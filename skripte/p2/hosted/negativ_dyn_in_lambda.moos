# P2-T66 (b) war negativ; seit P2-T85 (Plan 983e8a9c) positiv: Systemkoerper-
# Aufruf aus einer Methode (dynamischer Standardrahmen). Erwartete Ausgabe: 3.
@nativ
funktion teile(a: i32, b: i32) -> i32:
    unsicher:
        gib_zurück a / b

klasse Rechner:
    funktion rechne(a):
        unsicher:
            gib_zurück teile(a, 2)

setze r auf neu Rechner()
zeige r.rechne(7)
