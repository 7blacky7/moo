# P2-T114: 5 Mio. Methodenaufrufe, ein nicht geteilter globaler Lesewert.
# arbeite(0) liest nichts global; die statische Methoden-Ueberapproximation
# verlangt trotzdem eine Laufzeitpruefung in Rechner.rechne.
# Ausgabe: 37499992500000. Messwerkzeug: skripte/p2/runtime/zaehle.c.
setze faktor auf 3

klasse Rechner:
    funktion erstelle(wert):
        gib_zurück nichts

    funktion rechne(i):
        gib_zurück i * faktor

funktion arbeite(x):
    wenn x != 0:
        setze r auf neu Rechner(0)
        gib_zurück r.rechne(x)
    gib_zurück 0

setze t auf starte(arbeite, 0)
t.warten()
setze r auf neu Rechner(0)
setze summe auf 0
setze i auf 0
solange i < 5000000:
    setze summe auf summe + r.rechne(i)
    setze i auf i + 1
zeige summe
