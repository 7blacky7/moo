# P2-T29 S1 (Review 08e9b482): keine Fehlalarme. Spaetere Annotation,
# global mutierter Wert, Zweig mit anderem Typ, Schleife.
setze x auf "text"
setze y: Text auf x
setze x: Zahl auf 1
zeige y

setze g: Zahl auf 1
funktion mutiere():
    global g
    setze g auf "text"
mutiere()
setze h: Text auf g
zeige h

setze w auf 1
wenn x > 0:
    setze w auf "eins"
setze v: Zahl auf w
zeige v

setze i auf 0
setze s auf 0
solange i < 3:
    setze s auf "runde"
    setze i auf i + 1
setze t: Text auf s
zeige t

# Review da045f85: unbekannte rechte Seite; Annotation im nicht betretenen Zweig.
funktion liefert():
    gib_zurück "text"
setze q: Zahl auf liefert()
setze r: Text auf q
zeige r

setze u auf 1
wenn falsch:
    setze u: Zahl auf 2
setze u auf "text"
zeige u

# Parameter: Wert unbekannt, Neuzuweisung nur gegen die Annotation.
funktion verdopple(p: Zahl):
    setze ergebnis: Text auf p
    gib_zurück ergebnis
zeige verdopple(2)

# Review 255aca1c: Vorwaertsreferenz, Kette, Zweig, Schleife. Der spaetere
# Wert eines gelesenen Namens faerbt den frueheren Wert nicht.
setze va auf vb
setze vb auf 1
setze vc: Text auf va
zeige vc

setze ka auf kb
setze kb auf kc
setze kc auf 1
setze kd: Text auf ka
zeige kd

wenn x > 0:
    setze zb auf 1
setze za auf zb
setze zc: Text auf za
zeige zc

setze li auf 0
setze la auf 0
solange li < 2:
    setze la auf lb
    setze lb auf 1
    setze li auf li + 1
setze lc: Text auf la
zeige lc
