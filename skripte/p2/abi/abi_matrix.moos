# Drei verschiedene Strukturen unter gemischtem u64/f64/ptr-Druck.
@nativ
@einstieg
funktion probe_misch(ein: u64) -> f64:
    unsicher:
        setze q: ptr[MischEin] auf zeiger(ein)
        setze m: MischEin auf q[0]
        gib_zurück abi_misch(u64(1), 2.0, zeiger(ein), u64(3), 4.0, u64(5), m.x, m.y, m.z)

@nativ
@einstieg
funktion moo_misch(a: u64, b: f64, p: ptr[void], c: u64, d: f64, e: u64, x: FU, y: D2, z: B3) -> f64:
    unsicher:
        setze ganz: u64 auf a + c + e + u64(x.n) + u64(z.a) + u64(z.b) + u64(z.c)
        gib_zurück als(f64, ganz) + b + d + als(f64, x.f) + y.x + y.y

# void mit Struktur- und verschachteltem Argument (Arrayfeld).
@nativ
@einstieg
funktion probe_setze(ziel: u64, ein_wert: u64, ein_nest: u64) -> u32:
    unsicher:
        setze w: ptr[P8] auf zeiger(ein_wert)
        setze n: ptr[Nest] auf zeiger(ein_nest)
        abi_setze(zeiger(ziel), w[0], n[0])
        gib_zurück u32(1)

@nativ
@einstieg
funktion moo_setze(ziel: ptr[P8], wert: P8, n: Nest) -> void:
    unsicher:
        ziel[0] = P8(wert.a + u32(n.k[2]), wert.b + u32(n.i.t))
