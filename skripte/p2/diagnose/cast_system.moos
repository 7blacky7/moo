@nativ
funktion kurz(wert: u64) -> u8:
    setze ergebnis: u8 auf u8(5 * 8 - 1)
    unsicher:
        setze ergebnis auf u8(wert)
    gib_zurück ergebnis

@nativ
funktion lang(wert: u64) -> u8:
    setze ergebnis: u8 auf u8(5 * 8 - 1)
    unsicher:
        setze ergebnis auf als(u8, wert)
    gib_zurück ergebnis

zeige kurz(255)
zeige lang(255)
versuche:
    zeige kurz(256)
fange fehler:
    zeige "BEREICH"
versuche:
    zeige lang(256)
fange fehler:
    zeige "BEREICH"
