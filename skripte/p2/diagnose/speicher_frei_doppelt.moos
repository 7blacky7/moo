# P2-T98 S4 (M-M003): doppelte Freigabe, die zweite in einem inneren Block.
extern "C" funktion moo_t98_neu(n: u64) -> ptr[void]
@verbraucht(1)
extern "C" funktion moo_t98_frei(p: ptr[void]) -> void

@nativ
funktion probe(n: u64) -> u64:
    unsicher:
        setze p: ptr[void] auf moo_t98_neu(n)
        moo_t98_frei(p)
    wenn n > 1:
        unsicher:
            moo_t98_frei(p)
    gib_zurück n

zeige 1
