# 20 Bytes: drei ABI-Eightbytes, keine Register- oder Memoryklasse freigegeben.
struktur Paket20:
    wort0: u32
    wort1: u32
    wort2: u32
    wort3: u32
    wort4: u32

extern "C" funktion foo_struct20(wert: Paket20) -> Paket20

@nativ
@einstieg
funktion pruefe_sperre(adr: u64) -> u64:
    unsicher:
        gib_zurück adr
