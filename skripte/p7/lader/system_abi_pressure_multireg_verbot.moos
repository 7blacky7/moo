# Sieben vorangestellte u64-Parameter liegen ausserhalb der
# bisher eng freigegebenen C-Struktur-Signaturen (Maximum: sechs).
# 6 u64 + 12B Struct wurde durch separate echte ABI-Tests freigegeben.
struktur Paket12:
    wort0: u32
    wort1: u32
    wort2: u32

extern "C" funktion p2_multireg_unbelegt(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, wert: Paket12) -> Paket12

@nativ
@einstieg
funktion pruefe_sperre(adr: u64) -> u64:
    unsicher:
        gib_zurück adr
