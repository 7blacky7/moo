# P7-T5: Systemkoerper fuer @nativ (Kontrollfluss, Locals, Speicher, Aufrufe,
# adresse_von, Textkonstanten). Gegenprobe: system_probe.c (echte Ausfuehrung).
struktur Paar:
    a: u32
    b: u64

# ABI-Fall: Feld b liegt direkt nach einem einzelnen Byte (Offset 1).
@gepackt
struktur GepacktesPaar:
    marke: u8
    wert: u32

@nativ
konstante TEXT: [u8; 6] auf "MOO-OK"

@nativ
konstante PFAD: [u16; 5] auf "\\EFI"

@nativ
konstante TABELLE: [u32; 4] auf [10, 20, 30, 40]

@nativ
konstante FAKTOR: u64 auf 3

# solange + skalare Konstante
@nativ
@einstieg
funktion sys_summe(n: u64) -> u64:
    unsicher:
        setze s: u64 auf 0
        setze i: u64 auf 1
        solange i <= n:
            setze s auf s + i
            setze i auf i + 1
        gib_zurück s * FAKTOR

# adresse_von(Konstante) + speicher_lesen
@nativ
@einstieg
funktion sys_tabelle(i: u64) -> u32:
    unsicher:
        wenn i >= 4:
            gib_zurück 0
        gib_zurück speicher_lesen(adresse_von(TABELLE) + i * 4, 4)

# Textkonstanten [u8; N] (UTF-8) und [u16; N] (UTF-16 mit abschliessender 0), stopp
@nativ
@einstieg
funktion sys_text_summe() -> u64:
    unsicher:
        setze s: u64 auf 0
        setze i: u64 auf 0
        solange wahr:
            wenn i == 6:
                stopp
            setze s auf s + u64(speicher_lesen(adresse_von(TEXT) + i, 1))
            setze i auf i + 1
        setze j: u64 auf 0
        solange j < 5:
            setze s auf s + u64(speicher_lesen(adresse_von(PFAD) + j * 2, 2))
            setze j auf j + 1
        gib_zurück s

@nativ
funktion verdopple(x: u64) -> u64:
    unsicher:
        setze y: u64 auf x
        gib_zurück y + y

# Indirekter win64-Aufruf (Firmwaredienst) mit Ausgabeparameter = Adresse eines Locals
@nativ
@einstieg
funktion sys_rufe(f: ptr[fn[win64](u64, u64) -> u64], a: u64, b: u64) -> u64:
    unsicher:
        setze ergebnis: u64 auf 0
        setze r: u64 auf f(a, adresse_von(ergebnis))
        gib_zurück verdopple(ergebnis) + r + b

# Konversionen: kuerzen, umdeuten, Vorzeichen erweitern
@nativ
@einstieg
funktion sys_konv(x: u64) -> i64:
    unsicher:
        setze b: u8 auf u8(x)
        setze k: i8 auf i8(b)
        gib_zurück i64(k)

# zeiger(...), volatile mit Index, Nullzeigervergleich, oder (Kurzschluss)
@nativ
@einstieg
funktion sys_zeiger(adr: u64) -> u32:
    unsicher:
        setze p: ptr[u32] auf zeiger(adr)
        volatile_schreiben(p, 1, 77)
        wenn p == nichts oder volatile_lesen(p, 1) != 77:
            gib_zurück 0
        gib_zurück volatile_lesen(p) + volatile_lesen(p, 1)

# Layoutabfragen im Systemkoerper
@nativ
@einstieg
funktion sys_struktur(adr: u64) -> u64:
    unsicher:
        speicher_schreiben(adr + versatz_von(Paar, b), 99, 8)
        gib_zurück speicher_lesen(adr + versatz_von(Paar, b), 8) + groesse_von(Paar)

# weiter, Rest
@nativ
@einstieg
funktion sys_gerade(n: u64) -> u64:
    unsicher:
        setze z: u64 auf 0
        setze i: u64 auf 0
        solange i < n:
            setze i auf i + 1
            wenn (i % 2) == 1:
                weiter
            setze z auf z + 1
        gib_zurück z

# assembler mit Ausdrucks-Eingaengen
@nativ
@einstieg
funktion sys_asm(a: u64, b: u64) -> u64:
    unsicher:
        setze r: u64 auf assembler(ziel="x86_64", code="leaq ($1,$2), $0", ausgang="=r", eingaenge={"r": a + 1, "r": b}, clobber=[])
        gib_zurück r

# void-Funktion, sonst-wenn-Kette, und
@nativ
@einstieg
funktion sys_klasse(adr: u64, x: u64) -> void:
    unsicher:
        wenn x < 10 und x != 5:
            speicher_schreiben(adr, 1, 1)
        sonst:
            wenn x == 5:
                speicher_schreiben(adr, 2, 1)
            sonst:
                speicher_schreiben(adr, 3, 1)

# P2-T51: Typisierter RAM-Zeigerindex (NICHT fuer MMIO, dort volatile_*).
@nativ
@einstieg
funktion sys_puffer_index(adr: u64) -> u64:
    unsicher:
        setze p: ptr[u32] auf zeiger(adr)
        p[1] = 0x1234
        setze wert: u32 auf p[1]
        gib_zurück u64(wert) + u64(p[0])

# P2-T48: Die Registry liefert typgeprueften Feldtyp und Ziel-ABI-Offset.
@nativ
@einstieg
funktion sys_strukturfeld(adr: u64) -> u64:
    unsicher:
        strukturfeld_schreiben(Paar, b, adr, u64(123))
        setze wert: u64 auf strukturfeld_lesen(Paar, b, adr)
        gib_zurück wert + groesse_von(Paar)

# Registerzugriff ist explizit volatile und unterscheidet sich vom RAM-Zugriff.
@nativ
@einstieg
funktion sys_registerfeld(adr: u64) -> u32:
    unsicher:
        registerfeld_schreiben(Paar, a, adr, u32(71))
        gib_zurück registerfeld_lesen(Paar, a, adr)

# P2-T48: Gepackte Datenstruktur direkt ueber Zieloffset (1) beschreiben.
@nativ
@einstieg
funktion sys_gepacktes_feld(adr: u64) -> u32:
    unsicher:
        strukturfeld_schreiben(GepacktesPaar, wert, adr, u32(0x10203040))
        gib_zurück strukturfeld_lesen(GepacktesPaar, wert, adr)

# P2-T48: direkte Typ-/Offsetaufloesung fuer Zeiger auf Moo-Struktur.
@nativ
@einstieg
funktion sys_feld_direkt(adr: u64) -> u64:
    unsicher:
        setze p: ptr[Paar] auf zeiger(adr)
        p.b = u64(222)
        gib_zurück p.b + u64(p.a)

# Auch ein nativer Funktionsparameter mit ptr[Paar] benutzt die Nominalidentitaet.
@nativ
@einstieg
funktion sys_feld_param(p: ptr[Paar]) -> u64:
    unsicher:
        p.b = u64(333)
        gib_zurück p.b + u64(p.a)

# Derselbe Syntaxpfad funktioniert mit gepacktem ABI-Layout (Offset 1).
@nativ
@einstieg
funktion sys_feld_gepackt(adr: u64) -> u32:
    unsicher:
        setze p: ptr[GepacktesPaar] auf zeiger(adr)
        p.wert = u32(0xA1B2C3D4)
        gib_zurück p.wert

# Ptr[ptr[Struktur]]: das Index-Ergebnis ist erneut typisierter Zeiger.
@nativ
@einstieg
funktion sys_feld_verschachtelt(adr: u64) -> u64:
    unsicher:
        setze pp: ptr[ptr[Paar]] auf zeiger(adr)
        gib_zurück pp[0].b

# P2-T48: Eingebettete Strukturen behalten ihre ABI-Adresse, kein MooValue.
struktur InnereRegister:
    code: u16
    flags: u8

struktur GeraeteEintrag:
    kennung: u8
    innen: InnereRegister
    ende: u32

struktur GeraeteVerweis:
    ziel: ptr[InnereRegister]
    nummer: u32

@gepackt
struktur GepacktesGeraet:
    prefix: u8
    innen: InnereRegister
    ende: u16

@nativ
@einstieg
funktion sys_innen(adr: u64) -> u32:
    unsicher:
        setze p: ptr[GeraeteEintrag] auf zeiger(adr)
        p.innen.code = u16(0x1234)
        p.innen.flags = u8(5)
        gib_zurück u32(p.innen.code) + u32(p.innen.flags)

# Der Compiler multipliziert den Index mit der ABI-Groesse der Struktur.
@nativ
@einstieg
funktion sys_struktur_array(adr: u64) -> u32:
    unsicher:
        setze p: ptr[GeraeteEintrag] auf zeiger(adr)
        p[1].ende = u32(555)
        p[2].innen.code = u16(777)
        gib_zurück p[1].ende + u32(p[2].innen.code)

# Ein typisiertes Pointerfeld zeigt auf eine weitere Struktur.
@nativ
@einstieg
funktion sys_link_feld(adr: u64) -> u32:
    unsicher:
        setze p: ptr[GeraeteVerweis] auf zeiger(adr)
        p.ziel.flags = u8(44)
        gib_zurück u32(p.ziel.flags) + p.nummer

# @gepackt: Innenstruktur beginnt unmittelbar nach prefix (Offset 1).
@nativ
@einstieg
funktion sys_packed_innen(adr: u64) -> u32:
    unsicher:
        setze p: ptr[GepacktesGeraet] auf zeiger(adr)
        p.innen.code = u16(0xBEEF)
        gib_zurück u32(p.innen.code)

# P2-T48: Feste Arrayfelder in einer nativen Struktur.
struktur FeldEintrag:
    code: u16
    flags: u8

struktur ArrayLayout:
    marker: u8
    werte: [u32; 4]
    eintraege: [FeldEintrag; 3]

struktur ReferenzTabelle:
    referenzen: [ptr[FeldEintrag]; 2]

@nativ
@einstieg
funktion sys_array_felder(adr: u64, i: u64) -> u64:
    unsicher:
        setze p: ptr[ArrayLayout] auf zeiger(adr)
        p.werte[i] = u32(70)
        p.eintraege[1].code = u16(404)
        p.eintraege[2].flags = u8(9)
        gib_zurück u64(p.werte[i]) + u64(p.eintraege[1].code) + u64(p.eintraege[2].flags)

# Ein festes Array kann auch native Pointer-Elemente enthalten.
@nativ
@einstieg
funktion sys_array_referenzen(adr: u64) -> u32:
    unsicher:
        setze p: ptr[ReferenzTabelle] auf zeiger(adr)
        p.referenzen[1].flags = u8(17)
        gib_zurück u32(p.referenzen[1].flags)

# P2-T48: Echte mehrdimensionale Hardware-/Datenarrays ohne Hilfszeiger.
# Jede Dimension hat einen eigenen typisierten Index- und Laengenkontrakt.
struktur MatrixDaten:
    zaehler: u8
    feld: [[u16; 4]; 3]
    punkte: [[FeldEintrag; 2]; 2]

struktur MatrixPointer:
    ziele: [[ptr[FeldEintrag]; 2]; 2]

@nativ
@einstieg
funktion sys_matrix(adr: u64, reihe: u64, spalte: u64) -> u32:
    unsicher:
        setze p: ptr[MatrixDaten] auf zeiger(adr)
        p.feld[reihe][spalte] = u16(321)
        p.punkte[1][0].code = u16(222)
        p.punkte[1][0].flags = u8(6)
        gib_zurück u32(p.feld[reihe][spalte]) + u32(p.punkte[1][0].code) + u32(p.punkte[1][0].flags)

@nativ
@einstieg
funktion sys_matrix_zeiger(adr: u64) -> u32:
    unsicher:
        setze p: ptr[MatrixPointer] auf zeiger(adr)
        p.ziele[1][1].flags = u8(27)
        gib_zurück u32(p.ziele[1][1].flags)

# P2-T51: Adresse bestehender nativer Unterfelder direkt erhalten,
# ohne manuelle Versatzrechnung oder unpassendes MooValue-Boxing.
@nativ
@einstieg
funktion sys_adresse_matrix(adr: u64) -> u64:
    unsicher:
        setze p: ptr[MatrixDaten] auf zeiger(adr)
        gib_zurück adresse_von(p.feld[2][3])

@nativ
@einstieg
funktion sys_adresse_zeile(adr: u64) -> u64:
    unsicher:
        setze p: ptr[MatrixDaten] auf zeiger(adr)
        gib_zurück adresse_von(p.feld[1])

@nativ
@einstieg
funktion sys_adresse_punkt(adr: u64) -> u64:
    unsicher:
        setze p: ptr[MatrixDaten] auf zeiger(adr)
        gib_zurück adresse_von(p.punkte[1][0].code)

@nativ
@einstieg
funktion sys_adresse_struktur(adr: u64) -> u64:
    unsicher:
        setze p: ptr[MatrixDaten] auf zeiger(adr)
        gib_zurück adresse_von(p.punkte[1][0])

# P2-T48: Echte lokale Strukturwerte; Konstruktor nutzt die native
# Konstanten-Syntax, aber jetzt auch mit variablen Laufzeitwerten.
struktur NativeWert:
    code: u32
    wert: u64

struktur NativeBlock:
    prefix: u8
    innen: NativeWert
    ende: u16

# Wertkopie in nativen Slots: Original bleibt trotz Aenderung erhalten.
@nativ
@einstieg
funktion sys_value_copy(adr: u64) -> u64:
    unsicher:
        setze original: NativeWert auf NativeWert(u32(7), u64(11))
        setze kopie: NativeWert auf original
        kopie.wert = u64(99)
        setze p: ptr[NativeWert] auf zeiger(adr)
        p[0] = kopie
        gib_zurück original.wert + kopie.wert

# Verschachtelte Strukturwerte werden im nativen LLVM-Layout kopiert.
@nativ
@einstieg
funktion sys_value_nested(adr: u64) -> u64:
    unsicher:
        setze original: NativeBlock auf NativeBlock(u8(4), NativeWert(u32(5), u64(6)), u16(7))
        setze kopie: NativeBlock auf original
        kopie.innen.wert = u64(100)
        setze p: ptr[NativeBlock] auf zeiger(adr)
        p[0] = kopie
        gib_zurück original.innen.wert + kopie.innen.wert

# Nativer Struct-Load und -Store aus typisiertem RAM.
@nativ
@einstieg
funktion sys_value_pointer_copy(adr: u64) -> u64:
    unsicher:
        setze p: ptr[NativeWert] auf zeiger(adr)
        setze kopie: NativeWert auf p[0]
        kopie.code = u32(42)
        p[1] = kopie
        gib_zurück u64(kopie.code) + p[1].wert

# Die Adresse eines Feldes in einem lokalen Strukturwert ist nutzbar.
@nativ
@einstieg
funktion sys_value_local_address() -> u64:
    unsicher:
        setze wert: NativeWert auf NativeWert(u32(1), u64(2))
        setze adr: u64 auf adresse_von(wert.wert)
        setze p: ptr[u64] auf zeiger(adr)
        p[0] = u64(55)
        gib_zurück wert.wert

# Embedded Struct-Feld als Ganzes in RAM schreiben und wieder lesen.
@nativ
@einstieg
funktion sys_value_field_store(adr: u64) -> u64:
    unsicher:
        setze wert: NativeWert auf NativeWert(u32(3), u64(88))
        setze p: ptr[NativeBlock] auf zeiger(adr)
        p.innen = wert
        gib_zurück p.innen.wert

@nativ
@einstieg
funktion sys_value_field_copy(adr: u64) -> u64:
    unsicher:
        setze p: ptr[NativeBlock] auf zeiger(adr)
        setze kopie: NativeWert auf p.innen
        kopie.wert = u64(20)
        gib_zurück kopie.wert + p.innen.wert

# P2-T48: Nativer Moo-zu-Moo-Aufruf mit kompletter Struktur als Wert.
# Die ABI-Freigabe fuer fremde C-/UEFI-Aufrufe ist davon getrennt.
@nativ
funktion sys_value_transform(eingang: NativeWert) -> NativeWert:
    unsicher:
        setze ergebnis: NativeWert auf eingang
        ergebnis.code = ergebnis.code + u32(10)
        ergebnis.wert = ergebnis.wert + u64(20)
        gib_zurück ergebnis

@nativ
@einstieg
funktion sys_value_call(adr: u64) -> u64:
    unsicher:
        setze original: NativeWert auf NativeWert(u32(5), u64(9))
        setze ergebnis: NativeWert auf sys_value_transform(original)
        setze p: ptr[NativeWert] auf zeiger(adr)
        p[0] = ergebnis
        gib_zurück u64(original.code) + u64(ergebnis.code) + ergebnis.wert

@nativ
funktion sys_value_nested_transform(eingang: NativeBlock) -> NativeBlock:
    unsicher:
        setze ergebnis: NativeBlock auf eingang
        ergebnis.innen.wert = ergebnis.innen.wert + u64(10)
        gib_zurück ergebnis

@nativ
@einstieg
funktion sys_value_nested_call(adr: u64) -> u64:
    unsicher:
        setze original: NativeBlock auf NativeBlock(u8(2), NativeWert(u32(3), u64(4)), u16(5))
        setze ergebnis: NativeBlock auf sys_value_nested_transform(original)
        setze p: ptr[NativeBlock] auf zeiger(adr)
        p[0] = ergebnis
        gib_zurück original.innen.wert + ergebnis.innen.wert

# P2-T48 E3 (Plan a71947f7): Arrays als Werte, Arrayliteral, Nullkonstruktor,
# Float-/bool-Konstanten, Struktur-Array-Stride sowie die T63-Proben
# (exakter/partieller Overlap, Slot<->Zeiger-Alias) gegen C (system_probe.c).
struktur E3Messung:
    werte: [u32; 4]
    skala: f32
    gueltig: bool
    marke: u16

@nativ
konstante E3_SKALA: f32 auf 0.1
@nativ
konstante E3_HALB: f64 auf 0.5
@nativ
konstante E3_AN: bool auf wahr
@nativ
konstante E3_TABELLE: [f64; 3] auf [0.5, -1.25, 2.0]

# Lokales Array per Literal, unabhaengige Kopie, als Strukturfeld in den RAM.
@nativ
@einstieg
funktion sys_e3_arrays(adr: u64) -> u64:
    unsicher:
        setze a: [u32; 4] auf [1, 2, 3, 4]
        a[3] = 40
        setze b: [u32; 4] auf a
        b[0] = 100
        setze m: E3Messung auf E3Messung(b, E3_SKALA, wahr, 7)
        setze p: ptr[E3Messung] auf zeiger(adr)
        p[0] = m
        gib_zurück u64(a[0]) + u64(a[3]) + u64(b[0])

# Name() = Nullwert, auch fuer Arrayfelder.
@nativ
@einstieg
funktion sys_e3_null(adr: u64) -> u64:
    unsicher:
        setze leer: E3Messung auf E3Messung()
        setze p: ptr[E3Messung] auf zeiger(adr)
        p[0] = leer
        gib_zurück u64(leer.werte[2]) + u64(leer.marke)

# f32-Konstante aus dem Literal gerundet (== C 0.1f), f64-Tabelle im RAM.
@nativ
@einstieg
funktion sys_e3_float(adr: u64) -> u64:
    unsicher:
        setze q: ptr[f64] auf zeiger(adr)
        q[0] = als(f64, E3_SKALA) * 10.0 + E3_HALB
        setze t: ptr[f64] auf zeiger(adresse_von(E3_TABELLE))
        q[1] = t[1]
        wenn E3_AN:
            gib_zurück 1
        gib_zurück 0

# Lokales Struktur-Array: Literal, Nullelement, Elementfeld schreiben, Stride.
@nativ
@einstieg
funktion sys_e3_struktur_array(adr: u64) -> u64:
    unsicher:
        setze ws: [NativeWert; 3] auf [NativeWert(u32(1), u64(10)), NativeWert(u32(2), u64(20)), NativeWert()]
        ws[2].code = u32(3)
        setze p: ptr[NativeWert] auf zeiger(adr)
        setze i: u64 auf 0
        solange i < 3:
            p[i] = ws[i]
            setze i auf i + 1
        gib_zurück ws[1].wert + u64(ws[2].code)

# T63: exakter und partieller Overlap (Quelle 8 Byte hinter dem Ziel).
@nativ
@einstieg
funktion sys_e3_overlap(adr: u64) -> u64:
    unsicher:
        setze p: ptr[NativeWert] auf zeiger(adr)
        p[0] = p[0]
        setze q: ptr[NativeWert] auf zeiger(adr + 8)
        p[0] = q[0]
        gib_zurück p[0].wert

# P2-T13 Batch C: @ausrichten(32) fuer Slot, lokales Array und RAM-Kopie.
@ausrichten(32)
struktur E3Block:
    a: u32
    b: u8

@nativ
@einstieg
funktion sys_e3_ausgerichtet(adr: u64) -> u64:
    unsicher:
        setze stoerer: u8 auf 1
        setze blk: E3Block auf E3Block(u32(7), u8(9))
        setze bs: [E3Block; 2] auf [E3Block(u32(1), u8(2)), E3Block()]
        setze p: ptr[E3Block] auf zeiger(adr)
        p[0] = blk
        p[1] = bs[0]
        setze rest: u64 auf adresse_von(blk) % 32 + adresse_von(bs[0]) % 32
        gib_zurück rest * 1000 + (adresse_von(bs[1]) - adresse_von(bs[0])) + u64(stoerer) - 1

# P2-T17 D1 (Plan f5b52a0b): volatile_schreiben/volatile_lesen auf einem
# speichergestuetzten "Register" (MMIO nur Bare, O4). Zwei Lesezugriffe bleiben
# nach O2 zwei Loads (IR-Probe in mise.toml, Gegenprobe system_probe.c).
@nativ
@einstieg
funktion sys_mmio(adr: u64, wert: u32) -> u32:
    unsicher:
        setze reg: ptr[u32] auf zeiger(adr)
        volatile_schreiben(reg, wert)
        setze a: u32 auf volatile_lesen(reg)
        setze b: u32 auf volatile_lesen(reg)
        gib_zurück a + b

# T63: Slot und Zeiger auf denselben Slot sehen dieselben Bytes.
@nativ
@einstieg
funktion sys_e3_alias() -> u64:
    unsicher:
        setze w: NativeWert auf NativeWert(u32(1), u64(2))
        setze p: ptr[NativeWert] auf zeiger(adresse_von(w))
        p[0] = NativeWert(u32(5), u64(6))
        setze gesehen: u64 auf w.wert
        setze w auf p[0]
        w.code = w.code + u32(1)
        gib_zurück gesehen * 100 + u64(p[0].code)
