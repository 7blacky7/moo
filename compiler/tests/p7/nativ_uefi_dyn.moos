        ms_test_header_crc(p)
        wenn ms_gpt_kopf(p, 1):
            gib_zurück 2905
        speicher_schreiben(p + 80, 128, 4)
        speicher_schreiben(p + 84, 192, 4)
        ms_test_header_crc(p)
        wenn ms_gpt_kopf(p, 1):
            gib_zurück 2906
        speicher_schreiben(p + 84, 128, 4)
        speicher_schreiben(p + 72, 20478, 8)
        ms_test_header_crc(p)
        wenn ms_gpt_kopf(p, 1):
            gib_zurück 2907
        speicher_schreiben(p + 72, 2, 8)
        speicher_schreiben(p + 32, 10000, 8)
        speicher_schreiben(p + 48, 9967, 8)
        ms_test_header_crc(p)
        wenn nicht ms_gpt_kopf(p, 1):
            gib_zurück 2908
        nt_kopiere(a + 512, adresse_von(MS_TEST_GUID), 16)
        setze s auf ms_guid_format(adresse_von(MS_TEST_LEER), a + 512)
        solange j < 39:
            wenn speicher_lesen(s + j, 1) != speicher_lesen(adresse_von(MS_TEST_GUID_TEXT) + j, 1):
                gib_zurück 2909
            setze j auf j + 1
        speicher_schreiben(a + 512, 1, 8)
        speicher_schreiben(a + 520, 0, 8)
        speicher_schreiben(a + 528, 2, 8)
        speicher_schreiben(a + 536, 0, 8)
        speicher_schreiben(a + 544, 100, 8)
        speicher_schreiben(a + 552, 199, 8)
        wenn nicht ms_gpt_eintrag(a + 512, 34, 20446):
            gib_zurück 2910
        speicher_schreiben(a + 552, 99, 8)
        wenn ms_gpt_eintrag(a + 512, 34, 20446):
            gib_zurück 2911
        speicher_schreiben(a + 552, 199, 8)
        speicher_schreiben(a + 560, 8, 8)
        wenn ms_gpt_eintrag(a + 512, 34, 20446):
            gib_zurück 2912
        speicher_schreiben(a + 560, 0x8000000000000000, 8)
        wenn nicht ms_gpt_eintrag(a + 512, 34, 20446):
            gib_zurück 2913
        gib_zurück 2029

@nativ
funktion ms_interface_test() -> u64:
    unsicher:
        setze a: u64 auf ms_test_basis()
        setze input: u64 auf a + 512
        nt_kopiere(a, adresse_von(MS_TEST_CONFIG), 32)
        wenn nicht ms_interface(a, 32, 3) oder ms(7) != 2 oder ms(8) != 0x81 oder ms(9) != 2 oder ms(10) != 512 oder ms(11) != 512:
            gib_zurück 3001
        speicher_schreiben(a + 16, 0x62, 1)
        wenn ms_interface(a, 32, 3):
            gib_zurück 3002
        speicher_schreiben(a + 16, 0x50, 1)
        speicher_schreiben(a + 12, 1, 1)
        wenn ms_interface(a, 32, 3):
            gib_zurück 3003
        speicher_schreiben(a + 12, 0, 1)
        speicher_schreiben(a + 27, 0x82, 1)
        wenn ms_interface(a, 32, 3):
            gib_zurück 3004
        speicher_schreiben(a + 27, 2, 1)
        wenn ms_interface(a, 31, 3) oder ms_interface(a, 32, 1) oder ms_interface(a, 32, 2):
            gib_zurück 3005
        xh_setze(5, 32)
        ms_ep_context(input, 3, 0x12345000, 512, 0, wahr)
        wenn speicher_lesen(input + 132, 4) != 0x02000036 oder speicher_lesen(input + 136, 8) != 0x12345001 oder speicher_lesen(input + 144, 4) != 4096:
            gib_zurück 3006
        nt_kopiere(a, adresse_von(MS_TEST_SS_CONFIG), 44)
        wenn nicht ms_interface(a, 44, 4) oder ms(12) != 3 oder ms(13) != 4:
            gib_zurück 3007
        speicher_schreiben(a + 28, 1, 1)
        wenn ms_interface(a, 44, 4):
            gib_zurück 3008
        xh_setze(5, 64)
        ms_ep_context(input, 4, 0x12346000, 1024, 7, falsch)
        wenn speicher_lesen(input + 324, 4) != 0x04000716 oder speicher_lesen(input + 328, 8) != 0x12346001:
            gib_zurück 3009
        gib_zurück 2030

