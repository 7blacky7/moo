        speicher_schreiben(p + 72, 2, 8)
        speicher_schreiben(p + 80, 128, 4)
        speicher_schreiben(p + 84, 128, 4)
        ms_test_header_crc(p)
        wenn nicht ms_gpt_kopf(p, 1):
            gib_zurück 2903
        speicher_schreiben(p + 16, u32(speicher_lesen(p + 16, 4)) ^ u32(1), 4)
        wenn ms_gpt_kopf(p, 1):
            gib_zurück 2904
        ms_test_header_crc(p)
