# P7-T26: Wire-Orakel und Fehlerfaelle fuer den echten Nur-Lese-Treiber.
# Eigener kleiner RAM-Bereich im vorhandenen UEFI-Harness, keine echte USB-I/O.
@nativ
statisch MS_TEST_RAM: [u8; 8192] auf 0
@nativ
konstante MS_TEST_LEER: [u8; _] auf ""
@nativ
konstante MS_TEST_GUID: [u8; 16] auf [0x78,0x56,0x34,0x12,0xBC,0x9A,0xF0,0xDE,0x12,0x34,0x56,0x78,0x9A,0xBC,0xDE,0xF0]
@nativ
konstante MS_TEST_GUID_TEXT: [u8; _] auf "{12345678-9ABC-DEF0-1234-56789ABCDEF0} "
@nativ
konstante MS_TEST_CONFIG: [u8; 32] auf [9,2,32,0,1,1,0,128,50,9,4,2,0,2,8,6,80,0,7,5,129,2,0,2,0,7,5,2,2,0,2,0]
@nativ
konstante MS_TEST_SS_CONFIG: [u8; 44] auf [9,2,44,0,1,1,0,128,50,9,4,2,0,2,8,6,80,0,7,5,129,2,0,4,0,6,48,3,0,0,0,7,5,2,2,0,4,0,6,48,4,0,0,0]

@nativ
funktion ms_test_basis() -> u64:
    unsicher:
        setze a: u64 auf adresse_von(MS_TEST_RAM)
        setze j: u64 auf 0
        xh_null(a, 8192)
        solange j < 28:
            ms_setze(j, 0)
            setze j auf j + 1
        ms_setze(0, a)
        ms_setze(1, a)
        ms_setze(2, a + 4096)
        ms_setze(3, a + 4160)
        ms_setze(4, a + 6144)
        ms_setze(17, 512)
        ms_setze(18, 0xFFFFFFFFFFFFFFFF)
        hw_crc_tabelle(ms(4))
        gib_zurück a

@nativ
funktion ms_cbw_test() -> u64:
    unsicher:
        setze a: u64 auf ms_test_basis()
        setze p: u64 auf ms(2)
        setze op: u64 auf 0
        setze erlaubt: bool auf falsch
        wenn nicht ms_cbw_bauen(0x28, 0x12345678, 3):
            gib_zurück 2701
        # Unabhaengige31Byte-BOT-/SCSI-Wirewerte, nicht der Decoder als Orakel.
        wenn speicher_lesen(p, 8) != 0x0000000143425355 oder speicher_lesen(p + 8, 8) != 0x280A008000000600 oder speicher_lesen(p + 16, 8) != 0x0300007856341200 oder speicher_lesen(p + 24, 4) != 0:
            gib_zurück 2702
        wenn nicht ms_cbw_bauen(0x88, 0x123456789ABCDEF0, 2):
            gib_zurück 2703
        wenn speicher_lesen(p, 8) != 0x0000000243425355 oder speicher_lesen(p + 8, 8) != 0x8810008000000400 oder speicher_lesen(p + 16, 8) != 0xDEBC9A7856341200 oder speicher_lesen(p + 24, 1) != 0xF0 oder speicher_lesen(p + 25, 4) != 0x02000000:
            gib_zurück 2704
        wenn nicht ms_cbw_bauen(0x9E, 0, 0) oder speicher_lesen(p + 16, 1) != 0x10 oder speicher_lesen(p + 25, 4) != 0x20000000:
            gib_zurück 2705
        wenn ms_cbw_bauen(0x28, 0x100000000, 1) oder ms_cbw_bauen(0x28, 0, 0) oder ms_cbw_bauen(0x88, 0, 9):
            gib_zurück 2706
        solange op < 256:
            setze erlaubt auf op == 0 oder op == 3 oder op == 0x12 oder op == 0x25 oder op == 0x28 oder op == 0x88 oder op == 0x9E
            wenn ms_cbw_bauen(op, 16, 1) != erlaubt:
                gib_zurück 2707
            setze op auf op + 1
        wenn nicht ms_cbw_bauen(0x28, 16, 1):
            gib_zurück 2708
        speicher_schreiben(p + 15, 0x2A, 1)
        wenn ms_cbw_lesend(p):
            gib_zurück 2709
        speicher_schreiben(p + 15, 0x8A, 1)
        wenn ms_cbw_lesend(p):
            gib_zurück 2710
        speicher_schreiben(p + 15, 0x28, 1)
        speicher_schreiben(p + 12, 0, 1)
        wenn ms_cbw_lesend(p):
            gib_zurück 2711
        speicher_schreiben(p + 12, 129, 1)
        wenn ms_cbw_lesend(p):
            gib_zurück 2712
        wenn nicht ms_cbw_bauen(0x28, 16, 1):
            gib_zurück 2714
        speicher_schreiben(p, 0x43425354, 4)
        wenn ms_cbw_lesend(p):
            gib_zurück 2715
        speicher_schreiben(p, 0x43425355, 4)
        speicher_schreiben(p + 13, 1, 1)
        wenn ms_cbw_lesend(p):
            gib_zurück 2716
        speicher_schreiben(p + 13, 0, 1)
        speicher_schreiben(p + 14, 16, 1)
        wenn ms_cbw_lesend(p):
            gib_zurück 2717
        ms_setze(18, 100)
        wenn ms_cbw_bauen(0x88, 100, 2):
            gib_zurück 2713
        gib_zurück 2027

@nativ
funktion ms_csw_test() -> u64:
    unsicher:
        setze a: u64 auf ms_test_basis()
        setze p: u64 auf ms(3)
        ms_setze(14, 0x12345678)
        speicher_schreiben(p, 0x53425355, 4)
        speicher_schreiben(p + 4, 0x12345678, 4)
        speicher_schreiben(p + 8, 4, 4)
        wenn nicht ms_csw_pruefen(13, 512, 512) oder ms(16) != 508:
            gib_zurück 2801
        speicher_schreiben(p, 0x53425354, 4)
        wenn ms_csw_pruefen(13, 512, 512):
            gib_zurück 2809
        speicher_schreiben(p, 0x53425355, 4)
        wenn ms_csw_pruefen(12, 512, 512) oder ms_csw_pruefen(13, 512, 4):
            gib_zurück 2802
        speicher_schreiben(p + 4, 0x12345679, 4)
        wenn ms_csw_pruefen(13, 512, 512):
            gib_zurück 2803
        speicher_schreiben(p + 4, 0x12345678, 4)
        speicher_schreiben(p + 8, 513, 4)
        wenn ms_csw_pruefen(13, 512, 512):
            gib_zurück 2804
        speicher_schreiben(p + 8, 0, 4)
        speicher_schreiben(p + 12, 2, 1)
        wenn ms_csw_pruefen(13, 512, 512):
            gib_zurück 2805
        speicher_schreiben(p + 12, 3, 1)
        wenn ms_csw_pruefen(13, 512, 512):
            gib_zurück 2806
        speicher_schreiben(p + 12, 1, 1)
        speicher_schreiben(p + 8, 512, 4)
        wenn nicht ms_csw_pruefen(13, 512, 0) oder ms(15) != 1 oder ms(16) != 0:
            gib_zurück 2807
        speicher_schreiben(p + 12, 0, 1)
        speicher_schreiben(p + 8, 0, 4)
        wenn nicht ms_csw_pruefen(13, 0, 0):
            gib_zurück 2808
        gib_zurück 2028

@nativ
funktion ms_test_header_crc(p: u64) -> void:
    unsicher:
        speicher_schreiben(p + 16, 0, 4)
        speicher_schreiben(p + 16, hw_crc32(ms(4), p, 92), 4)

@nativ
funktion ms_gpt_test() -> u64:
    unsicher:
        setze a: u64 auf ms_test_basis()
        setze p: u64 auf a
        setze s: u64 auf 0
        setze j: u64 auf 0
        setze crc: u32 auf 0
        speicher_schreiben(a, 0x3837363534333231, 8)
        speicher_schreiben(a + 8, 57, 1)
        wenn hw_crc32(ms(4), a, 9) != u32(0xCBF43926) oder hw_crc32(ms(4), a, 0) != u32(0):
            gib_zurück 2901
        setze crc auf hw_crc_fortsetzen(ms(4), a, 4, u32(0xFFFFFFFF))
        setze crc auf hw_crc_fortsetzen(ms(4), a + 4, 5, crc)
        wenn (crc ^ u32(0xFFFFFFFF)) != u32(0xCBF43926):
            gib_zurück 2902
        xh_null(a, 512)
        ms_setze(18, 20479)
        speicher_schreiben(p, 0x5452415020494645, 8)
        speicher_schreiben(p + 8, 0x10000, 4)
        speicher_schreiben(p + 12, 92, 4)
        speicher_schreiben(p + 24, 1, 8)
        speicher_schreiben(p + 32, 20479, 8)
        speicher_schreiben(p + 40, 34, 8)
        speicher_schreiben(p + 48, 20446, 8)
        speicher_schreiben(p + 56, 0x123456789ABCDEF0, 8)
