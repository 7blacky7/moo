# P2-T21/T57 E-3: native Moo-Funktion ohne @rückruf ist kein C-Funktionszeiger.
extern "C" funktion rr_merke(cb: ptr[fn(i32, ptr[void]) -> i32], ud: ptr[void]) -> void

@nativ
funktion f(x: i32, u: ptr[void]) -> i32:
    unsicher:
        gib_zurück x

@nativ
funktion lauf() -> i32:
    unsicher:
        rr_merke(f, nichts)
        gib_zurück 0

unsicher:
    zeige lauf()
