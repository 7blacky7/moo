funktion marke(text):
    zeige text
funktion zweiter():
    zeige "B"
    wirf "SPAETERER_FEHLER"
funktion probe():
    aufräumen: marke("A")
    aufräumen: zweiter()
    wirf nichts
funktion umgebung():
    versuche:
        probe()
    fange fehler:
        wenn fehler == "nichts":
            zeige "IST_NICHTS"
        sonst:
            zeige "FALSCHER_ERSTFEHLER"
            zeige fehler
        aufräumen: marke("N")
umgebung()
zeige "ENDE"
