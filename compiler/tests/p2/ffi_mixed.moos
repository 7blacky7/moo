@bibliothek("p2_mixed")
extern "C" funktion p2_mixed_value(a: i32, b: f32, c: f64, d: i8, e: u8) -> f64
@nativ
funktion ffi_mixed_value(a: i32, b: f32, c: f64, d: i8, e: u8) -> f64:
    unsicher:
        gib_zurück p2_mixed_value(a, b, c, d, e)
