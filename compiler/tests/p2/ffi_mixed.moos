    unsicher:
        gib_zurück p2_mixed_u8(a, b, c, d, e)
setze a auf 7
setze b auf 1.5
setze c auf 2.5
setze d auf -3
setze e auf 11
zeige ffi_mixed_value(a, b, c, d, e)
zeige ffi_mixed_f32(a, b, c, d, e)
zeige ffi_mixed_i32(a, b, c, d, e)
