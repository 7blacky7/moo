# P2-T15/T50 Batch B (Plan bb3878ef B1-B5, C1): puffer[T] nativ als nicht
# besitzender Ausschnitt. Fuellen/Summieren je Typ i8..u64/f32/f64 (Wrap per
# als_wrap, dyn. Gegenlesen), Ansicht als Argument, nativ->nativ, leerer Puffer,
# Index == Laenge fangbar, falscher Elementtyp und Liste statt Puffer fangbar,
# Pin nach Fehler (zweites Pufferargument bzw. Koerperfehler) geloest: danach
# ist puffer_anhängen wieder erlaubt.
@nativ
funktion fuell_i8(p: puffer[i8]) -> i64:
    unsicher:
        setze i: u64 auf 0
        setze s: i64 auf 0
        solange i < länge(p):
            p[i] = als_wrap(i8, i * 37)
            setze s auf s + als_wrap(i64, p[i])
            setze i auf i + 1
        gib_zurück s
@nativ
funktion fuell_u8(p: puffer[u8]) -> i64:
    unsicher:
        setze i: u64 auf 0
        setze s: i64 auf 0
        solange i < länge(p):
