funktion marke():
    zeige "FALSCHER_SEITENEFFEKT"
    gib_zurück 0
funktion probe():
    versuche:
        [1, 2, 3, 4][0] = 1 / 0 + marke()
    fange fehler:
        gib_zurück 1
    gib_zurück 0
setze i auf 0
setze treffer auf 0
solange i < 200000:
    setze treffer auf treffer + probe()
    setze i auf i + 1
zeige treffer
