# P2-T16 (Plan 3f03704a C1/D1): stdlib/vektor.moos - Matrix-Konstruktoren,
# Verkettung ueber `*`, deutsche und englische Namen. Bitgleichheit gegen
# moo_3d_math.c prueft skripte/p2/grafik (test-mat4-nativ).
importiere vektor

@nativ
funktion transformiert(m: mat4, x: f32, y: f32, z: f32) -> vec4:
    gib_zurück m * vec4(x, y, z, 1.0)

@nativ
funktion kette() -> mat4:
    gib_zurück mat4_verschiebung(vec3(1.0, 2.0, 3.0)) * mat4_skalierung(vec3(2.0, 2.0, 2.0))

zeige mat4_einheit()
zeige transformiert(mat4_translation(vec3(1, 2, 3)), 1, 1, 1)
zeige transformiert(kette(), 1, 1, 1)
zeige transformiert(mat4_drehung(180, vec3(0, 0, 2)), 1, 0, 0)
zeige mat4_perspektive(90, 2, 1, 3)
zeige mat4_blick(vec3(0, 0, 5), vec3(0, 0, 0), vec3(0, 1, 0))
zeige mat4_orthographic(0, 2, 0, 4, -1, 1)
zeige mat4_scaling(vec3(1, 2, 3)) == mat4_skalierung(vec3(1, 2, 3))
zeige mat4_rotation(30, vec3(1, 1, 0)) == mat4_drehung(30, vec3(1, 1, 0))
zeige mat4_unit() == mat4_view(vec3(0, 0, 0), vec3(0, 0, -1), vec3(0, 1, 0))
zeige mat4_projection(60, 1.5, 0.1, 100) == mat4_perspektive(60, 1.5, 0.1, 100)
