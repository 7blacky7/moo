@bibliothek("p2_i64")
extern "C" funktion p2_i64_guard(wert: i64) -> i64
@nativ
funktion ffi_i64(wert: i64) -> i64:
    unsicher:
        gib_zurück p2_i64_guard(wert)
@bibliothek("p2_i64")
extern "C" funktion p2_f64_nan() -> f64
@nativ
funktion ffi_source() -> f64:
    unsicher:
        gib_zurück p2_f64_nan()
setze wert auf ffi_source()
zeige ffi_i64(wert)
zeige "DARF_NICHT_ERREICHT_WERDEN"
