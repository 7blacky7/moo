# P2-T50 Batch A (Plan bb3878ef A1-A3): länge(p)/p.länge(), puffer_anhängen
# (Wachstum), puffer_ansicht (teilt den Speicher), fangbare Fehler: Original
# durch Ansicht gesperrt, Ansicht nicht verlaengerbar, Bereich ausserhalb, Wert
# passt nicht. Englische Aliase; eine temporaere Ansicht wird freigegeben.
setze p auf puffer_erstellen(i32, 3)
p[0] = 7
zeige länge(p)
zeige p.länge()
puffer_anhängen(p, 42)
puffer_anhängen(p, -5)
zeige länge(p)
zeige p[3] + p[4]
setze a auf puffer_ansicht(p, 1, 3)
zeige länge(a)
a[0] = 99
zeige p[1]
versuche:
    puffer_anhängen(p, 1)
    zeige "NACH_FALSCH"
fange f:
    zeige "gefangen: " + f
versuche:
    puffer_anhängen(a, 1)
fange f:
    zeige "gefangen: " + f
versuche:
    setze b auf puffer_ansicht(p, 4, 2)
fange f:
    zeige "gefangen: " + f
versuche:
    puffer_anhängen(p, 1.5)
fange f:
    zeige "gefangen: " + f
setze q auf puffer_erstellen(u8, 0)
setze i auf 0
solange i < 300:
    puffer_anhängen(q, i % 256)
    setze i auf i + 1
zeige länge(q)
zeige q[299]
buffer_append(q, 7)
zeige länge(buffer_view(q, 0, 2))
puffer_anhängen(q, 1)
zeige länge(q)
zeige q[300]
