# P2-T21/T57 Batch E (Plan f4655d20 E-2, E4a/E5/E7): fehlerfreie C-Rueckrufe.
# Ihre Thunks beruehren keinen Runtime-Zustand (reiner ABI-Adapter):
# libc-qsort mit Moo-Vergleicher (negative Werte, Duplikat, i32-Grenzen),
# user_data auf eine lokale Struktur, void-Rueckruf, Strukturwert rein/raus,
# gespeicherter (asynchroner) Rueckruf und Aufruf von einem fremden C-Thread.
# C-Gegenstelle: skripte/p2/ffi/rueckruf_gegenstelle.c (libp2_rueckruf.a).
struktur Zahl:
    w: i32

struktur Kontext:
    aufrufe: i32
    wert: i32

struktur Paar:
    a: i32
    b: i64

extern "C" funktion qsort(basis: ptr[Zahl], anzahl: u64, groesse: u64, vergleich: ptr[fn(ptr[Zahl], ptr[Zahl]) -> i32]) -> void
@bibliothek("p2_rueckruf")
extern "C" funktion rr_wiederhole(n: i32, cb: ptr[fn(i32, ptr[Kontext]) -> i32], ud: ptr[Kontext]) -> i32
@bibliothek("p2_rueckruf")
extern "C" funktion rr_melde(n: i32, cb: ptr[fn(i32, ptr[Kontext]) -> void], ud: ptr[Kontext]) -> void
@bibliothek("p2_rueckruf")
extern "C" funktion rr_merke(cb: ptr[fn(i32, ptr[Kontext]) -> i32], ud: ptr[Kontext]) -> void
@bibliothek("p2_rueckruf")
extern "C" funktion rr_loese_aus(x: i32) -> i32
@bibliothek("p2_rueckruf")
extern "C" funktion rr_tausche(cb: ptr[fn(Paar) -> Paar], a: i32, b: i64) -> i64
@bibliothek("p2_rueckruf")
extern "C" funktion rr_auf_thread(cb: ptr[fn(i32, ptr[Kontext]) -> i32], ud: ptr[Kontext], x: i32) -> i32

# Vergleich ohne Subtraktion (kein Ueberlauf an den i32-Grenzen).
@nativ
@rückruf
funktion vergleiche(a: ptr[Zahl], b: ptr[Zahl]) -> i32:
    unsicher:
        wenn a.w < b.w:
            gib_zurück -1
        wenn a.w > b.w:
            gib_zurück 1
        gib_zurück 0

@nativ
@rückruf
funktion besuche(i: i32, k: ptr[Kontext]) -> i32:
    unsicher:
        k.aufrufe = k.aufrufe + 1
        k.wert = k.wert + i
        gib_zurück i + 1

@nativ
@rückruf
funktion melde(i: i32, k: ptr[Kontext]) -> void:
    unsicher:
        k.aufrufe = k.aufrufe + 1
        k.wert = k.wert + i * i

@nativ
@rückruf
funktion tausche(p: Paar) -> Paar:
    unsicher:
        gib_zurück Paar(p.a + 1, p.b * 2)

@nativ
@rückruf
funktion verdopple(x: i32, k: ptr[Kontext]) -> i32:
    gib_zurück x * 2

@nativ
funktion lauf_sortiere(p: puffer[i32]) -> i32:
    unsicher:
        qsort(zeiger(u64(puffer_zeiger(p))), länge(p), 4, vergleiche)
        gib_zurück 0

@nativ
funktion lauf_besuche(n: i32) -> i32:
    unsicher:
        setze k: Kontext auf Kontext(0, 0)
        setze r: i32 auf rr_wiederhole(n, besuche, zeiger(adresse_von(k)))
        gib_zurück k.aufrufe * 10000 + k.wert * 100 + r

@nativ
funktion lauf_melde(n: i32) -> i32:
    unsicher:
        setze k: Kontext auf Kontext(0, 0)
        rr_melde(n, melde, zeiger(adresse_von(k)))
        gib_zurück k.aufrufe * 100 + k.wert

@nativ
funktion lauf_tausche(a: i32, b: i64) -> i64:
    unsicher:
        setze r: i64 auf rr_tausche(tausche, a, b)
        gib_zurück r

@nativ
funktion lauf_merke() -> i32:
    unsicher:
        rr_merke(verdopple, nichts)
        gib_zurück 1

@nativ
funktion lauf_loese_aus(x: i32) -> i32:
    unsicher:
        setze r: i32 auf rr_loese_aus(x)
        gib_zurück r

@nativ
funktion lauf_thread(x: i32) -> i32:
    unsicher:
        setze k: Kontext auf Kontext(0, 0)
        setze r: i32 auf rr_auf_thread(besuche, zeiger(adresse_von(k)), x)
        gib_zurück k.aufrufe * 10000 + r

setze z auf puffer_erstellen(i32, 7)
z[0] = 5
z[1] = -3
z[2] = 2147483647
z[3] = -3
z[4] = 0
z[5] = -2147483648
z[6] = 9
unsicher:
    zeige lauf_sortiere(z)
setze i auf 0
solange i < 7:
    zeige z[i]
    setze i auf i + 1
unsicher:
    zeige lauf_besuche(4)
    zeige lauf_melde(3)
    zeige lauf_tausche(7, 21)
    zeige lauf_merke()
    zeige lauf_loese_aus(21)
    zeige lauf_thread(5)
