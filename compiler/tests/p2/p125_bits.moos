# P2-T125: gemeinsame Bitprimitiven, unabhaengige C++-Orakel.

@nativ
funktion p125_rol8(wort: u8, zaehler: u64) -> u8:
    gib_zurück rotieren_links(wort, zaehler)

@nativ
funktion p125_ror8(wort: u8, zaehler: u64) -> u8:
    gib_zurück rotate_right(wort, zaehler)

@nativ
funktion p125_hi8(a: u8, b: u8) -> u8:
    gib_zurück mul_hoch(a, b)

@nativ
funktion p125_carry8(a: u8, b: u8) -> bool:
    gib_zurück add_carry(a, b)

@nativ
funktion p125_eq8(a: u8, b: u8) -> bool:
    gib_zurück konstantzeit_gleich(a, b)

@nativ
funktion p125_sel8(flag: bool, a: u8, b: u8) -> u8:
    gib_zurück ct_select(flag, a, b)

