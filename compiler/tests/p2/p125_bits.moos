@nativ
funktion p125_neg(wort: u64) -> u64:
    gib_zurück rotieren_links(wort, -1)

@nativ
funktion p125_sys(wort: u64, zaehler: u64) -> u64:
    unsicher:
        setze ergebnis: u64 auf rotate_left(wort, zaehler)
        gib_zurück ergebnis

@nativ
funktion p125_inline(a: u64, b: u64, geheim: u64) -> u64:
    gib_zurück konstantzeit_auswahl(konstantzeit_gleich(geheim, 0), a + 1, b * 3)

@nativ
funktion p125_hw(ziel: ptr[u32], a: u32, b: u32, zaehler: u64) -> void:
    unsicher:
        volatile_schreiben(ziel, konstantzeit_auswahl(add_uebertrag(a, b), mul_hoch(a, b), rotieren_rechts(a, zaehler)))

@nativ
funktion p125_hw_sel(ziel: ptr[u32], flag: bool, a: u32, b: u32) -> void:
    unsicher:
        volatile_schreiben(ziel, konstantzeit_auswahl(flag, a, b))
