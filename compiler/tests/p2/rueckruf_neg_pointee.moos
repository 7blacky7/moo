# P2-T21/T57 E-3: Pointee-genau - ptr[i32] ist nicht ptr[void].
extern "C" funktion rr_merke(cb: ptr[fn(i32, ptr[void]) -> i32], ud: ptr[void]) -> void

@nativ
@rückruf
funktion f(x: i32, u: ptr[i32]) -> i32:
    unsicher:
        gib_zurück x

@nativ
funktion lauf() -> i32:
    unsicher:
        rr_merke(f, nichts)
        gib_zurück 0

unsicher:
    zeige lauf()
