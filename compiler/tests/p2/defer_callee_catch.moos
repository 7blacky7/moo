funktion marke(text):
    zeige text
funktion inner():
    versuche:
        setze x auf 1 / 0
    fange fehler:
        zeige "innen"
    gib_zurück [7, 8]
funktion probe():
    aufräumen: marke("A")
    setze wert auf inner()
    zeige wert[0]
    gib_zurück wert
setze ergebnis auf probe()
zeige ergebnis[1]
versuche:
    wirf "danach"
fange fehler:
    zeige fehler
