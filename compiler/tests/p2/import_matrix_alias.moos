# P2-T47 (Plan b1f51d65 E1): Importmatrix, Form Alias (q.name, q.NAME, q.Typ).
importiere modul_import_matrix als m

@nativ
funktion haupt_verschiebe(p: m.MPunkt) -> i32:
    setze q: m.MPunkt auf m.m_verschiebe(p, 1)
    gib_zurück q.x * 100 + q.y

@nativ
funktion haupt_ptr() -> i32:
    unsicher:
        setze q: m.MPunkt auf m.MPunkt(3, 4)
        setze z: ptr[m.MPunkt] auf zeiger(adresse_von(q))
        gib_zurück m.m_ptr_x(z)

@nativ
funktion haupt_extern(x: i32) -> i32:
    unsicher:
        setze r: i32 auf m.abs(x)
        gib_zurück r

@nativ
funktion haupt_grenze() -> i32:
    gib_zurück m.MGRENZE * 2

zeige m.m_skalar(2, 0.5)
zeige haupt_verschiebe(m.MPunkt(1, 2))
unsicher:
    zeige haupt_ptr()
    zeige haupt_extern(-5)
zeige haupt_grenze()
setze b auf puffer_erstellen(m.MPunkt, 3)
unsicher:
    zeige m.m_fuelle(b)
    zeige m.m_summe(b)
setze d auf neu m.MDaten(5, "fuenf")
zeige d.wert
zeige d.name
