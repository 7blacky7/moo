# P2-T50 (Plan bb3878ef R4, Review 33621): 64-Bit-Pufferelemente ueber 2^53 sind
# nativ exakt (Schreiben, Lesen, Rechnen); der dynamische Elementzugriff weist
# sie mit fangbarem Fehler ab statt still zu runden.
@nativ
funktion breit_setzen(p: puffer[u64], q: puffer[i64]) -> u64:
    unsicher:
        p[0] = 18446744073709551615
        p[1] = 9007199254740993
        q[0] = -9223372036854775808
        gib_zurück p[0] - p[1] - 18437736874454810620
@nativ
funktion breit_pruefen(p: puffer[u64], q: puffer[i64]) -> bool:
    unsicher:
        gib_zurück p[1] == 9007199254740993 und q[0] < -9007199254740993 und p[0] - 1 == 18446744073709551614
setze p auf puffer_erstellen(u64, 2)
setze q auf puffer_erstellen(i64, 1)
unsicher:
    zeige breit_setzen(p, q)
    zeige breit_pruefen(p, q)
versuche:
    zeige p[0]
    zeige "NACH_FALSCH"
fange e:
    zeige "gefangen: " + e
versuche:
    zeige p[1]
    zeige "NACH_FALSCH"
fange e:
    zeige "gefangen: " + e
versuche:
    zeige q[0]
    zeige "NACH_FALSCH"
fange e:
    zeige "gefangen: " + e
