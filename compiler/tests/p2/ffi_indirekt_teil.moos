@nativ
funktion p2_indirekt_zehn(f: ptr[fn(ptr[u8], ptr[u8], u32, u64, u64, u64, u64, u64, u64, u64) -> u64], a: ptr[u8], b: ptr[u8], op: u32, x1: u64, x2: u64, x3: u64, x4: u64, x5: u64, x6: u64, x7: u64) -> u64:
