# P2-T114 Phase B: übergib. Ein Puffer wechselt beim Senden ohne Kopie den
# Besitzer und wird dabei nicht eingefroren: der Empfaenger veraendert ihn
# und schickt ihn zurueck. Weitere Referenz oder Sicht: fangbarer Fehler,
# der Puffer bleibt beim Sender.
geteilt konstante HIN auf kanal(2)
geteilt konstante ZURUECK auf kanal(2)

funktion verarbeite(x):
    setze p auf HIN.empfangen()
    setze s auf 0
    setze i auf 0
    solange i < länge(p):
        p[i] = p[i] * 2
        setze s auf s + p[i]
        setze i auf i + 1
    ZURUECK.senden(übergib p)
    gib_zurück s

setze p auf puffer_erstellen(i32, 1000)
setze i auf 0
solange i < 1000:
    p[i] = i
    setze i auf i + 1
setze t auf starte(verarbeite, 0)
HIN.senden(übergib p)
zeige p
zeige t.warten()
setze q auf ZURUECK.empfangen()
zeige q[10]
q[0] = 5
zeige q[0]

setze a auf puffer_erstellen(i32, 4)
setze b auf a
versuche:
    HIN.senden(übergib a)
    zeige "FALSCH: Alias"
fange e:
    zeige "Alias abgelehnt"
zeige länge(a)
setze b auf nichts
setze v auf puffer_ansicht(a, 0, 2)
versuche:
    HIN.senden(übergib a)
    zeige "FALSCH: Sicht"
fange e:
    zeige "Sicht abgelehnt"
setze v auf nichts
HIN.senden(transfer a)
zeige a
zeige länge(HIN.empfangen())
