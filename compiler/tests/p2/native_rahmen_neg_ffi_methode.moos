# P2-T85 D3 (E7) war: FFI-Einzelform ausserhalb von main gesperrt, auch in
# Methoden. Seit P2-T55 positiv (Ausgabe 3); Dateiname bleibt fuer die Historie.
extern "C" funktion abs(x: i32) -> i32

@nativ
funktion betrag(x: i32) -> i32:
    unsicher:
        gib_zurück abs(x)

klasse K:
    funktion m(x):
        unsicher:
            gib_zurück betrag(x)

zeige neu K().m(-3)
