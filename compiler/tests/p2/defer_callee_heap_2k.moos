setze sauber auf 0
funktion marke():
    global sauber
    setze sauber auf sauber + 1
funktion inner():
    setze lokal auf 0..1000
    setze x auf 1 / 0
    zeige "FALSCH_INNER"
funktion probe():
    aufräumen: marke()
    inner()
    zeige "FALSCH_PROBE"
funktion test():
    versuche:
        probe()
    fange fehler:
        gib_zurück 1
    gib_zurück 0
setze i auf 0
setze treffer auf 0
solange i < 2000:
    setze treffer auf treffer + test()
    setze i auf i + 1
zeige treffer
zeige sauber
