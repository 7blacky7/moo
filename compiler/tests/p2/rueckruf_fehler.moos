# P2-T21/T57 Batch E (Plan f4655d20 E-2, E4b-d/E6): fehlbare C-Rueckrufe im
# versuche:. Der Thunk liefert C den vereinbarten Fehlerwert, C laeuft zu Ende,
# der Moo-Aufrufer prueft unmittelbar nach dem Fremdaufruf und kehrt ohne
# weitere Seiteneffekte zurueck; dynamisch ein normaler fangbarer Fehler.
# Steht schon ein Fehler an, laeuft der Rueckruf-Koerper nicht mehr (Zaehler im
# user_data-Puffer). Reentranz: Rueckruf -> C -> Rueckruf, Fehler ganz innen.
# C-Gegenstelle: skripte/p2/ffi/rueckruf_gegenstelle.c (libp2_rueckruf.a).
struktur Kontext:
    aufrufe: i64
    wert: i64

extern "C" funktion qsort(basis: ptr[i32], anzahl: u64, groesse: u64, vergleich: ptr[fn(ptr[i32], ptr[i32]) -> i32]) -> void
@bibliothek("p2_rueckruf")
extern "C" funktion rr_wiederhole(n: i32, cb: ptr[fn(i32, ptr[Kontext]) -> i32], ud: ptr[Kontext]) -> i32
@bibliothek("p2_rueckruf")
extern "C" funktion rr_melde(n: i32, cb: ptr[fn(i32, ptr[Kontext]) -> void], ud: ptr[Kontext]) -> void
@bibliothek("p2_rueckruf")
extern "C" funktion rr_tiefer(tiefe: i32, cb: ptr[fn(i32, ptr[Kontext]) -> i32], ud: ptr[Kontext]) -> i32

# Indexzugriff gilt als fehlbar -> der Fehlerwert ist Pflicht.
@nativ
@rückruf(0)
funktion vergleiche(a: ptr[i32], b: ptr[i32]) -> i32:
    unsicher:
        wenn a[0] < b[0]:
            gib_zurück -1
        wenn a[0] > b[0]:
            gib_zurück 1
        gib_zurück 0

# Enthaelt der Puffer eine 0: Division durch null im Vergleicher.
@nativ
@rückruf(0)
funktion vergleiche_teilend(a: ptr[i32], b: ptr[i32]) -> i32:
    unsicher:
        setze q: i32 auf 100 / a[0]
        wenn a[0] < b[0]:
            gib_zurück -1
        wenn a[0] > b[0]:
            gib_zurück 1
        gib_zurück q * 0

@nativ
@rückruf(0)
funktion zaehle(i: i32, k: ptr[Kontext]) -> i32:
    unsicher:
        k.aufrufe = k.aufrufe + 1
        gib_zurück 70 / (7 - i)

@nativ
@rückruf
funktion melde(i: i32, k: ptr[Kontext]) -> void:
    unsicher:
        k.aufrufe = k.aufrufe + 1
        k.wert = k.wert + 100 / (3 - i64(i))

@nativ
@rückruf(0)
funktion tiefer(t: i32, k: ptr[Kontext]) -> i32:
    unsicher:
        k.aufrufe = k.aufrufe + 1
        wenn t == 0:
            gib_zurück i32(10 / k.wert)
        setze r: i32 auf rr_tiefer(t - 1, tiefer, k)
        k.wert = k.wert + 100
        gib_zurück r + 1

@nativ
funktion lauf_sortiere(p: puffer[i32]) -> i32:
    unsicher:
        qsort(puffer_zeiger(p), länge(p), 4, vergleiche)
        gib_zurück 0

@nativ
funktion lauf_sortiere_teilend(p: puffer[i32]) -> i32:
    unsicher:
        qsort(puffer_zeiger(p), länge(p), 4, vergleiche_teilend)
        gib_zurück 0

@nativ
funktion lauf_zaehle(p: puffer[i64], n: i32) -> i32:
    unsicher:
        setze k: ptr[Kontext] auf zeiger(u64(puffer_zeiger(p)))
        setze r: i32 auf rr_wiederhole(n, zaehle, k)
        gib_zurück r

@nativ
funktion lauf_melde(p: puffer[i64], n: i32) -> i32:
    unsicher:
        setze k: ptr[Kontext] auf zeiger(u64(puffer_zeiger(p)))
        rr_melde(n, melde, k)
        gib_zurück 0

@nativ
funktion lauf_tiefer(p: puffer[i64], t: i32) -> i32:
    unsicher:
        setze k: ptr[Kontext] auf zeiger(u64(puffer_zeiger(p)))
        setze r: i32 auf rr_tiefer(t, tiefer, k)
        gib_zurück r

setze z auf puffer_erstellen(i32, 5)
z[0] = 4
z[1] = -7
z[2] = 4
z[3] = 12
z[4] = -2147483648
setze k auf puffer_erstellen(i64, 2)

versuche:
    unsicher:
        zeige lauf_sortiere(z)
fange fehler:
    zeige "FALSCH gefangen"
zeige "sortiert:"
setze i auf 0
solange i < 5:
