    zeige "NICHT ERREICHT"
fange fehler:
    zeige "melde gefangen"
zeige k[0]
zeige k[1]

k[0] = 0
k[1] = 1
versuche:
    unsicher:
        zeige lauf_tiefer(k, 3)
fange fehler:
    zeige "FALSCH gefangen"
zeige k[0]
zeige k[1]
k[0] = 0
k[1] = 0
versuche:
    unsicher:
        zeige lauf_tiefer(k, 3)
    zeige "NICHT ERREICHT"
fange fehler:
    zeige "tiefer gefangen"
zeige k[0]
zeige k[1]
zeige "fertig"
