funktion marke(text):
    zeige text
funktion zweiter():
    zeige "B"
    wirf "SPAETERER_FEHLER"
funktion probe():
    aufräumen: marke("A")
    aufräumen: zweiter()
    aufräumen: marke("C_DARF_NICHT_LAUFEN")
    zeige "NACH_PUSH_DARF_NICHT_LAUFEN"
versuche:
    probe()
fange fehler:
    zeige "CATCH"
    zeige fehler
zeige "ENDE"
