struktur P2FfiPaket:
    wert: i32


@nativ
funktion ffi_rufe_indirekt(f: ptr[fn(i32) -> i32], wert: i32) -> i32:
    unsicher:
        gib_zurück f(wert)

@nativ
funktion ffi_rufe_firmware(f: ptr[fn(ptr[u8], ptr[u16]) -> u64], kontext: ptr[u8], text: ptr[u16]) -> u64:
    unsicher:
        gib_zurück f(kontext, text)

@nativ
funktion ffi_rufe_i8(f: ptr[fn(i8) -> i8], wert: i8) -> i8:
    unsicher:
        gib_zurück f(wert)

@nativ
funktion ffi_rufe_u8(f: ptr[fn(u8) -> u8], wert: u8) -> u8:
    unsicher:
        gib_zurück f(wert)

@nativ
funktion ffi_rufe_void(f: ptr[fn(i32) -> void], wert: i32) -> void:
    unsicher:
        f(wert)

@nativ
funktion ffi_rufe_paket(f: ptr[fn(ptr[P2FfiPaket]) -> i32], wert: ptr[P2FfiPaket]) -> i32:
    unsicher:
        gib_zurück f(wert)

@nativ
funktion ffi_rufe_zehn(f: ptr[fn(ptr[u8], ptr[u8], u32, u64, u64, u64, u64, u64, u64, u64) -> u64], a: ptr[u8], b: ptr[u8], op: u32, x1: u64, x2: u64, x3: u64, x4: u64, x5: u64, x6: u64, x7: u64) -> u64:
    unsicher:
        gib_zurück f(a, b, op, x1, x2, x3, x4, x5, x6, x7)




