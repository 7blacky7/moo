struktur BufferFeldSicht:
    bytes: puffer[u8]
    marke: u64
struktur BufferFeldSpeicher:
    bytes: [u8; 9]

@nativ
funktion buffer_feld_falsch() -> BufferFeldSicht:
    setze speicher: BufferFeldSpeicher auf 0
    setze sicht: BufferFeldSicht auf 0
    setze sicht.bytes auf byteansicht(speicher.bytes)
    setze kopie: BufferFeldSicht auf sicht
    gib_zurück kopie
