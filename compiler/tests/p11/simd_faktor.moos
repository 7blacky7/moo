@nativ
@einstieg
@simd("skalar")
funktion faktor_16_skalar(p: ptr[u8], factor: u8, ziel: ptr[u8]) -> void:
    unsicher:
        setze a: u8x16 auf u8x16()
        setze i: u64 auf 0
        solange i < 16:
            a[i] = p[i]
            setze i auf i + 1
        setze r: u8x16 auf simd_gf256_mal_faktor(a, factor)
        setze i auf 0
        solange i < 16:
            ziel[i] = r[i]
            setze i auf i + 1

