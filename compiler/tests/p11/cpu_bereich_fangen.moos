extern "C" funktion sched_getaffinity(pid: i32, bytes: u64, maske: ptr[u64]) -> i32

@nativ
funktion cpu_maske() -> u64:
    unsicher:
        setze maske: [u64; 16] auf 0
        setze adresse: ptr[u64] auf zeiger(adresse_von(maske))
        wenn sched_getaffinity(0, 128, adresse) != 0:
            gib_zurück 0
        gib_zurück maske[0]

@nativ
@cpu_bereich
funktion cpu_bereich_fangbar(index: u64) -> u64:
    setze bytes: [u8; 1] auf 0
    setze view: puffer[u8] auf byteansicht(bytes)
    gib_zurück als(u64, view[index])

setze vorher auf 0
unsicher:
    setze vorher auf cpu_maske()
versuche:
    unsicher:
        zeige cpu_bereich_fangbar(2)
    zeige "FALSCH"
fange fehler:
    zeige "CPU-Bereich gefangen"
unsicher:
    wenn vorher != 0 und vorher == cpu_maske():
        zeige "CPU-Affinität restauriert"
    sonst:
        zeige "FALSCH"
