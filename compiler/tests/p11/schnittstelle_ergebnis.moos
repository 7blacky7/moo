importiere "schnittstelle_definitionen"

struktur Fehler implementiert Speicher:
    basis: u64
    funktion lesen(selbst, index: u64) -> u32:
        unsicher:
            gib_zurück u32(index)
    funktion schreiben(selbst, index: u64, wert: u64) -> void:
        unsicher:
            selbst.basis = wert
