@nativ
@einstieg
@simd("skalar")
funktion simd_puffer_16_skalar(p: ptr[u8], len: u64, start: u64, q: ptr[u8], qlen: u64, ziel: u64) -> void:
    unsicher:
        setze daten: puffer[u8] auf byteansicht(p, len)
        setze ausgabe: puffer[u8] auf byteansicht(q, qlen)
        setze v: u8x16 auf simd_laden(u8x16, daten, start)
        simd_speichern(ausgabe, ziel, v)

