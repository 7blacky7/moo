importiere ui_moo_surface

setze diag_status auf {}
diag_status["klicks"] = 0
diag_status["slider_cb"] = 0

funktion diag_auf_ok(w):
    diag_status["klicks"] = diag_status["klicks"] + 1
    gib_zurück wahr

funktion diag_auf_slider(w, wert):
    diag_status["slider_cb"] = diag_status["slider_cb"] + 1
    gib_zurück wahr

setze k auf uim_surface_wurzel(160, 120)
uim_hinzu(k, uim_label("A", 4, 4, 20, 12))
setze knopf auf uim_hinzu(k, uim_knopf("OK", 20, 20, 64, 24, diag_auf_ok))
setze regler auf uim_hinzu(k, uim_slider(20, 52, 100, 20, 0, 100, 25, diag_auf_slider))
setze rolle auf uim_hinzu(k, uim_scroll(20, 80, 120, 30, 80))
uim_hinzu(rolle, uim_label("CLIP", 4, 4, 60, 12))
uim_hinzu(rolle, uim_label("AUSSEN", 4, 40, 80, 12))

uim_surface_zeichne(k)
test_frame_save_bmp(uim_surface_snapshot(k), umgebung("MOO_SURFACE_DIFF_GOLDEN"))
zeige "DIAG-GOLDEN " + uim_surface_hash(k)

uim_surface_maus(k, 40, 32, wahr)
uim_surface_maus(k, 40, 32, falsch)
uim_surface_maus(k, 95, 62, wahr)
uim_surface_maus(k, 95, 62, falsch)
uim_surface_zeichne(k)
test_frame_save_bmp(uim_surface_snapshot(k), umgebung("MOO_SURFACE_DIFF_STATE"))
zeige "DIAG-STATE " + uim_surface_hash(k)
