importiere ui_moo_kern

setze layout13 auf uim_mock_wurzel(240, 140)
setze stapel13 auf uim_stapel(4, 4, 10, 10)
uim_layout_metriken_setze(stapel13, 0, 5, 3)
uim_layout_grenzen_setze(stapel13, 0, 0, 0, 0, wahr, wahr)
uim_clip_kinder_setze(stapel13, wahr)
setze la13 auf uim_label("A", 0, 0, 10, 10)
uim_layout_metriken_setze(la13, 2, 0, 0)
uim_layout_grenzen_setze(la13, 20, 10, 40, 20, falsch, falsch)
setze lb13 auf uim_label("B", 0, 0, 30, 8)
uim_layout_metriken_setze(lb13, 1, 0, 0)
uim_hinzu(stapel13, la13)
uim_hinzu(stapel13, lb13)
uim_stapel_layout(stapel13, "vertikal", 3)
uim_hinzu(layout13, stapel13)
setze ell13 auf uim_label("Türöffner Layout mit Ellipsis", 80, 10, 90, 18)
uim_layout_metriken_setze(ell13, 0, 2, 0)
uim_text_layout_setze(ell13, falsch, wahr)
uim_z_index_setze(ell13, 7)
uim_hinzu(layout13, ell13)
zeige "LAYOUT-METRICS " + text(la13["x"]) + "/" + text(la13["y"]) + "/" + text(lb13["y"])
zeige "LAYOUT-SIZE " + text(stapel13["b"]) + "/" + text(stapel13["h"]) + "/" + text(la13["b"])
zeige "LAYOUT-FLAGS " + text(stapel13["clip_kinder"]) + "/" + text(ell13["text_ellipsis"]) + "/" + text(ell13["z_index"])
zeige "LAYOUT-DRAW " + text(uim_mock_zeichne(layout13)) + "/" + text(länge(uim_mock_befehle(layout13)) > 0)
zeige "NATIVE-UI-13-LAYOUT-OK"
