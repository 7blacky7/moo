uim_mock_maus(w5c, 20, 55, falsch)
uim_mock_taste(w5c, "A", wahr, 0)
uim_mock_taste(w5c, "5", wahr, 0)
zeige "W5C-NUM " + nb5c["text"]
zeige "W5C-PW " + _uim_eingabe_anzeige(w5c, pw5c)
zeige "W5C-ML " + text(ml5c["mehrzeilig"])
uim_mock_maus(w5c, 20, 185, wahr)
uim_mock_maus(w5c, 20, 185, falsch)
uim_mock_taste(w5c, "Down", wahr, 0)
zeige "W5C-AUTO " + ac5c["text"] + "/" + text(ac5c["auswahl"])
