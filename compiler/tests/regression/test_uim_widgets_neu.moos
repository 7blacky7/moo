setze ml2_vert_ok auf uim_mock_taste(ml2_root, "Down", wahr, 0) and ml2_feld["cursor"] == 5 and ml2_feld["vertikal_spalte"] == 2
setze ml2_vert_ok auf ml2_vert_ok and uim_mock_taste(ml2_root, "Down", wahr, 0) and ml2_feld["cursor"] == 9 and ml2_feld["vertikal_spalte"] == 2
setze ml2_vert_ok auf ml2_vert_ok and uim_mock_taste(ml2_root, "Down", wahr, 0) and ml2_feld["cursor"] == 12 and ml2_feld["vertikal_spalte"] == 2
setze ml2_vert_ok auf ml2_vert_ok and uim_mock_taste(ml2_root, "Up", wahr, 0) and ml2_feld["cursor"] == 9
