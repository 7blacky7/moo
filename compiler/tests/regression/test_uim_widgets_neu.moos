# D14: Monatswechsel und danach Return, Enter, Space fuer Kalender UND Datepicker.
funktion t_kald14_aktivierung(typ_name, taste_name):
    setze pruef_root auf uim_mock_wurzel(420, 320)
    wenn typ_name == "calendar":
        setze pruef_widget auf uim_calendar(0, 0, 300, 190, 1, 2024, nichts)
        uim_hinzu(pruef_root, pruef_widget)
        pruef_root["fokus"] = pruef_widget
        pruef_widget["fokus_tag"] = 31
        pruef_widget["fokus_monat"] = 1
        pruef_widget["fokus_jahr"] = 2024
        uim_mock_taste(pruef_root, "PageDown", wahr, 0)
        uim_mock_taste(pruef_root, taste_name, wahr, 0)
        gib_zurück pruef_widget["monat"] == 2 and pruef_widget["auswahl_datum"][1] == 2 and pruef_widget["auswahl"] == 29
    setze pruef_widget auf uim_datepicker(0, 0, 240, 28, 1, 2024, nichts)
    uim_hinzu(pruef_root, pruef_widget)
    pruef_root["fokus"] = pruef_widget
    wenn not _uim_datepicker_oeffne(pruef_root, pruef_widget):
        gib_zurück falsch
    setze pruef_popup auf pruef_root["datepicker_overlay"]["kinder"][0]
    pruef_popup["fokus_tag"] = 31
    pruef_popup["fokus_monat"] = 1
    pruef_popup["fokus_jahr"] = 2024
    uim_mock_taste(pruef_root, "PageDown", wahr, 0)
    uim_mock_taste(pruef_root, taste_name, wahr, 0)
    gib_zurück pruef_widget["monat"] == 2 and pruef_widget["auswahl_datum"][1] == 2 and pruef_widget["auswahl"] == 29 and pruef_widget["offen"] == falsch

zeige "KALD14-AKTIV " + text(t_kald14_aktivierung("calendar", "Return") and t_kald14_aktivierung("calendar", "Enter") and t_kald14_aktivierung("calendar", "Space")) + "/" + text(t_kald14_aktivierung("datepicker", "Return") and t_kald14_aktivierung("datepicker", "Enter") and t_kald14_aktivierung("datepicker", "Space"))

