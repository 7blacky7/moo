uim_mock_taste(kald13_down_root, "PageDown", wahr, 0)
setze kald13_down_aussen_ok auf kald13_down["monat"] == 2 und kald13_down["fokus_tag"] == 15
zeige "KALD13-BOUNDS " + text(kald13_min_monat_ok und kald13_min_aussen_ok) + "/" + text(kald13_max_monat_ok und kald13_max_aussen_ok) + "/" + text(kald13_page_monat_ok und kald13_page_aussen_ok and kald13_down_monat_ok and kald13_down_aussen_ok)

