uim_kalender_auswahlmodus_setze(kald9_dp, "mehrfach")
setze kald9_dp_multi_ok auf uim_wert_setze(kald9_root, kald9_dp, [[20, 7, 2026], [5, 7, 2026], [12, 7, 2026]])
setze kald9_dp_multi_text auf _uim_datepicker_anzeige(kald9_dp)
setze kald9_dp_multi_wert auf uim_wert_hole(kald9_dp)
setze kald9_dp_sort_ok auf t_kald_datum_gleich(kald9_dp_multi_wert[0], [5, 7, 2026]) und t_kald_datum_gleich(kald9_dp_multi_wert[2], [20, 7, 2026])
setze kald9_dp_leer_ok auf uim_wert_setze(kald9_root, kald9_dp, []) und _uim_datepicker_anzeige(kald9_dp) == ""
zeige "KALD12-DP " + text(kald9_dp_bereich_ok) + "/" + kald9_dp_bereich_text + "/" + text(kald9_dp_multi_ok und kald9_dp_sort_ok) + "/" + kald9_dp_multi_text + "/" + text(kald9_dp_leer_ok)

