uim_mock_taste(kald7_dp_root, "PageUp", wahr, 0)
setze kald7_dp_page_up_ok auf kald7_popup["fokus_tag"] == 29 and kald7_popup["fokus_monat"] == 2
uim_mock_taste(kald7_dp_root, "PageDown", wahr, 0)
setze kald7_dp_page_down_ok auf kald7_popup["fokus_tag"] == 29 and kald7_popup["fokus_monat"] == 3
zeige "KALD7-DP " + text(kald7_dp_open_ok and kald7_dp_left_ok and kald7_dp_pfeile_ok) + "/" + text(kald7_dp_home_ok and kald7_dp_end_ok) + "/" + text(kald7_dp_page_up_ok and kald7_dp_page_down_ok) + "/" + text(kald7_dp["auswahl"] == 1 and S["kald_rufe"] == 0)
uim_mock_taste(kald7_dp_root, "Escape", wahr, 0)

# D8: Feldklick, einmaliges Overlay, Fokusfalle, Escape/Outside und Fokusrestauration.
setze kald8_root auf uim_mock_wurzel(420, 320)
setze kald8_dp auf uim_datepicker(10, 10, 220, 28, 7, 2026, t_kald_auswahl)
uim_hinzu(kald8_root, kald8_dp)
kald8_root["fokus"] = kald8_dp
S["kald_rufe"] = 0
uim_mock_maus(kald8_root, 30, 20, wahr)
uim_mock_maus(kald8_root, 30, 20, falsch)
setze kald8_overlay auf kald8_root["datepicker_overlay"]
setze kald8_uid auf kald8_overlay["uid"]
setze kald8_open_ok auf kald8_dp["offen"] and kald8_overlay["offen"] and kald8_overlay["modal"] and kald8_root["modal_overlay"]["uid"] == kald8_uid and kald8_root["fokus"]["uid"] == kald8_overlay["kinder"][0]["uid"]
uim_mock_taste(kald8_root, "Tab", wahr, 0)
setze kald8_trap_ok auf kald8_root["fokus"]["uid"] == kald8_overlay["kinder"][0]["uid"]
uim_mock_taste(kald8_root, "Escape", wahr, 0)
setze kald8_escape_ok auf kald8_dp["offen"] == falsch and kald8_overlay["offen"] == falsch and kald8_root["fokus"]["uid"] == kald8_dp["uid"]
uim_mock_maus(kald8_root, 30, 20, wahr)
uim_mock_maus(kald8_root, 30, 20, falsch)
setze kald8_reuse_ok auf kald8_root["datepicker_overlay"]["uid"] == kald8_uid and länge(kald8_root["wurzel"]["kinder"]) == 2 and länge(kald8_overlay["kinder"]) == 1
uim_mock_maus(kald8_root, 410, 310, wahr)
uim_mock_maus(kald8_root, 410, 310, falsch)
setze kald8_outside_ok auf kald8_dp["offen"] == falsch and kald8_overlay["offen"] == falsch and kald8_root["fokus"]["uid"] == kald8_dp["uid"]
zeige "KALD8-LIFE " + text(kald8_open_ok and kald8_trap_ok) + "/" + text(kald8_escape_ok) + "/" + text(kald8_reuse_ok and kald8_outside_ok and S["kald_rufe"] == 0)

