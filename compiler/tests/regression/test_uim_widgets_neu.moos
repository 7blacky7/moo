setze kald7_page_up_ok auf kald7_cal["fokus_tag"] == 29 und kald7_cal["fokus_monat"] == 2
uim_mock_taste(kald7_root, "PageDown", wahr, 0)
setze kald7_page_down_ok auf kald7_cal["fokus_tag"] == 29 und kald7_cal["fokus_monat"] == 3
