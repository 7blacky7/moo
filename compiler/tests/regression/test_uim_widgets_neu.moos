setze ml2_home_end_ok auf ml2_home_end_ok and uim_mock_taste(ml2_root, "End", wahr, 0) and ml2_feld["cursor"] == 5
ml2_feld["cursor"] = 2
setze ml2_home_end_ok auf ml2_home_end_ok and uim_mock_taste(ml2_root, "Home", wahr, 0) and ml2_feld["cursor"] == 0
setze ml2_home_end_ok auf ml2_home_end_ok and uim_mock_taste(ml2_root, "End", wahr, 0) and ml2_feld["cursor"] == 3
zeige "ML2-HOME-END " + text(ml2_home_end_ok)

ml2_feld["cursor"] = 3
