setze kald9_multi auf uim_wert_hole(kald9_cal)
setze kald9_multi_ok auf kald9_multi_ok und t_kald_datum_gleich(kald9_multi[0], [5, 7, 2026]) und t_kald_datum_gleich(kald9_multi[1], [12, 7, 2026]) und t_kald_datum_gleich(kald9_multi[2], [20, 7, 2026])
zeige "KALD9-CAL-API " + text(kald9_einzel_ok) + "/" + text(kald9_bereich_ok) + "/" + text(kald9_multi_ok)
uim_kalender_auswahlmodus_setze(kald9_dp, "bereich")
setze kald9_dp_bereich_ok auf uim_wert_setze(kald9_root, kald9_dp, [[20, 7, 2026], [5, 7, 2026]])
