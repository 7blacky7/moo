für befehl in uim_mock_befehle(cal5e_klein_root):
    wenn befehl["op"] == "text" und befehl["args"][2] == "1":
        setze cal5e_zelle_ok auf befehl["args"][1] >= cal5e_klein["y"] + 25 und befehl["args"][1] + befehl["args"][3] <= cal5e_klein["y"] + 24 + cal5e_zelle_h - 2
