uim_mock_taste(kald11_root, "Return", wahr, 0)
setze kald11_block_ok auf S["kald_rufe"] == 0 und kald11["auswahl"] == 1
uim_mock_taste(kald11_root, "Right", wahr, 0)
uim_mock_taste(kald11_root, "Return", wahr, 0)
