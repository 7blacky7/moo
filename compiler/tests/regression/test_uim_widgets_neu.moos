    gib_zurück wahr

funktion t_ml1_return_probe(initial, cursor_pos, erwartet, erwartet_cursor):
    S["ml1_eingabe"] = 0
    S["ml1_wechsel"] = 0
    setze ml1_root auf uim_mock_wurzel(320, 160)
    setze ml1_feld auf uim_textarea(10, 10, 260, 90, initial, t_ml1_wechsel)
    uim_event_setze(ml1_feld, "eingabe", t_ml1_eingabe)
    setze ml1_state auf {"wert": initial}
    uim_bind(ml1_feld, ml1_state, "wert", "text")
    uim_hinzu(ml1_root, ml1_feld)
    ml1_root["fokus"] = ml1_feld
    ml1_feld["cursor"] = cursor_pos
    uim_mock_zeichne(ml1_root)
    setze ml1_return auf uim_mock_taste(ml1_root, "Return", wahr, 0)
    setze ml1_repaint auf ml1_root["backend_zustand"]["ungueltig"]
    setze ml1_edit_ok auf ml1_feld["text"] == erwartet and uim_wert_hole(ml1_feld) == erwartet and ml1_feld["cursor"] == erwartet_cursor and ml1_state["wert"] == erwartet and S["ml1_eingabe"] == 1 and S["ml1_wechsel"] == 1 and länge(ml1_feld["undo_stapel"]) == 1
    setze ml1_undo_ok auf uim_text_undo(ml1_root, ml1_feld) and ml1_feld["text"] == initial and ml1_state["wert"] == initial and S["ml1_eingabe"] == 2 and S["ml1_wechsel"] == 2
    setze ml1_redo_ok auf uim_text_redo(ml1_root, ml1_feld) and ml1_feld["text"] == erwartet and ml1_state["wert"] == erwartet and S["ml1_eingabe"] == 3 and S["ml1_wechsel"] == 3
    gib_zurück ml1_return and ml1_repaint and ml1_edit_ok and ml1_undo_ok and ml1_redo_ok

zeige "ML1-RETURN-POS " + text(t_ml1_return_probe("ab", 0, "\nab", 1)) + "/" + text(t_ml1_return_probe("ab", 1, "a\nb", 2)) + "/" + text(t_ml1_return_probe("ab", 2, "ab\n", 3))

