zeige "KALB-A " + text(kalb_a_modus_ok und kalb_a_erste_ok und kalb_a_zweite_ok und kalb_a_abwahl_ok) + "/" + text(kalb_a_wert_ok) + "/" + text(kalb_a_state_ok) + "/" + text(kalb_a_interaktion_ok)

kalb_a["zustand"] = "selected"
setze kalb_b_setzen_ok auf uim_wert_setze(kalb_root, kalb_a, [])
setze kalb_b_wert auf uim_wert_hole(kalb_a)
setze kalb_b_leer_ok auf länge(kalb_b_wert) == 0
setze kalb_b_state_ok auf kalb_a["selected"] == falsch und kalb_a["zustand"] == "normal" und _uim_zustand_aktuell(kalb_root, kalb_a) == "normal"
zeige "KALB-B " + text(kalb_b_setzen_ok) + "/" + text(kalb_b_leer_ok) + "/" + text(kalb_b_state_ok)

setze kalb_c auf uim_calendar(0, 0, 280, 180, 7, 2026, nichts)
setze kalb_c_multi_ok auf uim_kalender_auswahlmodus_setze(kalb_c, "mehrfach")
setze kalb_c_wahl_ok auf _uim_kalender_auswahl_anwenden(nichts, kalb_c, [2, 7, 2026], falsch)
setze kalb_c_fokus_tag auf kalb_c["fokus_tag"]
setze kalb_c_fokus_monat auf kalb_c["fokus_monat"]
setze kalb_c_fokus_jahr auf kalb_c["fokus_jahr"]
setze kalb_c_modus_ok auf uim_kalender_auswahlmodus_setze(kalb_c, "bereich")
setze kalb_c_wert auf uim_wert_hole(kalb_c)
setze kalb_c_leer_ok auf länge(kalb_c_wert) == 0
setze kalb_c_state_ok auf kalb_c["selected"] == falsch und kalb_c["zustand"] == "normal"
setze kalb_c_fokus_ok auf kalb_c["fokus_tag"] == kalb_c_fokus_tag und kalb_c["fokus_monat"] == kalb_c_fokus_monat und kalb_c["fokus_jahr"] == kalb_c_fokus_jahr
zeige "KALB-C " + text(kalb_c_multi_ok und kalb_c_wahl_ok und kalb_c_modus_ok) + "/" + text(kalb_c_leer_ok) + "/" + text(kalb_c_state_ok) + "/" + text(kalb_c_fokus_ok)

# W6-KALENDER Etappe 3+4: Regressionsmatrix D1-D6, D9-D13.
S["kald_rufe"] = 0
funktion t_kald_auswahl(w, wert):
    S["kald_rufe"] = S["kald_rufe"] + 1
    gib_zurück wahr

funktion t_kald_datum_gleich(a, b):
    gib_zurück länge(a) == 3 und länge(b) == 3 und a[0] == b[0] und a[1] == b[1] und a[2] == b[2]

# D1: Einzel per echten Klicks, Getter, Legacy-Spiegel und Callback.
setze kald1_root auf uim_mock_wurzel(320, 210)
setze kald1 auf uim_calendar(0, 0, 280, 180, 7, 2026, t_kald_auswahl)
uim_hinzu(kald1_root, kald1)
S["kald_rufe"] = 0
uim_mock_maus(kald1_root, 90, 62, wahr)
uim_mock_maus(kald1_root, 90, 62, falsch)
uim_mock_maus(kald1_root, 130, 62, wahr)
uim_mock_maus(kald1_root, 130, 62, falsch)
zeige "KALD1-EINZEL " + text(uim_wert_hole(kald1) == 2) + "/" + text(kald1["auswahl"] == 2 und kald1["auswahl_datum"][0] == 2) + "/" + text(S["kald_rufe"] == 2)

# D2: Bereich vorwaerts, neuer Start und rueckwaerts normalisiert.
setze kald2 auf uim_calendar(0, 0, 280, 180, 7, 2026, nichts)
uim_kalender_auswahlmodus_setze(kald2, "bereich")
_uim_kalender_auswahl_anwenden(nichts, kald2, [10, 7, 2026], falsch)
_uim_kalender_auswahl_anwenden(nichts, kald2, [20, 7, 2026], falsch)
setze kald2_vor auf uim_wert_hole(kald2)
_uim_kalender_auswahl_anwenden(nichts, kald2, [5, 7, 2026], falsch)
setze kald2_neu auf uim_wert_hole(kald2)
setze kald2_rueck auf uim_calendar(0, 0, 280, 180, 7, 2026, nichts)
uim_kalender_auswahlmodus_setze(kald2_rueck, "bereich")
_uim_kalender_auswahl_anwenden(nichts, kald2_rueck, [20, 7, 2026], falsch)
_uim_kalender_auswahl_anwenden(nichts, kald2_rueck, [10, 7, 2026], falsch)
setze kald2_rueck_wert auf uim_wert_hole(kald2_rueck)
zeige "KALD2-BEREICH " + text(t_kald_datum_gleich(kald2_vor[0], [10, 7, 2026]) und t_kald_datum_gleich(kald2_vor[1], [20, 7, 2026])) + "/" + text(länge(kald2_neu) == 1 und t_kald_datum_gleich(kald2_neu[0], [5, 7, 2026])) + "/" + text(t_kald_datum_gleich(kald2_rueck_wert[0], [10, 7, 2026]) und t_kald_datum_gleich(kald2_rueck_wert[1], [20, 7, 2026]))

# D3: Mehrfach hinzufuegen und abwaehlen.
setze kald3 auf uim_calendar(0, 0, 280, 180, 7, 2026, nichts)
uim_kalender_auswahlmodus_setze(kald3, "mehrfach")
_uim_kalender_auswahl_anwenden(nichts, kald3, [10, 7, 2026], falsch)
_uim_kalender_auswahl_anwenden(nichts, kald3, [12, 7, 2026], falsch)
_uim_kalender_auswahl_anwenden(nichts, kald3, [10, 7, 2026], falsch)
setze kald3_wert auf uim_wert_hole(kald3)
zeige "KALD3-MEHRFACH " + text(länge(kald3_wert) == 1) + "/" + text(t_kald_datum_gleich(kald3_wert[0], [12, 7, 2026]))

# D4: Gesperrte Tage und Bounds blockieren Klick und Auswahl; Tastatur springt nur auf erlaubte Daten.
setze kald4_root auf uim_mock_wurzel(320, 210)
setze kald4 auf uim_calendar(0, 0, 280, 180, 7, 2026, t_kald_auswahl)
uim_hinzu(kald4_root, kald4)
