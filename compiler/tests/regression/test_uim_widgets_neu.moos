    wenn erwartet_umbruch:
        gib_zurück ml5_s_ret and ml5_s_repaint and ml5_s_feld["text"] == "X\n" and ml5_s_feld["cursor"] == 2 and S["ml5_eingabe"] == 1 and S["ml5_wechsel"] == 1
    gib_zurück ml5_s_ret and ml5_s_repaint and ml5_s_feld["text"] == "X" and ml5_s_feld["cursor"] == 1 and S["ml5_eingabe"] == 0 and S["ml5_wechsel"] == 0 and länge(ml5_s_feld["undo_stapel"]) == 0

zeige "ML5-DIALOG-LF " + text(t_ml5_dialog_probe(0, wahr)) + "/" + text(t_ml5_dialog_probe(1, wahr))
zeige "ML5-DIALOG-CTRL " + text(t_ml5_dialog_probe(2, falsch)) + "/" + text(t_ml5_dialog_probe(3, falsch))
zeige "ML5-STANDALONE-LF " + text(t_ml5_standalone_probe(0, wahr)) + "/" + text(t_ml5_standalone_probe(1, wahr))
zeige "ML5-STANDALONE-CTRL " + text(t_ml5_standalone_probe(2, falsch)) + "/" + text(t_ml5_standalone_probe(3, falsch))

