zeige "W5B-RAD " + text(icon5["scroll_y"] > 0)
zeige "W5B-DRAW " + text(uim_mock_zeichne(w5))

funktion t_w5b_text_gerendert(befehle, suchtext):
    setze gefunden auf falsch
    für befehl in befehle:
        wenn befehl["op"] == "text" und befehl["args"][2] == suchtext:
            setze gefunden auf wahr
    gib_zurück gefunden

setze clip5b_liste_root auf uim_mock_wurzel(140, 60)
setze clip5b_liste auf uim_liste(10, 10, 100, 30, ["EINS", "ZWEI"], t_w5_icon)
uim_hinzu(clip5b_liste_root, clip5b_liste)
uim_mock_zeichne(clip5b_liste_root)
zeige "W5B-CLIP-LIST " + text(t_w5b_text_gerendert(uim_mock_befehle(clip5b_liste_root), "ZWEI") == falsch)

setze clip5b_icon_root auf uim_mock_wurzel(120, 110)
setze clip5b_icon auf uim_iconview(10, 10, 80, 80, [{"icon": "A", "text": "EinSehrLangerName"}, {"icon": "B", "text": "Zwei"}], t_w5_icon)
uim_hinzu(clip5b_icon_root, clip5b_icon)
uim_mock_zeichne(clip5b_icon_root)
zeige "W5B-CLIP-ICON " + text(t_w5b_text_gerendert(uim_mock_befehle(clip5b_icon_root), "Zwei") == falsch)
zeige "W5B-ELLIPSIS " + text(t_w5b_text_gerendert(uim_mock_befehle(clip5b_icon_root), "EinSehrLangerName") == falsch)
zeige "NATIVE-UI-12-W5B-OK"
# --- NATIVE-UI-12/W5C: Text+ ---
S["w5c_rufe"] = 0
funktion t_w5c(w, wert):
