uim_kalender_gesperrte_tage_setze(kald4, [[8, 7, 2026]])
S["kald_rufe"] = 0
uim_mock_maus(kald4_root, 90, 62, wahr)
uim_mock_maus(kald4_root, 90, 62, falsch)
uim_mock_maus(kald4_root, 90, 85, wahr)
uim_mock_maus(kald4_root, 90, 85, falsch)
uim_mock_maus(kald4_root, 220, 132, wahr)
uim_mock_maus(kald4_root, 220, 132, falsch)
setze kald4_klick_ok auf kald4["auswahl"] == 1 und S["kald_rufe"] == 0
kald4_root["fokus"] = kald4
kald4["fokus_tag"] = 1
kald4["fokus_monat"] = 7
kald4["fokus_jahr"] = 2026
uim_mock_taste(kald4_root, "Down", wahr, 0)
setze kald4_gesperrt_ok auf kald4["fokus_tag"] == 9 und kald4["auswahl"] == 1
kald4["fokus_tag"] = 3
uim_mock_taste(kald4_root, "Left", wahr, 0)
setze kald4_min_ok auf kald4["fokus_tag"] == 3
kald4["fokus_tag"] = 20
uim_mock_taste(kald4_root, "Right", wahr, 0)
setze kald4_max_ok auf kald4["fokus_tag"] == 20 und S["kald_rufe"] == 0
zeige "KALD4-SPERREN " + text(kald4_klick_ok) + "/" + text(kald4_gesperrt_ok) + "/" + text(kald4_min_ok) + "/" + text(kald4_max_ok)

# D5: neun handverifizierte ISO-KW-Instanzen plus gerenderte KW-Spalte.
zeige "KALD5-ISO " + text(_uim_kalender_iso_woche([29, 12, 2014])) + "/" + text(_uim_kalender_iso_woche([1, 1, 2016])) + "/" + text(_uim_kalender_iso_woche([3, 1, 2016])) + "/" + text(_uim_kalender_iso_woche([31, 12, 2018])) + "/" + text(_uim_kalender_iso_woche([30, 12, 2019])) + "/" + text(_uim_kalender_iso_woche([31, 12, 2020])) + "/" + text(_uim_kalender_iso_woche([1, 1, 2021])) + "/" + text(_uim_kalender_iso_woche([3, 1, 2021])) + "/" + text(_uim_kalender_iso_woche([3, 1, 2022]))
setze kald5_root auf uim_mock_wurzel(340, 220)
setze kald5 auf uim_calendar(0, 0, 320, 190, 1, 2016, nichts)
uim_kalender_wochennummern_setze(kald5, wahr)
uim_hinzu(kald5_root, kald5)
uim_mock_zeichne(kald5_root)
setze kald5_kw53 auf falsch
setze kald5_kw1 auf falsch
für kald5_befehl in uim_mock_befehle(kald5_root):
    wenn kald5_befehl["op"] == "text" und kald5_befehl["args"][0] == 3 und kald5_befehl["args"][2] == "53":
        setze kald5_kw53 auf wahr
    wenn kald5_befehl["op"] == "text" und kald5_befehl["args"][0] == 3 und kald5_befehl["args"][2] == "1":
        setze kald5_kw1 auf wahr
zeige "KALD5-RENDER " + text(kald5_kw53) + "/" + text(kald5_kw1)

# D6: Terminmarker erzeugt genau einen Kreis und veraendert die Auswahl nicht.
