setze api2_layout_de auf uim_gitter(0, 0, 80, 40)
setze api2_layout_en auf uim_grid(0, 0, 80, 40)
uim_gitter_layout(api2_layout_de, 2, 3)
uim_grid_layout(api2_layout_en, 2, 3)
setze api2_ops auf api2_ops und api2_paar_gleich(api2_layout_de, api2_layout_en)
setze api2_overlay_de auf uim_ueberlagerung(0, 0, 80, 40)
setze api2_overlay_en auf uim_overlay(0, 0, 80, 40)
uim_ueberlagerung_setze(api2_k_de, api2_overlay_de, wahr, wahr)
uim_overlay_setze(api2_k_en, api2_overlay_en, wahr, wahr)
setze api2_ops auf api2_ops und api2_paar_gleich(api2_overlay_de, api2_overlay_en)
zeige "API2-OPS " + text(api2_ops)
zeige "W6-API2-OK"
