# --- NATIVE-UI-12/W5E: ColorPicker, DatePicker, Calendar ---
S["w5e_rufe"] = 0
funktion t_w5e(w, wert):
    S["w5e_rufe"] = S["w5e_rufe"] + 1
    gib_zurück wahr

funktion t_w5e_kalender_aktivierung(taste):
    setze wurzel auf uim_mock_wurzel(320, 210)
    setze kalender auf uim_calendar(0, 0, 280, 180, 7, 2026, nichts)
    uim_hinzu(wurzel, kalender)
    uim_mock_maus(wurzel, 90, 62, wahr)
    uim_mock_maus(wurzel, 90, 62, falsch)
    uim_mock_taste(wurzel, "Down", wahr, 0)
    setze navigation_ok auf kalender["fokus_tag"] == 8 und kalender["auswahl"] == 1
    uim_mock_taste(wurzel, taste, wahr, 0)
    gib_zurück navigation_ok und kalender["auswahl"] == 8

setze w5e auf uim_mock_wurzel(520, 300)
setze farben5e auf [[255, 0, 0, 255], [0, 255, 0, 255], [0, 0, 255, 255], [255, 255, 0, 255]]
setze cp5e auf uim_colorpicker(10, 10, 120, 48, farben5e, t_w5e)
setze cal5e auf uim_calendar(160, 10, 280, 180, 7, 2026, t_w5e)
setze dp5e auf uim_datepicker(10, 80, 120, 180, 7, 2026, t_w5e)
uim_hinzu(w5e, cp5e)
uim_hinzu(w5e, cal5e)
uim_hinzu(w5e, dp5e)
zeige "W5E-FACTORY " + text(cp5e["typ"] == "colorpicker") + "/" + text(cal5e["typ"] == "calendar") + "/" + text(dp5e["typ"] == "datepicker")
uim_mock_maus(w5e, 35, 20, wahr)
uim_mock_maus(w5e, 35, 20, falsch)
uim_mock_taste(w5e, "Right", wahr, 0)
zeige "W5E-COLOR " + text(cp5e["auswahl"])
uim_mock_maus(w5e, 250, 62, wahr)
uim_mock_maus(w5e, 250, 62, falsch)
uim_mock_taste(w5e, "Down", wahr, 0)
setze w5e_cal_navigation_ok auf cal5e["fokus_tag"] == 8 und cal5e["auswahl"] == 1
uim_mock_taste(w5e, "Return", wahr, 0)
zeige "W5E-CAL " + text(cal5e["auswahl"])
zeige "W5E-CAL-TASTEN " + text(w5e_cal_navigation_ok und cal5e["auswahl"] == 8) + "/" + text(t_w5e_kalender_aktivierung("Enter")) + "/" + text(t_w5e_kalender_aktivierung("Space"))
zeige "W5E-DRAW " + text(uim_mock_zeichne(w5e))
setze cal5e_klein_root auf uim_mock_wurzel(380, 150)
setze cal5e_klein auf uim_calendar(10, 10, 356, 120, 7, 2026, t_w5e)
uim_hinzu(cal5e_klein_root, cal5e_klein)
uim_mock_zeichne(cal5e_klein_root)
setze cal5e_zelle_ok auf falsch
setze cal5e_header_pad auf falsch
setze cal5e_zelle_h auf (cal5e_klein["h"] - 40) / 6
für befehl in uim_mock_befehle(cal5e_klein_root):
    wenn befehl["op"] == "text" und befehl["args"][2] == "1":
        setze cal5e_zelle_ok auf befehl["args"][1] >= cal5e_klein["y"] + 41 und befehl["args"][1] + befehl["args"][3] <= cal5e_klein["y"] + 40 + cal5e_zelle_h - 2
    wenn befehl["op"] == "text" und befehl["args"][2] == "Juli 2026" und befehl["args"][0] == cal5e_klein["x"] + 34 und befehl["args"][1] == cal5e_klein["y"] + 5:
        setze cal5e_header_pad auf wahr
zeige "W5E-CELL-BOUNDS " + text(cal5e_zelle_ok)
zeige "W5E-HEADER-PAD " + text(cal5e_header_pad)
zeige "NATIVE-UI-12-W5E-OK"
