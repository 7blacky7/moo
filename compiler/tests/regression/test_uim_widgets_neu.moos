# --- W6-API3: Builder und klassische Konstruktion ergeben dieselbe Geometrie ---
funktion api3_geometrie_gleich(a, b):
    wenn a["x"] != b["x"] oder a["y"] != b["y"] oder a["b"] != b["b"] oder a["h"] != b["h"]:
        gib_zurück falsch
    wenn länge(a["kinder"]) != länge(b["kinder"]):
        gib_zurück falsch
    setze i auf 0
    solange i < länge(a["kinder"]):
        setze ak auf a["kinder"][i]
        setze bk auf b["kinder"][i]
        wenn ak["x"] != bk["x"] oder ak["y"] != bk["y"] oder ak["b"] != bk["b"] oder ak["h"] != bk["h"]:
            gib_zurück falsch
        setze i auf i + 1
    gib_zurück wahr

setze api3_alt auf uim_stapel(0, 0, 240, 150)
uim_layout_metriken_setze(api3_alt, 0, 12, 8)
uim_hinzu(api3_alt, uim_label("Name", 0, 0, 100, 20))
uim_hinzu(api3_alt, uim_textfeld(0, 0, 180, 26, "Ada", nichts))
uim_hinzu(api3_alt, uim_knopf("Speichern", 0, 0, 100, 28, nichts))
uim_stapel_layout(api3_alt, "vertikal", 8)
setze api3_builder auf uim_baue("stapel", {"x": 0, "y": 0, "b": 240, "h": 150, "padding": 12, "gap": 8, "richtung": "vertikal", "kinder": [uim_baue("label", {"text": "Name", "b": 100, "h": 20}), uim_baue("textfield", {"wert": "Ada", "b": 180, "h": 26}), uim_baue("button", {"text": "Speichern", "b": 100, "h": 28})]})
zeige "API3-GEOMETRIE " + text(api3_geometrie_gleich(api3_alt, api3_builder))

