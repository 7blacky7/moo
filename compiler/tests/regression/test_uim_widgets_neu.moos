setze ml2_lr_ok auf ml2_lr_ok and uim_mock_taste(ml2_root, "Left", wahr, 0) and ml2_feld["cursor"] == 2
setze ml2_lr_ok auf ml2_lr_ok and uim_mock_taste(ml2_root, "Left", wahr, 0) and ml2_feld["cursor"] == 0
setze ml2_lr_ok auf ml2_lr_ok and uim_mock_taste(ml2_root, "Right", wahr, 0) and ml2_feld["cursor"] == 2
setze ml2_lr_ok auf ml2_lr_ok and uim_mock_taste(ml2_root, "Right", wahr, 0) and ml2_feld["cursor"] == 3
setze ml2_lr_ok auf ml2_lr_ok and uim_mock_taste(ml2_root, "Right", wahr, 0) and ml2_feld["cursor"] == 4
