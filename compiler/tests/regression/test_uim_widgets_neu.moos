# --- W6-API2: deutsche und englische Namen bleiben verhaltensgleich ---
funktion api2_paar_gleich(a, b):
    wenn typ_von(a) != typ_von(b):
        gib_zurück falsch
    für feld in ["typ", "text", "titel", "beschriftung", "zustand", "wert", "min", "max", "auswahl", "monat", "jahr", "quelle", "alt", "offen", "sichtbar", "richtung", "anteil", "beschaeftigt", "unbestimmt", "phase", "zeilen", "spalten", "abstand", "min1", "min2", "schliesst_aussen"]:
        wenn a.enthält(feld) != b.enthält(feld):
            gib_zurück falsch
        wenn a.enthält(feld) und typ_von(a[feld]) == "Liste" und länge(a[feld]) != länge(b[feld]):
            gib_zurück falsch
        wenn a.enthält(feld) und typ_von(a[feld]) != "Liste" und a[feld] != b[feld]:
            gib_zurück falsch
    gib_zurück wahr

