S["kald_rufe"] = 0
setze kald12_range_open_ok auf _uim_datepicker_oeffne(kald12_range_root, kald12_range) and S["kald_rufe"] == 0
setze kald12_range_popup auf kald12_range_root["datepicker_overlay"]["kinder"][0]
