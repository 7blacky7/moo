# --- NATIVE-UI-12/W5G: Terminal + Markdown Viewer ---
funktion t_w5g(w):
    S["w5g_rufe"] = S["w5g_rufe"] + 1
    gib_zurück falsch

S["w5g_rufe"] = 0

setze w5g auf uim_mock_wurzel(420, 220)
setze term5g auf uim_terminal(10, 10, 180, 90, "MOO shell", t_w5g)
setze md5g_inhalt auf ["# Titel", "CODE: test()", "- Punkt", "- Zweiter Punkt", "- Dritter Punkt", "- Vierter Punkt", "- Fuenfter Punkt", "- Sechster Punkt"].verbinden("\n")
setze md5g auf uim_markdown(210, 10, 180, 60, md5g_inhalt)
uim_hinzu(w5g, term5g)
uim_hinzu(w5g, md5g)
zeige "W5G-FACTORY " + text(term5g["typ"] == "terminal") + "/" + text(md5g["typ"] == "markdown")
uim_mock_maus(w5g, 30, 30, wahr)
uim_mock_maus(w5g, 30, 30, falsch)
uim_mock_taste(w5g, "h", wahr, 0)
uim_mock_taste(w5g, "i", wahr, 0)
setze w5g_command auf term5g["eingabe"]
uim_mock_zeichne(w5g)
setze w5g_callback_ok auf uim_mock_taste(w5g, "Return", wahr, 0)
setze w5g_return_repaint auf w5g["backend_zustand"]["ungueltig"]
setze w5g_return_einmal auf S["w5g_rufe"] == 1 and länge(term5g["history"]) == 1 and term5g["history"][0] == "hi" and term5g["eingabe"] == "" and term5g["zeilen"][länge(term5g["zeilen"]) - 1] == "> hi"
zeige "W5G-CALLBACK " + text(w5g_callback_ok)
zeige "W5G-COMMAND " + w5g_command
uim_mock_zeichne(w5g)
setze w5g_space_ok auf uim_mock_taste(w5g, "space", wahr, 0)
setze w5g_space_repaint auf w5g["backend_zustand"]["ungueltig"]
setze w5g_space_einmal auf term5g["eingabe"] == " " and term5g["cursor"] == 1 and S["w5g_rufe"] == 1
zeige "W5G-TERMINAL-TASTEN " + text(w5g_return_einmal) + "/" + text(w5g_space_einmal) + "/" + text(w5g_callback_ok and w5g_space_ok) + "/" + text(w5g_return_repaint and w5g_space_repaint)
uim_mock_taste(w5g, "BackSpace", wahr, 0)
uim_mock_taste(w5g, "Up", wahr, 0)
zeige "W5G-HISTORY " + term5g["eingabe"]
uim_mock_maus(w5g, 230, 30, wahr)
uim_mock_maus(w5g, 230, 30, falsch)
uim_mock_taste(w5g, "Down", wahr, 0)
zeige "W5G-SCROLL " + text(md5g["scroll_y"] > 0)
uim_terminal_ausgabe(w5g, term5g, ["OK", "READY"].verbinden("\n"))
zeige "W5G-DRAW " + text(uim_mock_zeichne(w5g))
setze w5g_fokus_innen auf falsch
setze w5g_code_text_y auf -1
setze w5g_code_schrift auf 0
setze w5g_code_mark_y auf -1
setze w5g_code_mark_h auf 0
für befehl in uim_mock_befehle(w5g):
    wenn befehl["op"] == "rechteck" und befehl["args"][0] == md5g["x"] + 1 und befehl["args"][1] == md5g["y"] + 1 und befehl["args"][2] == md5g["b"] - 2 und befehl["args"][3] == md5g["h"] - 2:
        setze w5g_fokus_innen auf wahr
    wenn befehl["op"] == "text" und befehl["args"][2] == "CODE: test()":
        setze w5g_code_text_y auf befehl["args"][1]
        setze w5g_code_schrift auf befehl["args"][3]
    wenn befehl["op"] == "rechteck" und befehl["args"][0] == md5g["x"] + 3 und befehl["args"][2] == md5g["b"] - 6:
        setze w5g_code_mark_y auf befehl["args"][1]
        setze w5g_code_mark_h auf befehl["args"][3]
zeige "W5G-FOCUS-INSET " + text(w5g_fokus_innen)
setze w5g_code_mark_innen auf w5g_code_text_y >= 0 und w5g_code_mark_y == w5g_code_text_y - 2 und w5g_code_mark_y + w5g_code_mark_h >= w5g_code_text_y + w5g_code_schrift
zeige "W5G-CODE-MARK-INSET " + text(w5g_code_mark_innen)
zeige "NATIVE-UI-12-W5G-OK"

# --- NATIVE-UI-13/VALID: Validator-Hook + Pflicht/Zahl/Format ---
funktion t_valid_name(w, wert):
    setze fehler auf uim_validierung_pflicht(wert, "PFLICHT")
    wenn fehler != "":
        gib_zurück fehler
    gib_zurück uim_validierung_format(wert, "^[A-Z]+$", "FORMAT")

funktion t_valid_range(w, wert):
    gib_zurück uim_validierung_zahl_bereich(wert, 0, 99, "BEREICH")

setze valid13 auf uim_mock_wurzel(420, 220)
setze name13 auf uim_textfeld(10, 10, 180, 24, "", nichts)
uim_hinzu(valid13, name13)
zeige "VALID-BIND " + text(uim_validierung_setze(valid13, name13, t_valid_name, "Nur Grossbuchstaben"))
zeige "VALID-EMPTY " + uim_eingabe_zustand_hole(name13) + "/" + uim_validierungsfehler_hole(name13) + "/" + name13["tooltip"]
uim_textfeld_setze(valid13, name13, "moo")
zeige "VALID-FORMAT " + uim_eingabe_zustand_hole(name13) + "/" + uim_validierungsfehler_hole(name13)
uim_textfeld_setze(valid13, name13, "MOO")
zeige "VALID-NAME-OK " + text(uim_validiere(valid13, name13)) + "/" + uim_eingabe_zustand_hole(name13) + "/" + name13["tooltip"]
setze zahl13 auf uim_numberbox(10, 70, 180, 24, 120, 0, 99, nichts)
uim_hinzu(valid13, zahl13)
uim_validierung_setze(valid13, zahl13, t_valid_range, "0 bis 99")
zeige "VALID-RANGE " + uim_eingabe_zustand_hole(zahl13) + "/" + uim_validierungsfehler_hole(zahl13)
zahl13["text"] = "42"
zeige "VALID-RANGE-OK " + text(uim_validiere(valid13, zahl13)) + "/" + zahl13["tooltip"]
name13["text"] = ""
uim_validiere(valid13, name13)
zeige "VALID-DRAW " + text(uim_mock_zeichne(valid13))
zeige "NATIVE-UI-13-VALID-OK"

