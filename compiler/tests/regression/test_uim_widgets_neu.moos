zeige "ML2-VERTIKAL " + text(ml2_vert_ok)

setze ml2_silent_ok auf ml2_feld["text"] == ml2_text and S["ml2_eingabe"] == 0 and S["ml2_wechsel"] == 0 and länge(ml2_feld["undo_stapel"]) == 0
