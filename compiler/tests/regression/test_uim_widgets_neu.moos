setze kald7_dp_left_ok auf kald7_popup["fokus_tag"] == 14
uim_mock_taste(kald7_dp_root, "Right", wahr, 0)
uim_mock_taste(kald7_dp_root, "Up", wahr, 0)
uim_mock_taste(kald7_dp_root, "Down", wahr, 0)
setze kald7_dp_pfeile_ok auf kald7_popup["fokus_tag"] == 15
uim_mock_taste(kald7_dp_root, "Home", wahr, 0)
setze kald7_dp_home_ok auf kald7_popup["fokus_tag"] == 11
uim_mock_taste(kald7_dp_root, "End", wahr, 0)
setze kald7_dp_end_ok auf kald7_popup["fokus_tag"] == 17
