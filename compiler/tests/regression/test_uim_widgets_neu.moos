kald13_page_root["fokus"] = kald13_page
uim_mock_taste(kald13_page_root, "PageUp", wahr, 0)
setze kald13_page_monat_ok auf kald13_page["monat"] == 2 und kald13_page["fokus_tag"] == 15
uim_mock_taste(kald13_page_root, "PageUp", wahr, 0)
setze kald13_page_aussen_ok auf kald13_page["monat"] == 2 und kald13_page["fokus_tag"] == 15
setze kald13_down_root auf uim_mock_wurzel(320, 210)
setze kald13_down auf uim_calendar(0, 0, 280, 180, 1, 2026, nichts)
uim_kalender_grenzen_setze(kald13_down, [], [15, 2, 2026])
