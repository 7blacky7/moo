zeige "KALD10-ALIASE " + text(kald10_de_cal["typ"] == "calendar" and kald10_de_cal["x"] == 7 and kald10_de_cal["y"] == 8 and kald10_de_cal["b"] == 283 and kald10_de_cal["h"] == 183 and kald10_de_cal["monat"] == 10 and kald10_de_cal["jahr"] == 2029) + "/" + text(kald10_de_dp["typ"] == "datepicker" and kald10_de_dp["x"] == 9 and kald10_de_dp["y"] == 10 and kald10_de_dp["b"] == 184 and kald10_de_dp["h"] == 30 and kald10_de_dp["monat"] == 11 and kald10_de_dp["jahr"] == 2030)

