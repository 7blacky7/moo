# --- W6-MULTILINE/BATCH5: Return, Dialogstandard und Modbits ---
S["ml5_eingabe"] = 0
S["ml5_wechsel"] = 0
S["ml5_aktion"] = 0
S["ml5_index"] = 0 - 1
funktion t_ml5_eingabe(w, wert):
    S["ml5_eingabe"] = S["ml5_eingabe"] + 1
    gib_zurück wahr

funktion t_ml5_wechsel(w, wert):
    S["ml5_wechsel"] = S["ml5_wechsel"] + 1
    gib_zurück wahr

funktion t_ml5_aktion(w, aktions_index):
    S["ml5_aktion"] = S["ml5_aktion"] + 1
    S["ml5_index"] = aktions_index
    gib_zurück wahr

funktion t_ml5_dialog_probe(modbits, erwartet_umbruch):
    S["ml5_eingabe"] = 0
    S["ml5_wechsel"] = 0
    S["ml5_aktion"] = 0
    S["ml5_index"] = 0 - 1
    setze ml5_d_root auf uim_mock_wurzel(320, 180)
    setze ml5_d_dialog auf uim_nachricht("T", "N", ["OK"], t_ml5_aktion)
    setze ml5_d_feld auf uim_textarea(10, 10, 180, 60, "X", t_ml5_wechsel)
    uim_event_setze(ml5_d_feld, "eingabe", t_ml5_eingabe)
    ml5_d_feld["dialog"] = ml5_d_dialog
    uim_hinzu(ml5_d_dialog, ml5_d_feld)
    uim_hinzu(ml5_d_root, ml5_d_dialog)
    ml5_d_root["fokus"] = ml5_d_feld
    ml5_d_feld["cursor"] = 1
    uim_mock_zeichne(ml5_d_root)
    setze ml5_d_ret auf uim_mock_taste(ml5_d_root, "Return", wahr, modbits)
    setze ml5_d_repaint auf ml5_d_root["backend_zustand"]["ungueltig"]
    wenn erwartet_umbruch:
        gib_zurück ml5_d_ret and ml5_d_repaint and ml5_d_feld["text"] == "X\n" and ml5_d_feld["cursor"] == 2 and S["ml5_eingabe"] == 1 and S["ml5_wechsel"] == 1 and S["ml5_aktion"] == 0 and ml5_d_dialog["offen"]
    gib_zurück ml5_d_ret and ml5_d_repaint and ml5_d_feld["text"] == "X" and ml5_d_feld["cursor"] == 1 and S["ml5_eingabe"] == 0 and S["ml5_wechsel"] == 0 and S["ml5_aktion"] == 1 and S["ml5_index"] == 0 and ml5_d_dialog["offen"] == falsch

funktion t_ml5_standalone_probe(modbits, erwartet_umbruch):
    S["ml5_eingabe"] = 0
