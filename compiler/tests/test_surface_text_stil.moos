# C1-B3: Compilerbindung, Arity und Rueckgabevertraege der Surface-Textstile.

setze z_alt auf surface_new(64, 32)
setze z_neu auf surface_new(64, 32)
setze render_stil auf surface_text_stil(z_neu, 2, 2, 1, "A", 0, 255, 255, 255, 255)
setze breite_stil auf surface_text_breite_stil("A", 1, 1)
setze glyphen_status auf surface_text_glyphen_status("A", 0)

zeige "TYPEN " + text(typ_von(render_stil) == "Wahrheitswert") + "/" + text(typ_von(breite_stil) == "Zahl") + "/" + text(typ_von(glyphen_status) == "Woerterbuch")

setze render_negativ auf surface_text_stil(z_neu, 2, 2, 1, "A", -1, 255, 255, 255, 255)
setze render_fuenf auf surface_text_stil(z_neu, 2, 2, 1, "A", 5, 255, 255, 255, 255)
setze render_fremd auf surface_text_stil(z_neu, 2, 2, 1, "A", "fett", 255, 255, 255, 255)
zeige "INVALID-RENDER " + text(render_negativ == falsch) + "/" + text(render_fuenf == falsch) + "/" + text(render_fremd == falsch)

setze breite_negativ auf surface_text_breite_stil("A", 1, -1)
setze breite_fuenf auf surface_text_breite_stil("A", 1, 5)
setze breite_fremd auf surface_text_breite_stil("A", 1, "fett")
zeige "INVALID-BREITE " + text(breite_negativ == nichts) + "/" + text(breite_fuenf == nichts) + "/" + text(breite_fremd == nichts)

setze status_negativ auf surface_text_glyphen_status("A", -1)
setze status_fuenf auf surface_text_glyphen_status("A", 5)
setze status_fremd auf surface_text_glyphen_status("A", "fett")
zeige "INVALID-STATUS " + text(status_negativ == nichts) + "/" + text(status_fuenf == nichts) + "/" + text(status_fremd == nichts)

setze render_alt auf surface_text(z_alt, 2, 2, 1, "A", 255, 255, 255, 255)
setze breite_alt auf surface_text_breite("A", 1)
setze breite_neu_null auf surface_text_breite_stil("A", 1, 0)
zeige "ALT-STIL0 " + text(render_alt == render_stil) + "/" + text(surface_hash(z_alt) == surface_hash(z_neu)) + "/" + text(breite_alt == breite_neu_null)

setze face0 auf surface_new(240, 40)
setze face1 auf surface_new(240, 40)
setze face2 auf surface_new(240, 40)
setze face3 auf surface_new(240, 40)
setze face4 auf surface_new(240, 40)
surface_clear(face0, 0, 0, 0, 255)
surface_clear(face1, 0, 0, 0, 255)
surface_clear(face2, 0, 0, 0, 255)
surface_clear(face3, 0, 0, 0, 255)
surface_clear(face4, 0, 0, 0, 255)
surface_text_stil(face0, 2, 2, 1, "Hallo Welt", 0, 255, 255, 255, 255)
surface_text_stil(face1, 2, 2, 1, "Hallo Welt", 1, 255, 255, 255, 255)
surface_text_stil(face2, 2, 2, 1, "Hallo Welt", 2, 255, 255, 255, 255)
surface_text_stil(face3, 2, 2, 1, "Hallo Welt", 3, 255, 255, 255, 255)
surface_text_stil(face4, 2, 2, 1, "Hallo Welt", 4, 255, 255, 255, 255)
setze hash0 auf surface_hash(face0)
setze hash1 auf surface_hash(face1)
setze hash2 auf surface_hash(face2)
setze hash3 auf surface_hash(face3)
setze hash4 auf surface_hash(face4)
zeige "FACE-HASHES " + text(hash0 == "0d1e2da136a03977") + "/" + text(hash1 == "f39ac504b3a90226") + "/" + text(hash2 == "799e363647bedd3e") + "/" + text(hash3 == "c76c129dabc8430d") + "/" + text(hash4 == "f47f310680a70b46")
setze breite0 auf surface_text_breite_stil("Hallo Welt", 1, 0)
setze breite1 auf surface_text_breite_stil("Hallo Welt", 1, 1)
setze breite2 auf surface_text_breite_stil("Hallo Welt", 1, 2)
setze breite3 auf surface_text_breite_stil("Hallo Welt", 1, 3)
setze breite4 auf surface_text_breite_stil("Hallo Welt", 1, 4)
zeige "FACE-BREITEN " + text(breite0 == 81) + "/" + text(breite1 == 93) + "/" + text(breite2 == 81) + "/" + text(breite3 == 93) + "/" + text(breite4 == 100)
setze face_alt auf surface_new(240, 40)
surface_clear(face_alt, 0, 0, 0, 255)
surface_text(face_alt, 2, 2, 1, "Hallo Welt", 255, 255, 255, 255)
zeige "ALT-FACE0 " + text(surface_hash(face_alt) == hash0)

