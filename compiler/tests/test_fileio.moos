# P2-T117: eindeutiger Temp-Pfad je Prozess (parallele Laeufe kollidieren nicht)
setze pfad auf "/tmp/moo_test_" + text(prozess_id()) + ".txt"
datei_schreiben(pfad, "Hallo moo!")
zeige datei_lesen(pfad)
zeige datei_existiert(pfad)
datei_anhängen(pfad, "\nZeile 2")
zeige datei_zeilen(pfad)
datei_löschen(pfad)
zeige datei_existiert(pfad)
