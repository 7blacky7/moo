# Synchrone Grenze: Aufrufer hält Objekt und Puffer bis zur Rückkehr gültig.
# Zugriffe auf ein Dateisystem werden vom Besitzer serialisiert. Ein Fehler
# garantiert keine atomare Mehrsektor-Schreiboperation.
aus nativ_block importiere BlockGeometrie, BlockFehler

schnittstelle FatTransport:
    funktion geometrie(selbst) -> BlockGeometrie
    funktion uebertragen(selbst, art: u32, lba: u64, anzahl: u64, puffer: u64, bytes: u64) -> ergebnis[void, BlockFehler]
