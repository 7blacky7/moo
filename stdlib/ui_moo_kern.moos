funktion _uim_glass_an(t):
    gib_zurück t["name"] == "glass"

# Glass-Deko auf eine Widget-Fläche: gestufter Sheen im oberen 2/5
# (3 überlagerte Weiß-Stufen = Verlaufseindruck) + 1px-Kanten
# (oben hell, unten dunkel). Sheen mit radius-Inset statt Rundung,
# damit kleine Höhen nie am Radius-Limit scheitern.
funktion _uim_glass_deko(kontext, z, x, y, b, h, radius):
    wenn b < 10 oder h < 10:
        gib_zurück wahr
    setze inset auf radius
    wenn inset < 2:
        setze inset auf 2
    wenn b - 2 * inset < 2:
        gib_zurück wahr
    setze sh auf boden(h * 2 / 5)
    wenn sh > 1:
        _uim_farbe(kontext, z, [255, 255, 255, 20])
        _uim_zf_rechteck(kontext, z, x + inset, y + 1, b - 2 * inset, sh, wahr)
        _uim_farbe(kontext, z, [255, 255, 255, 18])
        _uim_zf_rechteck(kontext, z, x + inset, y + 1, b - 2 * inset, boden(sh * 2 / 3) + 1, wahr)
        _uim_farbe(kontext, z, [255, 255, 255, 16])
        _uim_zf_rechteck(kontext, z, x + inset, y + 1, b - 2 * inset, boden(sh / 3) + 1, wahr)
    _uim_farbe(kontext, z, [255, 255, 255, 90])
    _uim_zf_linie(kontext, z, x + inset, y + 1, x + b - inset, y + 1, 1)
    _uim_farbe(kontext, z, [16, 26, 38, 80])
    _uim_zf_linie(kontext, z, x + inset, y + h - 1, x + b - inset, y + h - 1, 1)
    gib_zurück wahr


# Repaint-Anforderung wird vom Backendvertrag behandelt.
funktion _uim_anfordern(kontext):
    gib_zurück _uim_backend_aufruf(kontext, "anfordern", [])

funktion _uim_neue_uid():
    setze uid auf _UIM["naechste_uid"]
    _UIM["naechste_uid"] = uid + 1
    gib_zurück uid

funktion _uim_ctx(leinwand):
    setze schluessel auf "k" + text(leinwand)
    setze alle auf _UIM["kontexte"]
    wenn alle.enthält(schluessel):
        gib_zurück alle[schluessel]
    gib_zurück nichts

funktion _uim_farbe(kontext, z, f):
    kontext["_farbe"] = f
    gib_zurück _uim_backend_aufruf(kontext, "farbe", [z, f])

# ------------------------------------------------------------
# Zeichner-Abstraktion (UIMOO-6): ALLE Widget-Zeichner laufen über
# _uim_zf_*-Wrapper. Backend "leinwand" = ui_zeichne_* (Desktop),
# Backend "frame" = 2D-Spiel-API (zeichne_rechteck/kreis/linie auf
# ein Fenster, Farben als "#RRGGBB", Text über 3x5-Pixelfont).
# Frame-Einschränkungen (dokumentiert): kein Scissor (clip = no-op,
# virtuelles Listen-Rendering begrenzt Overdraw auf <=1 Zeile),
# Rounded-Rects werden eckig, Outline-Kreise entfallen (Kosmetik).
# ------------------------------------------------------------

funktion _uim_hex2(n):
    setze ziffern auf "0123456789ABCDEF"
    wenn n < 0:
        setze n auf 0
    wenn n > 255:
        setze n auf 255
    setze hi auf 0
    solange (hi + 1) * 16 <= n:
        setze hi auf hi + 1
    setze lo auf n - hi * 16
    gib_zurück ziffern[hi] + ziffern[lo]

funktion _uim_hexfarbe(kontext):
    setze f auf kontext["_farbe"]
    gib_zurück "#" + _uim_hex2(f[0]) + _uim_hex2(f[1]) + _uim_hex2(f[2])

# ------------------------------------------------------------
# Formeller Backendvertrag (P016-A1)
# Jede Operation hat die Signatur op(kontext, args_liste). Dadurch bleibt
# der Widget-Kern in Moo und kennt weder GTK/Win32/Cocoa noch SDL.
# ------------------------------------------------------------

funktion uim_backend_neu(name, faehigkeiten, operationen):
    wenn name == nichts oder faehigkeiten == nichts oder operationen == nichts:
        gib_zurück nichts
    setze benoetigt auf ["anfordern", "farbe", "rechteck", "rechteck_rund", "kreis", "linie", "text", "text_breite", "clip_setze", "clip_loesche"]
    für schluessel in benoetigt:
        wenn operationen.enthält(schluessel) == falsch:
            gib_zurück nichts
        wenn operationen[schluessel] == nichts:
            gib_zurück nichts
    setze faehigkeit_keys auf ["alpha", "clip", "rechteck_rund", "kreis_rand", "text_metrik"]
    für schluessel in faehigkeit_keys:
        wenn faehigkeiten.enthält(schluessel) == falsch:
            gib_zurück nichts
        wenn faehigkeiten[schluessel] == nichts:
            gib_zurück nichts
    setze bool_faehigkeiten auf ["alpha", "clip", "rechteck_rund", "kreis_rand"]
    für schluessel in bool_faehigkeiten:
        setze wert auf faehigkeiten[schluessel]
        wenn wert != wahr und wert != falsch:
            gib_zurück nichts
    setze text_metrik auf faehigkeiten["text_metrik"]
    wenn typ_von(text_metrik) != "Text" oder text_metrik == "":
        gib_zurück nichts
    setze backend auf {}
    backend["name"] = name
    backend["version"] = 1
    backend["faehigkeiten"] = faehigkeiten
    backend["operationen"] = operationen
    gib_zurück backend

funktion _uim_backend_register_gueltig(register):
    wenn typ_von(register) != "Woerterbuch":
        gib_zurück falsch
    wenn register.enthält("version") == falsch oder register["version"] != 1:
        gib_zurück falsch
    wenn register.enthält("backends") == falsch oder typ_von(register["backends"]) != "Woerterbuch":
        gib_zurück falsch
    wenn register.enthält("auswahl") == falsch oder typ_von(register["auswahl"]) != "Text":
        gib_zurück falsch
    gib_zurück wahr

funktion _uim_backend_register_backend_gueltig(backend):
    wenn typ_von(backend) != "Woerterbuch":
        gib_zurück falsch
    wenn backend.enthält("name") == falsch oder typ_von(backend["name"]) != "Text":
        gib_zurück falsch
    wenn backend["name"] == "":
        gib_zurück falsch
    wenn backend.enthält("version") == falsch oder backend["version"] != 1:
        gib_zurück falsch
    wenn backend.enthält("operationen") == falsch oder typ_von(backend["operationen"]) != "Woerterbuch":
        gib_zurück falsch
    setze operationen auf backend["operationen"]
    setze benoetigt auf ["anfordern", "farbe", "rechteck", "rechteck_rund", "kreis", "linie", "text", "text_breite", "clip_setze", "clip_loesche"]
    für schluessel in benoetigt:
        wenn operationen.enthält(schluessel) == falsch oder operationen[schluessel] == nichts:
            gib_zurück falsch
    wenn backend.enthält("faehigkeiten") == falsch oder typ_von(backend["faehigkeiten"]) != "Woerterbuch":
        gib_zurück falsch
    setze faehigkeiten auf backend["faehigkeiten"]
    setze faehigkeit_keys auf ["alpha", "clip", "rechteck_rund", "kreis_rand", "text_metrik"]
    für schluessel in faehigkeit_keys:
        wenn faehigkeiten.enthält(schluessel) == falsch oder faehigkeiten[schluessel] == nichts:
            gib_zurück falsch
    setze bool_faehigkeiten auf ["alpha", "clip", "rechteck_rund", "kreis_rand"]
    für schluessel in bool_faehigkeiten:
        setze wert auf faehigkeiten[schluessel]
        wenn wert != wahr und wert != falsch:
            gib_zurück falsch
    setze text_metrik auf faehigkeiten["text_metrik"]
    wenn typ_von(text_metrik) != "Text" oder text_metrik == "":
        gib_zurück falsch
    gib_zurück wahr

funktion uim_backend_register_neu():
    setze register auf {}
    register["version"] = 1
    register["backends"] = {}
    register["auswahl"] = ""
    gib_zurück register

funktion uim_backend_registriere(register, backend):
    wenn _uim_backend_register_gueltig(register) == falsch:
        gib_zurück falsch
    wenn _uim_backend_register_backend_gueltig(backend) == falsch:
        gib_zurück falsch
    setze name auf backend["name"]
    register["backends"][name] = backend
    gib_zurück wahr

funktion uim_backend_finde(register, name, version):
    wenn _uim_backend_register_gueltig(register) == falsch:
        gib_zurück nichts
    wenn typ_von(name) != "Text" oder name == "":
        gib_zurück nichts
    wenn version != 1:
        gib_zurück nichts
    setze backends auf register["backends"]
    wenn backends.enthält(name) == falsch:
        gib_zurück nichts
    setze backend auf backends[name]
    wenn _uim_backend_register_backend_gueltig(backend) == falsch:
        gib_zurück nichts
    wenn backend["name"] != name oder backend["version"] != version:
        gib_zurück nichts
    gib_zurück backend

funktion uim_backend_waehle(register, name, version):
    setze backend auf uim_backend_finde(register, name, version)
    wenn backend == nichts:
        gib_zurück nichts
    register["auswahl"] = name
    gib_zurück backend

funktion _uim_faehigkeiten(alpha, clip, rund, kreis_rand, text_metrik):
    setze f auf {}
    f["alpha"] = alpha
    f["clip"] = clip
    f["rechteck_rund"] = rund
    f["kreis_rand"] = kreis_rand
    f["text_metrik"] = text_metrik
    gib_zurück f

funktion _uim_backend_aufruf(kontext, name, args):
    wenn kontext.enthält("backend_vertrag") == falsch:
        gib_zurück falsch
    setze vertrag auf kontext["backend_vertrag"]
    wenn vertrag == nichts:
        gib_zurück falsch
    setze operationen auf vertrag["operationen"]
    wenn operationen.enthält(name) == falsch:
        gib_zurück falsch
    setze op auf operationen[name]
    wenn op == nichts:
        gib_zurück falsch
    gib_zurück op(kontext, args)

# Desktop-Leinwand-Adapter
# Toolkit-freies Mock-Framebuffer: schreibt Draw-Commands in eine Moo-Liste.
funktion _uim_bm_befehl(kontext, name, args):
    setze zustand auf kontext["backend_zustand"]
    wenn zustand.enthält("befehle") == falsch:
        zustand["befehle"] = []
    setze befehl auf {}
    befehl["op"] = name
    befehl["args"] = args
    befehl["farbe"] = kontext["_farbe"]
    zustand["befehle"].hinzufügen(befehl)
    gib_zurück wahr

funktion _uim_bm_anfordern(kontext, args):
    setze zustand auf kontext["backend_zustand"]
    zustand["ungueltig"] = wahr
    gib_zurück wahr

funktion _uim_bm_farbe(kontext, args):
    gib_zurück _uim_bm_befehl(kontext, "farbe", [args[1]])

funktion _uim_bm_rechteck(kontext, args):
    gib_zurück _uim_bm_befehl(kontext, "rechteck", [args[1], args[2], args[3], args[4], args[5]])

funktion _uim_bm_rechteck_rund(kontext, args):
    gib_zurück _uim_bm_befehl(kontext, "rechteck_rund", [args[1], args[2], args[3], args[4], args[5], args[6]])

funktion _uim_bm_kreis(kontext, args):
    gib_zurück _uim_bm_befehl(kontext, "kreis", [args[1], args[2], args[3], args[4]])

funktion _uim_bm_linie(kontext, args):
    gib_zurück _uim_bm_befehl(kontext, "linie", [args[1], args[2], args[3], args[4], args[5]])

funktion _uim_bm_text(kontext, args):
    gib_zurück _uim_bm_befehl(kontext, "text", [args[1], args[2], args[3], args[4]])

funktion _uim_bm_text_breite(kontext, args):
    gib_zurück länge(args[1]) * 8

funktion _uim_bm_clip_setze(kontext, args):
    gib_zurück _uim_bm_befehl(kontext, "clip_setze", [args[1], args[2], args[3], args[4]])

funktion _uim_bm_clip_loesche(kontext, args):
    gib_zurück _uim_bm_befehl(kontext, "clip_loesche", [])

funktion uim_backend_mock():
    setze ops auf {}
    ops["anfordern"] = _uim_bm_anfordern
    ops["farbe"] = _uim_bm_farbe
    ops["rechteck"] = _uim_bm_rechteck
    ops["rechteck_rund"] = _uim_bm_rechteck_rund
    ops["kreis"] = _uim_bm_kreis
    ops["linie"] = _uim_bm_linie
    ops["text"] = _uim_bm_text
    ops["text_breite"] = _uim_bm_text_breite
    ops["clip_setze"] = _uim_bm_clip_setze
    ops["clip_loesche"] = _uim_bm_clip_loesche
    gib_zurück uim_backend_neu("mock-framebuffer", _uim_faehigkeiten(wahr, wahr, wahr, wahr, "deterministisch-8px"), ops)

funktion _uim_zf_rechteck(kontext, zz, x, y, b, h, gefuellt):
    gib_zurück _uim_backend_aufruf(kontext, "rechteck", [zz, x, y, b, h, gefuellt])

funktion _uim_zf_rechteck_rund(kontext, zz, x, y, b, h, radius, gefuellt):
    gib_zurück _uim_backend_aufruf(kontext, "rechteck_rund", [zz, x, y, b, h, radius, gefuellt])

funktion _uim_zf_kreis(kontext, zz, cx, cy, radius, gefuellt):
    gib_zurück _uim_backend_aufruf(kontext, "kreis", [zz, cx, cy, radius, gefuellt])

funktion _uim_zf_linie(kontext, zz, x1, y1, x2, y2, breite):
    gib_zurück _uim_backend_aufruf(kontext, "linie", [zz, x1, y1, x2, y2, breite])

# Frame-Schriftgroesse -> Pixelfont-Skalierung (3x5-Glyphen).
funktion _uim_zf_px(groesse):
    wenn groesse >= 12:
        gib_zurück 2
    gib_zurück 1

funktion _uim_zf_text(kontext, zz, x, y, s, groesse):
    gib_zurück _uim_backend_aufruf(kontext, "text", [zz, x, y, s, groesse])

funktion _uim_zf_text_breite(kontext, zz, s, groesse):
    gib_zurück _uim_backend_aufruf(kontext, "text_breite", [zz, s, groesse])

funktion _uim_zf_clip_setze(kontext, zz, x, y, b, h):
    gib_zurück _uim_backend_aufruf(kontext, "clip_setze", [zz, x, y, b, h])

funktion _uim_zf_clip_loesche(kontext, zz):
    gib_zurück _uim_backend_aufruf(kontext, "clip_loesche", [zz])

# uid eines Widget-Slots im Kontext ("hover"/"druck"/"fokus"), 0 = leer.
funktion _uim_slot_uid(kontext, slot):
    setze w auf kontext[slot]
    wenn w == nichts:
        gib_zurück 0
    gib_zurück w["uid"]

# Basis aller Widgets: gemeinsame Felder einmal zentral.
funktion _uim_basis(typ, x, y, b, h):
    setze w auf {}
    w["typ"] = typ
    w["version"] = 1
    w["uid"] = _uim_neue_uid()
    w["id"] = ""
    w["x"] = x
    w["y"] = y
    w["b"] = b
    w["h"] = h
    w["sichtbar"] = wahr
    w["aktiv"] = wahr
    w["fokussierbar"] = falsch
    w["text"] = ""
    # Zentraler Querschnittszustand: jedes Widget erbt dieselben Felder.
    w["zustand"] = "normal"
    w["eingabe_zustand"] = "empty"
    w["disabled"] = falsch
    w["selected"] = falsch
    w["error"] = falsch
    w["loading"] = falsch
    w["readonly"] = falsch
    w["invalid"] = falsch
    w["hover"] = falsch
    w["druck"] = falsch
    w["kinder"] = []
    w["on_klick"] = nichts
    w["on_wechsel"] = nichts
    w["ausrichtung"] = "links"
    w["wert"] = 0
    w["min"] = 0
    w["max"] = 0
    w["a11y_name"] = ""
    w["a11y_beschreibung"] = ""
    w["tooltip"] = nichts
    # UI-13/VALID: Validator bleibt getrennt von Widget-/Eingabelogik.
    w["validator"] = nichts
    w["validierungs_fehler"] = ""
    w["hilfetext"] = ""
    # UI-13/LAYOUT: einheitliche skalare Metriken und Zeichenordnung.
    w["margin"] = 0
    w["padding"] = 0
    w["gap"] = 0
    w["min_b"] = 0
    w["min_h"] = 0
    w["max_b"] = 0
    w["max_h"] = 0
    w["auto_b"] = falsch
    w["auto_h"] = falsch
    w["text_umbruch"] = falsch
    w["text_ellipsis"] = falsch
    w["clip_kinder"] = falsch
    w["clip_kinder_explizit"] = falsch
    w["z_index"] = 0
    # UI-13/DATA: distinkte Events, Binding und retained DnD-Metadaten.
    w["on_fokus"] = nichts
    w["on_eingabe"] = nichts
    w["on_loslassen"] = nichts
    w["on_drop"] = nichts
    w["ziehbar"] = falsch
    w["dropziel"] = falsch
    w["drag_daten"] = nichts
    w["bindung_state"] = nichts
    w["bindung_key"] = ""
    w["bindung_feld"] = ""
    w["undo_stapel"] = []
    w["redo_stapel"] = []
    # UI-13/LIFE: Generation statt konkurrierender Animationen; Cleanup-Hook.
    w["animation_generation"] = 0
    w["animation_aktiv"] = falsch
    w["on_entfernt"] = nichts
    w["entfernt"] = falsch
    # Zyklusfreies Token fuer abwaertskompatible Setter ohne Kontextparameter.
    w["_repaint_token"] = nichts
    gib_zurück w

funktion _uim_layout_begrenze(w):
    wenn w["min_b"] > 0 und w["b"] < w["min_b"]:
        w["b"] = w["min_b"]
    wenn w["min_h"] > 0 und w["h"] < w["min_h"]:
        w["h"] = w["min_h"]
    wenn w["max_b"] > 0 und w["b"] > w["max_b"]:
        w["b"] = w["max_b"]
    wenn w["max_h"] > 0 und w["h"] > w["max_h"]:
        w["h"] = w["max_h"]
    gib_zurück w

funktion uim_layout_metriken_setze(w, margin, padding, gap):
    wenn margin < 0:
        setze margin auf 0
    wenn padding < 0:
        setze padding auf 0
    wenn gap < 0:
        setze gap auf 0
    w["margin"] = margin
    w["padding"] = padding
    w["gap"] = gap
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_layout_grenzen_setze(w, min_b, min_h, max_b, max_h, auto_b, auto_h):
    wenn min_b < 0:
        setze min_b auf 0
    wenn min_h < 0:
        setze min_h auf 0
    wenn max_b > 0 und max_b < min_b:
        setze max_b auf min_b
    wenn max_h > 0 und max_h < min_h:
        setze max_h auf min_h
    w["min_b"] = min_b
    w["min_h"] = min_h
    w["max_b"] = max_b
    w["max_h"] = max_h
    w["auto_b"] = auto_b
    w["auto_h"] = auto_h
    _uim_layout_begrenze(w)
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_text_layout_setze(w, umbruch, ellipsis):
    w["text_umbruch"] = umbruch
    w["text_ellipsis"] = ellipsis
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_clip_kinder_setze(w, an):
    w["clip_kinder"] = an
    w["clip_kinder_explizit"] = wahr
    _uim_widget_anfordern(w)
    gib_zurück w

# Gemeinsamer Render-/Input-Vertrag. Inhaltscontainer clippen standardmäßig;
# freie/custom Widgets nicht. uim_clip_kinder_setze überschreibt den Standard.
funktion _uim_clip_kinder_aktiv(w):
    wenn w["clip_kinder_explizit"]:
        gib_zurück w["clip_kinder"]
    setze typ auf w["typ"]
    gib_zurück typ == "scroll" oder typ == "panel" oder typ == "tabs" oder typ == "tab" oder typ == "expander" oder typ == "toolbar" oder typ == "teiler" oder typ == "karte" oder typ == "stapel" oder typ == "gitter" oder typ == "ueberlagerung"

funktion uim_z_index_setze(w, z_index):
    w["z_index"] = z_index
    _uim_widget_anfordern(w)
    gib_zurück w

# UI-13/DATA: bidirektionale retained Bindings ohne globales Capture.
funktion _uim_bind_widget_wert(w):
    setze feld auf w["bindung_feld"]
    wenn feld == "text":
        gib_zurück w["text"]
    wenn feld == "wert":
        gib_zurück w["wert"]
    wenn feld == "auswahl":
        gib_zurück w["auswahl"]
    wenn feld == "status_titel":
        gib_zurück w["status_titel"]
    gib_zurück nichts

funktion _uim_bind_setze_widget(w, feld, wert):
    wenn feld == "text":
        w["text"] = text(wert)
        w["cursor"] = länge(bytes_zu_liste(w["text"]))
        _uim_multiline_spalte_reset(w)
        _uim_widget_anfordern(w)
        gib_zurück wahr
    wenn feld == "wert":
        w["wert"] = wert
        _uim_widget_anfordern(w)
        gib_zurück wahr
    wenn feld == "auswahl":
        w["auswahl"] = wert
        _uim_widget_anfordern(w)
        gib_zurück wahr
    wenn feld == "status_titel":
        w["status_titel"] = text(wert)
        _uim_widget_anfordern(w)
        gib_zurück wahr
    gib_zurück falsch

funktion _uim_bind_widget_zu_state(w):
    wenn w["bindung_state"] == nichts oder w["bindung_key"] == "":
        gib_zurück falsch
    w["bindung_state"][w["bindung_key"]] = _uim_bind_widget_wert(w)
    gib_zurück wahr

funktion uim_bind(w, state, key, feld):
    wenn w == nichts oder state == nichts:
        gib_zurück falsch
    wenn state.enthält("__uim_bindings") == falsch:
        state["__uim_bindings"] = []
    w["bindung_state"] = state
    w["bindung_key"] = key
    w["bindung_feld"] = feld
    state["__uim_bindings"].hinzufügen(w)
    wenn state.enthält(key):
        gib_zurück _uim_bind_setze_widget(w, feld, state[key])
    state[key] = _uim_bind_widget_wert(w)
    gib_zurück wahr

funktion uim_state_setze(state, key, wert):
    state[key] = wert
    wenn state.enthält("__uim_bindings"):
        für w in state["__uim_bindings"]:
            wenn w["bindung_key"] == key:
                _uim_bind_setze_widget(w, w["bindung_feld"], wert)
    gib_zurück wahr

funktion uim_event_setze(w, art, cb):
    wenn w == nichts:
        gib_zurück falsch
    wenn art == "fokus":
        w["on_fokus"] = cb
    sonst wenn art == "eingabe":
        w["on_eingabe"] = cb
    sonst wenn art == "loslassen":
        w["on_loslassen"] = cb
    sonst wenn art == "drop":
        w["on_drop"] = cb
        w["dropziel"] = wahr
    sonst:
        gib_zurück falsch
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_drag_quelle(w, daten):
    w["ziehbar"] = wahr
    w["drag_daten"] = daten
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_drop_ziel(w, cb):
    w["dropziel"] = wahr
    w["on_drop"] = cb
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_text_kopieren(kontext, w):
    kontext["clipboard_text"] = w["text"]
    gib_zurück kontext["clipboard_text"]

funktion uim_text_ausschneiden(kontext, w):
    uim_text_kopieren(kontext, w)
    gib_zurück uim_textfeld_setze(kontext, w, "")

funktion uim_text_einfuegen(kontext, w):
    gib_zurück uim_textfeld_setze(kontext, w, kontext["clipboard_text"])

funktion _uim_zustand_gueltig(zustand):
    gib_zurück zustand == "normal" oder zustand == "hover" oder zustand == "pressed" oder zustand == "focused" oder zustand == "disabled" oder zustand == "selected" oder zustand == "error" oder zustand == "loading"

funktion _uim_eingabe_zustand_gueltig(zustand):
    gib_zurück zustand == "empty" oder zustand == "filled" oder zustand == "readonly" oder zustand == "invalid" oder zustand == "placeholder"

funktion _uim_zustand_aktuell(kontext, w):
    wenn w == nichts:
        gib_zurück "normal"
    wenn w["aktiv"] == falsch oder w["disabled"]:
        gib_zurück "disabled"
    wenn w["loading"]:
        gib_zurück "loading"
    wenn w["error"] oder w["invalid"]:
        gib_zurück "error"
    wenn w["druck"]:
        gib_zurück "pressed"
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        gib_zurück "focused"
    wenn w["selected"] or (w["typ"] == "checkbox" und w["wert"]):
        gib_zurück "selected"
    wenn w["hover"]:
        gib_zurück "hover"
    wenn _uim_zustand_gueltig(w["zustand"]) und w["zustand"] != "normal":
        gib_zurück w["zustand"]
    gib_zurück "normal"

funktion _uim_zustand_farbe(kontext, w, feld):
    setze t auf kontext["theme"]
    setze zustand auf _uim_zustand_aktuell(kontext, w)
    setze spezial auf feld
    wenn zustand == "hover":
        wenn feld == "flaeche":
            setze spezial auf "flaeche_hover"
        sonst wenn feld == "rand":
            setze spezial auf "rand_hover"
    sonst wenn zustand == "pressed":
        wenn feld == "flaeche":
            setze spezial auf "flaeche_druck"
        sonst wenn feld == "rand":
            setze spezial auf "rand_druck"
    sonst wenn zustand == "focused":
        wenn feld == "rand":
            setze spezial auf "rand_fokus"
    sonst wenn zustand == "disabled":
        wenn feld == "flaeche":
            setze spezial auf "flaeche_deaktiviert"
        sonst wenn feld == "rand":
            setze spezial auf "rand_deaktiviert"
        sonst wenn feld == "text":
            setze spezial auf "text_gedimmt"
    sonst wenn zustand == "selected":
        wenn feld == "flaeche":
            setze spezial auf "flaeche_auswahl"
        sonst wenn feld == "rand":
            setze spezial auf "rand_auswahl"
    sonst wenn zustand == "error":
        wenn feld == "flaeche":
            setze spezial auf "flaeche_fehler"
        sonst wenn feld == "rand":
            setze spezial auf "rand_fehler"
        sonst wenn feld == "text":
            setze spezial auf "text_fehler"
    sonst wenn zustand == "loading":
        wenn feld == "flaeche":
            setze spezial auf "flaeche_laden"
        sonst wenn feld == "text":
            setze spezial auf "text_laden"
    wenn t.enthält(spezial):
        gib_zurück t[spezial]
    gib_zurück t[feld]

# O4: Öffentliche, toolkitfreie Accessibility-Metadaten.
# Rollen, States und Aktionen spiegeln moo_input_protocol.h v1. Bounds sind
# ausdrücklich lokal zum direkten Elternknoten, nicht Bildschirmkoordinaten.
funktion _uim_a11y_widget_gueltig(w):
    wenn typ_von(w) != "Woerterbuch":
        gib_zurück falsch
    setze pflicht auf ["typ", "uid", "x", "y", "b", "h", "sichtbar", "aktiv", "fokussierbar", "text"]
    für feld in pflicht:
        wenn w.enthält(feld) == falsch:
            gib_zurück falsch
    gib_zurück wahr

funktion _uim_a11y_rolle(art):
    wenn art == "panel" oder art == "scroll":
        gib_zurück 2
    wenn art == "label":
        gib_zurück 3
    wenn art == "knopf":
        gib_zurück 4
    wenn art == "checkbox":
        gib_zurück 5
    wenn art == "slider":
        gib_zurück 6
    wenn art == "liste":
        gib_zurück 8
    gib_zurück 0

funktion _uim_a11y_aktionen(art):
    wenn art == "knopf" oder art == "checkbox":
        gib_zurück 3
    wenn art == "slider":
        gib_zurück 29
    wenn art == "liste":
        gib_zurück 33
    gib_zurück 0

funktion uim_a11y(kontext, w):
    wenn typ_von(kontext) != "Woerterbuch" oder kontext.enthält("fokus") == falsch:
        gib_zurück nichts
    wenn _uim_a11y_widget_gueltig(w) == falsch:
        gib_zurück nichts

    setze ergebnis auf {}
    ergebnis["version"] = 1
    ergebnis["uid"] = w["uid"]
    ergebnis["role"] = _uim_a11y_rolle(w["typ"])

    setze states auf 0
    wenn w["aktiv"] == falsch:
        setze states auf states + 1
    setze fokus auf kontext["fokus"]
    wenn fokus != nichts und typ_von(fokus) == "Woerterbuch" und fokus.enthält("uid") und fokus["uid"] == w["uid"]:
        setze states auf states + 2
    wenn w["typ"] == "checkbox" und w.enthält("wert") und w["wert"]:
        setze states auf states + 4
    wenn w["sichtbar"] == falsch:
        setze states auf states + 64
    ergebnis["states"] = states
    ergebnis["actions"] = _uim_a11y_aktionen(w["typ"])

    setze bounds auf {}
    bounds["x"] = w["x"]
    bounds["y"] = w["y"]
    bounds["b"] = w["b"]
    bounds["h"] = w["h"]
    ergebnis["bounds"] = bounds
    ergebnis["bounds_space"] = "parent-local"

    setze name auf w["text"]
    wenn w.enthält("a11y_name") und typ_von(w["a11y_name"]) == "Text" und w["a11y_name"] != "":
        setze name auf w["a11y_name"]
    ergebnis["name"] = name

    setze value auf ""
    wenn w["typ"] == "checkbox" und w.enthält("wert"):
        setze value auf text(w["wert"])
    wenn w["typ"] == "slider" und w.enthält("wert"):
        setze value auf text(w["wert"])
    wenn w["typ"] == "fortschritt" und w.enthält("wert"):
        setze value auf text(w["wert"])
    wenn w["typ"] == "liste" und w.enthält("auswahl"):
        setze value auf text(w["auswahl"])
    ergebnis["value"] = value

    setze beschreibung auf ""
    wenn w.enthält("a11y_beschreibung") und typ_von(w["a11y_beschreibung"]) == "Text":
        setze beschreibung auf w["a11y_beschreibung"]
    ergebnis["description"] = beschreibung
    gib_zurück ergebnis

# O4: Reiner, plattformneutraler IME-Ereigniswert nach
# moo_input_protocol.h v1. Auswahlgrenzen sind UTF-8-Byteoffsets.
# Diese Funktion beweist weder Zustandsfortschritt noch eine native Bruecke.
funktion _uim_ime_ganze_zahl(wert):
    wenn typ_von(wert) != "Zahl":
        gib_zurück falsch
    gib_zurück boden(wert) == wert

funktion _uim_ime_utf8_grenze(bytes, position):
    wenn position < 0 oder position > länge(bytes):
        gib_zurück falsch
    wenn position == 0 oder position == länge(bytes):
        gib_zurück wahr
    setze byte auf bytes[position]
    gib_zurück byte < 128 oder byte >= 192

funktion uim_ime_ereignis(art, inhalt, auswahl_start, auswahl_ende, revision):
    wenn typ_von(art) != "Text" oder typ_von(inhalt) != "Text":
        gib_zurück nichts
    wenn art != "preedit" und art != "commit" und art != "cancel":
        gib_zurück nichts
    wenn _uim_ime_ganze_zahl(revision) == falsch oder revision <= 0:
        gib_zurück nichts
    wenn _uim_ime_ganze_zahl(auswahl_start) == falsch oder _uim_ime_ganze_zahl(auswahl_ende) == falsch:
        gib_zurück nichts

    setze bytes auf bytes_zu_liste(inhalt)
    setze ereignis_text auf inhalt
    setze start auf auswahl_start
    setze ende auf auswahl_ende

    wenn art == "preedit":
        wenn start < 0 oder ende < start oder ende > länge(bytes):
            gib_zurück nichts
        wenn _uim_ime_utf8_grenze(bytes, start) == falsch oder _uim_ime_utf8_grenze(bytes, ende) == falsch:
            gib_zurück nichts
    sonst wenn art == "commit":
        setze start auf länge(bytes)
        setze ende auf länge(bytes)
    sonst:
        setze ereignis_text auf ""
        setze start auf 0
        setze ende auf 0

    setze ergebnis auf {}
    ergebnis["version"] = 1
    ergebnis["art"] = art
    ergebnis["text"] = ereignis_text
    ergebnis["selection_start"] = start
    ergebnis["selection_end"] = ende
    ergebnis["revision"] = revision
    gib_zurück ergebnis

# Treffer-Ergebnis: Widget + Koordinaten LOKAL zur Eltern-Ebene des
# Widgets (lx liegt in w.x..w.x+w.b). Nötig für Slider/Liste in Panels.
funktion _uim_tref(w, lx, ly):
    setze t auf {}
    t["w"] = w
    t["lx"] = lx
    t["ly"] = ly
    gib_zurück t

funktion _uim_finde_rek(kinder, id):
    setze gefunden auf nichts
    für w in kinder:
        wenn gefunden == nichts:
            wenn w["id"] == id:
                setze gefunden auf w
            sonst:
                setze gefunden auf _uim_finde_rek(w["kinder"], id)
    gib_zurück gefunden

funktion _uim_fokus_uids(kinder, ziele):
    für w in kinder:
        wenn w["sichtbar"] und w["aktiv"] und w["disabled"] == falsch:
            wenn w["fokussierbar"]:
                ziele.hinzufügen(w["uid"])
            # Fokus folgt derselben tatsächlichen Sichtbarkeit wie Render/Input.
            wenn w["typ"] == "tabs":
                wenn länge(w["kinder"]) > 0:
                    setze ti auf w["auswahl"]
                    wenn ti < 0:
                        setze ti auf 0
                    wenn ti > länge(w["kinder"]) - 1:
                        setze ti auf länge(w["kinder"]) - 1
                    _uim_fokus_uids(w["kinder"][ti]["kinder"], ziele)
            sonst wenn w["typ"] == "expander":
                wenn w["offen"]:
                    _uim_fokus_uids(w["kinder"], ziele)
            sonst wenn w["typ"] == "ueberlagerung":
                wenn w["offen"]:
                    _uim_fokus_uids(w["kinder"], ziele)
            sonst:
                _uim_fokus_uids(w["kinder"], ziele)
    gib_zurück ziele

funktion _uim_finde_uid_rek(kinder, uid):
    setze gefunden auf nichts
    für w in kinder:
        wenn gefunden == nichts:
            wenn w["uid"] == uid:
                setze gefunden auf w
            sonst:
                setze gefunden auf _uim_finde_uid_rek(w["kinder"], uid)
    gib_zurück gefunden

# 0 = nicht gefunden, 1 = durch Widget/Vorfahre blockiert, 2 = interaktiv.
funktion _uim_interaktiv_uid_rek(kinder, uid, erlaubt):
    setze ergebnis auf 0
    für w in kinder:
        wenn ergebnis == 0:
            setze kind_erlaubt auf erlaubt und w["sichtbar"] und w["aktiv"] und w["disabled"] == falsch
            wenn w["uid"] == uid:
                wenn kind_erlaubt:
                    setze ergebnis auf 2
                sonst:
                    setze ergebnis auf 1
            sonst:
                setze ergebnis auf _uim_interaktiv_uid_rek(w["kinder"], uid, kind_erlaubt)
    gib_zurück ergebnis

funktion _uim_ist_interaktiv(kontext, w):
    wenn w == nichts:
        gib_zurück falsch
    gib_zurück _uim_interaktiv_uid_rek(kontext["wurzel"]["kinder"], w["uid"], wahr) == 2

funktion _uim_scroll_max(kontext, w):
    setze inhalt auf w["inhalt_hoehe"]
    wenn w["typ"] == "liste":
        setze inhalt auf länge(w["zeilen"]) * _uim_zeilenhoehe(kontext)
    wenn w["typ"] == "baum":
        setze inhalt auf länge(_uim_baum_sichtbare(w)) * _uim_zeilenhoehe(kontext)
    wenn w["typ"] == "datengitter":
        setze inhalt auf (länge(w["zeilen"]) + 1) * _uim_zeilenhoehe(kontext)
    wenn w["typ"] == "iconview":
        setze inhalt auf _uim_iconview_zeilen(kontext, w) * w["tile_h"]
    wenn w["typ"] == "terminal":
        setze inhalt auf (länge(w["zeilen"]) + 1) * _uim_zeilenhoehe(kontext)
    wenn w["typ"] == "markdown":
        setze inhalt auf länge(w["zeilen"]) * _uim_zeilenhoehe(kontext)
    wenn w["typ"] == "multiline":
        setze inhalt auf länge(_uim_multiline_zeilen(bytes_zu_liste(w["text"]))) * _uim_zeilenhoehe(kontext) + 8
    setze max_scroll auf inhalt - w["h"]
    wenn max_scroll < 0:
        setze max_scroll auf 0
    gib_zurück max_scroll

funktion _uim_scroll_klemme(kontext, w):
    setze max_scroll auf _uim_scroll_max(kontext, w)
    wenn w["scroll_y"] < 0:
        w["scroll_y"] = 0
    wenn w["scroll_y"] > max_scroll:
        w["scroll_y"] = max_scroll
    gib_zurück wahr

funktion _uim_scroll_klemme_rek(kontext, kinder):
    für w in kinder:
        wenn w["typ"] == "scroll" oder w["typ"] == "liste" oder w["typ"] == "baum" oder w["typ"] == "datengitter" oder w["typ"] == "iconview" oder w["typ"] == "multiline":
            _uim_scroll_klemme(kontext, w)
        _uim_scroll_klemme_rek(kontext, w["kinder"])
    gib_zurück wahr

funktion _uim_liste_sichtbar_machen(kontext, w, idx):
    setze zh auf _uim_zeilenhoehe(kontext)
    setze oben auf idx * zh
    setze unten auf oben + zh
    wenn oben < w["scroll_y"]:
        w["scroll_y"] = oben
    wenn unten > w["scroll_y"] + w["h"]:
        w["scroll_y"] = unten - w["h"]
    _uim_scroll_klemme(kontext, w)
    gib_zurück wahr

funktion _uim_baum_sichtbare_rek(knoten, ebene, ziel):
    für knoten_eintrag in knoten:
        setze eintrag auf {}
        eintrag["knoten"] = knoten_eintrag
        eintrag["ebene"] = ebene
        ziel.hinzufügen(eintrag)
        wenn knoten_eintrag["offen"]:
            _uim_baum_sichtbare_rek(knoten_eintrag["kinder"], ebene + 1, ziel)
    gib_zurück wahr

funktion _uim_baum_sichtbare(w):
    setze ziel auf []
    _uim_baum_sichtbare_rek(w["knoten"], 0, ziel)
    gib_zurück ziel

funktion _uim_baum_sichtbar_machen(kontext, w, idx):
    setze zh auf _uim_zeilenhoehe(kontext)
    setze oben auf idx * zh
    setze unten auf oben + zh
    wenn oben < w["scroll_y"]:
        w["scroll_y"] = oben
    wenn unten > w["scroll_y"] + w["h"]:
        w["scroll_y"] = unten - w["h"]
    _uim_scroll_klemme(kontext, w)
    gib_zurück wahr

funktion _uim_baum_klick(kontext, w, lx, ly):
    setze t auf kontext["theme"]
    setze zh auf _uim_zeilenhoehe(kontext)
    setze rel auf ly - w["y"] + w["scroll_y"]
    wenn rel < 0:
        gib_zurück falsch
    setze idx auf 0
    solange (idx + 1) * zh <= rel:
        setze idx auf idx + 1
    setze sichtbare auf _uim_baum_sichtbare(w)
    wenn idx >= länge(sichtbare):
        gib_zurück falsch
    setze eintrag auf sichtbare[idx]
    setze knoten auf eintrag["knoten"]
    wenn lx < t["abstand"] + eintrag["ebene"] * 12 + 14 und länge(knoten["kinder"]) > 0:
        knoten["offen"] = knoten["offen"] == falsch
    w["auswahl"] = idx
    w["selected"] = wahr
    w["zustand"] = "selected"
    _uim_baum_sichtbar_machen(kontext, w, idx)
    setze cb auf w["on_auswahl"]
    wenn cb != nichts:
        cb(w, idx)
    gib_zurück wahr

funktion _uim_datengitter_klick(kontext, w, ly):
    setze zh auf _uim_zeilenhoehe(kontext)
    setze rel auf ly - w["y"] - zh + w["scroll_y"]
    wenn rel < 0:
        gib_zurück falsch
    setze idx auf 0
    solange (idx + 1) * zh <= rel:
        setze idx auf idx + 1
    wenn idx >= länge(w["zeilen"]):
        gib_zurück falsch
    w["auswahl"] = idx
    w["selected"] = wahr
    w["zustand"] = "selected"
    setze cb auf w["on_auswahl"]
    wenn cb != nichts:
        cb(w, idx)
    gib_zurück wahr

funktion _uim_iconview_text(eintrag):
    wenn typ_von(eintrag) == "Woerterbuch":
        wenn eintrag.enthält("text"):
            gib_zurück text(eintrag["text"])
        gib_zurück ""
    gib_zurück text(eintrag)

funktion _uim_iconview_icon(eintrag):
    wenn typ_von(eintrag) == "Woerterbuch":
        wenn eintrag.enthält("icon"):
            gib_zurück text(eintrag["icon"])
        gib_zurück ""
    gib_zurück ""

funktion _uim_iconview_spalten(kontext, w):
    setze tile_b auf w["tile_b"]
    setze abstand auf kontext["theme"]["abstand"]
    setze n auf 0
    setze lauf auf 0
    solange lauf + tile_b <= w["b"]:
        setze n auf n + 1
        setze lauf auf lauf + tile_b + abstand
    wenn n < 1:
        setze n auf 1
    gib_zurück n

funktion _uim_iconview_zeilen(kontext, w):
    setze n auf länge(w["eintraege"])
    setze cols auf _uim_iconview_spalten(kontext, w)
    setze zeilen auf 0
    wenn n > 0:
        setze zeilen auf 1
        setze rest auf cols
        solange rest < n:
            setze zeilen auf zeilen + 1
            setze rest auf rest + cols
    gib_zurück zeilen

funktion _uim_iconview_sichtbar_machen(kontext, w, idx):
    setze cols auf _uim_iconview_spalten(kontext, w)
    setze zeile auf 0
    setze rest auf cols
    solange rest <= idx:
        setze zeile auf zeile + 1
        setze rest auf rest + cols
    setze oben auf zeile * w["tile_h"]
    setze unten auf oben + w["tile_h"]
    wenn oben < w["scroll_y"]:
        setze w["scroll_y"] auf oben
    wenn unten > w["scroll_y"] + w["h"]:
        setze w["scroll_y"] auf unten - w["h"]
    _uim_scroll_klemme(kontext, w)
    gib_zurück wahr

funktion _uim_iconview_klick(kontext, w, lx, ly):
    setze t auf kontext["theme"]
    setze rel_x auf lx - w["x"]
    setze rel_y auf ly - w["y"] + w["scroll_y"]
    wenn rel_x < 0 oder rel_y < 0:
        gib_zurück falsch
    setze cols auf _uim_iconview_spalten(kontext, w)
    setze col auf 0
    solange (col + 1) * w["tile_b"] <= rel_x:
        setze col auf col + 1
    setze row auf 0
    solange (row + 1) * w["tile_h"] <= rel_y:
        setze row auf row + 1
    setze idx auf row * cols + col
    wenn idx < 0 oder idx >= länge(w["eintraege"]):
        gib_zurück falsch
    w["auswahl"] = idx
    w["selected"] = wahr
    w["zustand"] = "selected"
    _uim_iconview_sichtbar_machen(kontext, w, idx)
    setze cb auf w["on_auswahl"]
    wenn cb != nichts:
        cb(w, idx)
    gib_zurück wahr

funktion _uim_scroll_thumb_h(w):
    setze thumb_h auf w["h"] * w["h"] / w["inhalt_hoehe"]
    wenn thumb_h < 16:
        setze thumb_h auf 16
    wenn thumb_h > w["h"]:
        setze thumb_h auf w["h"]
    gib_zurück thumb_h

funktion _uim_scroll_setze_aus_y(kontext, w, ly, greif_y):
    setze max_scroll auf _uim_scroll_max(kontext, w)
    setze thumb_h auf _uim_scroll_thumb_h(w)
    setze lauf auf w["h"] - thumb_h
    setze anteil auf 0
    wenn lauf > 0:
        setze anteil auf (ly - w["y"] - greif_y) / lauf
    wenn anteil < 0:
        setze anteil auf 0
    wenn anteil > 1:
        setze anteil auf 1
    setze wert auf anteil * max_scroll
    wenn wert == w["scroll_y"]:
        gib_zurück falsch
    w["scroll_y"] = wert
    gib_zurück wahr

funktion _uim_druck_loesche(kontext):
    setze p auf kontext["druck"]
    wenn p != nichts:
        p["druck"] = falsch
    kontext["druck"] = nichts
    kontext["druck_art"] = ""
    kontext["druck_greif_y"] = 0
    gib_zurück p

# Rekursives Hit-Testing (z-Order: zuletzt hinzugefügt gewinnt).
# Panels/Scrollbereiche transformieren in ihr lokales Koordinatensystem;
# Scroll addiert scroll_y. Container decken ab: kein Kind getroffen →
# Container selbst ist der Treffer (blockt darunterliegende Widgets).
funktion _uim_treffer_rek(kinder, x, y):
    setze gefunden auf nichts
    setze geordnet auf _uim_kinder_z_sortiert(kinder)
    setze i auf länge(geordnet) - 1
    solange i >= 0:
        wenn gefunden == nichts:
            setze w auf geordnet[i]
            wenn w["sichtbar"]:
                setze im_rahmen auf x >= w["x"] und x < w["x"] + w["b"] und y >= w["y"] und y < w["y"] + w["h"]
                setze kinder_pruefen auf im_rahmen oder _uim_clip_kinder_aktiv(w) == falsch
                wenn w["aktiv"] == falsch:
                    # Deaktivierte Vorfahren geben nie Ereignisse an Kinder weiter.
                    wenn im_rahmen:
                        setze gefunden auf _uim_tref(w, x, y)
                sonst wenn w["typ"] == "tabs" und kinder_pruefen:
                    wenn im_rahmen und y < w["y"] + w["tab_h"]:
                        setze gefunden auf _uim_tref(w, x, y)
                    sonst wenn länge(w["kinder"]) > 0:
                        setze ti auf w["auswahl"]
                        setze tab auf w["kinder"][ti]
                        setze innen auf _uim_treffer_rek(tab["kinder"], x - w["x"], y - w["y"] - w["tab_h"])
                        wenn innen != nichts:
                            setze gefunden auf innen
                        sonst wenn im_rahmen:
                            setze gefunden auf _uim_tref(w, x, y)
                    sonst wenn im_rahmen:
                        setze gefunden auf _uim_tref(w, x, y)
                sonst wenn w["typ"] == "expander" und kinder_pruefen:
                    wenn im_rahmen und y < w["y"] + w["kauff_h"]:
                        setze gefunden auf _uim_tref(w, x, y)
                    sonst wenn w["offen"]:
                        setze innen auf _uim_treffer_rek(w["kinder"], x - w["x"], y - w["y"] - w["kauff_h"])
                        wenn innen != nichts:
                            setze gefunden auf innen
                        sonst wenn im_rahmen:
                            setze gefunden auf _uim_tref(w, x, y)
                    sonst wenn im_rahmen:
                        setze gefunden auf _uim_tref(w, x, y)
                sonst wenn w["typ"] == "toolbar" und kinder_pruefen:
                    setze innen auf _uim_treffer_rek(w["kinder"], x - w["x"], y - w["y"])
                    wenn innen != nichts:
                        setze gefunden auf innen
                    sonst wenn im_rahmen:
                        setze gefunden auf _uim_tref(w, x, y)
                sonst wenn w["typ"] == "teiler" und kinder_pruefen:
                    _uim_teiler_layout(w)
                    setze innen auf _uim_treffer_rek(w["kinder"], x - w["x"], y - w["y"])
                    wenn innen != nichts:
                        setze gefunden auf innen
                    sonst wenn im_rahmen:
                        setze gefunden auf _uim_tref(w, x - w["x"], y - w["y"])
                sonst wenn w["typ"] == "karte" und kinder_pruefen:
                    setze innen auf _uim_treffer_rek(w["kinder"], x - w["x"], y - w["y"] - w["titel_h"])
                    wenn innen != nichts:
                        setze gefunden auf innen
                    sonst wenn im_rahmen:
                        setze gefunden auf _uim_tref(w, x - w["x"], y - w["y"])
                sonst wenn (w["typ"] == "stapel" oder w["typ"] == "gitter") und kinder_pruefen:
                    setze innen auf _uim_treffer_rek(w["kinder"], x - w["x"], y - w["y"])
                    wenn innen != nichts:
                        setze gefunden auf innen
                    sonst wenn im_rahmen:
                        setze gefunden auf _uim_tref(w, x - w["x"], y - w["y"])
                sonst wenn w["typ"] == "ueberlagerung" and kinder_pruefen:
                    wenn w["offen"]:
                        _uim_ueberlagerung_layout(w)
                        setze innen auf _uim_treffer_rek(w["kinder"], x - w["x"], y - w["y"])
                        wenn innen != nichts:
                            setze gefunden auf innen
                        sonst wenn im_rahmen and w["modal"]:
                            setze gefunden auf _uim_tref(w, x - w["x"], y - w["y"])
                sonst wenn w["typ"] == "panel" and kinder_pruefen:
                    wenn im_rahmen and x >= w["x"] + w["b"] - 8 and w["inhalt_hoehe"] > w["h"]:
                        setze gefunden auf _uim_tref(w, x, y)
                    sonst:
                        setze innen auf _uim_treffer_rek(w["kinder"], x - w["x"], y - w["y"] + w["scroll_y"])
                        wenn innen != nichts:
                            setze gefunden auf innen
                        sonst wenn im_rahmen:
                            setze gefunden auf _uim_tref(w, x, y)
                sonst wenn w["typ"] == "scroll" and kinder_pruefen:
                    wenn im_rahmen and x >= w["x"] + w["b"] - 8 and w["inhalt_hoehe"] > w["h"]:
                        setze gefunden auf _uim_tref(w, x, y)
                    sonst:
                        setze innen auf _uim_treffer_rek(w["kinder"], x - w["x"], y - w["y"] + w["scroll_y"])
                        wenn innen != nichts:
                            setze gefunden auf innen
                        sonst wenn im_rahmen:
                            setze gefunden auf _uim_tref(w, x, y)
                sonst wenn im_rahmen:
                    setze gefunden auf _uim_tref(w, x, y)
        setze i auf i - 1
    gib_zurück gefunden

funktion _uim_treffer(kontext, x, y):
    gib_zurück _uim_treffer_rek(kontext["wurzel"]["kinder"], x, y)

# Oberstes scrollbares Widget (scroll/liste) unter dem Punkt.
funktion _uim_scrollziel_rek(kinder, x, y):
    setze gefunden auf nichts
    setze geordnet auf _uim_kinder_z_sortiert(kinder)
    setze i auf länge(geordnet) - 1
    solange i >= 0:
        wenn gefunden == nichts:
            setze w auf geordnet[i]
            wenn w["sichtbar"]:
                wenn x >= w["x"] und x < w["x"] + w["b"] und y >= w["y"] und y < w["y"] + w["h"]:
                    wenn w["aktiv"] == falsch:
                        setze gefunden auf w
                    sonst wenn w["typ"] == "panel":
                        setze gefunden auf _uim_scrollziel_rek(w["kinder"], x - w["x"], y - w["y"])
                    sonst wenn w["typ"] == "scroll":
                        setze innen auf _uim_scrollziel_rek(w["kinder"], x - w["x"], y - w["y"] + w["scroll_y"])
                        wenn innen == nichts:
                            setze gefunden auf w
                        sonst:
                            setze gefunden auf innen
                    sonst wenn w["typ"] == "liste" oder w["typ"] == "baum" oder w["typ"] == "datengitter" oder w["typ"] == "iconview" oder w["typ"] == "terminal" oder w["typ"] == "markdown" oder w["typ"] == "multiline":
                        setze gefunden auf w
        setze i auf i - 1
    gib_zurück gefunden

# Klick-Aktivierung, typ-bewusst: Knopf feuert on_klick, Checkbox
# toggelt + feuert on_wechsel. (Slider aktiviert nicht per Klick-Ende —
# sein Wert wird schon bei Press/Drag gesetzt.)
funktion _uim_radio_gruppe_rek(kinder, gruppe, uid):
    für kandidat in kinder:
        wenn kandidat["typ"] == "radio" und kandidat["gruppe"] == gruppe und kandidat["uid"] != uid:
            kandidat["wert"] = falsch
            kandidat["selected"] = falsch
            kandidat["zustand"] = "normal"
        _uim_radio_gruppe_rek(kandidat["kinder"], gruppe, uid)
    gib_zurück wahr

funktion _uim_bewertung_setze_aus_x(w, x):
    setze maximal auf w["max"]
    wenn maximal <= 0:
        gib_zurück falsch
    setze rel auf x - w["x"]
    wenn rel < 0:
        setze rel auf 0
    wenn rel >= w["b"]:
        setze rel auf w["b"] - 1
    setze wert auf boden(rel * maximal / w["b"]) + 1
    wenn wert < 1:
        setze wert auf 1
    wenn wert > maximal:
        setze wert auf maximal
    w["wert"] = wert
    w["selected"] = wahr
    w["zustand"] = "selected"
    gib_zurück wahr

funktion _uim_tick_rek(kinder, schritt):
    setze tick_aktiv auf falsch
    für w in kinder:
        wenn w["typ"] == "spinner":
            w["wert"] = (w["wert"] + 1) % w["max"]
            setze tick_aktiv auf wahr
        wenn w["typ"] == "statusansicht" und w["status_modus"] == "laden":
            w["phase"] = (w["phase"] + 1) % 8
            setze tick_aktiv auf wahr
        wenn w["typ"] == "fortschritt" und w["unbestimmt"]:
            w["phase"] = w["phase"] + schritt
            solange w["phase"] >= 1:
                w["phase"] = w["phase"] - 1
            solange w["phase"] < 0:
                w["phase"] = w["phase"] + 1
            setze tick_aktiv auf wahr
        wenn w["typ"] == "ueberlagerung" und w["offen"] und w.enthält("rest_ticks"):
            w["rest_ticks"] = w["rest_ticks"] - schritt
            setze tick_aktiv auf wahr
            wenn w["rest_ticks"] <= 0:
                w["offen"] = falsch
                w["sichtbar"] = falsch
                setze cb_tick auf w["on_schliessen"]
                wenn cb_tick != nichts:
                    cb_tick(w)
        wenn _uim_tick_rek(w["kinder"], schritt):
            setze tick_aktiv auf wahr
    gib_zurück tick_aktiv

funktion uim_tick(kontext, schritt):
    wenn kontext == nichts:
        gib_zurück falsch
    wenn schritt <= 0:
        setze schritt auf 0.1
    setze tick_aktiv auf _uim_tick_rek(kontext["wurzel"]["kinder"], schritt)
    wenn kontext.enthält("tooltip_widget") und kontext["tooltip_widget"] != nichts:
        setze tw auf kontext["tooltip_widget"]
        wenn tw.enthält("tooltip") und tw["tooltip"] != nichts und tw["hover"]:
            kontext["tooltip_ticks"] = kontext["tooltip_ticks"] + schritt
            setze tick_aktiv auf wahr
        sonst:
            kontext["tooltip_ticks"] = 0
    kontext["_tick_aktiv"] = tick_aktiv
    wenn tick_aktiv:
        _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_aktiviere(kontext, w):
    wenn _uim_ist_interaktiv(kontext, w) == falsch:
        gib_zurück falsch
    wenn w["typ"] == "ueberlagerung":
        wenn w["schliesst_aussen"] und w["offen"]:
            _uim_dialog_schliesse(kontext, w, 0 - 1)
        gib_zurück wahr
    wenn w.enthält("dialog") and w["dialog"] != nichts:
        _uim_dialog_aktion(kontext, w["dialog"], w["dialog_index"])
        gib_zurück wahr
    wenn w.enthält("snackbar") and w["snackbar"] != nichts:
        _uim_snackbar_aktion(kontext, w["snackbar"])
        gib_zurück wahr
    wenn w["typ"] == "expander":
        w["offen"] = w["offen"] == falsch
        setze cw auf w["on_wechsel"]
        wenn cw != nichts:
            cw(w, w["offen"])
        gib_zurück wahr
    wenn w["typ"] == "rating":
        setze cw auf w["on_wechsel"]
        wenn cw != nichts:
            cw(w, w["wert"])
        gib_zurück wahr
    wenn w["typ"] == "switch" oder w["typ"] == "toggle":
        wenn w["wert"]:
            w["wert"] = falsch
        sonst:
            w["wert"] = wahr
        w["selected"] = w["wert"]
        wenn w["selected"]:
            w["zustand"] = "selected"
        sonst:
            w["zustand"] = "normal"
        setze cw auf w["on_wechsel"]
        wenn cw != nichts:
            cw(w, w["wert"])
        gib_zurück wahr
    wenn w["typ"] == "radio":
        _uim_radio_gruppe_rek(kontext["wurzel"]["kinder"], w["gruppe"], w["uid"])
        w["wert"] = wahr
        w["selected"] = wahr
        w["zustand"] = "selected"
        setze cw auf w["on_wechsel"]
        wenn cw != nichts:
            cw(w, wahr)
        gib_zurück wahr
    wenn w["typ"] == "checkbox":
        wenn w["wert"]:
            w["wert"] = falsch
        sonst:
            w["wert"] = wahr
        w["selected"] = w["wert"]
        wenn w["selected"]:
            w["zustand"] = "selected"
        sonst:
            w["zustand"] = "normal"
        setze cw auf w["on_wechsel"]
        wenn cw != nichts:
            cw(w, w["wert"])
        gib_zurück wahr
    setze cb auf w["on_klick"]
    wenn cb == nichts:
        gib_zurück falsch
    # UI-13/STATUS: geschuetzte Knoepfe werden vor dem Callback gesperrt.
    # Damit kann auch ein reentranter zweiter Klick die Aktion nicht doppelt starten.
    wenn w["typ"] == "knopf" und w.enthält("aktion_laeuft") und w["aktion_laeuft"]:
        gib_zurück falsch
    wenn w["typ"] == "knopf" und w.enthält("auto_sperre") und w["auto_sperre"]:
        w["aktion_laeuft"] = wahr
        w["disabled"] = wahr
        w["zustand"] = "disabled"
        cb(w)
        w["aktion_laeuft"] = falsch
        w["disabled"] = falsch
        w["zustand"] = "normal"
        gib_zurück wahr
    cb(w)
    gib_zurück wahr

# Slider-Wert aus Maus-X ableiten (klemmt auf min..max) und bei
# Änderung on_wechsel feuern. Liefert wahr wenn sich der Wert änderte.
funktion _uim_slider_setze_aus_x(w, x):
    setze spanne auf w["max"] - w["min"]
    wenn spanne <= 0:
        gib_zurück falsch
    setze anteil auf (x - w["x"]) / w["b"]
    wenn anteil < 0:
        setze anteil auf 0
    wenn anteil > 1:
        setze anteil auf 1
    setze wert auf w["min"] + anteil * spanne
    wenn wert == w["wert"]:
        gib_zurück falsch
    w["wert"] = wert
    setze cw auf w["on_wechsel"]
    wenn cw != nichts:
        cw(w, wert)
    gib_zurück wahr

# Wenn Tab-Fokus ein Kind in einem Scrollbereich erreicht, wird der direkte
# Inhaltszweig, der das Ziel enthaelt, in den Viewport gebracht.
funktion _uim_fokus_scroll_sichtbar_rek(kontext, kinder, uid):
    setze gefunden auf falsch
    für w in kinder:
        wenn w["typ"] == "scroll":
            für kind in w["kinder"]:
                wenn kind["uid"] == uid oder _uim_finde_uid_rek(kind["kinder"], uid) != nichts:
                    setze oben auf kind["y"]
                    setze unten auf kind["y"] + kind["h"]
                    wenn oben < w["scroll_y"]:
                        w["scroll_y"] = oben
                    wenn unten > w["scroll_y"] + w["h"]:
                        w["scroll_y"] = unten - w["h"]
                    _uim_scroll_klemme(kontext, w)
                    setze gefunden auf wahr
        wenn _uim_fokus_scroll_sichtbar_rek(kontext, w["kinder"], uid):
            setze gefunden auf wahr
    gib_zurück gefunden


# Fokus auf nächstes fokussierbares Widget (Tab-Reihenfolge =
# Einfüge-Reihenfolge, mit Umlauf). rueckwaerts: wahr bei Shift+Tab.
funktion _uim_fokus_weiter(kontext, rueckwaerts):
    setze ziele auf []
    setze fokus_basis auf kontext["wurzel"]["kinder"]
    wenn kontext.enthält("modal_overlay") und kontext["modal_overlay"] != nichts und kontext["modal_overlay"]["offen"]:
        setze fokus_basis auf kontext["modal_overlay"]["kinder"]
    _uim_fokus_uids(fokus_basis, ziele)
    setze n auf länge(ziele)
    wenn n == 0:
        kontext["fokus"] = nichts
        gib_zurück falsch
    setze aktuell_uid auf _uim_slot_uid(kontext, "fokus")
    setze gefunden auf falsch
    setze start auf 0
    setze i auf 0
    solange i < n:
        wenn ziele[i] == aktuell_uid:
            setze start auf i
            setze gefunden auf wahr
        setze i auf i + 1
    setze schritt auf 1
    wenn rueckwaerts:
        setze schritt auf n - 1
        wenn gefunden == falsch:
            setze start auf 0
    sonst wenn gefunden == falsch:
        setze start auf n - 1
    setze idx auf (start + schritt) % n
    setze ziel_uid auf ziele[idx]
    setze kontext["fokus"] auf _uim_finde_uid_rek(fokus_basis, ziel_uid)
    wenn kontext["fokus"] != nichts:
        _uim_fokus_scroll_sichtbar_rek(kontext, kontext["wurzel"]["kinder"], ziel_uid)
    gib_zurück kontext["fokus"] != nichts

# Listen-Zeilenhöhe: rein theme-getrieben.
funktion _uim_zeilenhoehe(kontext):
    setze t auf kontext["theme"]
    gib_zurück t["schrift"] + t["abstand"]

# Listen-Klick: Zeile aus lokaler Y-Koordinate (ohne floor-Builtin:
# beschränkte Zählschleife). Setzt auswahl + feuert on_auswahl.
funktion _uim_liste_klick(kontext, w, ly):
    setze zh auf _uim_zeilenhoehe(kontext)
    setze rel auf ly - w["y"] + w["scroll_y"]
    wenn rel < 0:
        gib_zurück falsch
    setze idx auf 0
    solange (idx + 1) * zh <= rel:
        setze idx auf idx + 1
    wenn idx >= länge(w["zeilen"]):
        gib_zurück falsch
    w["auswahl"] = idx
    w["selected"] = wahr
    w["zustand"] = "selected"
    setze cb auf w["on_auswahl"]
    wenn cb != nichts:
        cb(w, idx)
    gib_zurück wahr

# ------------------------------------------------------------
# Event-Dispatcher (an die Leinwand gebunden von uim_wurzel)
# ------------------------------------------------------------

funktion _uim_kern_maus(kontext, x, y, taste):
    wenn taste == 3:
        setze cm auf _uim_kontextmenue_finde_rek(kontext["wurzel"]["kinder"])
        wenn cm != nichts:
            cm["x"] = x
            cm["y"] = y
            cm["offen"] = wahr
            cm["sichtbar"] = wahr
            kontext["kontext_offen"] = cm
            kontext["kontext_hover"] = 0 - 1
            _uim_anfordern(kontext)
            gib_zurück wahr
        gib_zurück falsch
    wenn taste != 1:
        gib_zurück falsch
    # Offenes Kontextmenue liegt z-oberst und faengt Klicks zuerst ab.
    wenn kontext["kontext_offen"] != nichts:
        setze cm2 auf kontext["kontext_offen"]
        setze cr2 auf kontext["kontext_rect"]
        wenn cr2 != nichts und x >= cr2["x"] und x < cr2["x"] + cr2["b"] und y >= cr2["y"] und y < cr2["y"] + cr2["h"]:
            setze zh2 auf _uim_zeilenhoehe(kontext)
            setze py2 auf cr2["y"]
            setze i2 auf 0
            solange i2 < länge(cm2["punkte"]):
                setze ph2 auf zh2
                wenn cm2["punkte"][i2]["typ"] == "trenner":
                    setze ph2 auf boden(zh2 / 2)
                wenn y >= py2 und y < py2 + ph2:
                    wenn cm2["punkte"][i2]["typ"] == "punkt":
                        setze cb2 auf cm2["punkte"][i2]["cb"]
                        uim_kontextmenue_schliessen(kontext)
                        wenn cb2 != nichts:
                            cb2(cm2["punkte"][i2])
                    sonst:
                        uim_kontextmenue_schliessen(kontext)
                    _uim_anfordern(kontext)
                    gib_zurück wahr
                setze py2 auf py2 + ph2
                setze i2 auf i2 + 1
            uim_kontextmenue_schliessen(kontext)
        sonst:
            uim_kontextmenue_schliessen(kontext)
        _uim_anfordern(kontext)
        gib_zurück wahr
    # Offenes Menue liegt z-oberst und faengt Klicks als Erstes ab.
    wenn kontext.enthält("menue_offen") und kontext["menue_offen"] != nichts:
        setze mw auf kontext["menue_offen"]
        setze mr auf nichts
        wenn kontext.enthält("menue_rect"):
            setze mr auf kontext["menue_rect"]
        wenn mr != nichts und x >= mr["x"] und x < mr["x"] + mr["b"] und y >= mr["y"] und y < mr["y"] + mr["h"]:
            setze punkte auf mw["eintraege"][mw["offen"]]["punkte"]
            setze zh auf _uim_zeilenhoehe(kontext)
            setze py auf mr["y"]
            setze i auf 0
            solange i < länge(punkte):
                setze ph auf zh
                wenn punkte[i]["typ"] == "trenner":
                    setze ph auf boden(zh / 2)
                wenn y >= py und y < py + ph:
                    wenn punkte[i]["typ"] == "punkt":
                        setze pcb auf punkte[i]["cb"]
                        setze pw auf punkte[i]
                        _uim_menue_schliessen(kontext)
                        wenn pcb != nichts:
                            pcb(pw)
                        _uim_anfordern(kontext)
                    gib_zurück wahr
                setze py auf py + ph
                setze i auf i + 1
            gib_zurück wahr
        # Klick auf die Leiste: Toggle bzw. Titel-Wechsel.
        setze mu auf nichts
        wenn kontext.enthält("menue_urspr"):
            setze mu auf kontext["menue_urspr"]
        wenn mu != nichts und x >= mu["x"] und x < mu["x"] + mw["b"] und y >= mu["y"] und y < mu["y"] + mw["h"]:
            setze mti auf _uim_menue_titel_bei(kontext, mw, x - mu["x"])
            wenn mti != nichts und mti["idx"] != mw["offen"]:
                mw["offen"] = mti["idx"]
                kontext["menue_hover"] = 0 - 1
            sonst:
                _uim_menue_schliessen(kontext)
            _uim_anfordern(kontext)
            gib_zurück wahr
        _uim_menue_schliessen(kontext)
        _uim_anfordern(kontext)
        gib_zurück wahr
    # Offenes Combobox-Dropdown liegt z-oberst und fängt Klicks VOR dem
    # regulären Hit-Test ab (das Overlay ragt über die Widget-Bounds).
    wenn kontext.enthält("combo_offen") und kontext["combo_offen"] != nichts:
        setze cbw auf kontext["combo_offen"]
        setze cr auf nichts
        wenn kontext.enthält("combo_rect"):
            setze cr auf kontext["combo_rect"]
        wenn cr != nichts und x >= cr["x"] und x < cr["x"] + cr["b"] und y >= cr["y"] und y < cr["y"] + cr["h"]:
            setze zh auf _uim_zeilenhoehe(kontext)
            setze idx auf boden((y - cr["y"]) / zh)
            setze n auf länge(cbw["zeilen"])
            wenn idx < 0:
                setze idx auf 0
            wenn idx > n - 1:
                setze idx auf n - 1
            cbw["offen"] = falsch
            kontext["combo_offen"] = nichts
            wenn idx != cbw["auswahl"]:
                cbw["auswahl"] = idx
                setze cba auf cbw["on_auswahl"]
                wenn cba != nichts:
                    cba(cbw, idx)
            _uim_anfordern(kontext)
            gib_zurück wahr
        cbw["offen"] = falsch
        kontext["combo_offen"] = nichts
        setze cf auf nichts
        wenn kontext.enthält("combo_feld"):
            setze cf auf kontext["combo_feld"]
        wenn cf != nichts und x >= cf["x"] und x < cf["x"] + cf["b"] und y >= cf["y"] und y < cf["y"] + cf["h"]:
            # Klick aufs Feld bei offenem Dropdown = Toggle-zu, nicht neu öffnen.
            _uim_anfordern(kontext)
            gib_zurück wahr
    setze tref auf _uim_treffer(kontext, x, y)
    wenn tref == nichts:
        _uim_druck_loesche(kontext)
        kontext["fokus"] = nichts
    sonst:
        setze w auf tref["w"]
        wenn w["typ"] == "teiler":
            _uim_teiler_layout(w)
            wenn _uim_teiler_trennlinie_treffer(w, tref["lx"], tref["ly"]):
                kontext["druck"] = w
                kontext["druck_art"] = "teiler"
                kontext["teiler"] = w
                w["druck"] = wahr
                _uim_anfordern(kontext)
                gib_zurück wahr
        wenn w["aktiv"] == falsch oder w["sichtbar"] == falsch:
            _uim_druck_loesche(kontext)
            wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
                kontext["fokus"] = nichts
        sonst:
            kontext["druck"] = w
            kontext["druck_art"] = "widget"
            # Offset Leinwand-global -> Widget-Eltern-lokal, fuer Drag ausserhalb.
            kontext["druck_ox"] = x - tref["lx"]
            kontext["druck_oy"] = y - tref["ly"]
            w["druck"] = wahr
            wenn w["ziehbar"]:
                kontext["drag_quelle"] = w
                kontext["drag_aktiv"] = falsch
            wenn w["fokussierbar"]:
                setze fokus_alt auf kontext["fokus"]
                wenn fokus_alt != w:
                    wenn fokus_alt != nichts und fokus_alt["on_fokus"] != nichts:
                        setze fokus_alt_cb auf fokus_alt["on_fokus"]
                        fokus_alt_cb(fokus_alt, falsch)
                    kontext["fokus"] = w
                    wenn w["on_fokus"] != nichts:
                        setze fokus_neu_cb auf w["on_fokus"]
                        fokus_neu_cb(w, wahr)
            wenn w["typ"] == "rating":
                _uim_bewertung_setze_aus_x(w, tref["lx"])
            wenn w["typ"] == "slider":
                kontext["druck_art"] = "slider"
                _uim_slider_setze_aus_x(w, tref["lx"])
            wenn w["typ"] == "scroll" und tref["lx"] >= w["x"] + w["b"] - 8 und w["inhalt_hoehe"] > w["h"]:
                kontext["druck_art"] = "scrollbar"
                setze max_scroll auf _uim_scroll_max(kontext, w)
                setze thumb_h auf _uim_scroll_thumb_h(w)
                setze thumb_y auf w["y"]
                wenn max_scroll > 0:
                    setze thumb_y auf w["y"] + (w["h"] - thumb_h) * (w["scroll_y"] / max_scroll)
                setze greif auf tref["ly"] - thumb_y
                wenn greif < 0 oder greif > thumb_h:
                    setze greif auf thumb_h / 2
                kontext["druck_greif_y"] = greif
                _uim_scroll_setze_aus_y(kontext, w, tref["ly"], greif)
    wenn w["typ"] == "liste":
        _uim_liste_klick(kontext, w, tref["ly"])
    wenn w["typ"] == "baum":
        _uim_baum_klick(kontext, w, tref["lx"], tref["ly"])
    wenn w["typ"] == "datengitter":
        _uim_datengitter_klick(kontext, w, tref["ly"])
    wenn w["typ"] == "iconview":
        _uim_iconview_klick(kontext, w, tref["lx"], tref["ly"])
    wenn w["typ"] == "colorpicker":
        _uim_colorpicker_klick(kontext, w, tref["lx"], tref["ly"])
    wenn w["typ"] == "calendar":
        _uim_kalender_klick(kontext, w, tref["lx"], tref["ly"])
    wenn w["typ"] == "datepicker":
        _uim_datepicker_toggle(kontext, w)
    wenn w["typ"] == "linechart" oder w["typ"] == "barchart" oder w["typ"] == "piechart":
        _uim_chart_klick(kontext, w, tref["lx"], tref["ly"])
    wenn w["typ"] == "gauge":
        _uim_gauge_klick(kontext, w, tref["lx"])
    wenn w["typ"] == "combobox":
                w["offen"] = wahr
                kontext["combo_offen"] = w
            wenn w["typ"] == "tabs":
                _uim_tabs_aus_x(kontext, w, tref["lx"])
            wenn w["typ"] == "menueleiste":
                setze mti2 auf _uim_menue_titel_bei(kontext, w, tref["lx"] - w["x"])
                wenn mti2 != nichts:
                    w["offen"] = mti2["idx"]
                    kontext["menue_offen"] = w
                    kontext["menue_hover"] = 0 - 1
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_kern_maus_los(kontext, x, y, taste):
    wenn taste != 1:
        gib_zurück falsch
    setze p auf kontext["druck"]
    wenn p == nichts:
        gib_zurück falsch
    setze art auf kontext["druck_art"]
    _uim_druck_loesche(kontext)
    setze los_cb auf p["on_loslassen"]
    wenn los_cb != nichts:
        los_cb(p, x, y)
    wenn kontext["drag_quelle"] != nichts:
        setze drag_quelle auf kontext["drag_quelle"]
        setze drag_treffer auf _uim_treffer(kontext, x, y)
        kontext["drag_quelle"] = nichts
        kontext["drag_aktiv"] = falsch
        wenn drag_treffer != nichts:
            setze drag_ziel auf drag_treffer["w"]
            wenn drag_ziel["dropziel"] und drag_ziel["on_drop"] != nichts and drag_ziel["uid"] != drag_quelle["uid"]:
                setze drop_cb auf drag_ziel["on_drop"]
                drop_cb(drag_ziel, drag_quelle["drag_daten"], drag_quelle)
                _uim_anfordern(kontext)
                gib_zurück wahr
    wenn art == "teiler":
        _uim_teiler_layout(p)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn art == "slider" oder art == "scrollbar":
        # Drag-Ende: Wert/Scrollposition wurde bereits bei Press/Drag gesetzt.
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn _uim_ist_interaktiv(kontext, p) == falsch:
        _uim_anfordern(kontext)
        gib_zurück wahr
    setze tref auf _uim_treffer(kontext, x, y)
    wenn tref != nichts:
        setze ziel auf tref["w"]
        wenn ziel["uid"] == p["uid"]:
            _uim_aktiviere(kontext, p)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_kern_bewegung(kontext, x, y):
    # Offenes Menue: Punkt-Hover + klassischer Titel-Wechsel bei Hover.
    wenn kontext.enthält("menue_offen") und kontext["menue_offen"] != nichts:
        setze mw auf kontext["menue_offen"]
        setze mr auf nichts
        wenn kontext.enthält("menue_rect"):
            setze mr auf kontext["menue_rect"]
        wenn mr != nichts und x >= mr["x"] und x < mr["x"] + mr["b"] und y >= mr["y"] und y < mr["y"] + mr["h"]:
            setze punkte auf mw["eintraege"][mw["offen"]]["punkte"]
            setze zh auf _uim_zeilenhoehe(kontext)
            setze py auf mr["y"]
            setze i auf 0
            setze hov_idx auf 0 - 1
            solange i < länge(punkte):
                setze ph auf zh
                wenn punkte[i]["typ"] == "trenner":
                    setze ph auf boden(zh / 2)
                wenn y >= py und y < py + ph und punkte[i]["typ"] == "punkt":
                    setze hov_idx auf i
                setze py auf py + ph
                setze i auf i + 1
            wenn kontext.enthält("menue_hover") == falsch oder hov_idx != kontext["menue_hover"]:
                kontext["menue_hover"] = hov_idx
                _uim_anfordern(kontext)
            gib_zurück wahr
        setze mu auf nichts
        wenn kontext.enthält("menue_urspr"):
            setze mu auf kontext["menue_urspr"]
        wenn mu != nichts und x >= mu["x"] und x < mu["x"] + mw["b"] und y >= mu["y"] und y < mu["y"] + mw["h"]:
            setze mti auf _uim_menue_titel_bei(kontext, mw, x - mu["x"])
            wenn mti != nichts und mti["idx"] != mw["offen"]:
                mw["offen"] = mti["idx"]
                kontext["menue_hover"] = 0 - 1
                _uim_anfordern(kontext)
            gib_zurück wahr
    # Aktiver Capture hat Vorrang vor Hover; Eltern-lokale Koordinaten
    # entstehen aus dem beim Press gemerkten globalen Offset.
    setze p auf kontext["druck"]
    wenn p != nichts:
        wenn kontext["drag_quelle"] != nichts:
            kontext["drag_aktiv"] = wahr
        wenn _uim_ist_interaktiv(kontext, p) == falsch:
            _uim_druck_loesche(kontext)
            _uim_anfordern(kontext)
            gib_zurück wahr
        wenn kontext["druck_art"] == "teiler":
            wenn _uim_teiler_ziehen(p, x, y):
                _uim_anfordern(kontext)
            gib_zurück wahr
        wenn kontext["druck_art"] == "slider":
            wenn _uim_slider_setze_aus_x(p, x - kontext["druck_ox"]):
                _uim_anfordern(kontext)
            gib_zurück wahr
        wenn kontext["druck_art"] == "scrollbar":
            wenn _uim_scroll_setze_aus_y(kontext, p, y - kontext["druck_oy"], kontext["druck_greif_y"]):
                _uim_anfordern(kontext)
            gib_zurück wahr
    setze tref auf _uim_treffer(kontext, x, y)
    setze w auf nichts
    wenn tref != nichts:
        setze w auf tref["w"]
    setze uid_treffer auf 0
    wenn w != nichts:
        setze uid_treffer auf w["uid"]
    setze alt_uid auf _uim_slot_uid(kontext, "hover")
    wenn uid_treffer == alt_uid:
        gib_zurück wahr
    setze alt auf kontext["hover"]
    wenn alt != nichts:
        alt["hover"] = falsch
    wenn w != nichts:
        w["hover"] = wahr
    kontext["hover"] = w
    wenn w != nichts und w.enthält("tooltip") und w["tooltip"] != nichts:
        wenn kontext["tooltip_widget"] == nichts oder kontext["tooltip_widget"]["uid"] != w["uid"]:
            kontext["tooltip_ticks"] = 0
        kontext["tooltip_widget"] = w
        kontext["tooltip_x"] = x
        kontext["tooltip_y"] = y
    sonst:
        kontext["tooltip_widget"] = nichts
        kontext["tooltip_ticks"] = 0
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_kern_taste(kontext, taste, gedrueckt, mod):
    wenn gedrueckt und taste == "Escape" und kontext.enthält("modal_overlay") und kontext["modal_overlay"] != nichts:
        setze modal_taste auf kontext["modal_overlay"]
        wenn modal_taste["offen"]:
            _uim_dialog_schliesse(kontext, modal_taste, 0 - 1)
            _uim_anfordern(kontext)
            gib_zurück wahr
    wenn gedrueckt und taste == "Escape" und kontext.enthält("menue_offen") und kontext["menue_offen"] != nichts:
        _uim_menue_schliessen(kontext)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn gedrueckt == falsch:
        gib_zurück falsch
    wenn taste == "Tab":
        setze rueck auf falsch
        wenn mod % 2 == 1:
            setze rueck auf wahr
        _uim_fokus_weiter(kontext, rueck)
        _uim_anfordern(kontext)
        gib_zurück wahr
    setze f auf kontext["fokus"]
    wenn f == nichts:
        gib_zurück falsch
    wenn _uim_ist_interaktiv(kontext, f) == falsch:
        kontext["fokus"] = nichts
        _uim_anfordern(kontext)
        gib_zurück falsch
    wenn f["typ"] == "autocomplete" und (taste == "Up" oder taste == "Down"):
        setze n_suggest auf länge(f["vorschlaege"])
        wenn n_suggest == 0:
            gib_zurück wahr
        setze idx_suggest auf f["auswahl"]
        wenn idx_suggest < 0:
            setze idx_suggest auf 0
        sonst wenn taste == "Down":
            setze idx_suggest auf idx_suggest + 1
        sonst:
            setze idx_suggest auf idx_suggest - 1
        wenn idx_suggest < 0:
            setze idx_suggest auf 0
        wenn idx_suggest > n_suggest - 1:
            setze idx_suggest auf n_suggest - 1
        f["auswahl"] = idx_suggest
        f["text"] = text(f["vorschlaege"][idx_suggest])
        f["cursor"] = länge(bytes_zu_liste(f["text"]))
        f["eingabe_zustand"] = "filled"
        _uim_tf_feuere_wechsel(kontext, f)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "textfeld" oder f["typ"] == "searchbox" oder f["typ"] == "numberbox" oder f["typ"] == "passwordbox" oder f["typ"] == "multiline" oder f["typ"] == "autocomplete":
        setze geaendert auf falsch
        wenn f["typ"] != "multiline" und (taste == "BackSpace" oder (taste != "Left" und taste != "Right" und taste != "Home" und taste != "End" und taste != "Return")):
            _uim_tf_verlauf_merke(f)
        sonst wenn f["typ"] == "multiline" und taste != "BackSpace" und taste != "Left" und taste != "Right" und taste != "Up" und taste != "Down" und taste != "Home" und taste != "End" und taste != "Return":
            _uim_tf_verlauf_merke(f)
        setze bytes auf bytes_zu_liste(f["text"])
        wenn f["cursor"] < 0:
            f["cursor"] = 0
        wenn f["cursor"] > länge(bytes):
            f["cursor"] = länge(bytes)
        wenn taste == "BackSpace":
            wenn f["cursor"] > 0:
                wenn f["typ"] == "multiline":
                    _uim_tf_verlauf_merke(f)
                setze p auf _uim_tf_grenze_zurueck(bytes, f["cursor"])
                setze nb auf _uim_tf_teil(bytes, 0, p)
                setze rest auf _uim_tf_teil(bytes, f["cursor"], länge(bytes))
                für bb in rest:
                    nb.hinzufügen(bb)
                f["text"] = bytes_neu(nb)
                f["cursor"] = p
                wenn f["text"] == "":
                    f["eingabe_zustand"] = "empty"
                sonst:
                    f["eingabe_zustand"] = "filled"
                setze geaendert auf wahr
        sonst wenn taste == "Left":
            f["cursor"] = _uim_tf_grenze_zurueck(bytes, f["cursor"])
            _uim_multiline_spalte_reset(f)
        sonst wenn taste == "Right":
            f["cursor"] = _uim_tf_grenze_vor(bytes, f["cursor"])
            _uim_multiline_spalte_reset(f)
        sonst wenn taste == "Home":
            wenn f["typ"] == "multiline":
                _uim_multiline_navigiere(f, taste)
            sonst:
                f["cursor"] = 0
        sonst wenn taste == "End":
            wenn f["typ"] == "multiline":
                _uim_multiline_navigiere(f, taste)
            sonst:
                f["cursor"] = länge(bytes)
        sonst wenn (taste == "Up" oder taste == "Down") und f["typ"] == "multiline":
            _uim_multiline_navigiere(f, taste)
        sonst wenn taste == "Return":
            wenn f["typ"] == "multiline":
                setze multiline_strg auf mod % 4 >= 2
                wenn multiline_strg:
                    wenn f.enthält("dialog") und f["dialog"] != nichts:
                        _uim_dialog_aktion(kontext, f["dialog"], f["dialog"]["standard_button"])
                sonst:
                    _uim_tf_verlauf_merke(f)
                    setze geaendert auf _uim_multiline_lf_einfuegen(f)
            sonst wenn f.enthält("dialog") und f["dialog"] != nichts:
                _uim_dialog_aktion(kontext, f["dialog"], f["dialog"]["standard_button"])
            sonst:
                _uim_aktiviere(kontext, f)
        sonst:
            setze eingabe auf taste
            wenn taste == "space":
                setze eingabe auf " "
            wenn _uim_tf_einfuegen(kontext, f, bytes_zu_liste(eingabe)):
                setze geaendert auf wahr
        wenn geaendert:
            _uim_multiline_spalte_reset(f)
            _uim_tf_feuere_wechsel(kontext, f)
        wenn f["typ"] == "multiline":
            _uim_multiline_caret_sichtbar(kontext, f)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "combobox":
        wenn taste == "Return" oder taste == "space":
            wenn f["offen"]:
                f["offen"] = falsch
                kontext["combo_offen"] = nichts
            sonst:
                f["offen"] = wahr
                kontext["combo_offen"] = f
            _uim_anfordern(kontext)
            gib_zurück wahr
        wenn taste == "Escape":
            f["offen"] = falsch
            kontext["combo_offen"] = nichts
            _uim_anfordern(kontext)
            gib_zurück wahr
        wenn taste == "Up" oder taste == "Down":
            setze n auf länge(f["zeilen"])
            wenn n == 0:
                gib_zurück wahr
            setze idx auf f["auswahl"]
            wenn taste == "Up":
                setze idx auf idx - 1
            sonst:
                setze idx auf idx + 1
            wenn idx < 0:
                setze idx auf 0
            wenn idx > n - 1:
                setze idx auf n - 1
            wenn idx != f["auswahl"]:
                f["auswahl"] = idx
                setze cba auf f["on_auswahl"]
                wenn cba != nichts:
                    cba(f, idx)
            _uim_anfordern(kontext)
            gib_zurück wahr
    wenn (taste == "Return" oder taste == "space") und f["typ"] != "calendar" und f["typ"] != "datepicker" und f["typ"] != "terminal":
        _uim_aktiviere(kontext, f)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "slider":
        wenn taste == "Left" oder taste == "Right":
            setze schritt auf (f["max"] - f["min"]) / 20
            wenn schritt <= 0:
                setze schritt auf 1
            wenn taste == "Left":
                setze schritt auf 0 - schritt
            setze wert auf f["wert"] + schritt
            wenn wert < f["min"]:
                setze wert auf f["min"]
            wenn wert > f["max"]:
                setze wert auf f["max"]
            wenn wert != f["wert"]:
                f["wert"] = wert
                setze cw auf f["on_wechsel"]
                wenn cw != nichts:
                    cw(f, wert)
            _uim_anfordern(kontext)
            gib_zurück wahr
    wenn f["typ"] == "colorpicker":
        setze n_color auf länge(f["farben"])
        wenn n_color == 0:
            gib_zurück wahr
        setze idx_color auf f["auswahl"]
        wenn idx_color < 0:
            setze idx_color auf 0
        setze cols_color auf _uim_colorpicker_spalten(f)
        wenn taste == "Left":
            setze idx_color auf idx_color - 1
        sonst wenn taste == "Right":
            setze idx_color auf idx_color + 1
        sonst wenn taste == "Up":
            setze idx_color auf idx_color - cols_color
        sonst wenn taste == "Down":
            setze idx_color auf idx_color + cols_color
        sonst:
            gib_zurück wahr
        wenn idx_color < 0:
            setze idx_color auf 0
        wenn idx_color > n_color - 1:
            setze idx_color auf n_color - 1
        f["auswahl"] = idx_color
        f["selected"] = wahr
        setze cb_color auf f["on_auswahl"]
        wenn cb_color != nichts:
            cb_color(f, idx_color)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "calendar" oder f["typ"] == "datepicker":
        wenn f["typ"] == "datepicker" und f["offen"] == falsch und (taste == "Return" oder taste == "Enter" oder taste == "Space" oder taste == "Down"):
            gib_zurück _uim_datepicker_oeffne(kontext, f)
        wenn f["typ"] == "datepicker" und f["offen"]:
            gib_zurück wahr
        wenn f["ansicht"] != "monat":
            wenn taste == "Left" oder taste == "Up":
                uim_kalender_navigiere(f, 0 - 1)
            sonst wenn taste == "Right" oder taste == "Down":
                uim_kalender_navigiere(f, 1)
            gib_zurück wahr
        setze fokus_datum auf [f["fokus_tag"], f["fokus_monat"], f["fokus_jahr"]]
        wenn nicht _uim_kalender_datum_gueltig(fokus_datum):
            setze fokus_datum auf [f["auswahl"], f["monat"], f["jahr"]]
        wenn taste == "Return" oder taste == "Enter" oder taste == "Space":
            gib_zurück _uim_kalender_auswahl_anwenden(kontext, f, fokus_datum, wahr)
        setze ziel_datum auf fokus_datum
        setze richtung auf 0
        wenn taste == "Left":
            setze ziel_datum auf _uim_kalender_datum_verschiebe(fokus_datum, 0 - 1)
            setze richtung auf 0 - 1
        sonst wenn taste == "Right":
            setze ziel_datum auf _uim_kalender_datum_verschiebe(fokus_datum, 1)
            setze richtung auf 1
        sonst wenn taste == "Up":
            setze ziel_datum auf _uim_kalender_datum_verschiebe(fokus_datum, 0 - 7)
            setze richtung auf 0 - 1
        sonst wenn taste == "Down":
            setze ziel_datum auf _uim_kalender_datum_verschiebe(fokus_datum, 7)
            setze richtung auf 1
        sonst wenn taste == "Home" oder taste == "End":
            setze sonntag_null auf _uim_kalender_wochentag(fokus_datum[0], fokus_datum[1], fokus_datum[2])
            setze wochen_offset auf (sonntag_null - f["wochenstart"] + 7) % 7
            wenn taste == "Home":
                setze ziel_datum auf _uim_kalender_datum_verschiebe(fokus_datum, 0 - wochen_offset)
                setze richtung auf 0 - 1
            sonst:
                setze ziel_datum auf _uim_kalender_datum_verschiebe(fokus_datum, 6 - wochen_offset)
                setze richtung auf 1
        sonst wenn taste == "PageUp":
            setze ziel_datum auf _uim_kalender_datum_monat_verschiebe(fokus_datum, 0 - 1)
            setze richtung auf 0 - 1
        sonst wenn taste == "PageDown":
            setze ziel_datum auf _uim_kalender_datum_monat_verschiebe(fokus_datum, 1)
            setze richtung auf 1
        sonst:
            gib_zurück wahr
        wenn taste == "PageUp" oder taste == "PageDown":
            setze ziel_datum auf _uim_kalender_monatsziel_klemme(f, ziel_datum)
        wenn länge(ziel_datum) > 0:
            _uim_kalender_fokus_bewege(f, ziel_datum, richtung)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "linechart" oder f["typ"] == "barchart" oder f["typ"] == "piechart":
        setze n_chart auf länge(f["werte"])
        wenn n_chart == 0:
            gib_zurück wahr
        setze idx_chart auf f["auswahl"]
        wenn idx_chart < 0:
            setze idx_chart auf 0
        wenn taste == "Left" oder taste == "Up":
            setze idx_chart auf idx_chart - 1
        sonst wenn taste == "Right" oder taste == "Down":
            setze idx_chart auf idx_chart + 1
        sonst:
            gib_zurück wahr
        wenn idx_chart < 0:
            setze idx_chart auf 0
        wenn idx_chart > n_chart - 1:
            setze idx_chart auf n_chart - 1
        f["auswahl"] = idx_chart
        f["selected"] = wahr
        setze cb_chart auf f["on_auswahl"]
        wenn cb_chart != nichts:
            cb_chart(f, idx_chart)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "gauge":
        setze step_gauge auf (f["max"] - f["min"]) / 20
        wenn step_gauge <= 0:
            setze step_gauge auf 1
        setze wert_gauge auf f["wert"]
        wenn taste == "Left" oder taste == "Down":
            setze wert_gauge auf wert_gauge - step_gauge
        sonst wenn taste == "Right" oder taste == "Up":
            setze wert_gauge auf wert_gauge + step_gauge
        sonst:
            gib_zurück wahr
        wenn wert_gauge < f["min"]:
            setze wert_gauge auf f["min"]
        wenn wert_gauge > f["max"]:
            setze wert_gauge auf f["max"]
        f["wert"] = wert_gauge
        setze cb_gauge auf f["on_wechsel"]
        wenn cb_gauge != nichts:
            cb_gauge(f, wert_gauge)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "terminal":
        setze hist_n auf länge(f["history"])
        wenn taste == "Up":
            setze hist_idx auf f["history_idx"]
            wenn hist_idx < 0:
                setze hist_idx auf hist_n - 1
            sonst:
                setze hist_idx auf hist_idx - 1
            wenn hist_idx < 0:
                setze hist_idx auf 0
            wenn hist_idx >= hist_n:
                setze hist_idx auf hist_n - 1
            wenn hist_n > 0:
                setze f["history_idx"] auf hist_idx
                setze f["eingabe"] auf f["history"][hist_idx]
                setze f["cursor"] auf länge(bytes_zu_liste(f["eingabe"]))
        sonst wenn taste == "Down":
            setze hist_idx auf f["history_idx"] + 1
            wenn hist_idx >= hist_n:
                setze f["history_idx"] auf -1
                setze f["eingabe"] auf ""
                setze f["cursor"] auf 0
            sonst:
                setze f["history_idx"] auf hist_idx
                setze f["eingabe"] auf f["history"][hist_idx]
                setze f["cursor"] auf länge(bytes_zu_liste(f["eingabe"]))
        sonst wenn taste == "Left":
            setze f["cursor"] auf _uim_tf_grenze_zurueck(bytes_zu_liste(f["eingabe"]), f["cursor"])
        sonst wenn taste == "Right":
            setze f["cursor"] auf _uim_tf_grenze_vor(bytes_zu_liste(f["eingabe"]), f["cursor"])
        sonst wenn taste == "Home":
            setze f["cursor"] auf 0
        sonst wenn taste == "End":
            setze f["cursor"] auf länge(bytes_zu_liste(f["eingabe"]))
        sonst wenn taste == "BackSpace":
            setze f["text"] auf f["eingabe"]
            setze bytes_term auf bytes_zu_liste(f["text"])
            wenn f["cursor"] > 0:
                setze p_term auf _uim_tf_grenze_zurueck(bytes_term, f["cursor"])
                setze nb_term auf _uim_tf_teil(bytes_term, 0, p_term)
                setze rest_term auf _uim_tf_teil(bytes_term, f["cursor"], länge(bytes_term))
                für bb_term in rest_term:
                    nb_term.hinzufügen(bb_term)
                setze f["eingabe"] auf bytes_neu(nb_term)
                setze f["cursor"] auf p_term
        sonst wenn taste == "Return":
            setze cmd_term auf bytes_neu(bytes_zu_liste(f["eingabe"]))
            f["zeilen"].hinzufügen(f["prompt"] + cmd_term)
            wenn cmd_term != "":
                f["history"].hinzufügen(cmd_term)
            setze f["history_idx"] auf -1
            setze cb_term auf f["on_befehl"]
            wenn cb_term != nichts:
                cb_term(f)
            setze f["eingabe"] auf ""
            setze f["text"] auf ""
            setze f["cursor"] auf 0
            setze f["scroll_y"] auf _uim_scroll_max(kontext, f)
            _uim_anfordern(kontext)
            gib_zurück wahr
        sonst:
            setze eingabe_term auf taste
            wenn taste == "space":
                setze eingabe_term auf " "
            setze f["text"] auf f["eingabe"]
            setze f["cursor"] auf länge(bytes_zu_liste(f["eingabe"]))
            wenn _uim_tf_einfuegen(kontext, f, bytes_zu_liste(eingabe_term)):
                setze f["eingabe"] auf f["text"]
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "markdown":
        setze max_md auf _uim_scroll_max(kontext, f)
        setze schritt_md auf _uim_zeilenhoehe(kontext)
        setze scroll_md auf f["scroll_y"]
        wenn taste == "Up":
            setze scroll_md auf scroll_md - schritt_md
        sonst wenn taste == "Down":
            setze scroll_md auf scroll_md + schritt_md
        sonst wenn taste == "Home":
            setze scroll_md auf 0
        sonst wenn taste == "End":
            setze scroll_md auf max_md
        sonst:
            gib_zurück wahr
        wenn scroll_md < 0:
            setze scroll_md auf 0
        wenn scroll_md > max_md:
            setze scroll_md auf max_md
        setze f["scroll_y"] auf scroll_md
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "iconview":
        setze n auf länge(f["eintraege"])
        wenn n == 0:
            gib_zurück wahr
        setze cols auf _uim_iconview_spalten(kontext, f)
        setze idx auf f["auswahl"]
        wenn idx < 0:
            wenn taste == "Up" oder taste == "Left":
                setze idx auf n - 1
            sonst:
                setze idx auf 0
        sonst wenn taste == "Up":
            setze idx auf idx - cols
        sonst wenn taste == "Down":
            setze idx auf idx + cols
        sonst wenn taste == "Left":
            setze idx auf idx - 1
        sonst wenn taste == "Right":
            setze idx auf idx + 1
        sonst:
            gib_zurück wahr
        wenn idx < 0:
            setze idx auf 0
        wenn idx > n - 1:
            setze idx auf n - 1
        wenn idx != f["auswahl"]:
            f["auswahl"] = idx
            f["selected"] = wahr
            f["zustand"] = "selected"
            _uim_iconview_sichtbar_machen(kontext, f, idx)
            setze cb_icon auf f["on_auswahl"]
            wenn cb_icon != nichts:
                cb_icon(f, idx)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "liste":
        wenn taste == "Up" oder taste == "Down":
            setze n auf länge(f["zeilen"])
            wenn n == 0:
                gib_zurück wahr
            setze idx auf f["auswahl"]
            wenn taste == "Up":
                setze idx auf idx - 1
            sonst:
                setze idx auf idx + 1
            wenn idx < 0:
                setze idx auf 0
            wenn idx > n - 1:
                setze idx auf n - 1
            wenn idx != f["auswahl"]:
                f["auswahl"] = idx
                _uim_liste_sichtbar_machen(kontext, f, idx)
                setze cb auf f["on_auswahl"]
                wenn cb != nichts:
                    cb(f, idx)
            _uim_anfordern(kontext)
            gib_zurück wahr
    wenn f["typ"] == "baum":
        setze sichtbare auf _uim_baum_sichtbare(f)
        setze n auf länge(sichtbare)
        wenn n == 0:
            gib_zurück wahr
        setze idx auf f["auswahl"]
        wenn idx < 0:
            setze idx auf 0
        wenn taste == "Up":
            setze idx auf idx - 1
        sonst:
            setze idx auf idx + 1
        wenn idx < 0:
            setze idx auf 0
        wenn idx > n - 1:
            setze idx auf n - 1
        wenn idx != f["auswahl"]:
            f["auswahl"] = idx
            _uim_baum_sichtbar_machen(kontext, f, idx)
            setze cb auf f["on_auswahl"]
            wenn cb != nichts:
                cb(f, idx)
        _uim_anfordern(kontext)
        gib_zurück wahr
    wenn f["typ"] == "datengitter":
        setze n auf länge(f["zeilen"])
        wenn n == 0:
            gib_zurück wahr
        setze idx auf f["auswahl"]
        wenn idx < 0:
            setze idx auf 0
        wenn taste == "Up":
            setze idx auf idx - 1
        sonst:
            setze idx auf idx + 1
        wenn idx < 0:
            setze idx auf 0
        wenn idx > n - 1:
            setze idx auf n - 1
        wenn idx != f["auswahl"]:
            f["auswahl"] = idx
            _uim_baum_sichtbar_machen(kontext, f, idx)
            setze cb auf f["on_auswahl"]
            wenn cb != nichts:
                cb(f, idx)
        _uim_anfordern(kontext)
        gib_zurück wahr
    gib_zurück falsch

# Scrollrad: oberstes scrollbares Widget unter dem Zeiger scrollen.
funktion _uim_kern_rad(kontext, x, y, delta):
    setze w auf _uim_scrollziel_rek(kontext["wurzel"]["kinder"], x, y)
    wenn w == nichts:
        gib_zurück falsch
    wenn w["aktiv"] == falsch:
        gib_zurück falsch
    wenn w["typ"] != "liste" und w["typ"] != "scroll" und w["typ"] != "baum" und w["typ"] != "datengitter" und w["typ"] != "terminal" und w["typ"] != "markdown" und w["typ"] != "multiline":
        gib_zurück falsch
    setze zh auf _uim_zeilenhoehe(kontext)
    setze max_scroll auf _uim_scroll_max(kontext, w)
    setze s auf w["scroll_y"] + delta * zh * 2
    wenn s < 0:
        setze s auf 0
    wenn s > max_scroll:
        setze s auf max_scroll
    wenn s != w["scroll_y"]:
        w["scroll_y"] = s
        _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_z_knopf(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze flaeche auf _uim_zustand_farbe(kontext, w, "flaeche")
    _uim_farbe(kontext, z, flaeche)
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], t["radius"])
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck_rund(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, t["radius"] + 2, falsch)
    setze schrift auf t["schrift"]
    setze tb auf _uim_zf_text_breite(kontext, z, w["text"], schrift)
    setze tx auf ax + (w["b"] - tb) / 2
    setze ty auf ay + (w["h"] - schrift) / 2 - 1
    setze farbe auf _uim_zustand_farbe(kontext, w, "text")
    _uim_farbe(kontext, z, farbe)
    _uim_zf_text(kontext, z, tx, ty, w["text"], schrift)
    gib_zurück wahr

funktion _uim_text_ellipsis(kontext, z, inhalt, max_b, schrift):
    wenn _uim_zf_text_breite(kontext, z, inhalt, schrift) <= max_b:
        gib_zurück inhalt
    setze punkte auf "..."
    wenn _uim_zf_text_breite(kontext, z, punkte, schrift) > max_b:
        gib_zurück ""
    setze bytes auf bytes_zu_liste(inhalt)
    setze pos auf länge(bytes)
    solange pos > 0:
        setze kandidat auf bytes_neu(_uim_tf_teil(bytes, 0, pos)) + punkte
        wenn _uim_zf_text_breite(kontext, z, kandidat, schrift) <= max_b:
            gib_zurück kandidat
        setze pos auf _uim_tf_grenze_zurueck(bytes, pos)
    gib_zurück punkte

funktion _uim_z_label(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze pad auf w["padding"]
    setze max_b auf w["b"] - pad * 2
    setze max_h auf w["h"] - pad * 2
    wenn max_b < 0:
        setze max_b auf 0
    wenn max_h < 0:
        setze max_h auf 0
    setze ax auf ox + w["x"] + pad
    setze ay auf oy + w["y"] + pad
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
    wenn w["text_umbruch"]:
        setze teile auf w["text"].teilen(" ")
        setze zeile auf ""
        setze yy auf ay
        setze fertig auf falsch
        für wort in teile:
            wenn fertig == falsch:
                setze kandidat auf wort
                wenn zeile != "":
                    setze kandidat auf zeile + " " + wort
                wenn zeile != "" und _uim_zf_text_breite(kontext, z, kandidat, t["schrift"]) > max_b:
                    wenn yy + t["schrift"] <= ay + max_h:
                        _uim_zf_text(kontext, z, ax, yy, zeile, t["schrift"])
                        setze yy auf yy + t["schrift"] + 2
                        setze zeile auf wort
                    sonst:
                        setze fertig auf wahr
                sonst:
                    setze zeile auf kandidat
        wenn fertig == falsch und zeile != "" und yy + t["schrift"] <= ay + max_h:
            wenn w["text_ellipsis"]:
                setze zeile auf _uim_text_ellipsis(kontext, z, zeile, max_b, t["schrift"])
            _uim_zf_text(kontext, z, ax, yy, zeile, t["schrift"])
        gib_zurück wahr
    setze anzeige auf w["text"]
    wenn w["text_ellipsis"]:
        setze anzeige auf _uim_text_ellipsis(kontext, z, anzeige, max_b, t["schrift"])
    wenn w["ausrichtung"] == "mitte":
        setze tb auf _uim_zf_text_breite(kontext, z, anzeige, t["schrift"])
        setze ax auf ax + (max_b - tb) / 2
    sonst wenn w["ausrichtung"] == "rechts":
        setze tb auf _uim_zf_text_breite(kontext, z, anzeige, t["schrift"])
        setze ax auf ax + max_b - tb
    _uim_zf_text(kontext, z, ax, ay, anzeige, t["schrift"])
    gib_zurück wahr

funktion _uim_z_spinner(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze cx auf ax + w["b"] / 2
    setze cy auf ay + w["h"] / 2
    setze radius auf w["h"] / 2 - 3
    wenn radius < 4:
        setze radius auf 4
    setze dx auf [0, 1, 1, 1, 0, -1, -1, -1]
    setze dy auf [-1, -1, 0, 1, 1, 1, 0, -1]
    setze i auf 0
    solange i < 8:
        wenn i == w["wert"]:
            _uim_farbe(kontext, z, t["akzent"])
        sonst:
            _uim_farbe(kontext, z, t["text_gedimmt"])
        _uim_zf_linie(kontext, z, cx + dx[i] * (radius - 3), cy + dy[i] * (radius - 3), cx + dx[i] * radius, cy + dy[i] * radius, 3)
        setze i auf i + 1
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
        _uim_zf_kreis(kontext, z, cx, cy, radius + 3, falsch)
    gib_zurück wahr

# UI-13/STATUS: kompakte retained Zustandsansicht fuer leer/fehler/laden/skelett.
funktion _uim_z_statusansicht(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze modus auf w["status_modus"]
    setze flaeche auf t["flaeche"]
    wenn modus == "fehler":
        setze flaeche auf t["flaeche_fehler"]
    sonst wenn modus == "laden":
        setze flaeche auf t["flaeche_laden"]
    _uim_farbe(kontext, z, flaeche)
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], t["radius"])
    wenn modus == "skelett":
        setze i auf 0
        solange i < w["skelett_zeilen"]:
            setze balken_b auf w["b"] - 28 - i * 18
            wenn balken_b < w["b"] / 2:
                setze balken_b auf w["b"] / 2
            _uim_farbe(kontext, z, t["text_gedimmt"])
            _uim_zf_rechteck_rund(kontext, z, ax + 14, ay + 12 + i * 15, balken_b, 7, 3, wahr)
            setze i auf i + 1
        gib_zurück wahr
    setze text_x auf ax + 14
    wenn modus == "laden":
        setze cx auf ax + 20
        setze cy auf ay + w["h"] / 2
        setze dx auf [0, 1, 1, 1, 0, -1, -1, -1]
        setze dy auf [-1, -1, 0, 1, 1, 1, 0, -1]
        setze i auf 0
        solange i < 8:
            wenn i == w["phase"]:
                _uim_farbe(kontext, z, t["akzent"])
            sonst:
                _uim_farbe(kontext, z, t["text_gedimmt"])
            _uim_zf_linie(kontext, z, cx + dx[i] * 5, cy + dy[i] * 5, cx + dx[i] * 9, cy + dy[i] * 9, 2)
            setze i auf i + 1
        setze text_x auf ax + 40
    wenn modus == "fehler":
        _uim_farbe(kontext, z, t["text_fehler"])
    sonst wenn modus == "laden":
        _uim_farbe(kontext, z, t["text_laden"])
    sonst:
        _uim_farbe(kontext, z, t["text"])
    _uim_zf_text(kontext, z, text_x, ay + 10, w["status_titel"], t["schrift"])
    _uim_farbe(kontext, z, t["text_gedimmt"])
    _uim_zf_text(kontext, z, text_x, ay + 30, w["status_text"], t["schrift"] - 2)
    wenn modus == "fehler" und w["on_klick"] != nichts:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck_rund(kontext, z, ax + w["b"] - 76, ay + w["h"] - 28, 64, 20, 4, wahr)
        wenn t.enthält("auswahl_text"):
            _uim_farbe(kontext, z, t["auswahl_text"])
        sonst:
            _uim_farbe(kontext, z, t["hintergrund"])
        _uim_zf_text(kontext, z, ax + w["b"] - 68, ay + w["h"] - 25, "Erneut", t["schrift"] - 2)
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    gib_zurück wahr

# Fontunabhaengiger Zehnpunkt-Stern. Die normierten Punkte halten die Form
# auf jedem Backend und bei jeder Widgetgroesse identisch. Ausgewaehlte Sterne
# werden als Dreiecksfaecher vom Mittelpunkt zu allen Kantenpunkten gefuellt.
funktion _uim_z_stern(kontext, z, x, y, groesse, gefuellt):
    setze stern_x auf [50, 61, 98, 68, 79, 50, 21, 32, 2, 39]
    setze stern_y auf [0, 35, 35, 57, 92, 70, 92, 57, 35, 35]
    wenn gefuellt:
        setze schritte auf boden(groesse / 2)
        wenn schritte < 2:
            setze schritte auf 2
        setze j auf 0
        solange j < 10:
            setze folge auf (j + 1) % 10
            setze scan auf 0
            solange scan <= schritte:
                setze rand_x auf stern_x[j] + (stern_x[folge] - stern_x[j]) * scan / schritte
                setze rand_y auf stern_y[j] + (stern_y[folge] - stern_y[j]) * scan / schritte
                _uim_zf_linie(kontext, z, x + groesse / 2, y + groesse / 2, x + rand_x * groesse / 100, y + rand_y * groesse / 100, 2)
                setze scan auf scan + 1
            setze j auf j + 1
    setze j auf 0
    solange j < 10:
        setze folge auf (j + 1) % 10
        _uim_zf_linie(kontext, z, x + stern_x[j] * groesse / 100, y + stern_y[j] * groesse / 100, x + stern_x[folge] * groesse / 100, y + stern_y[folge] * groesse / 100, 1)
        setze j auf j + 1
    gib_zurück wahr

funktion _uim_z_bewertung(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze stern_b auf w["b"] / w["max"]
    setze stern_g auf w["h"] - 4
    wenn stern_g > stern_b - 4:
        setze stern_g auf stern_b - 4
    wenn stern_g < 1:
        setze stern_g auf 1
    setze i auf 0
    solange i < w["max"]:
        setze ausgewaehlt auf i < w["wert"]
        wenn ausgewaehlt:
            _uim_farbe(kontext, z, t["akzent"])
        sonst:
            _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
        setze stern_x auf ax + i * stern_b + (stern_b - stern_g) / 2
        setze stern_y auf ay + (w["h"] - stern_g) / 2
        _uim_z_stern(kontext, z, stern_x, stern_y, stern_g, ausgewaehlt)
        setze i auf i + 1
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
        _uim_zf_rechteck_rund(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, t["radius"] + 2, falsch)
    gib_zurück wahr

funktion _uim_z_schalter(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze track_h auf w["h"] - 4
    wenn track_h > 20:
        setze track_h auf 20
    wenn track_h < 12:
        setze track_h auf 12
    setze track_b auf track_h * 2
    wenn track_b > w["b"]:
        setze track_b auf w["b"]
    setze ty auf ay + (w["h"] - track_h) / 2
    setze radius auf track_h / 2
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ty, track_b, track_h, radius, wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ty, track_b, track_h, radius)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ty, track_b, track_h, radius, falsch)
    setze knob_r auf radius - 2
    wenn knob_r < 3:
        setze knob_r auf 3
    setze kx auf ax + radius
    wenn w["wert"]:
        setze kx auf ax + track_b - radius
        _uim_farbe(kontext, z, t["akzent"])
    sonst:
        _uim_farbe(kontext, z, t["text"])
    wenn w["aktiv"] == falsch:
        _uim_farbe(kontext, z, t["text_gedimmt"])
    _uim_zf_kreis(kontext, z, kx, ty + radius, knob_r, wahr)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
        _uim_zf_rechteck_rund(kontext, z, ax - 2, ty - 2, track_b + 4, track_h + 4, radius + 2, falsch)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
    _uim_zf_text(kontext, z, ax + track_b + t["abstand"], ay + (w["h"] - t["schrift"]) / 2 - 1, w["text"], t["schrift"])
    gib_zurück wahr

funktion _uim_z_toggle(kontext, z, w, ox, oy):
    gib_zurück _uim_z_knopf(kontext, z, w, ox, oy)

funktion _uim_z_radio(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze kh auf w["h"]
    wenn kh > 18:
        setze kh auf 18
    setze cx auf ax + kh / 2
    setze cy auf ay + w["h"] / 2
    setze radius auf kh / 2 - 2
    wenn radius < 2:
        setze radius auf 2
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_kreis(kontext, z, cx, cy, radius, falsch)
    wenn w["wert"]:
        _uim_farbe(kontext, z, t["akzent"])
        setze innen auf radius - 3
        wenn innen < 1:
            setze innen auf 1
        _uim_zf_kreis(kontext, z, cx, cy, innen, wahr)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
        _uim_zf_kreis(kontext, z, cx, cy, radius + 2, falsch)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
    _uim_zf_text(kontext, z, ax + kh + t["abstand"], ay + (w["h"] - t["schrift"]) / 2 - 1, w["text"], t["schrift"])
    gib_zurück wahr

funktion _uim_z_checkbox(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze kh auf w["h"]
    wenn kh > 18:
        setze kh auf 18
    setze ky auf ay + (w["h"] - kh) / 2
    setze flaeche auf _uim_zustand_farbe(kontext, w, "flaeche")
    _uim_farbe(kontext, z, flaeche)
    _uim_zf_rechteck_rund(kontext, z, ax, ky, kh, kh, 3, wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ky, kh, kh, 3)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ky, kh, kh, 3, falsch)
    wenn w["wert"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_linie(kontext, z, ax + kh * 0.22, ky + kh * 0.52, ax + kh * 0.42, ky + kh * 0.74, 2)
        _uim_zf_linie(kontext, z, ax + kh * 0.42, ky + kh * 0.74, ax + kh * 0.80, ky + kh * 0.28, 2)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck_rund(kontext, z, ax - 2, ky - 2, kh + 4, kh + 4, 5, falsch)
    setze farbe auf _uim_zustand_farbe(kontext, w, "text")
    _uim_farbe(kontext, z, farbe)
    setze ty auf ay + (w["h"] - t["schrift"]) / 2 - 1
    _uim_zf_text(kontext, z, ax + kh + t["abstand"], ty, w["text"], t["schrift"])
    gib_zurück wahr

funktion _uim_z_slider(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze spanne auf w["max"] - w["min"]
    setze anteil auf 0
    wenn spanne > 0:
        setze anteil auf (w["wert"] - w["min"]) / spanne
    setze mitte_y auf ay + w["h"] / 2
    # Track (voll) + gefüllter Teil in Akzent
    _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck_rund(kontext, z, ax, mitte_y - 3, w["b"], 6, 3, wahr)
    wenn anteil > 0:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck_rund(kontext, z, ax, mitte_y - 3, w["b"] * anteil, 6, 3, wahr)
    # Knob
    setze kx auf ax + w["b"] * anteil
    setze radius auf 8
    wenn w["druck"] oder w["hover"]:
        setze radius auf 9
    setze knopf_farbe auf t["text"]
    wenn w["aktiv"] == falsch:
        setze knopf_farbe auf t["text_gedimmt"]
    _uim_farbe(kontext, z, knopf_farbe)
    _uim_zf_kreis(kontext, z, kx, mitte_y, radius, wahr)
    wenn _uim_glass_an(t):
        _uim_farbe(kontext, z, [255, 255, 255, 70])
        _uim_zf_kreis(kontext, z, kx - 1, mitte_y - 2, radius - 4, wahr)
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_kreis(kontext, z, kx, mitte_y, radius, falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_kreis(kontext, z, kx, mitte_y, radius + 3, falsch)
    gib_zurück wahr

funktion _uim_z_fortschritt(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze anteil auf w["wert"]
    wenn anteil < 0:
        setze anteil auf 0
    wenn anteil > 1:
        setze anteil auf 1
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    wenn w["unbestimmt"]:
        setze breite auf w["b"] * 0.3
        setze start auf ax + w["phase"] * (w["b"] + breite) - breite
        setze ende auf start + breite
        wenn start < ax:
            setze start auf ax
        wenn ende > ax + w["b"]:
            setze ende auf ax + w["b"]
        wenn ende > start:
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck_rund(kontext, z, start, ay, ende - start, w["h"], t["radius"], wahr)
    sonst wenn anteil > 0:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"] * anteil, w["h"], t["radius"], wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], t["radius"])
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    gib_zurück wahr

funktion _uim_z_panel(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], t["radius"])
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    wenn w["text"] != "":
        _uim_farbe(kontext, z, t["text_gedimmt"])
        _uim_zf_text(kontext, z, ax + t["abstand"] + 2, ay + t["abstand"] / 2 + 1, w["text"], t["schrift"] - 1)
    gib_zurück wahr

# TreeView: sichtbare Zeilen werden aus verschachtelten Knoten virtuell erzeugt.
funktion _uim_z_baum(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze zh auf _uim_zeilenhoehe(kontext)
    setze sichtbare auf _uim_baum_sichtbare(w)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    setze clip_ok auf _uim_zf_clip_setze(kontext, z, ax, ay, w["b"], w["h"])
    wenn clip_ok == falsch:
        gib_zurück falsch
    setze start auf 0
    solange (start + 1) * zh <= w["scroll_y"]:
        setze start auf start + 1
    setze i auf start
    setze zy auf ay + start * zh - w["scroll_y"]
    solange i < länge(sichtbare) und zy < ay + w["h"]:
        setze eintrag auf sichtbare[i]
        setze knoten auf eintrag["knoten"]
        setze ebene auf eintrag["ebene"]
        wenn i == w["auswahl"]:
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck(kontext, z, ax, zy, w["b"], zh, wahr)
            wenn t.enthält("auswahl_text"):
                _uim_farbe(kontext, z, t["auswahl_text"])
            sonst:
                _uim_farbe(kontext, z, t["hintergrund"])
        sonst:
            _uim_farbe(kontext, z, t["text"])
        setze tx auf ax + t["abstand"] + ebene * 12
        wenn länge(knoten["kinder"]) > 0:
            _uim_zf_linie(kontext, z, tx + 2, zy + zh / 2 - 2, tx + 6, zy + zh / 2 - 2, 1)
            _uim_zf_linie(kontext, z, tx + 4, zy + zh / 2 - 4, tx + 4, zy + zh / 2, 1)
        _uim_zf_text(kontext, z, tx + 12, zy + (zh - t["schrift"]) / 2, knoten["text"], t["schrift"])
        setze i auf i + 1
        setze zy auf zy + zh
    setze pop_ok auf _uim_zf_clip_loesche(kontext, z)
    wenn pop_ok == falsch:
        gib_zurück falsch
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

# DataGrid v1: fixe Kopfzeile, gleich breite Spalten, virtuelle Datenzeilen.
funktion _uim_z_datengitter(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze zh auf _uim_zeilenhoehe(kontext)
    setze n_spalten auf länge(w["spalten"])
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    wenn n_spalten == 0:
        gib_zurück wahr
    setze spalten_b auf w["b"] / n_spalten
    _uim_farbe(kontext, z, t["akzent"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], zh, wahr)
    setze j auf 0
    solange j < n_spalten:
        _uim_farbe(kontext, z, t["auswahl_text"])
        _uim_zf_text(kontext, z, ax + j * spalten_b + t["abstand"] + 2, ay + (zh - t["schrift"]) / 2 + 1, text(w["spalten"][j]), t["schrift"])
        setze j auf j + 1
    setze clip_ok auf _uim_zf_clip_setze(kontext, z, ax, ay + zh, w["b"], w["h"] - zh)
    wenn clip_ok == falsch:
        gib_zurück falsch
    setze start auf 0
    solange (start + 1) * zh <= w["scroll_y"]:
        setze start auf start + 1
    setze i auf start
    setze zy auf ay + zh + start * zh - w["scroll_y"]
    solange i < länge(w["zeilen"]) und zy < ay + w["h"]:
        setze zeile auf w["zeilen"][i]
        wenn i == w["auswahl"]:
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck(kontext, z, ax, zy, w["b"], zh, wahr)
        setze j auf 0
        solange j < n_spalten:
            wenn i == w["auswahl"] und t.enthält("auswahl_text"):
                _uim_farbe(kontext, z, t["auswahl_text"])
            sonst:
                _uim_farbe(kontext, z, t["text"])
            wenn j < länge(zeile):
                _uim_zf_text(kontext, z, ax + j * spalten_b + t["abstand"], zy + (zh - t["schrift"]) / 2, text(zeile[j]), t["schrift"])
            setze j auf j + 1
        setze i auf i + 1
        setze zy auf zy + zh
    setze pop_ok auf _uim_zf_clip_loesche(kontext, z)
    wenn pop_ok == falsch:
        gib_zurück falsch
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

funktion _uim_z_liste(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze zh auf _uim_zeilenhoehe(kontext)
    setze zeilen auf w["zeilen"]
    setze n auf länge(zeilen)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    setze clip_ok auf _uim_zf_clip_setze(kontext, z, ax, ay, w["b"], w["h"])
    wenn clip_ok == falsch:
        gib_zurück falsch
    # Virtuelles Rendering: erste sichtbare Zeile ohne floor-Builtin.
    setze start auf 0
    solange (start + 1) * zh <= w["scroll_y"]:
        setze start auf start + 1
    setze i auf start
    setze zy auf ay + start * zh - w["scroll_y"]
    # Keine nur teilweise sichtbare letzte Zeile zeichnen: Nicht jedes
    # Surface-Backend clippt Textglyphen zuverlässig an der Widget-Kante.
    solange i < n und zy + zh <= ay + w["h"]:
        wenn i == w["auswahl"]:
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck(kontext, z, ax, zy, w["b"], zh, wahr)
            wenn t.enthält("auswahl_text"):
                _uim_farbe(kontext, z, t["auswahl_text"])
            sonst:
                _uim_farbe(kontext, z, t["hintergrund"])
        sonst:
            _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, ax + t["abstand"], zy + (zh - t["schrift"]) / 2, zeilen[i], t["schrift"])
        setze i auf i + 1
        setze zy auf zy + zh
    setze pop_ok auf _uim_zf_clip_loesche(kontext, z)
    wenn pop_ok == falsch:
        gib_zurück falsch
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

# IconView/TileView: Raster aus deklarativen Einträgen; Icons sind bewusst
# toolkitfreie Platzhalter (Glyph-Text oder farbige Kachel).
funktion _uim_z_iconview(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze abstand auf t["abstand"]
    setze tile_b auf w["tile_b"]
    setze tile_h auf w["tile_h"]
    setze cols auf _uim_iconview_spalten(kontext, w)
    setze zeilen auf _uim_iconview_zeilen(kontext, w)
    setze n auf länge(w["eintraege"])
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    setze clip_ok auf _uim_zf_clip_setze(kontext, z, ax, ay, w["b"], w["h"])
    wenn clip_ok == falsch:
        gib_zurück falsch
    setze start auf 0
    solange (start + 1) * tile_h <= w["scroll_y"]:
        setze start auf start + 1
    setze row auf start
    setze idx auf start * cols
    setze zy auf ay + row * tile_h - w["scroll_y"]
    # Nur vollständig passende Tile-Zeilen rendern; partielle Tiles
    # würden sonst inklusive Beschriftung in das nächste Widget laufen.
    solange row < zeilen und idx < n und zy + tile_h <= ay + w["h"]:
        setze col auf 0
        solange col < cols und idx < n:
            setze tx auf ax + col * tile_b + abstand / 2
            setze ty auf zy + abstand / 2
            setze tile_innen_b auf tile_b - abstand
            wenn tile_innen_b > 34:
                setze tile_innen_b auf 34
            wenn tile_innen_b < 12:
                setze tile_innen_b auf 12
            wenn idx == w["auswahl"]:
                _uim_farbe(kontext, z, t["akzent"])
            sonst:
                _uim_farbe(kontext, z, t["flaeche_hover"])
            _uim_zf_rechteck_rund(kontext, z, tx, ty, tile_innen_b, tile_innen_b, 5, wahr)
            setze icon auf _uim_iconview_icon(w["eintraege"][idx])
            wenn icon != "":
                _uim_farbe(kontext, z, t["text"])
                setze ib auf _uim_zf_text_breite(kontext, z, icon, t["schrift"])
                _uim_zf_text(kontext, z, tx + (tile_innen_b - ib) / 2, ty + (tile_innen_b - t["schrift"]) / 2, icon, t["schrift"])
            sonst:
                _uim_farbe(kontext, z, t["akzent"])
                _uim_zf_rechteck_rund(kontext, z, tx + 8, ty + 8, tile_innen_b - 16, tile_innen_b - 16, 4, falsch)
            wenn idx == w["auswahl"]:
                _uim_farbe(kontext, z, t["auswahl_text"])
            sonst:
                _uim_farbe(kontext, z, t["text"])
            setze tile_text_b auf tile_b - abstand
            wenn tile_text_b < 1:
                setze tile_text_b auf 1
            setze tile_text auf _uim_text_ellipsis(kontext, z, _uim_iconview_text(w["eintraege"][idx]), tile_text_b, t["schrift"] - 1)
            _uim_zf_text(kontext, z, tx, ty + tile_innen_b + 2, tile_text, t["schrift"] - 1)
            setze idx auf idx + 1
            setze col auf col + 1
        setze row auf row + 1
        setze zy auf zy + tile_h
    setze pop_ok auf _uim_zf_clip_loesche(kontext, z)
    wenn pop_ok == falsch:
        gib_zurück falsch
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

# Anzeige-Widgets: toolkitfreie Platzhalter/Glyphen, zentral themisiert.
funktion _uim_z_image(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], t["radius"])
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    _uim_farbe(kontext, z, t["akzent"])
    _uim_zf_linie(kontext, z, ax + 6, ay + 6, ax + w["b"] - 6, ay + w["h"] - 6, 2)
    _uim_zf_linie(kontext, z, ax + w["b"] - 6, ay + 6, ax + 6, ay + w["h"] - 6, 2)
    wenn w["alt"] != "":
        setze label_schrift auf t["schrift"] - 1
        setze label_h auf label_schrift + 8
        wenn label_h > w["h"] - 4:
            setze label_h auf w["h"] - 4
        setze label_y auf ay + w["h"] - label_h - 2
        _uim_farbe(kontext, z, t["flaeche_hover"])
        _uim_zf_rechteck_rund(kontext, z, ax + 3, label_y, w["b"] - 6, label_h, 4, wahr)
        setze label_text auf _uim_text_ellipsis(kontext, z, w["alt"], w["b"] - t["abstand"] * 2, label_schrift)
        _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, ax + t["abstand"], label_y + 3, label_text, label_schrift)
    gib_zurück wahr

funktion _uim_z_icon(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze radius auf w["b"] / 2
    wenn radius > w["h"] / 2:
        setze radius auf w["h"] / 2
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_kreis(kontext, z, ax + w["b"] / 2, ay + w["h"] / 2, radius, wahr)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
    setze ib auf _uim_zf_text_breite(kontext, z, w["symbol"], t["schrift"])
    _uim_zf_text(kontext, z, ax + (w["b"] - ib) / 2, ay + (w["h"] - t["schrift"]) / 2, w["symbol"], t["schrift"])
    gib_zurück wahr

funktion _uim_z_badge(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], w["h"] / 2, wahr)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
    setze tb auf _uim_zf_text_breite(kontext, z, w["text"], t["schrift"] - 1)
    _uim_zf_text(kontext, z, ax + (w["b"] - tb) / 2, ay + (w["h"] - t["schrift"]) / 2, w["text"], t["schrift"] - 1)
    gib_zurück wahr

funktion _uim_z_avatar(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze radius auf w["b"] / 2
    wenn radius > w["h"] / 2:
        setze radius auf w["h"] / 2
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_kreis(kontext, z, ax + w["b"] / 2, ay + w["h"] / 2, radius, wahr)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
    setze tb auf _uim_zf_text_breite(kontext, z, w["kuerzel"], t["schrift"])
    _uim_zf_text(kontext, z, ax + (w["b"] - tb) / 2, ay + (w["h"] - t["schrift"]) / 2, w["kuerzel"], t["schrift"])
    gib_zurück wahr

# Auswahl-Widgets: Farbfeld und kalenderartiges Datumsgitter.
funktion _uim_colorpicker_spalten(w):
    setze n auf 1
    setze lauf auf 24
    solange lauf + 24 <= w["b"]:
        setze n auf n + 1
        setze lauf auf lauf + 24
    gib_zurück n

funktion _uim_colorpicker_klick(kontext, w, lx, ly):
    setze cols auf _uim_colorpicker_spalten(w)
    setze col auf 0
    solange (col + 1) * 24 <= lx - w["x"]:
        setze col auf col + 1
    setze row auf 0
    solange (row + 1) * 24 <= ly - w["y"]:
        setze row auf row + 1
    setze idx auf row * cols + col
    wenn idx < 0 oder idx >= länge(w["farben"]):
        gib_zurück falsch
    w["auswahl"] = idx
    w["selected"] = wahr
    w["zustand"] = "selected"
    setze cb auf w["on_auswahl"]
    wenn cb != nichts:
        cb(w, idx)
    gib_zurück wahr

funktion _uim_z_colorpicker(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze cols auf _uim_colorpicker_spalten(w)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    setze i auf 0
    setze x auf ax
    setze y auf ay
    solange i < länge(w["farben"]):
        _uim_farbe(kontext, z, w["farben"][i])
        _uim_zf_rechteck_rund(kontext, z, x + 2, y + 2, 20, 20, 4, wahr)
        wenn i == w["auswahl"]:
            _uim_farbe(kontext, z, t["text"])
            _uim_zf_rechteck_rund(kontext, z, x + 1, y + 1, 22, 22, 4, falsch)
        setze i auf i + 1
        wenn i % cols == 0:
            setze x auf ax
            setze y auf y + 24
        sonst:
            setze x auf x + 24
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

# Kalenderarithmetik bleibt bewusst widget-lokal: deterministisch aus den
# uebergebenen Werten, ohne Systemzeit und ohne konkurrierende Datums-API.
funktion _uim_kalender_schaltjahr(jahr):
    wenn jahr % 400 == 0:
        gib_zurück wahr
    wenn jahr % 100 == 0:
        gib_zurück falsch
    gib_zurück jahr % 4 == 0

funktion _uim_kalender_monatstage(monat, jahr):
    wenn monat < 1 oder monat > 12:
        gib_zurück 0
    wenn monat == 2:
        wenn _uim_kalender_schaltjahr(jahr):
            gib_zurück 29
        gib_zurück 28
    wenn monat == 4 oder monat == 6 oder monat == 9 oder monat == 11:
        gib_zurück 30
    gib_zurück 31


funktion _uim_kalender_datum_gueltig(datum):
    wenn typ_von(datum) != "Liste" oder länge(datum) < 3:
        gib_zurück falsch
    setze tag_nummer auf datum[0]
    setze monat_nummer auf datum[1]
    setze jahr_nummer auf datum[2]
    wenn jahr_nummer < 1 oder monat_nummer < 1 oder monat_nummer > 12:
        gib_zurück falsch
    gib_zurück tag_nummer >= 1 und tag_nummer <= _uim_kalender_monatstage(monat_nummer, jahr_nummer)

funktion _uim_kalender_datum_kopie(datum):
    wenn nicht _uim_kalender_datum_gueltig(datum):
        gib_zurück []
    gib_zurück [datum[0], datum[1], datum[2]]

funktion _uim_kalender_datum_schluessel(datum):
    wenn nicht _uim_kalender_datum_gueltig(datum):
        gib_zurück 0
    gib_zurück datum[2] * 10000 + datum[1] * 100 + datum[0]

funktion _uim_kalender_datum_gleich(a, b):
    wenn nicht _uim_kalender_datum_gueltig(a) oder nicht _uim_kalender_datum_gueltig(b):
        gib_zurück falsch
    gib_zurück a[0] == b[0] und a[1] == b[1] und a[2] == b[2]


funktion _uim_kalender_datum_verschiebe(datum, schritte):
    setze ziel auf _uim_kalender_datum_kopie(datum)
    wenn länge(ziel) == 0:
        gib_zurück []
    setze restschritte auf schritte
    solange restschritte > 0:
        ziel[0] = ziel[0] + 1
        wenn ziel[0] > _uim_kalender_monatstage(ziel[1], ziel[2]):
            ziel[0] = 1
            ziel[1] = ziel[1] + 1
            wenn ziel[1] > 12:
                ziel[1] = 1
                ziel[2] = ziel[2] + 1
        setze restschritte auf restschritte - 1
    solange restschritte < 0:
        ziel[0] = ziel[0] - 1
        wenn ziel[0] < 1:
            ziel[1] = ziel[1] - 1
            wenn ziel[1] < 1:
                ziel[1] = 12
                ziel[2] = ziel[2] - 1
            ziel[0] = _uim_kalender_monatstage(ziel[1], ziel[2])
        setze restschritte auf restschritte + 1
    gib_zurück ziel

funktion _uim_kalender_datum_monat_verschiebe(datum, monate):
    setze ziel auf _uim_kalender_datum_kopie(datum)
    wenn länge(ziel) == 0:
        gib_zurück []
    setze ziel_monat auf ziel[1] + monate
    solange ziel_monat < 1:
        setze ziel_monat auf ziel_monat + 12
        ziel[2] = ziel[2] - 1
    solange ziel_monat > 12:
        setze ziel_monat auf ziel_monat - 12
        ziel[2] = ziel[2] + 1
    ziel[1] = ziel_monat
    setze maximale_tage auf _uim_kalender_monatstage(ziel[1], ziel[2])
    wenn ziel[0] > maximale_tage:
        ziel[0] = maximale_tage
    gib_zurück ziel

funktion _uim_kalender_monatsschluessel(datum):
    wenn nicht _uim_kalender_datum_gueltig(datum):
        gib_zurück 0
    gib_zurück datum[2] * 12 + datum[1]

funktion _uim_kalender_monatsziel_klemme(w, ziel):
    setze ergebnis auf _uim_kalender_datum_kopie(ziel)
    wenn länge(ergebnis) == 0:
        gib_zurück []
    setze monatsschluessel auf _uim_kalender_monatsschluessel(ergebnis)
    wenn länge(w["min_datum"]) > 0:
        setze min_monatsschluessel auf _uim_kalender_monatsschluessel(w["min_datum"])
        wenn monatsschluessel < min_monatsschluessel:
            gib_zurück []
        wenn monatsschluessel == min_monatsschluessel und ergebnis[0] < w["min_datum"][0]:
            ergebnis[0] = w["min_datum"][0]
    wenn länge(w["max_datum"]) > 0:
        setze max_monatsschluessel auf _uim_kalender_monatsschluessel(w["max_datum"])
        wenn monatsschluessel > max_monatsschluessel:
            gib_zurück []
        wenn monatsschluessel == max_monatsschluessel und ergebnis[0] > w["max_datum"][0]:
            ergebnis[0] = w["max_datum"][0]
    gib_zurück ergebnis

funktion _uim_kalender_fokus_bewege(w, ziel, richtung):
    setze kandidat auf _uim_kalender_datum_kopie(ziel)
    wenn länge(kandidat) == 0:
        gib_zurück falsch
    solange nicht _uim_kalender_datum_erlaubt(w, kandidat):
        setze kandidat_schluessel auf _uim_kalender_datum_schluessel(kandidat)
        wenn richtung < 0 und länge(w["min_datum"]) > 0 und kandidat_schluessel <= _uim_kalender_datum_schluessel(w["min_datum"]):
            gib_zurück falsch
        wenn richtung > 0 und länge(w["max_datum"]) > 0 und kandidat_schluessel >= _uim_kalender_datum_schluessel(w["max_datum"]):
            gib_zurück falsch
        wenn richtung == 0:
            gib_zurück falsch
        setze kandidat auf _uim_kalender_datum_verschiebe(kandidat, richtung)
        wenn länge(kandidat) == 0:
            gib_zurück falsch
    w["fokus_tag"] = kandidat[0]
    w["fokus_monat"] = kandidat[1]
    w["fokus_jahr"] = kandidat[2]
    w["monat"] = kandidat[1]
    w["jahr"] = kandidat[2]
    _uim_kalender_sync(w)
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion _uim_kalender_iso_wochen_im_jahr(jahr):
    setze januar_eins auf _uim_kalender_wochentag(1, 1, jahr)
    setze iso_tag auf ((januar_eins + 6) % 7) + 1
    wenn iso_tag == 4 oder (iso_tag == 3 und _uim_kalender_schaltjahr(jahr)):
        gib_zurück 53
    gib_zurück 52

funktion _uim_kalender_iso_woche(datum):
    wenn nicht _uim_kalender_datum_gueltig(datum):
        gib_zurück 0
    setze jahrestag auf datum[0]
    setze monat_index auf 1
    solange monat_index < datum[1]:
        setze jahrestag auf jahrestag + _uim_kalender_monatstage(monat_index, datum[2])
        setze monat_index auf monat_index + 1
    setze sonntag_null auf _uim_kalender_wochentag(datum[0], datum[1], datum[2])
    setze iso_tag auf ((sonntag_null + 6) % 7) + 1
    setze woche_nummer auf boden((jahrestag - iso_tag + 10) / 7)
    wenn woche_nummer < 1:
        gib_zurück _uim_kalender_iso_wochen_im_jahr(datum[2] - 1)
    wenn woche_nummer > _uim_kalender_iso_wochen_im_jahr(datum[2]):
        gib_zurück 1
    gib_zurück woche_nummer

# Sakamoto: 0=Sonntag .. 6=Samstag.
funktion _uim_kalender_wochentag(tag, monat, jahr):
    setze monatswerte auf [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    setze rechenjahr auf jahr
    wenn monat < 3:
        setze rechenjahr auf rechenjahr - 1
    gib_zurück (rechenjahr + boden(rechenjahr / 4) - boden(rechenjahr / 100) + boden(rechenjahr / 400) + monatswerte[monat - 1] + tag) % 7

funktion _uim_kalender_offset(w):
    setze wochenstart auf w["wochenstart"] % 7
    wenn wochenstart < 0:
        setze wochenstart auf wochenstart + 7
    gib_zurück (_uim_kalender_wochentag(1, w["monat"], w["jahr"]) - wochenstart + 7) % 7

funktion _uim_kalender_sync(w):
    w["tage"] = _uim_kalender_monatstage(w["monat"], w["jahr"])
    gib_zurück w

funktion _uim_kalender_monatsname(monat):
    setze namen auf ["Januar", "Februar", "Maerz", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"]
    wenn monat < 1 oder monat > 12:
        gib_zurück ""
    gib_zurück namen[monat - 1]

funktion _uim_kalender_dekade_start(jahr):
    gib_zurück boden(jahr / 10) * 10

funktion uim_kalender_ansicht_setze(w, ansicht):
    wenn ansicht != "monat" und ansicht != "jahr" und ansicht != "jahrzehnt":
        gib_zurück falsch
    w["ansicht"] = ansicht
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_calendar_view_set(w, ansicht):
    gib_zurück uim_kalender_ansicht_setze(w, ansicht)


funktion _uim_kalender_datumsliste_kopie(werte):
    wenn typ_von(werte) != "Liste":
        gib_zurück nichts
    setze ergebnis auf []
    setze index auf 0
    solange index < länge(werte):
        setze datum_kopie auf _uim_kalender_datum_kopie(werte[index])
        wenn länge(datum_kopie) == 0:
            gib_zurück nichts
        ergebnis.hinzufügen(datum_kopie)
        setze index auf index + 1
    gib_zurück ergebnis

funktion _uim_kalender_datumsliste_sortiert(werte):
    setze ergebnis auf _uim_kalender_datumsliste_kopie(werte)
    wenn ergebnis == nichts:
        gib_zurück []
    setze index auf 1
    solange index < länge(ergebnis):
        setze datum_kopie auf ergebnis[index]
        setze position auf index
        solange position > 0 und _uim_kalender_datum_schluessel(ergebnis[position - 1]) > _uim_kalender_datum_schluessel(datum_kopie):
            ergebnis[position] = ergebnis[position - 1]
            setze position auf position - 1
        ergebnis[position] = datum_kopie
        setze index auf index + 1
    gib_zurück ergebnis

funktion _uim_kalender_auswahlzustand_sync(w):
    setze hat_auswahl auf falsch
    wenn w["auswahl_modus"] == "einzel":
        setze hat_auswahl auf _uim_kalender_datum_gueltig(w["auswahl_datum"])
    sonst wenn w["auswahl_modus"] == "bereich":
        setze hat_auswahl auf länge(w["bereich_start"]) > 0
    sonst wenn w["auswahl_modus"] == "mehrfach":
        setze hat_auswahl auf länge(w["mehrfach_auswahl"]) > 0
    w["selected"] = hat_auswahl
    wenn hat_auswahl:
        w["zustand"] = "selected"
    sonst:
        w["zustand"] = "normal"
    gib_zurück hat_auswahl

funktion uim_kalender_auswahlmodus_setze(w, modus):
    wenn modus != "einzel" und modus != "bereich" und modus != "mehrfach":
        gib_zurück falsch
    w["auswahl_modus"] = modus
    wenn modus == "einzel":
        wenn nicht _uim_kalender_datum_gueltig(w["auswahl_datum"]):
            w["auswahl_datum"] = [w["auswahl"], w["monat"], w["jahr"]]
        w["auswahl"] = w["auswahl_datum"][0]
    sonst wenn modus == "bereich":
        w["bereich_start"] = []
        w["bereich_ende"] = []
    sonst:
        w["mehrfach_auswahl"] = []
    _uim_kalender_auswahlzustand_sync(w)
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_calendar_selection_mode_set(w, modus):
    gib_zurück uim_kalender_auswahlmodus_setze(w, modus)

funktion uim_kalender_grenzen_setze(w, minimum_datum, maximum_datum):
    setze minimum_kopie auf []
    setze maximum_kopie auf []
    wenn minimum_datum != nichts:
        wenn typ_von(minimum_datum) != "Liste":
            gib_zurück falsch
        wenn länge(minimum_datum) > 0:
            setze minimum_kopie auf _uim_kalender_datum_kopie(minimum_datum)
            wenn länge(minimum_kopie) == 0:
                gib_zurück falsch
    wenn maximum_datum != nichts:
        wenn typ_von(maximum_datum) != "Liste":
            gib_zurück falsch
        wenn länge(maximum_datum) > 0:
            setze maximum_kopie auf _uim_kalender_datum_kopie(maximum_datum)
            wenn länge(maximum_kopie) == 0:
                gib_zurück falsch
    wenn länge(minimum_kopie) > 0 und länge(maximum_kopie) > 0:
        wenn _uim_kalender_datum_schluessel(minimum_kopie) > _uim_kalender_datum_schluessel(maximum_kopie):
            gib_zurück falsch
    w["min_datum"] = minimum_kopie
    w["max_datum"] = maximum_kopie
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_calendar_bounds_set(w, minimum_datum, maximum_datum):
    gib_zurück uim_kalender_grenzen_setze(w, minimum_datum, maximum_datum)

funktion uim_kalender_gesperrte_tage_setze(w, tage_liste):
    setze kopie auf _uim_kalender_datumsliste_kopie(tage_liste)
    wenn kopie == nichts:
        gib_zurück falsch
    w["gesperrte_tage"] = kopie
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_calendar_disabled_dates_set(w, tage_liste):
    gib_zurück uim_kalender_gesperrte_tage_setze(w, tage_liste)

funktion uim_kalender_wochennummern_setze(w, aktiviert):
    w["wochennummern"] = aktiviert == wahr
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_calendar_week_numbers_set(w, aktiviert):
    gib_zurück uim_kalender_wochennummern_setze(w, aktiviert)

funktion uim_kalender_termine_setze(w, termine_liste):
    setze kopie auf _uim_kalender_datumsliste_kopie(termine_liste)
    wenn kopie == nichts:
        gib_zurück falsch
    w["termine"] = kopie
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_calendar_appointments_set(w, termine_liste):
    gib_zurück uim_kalender_termine_setze(w, termine_liste)

funktion uim_kalender_navigiere(w, schritte):
    wenn w["ansicht"] == "monat":
        setze fokus_datum auf [w["fokus_tag"], w["fokus_monat"], w["fokus_jahr"]]
        wenn nicht _uim_kalender_datum_gueltig(fokus_datum):
            setze fokus_datum auf [w["auswahl"], w["monat"], w["jahr"]]
        setze ziel_datum auf _uim_kalender_datum_monat_verschiebe(fokus_datum, schritte)
        setze ziel_datum auf _uim_kalender_monatsziel_klemme(w, ziel_datum)
        setze richtung auf 0
        wenn schritte < 0:
            setze richtung auf 0 - 1
        sonst wenn schritte > 0:
            setze richtung auf 1
        wenn länge(ziel_datum) > 0:
            _uim_kalender_fokus_bewege(w, ziel_datum, richtung)
    sonst wenn w["ansicht"] == "jahr":
        w["jahr"] = w["jahr"] + schritte
        _uim_kalender_sync(w)
    sonst:
        w["jahr"] = w["jahr"] + schritte * 10
        _uim_kalender_sync(w)
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_calendar_navigate(w, schritte):
    gib_zurück uim_kalender_navigiere(w, schritte)

funktion uim_kalender_heute_setze(w, tag, monat, jahr):
    w["heute_tag"] = tag
    w["heute_monat"] = monat
    w["heute_jahr"] = jahr
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_calendar_today_set(w, tag, monat, jahr):
    gib_zurück uim_kalender_heute_setze(w, tag, monat, jahr)

funktion uim_kalender_zu_heute(w):
    wenn w["heute_tag"] < 1 oder w["heute_monat"] < 1 oder w["heute_jahr"] < 1:
        gib_zurück falsch
    setze heute_datum auf [w["heute_tag"], w["heute_monat"], w["heute_jahr"]]
    wenn nicht _uim_kalender_datum_erlaubt(w, heute_datum):
        gib_zurück falsch
    w["tag"] = w["heute_tag"]
    w["monat"] = w["heute_monat"]
    w["jahr"] = w["heute_jahr"]
    w["ansicht"] = "monat"
    _uim_kalender_sync(w)
    gib_zurück _uim_kalender_auswahl_anwenden(nichts, w, heute_datum, falsch)

funktion uim_calendar_go_today(w):
    gib_zurück uim_kalender_zu_heute(w)

funktion _uim_kalender_kopf_klick(w, lokal_x):
    wenn lokal_x < 28:
        uim_kalender_navigiere(w, 0 - 1)
        gib_zurück wahr
    wenn lokal_x >= w["b"] - 28:
        uim_kalender_navigiere(w, 1)
        gib_zurück wahr
    wenn w["b"] >= 220 und lokal_x >= w["b"] - 96:
        uim_kalender_zu_heute(w)
        gib_zurück wahr
    wenn w["ansicht"] == "monat":
        w["ansicht"] = "jahr"
    sonst wenn w["ansicht"] == "jahr":
        w["ansicht"] = "jahrzehnt"
    sonst:
        w["ansicht"] = "monat"
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion _uim_kalender_datum_index(datum, liste):
    wenn typ_von(liste) != "Liste":
        gib_zurück 0 - 1
    setze index auf 0
    solange index < länge(liste):
        wenn _uim_kalender_datum_gleich(datum, liste[index]):
            gib_zurück index
        setze index auf index + 1
    gib_zurück 0 - 1

funktion _uim_kalender_datum_erlaubt(w, datum):
    wenn nicht _uim_kalender_datum_gueltig(datum):
        gib_zurück falsch
    setze schluessel auf _uim_kalender_datum_schluessel(datum)
    wenn länge(w["min_datum"]) > 0 und schluessel < _uim_kalender_datum_schluessel(w["min_datum"]):
        gib_zurück falsch
    wenn länge(w["max_datum"]) > 0 und schluessel > _uim_kalender_datum_schluessel(w["max_datum"]):
        gib_zurück falsch
    gib_zurück _uim_kalender_datum_index(datum, w["gesperrte_tage"]) < 0

funktion _uim_kalender_fokus_sichtmonat_setze(w):
    setze fokus_datum auf [w["fokus_tag"], w["fokus_monat"], w["fokus_jahr"]]
    wenn w["fokus_monat"] == w["monat"] und w["fokus_jahr"] == w["jahr"] und _uim_kalender_datum_erlaubt(w, fokus_datum):
        gib_zurück wahr
    setze tag_nummer auf 1
    solange tag_nummer <= w["tage"]:
        setze kandidat auf [tag_nummer, w["monat"], w["jahr"]]
        wenn _uim_kalender_datum_erlaubt(w, kandidat):
            w["fokus_tag"] = tag_nummer
            w["fokus_monat"] = w["monat"]
            w["fokus_jahr"] = w["jahr"]
            gib_zurück wahr
        setze tag_nummer auf tag_nummer + 1
    gib_zurück falsch

funktion _uim_kalender_auswahlwert(w):
    wenn w["auswahl_modus"] == "einzel":
        wenn _uim_kalender_datum_gueltig(w["auswahl_datum"]):
            gib_zurück w["auswahl_datum"][0]
        gib_zurück []
    wenn w["auswahl_modus"] == "bereich":
        setze bereich auf []
        wenn länge(w["bereich_start"]) > 0:
            bereich.hinzufügen(_uim_kalender_datum_kopie(w["bereich_start"]))
        wenn länge(w["bereich_ende"]) > 0:
            bereich.hinzufügen(_uim_kalender_datum_kopie(w["bereich_ende"]))
        gib_zurück bereich
    gib_zurück _uim_kalender_datumsliste_sortiert(w["mehrfach_auswahl"])

funktion _uim_kalender_datum_ausgewaehlt(w, datum):
    wenn w["auswahl_modus"] == "einzel":
        gib_zurück _uim_kalender_datum_gleich(datum, w["auswahl_datum"])
    wenn w["auswahl_modus"] == "bereich":
        wenn länge(w["bereich_start"]) == 0:
            gib_zurück falsch
        setze schluessel auf _uim_kalender_datum_schluessel(datum)
        setze start_schluessel auf _uim_kalender_datum_schluessel(w["bereich_start"])
        wenn länge(w["bereich_ende"]) == 0:
            gib_zurück schluessel == start_schluessel
        gib_zurück schluessel >= start_schluessel und schluessel <= _uim_kalender_datum_schluessel(w["bereich_ende"])
    gib_zurück _uim_kalender_datum_index(datum, w["mehrfach_auswahl"]) >= 0

funktion _uim_kalender_auswahl_anwenden(kontext, w, datum, callback_aufrufen):
    wenn nicht _uim_kalender_datum_erlaubt(w, datum):
        gib_zurück falsch
    setze datum_kopie auf _uim_kalender_datum_kopie(datum)
    w["fokus_tag"] = datum_kopie[0]
    w["fokus_monat"] = datum_kopie[1]
    w["fokus_jahr"] = datum_kopie[2]
    w["auswahl"] = datum_kopie[0]
    w["auswahl_datum"] = _uim_kalender_datum_kopie(datum_kopie)
    wenn w["auswahl_modus"] == "bereich":
        wenn länge(w["bereich_start"]) == 0 oder länge(w["bereich_ende"]) > 0:
            w["bereich_start"] = _uim_kalender_datum_kopie(datum_kopie)
            w["bereich_ende"] = []
        sonst wenn _uim_kalender_datum_schluessel(datum_kopie) < _uim_kalender_datum_schluessel(w["bereich_start"]):
            w["bereich_ende"] = _uim_kalender_datum_kopie(w["bereich_start"])
            w["bereich_start"] = _uim_kalender_datum_kopie(datum_kopie)
        sonst:
            w["bereich_ende"] = _uim_kalender_datum_kopie(datum_kopie)
    sonst wenn w["auswahl_modus"] == "mehrfach":
        setze fundstelle auf _uim_kalender_datum_index(datum_kopie, w["mehrfach_auswahl"])
        setze neue_liste auf []
        setze index auf 0
        solange index < länge(w["mehrfach_auswahl"]):
            wenn index != fundstelle:
                neue_liste.hinzufügen(_uim_kalender_datum_kopie(w["mehrfach_auswahl"][index]))
            setze index auf index + 1
        wenn fundstelle < 0:
            neue_liste.hinzufügen(_uim_kalender_datum_kopie(datum_kopie))
        w["mehrfach_auswahl"] = neue_liste
    _uim_kalender_auswahlzustand_sync(w)
    wenn callback_aufrufen:
        setze cb auf w["on_auswahl"]
        wenn cb != nichts:
            wenn w["auswahl_modus"] == "einzel":
                cb(w, datum_kopie[0])
            sonst:
                cb(w, _uim_kalender_auswahlwert(w))
        wenn w.enthält("datepicker_quelle"):
            _uim_datepicker_popup_uebernehmen(kontext, w)
    wenn kontext != nichts:
        _uim_bind_widget_zu_state(w)
        _uim_anfordern(kontext)
    sonst:
        _uim_widget_anfordern(w)
    gib_zurück wahr

funktion _uim_kalender_wert_setze(kontext, w, wert):
    wenn w["auswahl_modus"] == "einzel":
        wenn typ_von(wert) == "Liste":
            wenn länge(wert) != 0:
                gib_zurück falsch
            w["auswahl_datum"] = []
        sonst:
            setze tag_nummer auf wert
            wenn tag_nummer < 1:
                setze tag_nummer auf 1
            wenn tag_nummer > w["tage"]:
                setze tag_nummer auf w["tage"]
            gib_zurück _uim_kalender_auswahl_anwenden(kontext, w, [tag_nummer, w["monat"], w["jahr"]], falsch)
    sonst wenn w["auswahl_modus"] == "bereich":
        wenn typ_von(wert) != "Liste" oder länge(wert) > 2:
            gib_zurück falsch
        wenn länge(wert) == 0:
            w["bereich_start"] = []
            w["bereich_ende"] = []
        sonst:
            setze erster_tag auf _uim_kalender_datum_kopie(wert[0])
            wenn länge(erster_tag) == 0 oder nicht _uim_kalender_datum_erlaubt(w, erster_tag):
                gib_zurück falsch
            setze letzter_tag auf []
            wenn länge(wert) == 2:
                setze letzter_tag auf _uim_kalender_datum_kopie(wert[1])
                wenn länge(letzter_tag) == 0 oder nicht _uim_kalender_datum_erlaubt(w, letzter_tag):
                    gib_zurück falsch
                wenn _uim_kalender_datum_schluessel(letzter_tag) < _uim_kalender_datum_schluessel(erster_tag):
                    setze tausch_tag auf erster_tag
                    setze erster_tag auf letzter_tag
                    setze letzter_tag auf tausch_tag
            w["bereich_start"] = erster_tag
            w["bereich_ende"] = letzter_tag
            w["auswahl_datum"] = erster_tag
            w["auswahl"] = erster_tag[0]
    sonst:
        setze kopie auf _uim_kalender_datumsliste_kopie(wert)
        wenn kopie == nichts:
            gib_zurück falsch
        setze einzigartige_liste auf []
        setze index auf 0
        solange index < länge(kopie):
            wenn nicht _uim_kalender_datum_erlaubt(w, kopie[index]):
                gib_zurück falsch
            wenn _uim_kalender_datum_index(kopie[index], einzigartige_liste) < 0:
                einzigartige_liste.hinzufügen(_uim_kalender_datum_kopie(kopie[index]))
            setze index auf index + 1
        w["mehrfach_auswahl"] = einzigartige_liste
        wenn länge(einzigartige_liste) > 0:
            setze letzter_index auf länge(einzigartige_liste) - 1
            w["auswahl_datum"] = _uim_kalender_datum_kopie(einzigartige_liste[letzter_index])
            w["auswahl"] = einzigartige_liste[letzter_index][0]
    _uim_kalender_auswahlzustand_sync(w)
    wenn w["auswahl_modus"] == "bereich" und länge(w["bereich_start"]) > 0:
        w["fokus_tag"] = w["bereich_start"][0]
        w["fokus_monat"] = w["bereich_start"][1]
        w["fokus_jahr"] = w["bereich_start"][2]
    sonst wenn w["auswahl_modus"] == "mehrfach" und länge(w["mehrfach_auswahl"]) > 0:
        setze fokus_index auf länge(w["mehrfach_auswahl"]) - 1
        w["fokus_tag"] = w["mehrfach_auswahl"][fokus_index][0]
        w["fokus_monat"] = w["mehrfach_auswahl"][fokus_index][1]
        w["fokus_jahr"] = w["mehrfach_auswahl"][fokus_index][2]
    _uim_bind_widget_zu_state(w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_kalender_klick(kontext, w, lx, ly):
    _uim_kalender_sync(w)
    setze lokal_x auf lx - w["x"]
    setze lokal_y auf ly - w["y"]
    wenn lokal_y < 24:
        gib_zurück _uim_kalender_kopf_klick(w, lokal_x)
    wenn w["ansicht"] == "jahr" oder w["ansicht"] == "jahrzehnt":
        setze grid_y auf lokal_y - 28
        setze cell_b auf w["b"] / 3
        setze cell_h auf (w["h"] - 28) / 4
        setze col auf boden(lokal_x / cell_b)
        setze row auf boden(grid_y / cell_h)
        setze grid_idx auf row * 3 + col
        wenn col < 0 oder col > 2 oder row < 0 oder row > 3:
            gib_zurück falsch
        wenn w["ansicht"] == "jahr":
            w["monat"] = grid_idx + 1
            w["ansicht"] = "monat"
            _uim_kalender_sync(w)
        sonst:
            w["jahr"] = _uim_kalender_dekade_start(w["jahr"]) - 1 + grid_idx
            w["ansicht"] = "jahr"
        _uim_anfordern(kontext)
        gib_zurück wahr
    setze kopf_h auf 40
    wenn lokal_y < kopf_h:
        gib_zurück wahr
    setze kw_spalten auf 0
    wenn w["wochennummern"]:
        setze kw_spalten auf 1
    setze spalten_gesamt auf 7 + kw_spalten
    setze cell_b auf w["b"] / spalten_gesamt
    setze cell_h auf (w["h"] - kopf_h) / 6
    wenn cell_b <= 0 oder cell_h <= 0:
        gib_zurück falsch
    setze col auf boden(lokal_x / cell_b)
    setze row auf boden((lokal_y - kopf_h) / cell_h)
    wenn col < 0 oder col >= spalten_gesamt oder row < 0 oder row > 5:
        gib_zurück falsch
    wenn kw_spalten == 1 und col == 0:
        gib_zurück falsch
    setze tages_spalte auf col - kw_spalten
    setze tag auf row * 7 + tages_spalte - _uim_kalender_offset(w) + 1
    wenn tag < 1 oder tag > w["tage"]:
        gib_zurück falsch
    gib_zurück _uim_kalender_auswahl_anwenden(kontext, w, [tag, w["monat"], w["jahr"]], wahr)

funktion _uim_z_kalender_kopf(kontext, z, w, ax, ay):
    setze t auf kontext["theme"]
    _uim_farbe(kontext, z, t["akzent"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], 24, wahr)
    setze titel auf text(w["jahr"])
    wenn w["ansicht"] == "monat":
        setze titel auf _uim_kalender_monatsname(w["monat"]) + " " + text(w["jahr"])
        wenn w["b"] < 220:
            setze titel auf text(w["monat"]) + "/" + text(w["jahr"])
    sonst wenn w["ansicht"] == "jahrzehnt":
        setze dekade auf _uim_kalender_dekade_start(w["jahr"])
        setze titel auf text(dekade) + " - " + text(dekade + 9)
    _uim_farbe(kontext, z, t["auswahl_text"])
    _uim_zf_text(kontext, z, ax + 8, ay + 5, "<", t["schrift"] - 1)
    _uim_zf_text(kontext, z, ax + 34, ay + 5, titel, t["schrift"] - 1)
    wenn w["b"] >= 220:
        _uim_zf_text(kontext, z, ax + w["b"] - 84, ay + 5, "Heute", t["schrift"] - 3)
    _uim_zf_text(kontext, z, ax + w["b"] - 18, ay + 5, ">", t["schrift"] - 1)
    gib_zurück wahr

funktion _uim_z_kalender_monat(kontext, z, w, ax, ay):
    setze t auf kontext["theme"]
    setze kopf_h auf 40
    setze kw_spalten auf 0
    wenn w["wochennummern"]:
        setze kw_spalten auf 1
    setze cell_b auf w["b"] / (7 + kw_spalten)
    setze cell_h auf (w["h"] - kopf_h) / 6
    setze tag_schrift auf t["schrift"] - 4
    wenn tag_schrift + 7 > cell_h:
        setze tag_schrift auf cell_h - 7
    wenn tag_schrift < 1:
        setze tag_schrift auf 1
    setze wochentage auf ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"]
    wenn kw_spalten == 1:
        _uim_farbe(kontext, z, t["text_gedimmt"])
        _uim_zf_text(kontext, z, ax + 3, ay + 26, "KW", t["schrift"] - 6)
    setze spalte auf 0
    solange spalte < 7:
        setze wochentag_idx auf (w["wochenstart"] + spalte) % 7
        _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, ax + (spalte + kw_spalten) * cell_b + 4, ay + 26, wochentage[wochentag_idx], t["schrift"] - 5)
        setze spalte auf spalte + 1
    setze offset auf _uim_kalender_offset(w)
    wenn kw_spalten == 1:
        setze kw_zeile auf 0
        solange kw_zeile < 6:
            setze wochen_datum auf _uim_kalender_datum_verschiebe([1, w["monat"], w["jahr"]], kw_zeile * 7 - offset)
            _uim_farbe(kontext, z, t["text_gedimmt"])
            _uim_zf_text(kontext, z, ax + 3, ay + kopf_h + kw_zeile * cell_h + 1, text(_uim_kalender_iso_woche(wochen_datum)), tag_schrift - 1)
            setze kw_zeile auf kw_zeile + 1
    setze tag auf 1
    solange tag <= w["tage"]:
        setze idx auf offset + tag - 1
        setze col auf idx % 7
        setze row auf boden(idx / 7)
        setze tx auf ax + (col + kw_spalten) * cell_b
        setze ty auf ay + kopf_h + row * cell_h
        setze datum auf [tag, w["monat"], w["jahr"]]
        setze erlaubt auf _uim_kalender_datum_erlaubt(w, datum)
        wenn _uim_kalender_datum_ausgewaehlt(w, datum):
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck(kontext, z, tx, ty, cell_b, cell_h, wahr)
        wenn tag == w["heute_tag"] und w["monat"] == w["heute_monat"] und w["jahr"] == w["heute_jahr"]:
            _uim_farbe(kontext, z, t["rand"])
            _uim_zf_rechteck(kontext, z, tx + 1, ty + 1, cell_b - 2, cell_h - 2, falsch)
        wenn _uim_slot_uid(kontext, "fokus") == w["uid"] und tag == w["fokus_tag"] und w["monat"] == w["fokus_monat"] und w["jahr"] == w["fokus_jahr"]:
            _uim_farbe(kontext, z, t["rand"])
            _uim_zf_rechteck(kontext, z, tx + 3, ty + 3, cell_b - 6, cell_h - 6, falsch)
        wenn erlaubt:
            _uim_farbe(kontext, z, t["text"])
        sonst:
            _uim_farbe(kontext, z, t["text_gedimmt"])
        _uim_zf_text(kontext, z, tx + 4, ty + 1, text(tag), tag_schrift)
        wenn _uim_kalender_datum_index(datum, w["termine"]) >= 0:
            wenn erlaubt:
                _uim_farbe(kontext, z, t["akzent"])
            sonst:
                _uim_farbe(kontext, z, t["text_gedimmt"])
            _uim_zf_kreis(kontext, z, tx + cell_b / 2, ty + cell_h - 4, 2, wahr)
        setze tag auf tag + 1
    gib_zurück wahr

funktion _uim_z_kalender_jahr(kontext, z, w, ax, ay):
    setze t auf kontext["theme"]
    setze monate auf ["Jan", "Feb", "Mae", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dez"]
    setze cell_b auf w["b"] / 3
    setze cell_h auf (w["h"] - 28) / 4
    setze idx auf 0
    solange idx < 12:
        setze col auf idx % 3
        setze row auf boden(idx / 3)
        wenn idx + 1 == w["monat"]:
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck(kontext, z, ax + col * cell_b + 2, ay + 28 + row * cell_h + 2, cell_b - 4, cell_h - 4, wahr)
        _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, ax + col * cell_b + 8, ay + 34 + row * cell_h, monate[idx], t["schrift"] - 2)
        setze idx auf idx + 1
    gib_zurück wahr

funktion _uim_z_kalender_jahrzehnt(kontext, z, w, ax, ay):
    setze t auf kontext["theme"]
    setze cell_b auf w["b"] / 3
    setze cell_h auf (w["h"] - 28) / 4
    setze dekade auf _uim_kalender_dekade_start(w["jahr"])
    setze idx auf 0
    solange idx < 12:
        setze col auf idx % 3
        setze row auf boden(idx / 3)
        setze jahr_zelle auf dekade - 1 + idx
        wenn jahr_zelle == w["jahr"]:
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck(kontext, z, ax + col * cell_b + 2, ay + 28 + row * cell_h + 2, cell_b - 4, cell_h - 4, wahr)
        _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, ax + col * cell_b + 8, ay + 34 + row * cell_h, text(jahr_zelle), t["schrift"] - 2)
        setze idx auf idx + 1
    gib_zurück wahr

funktion _uim_z_kalender(kontext, z, w, ox, oy):
    _uim_kalender_sync(w)
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    _uim_z_kalender_kopf(kontext, z, w, ax, ay)
    wenn w["ansicht"] == "monat":
        _uim_z_kalender_monat(kontext, z, w, ax, ay)
    sonst wenn w["ansicht"] == "jahr":
        _uim_z_kalender_jahr(kontext, z, w, ax, ay)
    sonst:
        _uim_z_kalender_jahrzehnt(kontext, z, w, ax, ay)
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

funktion _uim_datepicker_zwei_stellen(wert):
    wenn wert < 10:
        gib_zurück "0" + text(wert)
    gib_zurück text(wert)

funktion _uim_datepicker_datum_text(datum):
    wenn nicht _uim_kalender_datum_gueltig(datum):
        gib_zurück ""
    gib_zurück _uim_datepicker_zwei_stellen(datum[0]) + "." + _uim_datepicker_zwei_stellen(datum[1]) + "." + text(datum[2])

funktion _uim_datepicker_anzeige(w):
    wenn w["auswahl_modus"] == "einzel":
        gib_zurück _uim_datepicker_datum_text(w["auswahl_datum"])
    wenn w["auswahl_modus"] == "bereich":
        wenn länge(w["bereich_start"]) == 0:
            gib_zurück ""
        setze anzeige auf _uim_datepicker_datum_text(w["bereich_start"])
        wenn länge(w["bereich_ende"]) == 0:
            gib_zurück anzeige + " - ..."
        gib_zurück anzeige + " - " + _uim_datepicker_datum_text(w["bereich_ende"])
    setze mehrfach auf _uim_kalender_datumsliste_sortiert(w["mehrfach_auswahl"])
    setze anzeige_mehrfach auf ""
    für datum_mehrfach in mehrfach:
        wenn anzeige_mehrfach != "":
            setze anzeige_mehrfach auf anzeige_mehrfach + ", "
        setze anzeige_mehrfach auf anzeige_mehrfach + _uim_datepicker_datum_text(datum_mehrfach)
    gib_zurück anzeige_mehrfach

funktion _uim_z_datepicker(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    w["_fenster_x"] = ax
    w["_fenster_y"] = ay
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], 3, wahr)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], 3, falsch)
    setze ty auf ay + (w["h"] - t["schrift"]) / 2 - 1
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
    _uim_zf_clip_setze(kontext, z, ax + 4, ay, w["b"] - 24, w["h"])
    _uim_zf_text(kontext, z, ax + 6, ty, _uim_datepicker_anzeige(w), t["schrift"] - 1)
    _uim_zf_clip_loesche(kontext, z)
    setze px auf ax + w["b"] - 15
    setze py auf ay + w["h"] / 2 - 2
    _uim_zf_linie(kontext, z, px, py, px + 4, py + 4, 2)
    _uim_zf_linie(kontext, z, px + 4, py + 4, px + 8, py, 2)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

funktion _uim_datepicker_oeffne(kontext, w):
    wenn kontext == nichts oder w == nichts:
        gib_zurück falsch
    setze overlay auf nichts
    wenn kontext.enthält("datepicker_overlay"):
        setze overlay auf kontext["datepicker_overlay"]
    wenn overlay == nichts:
        setze overlay auf uim_ueberlagerung(0, 0, kontext["wurzel"]["b"], kontext["wurzel"]["h"])
        overlay["offen"] = falsch
        overlay["sichtbar"] = falsch
        overlay["dimmen"] = falsch
        overlay["modal"] = wahr
        overlay["schliesst_aussen"] = wahr
        overlay["overlay_kind"] = "datepicker"
        overlay["z_index"] = 100000
        setze popup_neu auf uim_calendar(0, 0, w["popup_b"], w["popup_h"], w["monat"], w["jahr"], nichts)
        popup_neu["datepicker_quelle"] = w
        uim_hinzu(overlay, popup_neu)
        uim_hinzu(kontext, overlay)
        kontext["datepicker_overlay"] = overlay
    wenn länge(overlay["kinder"]) == 0:
        gib_zurück falsch
    setze popup auf overlay["kinder"][0]
    popup["datepicker_quelle"] = w
    popup["b"] = w["popup_b"]
    popup["h"] = w["popup_h"]
    popup["monat"] = w["monat"]
    popup["jahr"] = w["jahr"]
    popup["heute_tag"] = w["heute_tag"]
    popup["heute_monat"] = w["heute_monat"]
    popup["heute_jahr"] = w["heute_jahr"]
    popup["fokus_tag"] = w["fokus_tag"]
    popup["fokus_monat"] = w["fokus_monat"]
    popup["fokus_jahr"] = w["fokus_jahr"]
    _uim_kalender_sync(popup)
    uim_kalender_auswahlmodus_setze(popup, w["auswahl_modus"])
    uim_kalender_grenzen_setze(popup, w["min_datum"], w["max_datum"])
    uim_kalender_gesperrte_tage_setze(popup, w["gesperrte_tage"])
    uim_kalender_wochennummern_setze(popup, w["wochennummern"])
    uim_kalender_termine_setze(popup, w["termine"])
    setze auswahl_wert auf uim_wert_hole(w)
    wenn w["auswahl_modus"] == "einzel":
        setze einzel_datum auf _uim_kalender_datum_kopie(w["auswahl_datum"])
        wenn länge(einzel_datum) == 0:
            wenn nicht uim_wert_setze(kontext, popup, []):
                gib_zurück falsch
        sonst:
            popup["auswahl_datum"] = einzel_datum
            popup["auswahl"] = einzel_datum[0]
            popup["selected"] = wahr
            popup["zustand"] = "selected"
    sonst wenn not uim_wert_setze(kontext, popup, auswahl_wert):
        gib_zurück falsch
    wenn typ_von(auswahl_wert) == "Liste" und länge(auswahl_wert) == 0:
        _uim_kalender_fokus_sichtmonat_setze(popup)
    setze feld_x auf w["x"]
    setze feld_y auf w["y"]
    wenn w.enthält("_fenster_x"):
        setze feld_x auf w["_fenster_x"]
        setze feld_y auf w["_fenster_y"]
    setze popup_x auf feld_x
    setze popup_y auf feld_y + w["h"]
    wenn popup_y + popup["h"] > kontext["wurzel"]["h"]:
        setze popup_y auf feld_y - popup["h"]
    wenn popup_x + popup["b"] > kontext["wurzel"]["b"]:
        setze popup_x auf kontext["wurzel"]["b"] - popup["b"]
    wenn popup_x < 0:
        setze popup_x auf 0
    wenn popup_y < 0:
        setze popup_y auf 0
    popup["x"] = popup_x
    popup["y"] = popup_y
    overlay["x"] = 0
    overlay["y"] = 0
    overlay["b"] = kontext["wurzel"]["b"]
    overlay["h"] = kontext["wurzel"]["h"]
    overlay["datepicker_quelle"] = w
    kontext["datepicker_feld"] = w
    w["offen"] = wahr
    gib_zurück uim_ueberlagerung_setze(kontext, overlay, wahr, wahr)

funktion _uim_datepicker_popup_uebernehmen(kontext, popup):
    wenn kontext == nichts oder popup.enthält("datepicker_quelle") == falsch:
        gib_zurück falsch
    setze quelle auf popup["datepicker_quelle"]
    wenn quelle == nichts:
        gib_zurück falsch
    quelle["monat"] = popup["monat"]
    quelle["jahr"] = popup["jahr"]
    _uim_kalender_sync(quelle)
    wenn nicht uim_wert_setze(kontext, quelle, _uim_kalender_auswahlwert(popup)):
        gib_zurück falsch
    quelle["fokus_tag"] = popup["fokus_tag"]
    quelle["fokus_monat"] = popup["fokus_monat"]
    quelle["fokus_jahr"] = popup["fokus_jahr"]
    setze cb auf quelle["on_auswahl"]
    wenn cb != nichts:
        wenn quelle["auswahl_modus"] == "einzel":
            cb(quelle, quelle["auswahl"])
        sonst:
            cb(quelle, _uim_kalender_auswahlwert(quelle))
    setze soll_schliessen auf quelle["auswahl_modus"] == "einzel"
    wenn quelle["auswahl_modus"] == "bereich" und länge(popup["bereich_ende"]) > 0:
        setze soll_schliessen auf wahr
    wenn soll_schliessen und kontext.enthält("datepicker_overlay") und kontext["datepicker_overlay"] != nichts:
        gib_zurück _uim_dialog_schliesse(kontext, kontext["datepicker_overlay"], 1)
    quelle["offen"] = wahr
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_datepicker_toggle(kontext, w):
    wenn w["offen"]:
        wenn kontext.enthält("datepicker_overlay") und kontext["datepicker_overlay"] != nichts:
            gib_zurück _uim_dialog_schliesse(kontext, kontext["datepicker_overlay"], 0 - 1)
        w["offen"] = falsch
        gib_zurück wahr
    gib_zurück _uim_datepicker_oeffne(kontext, w)

funktion _uim_chart_klick(kontext, w, lx, ly):
    setze n auf länge(w["werte"])
    wenn n == 0 oder w["b"] <= 0:
        gib_zurück falsch
    setze idx auf boden((lx - w["x"]) * n / w["b"])
    wenn idx < 0:
        setze idx auf 0
    wenn idx > n - 1:
        setze idx auf n - 1
    w["auswahl"] = idx
    w["selected"] = wahr
    w["zustand"] = "selected"
    setze cb auf w["on_auswahl"]
    wenn cb != nichts:
        cb(w, idx)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_gauge_klick(kontext, w, lx):
    wenn w["b"] <= 0:
        gib_zurück falsch
    setze anteil auf (lx - w["x"]) / w["b"]
    wenn anteil < 0:
        setze anteil auf 0
    wenn anteil > 1:
        setze anteil auf 1
    setze wert auf w["min"] + (w["max"] - w["min"]) * anteil
    w["wert"] = wert
    setze cb auf w["on_wechsel"]
    wenn cb != nichts:
        cb(w, wert)
    _uim_anfordern(kontext)
    gib_zurück wahr

# Diagramm-Grundlagen: einheitliches Raster, Palette und Rahmen.
funktion _uim_chart_max(werte):
    setze maximum auf 1
    für wert in werte:
        wenn wert > maximum:
            setze maximum auf wert
    gib_zurück maximum

funktion _uim_chart_farbe(theme, idx):
    setze palette auf [theme["akzent"], theme["flaeche_hover"], theme["rand_fokus"], theme["text_gedimmt"]]
    gib_zurück palette[idx % länge(palette)]

funktion _uim_z_chart_rahmen(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    setze pad auf t["abstand"]
    setze plot_b auf w["b"] - 2 * pad
    setze plot_h auf w["h"] - 2 * pad - 12
    wenn plot_b < 1:
        setze plot_b auf 1
    wenn plot_h < 1:
        setze plot_h auf 1
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_linie(kontext, z, ax + pad, ay + pad + plot_h, ax + pad + plot_b, ay + pad + plot_h, 1)
    _uim_zf_linie(kontext, z, ax + pad, ay + pad, ax + pad, ay + pad + plot_h, 1)
    _uim_farbe(kontext, z, t["text_gedimmt"])
    _uim_zf_linie(kontext, z, ax + pad, ay + pad + plot_h / 2, ax + pad + plot_b, ay + pad + plot_h / 2, 1)
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    gib_zurück wahr

funktion _uim_z_linechart(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_z_chart_rahmen(kontext, z, w, ox, oy)
    setze pad auf t["abstand"]
    setze plot_b auf w["b"] - 2 * pad
    setze plot_h auf w["h"] - 2 * pad - 12
    setze werte auf w["werte"]
    setze n auf länge(werte)
    setze maximum auf _uim_chart_max(werte)
    wenn n > 0:
        setze i auf 0
        setze vorher_x auf ax + pad
        setze wert0 auf werte[0]
        wenn wert0 < 0:
            setze wert0 auf 0
        wenn wert0 > maximum:
            setze wert0 auf maximum
        setze vorher_y auf ay + pad + plot_h - plot_h * wert0 / maximum
        solange i < n:
            setze wert auf werte[i]
            wenn wert < 0:
                setze wert auf 0
            wenn wert > maximum:
                setze wert auf maximum
            setze px auf ax + pad
            wenn n > 1:
                setze px auf ax + pad + plot_b * i / (n - 1)
            setze py auf ay + pad + plot_h - plot_h * wert / maximum
            wenn i > 0:
                _uim_farbe(kontext, z, _uim_chart_farbe(t, i))
                _uim_zf_linie(kontext, z, vorher_x, vorher_y, px, py, 2)
            wenn i == w["auswahl"]:
                _uim_farbe(kontext, z, t["text"])
                _uim_zf_kreis(kontext, z, px, py, 4, wahr)
            sonst:
                _uim_farbe(kontext, z, _uim_chart_farbe(t, i))
                _uim_zf_kreis(kontext, z, px, py, 3, wahr)
            setze vorher_x auf px
            setze vorher_y auf py
            setze i auf i + 1
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

funktion _uim_z_barchart(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_z_chart_rahmen(kontext, z, w, ox, oy)
    setze pad auf t["abstand"]
    setze plot_b auf w["b"] - 2 * pad
    setze plot_h auf w["h"] - 2 * pad - 12
    setze werte auf w["werte"]
    setze n auf länge(werte)
    wenn n > 0:
        setze maximum auf _uim_chart_max(werte)
        setze bar_b auf plot_b / n
        setze i auf 0
        solange i < n:
            setze wert auf werte[i]
            wenn wert < 0:
                setze wert auf 0
            wenn wert > maximum:
                setze wert auf maximum
            setze bh auf plot_h * wert / maximum
            setze bx auf ax + pad + bar_b * i + 2
            setze by auf ay + pad + plot_h - bh
            wenn i == w["auswahl"]:
                _uim_farbe(kontext, z, t["akzent"])
            sonst:
                _uim_farbe(kontext, z, _uim_chart_farbe(t, i))
            _uim_zf_rechteck_rund(kontext, z, bx, by, bar_b - 4, bh, 3, wahr)
            setze i auf i + 1
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

funktion _uim_z_piechart(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze radius auf w["h"] / 2 - t["abstand"] - 4
    wenn radius > w["b"] / 2 - t["abstand"] - 4:
        setze radius auf w["b"] / 2 - t["abstand"] - 4
    wenn radius < 4:
        setze radius auf 4
    setze cx auf ax + w["b"] / 2
    setze cy auf ay + w["h"] / 2
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    _uim_farbe(kontext, z, t["flaeche_hover"])
    _uim_zf_kreis(kontext, z, cx, cy, radius, wahr)
    setze dx auf [1, 0, -1, 0, 1, 1, -1, -1]
    setze dy auf [0, 1, 0, -1, -1, 1, 1, -1]
    setze n auf länge(w["werte"])
    wenn n > 0:
        setze i auf 0
        solange i < n:
            setze sektor auf i * 8 / n
            wenn sektor > 7:
                setze sektor auf 7
            setze ex auf cx + radius * dx[sektor]
            setze ey auf cy + radius * dy[sektor]
            wenn i == w["auswahl"]:
                _uim_farbe(kontext, z, t["text"])
            sonst:
                _uim_farbe(kontext, z, _uim_chart_farbe(t, i))
            _uim_zf_linie(kontext, z, cx, cy, ex, ey, 3)
            _uim_zf_kreis(kontext, z, ex, ey, 3, wahr)
            setze i auf i + 1
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_kreis(kontext, z, cx, cy, radius, falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

funktion _uim_z_gauge(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    setze span auf w["max"] - w["min"]
    setze anteil auf 0
    wenn span > 0:
        setze anteil auf (w["wert"] - w["min"]) / span
    wenn anteil < 0:
        setze anteil auf 0
    wenn anteil > 1:
        setze anteil auf 1
    setze pad auf t["abstand"]
    setze track_b auf w["b"] - 2 * pad
    _uim_farbe(kontext, z, t["flaeche_hover"])
    _uim_zf_rechteck_rund(kontext, z, ax + pad, ay + w["h"] / 2 - 6, track_b, 12, 5, wahr)
    _uim_farbe(kontext, z, t["akzent"])
    _uim_zf_rechteck_rund(kontext, z, ax + pad, ay + w["h"] / 2 - 6, track_b * anteil, 12, 5, wahr)
    _uim_zf_linie(kontext, z, ax + pad + track_b * anteil, ay + 8, ax + pad + track_b * anteil, ay + w["h"] - 8, 2)
    _uim_farbe(kontext, z, t["text"])
    _uim_zf_text(kontext, z, ax + pad, ay + 4, text(w["wert"]), t["schrift"] - 1)
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

# Scrollbereich: Rahmen + Clip öffnen (Kinder zeichnet _uim_zeichne_widget)
funktion _uim_z_scroll_rahmen(kontext, z, w, ox, oy):
    wenn _uim_clip_kinder_aktiv(w):
        gib_zurück _uim_zf_clip_setze(kontext, z, ox + w["x"], oy + w["y"], w["b"], w["h"])
    gib_zurück wahr
# Scrollbereich: Clip schliessen + Scrollbar rechts zeichnen
funktion _uim_z_scroll_leiste(kontext, z, w, ox, oy):
    wenn _uim_clip_kinder_aktiv(w):
        setze pop_ok auf _uim_zf_clip_loesche(kontext, z)
        wenn pop_ok == falsch:
            gib_zurück falsch
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], falsch)
    setze inhalt auf w["inhalt_hoehe"]
    wenn inhalt <= w["h"]:
        gib_zurück wahr
    # Thumb: Groesse und Position proportional.
    setze leiste_x auf ax + w["b"] - 6
    _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck_rund(kontext, z, leiste_x, ay, 5, w["h"], 2, wahr)
    setze thumb_h auf w["h"] * w["h"] / inhalt
    wenn thumb_h < 16:
        setze thumb_h auf 16
    setze max_scroll auf inhalt - w["h"]
    setze thumb_y auf ay
    wenn max_scroll > 0:
        setze thumb_y auf ay + (w["h"] - thumb_h) * (w["scroll_y"] / max_scroll)
    _uim_farbe(kontext, z, t["text_gedimmt"])
    _uim_zf_rechteck_rund(kontext, z, leiste_x, thumb_y, 5, thumb_h, 2, wahr)
    gib_zurück wahr

# Zentraler rekursiver Zeichner: Container transformieren ihre Kinder.
# ------------------------------------------------------------
# NATIVE-UI-3: Separator, Textfeld, Combobox — gezeichnete Widgets
# im selben Kern (kein zweiter Widget-Satz). Textfeld arbeitet
# byte-basiert mit UTF-8-Grenzen (_uim_ime_utf8_grenze); Combobox
# zeichnet ihr Dropdown als Overlay-Pass NACH dem Baum (z-oberst).
# ------------------------------------------------------------

funktion _uim_tf_teil(bytes, start_i, ende_i):
    setze teil_liste auf []
    setze i auf start_i
    solange i < ende_i:
        teil_liste.hinzufügen(bytes[i])
        setze i auf i + 1
    gib_zurück teil_liste

funktion _uim_tf_grenze_zurueck(bytes, pos):
    setze p auf pos - 1
    wenn p < 0:
        gib_zurück 0
    solange p > 0 und _uim_ime_utf8_grenze(bytes, p) == falsch:
        setze p auf p - 1
    gib_zurück p

funktion _uim_tf_grenze_vor(bytes, pos):
    setze n auf länge(bytes)
    setze p auf pos + 1
    wenn p > n:
        gib_zurück n
    solange p < n und _uim_ime_utf8_grenze(bytes, p) == falsch:
        setze p auf p + 1
    gib_zurück p

# Genau EIN druckbares Zeichen? (1 ASCII-Byte >= 32 oder eine einzelne
# UTF-8-Multibyte-Sequenz.)
funktion _uim_tf_ist_zeichen(tb):
    setze n auf länge(tb)
    wenn n == 0:
        gib_zurück falsch
    wenn n == 1:
        gib_zurück tb[0] >= 32 und tb[0] < 127
    wenn tb[0] < 194:
        gib_zurück falsch
    setze i auf 1
    solange i < n:
        wenn tb[i] < 128 oder tb[i] >= 192:
            gib_zurück falsch
        setze i auf i + 1
    gib_zurück n <= 4

funktion _uim_tf_einfuegen(kontext, f, tb):
    wenn _uim_tf_ist_zeichen(tb) == falsch:
        gib_zurück falsch
    wenn f["typ"] == "numberbox":
        wenn länge(tb) != 1:
            gib_zurück falsch
        wenn (tb[0] < 48 oder tb[0] > 57) und tb[0] != 45 und tb[0] != 46:
            gib_zurück falsch
    setze bytes auf bytes_zu_liste(f["text"])
    setze cur auf f["cursor"]
    wenn cur < 0:
        setze cur auf 0
    wenn cur > länge(bytes):
        setze cur auf länge(bytes)
    setze nb auf _uim_tf_teil(bytes, 0, cur)
    für bb in tb:
        nb.hinzufügen(bb)
    setze rest auf _uim_tf_teil(bytes, cur, länge(bytes))
    für bb in rest:
        nb.hinzufügen(bb)
    f["text"] = bytes_neu(nb)
    f["cursor"] = cur + länge(tb)
    wenn f["text"] == "":
        f["eingabe_zustand"] = "empty"
    sonst:
        f["eingabe_zustand"] = "filled"
    gib_zurück wahr

funktion _uim_multiline_spalte_reset(f):
    wenn f["typ"] == "multiline":
        f["vertikal_spalte"] = 0 - 1
    gib_zurück wahr

funktion _uim_multiline_zeilen(bytes):
    setze ml_zeilen auf []
    setze ml_start auf 0
    setze ml_i auf 0
    solange ml_i < länge(bytes):
        wenn bytes[ml_i] == 10:
            ml_zeilen.hinzufügen([ml_start, ml_i])
            setze ml_start auf ml_i + 1
        setze ml_i auf ml_i + 1
    ml_zeilen.hinzufügen([ml_start, länge(bytes)])
    gib_zurück ml_zeilen

funktion _uim_multiline_navigiere(f, taste):
    setze ml_bytes_nav auf bytes_zu_liste(f["text"])
    setze ml_cursor_nav auf f["cursor"]
    wenn ml_cursor_nav < 0:
        setze ml_cursor_nav auf 0
    wenn ml_cursor_nav > länge(ml_bytes_nav):
        setze ml_cursor_nav auf länge(ml_bytes_nav)
    wenn _uim_ime_utf8_grenze(ml_bytes_nav, ml_cursor_nav) == falsch:
        setze ml_cursor_nav auf _uim_tf_grenze_zurueck(ml_bytes_nav, ml_cursor_nav)
    setze ml_zeilen_nav auf _uim_multiline_zeilen(ml_bytes_nav)
    setze ml_idx_nav auf 0
    solange ml_idx_nav < länge(ml_zeilen_nav) - 1 und ml_cursor_nav > ml_zeilen_nav[ml_idx_nav][1]:
        setze ml_idx_nav auf ml_idx_nav + 1
    wenn taste == "Home":
        f["cursor"] = ml_zeilen_nav[ml_idx_nav][0]
        f["vertikal_spalte"] = 0 - 1
        gib_zurück wahr
    wenn taste == "End":
        f["cursor"] = ml_zeilen_nav[ml_idx_nav][1]
        f["vertikal_spalte"] = 0 - 1
        gib_zurück wahr
    setze ml_spalte_nav auf f["vertikal_spalte"]
    wenn ml_spalte_nav < 0:
        setze ml_spalte_nav auf 0
        setze ml_pos_nav auf ml_zeilen_nav[ml_idx_nav][0]
        solange ml_pos_nav < ml_cursor_nav:
            setze ml_pos_nav auf _uim_tf_grenze_vor(ml_bytes_nav, ml_pos_nav)
            setze ml_spalte_nav auf ml_spalte_nav + 1
        f["vertikal_spalte"] = ml_spalte_nav
    setze ml_ziel_idx auf ml_idx_nav
    wenn taste == "Up":
        setze ml_ziel_idx auf ml_ziel_idx - 1
    sonst wenn taste == "Down":
        setze ml_ziel_idx auf ml_ziel_idx + 1
    sonst:
        gib_zurück falsch
    wenn ml_ziel_idx < 0:
        setze ml_ziel_idx auf 0
    wenn ml_ziel_idx >= länge(ml_zeilen_nav):
        setze ml_ziel_idx auf länge(ml_zeilen_nav) - 1
    setze ml_ziel_pos auf ml_zeilen_nav[ml_ziel_idx][0]
    setze ml_ziel_spalte auf 0
    solange ml_ziel_spalte < ml_spalte_nav und ml_ziel_pos < ml_zeilen_nav[ml_ziel_idx][1]:
        setze ml_ziel_pos auf _uim_tf_grenze_vor(ml_bytes_nav, ml_ziel_pos)
        setze ml_ziel_spalte auf ml_ziel_spalte + 1
    f["cursor"] = ml_ziel_pos
    gib_zurück wahr

funktion _uim_multiline_caret_sichtbar(kontext, f):
    setze ml_bytes_sicht auf bytes_zu_liste(f["text"])
    setze ml_cursor_sicht auf f["cursor"]
    wenn ml_cursor_sicht < 0:
        setze ml_cursor_sicht auf 0
    wenn ml_cursor_sicht > länge(ml_bytes_sicht):
        setze ml_cursor_sicht auf länge(ml_bytes_sicht)
    wenn _uim_ime_utf8_grenze(ml_bytes_sicht, ml_cursor_sicht) == falsch:
        setze ml_cursor_sicht auf _uim_tf_grenze_zurueck(ml_bytes_sicht, ml_cursor_sicht)
    setze ml_zeilen_sicht auf _uim_multiline_zeilen(ml_bytes_sicht)
    setze ml_idx_sicht auf 0
    solange ml_idx_sicht < länge(ml_zeilen_sicht) - 1 und ml_cursor_sicht > ml_zeilen_sicht[ml_idx_sicht][1]:
        setze ml_idx_sicht auf ml_idx_sicht + 1
    setze ml_zh_sicht auf _uim_zeilenhoehe(kontext)
    setze ml_view_sicht auf f["h"] - 8
    wenn ml_view_sicht < ml_zh_sicht:
        setze ml_view_sicht auf ml_zh_sicht
    setze ml_oben_sicht auf ml_idx_sicht * ml_zh_sicht
    setze ml_unten_sicht auf ml_oben_sicht + ml_zh_sicht
    setze ml_alt_scroll auf f["scroll_y"]
    wenn ml_oben_sicht < f["scroll_y"]:
        f["scroll_y"] = ml_oben_sicht
    wenn ml_unten_sicht > f["scroll_y"] + ml_view_sicht:
        f["scroll_y"] = ml_unten_sicht - ml_view_sicht
    _uim_scroll_klemme(kontext, f)
    gib_zurück f["scroll_y"] != ml_alt_scroll

funktion _uim_multiline_lf_einfuegen(f):
    setze ml_bytes auf bytes_zu_liste(f["text"])
    setze ml_cur auf f["cursor"]
    wenn ml_cur < 0:
        setze ml_cur auf 0
    wenn ml_cur > länge(ml_bytes):
        setze ml_cur auf länge(ml_bytes)
    setze ml_neu auf _uim_tf_teil(ml_bytes, 0, ml_cur)
    ml_neu.hinzufügen(10)
    setze ml_rest auf _uim_tf_teil(ml_bytes, ml_cur, länge(ml_bytes))
    für ml_bb in ml_rest:
        ml_neu.hinzufügen(ml_bb)
    f["text"] = bytes_neu(ml_neu)
    f["cursor"] = ml_cur + 1
    f["eingabe_zustand"] = "filled"
    gib_zurück wahr

# UI-13/VALID: Validator-Hook und wiederverwendbare Standardprüfer.
funktion uim_validierung_pflicht(wert, nachricht):
    wenn wert == nichts oder text(wert) == "":
        wenn nachricht == "":
            gib_zurück "Pflichtfeld"
        gib_zurück nachricht
    gib_zurück ""

funktion uim_validierung_zahl_bereich(wert, min_wert, max_wert, nachricht):
    setze z auf zahl(wert)
    wenn z == nichts oder (min_wert != nichts und z < min_wert) oder (max_wert != nichts und z > max_wert):
        wenn nachricht == "":
            gib_zurück "Zahl ausserhalb des Bereichs"
        gib_zurück nachricht
    gib_zurück ""

funktion uim_validierung_format(wert, muster, nachricht):
    wenn muster == nichts oder muster == "":
        gib_zurück ""
    wenn passt(text(wert), regex(muster)):
        gib_zurück ""
    wenn nachricht == "":
        gib_zurück "Format ungueltig"
    gib_zurück nachricht

funktion uim_validiere(kontext, w):
    wenn w == nichts:
        gib_zurück falsch
    setze fehler auf ""
    setze validator auf w["validator"]
    wenn validator != nichts:
        setze ergebnis auf validator(w, w["text"])
        wenn ergebnis == falsch:
            setze fehler auf "Ungueltige Eingabe"
        sonst wenn ergebnis != wahr und ergebnis != nichts:
            setze fehler auf text(ergebnis)
    w["validierungs_fehler"] = fehler
    w["invalid"] = fehler != ""
    w["error"] = w["invalid"] oder w["zustand"] == "error"
    wenn w["invalid"]:
        w["eingabe_zustand"] = "invalid"
        w["tooltip"] = fehler
        w["a11y_beschreibung"] = fehler
    sonst:
        wenn w["text"] == "":
            w["eingabe_zustand"] = "empty"
        sonst:
            w["eingabe_zustand"] = "filled"
        w["tooltip"] = w["hilfetext"]
        w["a11y_beschreibung"] = w["hilfetext"]
    _uim_anfordern(kontext)
    gib_zurück w["invalid"] == falsch

funktion uim_validierung_setze(kontext, w, validator, hilfetext):
    wenn w == nichts:
        gib_zurück falsch
    w["validator"] = validator
    wenn hilfetext == nichts:
        w["hilfetext"] = ""
    sonst:
        w["hilfetext"] = text(hilfetext)
    gib_zurück uim_validiere(kontext, w)

funktion uim_validierungsfehler_hole(w):
    wenn w == nichts oder w.enthält("validierungs_fehler") == falsch:
        gib_zurück ""
    gib_zurück w["validierungs_fehler"]

funktion _uim_tf_verlauf_merke(f):
    wenn länge(f["undo_stapel"]) == 0 oder f["undo_stapel"][länge(f["undo_stapel"]) - 1] != f["text"]:
        f["undo_stapel"].hinzufügen(f["text"])
    f["redo_stapel"] = []
    gib_zurück wahr

funktion _uim_tf_feuere_wechsel(kontext, f):
    wenn f["validator"] != nichts:
        uim_validiere(kontext, f)
    _uim_bind_widget_zu_state(f)
    setze ce auf f["on_eingabe"]
    wenn ce != nichts:
        ce(f, f["text"])
    setze cw auf f["on_wechsel"]
    wenn cw != nichts:
        cw(f, f["text"])
    gib_zurück wahr

funktion _uim_liste_ohne_letztes(liste):
    setze rest_liste auf []
    setze i auf 0
    solange i < länge(liste) - 1:
        rest_liste.hinzufügen(liste[i])
        setze i auf i + 1
    gib_zurück rest_liste

funktion uim_text_undo(kontext, w):
    wenn länge(w["undo_stapel"]) == 0:
        gib_zurück falsch
    w["redo_stapel"].hinzufügen(w["text"])
    setze idx auf länge(w["undo_stapel"]) - 1
    w["text"] = w["undo_stapel"][idx]
    w["undo_stapel"] = _uim_liste_ohne_letztes(w["undo_stapel"])
    w["cursor"] = länge(bytes_zu_liste(w["text"]))
    _uim_multiline_spalte_reset(w)
    _uim_multiline_caret_sichtbar(kontext, w)
    _uim_tf_feuere_wechsel(kontext, w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_text_redo(kontext, w):
    wenn länge(w["redo_stapel"]) == 0:
        gib_zurück falsch
    w["undo_stapel"].hinzufügen(w["text"])
    setze idx auf länge(w["redo_stapel"]) - 1
    w["text"] = w["redo_stapel"][idx]
    w["redo_stapel"] = _uim_liste_ohne_letztes(w["redo_stapel"])
    w["cursor"] = länge(bytes_zu_liste(w["text"]))
    _uim_multiline_spalte_reset(w)
    _uim_multiline_caret_sichtbar(kontext, w)
    _uim_tf_feuere_wechsel(kontext, w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_z_separator(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"] + w["h"] / 2
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_linie(kontext, z, ax, ay, ax + w["b"], ay, 1)
    gib_zurück wahr

funktion _uim_eingabe_anzeige(kontext, w):
    wenn w["typ"] == "passwordbox":
        setze maskiert auf ""
        für bb in bytes_zu_liste(w["text"]):
            setze maskiert auf maskiert + "*"
        gib_zurück maskiert
    wenn w["text"] == "" und w.enthält("placeholder") und _uim_slot_uid(kontext, "fokus") != w["uid"]:
        gib_zurück w["placeholder"]
    gib_zurück w["text"]

funktion _uim_z_multiline(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze flaeche auf _uim_zustand_farbe(kontext, w, "flaeche")
    _uim_farbe(kontext, z, flaeche)
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], 3, wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], 3)
    setze hat_fokus auf _uim_slot_uid(kontext, "fokus") == w["uid"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], 3, falsch)
    setze ml_bytes_z auf bytes_zu_liste(w["text"])
    setze ml_zeilen_z auf _uim_multiline_zeilen(ml_bytes_z)
    setze ml_cursor_z auf w["cursor"]
    wenn ml_cursor_z < 0:
        setze ml_cursor_z auf 0
    wenn ml_cursor_z > länge(ml_bytes_z):
        setze ml_cursor_z auf länge(ml_bytes_z)
    wenn _uim_ime_utf8_grenze(ml_bytes_z, ml_cursor_z) == falsch:
        setze ml_cursor_z auf _uim_tf_grenze_zurueck(ml_bytes_z, ml_cursor_z)
    setze ml_cursor_zeile_z auf 0
    solange ml_cursor_zeile_z < länge(ml_zeilen_z) - 1 und ml_cursor_z > ml_zeilen_z[ml_cursor_zeile_z][1]:
        setze ml_cursor_zeile_z auf ml_cursor_zeile_z + 1
    setze ml_zeilen_h_z auf _uim_zeilenhoehe(kontext)
    setze ml_text_y_z auf ay + 4 - w["scroll_y"]
    _uim_zf_clip_setze(kontext, z, ax + 4, ay + 4, w["b"] - 8, w["h"] - 8)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
    setze ml_idx_z auf 0
    solange ml_idx_z < länge(ml_zeilen_z):
        setze ml_bereich_z auf ml_zeilen_z[ml_idx_z]
        setze ml_text_z auf bytes_neu(_uim_tf_teil(ml_bytes_z, ml_bereich_z[0], ml_bereich_z[1]))
        _uim_zf_text(kontext, z, ax + 6, ml_text_y_z + ml_idx_z * ml_zeilen_h_z, ml_text_z, t["schrift"])
        setze ml_idx_z auf ml_idx_z + 1
    wenn hat_fokus:
        setze ml_cursor_bereich_z auf ml_zeilen_z[ml_cursor_zeile_z]
        setze ml_links_z auf bytes_neu(_uim_tf_teil(ml_bytes_z, ml_cursor_bereich_z[0], ml_cursor_z))
        setze ml_cx_z auf ax + 6 + _uim_zf_text_breite(kontext, z, ml_links_z, t["schrift"])
        setze ml_cy_z auf ml_text_y_z + ml_cursor_zeile_z * ml_zeilen_h_z
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_linie(kontext, z, ml_cx_z + 1, ml_cy_z - 1, ml_cx_z + 1, ml_cy_z + t["schrift"] + 1, 1)
    _uim_zf_clip_loesche(kontext, z)
    wenn w["invalid"] und w["validierungs_fehler"] != "":
        setze fehler_schrift auf t["schrift"] - 2
        wenn fehler_schrift < 7:
            setze fehler_schrift auf 7
        _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
        _uim_zf_text(kontext, z, ax + 2, ay + w["h"] + 2, w["validierungs_fehler"], fehler_schrift)
    gib_zurück wahr

funktion _uim_z_textfeld(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze flaeche auf _uim_zustand_farbe(kontext, w, "flaeche")
    _uim_farbe(kontext, z, flaeche)
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], 3, wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], 3)
    setze hat_fokus auf _uim_slot_uid(kontext, "fokus") == w["uid"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], 3, falsch)
    _uim_zf_clip_setze(kontext, z, ax + 4, ay, w["b"] - 8, w["h"])
    setze farbe auf _uim_zustand_farbe(kontext, w, "text")
    _uim_farbe(kontext, z, farbe)
    setze ty auf ay + (w["h"] - t["schrift"]) / 2 - 1
    _uim_zf_text(kontext, z, ax + 6, ty, _uim_eingabe_anzeige(kontext, w), t["schrift"])
    wenn hat_fokus:
        setze bytes auf bytes_zu_liste(_uim_eingabe_anzeige(kontext, w))
        setze links auf bytes_neu(_uim_tf_teil(bytes, 0, w["cursor"]))
        setze cx auf ax + 6 + _uim_zf_text_breite(kontext, z, links, t["schrift"])
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_linie(kontext, z, cx + 1, ay + 4, cx + 1, ay + w["h"] - 4, 1)
    _uim_zf_clip_loesche(kontext, z)
    wenn w["invalid"] und w["validierungs_fehler"] != "":
        setze fehler_schrift auf t["schrift"] - 2
        wenn fehler_schrift < 7:
            setze fehler_schrift auf 7
        _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
        _uim_zf_text(kontext, z, ax + 2, ay + w["h"] + 2, w["validierungs_fehler"], fehler_schrift)
    gib_zurück wahr

funktion _uim_z_combobox(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze flaeche auf _uim_zustand_farbe(kontext, w, "flaeche")
    _uim_farbe(kontext, z, flaeche)
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], 3, wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], 3)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], 3, falsch)
    setze anzeige auf ""
    setze n auf länge(w["zeilen"])
    wenn n > 0 und w["auswahl"] >= 0 und w["auswahl"] < n:
        setze anzeige auf w["zeilen"][w["auswahl"]]
    setze farbe auf _uim_zustand_farbe(kontext, w, "text")
    _uim_farbe(kontext, z, farbe)
    setze ty auf ay + (w["h"] - t["schrift"]) / 2 - 1
    _uim_zf_clip_setze(kontext, z, ax + 4, ay, w["b"] - 22, w["h"])
    _uim_zf_text(kontext, z, ax + 6, ty, anzeige, t["schrift"])
    _uim_zf_clip_loesche(kontext, z)
    setze px auf ax + w["b"] - 14
    setze py auf ay + w["h"] / 2 - 2
    _uim_zf_linie(kontext, z, px, py, px + 4, py + 4, 2)
    _uim_zf_linie(kontext, z, px + 4, py + 4, px + 8, py, 2)
    wenn w["offen"]:
        # Overlay-Geometrie global merken; gezeichnet wird das Dropdown
        # in _uim_kern_zeichne NACH dem Baum (liegt damit z-oberst).
        setze feld auf {}
        feld["x"] = ax
        feld["y"] = ay
        feld["b"] = w["b"]
        feld["h"] = w["h"]
        kontext["combo_feld"] = feld
        setze zh auf _uim_zeilenhoehe(kontext)
        setze rect auf {}
        rect["x"] = ax
        rect["y"] = ay + w["h"]
        rect["b"] = w["b"]
        rect["h"] = n * zh
        kontext["combo_rect"] = rect
        kontext["combo_offen"] = w
    gib_zurück wahr

# Menueleisten-Zeichner (NATIVE-UI-11): Titel nebeneinander, offener
# Titel akzent-hinterlegt; Dropdown-Geometrie wird pro Frame frisch in
# kontext[menue_rect]/[menue_urspr] gelegt (Overlay-Muster wie Combobox).
funktion _uim_z_menueleiste(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], 2)
    setze mu auf {}
    mu["x"] = ax
    mu["y"] = ay
    kontext["menue_urspr"] = mu
    setze zh auf _uim_zeilenhoehe(kontext)
    setze cx auf ax
    setze i auf 0
    solange i < länge(w["eintraege"]):
        setze e auf w["eintraege"][i]
        setze tb auf _uim_menue_titel_breite(kontext, t, e)
        wenn i == w["offen"]:
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck(kontext, z, cx, ay + 1, tb, w["h"] - 2, wahr)
            wenn t.enthält("auswahl_text"):
                _uim_farbe(kontext, z, t["auswahl_text"])
            sonst:
                _uim_farbe(kontext, z, t["hintergrund"])
        sonst:
            _uim_farbe(kontext, z, t["text"])
        setze ty auf ay + (w["h"] - t["schrift"]) / 2 - 1
        _uim_zf_text(kontext, z, cx + t["abstand"], ty, e["titel"], t["schrift"])
        wenn i == w["offen"]:
            setze punkte auf e["punkte"]
            setze db auf 140
            setze dh auf 0
            setze j auf 0
            solange j < länge(punkte):
                wenn punkte[j]["typ"] == "trenner":
                    setze dh auf dh + boden(zh / 2)
                sonst:
                    setze dh auf dh + zh
                    setze pb auf _uim_zf_text_breite(kontext, nichts, punkte[j]["text"], t["schrift"]) + 2 * t["abstand"]
                    wenn pb > db:
                        setze db auf pb
                setze j auf j + 1
            setze rect auf {}
            rect["x"] = cx
            rect["y"] = ay + w["h"]
            rect["b"] = db
            rect["h"] = dh
            kontext["menue_rect"] = rect
        setze cx auf cx + tb
        setze i auf i + 1
    gib_zurück wahr

funktion _uim_z_menue_overlay(kontext, z):
    wenn kontext.enthält("menue_offen") == falsch:
        gib_zurück wahr
    setze mw auf kontext["menue_offen"]
    wenn mw == nichts oder mw["offen"] < 0:
        gib_zurück wahr
    setze r auf kontext["menue_rect"]
    wenn r == nichts:
        gib_zurück wahr
    setze t auf kontext["theme"]
    setze zh auf _uim_zeilenhoehe(kontext)
    setze punkte auf mw["eintraege"][mw["offen"]]["punkte"]
    wenn _uim_glass_an(t):
        _uim_farbe(kontext, z, [16, 26, 46, 235])
    sonst:
        _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck(kontext, z, r["x"], r["y"], r["b"], r["h"], wahr)
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, r["x"], r["y"], r["b"], r["h"], falsch)
    setze hover auf 0 - 1
    wenn kontext.enthält("menue_hover"):
        setze hover auf kontext["menue_hover"]
    setze py auf r["y"]
    setze i auf 0
    solange i < länge(punkte):
        setze p auf punkte[i]
        wenn p["typ"] == "trenner":
            setze ph auf boden(zh / 2)
            _uim_farbe(kontext, z, t["rand"])
            _uim_zf_linie(kontext, z, r["x"] + 6, py + boden(ph / 2), r["x"] + r["b"] - 6, py + boden(ph / 2), 1)
            setze py auf py + ph
        sonst:
            wenn i == hover:
                _uim_farbe(kontext, z, t["akzent"])
                _uim_zf_rechteck(kontext, z, r["x"] + 1, py, r["b"] - 2, zh, wahr)
                wenn t.enthält("auswahl_text"):
                    _uim_farbe(kontext, z, t["auswahl_text"])
                sonst:
                    _uim_farbe(kontext, z, t["hintergrund"])
            sonst:
                _uim_farbe(kontext, z, t["text"])
            _uim_zf_text(kontext, z, r["x"] + t["abstand"], py + (zh - t["schrift"]) / 2, p["text"], t["schrift"])
            setze py auf py + zh
        setze i auf i + 1
    gib_zurück wahr

funktion _uim_z_combo_overlay(kontext, z):
    wenn kontext.enthält("combo_offen") == falsch:
        gib_zurück wahr
    setze w auf kontext["combo_offen"]
    wenn w == nichts:
        gib_zurück wahr
    setze cr auf kontext["combo_rect"]
    wenn cr == nichts:
        gib_zurück wahr
    setze t auf kontext["theme"]
    setze zh auf _uim_zeilenhoehe(kontext)
    _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck(kontext, z, cr["x"], cr["y"], cr["b"], cr["h"], wahr)
    wenn _uim_glass_an(t):
        _uim_farbe(kontext, z, [20, 32, 52, 200])
        _uim_zf_rechteck(kontext, z, cr["x"], cr["y"], cr["b"], cr["h"], wahr)
        _uim_glass_deko(kontext, z, cr["x"], cr["y"], cr["b"], cr["h"], 2)
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, cr["x"], cr["y"], cr["b"], cr["h"], falsch)
    setze i auf 0
    setze n auf länge(w["zeilen"])
    solange i < n:
        setze zy auf cr["y"] + i * zh
        wenn i == w["auswahl"]:
            _uim_farbe(kontext, z, t["akzent"])
            _uim_zf_rechteck(kontext, z, cr["x"] + 1, zy, cr["b"] - 2, zh, wahr)
        wenn i == w["auswahl"] und t.enthält("auswahl_text"):
            _uim_farbe(kontext, z, t["auswahl_text"])
        sonst:
            _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, cr["x"] + 6, zy + (zh - t["schrift"]) / 2, w["zeilen"][i], t["schrift"])
        setze i auf i + 1
    gib_zurück wahr

funktion _uim_kinder_z_sortiert(kinder):
    setze sortiert auf []
    setze genutzt auf []
    für kind in kinder:
        genutzt.hinzufügen(falsch)
    solange länge(sortiert) < länge(kinder):
        setze bester auf 0 - 1
        setze i auf 0
        solange i < länge(kinder):
            wenn genutzt[i] == falsch:
                wenn bester < 0 oder kinder[i]["z_index"] < kinder[bester]["z_index"]:
                    setze bester auf i
            setze i auf i + 1
        wenn bester >= 0:
            sortiert.hinzufügen(kinder[bester])
            genutzt[bester] = wahr
    gib_zurück sortiert

funktion _uim_zeichne_kinder(kontext, z, parent, ox, oy, inhalt_y):
    setze ax auf ox + parent["x"]
    setze ay auf oy + parent["y"] + inhalt_y
    setze clip_an auf _uim_clip_kinder_aktiv(parent)
    wenn clip_an:
        wenn _uim_zf_clip_setze(kontext, z, ax, ay, parent["b"], parent["h"] - inhalt_y) == falsch:
            gib_zurück falsch
    setze ok auf wahr
    für kind in _uim_kinder_z_sortiert(parent["kinder"]):
        setze ok auf _uim_zeichne_widget(kontext, z, kind, ax, ay) und ok
    wenn clip_an:
        setze ok auf _uim_zf_clip_loesche(kontext, z) und ok
    gib_zurück ok

funktion _uim_zeichne_widget(kontext, z, w, ox, oy):
    wenn w["sichtbar"] == falsch:
        gib_zurück wahr
    wenn w["typ"] == "tabs":
        setze ok auf _uim_z_tabs(kontext, z, w, ox, oy)
        wenn länge(w["kinder"]) > 0:
            setze tab auf w["kinder"][w["auswahl"]]
            setze ok auf _uim_zeichne_kinder(kontext, z, tab, ox + w["x"], oy + w["y"] + w["tab_h"], 0) und ok
        gib_zurück ok
    wenn w["typ"] == "expander":
        setze t auf kontext["theme"]
        setze ax auf ox + w["x"]
        setze ay auf oy + w["y"]
        _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
        _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["kauff_h"], t["radius"], wahr)
        _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, ax + t["abstand"], ay + (w["kauff_h"] - t["schrift"]) / 2, w["text"], t["schrift"])
        setze ok auf wahr
        wenn w["offen"]:
            setze ok auf _uim_zeichne_kinder(kontext, z, w, ox, oy, w["kauff_h"]) and ok
        gib_zurück ok
    wenn w["typ"] == "toolbar":
        setze ok auf _uim_z_werkzeugleiste(kontext, z, w, ox, oy)
        gib_zurück _uim_zeichne_kinder(kontext, z, w, ox, oy, 0) and ok
        gib_zurück ok
    wenn w["typ"] == "statusleiste":
        gib_zurück _uim_z_statusleiste(kontext, z, w, ox, oy)
    wenn w["typ"] == "teiler":
        _uim_teiler_layout(w)
        setze ok auf _uim_z_teiler(kontext, z, w, ox, oy)
        gib_zurück _uim_zeichne_kinder(kontext, z, w, ox, oy, 0) and ok
        gib_zurück ok
    wenn w["typ"] == "karte":
        setze ok auf _uim_z_karte(kontext, z, w, ox, oy)
        gib_zurück _uim_zeichne_kinder(kontext, z, w, ox, oy, w["titel_h"]) und ok
    wenn w["typ"] == "stapel" oder w["typ"] == "gitter":
        gib_zurück _uim_zeichne_kinder(kontext, z, w, ox, oy, 0)
    wenn w["typ"] == "ueberlagerung":
        wenn w["offen"] == falsch:
            gib_zurück wahr
        _uim_ueberlagerung_layout(w)
        setze ok auf _uim_z_ueberlagerung(kontext, z, w, ox, oy)
        gib_zurück _uim_zeichne_kinder(kontext, z, w, ox, oy, 0) and ok
        gib_zurück ok
    wenn w["typ"] == "kontextmenue":
        gib_zurück wahr
    wenn w["typ"] == "panel":
        setze ok auf _uim_z_panel(kontext, z, w, ox, oy)
        gib_zurück _uim_zeichne_kinder(kontext, z, w, ox, oy, 0) und ok
    wenn w["typ"] == "scroll":
        setze offen auf _uim_z_scroll_rahmen(kontext, z, w, ox, oy)
        wenn offen == falsch:
            gib_zurück falsch
        setze ok auf wahr
        für k in _uim_kinder_z_sortiert(w["kinder"]):
            setze ok auf _uim_zeichne_widget(kontext, z, k, ox + w["x"], oy + w["y"] - w["scroll_y"]) und ok
        setze ok auf _uim_z_scroll_leiste(kontext, z, w, ox, oy) und ok
        gib_zurück ok
    wenn w["typ"] == "knopf":
        gib_zurück _uim_z_knopf(kontext, z, w, ox, oy)
    wenn w["typ"] == "label":
        gib_zurück _uim_z_label(kontext, z, w, ox, oy)
    wenn w["typ"] == "spinner":
        gib_zurück _uim_z_spinner(kontext, z, w, ox, oy)
    wenn w["typ"] == "statusansicht":
        gib_zurück _uim_z_statusansicht(kontext, z, w, ox, oy)
    wenn w["typ"] == "rating":
        gib_zurück _uim_z_bewertung(kontext, z, w, ox, oy)
    wenn w["typ"] == "switch":
        gib_zurück _uim_z_schalter(kontext, z, w, ox, oy)
    wenn w["typ"] == "toggle":
        gib_zurück _uim_z_toggle(kontext, z, w, ox, oy)
    wenn w["typ"] == "radio":
        gib_zurück _uim_z_radio(kontext, z, w, ox, oy)
    wenn w["typ"] == "checkbox":
        gib_zurück _uim_z_checkbox(kontext, z, w, ox, oy)
    wenn w["typ"] == "slider":
        gib_zurück _uim_z_slider(kontext, z, w, ox, oy)
    wenn w["typ"] == "fortschritt":
        gib_zurück _uim_z_fortschritt(kontext, z, w, ox, oy)
    wenn w["typ"] == "liste":
        gib_zurück _uim_z_liste(kontext, z, w, ox, oy)
    wenn w["typ"] == "baum":
        gib_zurück _uim_z_baum(kontext, z, w, ox, oy)
    wenn w["typ"] == "datengitter":
        gib_zurück _uim_z_datengitter(kontext, z, w, ox, oy)
    wenn w["typ"] == "iconview":
        gib_zurück _uim_z_iconview(kontext, z, w, ox, oy)
    wenn w["typ"] == "colorpicker":
        gib_zurück _uim_z_colorpicker(kontext, z, w, ox, oy)
    wenn w["typ"] == "calendar":
        gib_zurück _uim_z_kalender(kontext, z, w, ox, oy)
    wenn w["typ"] == "datepicker":
        gib_zurück _uim_z_datepicker(kontext, z, w, ox, oy)
    wenn w["typ"] == "linechart":
        gib_zurück _uim_z_linechart(kontext, z, w, ox, oy)
    wenn w["typ"] == "barchart":
        gib_zurück _uim_z_barchart(kontext, z, w, ox, oy)
    wenn w["typ"] == "piechart":
        gib_zurück _uim_z_piechart(kontext, z, w, ox, oy)
    wenn w["typ"] == "gauge":
        gib_zurück _uim_z_gauge(kontext, z, w, ox, oy)
    wenn w["typ"] == "terminal":
        gib_zurück _uim_z_terminal(kontext, z, w, ox, oy)
    wenn w["typ"] == "markdown":
        gib_zurück _uim_z_markdown(kontext, z, w, ox, oy)
    wenn w["typ"] == "separator":
        gib_zurück _uim_z_separator(kontext, z, w, ox, oy)
    wenn w["typ"] == "multiline":
        gib_zurück _uim_z_multiline(kontext, z, w, ox, oy)
    wenn w["typ"] == "textfeld" oder w["typ"] == "searchbox" oder w["typ"] == "numberbox" oder w["typ"] == "passwordbox" oder w["typ"] == "autocomplete":
        gib_zurück _uim_z_textfeld(kontext, z, w, ox, oy)
    wenn w["typ"] == "image":
        gib_zurück _uim_z_image(kontext, z, w, ox, oy)
    wenn w["typ"] == "icon":
        gib_zurück _uim_z_icon(kontext, z, w, ox, oy)
    wenn w["typ"] == "badge":
        gib_zurück _uim_z_badge(kontext, z, w, ox, oy)
    wenn w["typ"] == "avatar":
        gib_zurück _uim_z_avatar(kontext, z, w, ox, oy)
    wenn w["typ"] == "combobox":
        gib_zurück _uim_z_combobox(kontext, z, w, ox, oy)
    wenn w["typ"] == "menueleiste":
        gib_zurück _uim_z_menueleiste(kontext, z, w, ox, oy)
    wenn w["typ"] == "eigen":
        wenn w.enthält("on_zeichne") == falsch:
            gib_zurück falsch
        setze on_zeichne auf w["on_zeichne"]
        wenn on_zeichne == nichts:
            gib_zurück falsch
        gib_zurück on_zeichne(kontext, w, ox + w["x"], oy + w["y"])
    gib_zurück falsch

funktion _uim_kern_zeichne(kontext, z):
    wenn kontext.enthält("wurzel") == falsch:
        gib_zurück falsch
    wenn kontext.enthält("backend_vertrag") == falsch:
        gib_zurück falsch
    setze wurzel auf kontext["wurzel"]
    wenn wurzel == nichts:
        gib_zurück falsch
    wenn kontext["backend_vertrag"] == nichts:
        gib_zurück falsch
    setze t auf kontext["theme"]
    wenn kontext["hintergrund_zeichnen"]:
        _uim_farbe(kontext, z, t["hintergrund"])
        _uim_zf_rechteck(kontext, z, 0, 0, wurzel["b"], wurzel["h"], wahr)
    setze ok auf wahr
    wenn kontext.enthält("combo_offen"):
        wenn kontext["combo_offen"] != nichts:
            setze co auf kontext["combo_offen"]
            wenn co["offen"] == falsch:
                kontext["combo_offen"] = nichts
    für w in _uim_kinder_z_sortiert(wurzel["kinder"]):
        setze ok auf _uim_zeichne_widget(kontext, z, w, 0, 0) und ok
    setze ok auf _uim_z_combo_overlay(kontext, z) und ok
    setze ok auf _uim_z_menue_overlay(kontext, z) und ok
    setze ok auf _uim_z_kontext_overlay(kontext, z) und ok
    setze ok auf _uim_z_tooltip(kontext, z) und ok
    gib_zurück ok


# Generischer Kontext und normalisierte Eingabe fuer beliebige Backends.
funktion uim_backend_wurzel(backend, b, h):
    wenn backend == nichts:
        gib_zurück nichts
    setze kontext auf {}
    kontext["leinwand"] = nichts
    kontext["fenster"] = nichts
    kontext["backend"] = backend["name"]
    kontext["backend_vertrag"] = backend
    kontext["backend_zustand"] = {}
    kontext["_win"] = nichts
    kontext["_farbe"] = [0, 0, 0, 255]
    kontext["hintergrund_zeichnen"] = wahr
    kontext["theme"] = uim_theme_dunkel()
    kontext["modal_overlay"] = nichts
    kontext["fokus_vor_overlay"] = nichts
    kontext["hover"] = nichts
    kontext["druck"] = nichts
    kontext["druck_ox"] = 0
    kontext["druck_oy"] = 0
    kontext["druck_art"] = ""
    kontext["druck_greif_y"] = 0
    kontext["drag_quelle"] = nichts
    kontext["drag_aktiv"] = falsch
    kontext["clipboard_text"] = ""
    kontext["fenster_x"] = 0
    kontext["fenster_y"] = 0
    kontext["fenster_b"] = b
    kontext["fenster_h"] = h
    kontext["fenster_modus"] = "normal"
    kontext["fokus"] = nichts
    kontext["hat_fokus"] = wahr
    kontext["_maus_war"] = falsch
    kontext["_maus_taste"] = 1
    kontext["_maus_blockiert_bis_los"] = falsch
    kontext["kontext_offen"] = nichts
    kontext["kontext_hover"] = 0 - 1
    kontext["kontext_rect"] = nichts
    kontext["tooltip_widget"] = nichts
    kontext["tooltip_ticks"] = 0
    kontext["tooltip_x"] = 0
    kontext["tooltip_y"] = 0
    kontext["wurzel"] = _uim_basis("wurzel", 0, 0, b, h)
    gib_zurück kontext

funktion uim_backend_zeichne(kontext, zeichner):
    gib_zurück _uim_kern_zeichne(kontext, zeichner)

funktion uim_backend_maus_taste(kontext, x, y, taste, gedrueckt):
    wenn taste != 1 und taste != 3:
        gib_zurück falsch
    wenn kontext["_maus_blockiert_bis_los"]:
        wenn gedrueckt == falsch:
            kontext["_maus_blockiert_bis_los"] = falsch
        gib_zurück falsch
    wenn kontext["hat_fokus"] == falsch:
        gib_zurück falsch
    setze war auf kontext["_maus_war"]
    wenn gedrueckt und war == falsch:
        kontext["_maus_war"] = wahr
        kontext["_maus_taste"] = taste
        gib_zurück _uim_kern_maus(kontext, x, y, taste)
    wenn gedrueckt == falsch und war:
        kontext["_maus_war"] = falsch
        gib_zurück _uim_kern_maus_los(kontext, x, y, kontext["_maus_taste"])
    gib_zurück _uim_kern_bewegung(kontext, x, y)

funktion uim_backend_maus(kontext, x, y, gedrueckt):
    gib_zurück uim_backend_maus_taste(kontext, x, y, 1, gedrueckt)

funktion uim_backend_bewegung(kontext, x, y):
    wenn kontext["hat_fokus"] == falsch:
        gib_zurück falsch
    gib_zurück _uim_kern_bewegung(kontext, x, y)

funktion uim_backend_taste(kontext, taste, gedrueckt, mod):
    wenn kontext["hat_fokus"] == falsch:
        gib_zurück falsch
    gib_zurück _uim_kern_taste(kontext, taste, gedrueckt, mod)

funktion uim_backend_rad(kontext, x, y, delta):
    wenn kontext["hat_fokus"] == falsch:
        gib_zurück falsch
    gib_zurück _uim_kern_rad(kontext, x, y, delta)

funktion uim_backend_fokus(kontext, hat_fokus):
    kontext["hat_fokus"] = hat_fokus
    wenn hat_fokus == falsch:
        wenn kontext["_maus_war"]:
            kontext["_maus_blockiert_bis_los"] = wahr
        _uim_druck_loesche(kontext)
        setze h auf kontext["hover"]
        wenn h != nichts:
            h["hover"] = falsch
        kontext["hover"] = nichts
        kontext["_maus_war"] = falsch
    _uim_anfordern(kontext)
    gib_zurück wahr

# ------------------------------------------------------------
# Öffentliche API
# ------------------------------------------------------------

# Ein minimales Repaint-Token enthaelt nur Backend-/Hostreferenzen und niemals
# Wurzel oder Widget. Dadurch koennen alte Setter invalidieren, ohne einen
# Refcount-Zyklus Kontext -> Widget -> Kontext zu erzeugen.
funktion _uim_repaint_token_neu(kontext):
    setze token auf {}
    token["backend_vertrag"] = kontext["backend_vertrag"]
    wenn kontext.enthält("backend_zustand"):
        token["backend_zustand"] = kontext["backend_zustand"]
    wenn kontext.enthält("leinwand"):
        token["leinwand"] = kontext["leinwand"]
    wenn kontext.enthält("_win"):
        token["_win"] = kontext["_win"]
    gib_zurück token

funktion _uim_repaint_verknuepfe_rek(w, token):
    w["_repaint_token"] = token
    für kind in w["kinder"]:
        _uim_repaint_verknuepfe_rek(kind, token)
    gib_zurück wahr

funktion _uim_widget_anfordern(w):
    wenn w == nichts oder w.enthält("_repaint_token") == falsch oder w["_repaint_token"] == nichts:
        gib_zurück falsch
    gib_zurück _uim_anfordern(w["_repaint_token"])

funktion uim_hinzu(ziel, widget):
    wenn ziel.enthält("wurzel"):
        ziel["wurzel"]["kinder"].hinzufügen(widget)
        _uim_repaint_verknuepfe_rek(widget, _uim_repaint_token_neu(ziel))
        wenn widget["typ"] == "ueberlagerung":
            wenn widget["b"] <= 0:
                widget["b"] = ziel["wurzel"]["b"]
            wenn widget["h"] <= 0:
                widget["h"] = ziel["wurzel"]["h"]
            wenn widget["modal"] and widget["offen"]:
                _uim_overlay_fokus_oeffne(ziel, widget)
        _uim_anfordern(ziel)
    sonst:
        ziel["kinder"].hinzufügen(widget)
        wenn ziel.enthält("_repaint_token") und ziel["_repaint_token"] != nichts:
            _uim_repaint_verknuepfe_rek(widget, ziel["_repaint_token"])
    gib_zurück widget

# UI-13/LIFE: Fensterzustand normalisieren und persistierbar machen.
funktion uim_fenster_zustand_setze(kontext, modus, x, y, b, h):
    wenn modus != "normal" und modus != "minimiert" und modus != "maximiert" und modus != "vollbild":
        setze modus auf "normal"
    wenn x < 0:
        setze x auf 0
    wenn y < 0:
        setze y auf 0
    wenn b < 1:
        setze b auf 1
    wenn h < 1:
        setze h auf 1
    kontext["fenster_modus"] = modus
    kontext["fenster_x"] = x
    kontext["fenster_y"] = y
    kontext["fenster_b"] = b
    kontext["fenster_h"] = h
    wenn modus == "normal":
        kontext["wurzel"]["b"] = b
        kontext["wurzel"]["h"] = h
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_einstellungen_speichern(kontext):
    gib_zurück {"x": kontext["fenster_x"], "y": kontext["fenster_y"], "b": kontext["fenster_b"], "h": kontext["fenster_h"], "modus": kontext["fenster_modus"], "theme": kontext["theme"]["name"]}

funktion uim_einstellungen_laden(kontext, daten):
    wenn daten == nichts oder daten.enthält("x") == falsch oder daten.enthält("y") == falsch oder daten.enthält("b") == falsch oder daten.enthält("h") == falsch oder daten.enthält("modus") == falsch:
        gib_zurück falsch
    gib_zurück uim_fenster_zustand_setze(kontext, daten["modus"], daten["x"], daten["y"], daten["b"], daten["h"])

funktion uim_animation_start(w):
    w["animation_generation"] = w["animation_generation"] + 1
    w["animation_aktiv"] = wahr
    gib_zurück w["animation_generation"]

funktion uim_animation_abbrechen(w):
    w["animation_generation"] = w["animation_generation"] + 1
    w["animation_aktiv"] = falsch
    gib_zurück w["animation_generation"]

funktion uim_animation_gueltig(w, generation):
    gib_zurück w["animation_aktiv"] und w["animation_generation"] == generation

funktion _uim_lifecycle_referenzen_loesche(kontext, w):
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        kontext["fokus"] = nichts
    wenn _uim_slot_uid(kontext, "hover") == w["uid"]:
        kontext["hover"] = nichts
    wenn _uim_slot_uid(kontext, "druck") == w["uid"]:
        kontext["druck"] = nichts
    wenn _uim_slot_uid(kontext, "drag_quelle") == w["uid"]:
        kontext["drag_quelle"] = nichts
    wenn kontext.enthält("datepicker_feld") und _uim_slot_uid(kontext, "datepicker_feld") == w["uid"]:
        wenn kontext.enthält("datepicker_overlay") and kontext["datepicker_overlay"] != nichts and kontext["datepicker_overlay"]["offen"]:
            _uim_dialog_schliesse(kontext, kontext["datepicker_overlay"], 0 - 1)
        kontext["datepicker_feld"] = nichts
    gib_zurück wahr

funktion uim_entferne(kontext, ziel, w):
    wenn ziel == nichts oder w == nichts oder w["entfernt"]:
        gib_zurück falsch
    setze kinder auf []
    wenn ziel.enthält("wurzel"):
        setze kinder auf ziel["wurzel"]["kinder"]
    sonst:
        setze kinder auf ziel["kinder"]
    setze rest_kinder auf []
    setze gefunden auf falsch
    für kind in kinder:
        wenn kind["uid"] == w["uid"]:
            setze gefunden auf wahr
        sonst:
            rest_kinder.hinzufügen(kind)
    wenn gefunden == falsch:
        gib_zurück falsch
    wenn ziel.enthält("wurzel"):
        ziel["wurzel"]["kinder"] = rest_kinder
    sonst:
        ziel["kinder"] = rest_kinder
    _uim_lifecycle_referenzen_loesche(kontext, w)
    w["sichtbar"] = falsch
    w["aktiv"] = falsch
    w["entfernt"] = wahr
    w["animation_aktiv"] = falsch
    w["kinder"] = []
    setze cleanup_cb auf w["on_entfernt"]
    w["on_entfernt"] = nichts
    wenn cleanup_cb != nichts:
        cleanup_cb(w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_on_entfernt(w, cb):
    w["on_entfernt"] = cb
    gib_zurück w

funktion _uim_theme_farbe_v1(theme, feld):
    wenn theme.enthält(feld) == falsch:
        gib_zurück falsch
    setze farbe auf theme[feld]
    wenn typ_von(farbe) != "Liste" oder länge(farbe) != 4:
        gib_zurück falsch
    für kanal in farbe:
        wenn typ_von(kanal) != "Zahl" oder kanal < 0 oder kanal > 255:
            gib_zurück falsch
    gib_zurück wahr

funktion _uim_theme_schema_v1(theme):
    wenn typ_von(theme) != "Woerterbuch":
        gib_zurück falsch
    setze felder auf ["version", "name", "radius", "schrift", "abstand"]
    für feld in felder:
        wenn theme.enthält(feld) == falsch:
            gib_zurück falsch
    wenn theme["version"] != 1:
        gib_zurück falsch
    wenn typ_von(theme["name"]) != "Text" oder theme["name"] == "":
        gib_zurück falsch
    wenn typ_von(theme["radius"]) != "Zahl" oder theme["radius"] < 0:
        gib_zurück falsch
    wenn typ_von(theme["schrift"]) != "Zahl" oder theme["schrift"] <= 0:
        gib_zurück falsch
    wenn typ_von(theme["abstand"]) != "Zahl" oder theme["abstand"] < 0:
        gib_zurück falsch
    setze farben auf ["hintergrund", "flaeche", "flaeche_hover", "flaeche_druck", "rand", "akzent", "text", "text_gedimmt"]
    für farbfeld in farben:
        wenn _uim_theme_farbe_v1(theme, farbfeld) == falsch:
            gib_zurück falsch
    setze zustandsfarben auf ["flaeche_deaktiviert", "flaeche_auswahl", "flaeche_fehler", "flaeche_laden", "rand_deaktiviert", "rand_auswahl", "rand_fehler", "rand_hover", "rand_druck", "rand_fokus", "text_fehler", "text_laden"]
    für farbfeld in zustandsfarben:
        wenn theme.enthält(farbfeld) und _uim_theme_farbe_v1(theme, farbfeld) == falsch:
            gib_zurück falsch
    gib_zurück wahr

funktion uim_theme_setze(kontext, theme):
    wenn _uim_theme_schema_v1(theme) == falsch:
        gib_zurück falsch
    kontext["theme"] = theme
    _uim_scroll_klemme_rek(kontext, kontext["wurzel"]["kinder"])
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_groesse_setze(kontext, b, h):
    wenn b < 0:
        setze b auf 0
    wenn h < 0:
        setze h auf 0
    setze wurzel auf kontext["wurzel"]
    wurzel["b"] = b
    wurzel["h"] = h
    _uim_scroll_klemme_rek(kontext, wurzel["kinder"])
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_neuzeichnen(kontext):
    _uim_anfordern(kontext)
    gib_zurück wahr

# W6/API1: ein Wertvertrag fuer alle interaktiven Wert-Widgetfamilien.
funktion _uim_wert_typ_text(typ):
    gib_zurück typ == "textfeld" oder typ == "searchbox" oder typ == "numberbox" oder typ == "passwordbox" oder typ == "multiline" oder typ == "autocomplete"

funktion _uim_wert_typ_bool(typ):
    gib_zurück typ == "switch" oder typ == "toggle" oder typ == "radio" oder typ == "checkbox"

funktion _uim_wert_typ_zahl(typ):
    gib_zurück typ == "slider" oder typ == "fortschritt" oder typ == "spinner" oder typ == "rating" oder typ == "gauge"

funktion _uim_wert_typ_auswahl(typ):
    gib_zurück typ == "combobox" oder typ == "liste" oder typ == "baum" oder typ == "datengitter" oder typ == "iconview" oder typ == "colorpicker" oder typ == "calendar" oder typ == "datepicker" oder typ == "linechart" oder typ == "barchart" oder typ == "piechart" oder typ == "tabs"

funktion _uim_wert_auswahl_max(w):
    setze typ auf w["typ"]
    wenn typ == "combobox" oder typ == "liste" oder typ == "datengitter":
        gib_zurück länge(w["zeilen"]) - 1
    wenn typ == "baum":
        gib_zurück länge(_uim_baum_sichtbare(w)) - 1
    wenn typ == "iconview":
        gib_zurück länge(w["eintraege"]) - 1
    wenn typ == "colorpicker":
        gib_zurück länge(w["farben"]) - 1
    wenn typ == "calendar" oder typ == "datepicker":
        gib_zurück w["tage"]
    wenn typ == "linechart" oder typ == "barchart" oder typ == "piechart":
        gib_zurück länge(w["werte"]) - 1
    wenn typ == "tabs":
        gib_zurück länge(w["kinder"]) - 1
    gib_zurück 0 - 1

funktion uim_wert_hole(w):
    wenn w == nichts:
        gib_zurück nichts
    setze typ auf w["typ"]
    wenn typ == "calendar" oder typ == "datepicker":
        gib_zurück _uim_kalender_auswahlwert(w)
    wenn _uim_wert_typ_text(typ):
        gib_zurück w["text"]
    wenn _uim_wert_typ_bool(typ) oder _uim_wert_typ_zahl(typ):
        gib_zurück w["wert"]
    wenn _uim_wert_typ_auswahl(typ):
        gib_zurück w["auswahl"]
    wenn typ == "expander" oder typ == "ueberlagerung":
        gib_zurück w["offen"]
    wenn typ == "teiler":
        gib_zurück w["anteil"]
    wenn typ == "terminal":
        gib_zurück w["eingabe"]
    wenn typ == "markdown":
        gib_zurück w["inhalt"]
    gib_zurück nichts

funktion uim_wert_setze(kontext, w, wert):
    wenn kontext == nichts oder w == nichts:
        gib_zurück falsch
    setze typ auf w["typ"]
    wenn typ == "calendar" oder typ == "datepicker":
        gib_zurück _uim_kalender_wert_setze(kontext, w, wert)
    wenn _uim_wert_typ_text(typ):
        gib_zurück uim_textfeld_setze(kontext, w, text(wert))
    wenn typ == "fortschritt":
        gib_zurück uim_fortschritt_setze(kontext, w, wert)
    wenn typ == "slider":
        gib_zurück uim_slider_setze(kontext, w, wert)
    wenn typ == "spinner":
        w["wert"] = wert % 8
        wenn w["wert"] < 0:
            w["wert"] = w["wert"] + 8
    sonst wenn typ == "rating" oder typ == "gauge":
        wenn wert < w["min"]:
            setze wert auf w["min"]
        wenn wert > w["max"]:
            setze wert auf w["max"]
        w["wert"] = wert
        w["selected"] = wert > w["min"]
    sonst wenn _uim_wert_typ_bool(typ):
        wenn typ == "radio" und wert:
            _uim_radio_gruppe_rek(kontext["wurzel"]["kinder"], w["gruppe"], w["uid"])
        w["wert"] = wert
        w["selected"] = wert
    sonst wenn _uim_wert_typ_auswahl(typ):
        setze minimum auf 0 - 1
        wenn typ == "combobox" oder typ == "tabs":
            setze minimum auf 0
        wenn typ == "calendar" oder typ == "datepicker":
            setze minimum auf 1
        setze maximum auf _uim_wert_auswahl_max(w)
        wenn maximum < minimum:
            setze wert auf maximum
        sonst:
            wenn wert < minimum:
                setze wert auf minimum
            wenn wert > maximum:
                setze wert auf maximum
        w["auswahl"] = wert
        w["selected"] = wert >= minimum
    sonst wenn typ == "expander":
        w["offen"] = wert
    sonst wenn typ == "teiler":
        wenn wert < 0.05:
            setze wert auf 0.05
        wenn wert > 0.95:
            setze wert auf 0.95
        w["anteil"] = wert
        _uim_teiler_layout(w)
    sonst wenn typ == "ueberlagerung":
        gib_zurück uim_ueberlagerung_setze(kontext, w, wert, w["schliesst_aussen"])
    sonst wenn typ == "terminal":
        w["eingabe"] = text(wert)
        w["text"] = w["eingabe"]
        w["cursor"] = länge(bytes_zu_liste(w["eingabe"]))
    sonst wenn typ == "markdown":
        gib_zurück uim_markdown_setze(kontext, w, text(wert))
    sonst:
        gib_zurück falsch
    _uim_bind_widget_zu_state(w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_finde(kontext, id):
    gib_zurück _uim_finde_rek(kontext["wurzel"]["kinder"], id)

funktion uim_zustand_setze(kontext, w, zustand):
    wenn w == nichts oder _uim_zustand_gueltig(zustand) == falsch:
        gib_zurück falsch
    wenn w["zustand"] != zustand und w["animation_aktiv"]:
        uim_animation_abbrechen(w)
    w["zustand"] = zustand
    w["disabled"] = zustand == "disabled"
    w["selected"] = zustand == "selected"
    w["error"] = zustand == "error"
    w["loading"] = zustand == "loading"
    w["invalid"] = zustand == "error"
    wenn zustand == "hover":
        w["hover"] = wahr
    sonst wenn zustand == "pressed":
        w["druck"] = wahr
    sonst wenn zustand == "focused":
        kontext["fokus"] = w
    sonst wenn zustand == "normal":
        w["hover"] = falsch
        w["druck"] = falsch
        wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
            kontext["fokus"] = nichts
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_zustand_hole(kontext, w):
    gib_zurück _uim_zustand_aktuell(kontext, w)

funktion uim_eingabe_zustand_setze(kontext, w, zustand):
    wenn w == nichts oder _uim_eingabe_zustand_gueltig(zustand) == falsch:
        gib_zurück falsch
    w["eingabe_zustand"] = zustand
    w["readonly"] = zustand == "readonly"
    w["invalid"] = zustand == "invalid"
    wenn zustand == "invalid":
        w["error"] = wahr
    sonst wenn w["zustand"] == "error":
        w["error"] = wahr
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_eingabe_zustand_hole(w):
    wenn w == nichts oder w.enthält("eingabe_zustand") == falsch:
        gib_zurück "empty"
    gib_zurück w["eingabe_zustand"]

# ------------------------------------------------------------
# Referenz-Widgets (voller Satz folgt in UIMOO-3)
# ------------------------------------------------------------

funktion uim_widget_eigen(x, y, b, h, on_zeichne):
    wenn on_zeichne == nichts:
        gib_zurück nichts
    setze w auf _uim_basis("eigen", x, y, b, h)
    w["on_zeichne"] = on_zeichne
    gib_zurück w

funktion uim_knopf(beschriftung, x, y, b, h, on_klick):
    setze w auf _uim_basis("knopf", x, y, b, h)
    w["text"] = beschriftung
    w["fokussierbar"] = wahr
    w["on_klick"] = on_klick
    gib_zurück w

# Geschuetzter Knopf: waehrend des synchronen Callbacks deaktiviert und
# damit auch gegen reentrante Doppelklicks gesichert. Fuer laengere Aktionen
# koennen start/ende explizit auf jedem Knopf verwendet werden.
funktion uim_knopf_geschuetzt(beschriftung, x, y, b, h, on_klick):
    setze w auf uim_knopf(beschriftung, x, y, b, h, on_klick)
    w["auto_sperre"] = wahr
    w["aktion_laeuft"] = falsch
    gib_zurück w

funktion uim_knopf_aktion_start(w):
    wenn w == nichts oder w["typ"] != "knopf":
        gib_zurück falsch
    wenn w.enthält("aktion_laeuft") und w["aktion_laeuft"]:
        gib_zurück falsch
    w["aktion_laeuft"] = wahr
    w["disabled"] = wahr
    w["zustand"] = "disabled"
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_knopf_aktion_ende(w):
    wenn w == nichts oder w["typ"] != "knopf":
        gib_zurück falsch
    w["aktion_laeuft"] = falsch
    w["disabled"] = falsch
    w["zustand"] = "normal"
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_statusansicht(x, y, b, h, zustand, titel, beschreibung, on_retry):
    setze w auf _uim_basis("statusansicht", x, y, b, h)
    w["status_modus"] = zustand
    wenn zustand != "leer" und zustand != "fehler" und zustand != "laden" und zustand != "skelett":
        w["status_modus"] = "leer"
    w["status_titel"] = titel
    w["status_text"] = beschreibung
    w["on_klick"] = on_retry
    w["fokussierbar"] = on_retry != nichts
    w["phase"] = 0
    w["skelett_zeilen"] = 3
    w["error"] = w["status_modus"] == "fehler"
    w["loading"] = w["status_modus"] == "laden" oder w["status_modus"] == "skelett"
    gib_zurück w

funktion uim_status_setze(w, zustand, titel, beschreibung):
    wenn w == nichts oder w["typ"] != "statusansicht":
        gib_zurück falsch
    w["status_modus"] = zustand
    w["status_titel"] = titel
    w["status_text"] = beschreibung
    w["error"] = zustand == "fehler"
    w["loading"] = zustand == "laden" oder zustand == "skelett"
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_leerzustand(x, y, b, h, titel, beschreibung):
    gib_zurück uim_statusansicht(x, y, b, h, "leer", titel, beschreibung, nichts)

funktion uim_fehlerzustand(x, y, b, h, titel, beschreibung, on_retry):
    gib_zurück uim_statusansicht(x, y, b, h, "fehler", titel, beschreibung, on_retry)

funktion uim_ladezustand(x, y, b, h, titel, beschreibung):
    gib_zurück uim_statusansicht(x, y, b, h, "laden", titel, beschreibung, nichts)

funktion uim_skelett(x, y, b, h, zeilen):
    setze w auf uim_statusansicht(x, y, b, h, "skelett", "", "", nichts)
    wenn zeilen > 0:
        w["skelett_zeilen"] = zeilen
    gib_zurück w

funktion uim_spinner(x, y, b, h):
    setze w auf _uim_basis("spinner", x, y, b, h)
    w["wert"] = 0
    w["max"] = 8
    gib_zurück w

funktion uim_spinner_phase_setze(w, phase):
    wenn w == nichts:
        gib_zurück falsch
    w["wert"] = phase % 8
    wenn w["wert"] < 0:
        w["wert"] = w["wert"] + 8
    _uim_widget_anfordern(w)
    gib_zurück wahr

funktion uim_bewertung(x, y, b, h, initial, on_wechsel):
    setze w auf _uim_basis("rating", x, y, b, h)
    w["fokussierbar"] = wahr
    w["max"] = 5
    w["wert"] = initial
    wenn w["wert"] < 0:
        w["wert"] = 0
    wenn w["wert"] > w["max"]:
        w["wert"] = w["max"]
    wenn w["wert"] > 0:
        w["selected"] = wahr
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_rating(x, y, b, h, initial, on_wechsel):
    gib_zurück uim_bewertung(x, y, b, h, initial, on_wechsel)

funktion uim_schalter(beschriftung, x, y, b, h, initial, on_wechsel):
    setze w auf _uim_basis("switch", x, y, b, h)
    w["text"] = beschriftung
    w["fokussierbar"] = wahr
    w["wert"] = initial
    w["selected"] = initial
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_umschaltknopf(beschriftung, x, y, b, h, initial, on_wechsel):
    setze w auf _uim_basis("toggle", x, y, b, h)
    w["text"] = beschriftung
    w["fokussierbar"] = wahr
    w["wert"] = initial
    w["selected"] = initial
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_switch(beschriftung, x, y, b, h, initial, on_wechsel):
    gib_zurück uim_schalter(beschriftung, x, y, b, h, initial, on_wechsel)

funktion uim_toggle(beschriftung, x, y, b, h, initial, on_wechsel):
    gib_zurück uim_umschaltknopf(beschriftung, x, y, b, h, initial, on_wechsel)

funktion uim_radio(beschriftung, x, y, b, h, gruppe, initial, on_wechsel):
    setze w auf _uim_basis("radio", x, y, b, h)
    w["text"] = beschriftung
    w["gruppe"] = gruppe
    w["fokussierbar"] = wahr
    w["wert"] = initial
    w["selected"] = initial
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_label(beschriftung, x, y, b, h):
    setze w auf _uim_basis("label", x, y, b, h)
    w["text"] = beschriftung
    w["ausrichtung"] = "links"
    gib_zurück w

# Label-Ausrichtung: "links" (Standard) | "mitte" | "rechts" (innerhalb b).
funktion uim_label_ausrichtung(w, ausrichtung):
    w["ausrichtung"] = ausrichtung
    _uim_widget_anfordern(w)
    gib_zurück w

# Checkbox: Klick oder space/Return toggelt. on_wechsel(w, wert).
funktion uim_checkbox(beschriftung, x, y, b, h, initial, on_wechsel):
    setze w auf _uim_basis("checkbox", x, y, b, h)
    w["text"] = beschriftung
    w["fokussierbar"] = wahr
    w["wert"] = initial
    w["on_wechsel"] = on_wechsel
    gib_zurück w

# Slider: Press setzt Wert, Drag zieht, Pfeiltasten in 1/20-Schritten.
# on_wechsel(w, wert) bei jeder Wertänderung.
funktion uim_slider(x, y, b, h, min, max, start, on_wechsel):
    setze w auf _uim_basis("slider", x, y, b, h)
    w["fokussierbar"] = wahr
    w["min"] = min
    w["max"] = max
    setze anfang auf start
    wenn anfang < min:
        setze anfang auf min
    wenn anfang > max:
        setze anfang auf max
    w["wert"] = anfang
    w["on_wechsel"] = on_wechsel
    gib_zurück w

# Fortschrittsbalken: wert 0..1 oder unbestimmt via uim_fortschritt_unbestimmt_setze.
funktion uim_fortschritt(x, y, b, h):
    setze w auf _uim_basis("fortschritt", x, y, b, h)
    w["wert"] = 0
    w["unbestimmt"] = falsch
    w["phase"] = 0
    gib_zurück w

funktion uim_fortschritt_setze(kontext, w, wert):
    wenn wert < 0:
        setze wert auf 0
    wenn wert > 1:
        setze wert auf 1
    w["wert"] = wert
    w["unbestimmt"] = falsch
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_fortschritt_unbestimmt_setze(kontext, w, aktiv):
    wenn w == nichts:
        gib_zurück falsch
    w["unbestimmt"] = aktiv
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_slider_setze(kontext, w, wert):
    wenn wert < w["min"]:
        setze wert auf w["min"]
    wenn wert > w["max"]:
        setze wert auf w["max"]
    w["wert"] = wert
    _uim_anfordern(kontext)
    gib_zurück wahr

# ------------------------------------------------------------
# Container (UIMOO-5). Kind-Koordinaten sind RELATIV zum Container.
# Tab-Fokus läuft in V1 nur über Top-Level-Widgets (dokumentierte
# Einschränkung); Klick-Fokus funktioniert auch in Containern.
# ------------------------------------------------------------

# Panel: Fläche + optionaler Titel + Kinder. uim_hinzu(panel, w).
funktion uim_panel(titel, x, y, b, h):
    setze w auf _uim_basis("panel", x, y, b, h)
    w["text"] = titel
    gib_zurück w

# Scrollbereich: Kinder werden am Rechteck geclippt (UIMOO-1-Scissor),
# Rad scrollt, Scrollbar rechts. inhalt_hoehe = virtuelle Gesamthöhe.
funktion uim_scroll(x, y, b, h, inhalt_hoehe):
    setze w auf _uim_basis("scroll", x, y, b, h)
    w["inhalt_hoehe"] = inhalt_hoehe
    w["scroll_y"] = 0
    gib_zurück w

# Liste: virtuelles Rendering (nur sichtbare Zeilen), Klick/Up/Down
# wählt aus, Rad scrollt. zeilen = Liste von Strings.
# on_auswahl(w, index).
funktion uim_liste(x, y, b, h, zeilen, on_auswahl):
    setze w auf _uim_basis("liste", x, y, b, h)
    w["zeilen"] = zeilen
    w["auswahl"] = 0 - 1
    w["scroll_y"] = 0
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_baum_knoten(text, kinder):
    setze k auf {}
    k["text"] = text
    k["kinder"] = kinder
    k["offen"] = falsch
    gib_zurück k

funktion uim_baum(x, y, b, h, knoten, on_auswahl):
    setze w auf _uim_basis("baum", x, y, b, h)
    w["knoten"] = knoten
    w["auswahl"] = 0 - 1
    w["scroll_y"] = 0
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_datengitter(x, y, b, h, spalten, zeilen, on_auswahl):
    setze w auf _uim_basis("datengitter", x, y, b, h)
    w["spalten"] = spalten
    w["zeilen"] = zeilen
    w["auswahl"] = 0 - 1
    w["scroll_y"] = 0
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_datengitter_zeilen_setze(kontext, w, zeilen):
    w["zeilen"] = zeilen
    w["auswahl"] = 0 - 1
    w["scroll_y"] = 0
    _uim_anfordern(kontext)
    gib_zurück wahr

# IconView: Raster-/Tile-Ansicht mit Auswahl, Fokus und virtuellem Scrollen.
# Eintrag = String oder Dict {"icon": "...", "text": "..."}.
funktion uim_iconview(x, y, b, h, eintraege, on_auswahl):
    setze w auf _uim_basis("iconview", x, y, b, h)
    w["eintraege"] = eintraege
    w["auswahl"] = 0 - 1
    w["scroll_y"] = 0
    w["tile_b"] = 76
    w["tile_h"] = 68
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

# ------------------------------------------------------------
# Menueleiste (NATIVE-UI-11): klassisches Datei/Bearbeiten-Menue.
# eintraege = Liste von uim_menue(titel, punkte);
# punkte = Liste von uim_menue_punkt(text, cb) / uim_menue_trenner().
# ------------------------------------------------------------
funktion uim_menue_punkt(text, cb):
    setze p auf {}
    p["typ"] = "punkt"
    p["text"] = text
    p["cb"] = cb
    gib_zurück p

funktion uim_menue_trenner():
    setze p auf {}
    p["typ"] = "trenner"
    p["text"] = ""
    gib_zurück p

funktion uim_menue(titel, punkte):
    setze e auf {}
    e["titel"] = titel
    e["punkte"] = punkte
    gib_zurück e

funktion uim_menueleiste(x, y, b, h, eintraege):
    setze w auf _uim_basis("menueleiste", x, y, b, h)
    w["eintraege"] = eintraege
    w["offen"] = 0 - 1
    gib_zurück w

funktion _uim_menue_titel_breite(kontext, t, eintrag):
    gib_zurück _uim_zf_text_breite(kontext, nichts, eintrag["titel"], t["schrift"]) + 2 * t["abstand"]

# Titel unter widget-lokalem lx: {idx, x0, b} oder nichts.
funktion _uim_menue_titel_bei(kontext, w, lx):
    setze t auf kontext["theme"]
    setze cx auf 0
    setze i auf 0
    solange i < länge(w["eintraege"]):
        setze tb auf _uim_menue_titel_breite(kontext, t, w["eintraege"][i])
        wenn lx >= cx und lx < cx + tb:
            setze r auf {}
            r["idx"] = i
            r["x0"] = cx
            r["b"] = tb
            gib_zurück r
        setze cx auf cx + tb
        setze i auf i + 1
    gib_zurück nichts

funktion _uim_menue_schliessen(kontext):
    wenn kontext.enthält("menue_offen") und kontext["menue_offen"] != nichts:
        setze mw auf kontext["menue_offen"]
        mw["offen"] = 0 - 1
    kontext["menue_offen"] = nichts
    kontext["menue_hover"] = 0 - 1
    gib_zurück wahr

# Toolkit-freies Mock-Framebuffer fuer Kernel-/Moo-OS- und Unit-Tests.
# Textfeld: byte-basiertes Editieren mit UTF-8-Grenzen, Cursor via
# Left/Right/Home/End, BackSpace, druckbare Zeichen + space. v1: Klick
# fokussiert (Cursor bleibt), keine Selektion, kein IME-Preedit.
funktion uim_textfeld(x, y, b, h, initial, on_wechsel):
    setze w auf _uim_basis("textfeld", x, y, b, h)
    w["fokussierbar"] = wahr
    w["text"] = initial
    wenn initial == "":
        w["eingabe_zustand"] = "empty"
    sonst:
        w["eingabe_zustand"] = "filled"
    w["cursor"] = länge(bytes_zu_liste(initial))
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_textfeld_setze(kontext, w, txt):
    wenn w["text"] != txt:
        _uim_tf_verlauf_merke(w)
    w["text"] = txt
    wenn txt == "":
        w["eingabe_zustand"] = "empty"
    sonst:
        w["eingabe_zustand"] = "filled"
    w["cursor"] = länge(bytes_zu_liste(txt))
    _uim_multiline_spalte_reset(w)
    wenn w["typ"] == "multiline":
        _uim_multiline_caret_sichtbar(kontext, w)
    wenn w["validator"] != nichts:
        uim_validiere(kontext, w)
    _uim_tf_feuere_wechsel(kontext, w)
    _uim_anfordern(kontext)
    gib_zurück wahr

# Text+-Varianten: gemeinsame bytebasierte Fokus-/Cursorlogik.
funktion uim_searchbox(x, y, b, h, placeholder, on_wechsel):
    setze w auf _uim_basis("searchbox", x, y, b, h)
    w["fokussierbar"] = wahr
    w["placeholder"] = placeholder
    w["cursor"] = 0
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_numberbox(x, y, b, h, initial, min_wert, max_wert, on_wechsel):
    setze w auf _uim_basis("numberbox", x, y, b, h)
    w["fokussierbar"] = wahr
    w["text"] = text(initial)
    w["cursor"] = länge(bytes_zu_liste(w["text"]))
    w["min"] = min_wert
    w["max"] = max_wert
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_passwordbox(x, y, b, h, initial, on_wechsel):
    setze w auf _uim_basis("passwordbox", x, y, b, h)
    w["fokussierbar"] = wahr
    w["text"] = initial
    w["cursor"] = länge(bytes_zu_liste(initial))
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_textarea(x, y, b, h, initial, on_wechsel):
    setze w auf _uim_basis("multiline", x, y, b, h)
    w["fokussierbar"] = wahr
    w["text"] = initial
    w["cursor"] = länge(bytes_zu_liste(initial))
    w["vertikal_spalte"] = 0 - 1
    w["scroll_y"] = 0
    w["inhalt_hoehe"] = 0
    w["mehrzeilig"] = wahr
    w["on_wechsel"] = on_wechsel
    gib_zurück w

funktion uim_autocomplete(x, y, b, h, initial, vorschlaege, on_wechsel):
    setze w auf _uim_basis("autocomplete", x, y, b, h)
    w["fokussierbar"] = wahr
    w["text"] = initial
    w["cursor"] = länge(bytes_zu_liste(initial))
    w["vorschlaege"] = vorschlaege
    w["auswahl"] = 0 - 1
    w["on_wechsel"] = on_wechsel
    gib_zurück w

# Anzeige-Widgets: Image/Icon/Badge/Avatar.
funktion uim_image(x, y, b, h, quelle, alt):
    setze w auf _uim_basis("image", x, y, b, h)
    w["quelle"] = quelle
    w["alt"] = alt
    w["a11y_name"] = alt
    gib_zurück w

funktion uim_icon(symbol, x, y, b, h):
