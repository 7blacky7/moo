    wenn w == nichts:
        gib_zurück nichts
    wenn kanon == "stapel" oder kanon == "gitter":
        w["_baue_layout"] = wahr
        w["_baue_richtung"] = _uim_baue_opt(optionen, "richtung", "vertikal")
        w["_baue_spalten"] = _uim_baue_opt(optionen, "spalten", 1)
        wenn optionen.enthält("b") == falsch:
            w["auto_b"] = wahr
        wenn optionen.enthält("h") == falsch:
            w["auto_h"] = wahr
    uim_optionen(w, optionen)
    wenn optionen.enthält("kinder") and typ_von(optionen["kinder"]) == "Liste" and kanon != "tabs":
        für kind in optionen["kinder"]:
            uim_kind(w, kind, nichts)
    _uim_baue_layout(w)
    gib_zurück w
