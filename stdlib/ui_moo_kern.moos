    w["symbol"] = symbol
    w["a11y_name"] = symbol
    gib_zurück w

funktion uim_badge(text, x, y, b, h):
    setze w auf _uim_basis("badge", x, y, b, h)
    w["text"] = text
    w["a11y_name"] = text
    gib_zurück w

funktion uim_avatar(kuerzel, x, y, b, h):
    setze w auf _uim_basis("avatar", x, y, b, h)
    w["kuerzel"] = kuerzel
    w["a11y_name"] = kuerzel
    gib_zurück w

# Auswahl-Widgets.
funktion uim_colorpicker(x, y, b, h, farben, on_auswahl):
    setze w auf _uim_basis("colorpicker", x, y, b, h)
    w["farben"] = farben
    w["auswahl"] = 0 - 1
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_calendar(x, y, b, h, monat, jahr, on_auswahl):
    setze w auf _uim_basis("calendar", x, y, b, h)
    w["monat"] = monat
    w["jahr"] = jahr
    w["tage"] = _uim_kalender_monatstage(monat, jahr)
    w["wochenstart"] = 1
    w["ansicht"] = "monat"
    w["heute_tag"] = 0
    w["heute_monat"] = 0
    w["heute_jahr"] = 0
    w["auswahl"] = 1
    w["auswahl_modus"] = "einzel"
    w["auswahl_datum"] = [1, monat, jahr]
    w["bereich_start"] = []
    w["bereich_ende"] = []
    w["mehrfach_auswahl"] = []
    w["min_datum"] = []
    w["max_datum"] = []
    w["gesperrte_tage"] = []
    w["wochennummern"] = falsch
    w["termine"] = []
    w["fokus_tag"] = 1
    w["fokus_monat"] = monat
    w["fokus_jahr"] = jahr
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_datepicker(x, y, b, h, monat, jahr, on_auswahl):
    setze w auf _uim_basis("datepicker", x, y, b, h)
    w["monat"] = monat
    w["jahr"] = jahr
    w["tage"] = _uim_kalender_monatstage(monat, jahr)
    w["wochenstart"] = 1
    w["ansicht"] = "monat"
    w["heute_tag"] = 0
    w["heute_monat"] = 0
    w["heute_jahr"] = 0
    w["auswahl"] = 1
    w["auswahl_modus"] = "einzel"
    w["auswahl_datum"] = [1, monat, jahr]
    w["bereich_start"] = []
    w["bereich_ende"] = []
    w["mehrfach_auswahl"] = []
    w["min_datum"] = []
    w["max_datum"] = []
    w["gesperrte_tage"] = []
    w["wochennummern"] = falsch
    w["termine"] = []
    w["fokus_tag"] = 1
    w["fokus_monat"] = monat
    w["fokus_jahr"] = jahr
    w["offen"] = falsch
    w["popup_b"] = 280
    w["popup_h"] = 260
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

# NATIVE-UI-12/W5F: Diagramme. Daten liegen deklarativ im Widget; die Zeichenpfade
# bleiben vollständig im retained-mode Moo-Kern und nutzen ausschließlich die
# zentralen Theme-/Backend-Primitiven.
funktion uim_linechart(x, y, b, h, werte, on_auswahl):
    setze w auf _uim_basis("linechart", x, y, b, h)
    w["werte"] = werte
    w["auswahl"] = 0 - 1
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_barchart(x, y, b, h, werte, on_auswahl):
    setze w auf _uim_basis("barchart", x, y, b, h)
    w["werte"] = werte
    w["auswahl"] = 0 - 1
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_piechart(x, y, b, h, werte, on_auswahl):
    setze w auf _uim_basis("piechart", x, y, b, h)
    w["werte"] = werte
    w["auswahl"] = 0 - 1
    w["on_auswahl"] = on_auswahl
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_gauge(x, y, b, h, min_wert, max_wert, wert, on_wechsel):
    setze w auf _uim_basis("gauge", x, y, b, h)
    w["min"] = min_wert
    w["max"] = max_wert
    w["wert"] = wert
    w["on_wechsel"] = on_wechsel
    w["fokussierbar"] = wahr
    wenn w["wert"] < w["min"]:
        w["wert"] = w["min"]
    wenn w["wert"] > w["max"]:
        w["wert"] = w["max"]
    gib_zurück w

# Combobox: Klick/Return/space öffnet das Dropdown (Overlay, z-oberst),
# Klick auf Zeile bzw. Up/Down wählt, Escape schließt. v1: Dropdown
# ohne eigenes Scrolling (alle Zeilen sichtbar).
funktion uim_combobox(x, y, b, h, zeilen, start, on_auswahl):
    setze w auf _uim_basis("combobox", x, y, b, h)
    w["fokussierbar"] = wahr
    w["zeilen"] = zeilen
    setze idx auf start
    wenn idx < 0:
        setze idx auf 0
    wenn idx > länge(zeilen) - 1:
        setze idx auf länge(zeilen) - 1
    w["auswahl"] = idx
    w["offen"] = falsch
    w["on_auswahl"] = on_auswahl
    gib_zurück w

funktion uim_separator(x, y, b):
    setze w auf _uim_basis("separator", x, y, b, 8)
    gib_zurück w

funktion uim_mock_wurzel(b, h):
    setze kontext auf uim_backend_wurzel(uim_backend_mock(), b, h)
    setze zustand auf kontext["backend_zustand"]
    zustand["befehle"] = []
    zustand["ungueltig"] = wahr
    gib_zurück kontext

funktion uim_mock_leeren(kontext):
    setze zustand auf kontext["backend_zustand"]
    zustand["befehle"] = []
    gib_zurück wahr

funktion uim_mock_befehle(kontext):
    setze zustand auf kontext["backend_zustand"]
    gib_zurück zustand["befehle"]

funktion uim_mock_zeichne(kontext):
    uim_mock_leeren(kontext)
    setze ok auf uim_backend_zeichne(kontext, nichts)
    setze zustand auf kontext["backend_zustand"]
    zustand["ungueltig"] = falsch
    gib_zurück ok

funktion uim_mock_maus(kontext, x, y, gedrueckt):
    gib_zurück uim_backend_maus(kontext, x, y, gedrueckt)

funktion uim_mock_bewegung(kontext, x, y):
    gib_zurück uim_backend_bewegung(kontext, x, y)

funktion uim_mock_groesse_setze(kontext, b, h):
    gib_zurück uim_groesse_setze(kontext, b, h)

funktion uim_mock_taste(kontext, taste, gedrueckt, mod):
    gib_zurück uim_backend_taste(kontext, taste, gedrueckt, mod)

funktion uim_mock_rad(kontext, x, y, delta):
    gib_zurück uim_backend_rad(kontext, x, y, delta)

funktion uim_mock_fokus(kontext, hat_fokus):
    gib_zurück uim_backend_fokus(kontext, hat_fokus)

# W2 retained-mode widgets: Tabs, Toolbar, Statusbar, ContextMenu, Tooltip, Expander.
funktion _uim_tabs_aus_x(kontext, w, lx):
    setze n auf länge(w["kinder"])
    wenn n == 0:
        gib_zurück falsch
    setze idx auf boden((lx - w["x"]) / (w["b"] / n))
    wenn idx < 0:
        setze idx auf 0
    wenn idx > n - 1:
        setze idx auf n - 1
    w["auswahl"] = idx
    w["selected"] = wahr
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_tabs(x, y, b, h, titel_liste):
    setze w auf _uim_basis("tabs", x, y, b, h)
    w["titel"] = titel_liste
    w["auswahl"] = 0
    w["tab_h"] = 28
    w["fokussierbar"] = wahr
    für titel in titel_liste:
        setze tab auf _uim_basis("tab", 0, 0, b, h - w["tab_h"])
        tab["titel"] = titel
        w["kinder"].hinzufügen(tab)
    gib_zurück w

funktion uim_tabs_auswahl_setze(kontext, w, idx):
    wenn w == nichts oder länge(w["kinder"]) == 0:
        gib_zurück falsch
    wenn idx < 0:
        setze idx auf 0
    wenn idx > länge(w["kinder"]) - 1:
        setze idx auf länge(w["kinder"]) - 1
    w["auswahl"] = idx
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_z_tabs(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    setze n auf länge(w["kinder"])
    wenn n == 0:
        gib_zurück wahr
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    setze i auf 0
    solange i < n:
        setze tb auf w["b"] / n
        setze tx auf ax + i * tb
        wenn i == w["auswahl"]:
            _uim_farbe(kontext, z, t["akzent"])
        sonst:
            _uim_farbe(kontext, z, t["flaeche"])
        _uim_zf_rechteck(kontext, z, tx, ay, tb, w["tab_h"], wahr)
        _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, tx + t["abstand"], ay + (w["tab_h"] - t["schrift"]) / 2, w["kinder"][i]["titel"], t["schrift"])
        setze i auf i + 1
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    gib_zurück wahr

funktion uim_werkzeug(text, cb):
    setze w auf {}
    w["typ"] = "punkt"
    w["text"] = text
    w["cb"] = cb
    gib_zurück w

funktion uim_werkzeug_trenner():
    setze w auf {}
    w["typ"] = "trenner"
    gib_zurück w

funktion uim_werkzeugleiste(x, y, b, h, werkzeuge):
    setze w auf _uim_basis("toolbar", x, y, b, h)
    setze cx auf 4
    für item in werkzeuge:
        wenn item["typ"] == "trenner":
            setze sep auf _uim_basis("separator", cx, 3, 8, h - 6)
            w["kinder"].hinzufügen(sep)
            setze cx auf cx + 12
        sonst:
            setze kn auf _uim_basis("knopf", cx, 2, 72, h - 4)
            kn["text"] = item["text"]
            kn["fokussierbar"] = wahr
            kn["on_klick"] = item["cb"]
            w["kinder"].hinzufügen(kn)
            setze cx auf cx + 76
    gib_zurück w

funktion _uim_z_werkzeugleiste(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    gib_zurück wahr

funktion uim_statusleiste(x, y, b, h, links, rechts):
    setze w auf _uim_basis("statusleiste", x, y, b, h)
    w["links"] = links
    w["rechts"] = rechts
    gib_zurück w

funktion _uim_z_statusleiste(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_linie(kontext, z, ax, ay, ax + w["b"], ay, 1)
    _uim_farbe(kontext, z, t["text_gedimmt"])
    _uim_zf_text(kontext, z, ax + t["abstand"], ay + (w["h"] - t["schrift"]) / 2, w["links"], t["schrift"])
    setze rb auf _uim_zf_text_breite(kontext, z, w["rechts"], t["schrift"])
    _uim_zf_text(kontext, z, ax + w["b"] - rb - t["abstand"], ay + (w["h"] - t["schrift"]) / 2, w["rechts"], t["schrift"])
    gib_zurück wahr

funktion _uim_kontextmenue_finde_rek(kinder):
    setze gefunden auf nichts
    für w in kinder:
        wenn gefunden == nichts:
            wenn w["typ"] == "kontextmenue":
                setze gefunden auf w
            sonst:
                setze gefunden auf _uim_kontextmenue_finde_rek(w["kinder"])
    gib_zurück gefunden

funktion uim_kontextmenue(punkte):
    setze w auf _uim_basis("kontextmenue", 0, 0, 0, 0)
    w["punkte"] = punkte
    w["offen"] = falsch
    w["sichtbar"] = falsch
    gib_zurück w

funktion uim_kontextmenue_schliessen(kontext):
    wenn kontext.enthält("kontext_offen") und kontext["kontext_offen"] != nichts:
        setze cm auf kontext["kontext_offen"]
        cm["offen"] = falsch
        cm["sichtbar"] = falsch
    kontext["kontext_offen"] = nichts
    kontext["kontext_hover"] = 0 - 1
    gib_zurück wahr

funktion _uim_z_kontext_overlay(kontext, z):
    wenn kontext.enthält("kontext_offen") == falsch or kontext["kontext_offen"] == nichts:
        gib_zurück wahr
    setze cm auf kontext["kontext_offen"]
    wenn cm["offen"] == falsch:
        gib_zurück wahr
    setze t auf kontext["theme"]
    setze zh auf _uim_zeilenhoehe(kontext)
    setze db auf 140
    setze dh auf 0
    für p in cm["punkte"]:
        wenn p["typ"] == "trenner":
            setze dh auf dh + boden(zh / 2)
        sonst:
            setze dh auf dh + zh
            setze pb auf _uim_zf_text_breite(kontext, z, p["text"], t["schrift"]) + 2 * t["abstand"]
            wenn pb > db:
                setze db auf pb
    setze cm["b"] auf db
    setze cm["h"] auf dh
    setze rect auf {}
    rect["x"] = cm["x"]
    rect["y"] = cm["y"]
    rect["b"] = db
    rect["h"] = dh
    kontext["kontext_rect"] = rect
    _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck(kontext, z, rect["x"], rect["y"], db, dh, wahr)
    _uim_farbe(kontext, z, t["rand"])
    _uim_zf_rechteck(kontext, z, rect["x"], rect["y"], db, dh, falsch)
    setze py auf rect["y"]
    setze i auf 0
    für p in cm["punkte"]:
        setze ph auf zh
        wenn p["typ"] == "trenner":
            setze ph auf boden(zh / 2)
            _uim_farbe(kontext, z, t["rand"])
            _uim_zf_linie(kontext, z, rect["x"] + t["abstand"], py + ph / 2, rect["x"] + db - t["abstand"], py + ph / 2, 1)
        sonst:
            wenn kontext["kontext_hover"] == i:
                _uim_farbe(kontext, z, t["akzent"])
                _uim_zf_rechteck(kontext, z, rect["x"], py, db, ph, wahr)
            _uim_farbe(kontext, z, t["text"])
            _uim_zf_text(kontext, z, rect["x"] + t["abstand"], py + (ph - t["schrift"]) / 2, p["text"], t["schrift"])
        setze py auf py + ph
        setze i auf i + 1
    gib_zurück wahr

funktion uim_tooltip(w, text):
    wenn w == nichts:
        gib_zurück nichts
    w["tooltip"] = text
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_tooltip_setze(w, text):
    gib_zurück uim_tooltip(w, text)

funktion _uim_z_tooltip(kontext, z):
    wenn kontext.enthält("tooltip_widget") == falsch or kontext["tooltip_widget"] == nichts:
        gib_zurück wahr
    setze tw auf kontext["tooltip_widget"]
    wenn tw.enthält("tooltip") == falsch or tw["tooltip"] == nichts or kontext["tooltip_ticks"] < 0.5:
        gib_zurück wahr
    setze t auf kontext["theme"]
    setze txt auf tw["tooltip"]
    setze tb auf _uim_zf_text_breite(kontext, z, txt, t["schrift"])
    setze xb auf kontext["tooltip_x"] + 12
    setze yb auf kontext["tooltip_y"] + 16
    _uim_farbe(kontext, z, [18, 28, 48, 245])
    _uim_zf_rechteck_rund(kontext, z, xb, yb, tb + 2 * t["abstand"], t["schrift"] + 2 * t["abstand"], t["radius"], wahr)
    _uim_farbe(kontext, z, t["text"])
    _uim_zf_text(kontext, z, xb + t["abstand"], yb + t["abstand"] / 2, txt, t["schrift"])
    gib_zurück wahr

funktion uim_aufklapper(titel, x, y, b, h):
    setze w auf _uim_basis("expander", x, y, b, h)
    w["text"] = titel
    w["offen"] = falsch
    w["kauff_h"] = 28
    w["fokussierbar"] = wahr
    gib_zurück w



# ------------------------------------------------------------
# NATIVE-UI-12/W3: Splitter, Card, Stack/Grid und Overlay.
# Layout ist retained-mode und positioniert nur direkte Kinder.
# ------------------------------------------------------------
funktion _uim_richtung_horizontal(richtung):
    gib_zurück richtung == "horizontal" oder richtung == "h" oder richtung == "x"

funktion _uim_teiler_layout(w):
    wenn länge(w["kinder"]) == 0:
        w["trenn_pos"] = 0
        gib_zurück wahr
    setze dicke auf w["trenner_breite"]
    setze verfuegbar auf w["b"] - dicke
    wenn verfuegbar < 0:
        setze verfuegbar auf 0
    setze p auf verfuegbar * w["anteil"]
    wenn p < w["min1"]:
        setze p auf w["min1"]
    wenn verfuegbar - p < w["min2"]:
        setze p auf verfuegbar - w["min2"]
    wenn p < 0:
        setze p auf 0
    wenn p > verfuegbar:
        setze p auf verfuegbar
    w["trenn_pos"] = p
    setze a auf w["kinder"][0]
    wenn _uim_richtung_horizontal(w["richtung"]):
        a["x"] = 0
        a["y"] = 0
        a["b"] = p
        a["h"] = w["h"]
        wenn länge(w["kinder"]) > 1:
            setze z auf w["kinder"][1]
            z["x"] = p + dicke
            z["y"] = 0
            z["b"] = verfuegbar - p
            z["h"] = w["h"]
    sonst:
        setze verfuegbar_y auf w["h"] - dicke
        wenn verfuegbar_y < 0:
            setze verfuegbar_y auf 0
        setze py auf verfuegbar_y * w["anteil"]
        wenn py < w["min1"]:
            setze py auf w["min1"]
        wenn verfuegbar_y - py < w["min2"]:
            setze py auf verfuegbar_y - w["min2"]
        wenn py < 0:
            setze py auf 0
        wenn py > verfuegbar_y:
            setze py auf verfuegbar_y
        w["trenn_pos"] = py
        a["x"] = 0
        a["y"] = 0
        a["b"] = w["b"]
        a["h"] = py
        wenn länge(w["kinder"]) > 1:
            setze z auf w["kinder"][1]
            z["x"] = 0
            z["y"] = py + dicke
            z["b"] = w["b"]
            z["h"] = verfuegbar_y - py
    gib_zurück wahr

funktion _uim_teiler_trennlinie_treffer(w, lx, ly):
    setze d auf w["trenner_breite"]
    wenn _uim_richtung_horizontal(w["richtung"]):
        gib_zurück lx >= w["trenn_pos"] und lx < w["trenn_pos"] + d
    gib_zurück ly >= w["trenn_pos"] und ly < w["trenn_pos"] + d

funktion _uim_teiler_ziehen(w, x, y):
    setze alt auf w["anteil"]
    wenn _uim_richtung_horizontal(w["richtung"]):
        setze verfuegbar auf w["b"] - w["trenner_breite"]
        wenn verfuegbar <= 0:
            gib_zurück falsch
        setze p auf x - w["x"]
        wenn p < w["min1"]:
            setze p auf w["min1"]
        wenn verfuegbar - p < w["min2"]:
            setze p auf verfuegbar - w["min2"]
        w["anteil"] = p / verfuegbar
    sonst:
        setze verfuegbar auf w["h"] - w["trenner_breite"]
        wenn verfuegbar <= 0:
            gib_zurück falsch
        setze p auf y - w["y"]
        wenn p < w["min1"]:
            setze p auf w["min1"]
        wenn verfuegbar - p < w["min2"]:
            setze p auf verfuegbar - w["min2"]
        w["anteil"] = p / verfuegbar
    _uim_teiler_layout(w)
    gib_zurück alt != w["anteil"]

funktion _uim_z_teiler(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, t["flaeche"])
    _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    _uim_farbe(kontext, z, t["rand"])
    wenn _uim_richtung_horizontal(w["richtung"]):
        _uim_zf_linie(kontext, z, ax + w["trenn_pos"] + w["trenner_breite"] / 2, ay, ax + w["trenn_pos"] + w["trenner_breite"] / 2, ay + w["h"], 2)
    sonst:
        _uim_zf_linie(kontext, z, ax, ay + w["trenn_pos"] + w["trenner_breite"] / 2, ax + w["b"], ay + w["trenn_pos"] + w["trenner_breite"] / 2, 2)
    gib_zurück wahr

funktion _uim_z_karte(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    wenn _uim_glass_an(t):
        _uim_glass_deko(kontext, z, ax, ay, w["b"], w["h"], t["radius"])
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    _uim_farbe(kontext, z, t["text"])
    _uim_zf_text(kontext, z, ax + t["abstand"] + 2, ay + (w["titel_h"] - t["schrift"]) / 2 + 1, w["text"], t["schrift"])
    gib_zurück wahr

funktion _uim_z_ueberlagerung(kontext, z, w, ox, oy):
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    wenn w["dimmen"]:
        _uim_farbe(kontext, z, [0, 0, 0, 160])
        _uim_zf_rechteck(kontext, z, ax, ay, w["b"], w["h"], wahr)
    gib_zurück wahr

funktion _uim_ueberlagerung_layout(w):
    wenn länge(w["kinder"]) == 0:
        gib_zurück wahr
    setze panel auf w["kinder"][0]
    panel["x"] = (w["b"] - panel["b"]) / 2
    wenn w.enthält("overlay_kind") und (w["overlay_kind"] == "toast" oder w["overlay_kind"] == "snackbar"):
        panel["y"] = w["h"] - panel["h"] - 16
    sonst:
        panel["y"] = (w["h"] - panel["h"]) / 2
    gib_zurück wahr

funktion uim_teiler(x, y, b, h, richtung, anteil):
    setze w auf _uim_basis("teiler", x, y, b, h)
    w["richtung"] = richtung
    w["anteil"] = anteil
    wenn w["anteil"] < 0.05:
        w["anteil"] = 0.05
    wenn w["anteil"] > 0.95:
        w["anteil"] = 0.95
    w["min1"] = 24
    w["min2"] = 24
    w["trenner_breite"] = 6
    gib_zurück w

funktion uim_teiler_min_setze(w, min1, min2):
    wenn min1 < 0:
        setze min1 auf 0
    wenn min2 < 0:
        setze min2 auf 0
    w["min1"] = min1
    w["min2"] = min2
    _uim_teiler_layout(w)
    _uim_widget_anfordern(w)
    gib_zurück w

funktion uim_karte(titel, x, y, b, h):
    setze w auf _uim_basis("karte", x, y, b, h)
    w["text"] = titel
    w["titel_h"] = 28
    gib_zurück w

funktion uim_stapel(x, y, b, h):
    gib_zurück _uim_basis("stapel", x, y, b, h)

funktion uim_gitter(x, y, b, h):
    gib_zurück _uim_basis("gitter", x, y, b, h)

funktion uim_stapel_layout(container, richtung, abstand):
    wenn abstand < 0:
        setze abstand auf 0
    container["gap"] = abstand
    setze pos auf container["padding"]
    setze quer_max auf 0
    für kind in container["kinder"]:
        _uim_layout_begrenze(kind)
        setze rand auf kind["margin"]
        wenn _uim_richtung_horizontal(richtung):
            kind["x"] = pos + rand
            kind["y"] = container["padding"] + rand
            setze pos auf pos + kind["b"] + rand * 2 + abstand
            wenn kind["h"] + rand * 2 > quer_max:
                setze quer_max auf kind["h"] + rand * 2
        sonst:
            kind["x"] = container["padding"] + rand
            kind["y"] = pos + rand
            setze pos auf pos + kind["h"] + rand * 2 + abstand
            wenn kind["b"] + rand * 2 > quer_max:
                setze quer_max auf kind["b"] + rand * 2
    wenn länge(container["kinder"]) > 0:
        setze pos auf pos - abstand
    wenn _uim_richtung_horizontal(richtung):
        wenn container["auto_b"]:
            container["b"] = pos + container["padding"]
        wenn container["auto_h"]:
            container["h"] = quer_max + container["padding"] * 2
    sonst:
        wenn container["auto_b"]:
            container["b"] = quer_max + container["padding"] * 2
        wenn container["auto_h"]:
            container["h"] = pos + container["padding"]
    gib_zurück _uim_layout_begrenze(container)

funktion uim_gitter_layout(container, spalten, abstand):
    wenn spalten < 1:
        setze spalten auf 1
    wenn abstand < 0:
        setze abstand auf 0
    container["gap"] = abstand
    setze zell_b auf 0
    setze zell_h auf 0
    für kind in container["kinder"]:
        _uim_layout_begrenze(kind)
        wenn kind["b"] + kind["margin"] * 2 > zell_b:
            setze zell_b auf kind["b"] + kind["margin"] * 2
        wenn kind["h"] + kind["margin"] * 2 > zell_h:
            setze zell_h auf kind["h"] + kind["margin"] * 2
    setze i auf 0
    für kind in container["kinder"]:
        setze sp auf i % spalten
        setze zeile auf boden(i / spalten)
        kind["x"] = container["padding"] + sp * (zell_b + abstand) + kind["margin"]
        kind["y"] = container["padding"] + zeile * (zell_h + abstand) + kind["margin"]
        setze i auf i + 1
    setze zeilen auf 0
    wenn länge(container["kinder"]) > 0:
        setze zeilen auf boden((länge(container["kinder"]) + spalten - 1) / spalten)
    wenn container["auto_b"]:
        container["b"] = container["padding"] * 2 + spalten * zell_b + (spalten - 1) * abstand
    wenn container["auto_h"]:
        container["h"] = container["padding"] * 2 + zeilen * zell_h
        wenn zeilen > 0:
            container["h"] = container["h"] + (zeilen - 1) * abstand
    gib_zurück _uim_layout_begrenze(container)

funktion uim_ueberlagerung(x, y, b, h):
    setze w auf _uim_basis("ueberlagerung", x, y, b, h)
    w["offen"] = wahr
    w["schliesst_aussen"] = wahr
    w["on_schliessen"] = nichts
    w["modal"] = wahr
    w["dimmen"] = wahr
    gib_zurück w

funktion uim_ueberlagerung_setze(kontext, w, offen, schliesst_aussen):
    wenn w == nichts:
        gib_zurück falsch
    w["offen"] = offen
    w["sichtbar"] = offen
    w["schliesst_aussen"] = schliesst_aussen
    wenn offen und w["modal"]:
        _uim_overlay_fokus_oeffne(kontext, w)
    sonst:
        _uim_overlay_fokus_schliesse(kontext, w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_overlay(x, y, b, h):
    gib_zurück uim_ueberlagerung(x, y, b, h)

# ------------------------------------------------------------
# NATIVE-UI-12/W4: Dialoge, Toast und Snackbar
# ------------------------------------------------------------

funktion _uim_dialog_erstfokus(w):
    setze ziele auf []
    _uim_fokus_uids(w["kinder"], ziele)
    wenn länge(ziele) == 0:
        gib_zurück nichts
    gib_zurück _uim_finde_uid_rek(w["kinder"], ziele[0])

# Modal-Fokus ist eine Falle innerhalb des Overlays. Beim ersten Öffnen wird
# der vorherige Fokus gemerkt und beim Schließen nur dann wiederhergestellt,
# wenn das Ziel entlang seiner Elternkette noch interaktiv ist.
funktion _uim_overlay_fokus_oeffne(kontext, w):
    wenn kontext["modal_overlay"] == nichts oder kontext["modal_overlay"]["uid"] != w["uid"]:
        kontext["fokus_vor_overlay"] = kontext["fokus"]
    kontext["modal_overlay"] = w
    setze erste_fokus auf _uim_dialog_erstfokus(w)
    kontext["fokus"] = erste_fokus
    gib_zurück wahr

funktion _uim_overlay_fokus_schliesse(kontext, w):
    wenn kontext["modal_overlay"] != nichts und kontext["modal_overlay"]["uid"] == w["uid"]:
        kontext["modal_overlay"] = nichts
        setze vorher auf kontext["fokus_vor_overlay"]
        kontext["fokus_vor_overlay"] = nichts
        wenn vorher != nichts und _uim_ist_interaktiv(kontext, vorher):
            kontext["fokus"] = vorher
        sonst:
            kontext["fokus"] = nichts
    gib_zurück wahr


funktion _uim_dialog_schliesse(kontext, w, aktion):
    wenn w == nichts:
        gib_zurück falsch
    w["offen"] = falsch
    w["sichtbar"] = falsch
    _uim_overlay_fokus_schliesse(kontext, w)
    setze kind auf ""
    wenn w.enthält("overlay_kind"):
        setze kind auf w["overlay_kind"]
    wenn kind == "datepicker":
        wenn w.enthält("datepicker_quelle") und w["datepicker_quelle"] != nichts:
            w["datepicker_quelle"]["offen"] = falsch
        wenn kontext.enthält("datepicker_feld"):
            kontext["datepicker_feld"] = nichts
    sonst wenn kind == "eingabe":
        wenn aktion < 0:
            w["abgebrochen"] = wahr
        setze cb_eingabe auf w["on_aktion"]
        wenn cb_eingabe != nichts:
            cb_eingabe(w, w["dialog_eingabe"]["text"])
    sonst wenn kind == "nachricht":
        setze cb_nachricht auf w["on_aktion"]
        wenn cb_nachricht != nichts:
            cb_nachricht(w, aktion)
    sonst:
        setze cb_schliessen auf w["on_schliessen"]
        wenn cb_schliessen != nichts:
            cb_schliessen(w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_dialog_aktion(kontext, w, index):
    wenn w == nichts oder w["offen"] == falsch:
        gib_zurück falsch
    _uim_dialog_schliesse(kontext, w, index)
    gib_zurück wahr

funktion _uim_snackbar_aktion(kontext, w):
    wenn w == nichts:
        gib_zurück falsch
    w["offen"] = falsch
    w["sichtbar"] = falsch
    setze cb_snack auf w["on_aktion"]
    wenn cb_snack != nichts:
        cb_snack(w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_dialog_button(text, x, y, b, h, dialog, index):
    setze knopf auf uim_knopf(text, x, y, b, h, nichts)
    knopf["dialog"] = dialog
    knopf["dialog_index"] = index
    gib_zurück knopf

funktion uim_nachricht(titel, text, knoepfe, cb):
    setze w auf uim_ueberlagerung(0, 0, 0, 0)
    w["overlay_kind"] = "nachricht"
    w["modal"] = wahr
    w["dimmen"] = wahr
    w["schliesst_aussen"] = falsch
    w["on_aktion"] = cb
    w["dialog_buttons"] = []
    setze panel auf uim_karte(titel, 0, 0, 360, 156)
    setze body auf uim_label(text, 16, 12, 328, 44)
    uim_hinzu(panel, body)
    setze i auf 0
    für beschriftung in knoepfe:
        setze button auf _uim_dialog_button(beschriftung, 0, 0, 92, 28, w, i)
        w["dialog_buttons"].hinzufügen(button)
        uim_hinzu(panel, button)
        setze i auf i + 1
    uim_hinzu(w, panel)
    wenn länge(w["dialog_buttons"]) > 0:
        w["standard_button"] = 0
    sonst:
        w["standard_button"] = 0 - 1
    gib_zurück w

funktion _uim_loeschen_dialog_aktion(w, index):
    wenn index != 0:
        gib_zurück wahr
    setze cb auf w["on_loeschen"]
    wenn cb != nichts:
        cb(w)
    gib_zurück wahr

# Schutzmuster: destruktive Aktion wird immer durch die vorhandene
# retained MessageBox bestaetigt; Index 0 ist bewusst die Loeschaktion.
funktion uim_loeschen_bestaetigung(titel, text, on_bestaetigt):
    setze w auf uim_nachricht(titel, text, ["Loeschen", "Abbrechen"], _uim_loeschen_dialog_aktion)
    w["on_loeschen"] = on_bestaetigt
    w["destruktiv"] = wahr
    gib_zurück w

funktion uim_eingabe_dialog(titel, prompt, initial, cb):
    setze w auf uim_ueberlagerung(0, 0, 0, 0)
    w["overlay_kind"] = "eingabe"
    w["modal"] = wahr
    w["dimmen"] = wahr
    w["schliesst_aussen"] = falsch
    w["on_aktion"] = cb
    w["abgebrochen"] = falsch
    w["dialog_buttons"] = []
    setze panel auf uim_karte(titel, 0, 0, 380, 188)
    setze frage auf uim_label(prompt, 16, 10, 348, 24)
    setze feld auf uim_textfeld(16, 40, 348, 30, initial, nichts)
    feld["dialog"] = w
    w["dialog_eingabe"] = feld
    uim_hinzu(panel, frage)
    uim_hinzu(panel, feld)
    setze ok auf _uim_dialog_button("OK", 178, 82, 84, 28, w, 0)
    setze abbrechen auf _uim_dialog_button("Abbrechen", 270, 82, 94, 28, w, 1)
    w["dialog_buttons"].hinzufügen(ok)
    w["dialog_buttons"].hinzufügen(abbrechen)
    uim_hinzu(panel, ok)
    uim_hinzu(panel, abbrechen)
    uim_hinzu(w, panel)
    w["standard_button"] = 0
    gib_zurück w

funktion uim_toast(text, dauer_ticks):
    setze w auf uim_ueberlagerung(0, 0, 0, 0)
    w["overlay_kind"] = "toast"
    w["modal"] = falsch
    w["dimmen"] = falsch
    w["schliesst_aussen"] = falsch
    w["rest_ticks"] = dauer_ticks
    wenn w["rest_ticks"] <= 0:
        w["rest_ticks"] = 1
    setze panel auf uim_panel("", 0, 0, 300, 44)
    setze label auf uim_label(text, 12, 8, 276, 24)
    uim_hinzu(panel, label)
    uim_hinzu(w, panel)
    gib_zurück w

funktion uim_snackbar(text, aktionsknopf, cb):
    setze w auf uim_ueberlagerung(0, 0, 0, 0)
    w["overlay_kind"] = "snackbar"
    w["modal"] = falsch
    w["dimmen"] = falsch
    w["schliesst_aussen"] = falsch
    w["rest_ticks"] = 6
    setze panel auf uim_panel("", 0, 0, 420, 48)
    setze label auf uim_label(text, 12, 10, 260, 24)
    uim_hinzu(panel, label)
    wenn aktionsknopf != nichts und aktionsknopf != "":
        setze button auf uim_knopf(aktionsknopf, 286, 8, 118, 28, nichts)
        button["snackbar"] = w
        uim_hinzu(panel, button)
    uim_hinzu(w, panel)
    w["on_aktion"] = cb
    gib_zurück w

# ------------------------------------------------------------
# NATIVE-UI-12/W5G: Terminal und Markdown Viewer.
# Beide Widgets bleiben reine retained-mode Moo-Zeichenpfade.
# ------------------------------------------------------------

funktion uim_terminal(x, y, b, h, initial, on_befehl):
    setze w auf _uim_basis("terminal", x, y, b, h)
    w["fokussierbar"] = wahr
    w["zeilen"] = initial.teilen("\n")
    w["eingabe"] = ""
    w["text"] = ""
    w["cursor"] = 0
    w["prompt"] = "> "
    w["history"] = []
    w["history_idx"] = -1
    w["on_befehl"] = on_befehl
    w["scroll_y"] = 0
    w["max_zeilen"] = 256
    gib_zurück w


funktion uim_terminal_ausgabe(kontext, w, ausgabe):
    wenn w == nichts:
        gib_zurück falsch
    für zeile in ausgabe.teilen("\n"):
        w["zeilen"].hinzufügen(zeile)
    wenn länge(w["zeilen"]) > w["max_zeilen"]:
        setze w["zeilen"] auf w["zeilen"].zeilen(länge(w["zeilen"]) - w["max_zeilen"], länge(w["zeilen"]))
    setze w["scroll_y"] auf _uim_scroll_max(kontext, w)
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion uim_markdown(x, y, b, h, inhalt):
    setze w auf _uim_basis("markdown", x, y, b, h)
    w["inhalt"] = inhalt
    w["zeilen"] = inhalt.teilen("\n")
    w["scroll_y"] = 0
    w["fokussierbar"] = wahr
    gib_zurück w

funktion uim_markdown_setze(kontext, w, inhalt):
    wenn w == nichts:
        gib_zurück falsch
    w["inhalt"] = inhalt
    w["zeilen"] = inhalt.teilen("\n")
    w["scroll_y"] = 0
    _uim_anfordern(kontext)
    gib_zurück wahr

funktion _uim_markdown_art(zeile):
    wenn zeile == "":
        gib_zurück 0
    wenn zeile.enthält("### "):
        gib_zurück 3
    wenn zeile.enthält("## "):
        gib_zurück 2
    wenn zeile.enthält("# "):
        gib_zurück 1
    wenn zeile.enthält("CODE:"):
        gib_zurück 4
    wenn zeile.enthält("- ") oder zeile.enthält("* "):
        gib_zurück 5
    gib_zurück 0

funktion _uim_z_terminal(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, [12, 18, 26, 255])
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    setze pad auf t["abstand"]
    setze zeilen_h auf t["schrift"] + 3
    setze max_zeilen auf boden((w["h"] - 2 * pad - zeilen_h) / zeilen_h)
    wenn max_zeilen < 1:
        setze max_zeilen auf 1
    setze start auf boden(w["scroll_y"] / zeilen_h)
    setze max_start auf länge(w["zeilen"]) - max_zeilen
    wenn max_start < 0:
        setze max_start auf 0
    wenn start > max_start:
        setze start auf max_start
    wenn start < 0:
        setze start auf 0
    _uim_zf_clip_setze(kontext, z, ax + 4, ay + pad, w["b"] - 8, w["h"] - pad - zeilen_h - 4)
    setze i auf start
    setze gezeichnet auf 0
    solange i < länge(w["zeilen"]) und gezeichnet < max_zeilen:
        _uim_farbe(kontext, z, t["text"])
        _uim_zf_text(kontext, z, ax + pad, ay + pad + gezeichnet * zeilen_h, w["zeilen"][i], t["schrift"])
        setze i auf i + 1
        setze gezeichnet auf gezeichnet + 1
    _uim_zf_clip_loesche(kontext, z)
    setze eingabe_y auf ay + w["h"] - pad - zeilen_h
    _uim_farbe(kontext, z, t["akzent"])
    _uim_zf_text(kontext, z, ax + pad, eingabe_y, w["prompt"] + w["eingabe"], t["schrift"])
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        setze links auf w["prompt"] + w["eingabe"]
        setze cx auf ax + pad + _uim_zf_text_breite(kontext, z, links, t["schrift"])
        _uim_farbe(kontext, z, t["text"])
        _uim_zf_linie(kontext, z, cx, eingabe_y - 1, cx, eingabe_y + t["schrift"] + 1, 1)
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax - 2, ay - 2, w["b"] + 4, w["h"] + 4, falsch)
    gib_zurück wahr

funktion _uim_z_markdown(kontext, z, w, ox, oy):
    setze t auf kontext["theme"]
    setze ax auf ox + w["x"]
    setze ay auf oy + w["y"]
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "flaeche"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], wahr)
    _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "rand"))
    _uim_zf_rechteck_rund(kontext, z, ax, ay, w["b"], w["h"], t["radius"], falsch)
    setze pad auf t["abstand"]
    setze zeilen_h auf t["schrift"] + 4
    setze max_zeilen auf boden((w["h"] - 2 * pad) / zeilen_h)
    wenn max_zeilen < 1:
        setze max_zeilen auf 1
    setze start auf boden(w["scroll_y"] / zeilen_h)
    setze max_start auf länge(w["zeilen"]) - max_zeilen
    wenn max_start < 0:
        setze max_start auf 0
    wenn start > max_start:
        setze start auf max_start
    wenn start < 0:
        setze start auf 0
    _uim_zf_clip_setze(kontext, z, ax + 3, ay + 2, w["b"] - 6, w["h"] - 4)
    setze i auf start
    setze gezeichnet auf 0
    solange i < länge(w["zeilen"]) und gezeichnet < max_zeilen:
        setze zeile auf w["zeilen"][i]
        setze art auf _uim_markdown_art(zeile)
        setze schrift auf t["schrift"]
        wenn art == 1:
            setze schrift auf t["schrift"] + 2
        sonst wenn art == 2:
            setze schrift auf t["schrift"] + 1
        wenn art == 4:
            # Der Codebalken folgt derselben Textbasis: 2px oberhalb bis 2px unterhalb.
            setze code_y auf ay + pad - 2 + gezeichnet * zeilen_h
            _uim_farbe(kontext, z, [24, 30, 42, 255])
            _uim_zf_rechteck(kontext, z, ax + 3, code_y, w["b"] - 6, schrift + 4, wahr)
        wenn art == 1 oder art == 2 oder art == 3:
            _uim_farbe(kontext, z, t["akzent"])
        sonst wenn art == 4:
            _uim_farbe(kontext, z, t["text"])
        sonst wenn art == 5:
            _uim_farbe(kontext, z, t["rand_fokus"])
        sonst:
            _uim_farbe(kontext, z, _uim_zustand_farbe(kontext, w, "text"))
        _uim_zf_text(kontext, z, ax + pad, ay + pad + gezeichnet * zeilen_h, zeile, schrift)
        setze i auf i + 1
        setze gezeichnet auf gezeichnet + 1
    _uim_zf_clip_loesche(kontext, z)
    wenn _uim_slot_uid(kontext, "fokus") == w["uid"]:
        _uim_farbe(kontext, z, t["akzent"])
        _uim_zf_rechteck(kontext, z, ax + 1, ay + 1, w["b"] - 2, w["h"] - 2, falsch)
    gib_zurück wahr


# --- W6-API2: zweisprachige Widget-Oberflaeche ---
