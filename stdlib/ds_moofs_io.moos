# Gemeinsame MooFS-Schreibgrenze. Besitzer serialisiert alle Aufrufe.
aus ds_moofs importiere MooFsVolume, MooFsBlock, MooFsFehler, MOOFS_MAGIE, MOOFS_VOLL, MOOFS_EA, moofs_crc
aus ds_moofs_formate importiere MooFsKopf
aus ds_fat_transport importiere FatTransport
aus nativ_block importiere BlockFehler, BLOCK_SCHREIBEN, BLOCK_FLUSH

@nativ
funktion moofs_block_vorbereiten(puffer: ptr[MooFsBlock], nr: u64, art: u32, ebene: u32, anzahl: u32, inode: u64, logisch: u64, generation: u64) -> void:
    unsicher:
        setze bytes: puffer[u8] auf byteansicht(puffer.bytes)
        setze i: u64 auf 0
        solange i < 4096:
            setze bytes[i] auf 0
            setze i auf i + 1
        setze h: puffer[MooFsKopf] auf sicht(bytes, MooFsKopf, 0)
        setze h[0].magie auf MOOFS_MAGIE
        setze h[0].art auf art
        setze h[0].ebene auf ebene
        setze h[0].block auf nr
        setze h[0].generation auf generation
        setze h[0].anzahl auf anzahl
        setze h[0].eigentuemer auf inode
        setze h[0].logisch auf logisch

@nativ
funktion moofs_block_schreiben(v: ptr[MooFsVolume], nr: u64, bytes: puffer[u8]) -> ergebnis[u32, MooFsFehler]:
    unsicher:
        wenn nr >= v.bloecke oder länge(bytes) != 4096:
            gib_zurück fehlschlag(MooFsFehler(MOOFS_VOLL, 0, nr))
        setze crc: u32 auf weitergeben(moofs_crc(bytes))
        byte_schreiben_le32(bytes, 40, crc)
        setze r: ergebnis[void, BlockFehler] auf v.transport.uebertragen(BLOCK_SCHREIBEN, nr * (4096 / v.sektor_bytes), 4096 / v.sektor_bytes, u64(puffer_zeiger(bytes)), 4096)
        wenn nicht ist_erfolg(r):
            gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, ergebnis_fehler(r).code, nr))
        gib_zurück erfolg(crc)

@nativ
funktion moofs_barriere(transport: ptr[dyn FatTransport]) -> ergebnis[void, MooFsFehler]:
    unsicher:
        setze r: ergebnis[void, BlockFehler] auf transport.uebertragen(BLOCK_FLUSH, 0, 0, 0, 0)
        wenn nicht ist_erfolg(r):
            gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, ergebnis_fehler(r).code, 0))
        gib_zurück erfolg()
