@nativ
funktion fat_unicode_gross(punkt: u32) -> u32:
    unsicher:
        setze links: u64 auf 0
        setze rechts: u64 auf 204
        solange links < rechts:
            setze mitte: u64 auf links + (rechts - links) / 2
            setze bereich: FatUnicodeBereich auf FAT_UNICODE_FALTUNG[mitte]
            wenn punkt < bereich.erster:
                setze rechts auf mitte
            sonst wenn punkt > bereich.letzter:
                setze links auf mitte + 1
            sonst:
                wenn (punkt - bereich.erster) % bereich.schritt == 0:
                    gib_zurück als(u32, als(i64, punkt) + bereich.delta)
                gib_zurück punkt
        gib_zurück punkt
