# GF(2^8), Polynom 0x11D; Koeffizienten bleiben an Mitgliedsslots gebunden.
struktur ArrayGf256:
    logarithmus: [u8; 256]
    exponent: [u8; 512]
    bereit: bool

@nativ
funktion array_gf256_mal(a: u8, b: u8) -> u8:
    setze links: u16 auf als(u16, a)
    setze rechts: u16 auf als(u16, b)
    setze produkt: u16 auf 0
    setze i: u64 auf 0
    solange i < 8:
        wenn (rechts & 1) != 0:
            setze produkt auf produkt ^ links
        setze links auf links << 1
        wenn (links & 256) != 0:
            setze links auf links ^ 0x11D
        setze rechts auf rechts >> 1
        setze i auf i + 1
    gib_zurück als(u8, produkt)

@nativ
funktion array_gf256_koeffizient(slot: u64) -> u8:
    wenn slot >= 16:
        gib_zurück 0
    konstante faktoren: [u8; 16] auf [1, 2, 4, 8, 16, 32, 64, 128, 29, 58, 116, 232, 205, 135, 19, 38]
    gib_zurück faktoren[slot]

@nativ
funktion array_gf256_invers(a: u8) -> u8:
    # 0 liefert 0; alle anderen Eintraege erfuellen a * invers(a) == 1.
    # Oeffentliche Datenkoeffizienten: kein Konstantzeitvertrag.
    konstante inverse: [u8; 256] auf [0, 1, 142, 244, 71, 167, 122, 186, 173, 157, 221, 152, 61, 170, 93, 150, 216, 114, 192, 88, 224, 62, 76, 102, 144, 222, 85, 128, 160, 131, 75, 42, 108, 237, 57, 81, 96, 86, 44, 138, 112, 208, 31, 74, 38, 139, 51, 110, 72, 137, 111, 46, 164, 195, 64, 94, 80, 34, 207, 169, 171, 12, 21, 225, 54, 95, 248, 213, 146, 78, 166, 4, 48, 136, 43, 30, 22, 103, 69, 147, 56, 35, 104, 140, 129, 26, 37, 97, 19, 193, 203, 99, 151, 14, 55, 65, 36, 87, 202, 91, 185, 196, 23, 77, 82, 141, 239, 179, 32, 236, 47, 50, 40, 209, 17, 217, 233, 251, 218, 121, 219, 119, 6, 187, 132, 205, 254, 252, 27, 84, 161, 29, 124, 204, 228, 176, 73, 49, 39, 45, 83, 105, 2, 245, 24, 223, 68, 79, 155, 188, 15, 92, 11, 220, 189, 148, 172, 9, 199, 162, 28, 130, 159, 198, 52, 194, 70, 5, 206, 59, 13, 60, 156, 8, 190, 183, 135, 229, 238, 107, 235, 242, 191, 175, 197, 100, 7, 123, 149, 154, 174, 182, 18, 89, 165, 53, 101, 184, 163, 158, 210, 247, 98, 90, 133, 125, 168, 58, 41, 113, 200, 246, 249, 67, 215, 214, 16, 115, 118, 120, 153, 10, 25, 145, 20, 63, 230, 240, 134, 177, 226, 241, 250, 116, 243, 180, 109, 33, 178, 106, 227, 231, 181, 234, 3, 143, 211, 201, 66, 212, 232, 117, 127, 255, 126, 253]
    gib_zurück inverse[als(u64, a)]

@nativ
funktion array_gf256_starten(t: ptr[ArrayGf256]) -> void:
    unsicher:
        setze t.bereit auf falsch
        setze t.logarithmus[0] auf 0
        setze wert: u8 auf 1
        setze i: u64 auf 0
        solange i < 255:
            setze t.exponent[i] auf wert
            setze t.logarithmus[als(u64, wert)] auf als(u8, i)
            setze wert auf array_gf256_mal(wert, 2)
            setze i auf i + 1
        solange i < 512:
            setze t.exponent[i] auf t.exponent[i - 255]
            setze i auf i + 1
        setze t.bereit auf wahr

# Interner Tabellenpfad: t bleibt gültig und wurde exklusiv initialisiert.
@nativ
funktion array_gf256_tabelle(t: ptr[ArrayGf256], a: u8, b: u8) -> u8:
    unsicher:
        wenn a == 0 oder b == 0:
            gib_zurück 0
        gib_zurück t.exponent[als(u64, t.logarithmus[als(u64, a)]) + als(u64, t.logarithmus[als(u64, b)])]
