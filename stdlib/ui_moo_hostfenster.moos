# ============================================================
# stdlib/ui_moo_hostfenster.moos — ui_moo-Widgets im NATIVEN
# Host-Fenster (NATIVE-UI-3). Läuft komplett über den
# MooUiHostOps-Vertrag (host_*-Builtins) + Surface-Backend:
# KEIN Toolkit, kein importiere ui (das würde im No-GTK-Build
# Leinwand-Symbole ziehen).
#
# Nutzung:
#   setze k auf uimh_fenster("Titel", 640, 480)
#   uim_hinzu(k, uim_knopf(...))
#   uimh_laufen(k)
#
# v1-Einschränkungen: ein Fenster, Modifier immer 0 (kein
# Shift-Tab), Tasten via X11-Keysym-Map (ASCII + Latin-1 +
# Unicode-Keysyms; tote Tasten/IME nicht unterstützt — NATIVE-UI-9).
# ============================================================

importiere ui_moo_kern
importiere ui_moo_surface
importiere ui_moo_csd

setze _UIMH auf {}
_UIMH["kontext"] = nichts
_UIMH["fenster"] = nichts
_UIMH["csd"] = falsch
_UIMH["titel"] = ""
_UIMH["hover"] = nichts
_UIMH["gedrueckt"] = nichts
_UIMH["b"] = 0
_UIMH["h"] = 0
_UIMH["dirty"] = falsch

# Render-Drossel: Input-Handler markieren nur dirty; gerendert wird beim
# tick-Event des Backends EINMAL pro Dispatch-Batch (statt pro Event).
funktion _uimh_dirty():
    _UIMH["dirty"] = wahr
    gib_zurück wahr

funktion _uimh_utf8(cp):
    wenn cp < 128:
        gib_zurück bytes_neu([cp])
    wenn cp < 2048:
        gib_zurück bytes_neu([192 + boden(cp / 64), 128 + cp % 64])
    gib_zurück bytes_neu([224 + boden(cp / 4096), 128 + boden(cp / 64) % 64, 128 + cp % 64])

# X11-/xkb-Keysym -> Kern-Tastenname ("BackSpace", "a", ...) oder nichts.
funktion uimh_keysym_name(ks):
    wenn ks == 65288:
        gib_zurück "BackSpace"
    wenn ks == 65293 oder ks == 65421:
        gib_zurück "Return"
    wenn ks == 65289:
        gib_zurück "Tab"
    wenn ks == 65307:
        gib_zurück "Escape"
    wenn ks == 65361:
        gib_zurück "Left"
    wenn ks == 65362:
        gib_zurück "Up"
    wenn ks == 65363:
        gib_zurück "Right"
    wenn ks == 65364:
        gib_zurück "Down"
    wenn ks == 65360:
        gib_zurück "Home"
    wenn ks == 65367:
        gib_zurück "End"
    wenn ks == 32:
        gib_zurück "space"
    wenn ks > 32 und ks < 127:
        gib_zurück bytes_neu([ks])
    wenn ks >= 160 und ks < 256:
        gib_zurück _uimh_utf8(ks)
    wenn ks >= 16777472:
        setze cp auf ks - 16777216
        wenn cp < 65536:
            gib_zurück _uimh_utf8(cp)
    gib_zurück nichts

funktion uimh_render():
    setze k auf _UIMH["kontext"]
    wenn k == nichts:
        gib_zurück falsch
    setze z auf k["_z"]
    wenn _UIMH["csd"]:
        # CSD-Modus (NATIVE-UI-3b): Aero-Glass-Fenster zuerst, der
        # Widget-Baum blendet darüber (Glass-Theme-Hintergrund ist
        # transparent und übermalt den Body nicht).
        surface_clear(z, 0, 0, 0, 0)
        uim_csd_zeichnen(z, 0, 0, _UIMH["b"], _UIMH["h"], _UIMH["titel"], wahr, _UIMH["hover"], _UIMH["gedrueckt"], 255, 65536)
    wenn uim_backend_zeichne(k, z) == falsch:
        gib_zurück falsch
    setze fr auf surface_snapshot_to_frame(z)
    wenn fr == nichts:
        gib_zurück falsch
    host_present(_UIMH["fenster"], fr)
    gib_zurück wahr

funktion _uimh_input(art, a, b, c):
    setze k auf _UIMH["kontext"]
    wenn k == nichts:
        gib_zurück falsch
    # CSD-Zonen (Titelleiste/Kanten/Buttons) VOR dem Widget-Kern.
    wenn _UIMH["csd"]:
        wenn art == "bewegung":
            setze zone auf uim_csd_hit_test(_UIMH["b"], _UIMH["h"], a, b)
            setze hz auf nichts
            wenn zone == "schliessen" oder zone == "minimieren" oder zone == "maximieren":
                setze hz auf zone
            wenn hz != _UIMH["hover"]:
                _UIMH["hover"] = hz
                _uimh_dirty()
            host_cursor(_UIMH["fenster"], uim_csd_cursor_name(zone))
        wenn art == "maus_runter" und c == 1:
            setze zone auf uim_csd_hit_test(_UIMH["b"], _UIMH["h"], a, b)
            setze kante auf uim_csd_kante(zone)
            wenn kante != nichts:
                host_resize_start(_UIMH["fenster"], kante)
                gib_zurück wahr
            wenn zone == "titel":
                host_drag_start(_UIMH["fenster"])
                gib_zurück wahr
            wenn zone == "schliessen" oder zone == "minimieren" oder zone == "maximieren":
                _UIMH["gedrueckt"] = zone
                _uimh_dirty()
                gib_zurück wahr
        wenn art == "maus_hoch" und c == 1:
            setze zone auf uim_csd_hit_test(_UIMH["b"], _UIMH["h"], a, b)
            setze vorher auf _UIMH["gedrueckt"]
            wenn vorher != nichts:
                _UIMH["gedrueckt"] = nichts
                wenn zone == vorher:
                    wenn zone == "schliessen":
                        host_schliessen(_UIMH["fenster"])
                        gib_zurück wahr
                    wenn zone == "minimieren":
                        host_minimiere(_UIMH["fenster"])
                    wenn zone == "maximieren":
                        host_maximiere(_UIMH["fenster"])
                _uimh_dirty()
                gib_zurück wahr
    wenn art == "maus_runter":
        uim_backend_maus_taste(k, a, b, c, wahr)
        _uimh_dirty()
        gib_zurück wahr
    wenn art == "maus_hoch":
        uim_backend_maus_taste(k, a, b, c, falsch)
        _uimh_dirty()
        gib_zurück wahr
    wenn art == "bewegung":
        uim_backend_bewegung(k, a, b)
        _uimh_dirty()
        gib_zurück wahr
    wenn art == "taste_runter":
        setze name auf uimh_keysym_name(a)
        wenn name != nichts:
            uim_backend_taste(k, name, wahr, 0)
            _uimh_dirty()
        gib_zurück wahr
    wenn art == "tick":
        uim_tick(k, 0.05)
        wenn k["_tick_aktiv"]:
            _uimh_dirty()
        wenn _UIMH["dirty"]:
            _UIMH["dirty"] = falsch
            uimh_render()
        gib_zurück wahr
    wenn art == "resize":
        setze z2 auf surface_new(a, b)
        wenn z2 != nichts:
            k["_z"] = z2
            _UIMH["b"] = a
            _UIMH["h"] = b
            uim_groesse_setze(k, a, b)
            uimh_render()
        gib_zurück wahr
    wenn art == "neuzeichnen":
        _uimh_dirty()
        gib_zurück wahr
    wenn art == "schliessen":
        host_beenden()
        gib_zurück wahr
    gib_zurück wahr

# Erzeugt natives Host-Fenster + Surface-Widget-Kontext. Liefert den
# Kontext (mit k["_z"] Surface, k["_fenster"] Host-Handle) oder nichts.
funktion uimh_fenster(titel, b, h):
    setze z auf surface_new(b, h)
    wenn z == nichts:
        gib_zurück nichts
    setze f auf host_fenster(titel, b, h, 0)
    wenn f == falsch:
        gib_zurück nichts
    setze backend auf uim_backend_surface()
    setze k auf uim_backend_wurzel(backend, b, h)
    wenn k == nichts:
        gib_zurück nichts
    k["_z"] = z
    k["_fenster"] = f
    _UIMH["kontext"] = k
    _UIMH["fenster"] = f
    _UIMH["titel"] = titel
    _UIMH["b"] = b
    _UIMH["h"] = h
    host_on_input(f, _uimh_input)
    gib_zurück k

# CSD-Variante (NATIVE-UI-3b): eigenes Aero-Glass-Fenster als Chrome,
# Widget-Kern im Glass-Theme darüber. Widgets unterhalb der Titelleiste
# platzieren (uim_csd_titel_hoehe liefert die Höhe).
funktion uimh_fenster_csd(titel, b, h):
    setze k auf uimh_fenster(titel, b, h)
    wenn k == nichts:
        gib_zurück nichts
    _UIMH["csd"] = wahr
    uim_theme_setze(k, uim_theme_glass())
    gib_zurück k

funktion uimh_laufen(k):
    setze f auf k["_fenster"]
    setze sichtbar auf host_zeige(f)
    wenn sichtbar == falsch:
        gib_zurück falsch
    uimh_render()
    host_laufen()
    gib_zurück wahr
