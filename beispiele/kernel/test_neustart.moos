# P7-T25: Testlauf-Reset, Watchdog und lesende N100-Diagnose.
# Intel N-Series Datasheet Vol.2, 759604-003:
# https://cdrdv2.intel.com/v1/dl/getContent/759604?fileName=759604-003.pdf
# 15.1.17/18 S.1065/1066: D31:F4, TCOBASE[15:5], TCOCTL[8].
# 38.1.5/6 S.3040/3041: TCO2_STS[2] Strap; TCO1_CNT[0] NO_REBOOT.
# 38.1.11 S.3044: TCO_TMR. Kein PMC-/RCBA-Schreiben fuer N100.
# ACPI 6.6, 5.2.9 FADT: Flags[10], ResetReg GAS bei 116, ResetValue bei 128.
# Linux v6.12 drivers/i2c/busses/i2c-i801.c:
# 147-160 TCOBASE=0x50,TCOCTL=0x54,EN=bit8; 1514-1556 iTCO_version=6.
# PCI 8086:54a3 (Alder Lake-M/N) nutzt FEATURE_TCO_CNL (PCI-Tabelle).
# Linux v6.12 drivers/watchdog/iTCO_wdt.c:75-83 Register;218-231
# NO_REBOOT bei Version>=6 in TCO1_CNT[0], nicht im alten PMC/GCS.
# Diese Diagnose schreibt KEIN TCO-/SMI-/PMC-/PCI-Konfigurationsregister.
aus "../uefi/hardware_pci" importiere takt, nt_cfg_lese32, nt_mmio_lese32, nt_mmio_schreibe32
aus "it8613_wdt" importiere it8613_suchen, it8613_kurzlauf, it8613_port_lesen

# Im ELF eindeutig markierter Testvertrag. Der Runner darf nur die Daten
# einer privaten Build-Kopie konfigurieren, niemals den Quelltext.
@nativ
statisch TESTLAUF_KONFIG: [u64; 4] auf [0x353254504F4F4D21, 90, 180, 0]
@nativ
statisch TESTLAUF_ZUSTAND: [u64; 12] auf 0
@nativ
konstante TL_RESET: [u8; _] auf "MOO-KERNEL NEUSTART "
@nativ
konstante TL_RUECKFALL: [u8; _] auf "MOO-KERNEL RUECKFALL OHNE USB "
@nativ
konstante TL_FADT: [u8; _] auf "MOO-KERNEL RESET FADT GAS "
@nativ
konstante TL_CF9: [u8; _] auf "MOO-KERNEL RESET CF9 "
@nativ
konstante TL_8042: [u8; _] auf "MOO-KERNEL RESET 8042 "
@nativ
konstante TL_FEHLER: [u8; _] auf "MOO-KERNEL RESET FEHLGESCHLAGEN "
@nativ
konstante TL_PCI: [u8; _] auf "MOO-KERNEL TCO SMBUS PCI "
@nativ
konstante TL_BASIS: [u8; _] auf "MOO-KERNEL TCO BASIS "
@nativ
konstante TL_CTL: [u8; _] auf "MOO-KERNEL TCO PCI TCOCTL "
@nativ
konstante TL_CNT: [u8; _] auf "MOO-KERNEL TCO TCO1_CNT "
@nativ
konstante TL_TMR: [u8; _] auf "MOO-KERNEL TCO TCO_TMR "
@nativ
konstante TL_STS2: [u8; _] auf "MOO-KERNEL TCO TCO2_STS "
@nativ
konstante TL_STRAP: [u8; _] auf "MOO-KERNEL TCO NO_REBOOT STRAP "
@nativ
konstante TL_NR: [u8; _] auf "MOO-KERNEL TCO NO_REBOOT "
@nativ
konstante TL_NUR: [u8; _] auf "MOO-KERNEL TCO NUR LESEN "
@nativ
konstante TL_FEHLT: [u8; _] auf "MOO-KERNEL TCO NICHT BELEGT "
@nativ
konstante TL_TCO_AN: [u8; _] auf "MOO-KERNEL TCO SCHARF GESAMT-SEKUNDEN "
@nativ
konstante TL_TCO_TMR_NEU: [u8; _] auf "MOO-KERNEL TCO TMR NACH SCHARF "
@nativ
konstante TL_TCO_CNT_NEU: [u8; _] auf "MOO-KERNEL TCO CNT NACH SCHARF "
@nativ
konstante TL_TCO_PING: [u8; _] auf "MOO-KERNEL TCO BEDIENT "
@nativ
konstante TL_TCO_NEIN: [u8; _] auf "MOO-KERNEL TCO SCHARFSCHALTUNG VERWEIGERT "
@nativ
konstante TL_TCO_SAFETY: [u8; _] auf "MOO-KERNEL TCO SAFETY OHNE BEDIENUNG "

@nativ
konstante TL_RLD: [u8; _] auf "MOO-KERNEL TCO TCO_RLD "
@nativ
konstante TL_STS1: [u8; _] auf "MOO-KERNEL TCO TCO1_STS "
@nativ
konstante TL_CNT2: [u8; _] auf "MOO-KERNEL TCO TCO2_CNT "
@nativ
konstante TL_PMC_PCI: [u8; _] auf "MOO-KERNEL TCO PMC D31F2 PCI "
@nativ
konstante TL_PMC_CMD: [u8; _] auf "MOO-KERNEL TCO PMC PCI COMMAND "
@nativ
konstante TL_PMC_BAR0: [u8; _] auf "MOO-KERNEL TCO PMC PCI BAR0 "
@nativ
konstante TL_PMC_BAR0_HI: [u8; _] auf "MOO-KERNEL TCO PMC PCI BAR0 HIGH "
@nativ
konstante TL_PMC_BAR2: [u8; _] auf "MOO-KERNEL TCO PMC PCI BAR2 "
@nativ
konstante TL_PMC_BASIS: [u8; _] auf "MOO-KERNEL TCO PMC PWRMBASE "
@nativ
konstante TL_PMC_FEHLT: [u8; _] auf "MOO-KERNEL TCO PMC NICHT BELEGT "
@nativ
konstante TL_PM_BASIS: [u8; _] auf "MOO-KERNEL TCO ACPI-PM BASIS "
@nativ
konstante TL_PM_FEHLT: [u8; _] auf "MOO-KERNEL TCO ACPI-PM NICHT BELEGT "
@nativ
konstante TL_SMI_EN: [u8; _] auf "MOO-KERNEL TCO SMI_EN "
@nativ
konstante TL_SMI_STS: [u8; _] auf "MOO-KERNEL TCO SMI_STS "
@nativ
konstante TL_PMCON_A: [u8; _] auf "MOO-KERNEL TCO PMC GEN_PMCON_A "
@nativ
konstante TL_PMCON_B: [u8; _] auf "MOO-KERNEL TCO PMC GEN_PMCON_B "
@nativ
konstante TL_ETR3: [u8; _] auf "MOO-KERNEL TCO PMC ETR3 "
@nativ
konstante TL_ACPI_TMR_CTL: [u8; _] auf "MOO-KERNEL TCO PMC ACPI_TMR_CTL "
@nativ
konstante TL_HPR: [u8; _] auf "MOO-KERNEL TCO PMC HPR_CAUSE0 "

@nativ
konstante TL_BEOB_START: [u8; _] auf "MOO-KERNEL TCO BEOBACHTUNG START "
@nativ
konstante TL_BEOB_MS: [u8; _] auf "MOO-KERNEL TCO BEOBACHTUNG MS "
@nativ
konstante TL_BEOB_FRIST: [u8; _] auf "MOO-KERNEL TCO BEOBACHTUNG FRIST "
@nativ
konstante TL_IT8613_MESSZEIT: [u8; _] auf "MOO-KERNEL IT8613 MESSZEIT MS "
@nativ
konstante TL_IT8613_FERTIG: [u8; _] auf "MOO-KERNEL IT8613 MESSREIHE FERTIG "

@nativ
funktion testlauf_konfig(index: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(TESTLAUF_KONFIG) + index * 8, 8)

@nativ
funktion tl_wert(index: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(TESTLAUF_ZUSTAND) + index * 8, 8)

@nativ
funktion tl_setze(index: u64, wert: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(TESTLAUF_ZUSTAND) + index * 8, wert, 8)

# Intel 759604-003, 13.2.1: PM1a_EVT liegt bei PMBASE + 0.
# ACPI FADT: PM1a_EVT_BLK bei 56, X_PM1a_EVT_BLK (GAS) bei 148.
@nativ
funktion tl_pm_basis_fadt(fadt: u64) -> u64:
    unsicher:
        wenn fadt == 0:
            gib_zurück 0
        setze laenge: u64 auf u64(speicher_lesen(fadt + 4, 4))
        wenn laenge < 116 oder (speicher_lesen(fadt + 112, 4) & 0x100000) != 0 oder speicher_lesen(fadt + 88, 1) != 4:
            gib_zurück 0
        setze basis: u64 auf u64(speicher_lesen(fadt + 56, 4))
        wenn laenge >= 160 und speicher_lesen(fadt + 152, 8) != 0:
            wenn speicher_lesen(fadt + 148, 1) != 1 oder speicher_lesen(fadt + 150, 1) != 0:
                gib_zurück 0
            setze basis auf speicher_lesen(fadt + 152, 8)
        wenn basis > 0xFF80 oder (basis & 0x7F) != 0:
            gib_zurück 0
        gib_zurück basis

# Linux v6.12 intel/pmc/core.c:1179-1195,1362-1364 und tgl.c:288-306:
# Auf Gracemont liegt der LPIT-SystemMemory-Residenzzaehler bei PWRMBASE + 0x193C.
# LPIT und GAS: Linux include/acpi/actbl2.h:882-921 und actbl.h:91-99.
@nativ
funktion tl_pwrm_basis_lpit(lpit: u64) -> u64:
    unsicher:
        wenn lpit == 0:
            gib_zurück 0
        setze gesamt: u64 auf u64(speicher_lesen(lpit + 4, 4))
        setze eintrag: u64 auf 36
        solange eintrag + 16 <= gesamt:
            setze adr: u64 auf lpit + eintrag
            setze laenge: u64 auf u64(speicher_lesen(adr + 4, 4))
            wenn laenge < 16 oder laenge > gesamt - eintrag:
                gib_zurück 0
            wenn laenge >= 56 und speicher_lesen(adr, 4) == 0 und speicher_lesen(adr + 12, 4) == 0:
                wenn speicher_lesen(adr + 36, 1) == 0 und speicher_lesen(adr + 38, 1) == 0:
                    setze zaehler: u64 auf speicher_lesen(adr + 40, 8)
                    wenn (zaehler & 0x1FFF) == 0x193C:
                        gib_zurück zaehler - 0x193C
            setze eintrag auf eintrag + laenge
        gib_zurück 0

# Intel 759604-003, 13.1.2/5/6/9: D31:F2 Command, BAR0 (8 KiB), BAR2 (I/O).
# Bei verborgener PCI-Funktion verwenden wir die belegten ACPI-Tabelleneintraege.
@nativ
funktion tl_pmc_lesen(fadt: u64, lpit: u64, bi: u64, map: u64, loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze abbilden: ptr[fn[sysv64](u64, u64, u64) -> u64] auf zeiger(map)
        setze pci_id: u32 auf nt_cfg_lese32(0x8000FA00)
        setze pwrm: u64 auf 0
        setze pm_basis: u64 auf 0
        log(adresse_von(TL_PMC_PCI), u64(pci_id))
        wenn (pci_id & 0xFFFF) == 0x8086:
            setze command: u32 auf nt_cfg_lese32(0x8000FA04) & 0xFFFF
            setze bar0: u32 auf nt_cfg_lese32(0x8000FA10)
            setze bar0_hi: u32 auf nt_cfg_lese32(0x8000FA14)
            setze bar2: u32 auf nt_cfg_lese32(0x8000FA20)
            log(adresse_von(TL_PMC_CMD), u64(command))
            log(adresse_von(TL_PMC_BAR0), u64(bar0))
            log(adresse_von(TL_PMC_BAR0_HI), u64(bar0_hi))
            log(adresse_von(TL_PMC_BAR2), u64(bar2))
            wenn (command & 2) != 0 und (bar0 & 0x1FFF) == 4:
                setze pwrm auf (u64(bar0_hi) << 32) | u64(bar0 & 0xFFFFE000)
            wenn (command & 1) != 0 und (bar2 & 0xFFFF007F) == 1:
                setze pm_basis auf u64(bar2 & 0xFF80)
        sonst wenn pci_id == 0xFFFFFFFF:
            setze pm_basis auf tl_pm_basis_fadt(fadt)
            setze pwrm auf tl_pwrm_basis_lpit(lpit)
        log(adresse_von(TL_PM_BASIS), pm_basis)
        tl_setze(10, pm_basis)
        wenn pm_basis == 0:
            log(adresse_von(TL_PM_FEHLT), 1)
        log(adresse_von(TL_PMC_BASIS), pwrm)
        wenn pwrm == 0 oder pwrm >= 0x1000000000000:
            log(adresse_von(TL_PMC_FEHLT), 1)
            gib_zurück
        setze mmio: u64 auf abbilden(bi, pwrm, 0x2000)
        wenn mmio == 0:
            log(adresse_von(TL_PMC_FEHLT), 2)
            gib_zurück
        tl_setze(11, mmio)
        # 759604-003, 13.3.1/2/4.
        log(adresse_von(TL_PMCON_A), u64(nt_mmio_lese32(mmio + 0x1020)))
        log(adresse_von(TL_PMCON_B), u64(nt_mmio_lese32(mmio + 0x1024)))
        log(adresse_von(TL_ETR3), u64(nt_mmio_lese32(mmio + 0x1048)))

@nativ
funktion tl_pch_status(loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze pm_basis: u64 auf tl_wert(10)
        setze mmio: u64 auf tl_wert(11)
        wenn pm_basis != 0:
            # 759604-003, 13.2.5/6: TCO_EN und TCO_STS sind jeweils Bit 13.
            setze smi_en: u32 auf port_lese32(u16(pm_basis + 0x30))
            setze smi_sts: u32 auf port_lese32(u16(pm_basis + 0x34))
            log(adresse_von(TL_SMI_EN), u64(smi_en))
            log(adresse_von(TL_SMI_STS), u64(smi_sts))
        wenn mmio != 0:
            # 759604-003, 13.3.69: ACPI_TIM_DIS[1] haelt den PCH-PM-Timer an.
            log(adresse_von(TL_ACPI_TMR_CTL), u64(nt_mmio_lese32(mmio + 0x18FC)))
            # 759604-003, 13.3.75: TCO_WDT[6] meldet den zweiten Ablauf.
            log(adresse_von(TL_HPR), u64(nt_mmio_lese32(mmio + 0x192C)))

@nativ
funktion tl_tco_status(basis: u32, n100: bool, loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        # 759604-003, 38.1.1/4-7/11. Lesen von RLD liefert den laufenden Zaehler.
        setze rld: u16 auf port_lese16(u16(basis))
        setze sts1: u16 auf port_lese16(u16(basis + 4))
        setze sts2: u16 auf port_lese16(u16(basis + 6))
        setze cnt: u16 auf port_lese16(u16(basis + 8))
        setze cnt2: u16 auf port_lese16(u16(basis + 0x0A))
        setze tmr: u16 auf port_lese16(u16(basis + 0x12))
        log(adresse_von(TL_RLD), u64(rld))
        log(adresse_von(TL_STS1), u64(sts1))
        log(adresse_von(TL_STS2), u64(sts2))
        log(adresse_von(TL_CNT), u64(cnt))
        log(adresse_von(TL_CNT2), u64(cnt2))
        log(adresse_von(TL_TMR), u64(tmr))
        wenn n100:
            log(adresse_von(TL_STRAP), u64((sts2 >> 2) & 1))
            log(adresse_von(TL_NR), u64(cnt & 1))

# Genauer SMBus-BDF 00:1f.4 belegt die Registerbelegung des N100.
@nativ
funktion testlauf_tco_lesen(fadt: u64, lpit: u64, bi: u64, map: u64, loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze pci_id: u32 auf nt_cfg_lese32(0x8000FC00)
        log(adresse_von(TL_PCI), u64(pci_id))
        wenn pci_id != 0x54A38086:
            log(adresse_von(TL_FEHLT), 1)
            gib_zurück
        setze basis: u32 auf nt_cfg_lese32(0x8000FC50)
        setze kontrolle: u32 auf nt_cfg_lese32(0x8000FC54)
        log(adresse_von(TL_BASIS), u64(basis))
        log(adresse_von(TL_CTL), u64(kontrolle))
        tl_pmc_lesen(fadt, lpit, bi, map, loggen)
        tl_pch_status(loggen)
        wenn (kontrolle & 0x100) == 0 oder (basis & 0xFFFF0000) != 0 oder (basis & 0xFFE0) == 0 oder (basis & 0x1E) != 0:
            log(adresse_von(TL_FEHLT), 2)
            gib_zurück
        tl_tco_status(basis & 0xFFE0, wahr, loggen)
        log(adresse_von(TL_NUR), 1)

@nativ
funktion testlauf_starten(fadt: u64, lpit: u64, bi: u64, tsc: u64, map: u64, loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze abbilden: ptr[fn[sysv64](u64, u64, u64) -> u64] auf zeiger(map)
        setze gas: u64 auf 0
        setze adresse: u64 auf 0
        setze raum: u64 auf 0
        tl_setze(3, tsc * 1000000)
        tl_setze(4, takt())
        # Der Callback wird als Parameter an poll/reset weitergereicht.
        wenn fadt != 0 und speicher_lesen(fadt + 4, 4) >= 129 und (speicher_lesen(fadt + 112, 4) & 0x400) != 0:
            setze gas auf fadt + 116
            setze raum auf u64(speicher_lesen(gas, 1))
            setze adresse auf speicher_lesen(gas + 4, 8)
            wenn speicher_lesen(gas + 1, 1) == 8 und speicher_lesen(gas + 2, 1) == 0 und speicher_lesen(gas + 3, 1) <= 1 und adresse != 0:
                wenn raum == 0:
                    setze adresse auf abbilden(bi, adresse, 1)
                sonst wenn raum != 1 oder adresse > 0xFFFF:
                    setze adresse auf 0
                wenn adresse != 0:
                    tl_setze(0, adresse)
                    tl_setze(1, u64(speicher_lesen(fadt + 128, 1)))
                    tl_setze(2, raum)
        log(adresse_von(TL_FADT), tl_wert(0))
        testlauf_tco_lesen(fadt, lpit, bi, map, loggen)
        setze modus: u64 auf testlauf_konfig(3)
        setze scharf: bool auf falsch
        setze watchdog: u64 auf testlauf_konfig(2)
        setze sekunden: u64 auf testlauf_konfig(1)
        setze beobachten: bool auf modus == 4 oder modus == 104
        wenn modus == 0:
            it8613_suchen(loggen)
        wenn modus != 0 und modus != 5 und modus != 6 und modus != 7:
            # Die Beobachtungsfrist deckt beide Intervalle samt Timertoleranz ab.
            wenn tsc != 0 und (nicht beobachten oder (sekunden >= 5 und sekunden <= 600 und watchdog <= sekunden - 5)):
                wenn modus == 1 oder modus == 2 oder modus == 3 oder modus == 4:
                    setze scharf auf tl_tco_n100(watchdog)
                sonst wenn modus == 100 oder modus == 101 oder modus == 103 oder modus == 104:
                    setze scharf auf tl_tco_ich9(bi, map, watchdog)
            wenn scharf:
                log(adresse_von(TL_TCO_AN), testlauf_konfig(2))
                log(adresse_von(TL_TCO_TMR_NEU), u64(port_lese16(u16(tl_wert(6) + 0x12))))
                log(adresse_von(TL_TCO_CNT_NEU), u64(port_lese16(u16(tl_wert(6) + 8))))
                wenn modus == 2 oder modus == 101:
                    log(adresse_von(TL_TCO_SAFETY), testlauf_konfig(2))
            sonst:
                log(adresse_von(TL_TCO_NEIN), modus)
                tl_setze(9, 1)

@nativ
funktion tl_warten(ms: u64) -> void:
    unsicher:
        setze anfang: u64 auf takt()
        setze hz: u64 auf tl_wert(3)
        setze budget: u64 auf 1000000
        solange hz != 0 oder budget > 0:
            wenn hz != 0 und takt() - anfang >= hz / 1000 * ms:
                gib_zurück
            assembler(ziel="x86_64", code="pause", clobber=[])
            setze budget auf budget - 1

@nativ
funktion tl_it8613_messreihe(loggen: u64) -> void:
    unsicher:
        setze pro_ms: u64 auf tl_wert(3) / 1000
        wenn pro_ms == 0 oder testlauf_konfig(1) != 70:
            gib_zurück
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze anfang: u64 auf takt()
        log(adresse_von(TL_IT8613_MESSZEIT), 0)
        setze port: u16 auf it8613_suchen(loggen)
        wenn port == 0:
            gib_zurück
        tl_warten(2000)
        log(adresse_von(TL_IT8613_MESSZEIT), (takt() - anfang) / pro_ms)
        wenn nicht it8613_port_lesen(port, loggen, falsch):
            gib_zurück
        tl_warten(68000)
        log(adresse_von(TL_IT8613_MESSZEIT), (takt() - anfang) / pro_ms)
        wenn it8613_port_lesen(port, loggen, falsch):
            log(adresse_von(TL_IT8613_FERTIG), (takt() - anfang) / pro_ms)

@nativ
funktion testlauf_neustart(loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        log(adresse_von(TL_RESET), testlauf_konfig(1))
        # TX darf abschliessen, bevor die Plattform zurueckgesetzt wird.
        tl_warten(20)
        assembler(ziel="x86_64", code="cli", clobber=[])
        wenn tl_wert(0) != 0:
            wenn tl_wert(2) == 1:
                port_schreibe(u16(tl_wert(0)), u8(tl_wert(1)))
            sonst:
                setze ziel: ptr[u8] auf zeiger(tl_wert(0))
                volatile_schreiben(ziel, u8(tl_wert(1)))
            tl_warten(100)
        log(adresse_von(TL_CF9), 1)
        port_schreibe(u16(0xCF9), 2)
        port_schreibe(u16(0xCF9), 6)
        tl_warten(100)
        log(adresse_von(TL_8042), 1)
        setze versuche_8042: u64 auf 10000
        solange versuche_8042 > 0 und (port_lese(u16(0x64)) & 2) != 0:
            setze versuche_8042 auf versuche_8042 - 1
        wenn versuche_8042 != 0:
            port_schreibe(u16(0x64), 0xFE)
        log(adresse_von(TL_FEHLER), 1)
        solange wahr:
            assembler(ziel="x86_64", code="hlt", clobber=[])

# Beobachtung vor USB und Massenspeicher. Ab Start der Uhr schreibt dieser
# Pfad weder TCO_RLD noch Statusbits. Bei Fristablauf folgt der Software-Reset.
@nativ
funktion tl_tco_beobachten(sekunden: u64, n100: bool, loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze start: u64 auf tl_wert(5)
        setze pro_ms: u64 auf tl_wert(3) / 1000
        setze basis: u32 auf u32(tl_wert(6))
        setze faellig: u64 auf 0
        log(adresse_von(TL_BEOB_START), testlauf_konfig(2))
        solange wahr:
            setze ms: u64 auf (takt() - start) / pro_ms
            wenn ms >= faellig:
                setze faellig auf ms + 1000
                log(adresse_von(TL_BEOB_MS), ms)
                tl_tco_status(basis, n100, loggen)
                tl_pch_status(loggen)
            wenn ms >= sekunden * 1000:
                log(adresse_von(TL_BEOB_FRIST), ms)
                testlauf_neustart(loggen)
            assembler(ziel="x86_64", code="pause", clobber=[])

@nativ
funktion testlauf_poll(loggen: u64) -> void:
    unsicher:
        setze sekunden: u64 auf testlauf_konfig(1)
        wenn tl_wert(9) != 0:
            testlauf_neustart(loggen)
        setze modus: u64 auf testlauf_konfig(3)
        wenn modus == 6:
            tl_it8613_messreihe(loggen)
            testlauf_neustart(loggen)
            gib_zurück
        wenn modus == 5 oder modus == 7:
            it8613_kurzlauf(sekunden, testlauf_konfig(2), tl_wert(3), modus == 7, loggen)
            testlauf_neustart(loggen)
            gib_zurück
        wenn tl_wert(7) != 0 und (modus == 4 oder modus == 104):
            tl_tco_beobachten(sekunden, modus == 4, loggen)
        wenn tl_wert(7) != 0 und (modus == 2 oder modus == 101):
            # Sicherheitsnachweis: echter Stillstand, IRQs aus, keine Soft-Resetfolge.
            assembler(ziel="x86_64", code="cli", clobber=[])
            solange wahr:
                assembler(ziel="x86_64", code="hlt", clobber=[])
        tl_tco_bedienen(loggen)
        # 0 bedeutet interaktiv. Ein fehlender kalibrierter TSC darf einen
        # befristeten Test nicht endlos machen: dann nach Diagnose resetten.
        wenn sekunden > 0 und (tl_wert(3) == 0 oder (takt() - tl_wert(4)) / tl_wert(3) >= sekunden):
            testlauf_neustart(loggen)


# Intel 759604-003: Reset erfolgt beim ZWEITEN Ablauf (38.1.5).
# Daher ist ein Timerintervall die Haelfte der gewuenschten Gesamtzeit.
# 0.6s/Tick, aufgerundet; Linux iTCO_wdt liefert Register/Status/Startfolge,
# seine gemeldete Timeout-Semantik wird hier nicht als Gesamtzeit uebernommen.
@nativ
funktion testlauf_tco_ticks(sekunden: u64) -> u16:
    wenn sekunden < 6 oder sekunden > 600:
        gib_zurück 0
    gib_zurück als(u16, (sekunden * 5 + 5) / 6)

@nativ
funktion tl_tco_start(basis: u64, sekunden: u64) -> bool:
    unsicher:
        wenn basis == 0 oder basis > 0xFFE0 oder (basis & 31) != 0:
            gib_zurück falsch
        setze ticks: u16 auf testlauf_tco_ticks(sekunden)
        setze cnt: u16 auf port_lese16(u16(basis + 8))
        setze alt: u16 auf port_lese16(u16(basis + 0x12))
        wenn ticks == 0 oder (cnt & 0x800) == 0:
            gib_zurück falsch
        port_schreibe16(u16(basis + 0x12), (alt & 0xFC00) | ticks)
        wenn (port_lese16(u16(basis + 0x12)) & 0x3FF) != ticks:
            port_schreibe16(u16(basis + 0x12), alt)
            gib_zurück falsch
        # Nur die Timeout-Statusbits quittieren, keine fremden W1C-Ereignisse.
        port_schreibe16(u16(basis + 4), 8)
        port_schreibe16(u16(basis + 6), 2)
        port_schreibe16(u16(basis), 1)
        port_schreibe16(u16(basis + 8), cnt & 0xF7FF)
        wenn (port_lese16(u16(basis + 8)) & 0x801) != 0:
            port_schreibe16(u16(basis + 8), cnt | 0x800)
            port_schreibe16(u16(basis + 0x12), alt)
            gib_zurück falsch
        tl_setze(5, takt())
        tl_setze(6, basis)
        tl_setze(7, 1)
        gib_zurück wahr

# Lokaler Rueckfall: kein USB-/Framebuffer-Test, nur Bedienung und Reset.
# Modi3/103 werden ausschliesslich in einer privaten ELF-Kopie gesetzt.
@nativ
funktion testlauf_rueckfall(loggen: u64) -> void:
    unsicher:
        wenn testlauf_konfig(3) != 3 und testlauf_konfig(3) != 103:
            gib_zurück
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        wenn testlauf_konfig(1) == 0 oder testlauf_konfig(1) > 30:
            testlauf_neustart(loggen)
        log(adresse_von(TL_RUECKFALL), testlauf_konfig(1))
        solange wahr:
            testlauf_poll(loggen)

# Ausschliesslich die auf dem N100 gelesene Konfiguration d3ea9834.
# TCO_LOCK[12] betrifft SMI_EN.TCO_EN, NICHT TCO_TMR_HALT[11].
# Linux v6.12 iTCO_wdt:488-531 nutzt fuer v6 ebenfalls kein SMI_EN.
@nativ
funktion tl_tco_n100(sekunden: u64) -> bool:
    unsicher:
        wenn nt_cfg_lese32(0x8000FC00) != 0x54A38086 oder nt_cfg_lese32(0x8000FC50) != 0x401 oder nt_cfg_lese32(0x8000FC54) != 0x101:
            gib_zurück falsch
        wenn port_lese16(u16(0x408)) != 0x1800 oder (port_lese16(u16(0x406)) & 4) != 0:
            gib_zurück falsch
        # NO_REBOOT muss bereits 0 sein. Kein Firmware-/PMC-Override.
        gib_zurück tl_tco_start(0x400, sekunden)

# Opt-in-Emulatorpfad, NICHT als N100-Beleg verwenden.
# Intel ICH9 DS316972: PMBASE+60 TCO, RCBA+3410 GCS.NO_REBOOT[5].
# QEMU v11.0.1 hw/acpi/ich9_tco.c:49-78: zwei Timerablaeufe, je0.6s.
@nativ
funktion tl_tco_ich9(bi: u64, map: u64, sekunden: u64) -> bool:
    unsicher:
        setze abbilden: ptr[fn[sysv64](u64, u64, u64) -> u64] auf zeiger(map)
        setze pm: u64 auf u64(nt_cfg_lese32(0x8000F840) & 0xFF80)
        setze rcba: u64 auf u64(nt_cfg_lese32(0x8000F8F0) & 0xFFFFC000)
        setze gcs: u64 auf 0
        setze wert: u32 auf 0
        setze cnt: u16 auf 0
        setze smi: u32 auf 0
        wenn nt_cfg_lese32(0x8000F800) != 0x29188086 oder pm == 0 oder rcba == 0 oder (nt_cfg_lese32(0x8000F8F0) & 1) == 0 oder (nt_cfg_lese32(0x8000F844) & 0x80) == 0:
            gib_zurück falsch
        setze rcba auf abbilden(bi, rcba, 0x4000)
        wenn rcba == 0:
            gib_zurück falsch
        setze gcs auf rcba + 0x3410
        setze wert auf nt_mmio_lese32(gcs)
        setze cnt auf port_lese16(u16(pm + 0x68))
        setze smi auf port_lese32(u16(pm + 0x30))
        wenn (cnt & 0x1000) != 0 und (smi & 0x2000) != 0:
            gib_zurück falsch
        port_schreibe16(u16(pm + 0x68), cnt | 0x800)
        port_schreibe32(u16(pm + 0x30), smi & 0xFFFFDFFF)
        nt_mmio_schreibe32(gcs, wert & 0xFFFFFFDF)
        wenn (nt_mmio_lese32(gcs) & 0x20) != 0 oder (port_lese32(u16(pm + 0x30)) & 0x2000) != 0:
            gib_zurück falsch
        gib_zurück tl_tco_start(pm + 0x60, sekunden)

@nativ
funktion tl_tco_bedienen(loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        wenn tl_wert(7) == 0:
            gib_zurück
        wenn takt() - tl_wert(5) >= tl_wert(3):
            port_schreibe16(u16(tl_wert(6)), 1)
            tl_setze(5, takt())
            tl_setze(8, tl_wert(8) + 1)
            wenn tl_wert(8) == 1 oder (tl_wert(8) % 10) == 0:
                log(adresse_von(TL_TCO_PING), tl_wert(8))
