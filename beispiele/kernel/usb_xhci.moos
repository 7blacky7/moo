# P7-T23: eigener xHCI-Hosttreiber, Hardware-Syntax A.
# xHCI 1.2: Register/Contexts/TRBs; USB 2.0 Kap.9; HID 1.11 Boot Keyboard.
# Boot-Tastaturen direkt an xHCI-Rootports. MSI weckt den Eingabefaden.
# Pro Host eigener Kommando-/Eventring, pro Slot eigener Device Context,
# Control-, IN- und OUT-Ringe. Laufender BOT verarbeitet auch HID-Ereignisse.
# Timer-Polling bleibt der Rückfall. Hub, Maus und Hotplug sind weitere Stufen.
# Kein Firmwaredienst nach ExitBootServices.
# Die DMA-Seiten bleiben beim PFA reserviert.
aus "../uefi/hardware_pci" importiere nt_mmio_lese32, nt_mmio_schreibe32, nt_mmio_glocke32, nt_cfg_lese32, nt_cfg_schreibe32, takt, nt_null
aus "kern_irq" importiere kern_irq_msi, kern_irq_msix, kern_irq_stoppen

# 0 CAP,1 OP,2 DB,3 RT,4 DMA,5 Contextgroesse,6/7 CMD Index/Cycle,
# 8/9 Event Index/Cycle,10 Slot,11 DCI,12/13 EP0 Index/Cycle,
# 14/15 Arbeitsindex/Cycle fuer IN,16 Anzahl HID-Slots,18 TSC/us,
# 19 Fehlerstufe,22 Completion-Slot,23 physische BAR.
# 17 MSI aktiv, 20 Anzahl MSC-Slots, 21 kompakte BOT-Protokollierung,
# 24 HID-Callback bei synchroner I/O; 25 frei.
# 26 Meldungs-Callback,27 PPC,28 MaxPorts,29 BDF,
# 30 Keyboard-Interface,31 Endpoint,32 Paketgroesse,33 bInterval,34 Konfig,35 Protocol-Caps.
# 36/37/38 letztes passendes Event Status/Steuer/TRB; 39/40/41 aktive EP0-TRBs,
# 42 angefragte Datenbytes,43 tatsaechliche Datenbytes (Short vor Status).
# 44/45 Bulk-OUT Index/Cycle, 46 MaxSlotsEn, 47/48/49 Rohereignis,
# 50 HID-Reportdiagnose, 51 HID-Arena aktiv.
@nativ
konstante XH_WERTE: u64 auf 52
@nativ
konstante XH_MAX_HOSTS: u64 auf 8
@nativ
konstante XH_MAX_HID: u64 auf 16
# 64 Seiten Host, je Slot vier Seiten: Output/RAM, EP0, IN und OUT.
@nativ
konstante XH_HID_SEITEN: u64 auf 128
@nativ
statisch XH: [u64; 52] auf 0
@nativ
statisch XH_HID_HOSTS: [u64; 416] auf 0
@nativ
statisch XH_AKTIV: [u64; 1] auf 0
@nativ
statisch XH_HID_HOST_ANZAHL: [u64; 1] auf 0
@nativ
statisch XH_MSC_RUF: [u64; 1] auf 0

# Metadaten oberhalb des 32 * 64 Byte grossen Output Device Context.
struktur XhTastatur:
    port: u64
    dci: u64
    index: u64
    zyklus: u64
    anfrage: u64
    vorher: u64

