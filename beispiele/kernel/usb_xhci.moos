@nativ
statisch XH_PROTO: [u8; 256] auf 0
@nativ
statisch XH_CSC: [u8; 256] auf 0

@nativ
funktion xh_log(adr: u64, wert: u64) -> void:
    unsicher:
        wenn xh(26) != 0:
            setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(xh(26))
            log(adr, wert)

# Phasen: 0 vor HC-Reset, 1 danach, 2 nach Power/CCS-Wartezeit;
# 3 vor Port-Reset, 4 danach, 5 nach Recovery.
@nativ
funktion xh_port_bild(port: u64, phase: u64) -> void:
    unsicher:
        setze v: u32 auf nt_mmio_lese32(xh(1) + 0x400 + (port - 1) * 16)
        wenn (v & 0x20000) != 0:
            speicher_schreiben(adresse_von(XH_CSC) + port, 1, 1)
        xh_log(adresse_von(XH_T_PORT), port)
        xh_log(adresse_von(XH_T_PHASE), phase)
        xh_log(adresse_von(XH_T_PROTOKOLL), u64(speicher_lesen(adresse_von(XH_PROTO) + port, 1)))
        xh_log(adresse_von(XH_T_PORTSC), u64(v))
        xh_log(adresse_von(XH_T_CCS), u64(v & 1))
        xh_log(adresse_von(XH_T_PED), u64((v >> 1) & 1))
        xh_log(adresse_von(XH_T_PR), u64((v >> 4) & 1))
        xh_log(adresse_von(XH_T_PLS), u64((v >> 5) & 15))
        xh_log(adresse_von(XH_T_PP), u64((v >> 9) & 1))
        xh_log(adresse_von(XH_T_SPEED), u64((v >> 10) & 15))
        xh_log(adresse_von(XH_T_CSC), u64((v >> 17) & 1))
        xh_log(adresse_von(XH_T_CSC_GESEHEN), u64(speicher_lesen(adresse_von(XH_CSC) + port, 1)))

@nativ
funktion xh_ports_bild(phase: u64) -> void:
    unsicher:
        setze port: u64 auf 1
        solange port <= xh(28):
            xh_port_bild(port, phase)
            setze port auf port + 1

# ID2 liefert USB2/USB3-Portbereiche, unabhaengig von aktueller Speed-ID.
@nativ
funktion xh_protokoll(cap: u64, e: u64, kopf: u32) -> bool:
    unsicher:
        setze bereich: u32 auf nt_mmio_lese32(cap + e + 8)
        setze erster: u64 auf u64(bereich & 255)
        setze anzahl: u64 auf u64((bereich >> 8) & 255)
        setze major: u8 auf u8(kopf >> 24)
        setze i: u64 auf 0
        setze psi: u64 auf u64(bereich >> 28)
        xh_log(adresse_von(XH_T_PROTO_KOPF), u64(kopf))
        xh_log(adresse_von(XH_T_PROTO_NAME), u64(nt_mmio_lese32(cap + e + 4)))
        xh_log(adresse_von(XH_T_PROTO_PORTS), u64(bereich))
        xh_log(adresse_von(XH_T_PROTO_SLOT), u64(nt_mmio_lese32(cap + e + 12)))
        wenn erster == 0 oder anzahl == 0 oder erster + anzahl > xh(28) + 1 oder e + 16 + psi * 4 > 0x100000:
            gib_zurück falsch
        solange i < psi:
            xh_log(adresse_von(XH_T_PROTO_PSI), u64(nt_mmio_lese32(cap + e + 16 + i * 4)))
            setze i auf i + 1
        wenn nt_mmio_lese32(cap + e + 4) != 0x20425355 oder (major != 2 und major != 3):
            gib_zurück wahr
        setze i auf erster
        solange i < erster + anzahl:
            wenn speicher_lesen(adresse_von(XH_PROTO) + i, 1) != 0:
                gib_zurück falsch
            speicher_schreiben(adresse_von(XH_PROTO) + i, major, 1)
            setze i auf i + 1
        xh_setze(35, xh(35) + 1)
        gib_zurück wahr

# Gemeinsame 1-s-Frist fuer ALLE Ports: ein frueher Boot-Stick beendet
# das Warten auf einen spaeter sichtbaren Unifying-Empfaenger nicht.
@nativ
funktion xh_ports_vorbereiten() -> void:
    unsicher:
        setze port: u64 auf 1
        setze p: u64 auf 0
        setze v: u32 auf 0
        setze start: u64 auf 0
        solange port <= xh(28):
            setze p auf xh(1) + 0x400 + (port - 1) * 16
            setze v auf nt_mmio_lese32(p)
            wenn xh(27) != 0 und (v & 512) == 0:
                nt_mmio_schreibe32(p, (v & 0x0E00C200) | 512)
            setze port auf port + 1
        setze start auf takt()
        solange takt() - start < 1000000 * xh(18):
            setze port auf 1
            solange port <= xh(28):
                setze p auf xh(1) + 0x400 + (port - 1) * 16
                setze v auf nt_mmio_lese32(p)
                wenn (v & 0x20000) != 0:
                    speicher_schreiben(adresse_von(XH_CSC) + port, 1, 1)
                    # CSC ist RW1C; nur das beobachtete Bit quittieren.
                    nt_mmio_schreibe32(p, (v & 0x0E00C200) | 0x20000)
                setze port auf port + 1
            xh_warte_us(10000)
        xh_ports_bild(2)



@nativ
funktion xh_kontext() -> u64:
    unsicher:
        setze adr: u64 auf speicher_lesen(adresse_von(XH_AKTIV), 8)
        wenn adr != 0:
            gib_zurück adr
        gib_zurück adresse_von(XH)

@nativ
funktion xh_waehle(adr: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(XH_AKTIV), adr, 8)

@nativ
funktion xh(f: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(xh_kontext() + f * 8, 8)

@nativ
funktion xh_setze(f: u64, w: u64) -> void:
    unsicher:
        speicher_schreiben(xh_kontext() + f * 8, w, 8)

@nativ
funktion xh_hid_slot(slot: u64) -> u64:
    unsicher:
        gib_zurück xh(4) + 64 * 4096 + (slot - 1) * 4 * 4096

@nativ
funktion xh_ausgabe() -> u64:
    unsicher:
        wenn xh(51) != 0:
            gib_zurück xh_hid_slot(xh(10))
        gib_zurück xh(4) + 20480

@nativ
funktion xh_ring_basis(seite: u64) -> u64:
    unsicher:
        wenn xh(51) != 0:
            wenn seite == 6 oder seite == 7:
                gib_zurück xh_ausgabe() + (seite - 5) * 4096
            wenn seite == 9:
                gib_zurück xh_ausgabe() + 3 * 4096
        gib_zurück xh(4) + seite * 4096

@nativ
funktion xh_null(p: u64, n: u64) -> void:
    unsicher:
        nt_null(p, n)

# TSC ist bereits vom vorhandenen Kern kalibriert.
@nativ
funktion xh_warte_us(us: u64) -> void:
    unsicher:
        setze start: u64 auf takt()
        solange takt() - start < us * xh(18):
            assembler(ziel="x86_64", code="pause", clobber=["memory"])

@nativ
funktion xh_warte_bit(p: u64, maske: u32, soll: u32) -> bool:
    unsicher:
        setze start: u64 auf takt()
        solange takt() - start < 1000000 * xh(18):
            wenn (nt_mmio_lese32(p) & maske) == soll:
                gib_zurück wahr
        gib_zurück falsch

@nativ
funktion xh_reg64(p: u64, w: u64) -> void:
    unsicher:
        nt_mmio_schreibe32(p, u32(w))
        nt_mmio_schreibe32(p + 4, u32(w >> 32))

# Producer: Parameter/Status vor dem Cycle-Bit publizieren. Link-TRB am Ende
# toggelt Cycle (TC=1); pro Ring ist hoechstens ein TD gleichzeitig ausstehend.
@nativ
funktion xh_trb(seite: u64, indexfeld: u64, parameter: u64, status: u32, steuer: u32, freigeben: bool) -> u64:
    unsicher:
        setze basis: u64 auf xh_ring_basis(seite)
        setze index: u64 auf xh(indexfeld)
        setze cycle: u64 auf xh(indexfeld + 1)
        setze p: u64 auf basis + index * 16
        setze bereit: u32 auf u32(cycle)
        wenn nicht freigeben:
            setze bereit auf bereit ^ 1
        speicher_schreiben(p, parameter, 8)
        speicher_schreiben(p + 8, status, 4)
        schreibbarriere()
        nt_mmio_schreibe32(p + 12, steuer | bereit)
        setze index auf index + 1
        wenn index == 255:
            speicher_schreiben(basis + 4080, basis, 8)
            speicher_schreiben(basis + 4088, 0, 4)
            schreibbarriere()
            nt_mmio_schreibe32(basis + 4092, (6 << 10) | 2 | u32(cycle) | (steuer & 16))
            setze index auf 0
            setze cycle auf cycle ^ 1
        xh_setze(indexfeld, index)
        xh_setze(indexfeld + 1, cycle)
        gib_zurück p

# Der Event Ring Dequeue Pointer folgt dem Consumer. Bit 3 (EHB) ist W1C,
# xHCI 1.2b §5.5.2.3.3.
@nativ
funktion xh_eventring_freigeben() -> void:
    unsicher:
        xh_reg64(xh(3) + 0x38, (xh(4) + 8192 + xh(8) * 16) | 8)

# xHCI 1.2b 6.4.2: jede Command-/Transfer-Completion vor dem Filtern protokollieren.
# Command PARAM24 ist keine Restlaenge (6.4.2.2); Transfer REST bleibt unveraendert.
@nativ
funktion xh_event_holen() -> bool:
    unsicher:
        setze p: u64 auf xh(4) + 8192 + xh(8) * 16
        setze steuer: u32 auf nt_mmio_lese32(p + 12)
        setze status: u32 auf 0
        setze ereignis: u32 auf 0
        setze parameter: u64 auf 0
        wenn (steuer & 1) != u32(xh(9)):
            gib_zurück falsch
        lesebarriere()
        setze parameter auf speicher_lesen(p, 8)
        setze status auf u32(speicher_lesen(p + 8, 4))
        setze ereignis auf (steuer >> 10) & 63
        # Alle Daten lokal sichern. Der MSI-Pfad quittiert EHB für den ganzen Batch.
        xh_setze(8, xh(8) + 1)
        wenn xh(8) == 256:
            xh_setze(8, 0)
            xh_setze(9, xh(9) ^ 1)
        wenn xh(17) == 0:
            xh_eventring_freigeben()
        wenn (ereignis == 32 oder ereignis == 33) und (xh(21) == 0 oder (status >> 24) != 1 oder u64(steuer >> 24) != xh(10)):
            xh_log(adresse_von(XH_T_EVT_TYP), u64(ereignis))
            xh_log(adresse_von(XH_T_EVT_TRB), parameter)
            xh_log(adresse_von(XH_T_EVT_STATUS), u64(status))
            xh_log(adresse_von(XH_T_EVT_STEUER), u64(steuer))
            xh_log(adresse_von(XH_T_EVT_SLOT), u64(steuer >> 24))
            xh_log(adresse_von(XH_T_EVT_CC), u64(status >> 24))
            wenn ereignis == 32:
                xh_log(adresse_von(XH_T_EVT_EP), u64((steuer >> 16) & 31))
                xh_log(adresse_von(XH_T_EVT_REST), u64(status & 0xFFFFFF))
            sonst:
                xh_log(adresse_von(XH_T_EVT_PARAM), u64(status & 0xFFFFFF))
        xh_setze(47, parameter)
        xh_setze(48, u64(status))
        xh_setze(49, u64(steuer))
        gib_zurück wahr

@nativ
funktion xh_event(typ: u32, erwartet: u64) -> u32:
    unsicher:
        wenn nicht xh_event_holen():
            gib_zurück 0
        wenn xh(17) != 0:
            xh_msi_status_quittieren()
            xh_eventring_freigeben()
        setze steuer: u32 auf u32(xh(49))
        setze status: u32 auf u32(xh(48))
        setze ereignis: u32 auf (steuer >> 10) & 63
        setze parameter: u64 auf xh(47)
        setze code: u32 auf 0
        setze passend: bool auf falsch
        setze passend auf ereignis == typ und parameter == erwartet
        wenn ereignis == 32:
            # Keine Event-Data-TRBs verwendet; Slot und Endpoint gehoeren zur Anfrage.
            setze passend auf passend und (steuer & 4) == 0 und u64(steuer >> 24) == xh(10)
            wenn typ == 32 und xh(39) != 0 und erwartet == xh(41):
                setze passend auf (steuer & 4) == 0 und u64(steuer >> 24) == xh(10) und ((steuer >> 16) & 31) == 1 und (parameter == xh(39) oder parameter == xh(40) oder parameter == xh(41))
            sonst:
                setze passend auf passend und u64((steuer >> 16) & 31) == xh(11)
        wenn passend:
            xh_setze(36, u64(status))
            xh_setze(37, u64(steuer))
            xh_setze(38, parameter)
            setze code auf status >> 24
            wenn ereignis == 33:
                xh_setze(22, u64(steuer >> 24))
            # 6.4.1.2.2: Short Data beendet die Data-TD, danach Status abwarten.
            wenn ereignis == 32 und xh(39) != 0 und parameter == xh(40) und code == 13 und u64(status & 0xFFFFFF) <= xh(42):
                xh_setze(43, xh(42) - u64(status & 0xFFFFFF))
                gib_zurück 0
        sonst wenn xh(24) != 0:
            xh_hid_ereignis(xh(24))
        gib_zurück code

@nativ
funktion xh_ergebnis_frist(typ: u32, p: u64, mikrosekunden: u64) -> u32:
    unsicher:
        setze start: u64 auf takt()
        setze code: u32 auf 0
        xh_setze(36, 0)
        solange takt() - start < mikrosekunden * xh(18):
            setze code auf xh_event(typ, p)
            wenn code != 0:
                # Rohes CC behalten; Control-Short-Data wird bereits in xh_event gepaart.
                gib_zurück code
        xh_setze(36, 0)
        xh_log(adresse_von(XH_T_WARTE_TYP), u64(typ))
        xh_log(adresse_von(XH_T_WARTE_TRB), p)
        gib_zurück 0
@nativ
funktion xh_ergebnis(typ: u32, p: u64) -> u32:
    unsicher:
        gib_zurück xh_ergebnis_frist(typ, p, 1000000)

@nativ
funktion xh_abschluss(typ: u32, p: u64) -> bool:
    unsicher:
        setze code: u32 auf xh_ergebnis(typ, p)
        # Command/EP0-Erfolg nur am erwarteten TRB ohne Restdaten.
        gib_zurück code == 1 und xh(38) == p und (typ != 32 oder (xh(36) & 0xFFFFFF) == 0)

@nativ
funktion xh_befehl(parameter: u64, steuer: u32) -> bool:
    unsicher:
        setze p: u64 auf xh_trb(1, 6, parameter, 0, steuer, wahr)
        nt_mmio_glocke32(xh(2), 0)
        gib_zurück xh_abschluss(33, p)

# Control-Stufen sind eigene TDs (xHCI 1.2b 6.4.1.2): kein CH zwischen ihnen.
# Setup zuletzt freigeben, wie Linux xhci_queue_ctrl_tx/giveback_first_trb.
@nativ
funktion xh_control_bauen(setup: u64, daten: u64, laenge: u32) -> u64:
    unsicher:
        setze trt: u32 auf 0
        setze dir: u32 auf 0
        xh_setze(39, 0)
        xh_setze(40, 0)
        xh_setze(41, 0)
        wenn laenge > 4096 oder u64(laenge) != (setup >> 48):
            gib_zurück 0
        wenn laenge != 0:
            wenn daten == 0 oder (daten & 65535) + u64(laenge) > 65536:
                gib_zurück 0
            setze dir auf u32((setup >> 7) & 1)
            setze trt auf (2 + dir) << 16
        xh_setze(42, u64(laenge))
        xh_setze(43, u64(laenge))
        # Setup Bits4:1 sind RsvdZ, IDT=1, Transfer Length=8.
        xh_setze(39, xh_trb(6, 12, setup, 8, (2 << 10) | 64 | trt, falsch))
        wenn laenge != 0:
            # Eine Data-TRB ist die ganze Data-TD: CH=0, ISP nur fuer IN, IDT=0.
            xh_setze(40, xh_trb(6, 12, daten, laenge, (3 << 10) | (dir << 16) | (dir << 2), wahr))
        setze trt auf 1 << 16
        wenn laenge != 0 und dir == 1:
            setze trt auf 0
        xh_setze(41, xh_trb(6, 12, 0, 0, (4 << 10) | 32 | trt, wahr))
        xh_log(adresse_von(XH_T_CTRL_SETUP), u64(nt_mmio_lese32(xh(39) + 12)))
        wenn laenge != 0:
            xh_log(adresse_von(XH_T_CTRL_DATA), u64(nt_mmio_lese32(xh(40) + 12)))
        xh_log(adresse_von(XH_T_CTRL_STATUS), u64(nt_mmio_lese32(xh(41) + 12)))
        gib_zurück xh(41)

# Maximal drei Control-Versuche, nur USB Transaction Error + Halted erneut.
# Kein Stall-/Timeout-/TRB-Error-Retry. Reset Endpoint nur bei EP State=Halted;
# danach Set TR Dequeue auf eine NEU aufgebaute Setup-TD (xHCI 4.6.8/4.6.10).
@nativ
funktion xh_control(setup: u64, daten: u64, laenge: u32) -> bool:
    unsicher:
        setze versuch: u64 auf 1
        setze p: u64 auf 0
        setze ok: bool auf falsch
        setze umsetzen: bool auf falsch
        solange versuch <= 3:
            xh_log(adresse_von(XH_T_CTRL_REQUEST), setup)
            xh_log(adresse_von(XH_T_CTRL_VERSUCH), versuch)
            setze p auf xh_control_bauen(setup, daten, laenge)
            wenn p == 0:
                gib_zurück falsch
            wenn umsetzen:
                # Erst Setup gueltig aufbauen, Dequeue mit deren PCS initialisieren.
                wenn nicht xh_befehl(xh(39) | u64((nt_mmio_lese32(xh(39) + 12) ^ 1) & 1), (16 << 10) | (1 << 16) | u32(xh(10) << 24)):
                    xh_setze(39, 0)
                    gib_zurück falsch
            schreibbarriere()
            nt_mmio_schreibe32(xh(39) + 12, nt_mmio_lese32(xh(39) + 12) ^ 1)
            nt_mmio_glocke32(xh(2) + xh(10) * 4, 1)
            setze ok auf xh_abschluss(32, p)
            xh_setze(39, 0)
            wenn ok:
                xh_log(adresse_von(XH_T_CTRL_LAENGE), xh(43))
                gib_zurück wahr
            xh_context_bild()
            lesebarriere()
            wenn (xh(36) >> 24) != 4 oder versuch == 3 oder (speicher_lesen(xh_ausgabe() + xh(5), 4) & 7) != 2:
                gib_zurück falsch
            wenn nicht xh_befehl(0, (14 << 10) | (1 << 16) | u32(xh(10) << 24)):
                gib_zurück falsch
            setze umsetzen auf wahr
            setze versuch auf versuch + 1
            # Linux hub_port_init wartet zwischen Descriptor-Versuchen 100 ms.
            xh_warte_us(100000)
        gib_zurück falsch

# PCI-Mechanismus 1 durchsucht Segment 0; Klasse/Subklasse/ProgIF exakt.
@nativ
funktion xh_pci(bdf: u32, off: u32) -> u32:
    unsicher:
        gib_zurück nt_cfg_lese32(0x80000000 | (bdf << 8) | off)

# USBSTS.EINT vor dem Eventring quittieren. Bei MSI wird IMAN.IP bei
# der Zustellung geloescht (Linux v6.12 xhci-ring.c:3017–3026,3104–3127).
@nativ
funktion xh_msi_status_quittieren() -> bool:
    unsicher:
        setze status: u64 auf xh(1) + 4
        wenn (nt_mmio_lese32(status) & 8) == 0:
            gib_zurück falsch
        nt_mmio_schreibe32(status, 8)
        gib_zurück wahr

@nativ
funktion xh_msi_starten(pci: u64, ziel: u64, ruf: u64) -> u64:
    unsicher:
        setze v: u64 auf kern_irq_msi(pci, xh(29), ziel, ruf, 0)
        setze msix: bool auf falsch
        wenn v == 0:
            setze v auf kern_irq_msix(pci, xh(29), ziel, 0, xh(0), 1048576, 0, ruf, 0)
            setze msix auf v != 0
        wenn v == 0:
            gib_zurück 0
        xh_msi_status_quittieren()
        xh_eventring_freigeben()
        setze iman: u64 auf xh(3) + 0x20
        setze cmd: u32 auf nt_mmio_lese32(xh(1))
        # Altes IP quittieren, danach IE und INTE setzen (xHCI §5.5.2.1).
        nt_mmio_schreibe32(iman, 1)
        nt_mmio_schreibe32(iman, 2)
        nt_mmio_schreibe32(xh(1), cmd | 4)
        wenn (nt_mmio_lese32(iman) & 2) != 0 und (nt_mmio_lese32(xh(1)) & 4) != 0:
            wenn msix:
                xh_log(adresse_von(XH_T_MSIX), v)
            gib_zurück v
        nt_mmio_schreibe32(xh(1), cmd & 0xFFFFFFFB)
        nt_mmio_schreibe32(iman, 1)
        kern_irq_stoppen(v)
        gib_zurück 0

@nativ
funktion xh_stop() -> bool:
    unsicher:
        wenn xh(1) == 0:
            gib_zurück wahr
        nt_mmio_schreibe32(xh(1), 0)
        gib_zurück xh_warte_bit(xh(1) + 4, 1, 1)

# Controller-Reset und Eigentumsuebernahme gemaess USB Legacy Support.
@nativ
funktion xh_controller(bdf: u32, bi: u64, map: u64) -> bool:
    unsicher:
        setze bar: u32 auf xh_pci(bdf, 16)
        setze cap: u64 auf u64(bar & 0xFFFFFFF0)
        setze e: u64 auf 0
        setze n: u64 auf 0
        setze v: u32 auf 0
        setze scratch: u64 auf 0
        xh_setze(29, u64(bdf))
        xh_log(adresse_von(XH_T_BDF), u64(bdf))
        xh_setze(19, 11)
        wenn (bar & 1) != 0:
            gib_zurück falsch
        wenn (bar & 6) == 4:
            setze cap auf cap | (u64(xh_pci(bdf, 20)) << 32)
        xh_setze(0, cap)
        xh_setze(23, cap)
        xh_setze(19, 12)
        wenn cap == 0:
            gib_zurück falsch
        setze abbilden: ptr[fn[sysv64](u64, u64, u64) -> u64] auf zeiger(map)
        setze cap auf abbilden(bi, cap, 1048576)
        wenn cap == 0:
            gib_zurück falsch
        nt_cfg_schreibe32(0x80000004 | (bdf << 8), (xh_pci(bdf, 4) & 0xFFFF) | 0x406)
        xh_setze(0, cap)
        wenn (nt_mmio_lese32(cap) & 255) < 32 oder (nt_mmio_lese32(cap + 20) & 0xFFFFFFFC) >= 0xFF000 oder (nt_mmio_lese32(cap + 24) & 0xFFFFFFE0) >= 0xFF000:
            gib_zurück falsch
        xh_setze(1, cap + u64(nt_mmio_lese32(cap) & 255))
        xh_setze(2, cap + u64(nt_mmio_lese32(cap + 20) & 0xFFFFFFFC))
        xh_setze(3, cap + u64(nt_mmio_lese32(cap + 24) & 0xFFFFFFE0))
        xh_setze(5, 32)
        wenn (nt_mmio_lese32(cap + 16) & 4) != 0:
            xh_setze(5, 64)
        xh_setze(27, u64((nt_mmio_lese32(cap + 16) >> 3) & 1))
        xh_setze(28, u64(nt_mmio_lese32(cap + 4) >> 24))
        xh_null(adresse_von(XH_PROTO), 256)
        xh_null(adresse_von(XH_CSC), 256)
        xh_log(adresse_von(XH_T_HCS1), u64(nt_mmio_lese32(cap + 4)))
        xh_log(adresse_von(XH_T_HCS2), u64(nt_mmio_lese32(cap + 8)))
        xh_log(adresse_von(XH_T_HCC1), u64(nt_mmio_lese32(cap + 16)))
        xh_setze(19, 13)
        setze e auf u64(nt_mmio_lese32(cap + 16) >> 16) * 4
        solange e != 0 und n < 256:
            wenn e + 16 > 0x100000:
                gib_zurück falsch
            setze v auf nt_mmio_lese32(cap + e)
            wenn (v & 255) == 1:
                nt_mmio_schreibe32(cap + e, v | (1 << 24))
                wenn nicht xh_warte_bit(cap + e, 1 << 16, 0):
                    gib_zurück falsch
                # SMI-Enable-Bits aus, Statusbits quittieren.
                nt_mmio_schreibe32(cap + e + 4, 0xE0000000)
            wenn (v & 255) == 2:
                wenn nicht xh_protokoll(cap, e, v):
                    gib_zurück falsch
            wenn ((v >> 8) & 255) == 0:
                setze e auf 0
            sonst:
                setze e auf e + u64((v >> 8) & 255) * 4
            setze n auf n + 1
        wenn e != 0:
            gib_zurück falsch
        xh_ports_bild(0)
        xh_setze(19, 2)
        wenn nicht xh_stop():
            gib_zurück falsch
        nt_mmio_schreibe32(xh(1), 2)
        wenn nicht xh_warte_bit(xh(1), 2, 0) oder nicht xh_warte_bit(xh(1) + 4, 1 << 11, 0):
            gib_zurück falsch
        xh_ports_bild(1)
        wenn (nt_mmio_lese32(xh(1) + 8) & 1) == 0 oder (nt_mmio_lese32(cap + 4) & 255) == 0:
            gib_zurück falsch
        xh_null(xh(4), 64 * 4096)
        setze v auf nt_mmio_lese32(cap + 8)
        setze scratch auf u64(((v >> 27) & 31) | (((v >> 21) & 31) << 5))
        wenn scratch > 54:
            gib_zurück falsch
        wenn scratch != 0:
            speicher_schreiben(xh(4), xh(4) + 2048, 8)
            setze n auf 0
            solange n < scratch:
                speicher_schreiben(xh(4) + 2048 + n * 8, xh(4) + (10 + n) * 4096, 8)
                setze n auf n + 1
        xh_setze(6, 0)
        xh_setze(7, 1)
        xh_setze(8, 0)
        xh_setze(9, 1)
        speicher_schreiben(xh(4) + 12288, xh(4) + 8192, 8)
        speicher_schreiben(xh(4) + 12296, 256, 4)
        schreibbarriere()
        xh_reg64(xh(1) + 0x30, xh(4))
        xh_reg64(xh(1) + 0x18, (xh(4) + 4096) | 1)
        nt_mmio_schreibe32(xh(3) + 0x28, 1)
        xh_reg64(xh(3) + 0x30, xh(4) + 12288)
        xh_reg64(xh(3) + 0x38, xh(4) + 8192)
        nt_mmio_schreibe32(xh(3) + 0x20, 0)
        # HCSPARAMS1.MaxSlots begrenzt CONFIG.MaxSlotsEn (xHCI 1.2b 5.3.3/5.4.7).
        setze v auf nt_mmio_lese32(cap + 4) & 255
        wenn u64(v) < xh(46):
            xh_setze(46, u64(v))
        nt_mmio_schreibe32(xh(1) + 0x38, u32(xh(46)))
        nt_mmio_glocke32(xh(1), 1)
        wenn nicht xh_warte_bit(xh(1) + 4, 1, 0):
            gib_zurück falsch
        xh_ports_vorbereiten()
        gib_zurück wahr

@nativ
funktion xh_port(port: u64) -> u64:
    unsicher:
        setze p: u64 auf xh(1) + 0x400 + (port - 1) * 16
        setze v: u32 auf nt_mmio_lese32(p)
        setze protokoll: u8 auf speicher_lesen(adresse_von(XH_PROTO) + port, 1)
        setze reset: u32 auf 16
        setze ok: bool auf wahr
        xh_port_bild(port, 3)
        wenn (v & 1) == 0 oder (protokoll != 2 und protokoll != 3):
            gib_zurück 0
        wenn (v & 0x20000) != 0:
            speicher_schreiben(adresse_von(XH_CSC) + port, 1, 1)
            nt_mmio_schreibe32(p, (v & 0x0E00C200) | 0x20000)
            xh_warte_us(100000)
            setze v auf nt_mmio_lese32(p)
            wenn (v & 1) == 0:
                gib_zurück 0
        # USB2: PR. USB3: U0/PED erhalten, sonst WPR. Auswahl aus ID2.
        wenn protokoll == 3:
            setze reset auf 0x80000000
            wenn (v & 3) == 3 und ((v >> 5) & 15) == 0:
                setze reset auf 0
        wenn reset != 0:
            nt_mmio_schreibe32(p, (v & 0x0E00C200) | reset)
            setze ok auf xh_warte_bit(p, reset, 0)
            wenn ok:
                setze ok auf xh_warte_bit(p, 3, 3)
        xh_port_bild(port, 4)
        wenn nicht ok:
            gib_zurück 0
        xh_warte_us(10000)
        xh_port_bild(port, 5)
        setze v auf nt_mmio_lese32(p)
        wenn (v & 3) != 3 oder ((v >> 5) & 15) != 0:
            gib_zurück 0
        nt_mmio_schreibe32(p, (v & 0x0E00C200) | (v & 0x00FE0000))
        gib_zurück u64((v >> 10) & 15)

# Output Context erst nach Command-Completion lesen; CSZ ist 32 oder 64 Byte.
# xHCI 1.2b 6.2.2 (Slot DWORD3) / 6.2.3 (EP DWORD0/1/2/3).
@nativ
funktion xh_context_bild() -> void:
    unsicher:
        setze out: u64 auf xh_ausgabe()
        setze ep: u64 auf out + xh(5)
        lesebarriere()
        setze slot: u32 auf u32(speicher_lesen(out + 12, 4))
        setze ep0: u32 auf u32(speicher_lesen(ep, 4))
        setze ep1: u32 auf u32(speicher_lesen(ep + 4, 4))
        xh_log(adresse_von(XH_T_SLOT0), u64(speicher_lesen(out, 4)))
        xh_log(adresse_von(XH_T_SLOT1), u64(speicher_lesen(out + 4, 4)))
        xh_log(adresse_von(XH_T_SLOT3), u64(slot))
        xh_log(adresse_von(XH_T_SLOT_STATE), u64((slot >> 27) & 31))
        xh_log(adresse_von(XH_T_ADRESSE), u64(slot & 255))
        xh_log(adresse_von(XH_T_EP0_0), u64(ep0))
        xh_log(adresse_von(XH_T_EP0_1), u64(ep1))
        xh_log(adresse_von(XH_T_EP0_DEQ), speicher_lesen(ep + 8, 8))
        xh_log(adresse_von(XH_T_EP0_STATE), u64(ep0 & 7))
        xh_log(adresse_von(XH_T_EP0_MPS), u64(ep1 >> 16))

@nativ
funktion xh_ep0(mps: u64) -> void:
    unsicher:
        setze ep: u64 auf xh(4) + 16384 + 2 * xh(5)
        speicher_schreiben(ep + 4, u32((mps << 16) | 38), 4)
        speicher_schreiben(ep + 8, xh_ring_basis(6) | 1, 8)
        speicher_schreiben(ep + 16, 8, 4)

# Ergebnis 1 nur fuer Interface Class=3/Subclass=1/Protocol=1, AltSetting=0
# und einen Interrupt-IN-Endpunkt. Alle Deskriptorlaengen werden begrenzt.
# Vorhandene Boot-Keyboard-Auswahl als eigener, bounds-gepruefter Parser.
# Composite HID: Boot-Maus und Report-HID ueberspringen, Alternate0 und
# Klassen-Tripel 03/01/01 plus Interrupt-IN im selben Interface verlangen.
@nativ
funktion xh_boot_interface(desc: u64, laenge: u64) -> bool:
    unsicher:
        setze pos: u64 auf 0
        setze n: u64 auf 0
        setze typ: u64 auf 0
        setze hid: u64 auf 0
        setze ep: u64 auf 0
        setze paket: u64 auf 0
        setze intervall: u64 auf 0
        setze boot: bool auf falsch
        xh_setze(30, 0)
        xh_setze(31, 0)
        xh_setze(32, 0)
        xh_setze(33, 0)
        xh_setze(34, 0)
        wenn laenge < 9 oder laenge > 4096:
            gib_zurück falsch
        wenn speicher_lesen(desc, 1) < 9 oder speicher_lesen(desc + 1, 1) != 2 oder u64(speicher_lesen(desc + 2, 2)) != laenge oder speicher_lesen(desc + 5, 1) == 0:
            gib_zurück falsch
        solange pos + 2 <= laenge:
            setze n auf u64(speicher_lesen(desc + pos, 1))
            setze typ auf u64(speicher_lesen(desc + pos + 1, 1))
            wenn n < 2 oder pos + n > laenge:
                gib_zurück falsch
            wenn typ == 4:
                wenn n < 9:
                    gib_zurück falsch
                setze boot auf speicher_lesen(desc + pos + 3, 1) == 0 und speicher_lesen(desc + pos + 4, 1) != 0 und speicher_lesen(desc + pos + 5, 1) == 3 und speicher_lesen(desc + pos + 6, 1) == 1 und speicher_lesen(desc + pos + 7, 1) == 1
                setze hid auf u64(speicher_lesen(desc + pos + 2, 1))
            wenn typ == 5 und boot:
                wenn n < 7:
                    gib_zurück falsch
                setze ep auf u64(speicher_lesen(desc + pos + 2, 1))
                setze paket auf u64(speicher_lesen(desc + pos + 4, 2)) & 2047
                setze intervall auf u64(speicher_lesen(desc + pos + 6, 1))
                wenn (ep & 0x80) != 0 und (ep & 0x70) == 0 und (ep & 15) != 0 und (speicher_lesen(desc + pos + 3, 1) & 3) == 3 und paket >= 8 und paket <= 1024 und intervall != 0:
                    xh_setze(30, hid)
                    xh_setze(31, ep)
                    xh_setze(32, paket)
                    xh_setze(33, intervall)
                    xh_setze(34, u64(speicher_lesen(desc + 5, 1)))
                    gib_zurück wahr
            setze pos auf pos + n
        gib_zurück falsch

@nativ
funktion xh_adressieren(port: u64, speed: u64) -> bool:
    unsicher:
        setze input: u64 auf xh(4) + 16384
        setze desc: u64 auf xh(4) + 32768
        setze mps: u64 auf 8
        setze n: u64 auf 0
        setze boot: bool auf falsch
        xh_setze(19, 4)
        wenn nicht xh_befehl(0, 9 << 10):
            gib_zurück falsch
        xh_setze(10, xh(22))
        wenn xh(10) == 0 oder xh(10) > xh(46):
            gib_zurück falsch
        xh_null(input, 4096)
        xh_null(xh_ausgabe(), 3 * 4096)
        xh_setze(12, 0)
        xh_setze(13, 1)
        xh_setze(14, 0)
        xh_setze(15, 1)
        speicher_schreiben(xh(4) + xh(10) * 8, xh_ausgabe(), 8)
        speicher_schreiben(input + 4, 3, 4)
        speicher_schreiben(input + xh(5), u32((speed << 20) | (1 << 27)), 4)
        speicher_schreiben(input + xh(5) + 4, u32(port << 16), 4)
        wenn speed == 3:
            setze mps auf 64
        wenn speed >= 4:
            setze mps auf 512
        xh_ep0(mps)
        wenn nicht xh_befehl(input, (11 << 10) | u32(xh(10) << 24)):
            gib_zurück falsch
        xh_context_bild()
        # Software-Recovery nach SET_ADDRESS (xHCI 4.6.5; Linux hub.c:4742-4751).
        xh_warte_us(10000)
        xh_setze(19, 5)
        xh_null(desc, 8)
        setze boot auf xh_control(0x0008000001000680, desc, 8)
        xh_log(adresse_von(XH_T_DESC8), speicher_lesen(desc, 8))
        setze n auf u64(speicher_lesen(desc + 7, 1))
        xh_log(adresse_von(XH_T_DESC_MPS), n)
        wenn nicht boot oder xh(43) < 8 oder speicher_lesen(desc, 2) != 0x0112:
            gib_zurück falsch
        wenn speed >= 4:
            wenn n != 9:
                gib_zurück falsch
            setze n auf 512
        wenn n != 8 und n != 16 und n != 32 und n != 64 und n != 512:
            gib_zurück falsch
        wenn n != mps:
            speicher_schreiben(input, 0, 4)
            speicher_schreiben(input + 4, 2, 4)
            # Evaluate Context aktualisiert nur MPS, der bestehende Dequeue bleibt.
            speicher_schreiben(input + 2 * xh(5) + 4, u32((n << 16) | 38), 4)
            wenn nicht xh_befehl(input, (13 << 10) | u32(xh(10) << 24)):
                gib_zurück falsch
        wenn nicht xh_control(0x0012000001000680, desc, 18) oder xh(43) < 18 oder speicher_lesen(desc, 2) != 0x0112:
            gib_zurück falsch
        xh_log(adresse_von(XH_T_KLASSE), u64(speicher_lesen(desc + 4, 1)))
        xh_log(adresse_von(XH_T_VID), u64(speicher_lesen(desc + 8, 2)))
        xh_log(adresse_von(XH_T_PID), u64(speicher_lesen(desc + 10, 2)))
        gib_zurück wahr

@nativ
funktion xh_konfiguration_lesen(index: u64) -> u64:
    unsicher:
        setze desc: u64 auf xh(4) + 32768
        setze setup: u64 auf 0x02000680 | (index << 16)
        wenn nicht xh_control((u64(9) << 48) | setup, desc, 9) oder xh(43) < 9:
            gib_zurück 0
        wenn speicher_lesen(desc, 1) < 9 oder speicher_lesen(desc + 1, 1) != 2:
            gib_zurück 0
        setze laenge: u64 auf u64(speicher_lesen(desc + 2, 2))
        wenn laenge < 9 oder laenge > 4096:
            gib_zurück 0
        wenn nicht xh_control((laenge << 48) | setup, desc, u32(laenge)) oder xh(43) < laenge:
            gib_zurück 0
        wenn speicher_lesen(desc, 1) < 9 oder speicher_lesen(desc + 1, 1) != 2 oder u64(speicher_lesen(desc + 2, 2)) != laenge:
            gib_zurück 0
        gib_zurück laenge

@nativ
funktion xh_beschreiben(port: u64, speed: u64, ziel_id: u64) -> u64:
    unsicher:
        wenn nicht xh_adressieren(port, speed):
            gib_zurück 0
        # Identitaetsfilter vor Config/BOT; 0 bedeutet beliebiges USB-Geraet.
        wenn ziel_id != 0 und u64(speicher_lesen(xh(4) + 32768 + 8, 4)) != ziel_id:
            gib_zurück 0
        gib_zurück xh_konfiguration_lesen(0)

@nativ
konstante XH_T_HID_BEREIT_PORT: [u8; _] auf "MOO-KERNEL USB HID BEREIT PORT "
@nativ
konstante XH_T_HID_BEREIT_SPEED: [u8; _] auf "MOO-KERNEL USB HID BEREIT SPEED "
@nativ
konstante XH_T_HID_BEREIT_SLOT: [u8; _] auf "MOO-KERNEL USB HID BEREIT SLOT "
@nativ
konstante XH_T_HID_INTERVALL: [u8; _] auf "MOO-KERNEL USB HID INTERVALL "
@nativ
konstante XH_T_REPORT_BYTES: [u8; _] auf "MOO-KERNEL USB HID REPORT BYTES "

# HID 1.11 §6.2.1: Deskriptorliste beginnt bei bDescriptorType[0].
@nativ
funktion xh_hid_report_laenge(desc: u64, laenge: u64, interface_id: u64) -> u64:
    unsicher:
        setze pos: u64 auf 0
        setze passt: bool auf falsch
        solange pos + 2 <= laenge:
            setze n: u64 auf u64(speicher_lesen(desc + pos, 1))
            setze art: u64 auf u64(speicher_lesen(desc + pos + 1, 1))
            wenn n < 2 oder n > laenge - pos:
                gib_zurück 0
            wenn art == 4:
                wenn n < 9:
                    gib_zurück 0
                setze passt auf u64(speicher_lesen(desc + pos + 2, 1)) == interface_id und speicher_lesen(desc + pos + 3, 1) == 0
            wenn passt und art == 0x21 und n >= 6:
                setze i: u64 auf 0
                setze anzahl: u64 auf u64(speicher_lesen(desc + pos + 5, 1))
                wenn 6 + anzahl * 3 > n:
                    gib_zurück 0
                solange i < anzahl:
                    setze p: u64 auf desc + pos + 6 + i * 3
                    wenn speicher_lesen(p, 1) == 0x22:
                        gib_zurück u64(speicher_lesen(p + 1, 2))
                    setze i auf i + 1
            setze pos auf pos + n
        gib_zurück 0

# Standard GET_DESCRIPTOR, Empfaenger Interface. HID 1.11 §7.1.1.
@nativ
funktion xh_hid_report_lesen(daten: u64, interface_id: u64, laenge: u64) -> void:
    unsicher:
        # Die 0x22-Rohbytes gehoeren zur Diagnose und zum HID-Emulationsgate.
        wenn xh(50) == 0:
            gib_zurück
        setze empfangen: u64 auf 0
        wenn laenge > 0 und laenge <= 4096:
            wenn xh_control((laenge << 48) | (interface_id << 32) | 0x22000681, daten, u32(laenge)):
                setze empfangen auf xh(43)
        xh_log(adresse_von(XH_T_REPORT_BYTES), empfangen)
        wenn empfangen > 0 und empfangen <= laenge:
            xh_inventar_roh(daten, empfangen)

# Linux v6.12 xhci-mem.c:1220–1249,1294–1299: FS/LS bInterval in ms
# auf 125us-Einheiten und floor(log2), begrenzt auf 3..10.
@nativ
funktion xh_hid_intervall(speed: u64, intervall: u64) -> u64:
    unsicher:
        wenn speed >= 3:
            gib_zurück intervall - 1
        setze taktzahl: u64 auf 8
        setze exponent: u64 auf 3
        solange exponent < 10 und taktzahl * 2 <= intervall * 8:
            setze taktzahl auf taktzahl * 2
            setze exponent auf exponent + 1
        gib_zurück exponent

@nativ
@aufrufkonvention("sysv64")
funktion xh_geraet(port: u64, speed: u64) -> bool:
    unsicher:
        setze input: u64 auf xh(4) + 16384
        setze desc: u64 auf xh(4) + 32768
        setze laenge: u64 auf xh_beschreiben(port, speed, 0)
        setze hid_nummer: u64 auf 0
        setze ep: u64 auf 0
        setze paket: u64 auf 0
        setze intervall: u64 auf 0
        setze konfig: u64 auf 0
        wenn laenge == 0:
            gib_zurück falsch
        wenn nicht xh_boot_interface(desc, laenge):
            wenn XH_MSC_RUF[0] != 0:
                setze binden: ptr[fn[sysv64](u64, u64, u64) -> bool] auf zeiger(XH_MSC_RUF[0])
                wenn binden(port, speed, laenge):
                    xh_setze(20, xh(20) + 1)
                    gib_zurück wahr
            xh_log(adresse_von(XH_T_INTERFACE), 0xFFFFFFFF)
            gib_zurück falsch
        setze hid_nummer auf xh(30)
        setze ep auf xh(31)
        setze paket auf xh(32)
        setze intervall auf xh(33)
        setze konfig auf xh(34)
        setze report_laenge: u64 auf xh_hid_report_laenge(desc, laenge, hid_nummer)
        xh_log(adresse_von(XH_T_INTERFACE), hid_nummer)
        xh_log(adresse_von(XH_T_EP), ep)
        xh_setze(19, 6)
        wenn (speed == 2 und paket != 8) oder nicht xh_control((konfig << 16) | 0x0900, 0, 0):
            gib_zurück falsch
        # SET_PROTOCOL(Boot=0), Interface-Empfaenger, danach SET_IDLE(0).
        wenn nicht xh_control((hid_nummer << 32) | 0x0B21, 0, 0):
            gib_zurück falsch
        wenn nicht xh_control((hid_nummer << 32) | 0x0A21, 0, 0):
            gib_zurück falsch
        xh_setze(11, (ep & 15) * 2 + 1)
        xh_null(input, 4096)
        speicher_schreiben(input + 4, u32(1 | (u64(1) << xh(11))), 4)
        speicher_schreiben(input + xh(5), u32((speed << 20) | (xh(11) << 27)), 4)
        speicher_schreiben(input + xh(5) + 4, u32(port << 16), 4)
        setze intervall auf xh_hid_intervall(speed, intervall)
        wenn intervall > 15:
            gib_zurück falsch
        setze ep auf input + (xh(11) + 1) * xh(5)
        speicher_schreiben(ep, u32(intervall << 16), 4)
        speicher_schreiben(ep + 4, u32((paket << 16) | 62), 4)
        speicher_schreiben(ep + 8, xh_ring_basis(7) | 1, 8)
        speicher_schreiben(ep + 16, u32((paket << 16) | 8), 4)
        wenn nicht xh_befehl(input, (12 << 10) | u32(xh(10) << 24)):
            gib_zurück falsch
        # Das Konfigurieren des Interrupt-Endpoints ist vom 0x22-Diagnoseabruf
        # getrennt. Ein abgelehnter Descriptor stoppt den Polling-Slot nicht.
        xh_hid_report_lesen(desc, hid_nummer, report_laenge)
        setze zustand: u64 auf xh_ausgabe() + 3072
        speicher_schreiben(zustand + versatz_von(XhTastatur, port), port, 8)
        speicher_schreiben(zustand + versatz_von(XhTastatur, dci), xh(11), 8)
        speicher_schreiben(zustand + versatz_von(XhTastatur, zyklus), 1, 8)
        xh_setze(16, xh(16) + 1)
        xh_setze(19, 0)
        xh_log(adresse_von(XH_T_HID_BEREIT_PORT), port)
        xh_log(adresse_von(XH_T_HID_BEREIT_SPEED), speed)
        xh_log(adresse_von(XH_T_HID_BEREIT_SLOT), xh(10))
        xh_log(adresse_von(XH_T_HID_INTERVALL), intervall)
        gib_zurück wahr


@nativ
konstante XH_ZAHLEN: [u8; _] auf "1234567890"
@nativ
konstante XH_SHIFT_ZAHLEN: [u8; _] auf "!@#$%^&*()"
@nativ
konstante XH_ZEICHEN: [u8; 12] auf [45,61,91,93,92,35,59,39,96,44,46,47]
@nativ
konstante XH_SHIFT_ZEICHEN: [u8; 12] auf [95,43,123,125,124,126,58,34,126,60,62,63]

# USB Usage -> ASCII (US-Belegung), Shift/CapsLock; Steuer-/Alt-Kombinationen
# bleiben als HID-Marker sichtbar und erzeugen keinen druckbaren Text.
@nativ
funktion xh_ascii(usage: u64, mods: u64, caps: bool) -> u8:
    unsicher:
        setze shift: bool auf (mods & 0x22) != 0
        wenn (mods & 0xDD) != 0:
            gib_zurück 0
        wenn usage >= 4 und usage <= 29:
            wenn shift != caps:
                gib_zurück u8(usage + 61)
            gib_zurück u8(usage + 93)
        wenn usage >= 30 und usage <= 39:
            wenn shift:
                gib_zurück speicher_lesen(adresse_von(XH_SHIFT_ZAHLEN) + usage - 30, 1)
            gib_zurück speicher_lesen(adresse_von(XH_ZAHLEN) + usage - 30, 1)
        wenn usage == 40:
            gib_zurück 10
        wenn usage == 43:
            gib_zurück 9
        wenn usage == 44:
            gib_zurück 32
        wenn usage >= 45 und usage <= 56:
            wenn shift:
                gib_zurück speicher_lesen(adresse_von(XH_SHIFT_ZEICHEN) + usage - 45, 1)
            gib_zurück speicher_lesen(adresse_von(XH_ZEICHEN) + usage - 45, 1)
        gib_zurück 0

# Rollover/POSTFail/ErrorUndefined und reserviertes Byte verwerfen.
# Gleiche Usage im alten Report oder zweimal im neuen erzeugt keine Wiederholung.
@nativ
funktion xh_neue_taste(report: u64, vorher: u64, index: u64) -> u64:
    unsicher:
        setze usage: u64 auf (report >> (index * 8)) & 255
        setze j: u64 auf 2
        wenn index < 2 oder index > 7 oder (report & 0xFF00) != 0:
            gib_zurück 0
        solange j < 8:
            wenn ((report >> (j * 8)) & 255) >= 1 und ((report >> (j * 8)) & 255) <= 3:
                gib_zurück 0
            wenn ((vorher >> (j * 8)) & 255) == usage:
                gib_zurück 0
            wenn j < index und ((report >> (j * 8)) & 255) == usage:
                gib_zurück 0
            setze j auf j + 1
        gib_zurück usage

@nativ
funktion usb_report_pruefen() -> bool:
    unsicher:
        gib_zurück xh_ascii(4, 0, falsch) == 97 und xh_ascii(4, 2, falsch) == 65 und xh_ascii(4, 0, wahr) == 65 und xh_ascii(4, 2, wahr) == 97 und xh_ascii(55, 0, falsch) == 46 und xh_ascii(30, 2, falsch) == 33 und xh_neue_taste(0x0000000000040000, 0, 2) == 4 und xh_neue_taste(0x0000000000040000, 0x0000000000040000, 2) == 0 und xh_neue_taste(0x0000000001040000, 0, 2) == 0 und xh_neue_taste(0x0000000004040000, 0, 3) == 0

@nativ
funktion xh_hid_anfordern(slot: u64, zustand: u64) -> void:
    unsicher:
        setze p_index: u64 auf zustand + versatz_von(XhTastatur, index)
        setze p_zyklus: u64 auf zustand + versatz_von(XhTastatur, zyklus)
        setze dci: u64 auf speicher_lesen(zustand + versatz_von(XhTastatur, dci), 8)
        # HID kann beim synchronen Warten auf einen anderen Slot eintreffen.
        setze alt_slot: u64 auf xh(10)
        setze alt_index: u64 auf xh(14)
        setze alt_zyklus: u64 auf xh(15)
        xh_setze(10, slot)
        xh_setze(14, speicher_lesen(p_index, 8))
        xh_setze(15, speicher_lesen(p_zyklus, 8))
        setze trb: u64 auf xh_trb(7, 14, xh_ausgabe() + 2048, 8, (1 << 10) | 32 | 4, wahr)
        speicher_schreiben(p_index, xh(14), 8)
        speicher_schreiben(p_zyklus, xh(15), 8)
        speicher_schreiben(zustand + versatz_von(XhTastatur, anfrage), trb, 8)
        xh_setze(10, alt_slot)
        xh_setze(14, alt_index)
        xh_setze(15, alt_zyklus)
        nt_mmio_glocke32(xh(2) + slot * 4, u32(dci))

@nativ
konstante XH_T_HID_HALT: [u8; _] auf "MOO-KERNEL USB ANGEHALTEN CODE "

# Jede Completion gehoert genau zu Endpoint, Slot und outstanding TRB.
# Bei einem Transferfehler bleibt der restliche Controller bedienbar.
@nativ
funktion xh_hid_ereignis(callback: u64) -> void:
    unsicher:
        setze steuer: u64 auf xh(49)
        setze slot: u64 auf steuer >> 24
        wenn (steuer & 4) != 0 oder ((steuer >> 10) & 63) != 32 oder slot == 0 oder slot > xh(46):
            gib_zurück
        setze basis: u64 auf xh_hid_slot(slot)
        setze zustand: u64 auf basis + 3072
        setze dci: u64 auf speicher_lesen(zustand + versatz_von(XhTastatur, dci), 8)
        setze trb: u64 auf speicher_lesen(zustand + versatz_von(XhTastatur, anfrage), 8)
        wenn dci == 0 oder trb == 0 oder dci != ((steuer >> 16) & 31) oder trb != xh(47):
            gib_zurück
        setze code: u64 auf xh(48) >> 24
        speicher_schreiben(zustand + versatz_von(XhTastatur, anfrage), 0, 8)
        wenn code != 1 und code != 13:
            speicher_schreiben(zustand + versatz_von(XhTastatur, dci), 0, 8)
            xh_log(adresse_von(XH_T_HID_HALT), code)
            gib_zurück
        wenn code == 1 und (xh(48) & 0xFFFFFF) == 0:
            lesebarriere()
            setze empfangen: ptr[fn[sysv64](u64, u64, u64, u64) -> void] auf zeiger(callback)
            empfangen(speicher_lesen(basis + 2048, 8), zustand + versatz_von(XhTastatur, vorher), speicher_lesen(zustand + versatz_von(XhTastatur, port), 8), slot)
        xh_hid_anfordern(slot, zustand)

@nativ
konstante XH_T_INV_PORT: [u8; _] auf "MOO-KERNEL USB INVENTAR PORT START "
@nativ
konstante XH_T_INV_ENDE: [u8; _] auf "MOO-KERNEL USB INVENTAR PORT ENDE "
@nativ
konstante XH_T_INV_DEVICE: [u8; _] auf "MOO-KERNEL USB INVENTAR DEVICE BYTES "
@nativ
konstante XH_T_INV_KONFIG: [u8; _] auf "MOO-KERNEL USB INVENTAR KONFIG INDEX "
@nativ
konstante XH_T_INV_BYTES: [u8; _] auf "MOO-KERNEL USB INVENTAR KONFIG BYTES "
@nativ
konstante XH_T_INV_OFFSET: [u8; _] auf "MOO-KERNEL USB INVENTAR OFFSET "
@nativ
konstante XH_T_INV_WORT: [u8; _] auf "MOO-KERNEL USB INVENTAR ROH64 LE "
@nativ
konstante XH_T_INV_IF: [u8; _] auf "MOO-KERNEL USB INVENTAR INTERFACE OFFSET "
@nativ
konstante XH_T_INV_HID: [u8; _] auf "MOO-KERNEL USB INVENTAR HID OFFSET "

# Vollstaendige Rohbytes in 8-Byte-Gruppen, letzter Rest nullaufgefuellt.
@nativ
funktion xh_inventar_roh(adr: u64, laenge: u64) -> void:
    unsicher:
        setze pos: u64 auf 0
        solange pos < laenge:
            setze wort: u64 auf 0
            setze j: u64 auf 0
            solange j < 8 und pos + j < laenge:
                setze wort auf wort | (u64(speicher_lesen(adr + pos + j, 1)) << (j * 8))
                setze j auf j + 1
            xh_log(adresse_von(XH_T_INV_OFFSET), pos)
            xh_log(adresse_von(XH_T_INV_WORT), wort)
            setze pos auf pos + 8

@nativ
funktion xh_inventar_interface(adr: u64, laenge: u64) -> bool:
    unsicher:
        setze pos: u64 auf 0
        setze hid: bool auf falsch
        solange pos + 2 <= laenge:
            setze n: u64 auf u64(speicher_lesen(adr + pos, 1))
            setze art: u64 auf u64(speicher_lesen(adr + pos + 1, 1))
            wenn n < 2 oder n > laenge - pos:
                gib_zurück falsch
            wenn art == 4:
                wenn n < 9:
                    gib_zurück falsch
                setze hid auf speicher_lesen(adr + pos + 5, 1) == 3
                xh_log(adresse_von(XH_T_INV_IF), pos)
            wenn art == 0x21 und hid:
                xh_log(adresse_von(XH_T_INV_HID), pos)
            setze pos auf pos + n
        gib_zurück pos == laenge

# Alle Konfigurationen mit GET_DESCRIPTOR lesen. Interface- und HID-0x21-
# Deskriptoren liegen im Konfigurationsblock. Kein SET_CONFIGURATION.
@nativ
@aufrufkonvention("sysv64")
funktion xh_inventar_geraet(port: u64, speed: u64) -> bool:
    unsicher:
        wenn nicht xh_adressieren(port, speed):
            gib_zurück falsch
        setze desc: u64 auf xh(4) + 32768
        setze anzahl: u64 auf u64(speicher_lesen(desc + 17, 1))
        setze index: u64 auf 0
        xh_log(adresse_von(XH_T_INV_DEVICE), 18)
        xh_inventar_roh(desc, 18)
        solange index < anzahl:
            xh_log(adresse_von(XH_T_INV_KONFIG), index)
            setze laenge: u64 auf xh_konfiguration_lesen(index)
            wenn laenge == 0:
                gib_zurück falsch
            xh_log(adresse_von(XH_T_INV_BYTES), laenge)
            xh_inventar_roh(desc, laenge)
            wenn nicht xh_inventar_interface(desc, laenge):
                gib_zurück falsch
            setze index auf index + 1
        gib_zurück anzahl > 0

@nativ
funktion xh_vorbereiten(dma: u64, tsc_us: u64, log: u64, hid: bool, report: bool) -> bool:
    unsicher:
        xh_null(xh_kontext(), XH_WERTE * 8)
        xh_setze(26, log)
        xh_setze(4, dma)
        xh_setze(18, tsc_us)
        xh_setze(46, 1)
        wenn hid:
            xh_setze(46, XH_MAX_HID)
            xh_setze(50, u64(report))
            xh_setze(51, 1)
        wenn dma == 0 oder (dma & 4095) != 0 oder dma >= 0xFFF00000 oder tsc_us == 0:
            xh_setze(19, 1)
            gib_zurück falsch
        wenn hid:
            xh_null(dma + 64 * 4096, (XH_HID_SEITEN - 64) * 4096)
        xh_setze(19, 10)
        gib_zurück wahr

@nativ
konstante XH_T_HOST_LIMIT: [u8; _] auf "MOO-KERNEL USB HID CONTROLLER LIMIT BDF "

@nativ
funktion xh_durchlaufen(dma: u64, tsc_us: u64, bi: u64, map: u64, log: u64, ziel_bdf: u64, pruefen: u64, wartung: u64, allokieren: u64, report: bool) -> bool:
    unsicher:
        setze bdf: u32 auf 0
        setze vollstaendig: bool auf wahr
        setze controller: u64 auf 0
        setze hosts: u64 auf 0
        setze fortsetzen: bool auf wahr
        setze hid: bool auf allokieren != 0
        setze inventar: bool auf nicht hid und wartung != 0
        setze allok: ptr[fn[sysv64](u64) -> u64] auf zeiger(allokieren)
        setze warte: ptr[fn[sysv64](u64) -> void] auf zeiger(wartung)
        setze pruefe_geraet: ptr[fn[sysv64](u64, u64) -> bool] auf zeiger(pruefen)
        xh_waehle(0)
        wenn nicht hid und nicht xh_vorbereiten(dma, tsc_us, log, falsch, falsch):
            gib_zurück falsch
        wenn tsc_us == 0 oder pruefen == 0 oder ziel_bdf > 65536:
            gib_zurück falsch
        wenn ziel_bdf < 65536:
            setze bdf auf u32(ziel_bdf)
        solange fortsetzen und bdf < 65536 und (ziel_bdf == 65536 oder u64(bdf) == ziel_bdf):
            wenn (xh_pci(bdf, 0) & 0xFFFF) == 0xFFFF:
                wenn (bdf & 7) == 0:
                    setze bdf auf bdf + 7
            sonst wenn (xh_pci(bdf, 8) >> 8) == 0x0C0330:
                wenn hid:
                    wenn hosts == XH_MAX_HOSTS:
                        xh_log(adresse_von(XH_T_HOST_LIMIT), u64(bdf))
                        setze fortsetzen auf falsch
                    sonst:
                        xh_waehle(adresse_von(XH_HID_HOSTS) + hosts * XH_WERTE * 8)
                        setze fortsetzen auf xh_vorbereiten(allok(XH_HID_SEITEN), tsc_us, log, wahr, report)
                wenn fortsetzen:
                    xh_setze(19, 1)
                    xh_setze(10, 0)
                    xh_setze(1, 0)
                    setze controller auf controller + 1
                    setze port_ok: bool auf wahr
                    wenn xh_controller(bdf, bi, map):
                        xh_setze(19, 3)
                        setze port: u64 auf 1
                        solange port_ok und port <= xh(28):
                            wenn inventar:
                                xh_log(adresse_von(XH_T_INV_PORT), port)
                            setze speed: u64 auf xh_port(port)
                            setze geraet_ok: bool auf wahr
                            wenn inventar:
                                setze geraet_ok auf (nt_mmio_lese32(xh(1) + 0x400 + (port - 1) * 16) & 1) == 0
                            wenn speed >= 1 und speed <= 4:
                                setze geraet_ok auf pruefe_geraet(port, speed)
                                wenn geraet_ok und nicht inventar und nicht hid:
                                    gib_zurück wahr
                                wenn xh(10) != 0 und (nicht hid oder nicht geraet_ok):
                                    setze port_ok auf xh_befehl(0, (10 << 10) | u32(xh(10) << 24))
                                xh_setze(10, 0)
                            wenn inventar:
                                wenn nicht geraet_ok oder nicht port_ok:
                                    setze vollstaendig auf falsch
                                xh_log(adresse_von(XH_T_INV_ENDE), u64(geraet_ok und port_ok))
                            wenn wartung != 0:
                                warte(log)
                            setze port auf port + 1
                    sonst:
                        setze vollstaendig auf falsch
                    wenn hid und port_ok und (xh(16) > 0 oder xh(20) > 0):
                        setze hosts auf hosts + 1
                    sonst:
                        setze fortsetzen auf xh_stop()
                        wenn nicht port_ok und nicht hid:
                            gib_zurück falsch
            setze bdf auf bdf + 1
        wenn hid:
            speicher_schreiben(adresse_von(XH_HID_HOST_ANZAHL), hosts, 8)
            gib_zurück hosts > 0
        gib_zurück inventar und vollstaendig und fortsetzen und controller > 0

@nativ
funktion xh_suchen(dma: u64, tsc_us: u64, bi: u64, map: u64, log: u64, ziel_bdf: u64, pruefen: u64) -> bool:
    unsicher:
        gib_zurück xh_durchlaufen(dma, tsc_us, bi, map, log, ziel_bdf, pruefen, 0, 0, falsch)

@nativ
funktion usb_inventar(dma: u64, tsc_us: u64, bi: u64, map: u64, log: u64, wartung: u64) -> bool:
    unsicher:
        wenn wartung == 0:
            gib_zurück falsch
        gib_zurück xh_durchlaufen(dma, tsc_us, bi, map, log, 65536, adresse_von(xh_inventar_geraet), wartung, 0, falsch)

@nativ
konstante XH_T_MSI: [u8; _] auf "MOO-KERNEL USB MSI BDF "
@nativ
konstante XH_T_MSI_VEKTOR: [u8; _] auf "MOO-KERNEL USB MSI VEKTOR "
@nativ
konstante XH_T_MSIX: [u8; _] auf "MOO-KERNEL USB MSI-X VEKTOR "
@nativ
konstante XH_T_POLL: [u8; _] auf "MOO-KERNEL USB POLL BDF "

@nativ
funktion usb_starten(allokieren: u64, tsc_us: u64, bi: u64, map: u64, log: u64, wartung: u64, report: bool, pci: u64, msi_ziel: u64, msi_ruf: u64, speicher_ruf: u64, bericht: u64) -> bool:
    unsicher:
        speicher_schreiben(adresse_von(XH_HID_HOST_ANZAHL), 0, 8)
        setze XH_MSC_RUF[0] auf speicher_ruf
        setze gestartet: bool auf allokieren != 0 und xh_durchlaufen(0, tsc_us, bi, map, log, 65536, adresse_von(xh_geraet), wartung, allokieren, report)
        setze XH_MSC_RUF[0] auf 0
        wenn nicht gestartet:
            gib_zurück falsch
        setze host: u64 auf 0
        setze tastatur: bool auf falsch
        solange host < speicher_lesen(adresse_von(XH_HID_HOST_ANZAHL), 8):
            xh_waehle(adresse_von(XH_HID_HOSTS) + host * XH_WERTE * 8)
            setze tastatur auf tastatur oder xh(16) != 0
            xh_setze(24, bericht)
            setze v: u64 auf xh_msi_starten(pci, msi_ziel, msi_ruf)
            wenn v != 0:
                xh_setze(17, 1)
                xh_log(adresse_von(XH_T_MSI), xh(29))
                xh_log(adresse_von(XH_T_MSI_VEKTOR), v)
            sonst:
                xh_log(adresse_von(XH_T_POLL), xh(29))
            setze slot: u64 auf 1
            solange slot <= xh(46):
                setze zustand: u64 auf xh_hid_slot(slot) + 3072
                wenn speicher_lesen(zustand + versatz_von(XhTastatur, dci), 8) != 0:
                    xh_hid_anfordern(slot, zustand)
                setze slot auf slot + 1
            setze host auf host + 1
        xh_waehle(adresse_von(XH_HID_HOSTS))
        gib_zurück tastatur

@nativ
funktion xh_host_verfuegbar(kontext: u64, dma: u64) -> bool:
    unsicher:
        setze basis: u64 auf adresse_von(XH_HID_HOSTS)
        setze anzahl: u64 auf speicher_lesen(adresse_von(XH_HID_HOST_ANZAHL), 8)
        wenn kontext < basis oder kontext >= basis + anzahl * XH_WERTE * 8 oder (kontext - basis) % (XH_WERTE * 8) != 0:
            gib_zurück falsch
        gib_zurück speicher_lesen(kontext + 4 * 8, 8) == dma

@nativ
funktion usb_braucht_poll() -> bool:
    unsicher:
        setze host: u64 auf 0
        setze anzahl: u64 auf speicher_lesen(adresse_von(XH_HID_HOST_ANZAHL), 8)
        solange host < anzahl:
            setze zustand: u64 auf adresse_von(XH_HID_HOSTS) + host * XH_WERTE * 8
            wenn speicher_lesen(zustand + 17 * 8, 8) == 0:
                gib_zurück wahr
            setze host auf host + 1
        gib_zurück falsch

# Volles Budget bedeutet, dass der Eingabefaden den Ring erneut prüft.
@nativ
funktion usb_poll_berichte(callback: u64) -> bool:
    unsicher:
        setze offen: bool auf falsch
        setze host: u64 auf 0
        setze anzahl: u64 auf speicher_lesen(adresse_von(XH_HID_HOST_ANZAHL), 8)
        solange host < anzahl:
            xh_waehle(adresse_von(XH_HID_HOSTS) + host * XH_WERTE * 8)
            setze budget: u64 auf 32
            setze quittiert: bool auf falsch
            wenn xh(17) != 0:
                setze quittiert auf xh_msi_status_quittieren()
            solange budget > 0 und xh_event_holen():
                xh_hid_ereignis(callback)
                setze budget auf budget - 1
            wenn xh(17) != 0 und (quittiert oder budget < 32):
                xh_eventring_freigeben()
            wenn budget == 0:
                setze offen auf wahr
            setze host auf host + 1
        wenn anzahl > 0:
            xh_waehle(adresse_von(XH_HID_HOSTS))
        gib_zurück offen


