# P7-T11: TCP ueber den vorhandenen IPv4-Pfad, HTTP 8080 und Echo 2222.
# RFC 9293 §§3.3–3.8, 3.10.7; RFC 6298 fuer das RTO mit begrenztem Backoff.
# Ein aktiver Slot und ein ausstehendes Segment. Der Ring haelt unbestaetigte
# und noch ungesendete Bytes. ACKs geben Platz im Empfangsfenster frei.
aus "../uefi/netz_geraet" importiere nt_r16, nt_r32, nt_b8, nt_b16, nt_b32, nt_kopiere, nt_mac, nt_senden, nt_link, nt_pseudo_pruefsumme, nt_ipv4_antwortkopf
aus "../uefi/hardware_pci" importiere takt

@nativ
konstante TCP_HTTP_PORT: u64 auf 8080
@nativ
konstante TCP_ECHO_PORT: u64 auf 2222
@nativ
konstante TCP_LISTEN: u64 auf 0
@nativ
konstante TCP_SYN_RCVD: u64 auf 1
@nativ
konstante TCP_ESTABLISHED: u64 auf 2
@nativ
konstante TCP_FIN: u64 auf 3
@nativ
konstante TCP_KOPF_MAX: u64 auf 2048
@nativ
konstante TCP_MSS_MAX: u64 auf 1460
@nativ
konstante TCP_RING_GROESSE: u64 auf 16384
@nativ
konstante TCP_HTTP: [u8; _] auf "HTTP/1.1 200 OK\r\nContent-Length: 8\r\nConnection: close\r\n\r\nMoo TCP\n"
@nativ
konstante TCP_HTTP_LAENGE: u64 auf 65

struktur TcpSlot:
    zustand: u64
    nic: u64
    lokal_ip: u64
    peer_ip: u64
    lokal_port: u64
    peer_port: u64
    peer_mac: u64
    empfang: u64
    unbestaetigt: u64
    senden: u64
    aktiv: u64
    kopf_muster: u64
    kopf_bytes: u64
    peer_fin: u64
    will_fin: u64
    ring_kopf: u64
    ring_belegt: u64
    tx_daten: u64
    tx_flags: u64
    tx_zeit: u64
    wiederholungen: u64
    mss: u64
    peer_fenster: u64
    fenster_seq: u64
    fenster_ack: u64

@nativ
statisch TCP_SLOT: [u64; 25] auf 0
@nativ
statisch TCP_RING: [u8; 16384] auf 0
@nativ
statisch TCP_RAHMEN: [u8; 1514] auf 0

@nativ
funktion tcp_wert(off: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(TCP_SLOT) + off, 8)

@nativ
funktion tcp_setze(off: u64, wert: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(TCP_SLOT) + off, wert, 8)

@nativ
funktion tcp_abstand(von_seq: u64, bis_seq: u64) -> u64:
    gib_zurück (bis_seq + 0x100000000 - von_seq) & 0xFFFFFFFF

@nativ
funktion tcp_fenster() -> u64:
    unsicher:
        wenn tcp_wert(versatz_von(TcpSlot, peer_fin)) != 0:
            gib_zurück 0
        wenn tcp_wert(versatz_von(TcpSlot, lokal_port)) == TCP_ECHO_PORT:
            gib_zurück TCP_RING_GROESSE - tcp_wert(versatz_von(TcpSlot, ring_belegt))
        gib_zurück TCP_KOPF_MAX

@nativ
funktion tcp_geschlossen() -> bool:
    unsicher:
        gib_zurück tcp_wert(versatz_von(TcpSlot, zustand)) == TCP_FIN und tcp_wert(versatz_von(TcpSlot, peer_fin)) != 0 und tcp_wert(versatz_von(TcpSlot, unbestaetigt)) == tcp_wert(versatz_von(TcpSlot, senden))

@nativ
funktion tcp_ring_anfuegen(quelle: u64, laenge: u64) -> void:
    unsicher:
        setze belegt: u64 auf tcp_wert(versatz_von(TcpSlot, ring_belegt))
        setze ende: u64 auf (tcp_wert(versatz_von(TcpSlot, ring_kopf)) + belegt) % TCP_RING_GROESSE
        setze anfang: u64 auf TCP_RING_GROESSE - ende
        wenn anfang > laenge:
            setze anfang auf laenge
        nt_kopiere(adresse_von(TCP_RING) + ende, quelle, anfang)
        nt_kopiere(adresse_von(TCP_RING), quelle + anfang, laenge - anfang)
        tcp_setze(versatz_von(TcpSlot, ring_belegt), belegt + laenge)

@nativ
funktion tcp_ring_kopiere(ziel: u64, laenge: u64) -> void:
    unsicher:
        setze kopf: u64 auf tcp_wert(versatz_von(TcpSlot, ring_kopf))
        setze anfang: u64 auf TCP_RING_GROESSE - kopf
        wenn anfang > laenge:
            setze anfang auf laenge
        nt_kopiere(ziel, adresse_von(TCP_RING) + kopf, anfang)
        nt_kopiere(ziel + anfang, adresse_von(TCP_RING), laenge - anfang)

# IP und Ethernet aus dem Verbindungsslot aufbauen. Payload kommt bei
# Neuversand und Wiederholung aus demselben Ringkopf.
@nativ
funktion tcp_sende_segment(seq: u64, flags: u64, daten: u64) -> void:
    unsicher:
        setze p: u64 auf adresse_von(TCP_RAHMEN)
        setze nic: u64 auf tcp_wert(versatz_von(TcpSlot, nic))
        setze lokal: u64 auf tcp_wert(versatz_von(TcpSlot, lokal_ip))
        setze peer: u64 auf tcp_wert(versatz_von(TcpSlot, peer_ip))
        setze mac: u64 auf tcp_wert(versatz_von(TcpSlot, peer_mac))
        setze i: u64 auf 0
        solange i < 6:
            nt_b8(p, i, (mac >> (8 * i)) & 255)
            nt_b8(p, 6 + i, nt_mac(nic, i))
            setze i auf i + 1
        nt_b16(p, 12, 0x0800)
        nt_b8(p, 14, 0x45)
        nt_b8(p, 15, 0)
        nt_b16(p, 34, tcp_wert(versatz_von(TcpSlot, lokal_port)))
        nt_b16(p, 36, tcp_wert(versatz_von(TcpSlot, peer_port)))
        nt_b32(p, 38, seq)
        nt_b32(p, 42, tcp_wert(versatz_von(TcpSlot, empfang)))
        setze kopf: u64 auf 20
        wenn (flags & 2) != 0:
            setze kopf auf 24
            nt_b16(p, 54, 0x0204)
            nt_b16(p, 56, TCP_MSS_MAX)
        nt_b8(p, 46, kopf * 4)
        setze bits: u64 auf flags | 0x10
        wenn daten != 0:
            setze bits auf bits | 8
            tcp_ring_kopiere(p + 34 + kopf, daten)
        nt_b8(p, 47, bits)
        nt_b16(p, 48, tcp_fenster())
        nt_b16(p, 50, 0)
        nt_b16(p, 52, 0)
        setze nutz: u64 auf kopf + daten
        nt_b16(p, 50, nt_pseudo_pruefsumme(p, 34, nutz, lokal, peer, 6))
        nt_ipv4_antwortkopf(p, lokal, peer, 6, nutz)
        nt_senden(nic, p, 34 + nutz)

@nativ
funktion tcp_ack_senden() -> void:
    unsicher:
        tcp_sende_segment(tcp_wert(versatz_von(TcpSlot, senden)), 0, 0)

@nativ
funktion tcp_neues_segment(flags: u64, daten: u64) -> void:
    unsicher:
        setze seq: u64 auf tcp_wert(versatz_von(TcpSlot, senden))
        tcp_setze(versatz_von(TcpSlot, senden), (seq + daten + u64(flags != 0)) & 0xFFFFFFFF)
        tcp_setze(versatz_von(TcpSlot, tx_daten), daten)
        tcp_setze(versatz_von(TcpSlot, tx_flags), flags)
        tcp_setze(versatz_von(TcpSlot, tx_zeit), takt())
        tcp_setze(versatz_von(TcpSlot, wiederholungen), 0)
        tcp_sende_segment(seq, flags, daten)

@nativ
funktion tcp_ausgabe() -> bool:
    unsicher:
        wenn tcp_wert(versatz_von(TcpSlot, zustand)) != TCP_ESTABLISHED oder tcp_wert(versatz_von(TcpSlot, unbestaetigt)) != tcp_wert(versatz_von(TcpSlot, senden)):
            gib_zurück falsch
        setze fenster: u64 auf tcp_wert(versatz_von(TcpSlot, peer_fenster))
        wenn fenster == 0:
            gib_zurück falsch
        setze belegt: u64 auf tcp_wert(versatz_von(TcpSlot, ring_belegt))
        setze daten: u64 auf belegt
        setze mss: u64 auf tcp_wert(versatz_von(TcpSlot, mss))
        wenn daten > mss:
            setze daten auf mss
        wenn daten > fenster:
            setze daten auf fenster
        setze fin: u64 auf 0
        wenn daten == belegt und fenster > daten und tcp_wert(versatz_von(TcpSlot, will_fin)) != 0:
            setze fin auf 1
            tcp_setze(versatz_von(TcpSlot, zustand), TCP_FIN)
        wenn daten + fin == 0:
            gib_zurück falsch
        tcp_neues_segment(fin, daten)
        gib_zurück wahr

@nativ
funktion netz_tcp_wartung(tsc_us: u64) -> void:
    unsicher:
        setze zustand: u64 auf tcp_wert(versatz_von(TcpSlot, zustand))
        wenn tsc_us == 0 oder zustand == TCP_LISTEN:
            gib_zurück
        setze jetzt: u64 auf takt()
        setze alter: u64 auf jetzt - tcp_wert(versatz_von(TcpSlot, aktiv))
        wenn tcp_geschlossen():
            wenn alter >= tsc_us * 240000000:
                tcp_setze(versatz_von(TcpSlot, zustand), TCP_LISTEN)
            gib_zurück
        wenn alter >= tsc_us * 120000000:
            tcp_setze(versatz_von(TcpSlot, zustand), TCP_LISTEN)
            gib_zurück
        wenn nicht nt_link(tcp_wert(versatz_von(TcpSlot, nic))):
            gib_zurück
        setze vergangen: u64 auf jetzt - tcp_wert(versatz_von(TcpSlot, tx_zeit))
        setze una: u64 auf tcp_wert(versatz_von(TcpSlot, unbestaetigt))
        setze nxt: u64 auf tcp_wert(versatz_von(TcpSlot, senden))
        setze fenster: u64 auf tcp_wert(versatz_von(TcpSlot, peer_fenster))
        wenn zustand != TCP_SYN_RCVD und fenster == 0:
            # ACK mit SND.UNA-1 fordert eine Antwort mit aktuellem Fenster
            # an (Linux v6.12 tcp_output.c:4288-4305).
            wenn vergangen >= tsc_us * 1000000 und (una != nxt oder tcp_wert(versatz_von(TcpSlot, ring_belegt)) != 0 oder tcp_wert(versatz_von(TcpSlot, will_fin)) != 0):
                tcp_sende_segment((una + 0xFFFFFFFF) & 0xFFFFFFFF, 0, 0)
                tcp_setze(versatz_von(TcpSlot, tx_zeit), jetzt)
            gib_zurück
        wenn una == nxt:
            tcp_ausgabe()
            gib_zurück
        setze n: u64 auf tcp_wert(versatz_von(TcpSlot, wiederholungen))
        setze stufe: u64 auf n
        wenn stufe > 3:
            setze stufe auf 3
        wenn vergangen < tsc_us * (u64(1000000) << stufe):
            gib_zurück
        wenn n >= 5:
            tcp_setze(versatz_von(TcpSlot, zustand), TCP_LISTEN)
            gib_zurück
        setze flags: u64 auf tcp_wert(versatz_von(TcpSlot, tx_flags))
        setze daten: u64 auf tcp_wert(versatz_von(TcpSlot, tx_daten))
        wenn zustand != TCP_SYN_RCVD:
            wenn daten >= fenster:
                setze daten auf fenster
                setze flags auf 0
        tcp_sende_segment(una, flags, daten)
        tcp_setze(versatz_von(TcpSlot, tx_zeit), jetzt)
        tcp_setze(versatz_von(TcpSlot, wiederholungen), n + 1)

@nativ
funktion tcp_mss(p: u64, kopf: u64) -> u64:
    unsicher:
        setze i: u64 auf 20
        setze mss: u64 auf 536
        solange i < kopf:
            setze art: u64 auf u64(speicher_lesen(p + 34 + i, 1))
            wenn art == 0:
                stopp
            setze schritt: u64 auf 1
            wenn art != 1:
                wenn i + 2 > kopf:
                    gib_zurück 0
                setze schritt auf u64(speicher_lesen(p + 35 + i, 1))
                wenn schritt < 2 oder i + schritt > kopf:
                    gib_zurück 0
                wenn art == 2:
                    wenn schritt != 4:
                        gib_zurück 0
                    setze mss auf nt_r16(p, 36 + i)
            setze i auf i + schritt
        wenn mss > TCP_MSS_MAX:
            gib_zurück TCP_MSS_MAX
        gib_zurück mss

@nativ
funktion tcp_beginnen(p: u64, nic: u64, ip: u64, quelle: u64, kopf: u64) -> void:
    unsicher:
        setze mss: u64 auf tcp_mss(p, kopf)
        wenn mss == 0:
            gib_zurück
        setze seq: u64 auf nt_r32(p, 38)
        setze mac: u64 auf u64(speicher_lesen(p + 6, 4)) | (u64(speicher_lesen(p + 10, 2)) << 32)
        # TSC-basierte Startsequenz fuer das isolierte Echo-Testnetz.
        setze iss: u64 auf ((takt() >> 10) ^ quelle ^ nt_r16(p, 34)) & 0xFFFFFFFF
        tcp_setze(versatz_von(TcpSlot, zustand), TCP_SYN_RCVD)
        tcp_setze(versatz_von(TcpSlot, nic), nic)
        tcp_setze(versatz_von(TcpSlot, lokal_ip), ip)
        tcp_setze(versatz_von(TcpSlot, peer_ip), quelle)
        tcp_setze(versatz_von(TcpSlot, lokal_port), nt_r16(p, 36))
        tcp_setze(versatz_von(TcpSlot, peer_port), nt_r16(p, 34))
        tcp_setze(versatz_von(TcpSlot, peer_mac), mac)
        tcp_setze(versatz_von(TcpSlot, empfang), (seq + 1) & 0xFFFFFFFF)
        tcp_setze(versatz_von(TcpSlot, unbestaetigt), iss)
        tcp_setze(versatz_von(TcpSlot, senden), iss)
        tcp_setze(versatz_von(TcpSlot, aktiv), takt())
        tcp_setze(versatz_von(TcpSlot, kopf_muster), 0)
        tcp_setze(versatz_von(TcpSlot, kopf_bytes), 0)
        tcp_setze(versatz_von(TcpSlot, peer_fin), 0)
        tcp_setze(versatz_von(TcpSlot, will_fin), 0)
        tcp_setze(versatz_von(TcpSlot, ring_kopf), 0)
        tcp_setze(versatz_von(TcpSlot, ring_belegt), 0)
        tcp_setze(versatz_von(TcpSlot, mss), mss)
        tcp_setze(versatz_von(TcpSlot, peer_fenster), nt_r16(p, 48))
        tcp_setze(versatz_von(TcpSlot, fenster_seq), seq)
        tcp_setze(versatz_von(TcpSlot, fenster_ack), iss)
        tcp_neues_segment(2, 0)

# Kumulative ACKs quittieren nur gesendeten Sequenzraum. Ein Teil-ACK
# verschiebt den Ringkopf exakt um die quittierten Datenbytes.
@nativ
funktion tcp_ack_annehmen(seq: u64, ack: u64, fenster: u64) -> bool:
    unsicher:
        setze una: u64 auf tcp_wert(versatz_von(TcpSlot, unbestaetigt))
        setze nxt: u64 auf tcp_wert(versatz_von(TcpSlot, senden))
        setze zugang: u64 auf tcp_abstand(una, ack)
        wenn zugang > tcp_abstand(una, nxt):
            # Alte ACKs aendern keinen Sendezustand, zukuenftige sind ungueltig.
            gib_zurück zugang >= 0x80000000
        wenn zugang != 0:
            setze rest: u64 auf tcp_wert(versatz_von(TcpSlot, tx_daten))
            setze daten: u64 auf zugang
            wenn daten > rest:
                setze daten auf rest
            tcp_setze(versatz_von(TcpSlot, ring_kopf), (tcp_wert(versatz_von(TcpSlot, ring_kopf)) + daten) % TCP_RING_GROESSE)
            tcp_setze(versatz_von(TcpSlot, ring_belegt), tcp_wert(versatz_von(TcpSlot, ring_belegt)) - daten)
            tcp_setze(versatz_von(TcpSlot, unbestaetigt), ack)
            tcp_setze(versatz_von(TcpSlot, tx_daten), rest - daten)
            tcp_setze(versatz_von(TcpSlot, tx_zeit), takt())
            tcp_setze(versatz_von(TcpSlot, wiederholungen), 0)
            wenn ack == nxt:
                tcp_setze(versatz_von(TcpSlot, tx_flags), 0)
        setze folge: u64 auf tcp_abstand(tcp_wert(versatz_von(TcpSlot, fenster_seq)), seq)
        wenn (folge != 0 und folge < 0x80000000) oder (folge == 0 und tcp_abstand(tcp_wert(versatz_von(TcpSlot, fenster_ack)), ack) < 0x80000000):
            tcp_setze(versatz_von(TcpSlot, peer_fenster), fenster)
            tcp_setze(versatz_von(TcpSlot, fenster_seq), seq)
            tcp_setze(versatz_von(TcpSlot, fenster_ack), ack)
        gib_zurück wahr

@nativ
funktion tcp_http_kopf(quelle: u64, daten: u64) -> void:
    unsicher:
        wenn tcp_wert(versatz_von(TcpSlot, will_fin)) != 0:
            gib_zurück
        setze muster: u64 auf tcp_wert(versatz_von(TcpSlot, kopf_muster))
        setze bytes: u64 auf tcp_wert(versatz_von(TcpSlot, kopf_bytes))
        setze i: u64 auf 0
        solange i < daten und bytes < TCP_KOPF_MAX und muster != 0x0D0A0D0A:
            setze muster auf ((muster << 8) | u64(speicher_lesen(quelle + i, 1))) & 0xFFFFFFFF
            setze bytes auf bytes + 1
            setze i auf i + 1
        tcp_setze(versatz_von(TcpSlot, kopf_muster), muster)
        tcp_setze(versatz_von(TcpSlot, kopf_bytes), bytes)
        wenn muster == 0x0D0A0D0A:
            tcp_ring_anfuegen(adresse_von(TCP_HTTP), TCP_HTTP_LAENGE)
        wenn muster == 0x0D0A0D0A oder bytes >= TCP_KOPF_MAX:
            tcp_setze(versatz_von(TcpSlot, will_fin), 1)

# Ueberlappende alte Bytes ueberspringen. Luecken werden mit dem
# unveraenderten RCV.NXT beantwortet. FIN belegt das letzte Fensterbyte.
@nativ
funktion tcp_daten_annehmen(quelle: u64, seq: u64, daten: u64, fin: u64) -> void:
    unsicher:
        setze erwartet: u64 auf tcp_wert(versatz_von(TcpSlot, empfang))
        setze alt: u64 auf tcp_abstand(seq, erwartet)
        wenn alt > daten oder tcp_wert(versatz_von(TcpSlot, peer_fin)) != 0:
            gib_zurück
        setze rest: u64 auf daten - alt
        setze fenster: u64 auf tcp_fenster()
        setze anzahl: u64 auf rest
        wenn anzahl > fenster:
            setze anzahl auf fenster
        wenn anzahl != 0 und tcp_wert(versatz_von(TcpSlot, zustand)) == TCP_ESTABLISHED:
            wenn tcp_wert(versatz_von(TcpSlot, lokal_port)) == TCP_ECHO_PORT:
                tcp_ring_anfuegen(quelle + alt, anzahl)
            sonst:
                tcp_http_kopf(quelle + alt, anzahl)
        wenn fin != 0 und anzahl == rest und anzahl < fenster:
            setze anzahl auf anzahl + 1
            tcp_setze(versatz_von(TcpSlot, peer_fin), 1)
            tcp_setze(versatz_von(TcpSlot, will_fin), 1)
        tcp_setze(versatz_von(TcpSlot, empfang), (erwartet + anzahl) & 0xFFFFFFFF)

@nativ
funktion netz_tcp_empfangen(p: u64, nutz: u64, nic: u64, ip: u64, quelle: u64, echo_aktiv: bool) -> void:
    unsicher:
        wenn nutz < 20:
            gib_zurück
        setze ziel: u64 auf nt_r16(p, 36)
        wenn ziel != TCP_HTTP_PORT und (ziel != TCP_ECHO_PORT oder nicht echo_aktiv):
            gib_zurück
        setze port: u64 auf nt_r16(p, 34)
        setze kopf: u64 auf u64(speicher_lesen(p + 46, 1) >> 4) * 4
        wenn port == 0 oder kopf < 20 oder kopf > nutz oder nt_pseudo_pruefsumme(p, 34, nutz, quelle, ip, 6) != 0:
            gib_zurück
        setze flags: u64 auf u64(speicher_lesen(p + 47, 1)) & 0x3F
        setze seq: u64 auf nt_r32(p, 38)
        setze ack: u64 auf nt_r32(p, 42)
        setze daten: u64 auf nutz - kopf
        setze zustand: u64 auf tcp_wert(versatz_von(TcpSlot, zustand))
        setze gleich: bool auf zustand != TCP_LISTEN und nic == tcp_wert(versatz_von(TcpSlot, nic)) und quelle == tcp_wert(versatz_von(TcpSlot, peer_ip)) und port == tcp_wert(versatz_von(TcpSlot, peer_port)) und ziel == tcp_wert(versatz_von(TcpSlot, lokal_port))
        wenn nicht gleich:
            wenn flags == 2 und daten == 0 und (zustand == TCP_LISTEN oder tcp_geschlossen()):
                tcp_beginnen(p, nic, ip, quelle, kopf)
            gib_zurück

        setze erwartet: u64 auf tcp_wert(versatz_von(TcpSlot, empfang))
        setze fin: u64 auf flags & 1
        wenn tcp_geschlossen():
            wenn fin != 0 und ((seq + daten + 1) & 0xFFFFFFFF) == erwartet:
                tcp_ack_senden()
                tcp_setze(versatz_von(TcpSlot, aktiv), takt())
            gib_zurück
        wenn (flags & 4) != 0:
            wenn seq == erwartet:
                tcp_setze(versatz_von(TcpSlot, zustand), TCP_LISTEN)
            gib_zurück
        wenn (flags & 2) != 0:
            wenn zustand == TCP_SYN_RCVD und flags == 2 und daten == 0 und ((seq + 1) & 0xFFFFFFFF) == erwartet:
                tcp_sende_segment(tcp_wert(versatz_von(TcpSlot, unbestaetigt)), 2, 0)
            gib_zurück
        wenn (flags & 0x10) == 0:
            gib_zurück

        setze segment: u64 auf daten + fin
        setze fenster: u64 auf tcp_fenster()
        setze voraus: u64 auf tcp_abstand(erwartet, seq)
        setze passt: bool auf voraus < fenster
        wenn segment == 0:
            setze passt auf passt oder seq == erwartet
        sonst:
            setze passt auf fenster != 0 und (passt oder tcp_abstand(seq, erwartet) < segment)
        wenn nicht passt:
            tcp_ack_senden()
            gib_zurück
        wenn zustand == TCP_SYN_RCVD und (seq != erwartet oder ack != tcp_wert(versatz_von(TcpSlot, senden))):
            gib_zurück
        wenn nicht tcp_ack_annehmen(seq, ack, nt_r16(p, 48)):
            tcp_ack_senden()
            gib_zurück

        tcp_setze(versatz_von(TcpSlot, aktiv), takt())
        wenn zustand == TCP_SYN_RCVD:
            tcp_setze(versatz_von(TcpSlot, zustand), TCP_ESTABLISHED)
        wenn segment != 0:
            tcp_daten_annehmen(p + 34 + kopf, seq, daten, fin)
        wenn nicht tcp_ausgabe() und (segment != 0 oder (fenster == 0 und tcp_fenster() != 0)):
            tcp_ack_senden()
