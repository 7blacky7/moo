extern "C" funktion kern_c_moo_func_call_1(f: LaufzeitWert, a0: LaufzeitWert) -> LaufzeitWert
extern "C" funktion kern_c_moo_func_call_2(f: LaufzeitWert, a0: LaufzeitWert, a1: LaufzeitWert) -> LaufzeitWert
