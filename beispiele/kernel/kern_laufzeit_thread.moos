@nativ
konstante LWT_FUNC: [u8; 36] auf [115, 116, 97, 114, 116, 101, 58, 32, 100, 101, 114, 32, 87, 101, 114, 116, 32, 105, 115, 116, 32, 107, 101, 105, 110, 101, 32, 70, 117, 110, 107, 116, 105, 111, 110, 0]

struktur LaufzeitListe:
    refcount: i32
    eingefroren: bool
    elemente: u64
    anzahl: i32
    kapazitaet: i32

struktur LaufzeitWertPlatz:
    wert: LaufzeitWert

struktur LaufzeitThread:
    refcount: i32
    reserve: i32
    ergebnis: LaufzeitWert
    beendet: bool
    gejoint: bool
    wartender: ptr[LaufzeitPostfach]
    postfach: ptr[LaufzeitPostfach]
    mutex: LaufzeitMutex
    fertig: LaufzeitBedingung
    funktionswert: LaufzeitWert
    argument: LaufzeitWert
    anzahl: i32
    griff: u64

@nativ
funktion laufzeit_post_mein() -> ptr[LaufzeitPostfach]:
    unsicher:
        setze k: ptr[LaufzeitFehler] auf laufzeit_kontext()
        wenn k.postfach == 0:
            k.postfach = u64(laufzeit_post_neu(1))
        gib_zurück zeiger(k.postfach)

@nativ
funktion laufzeit_listenwert(liste: ptr[LaufzeitListe], index: i32) -> LaufzeitWert:
    unsicher:
        setze p: ptr[LaufzeitWertPlatz] auf zeiger(liste.elemente + u64(index) * groesse_von(LaufzeitWert))
        gib_zurück p.wert

@nativ
funktion laufzeit_thread_aufrufen(t: ptr[LaufzeitThread]) -> LaufzeitWert:
    unsicher:
        wenn t.anzahl < 0:
            kern_c_moo_retain(t.argument)
            gib_zurück kern_c_moo_func_call_1(t.funktionswert, t.argument)
        setze l: ptr[LaufzeitListe] auf zeiger(t.argument.daten)
        setze i: i32 auf 0
        solange i < t.anzahl:
            kern_c_moo_retain(laufzeit_listenwert(l, i))
            setze i auf i + 1
        wenn t.anzahl == 0:
            gib_zurück kern_c_moo_func_call_0(t.funktionswert)
        wenn t.anzahl == 1:
            gib_zurück kern_c_moo_func_call_1(t.funktionswert, laufzeit_listenwert(l, 0))
        wenn t.anzahl == 2:
            gib_zurück kern_c_moo_func_call_2(t.funktionswert, laufzeit_listenwert(l, 0), laufzeit_listenwert(l, 1))
        wenn t.anzahl == 3:
            gib_zurück kern_c_moo_func_call_3(t.funktionswert, laufzeit_listenwert(l, 0), laufzeit_listenwert(l, 1), laufzeit_listenwert(l, 2))
        wenn t.anzahl == 4:
            gib_zurück kern_c_moo_func_call_4(t.funktionswert, laufzeit_listenwert(l, 0), laufzeit_listenwert(l, 1), laufzeit_listenwert(l, 2), laufzeit_listenwert(l, 3))
        wenn t.anzahl == 5:
            gib_zurück kern_c_moo_func_call_5(t.funktionswert, laufzeit_listenwert(l, 0), laufzeit_listenwert(l, 1), laufzeit_listenwert(l, 2), laufzeit_listenwert(l, 3), laufzeit_listenwert(l, 4))
        wenn t.anzahl == 6:
            gib_zurück kern_c_moo_func_call_6(t.funktionswert, laufzeit_listenwert(l, 0), laufzeit_listenwert(l, 1), laufzeit_listenwert(l, 2), laufzeit_listenwert(l, 3), laufzeit_listenwert(l, 4), laufzeit_listenwert(l, 5))
        wenn t.anzahl == 7:
            gib_zurück kern_c_moo_func_call_7(t.funktionswert, laufzeit_listenwert(l, 0), laufzeit_listenwert(l, 1), laufzeit_listenwert(l, 2), laufzeit_listenwert(l, 3), laufzeit_listenwert(l, 4), laufzeit_listenwert(l, 5), laufzeit_listenwert(l, 6))
        sonst:
            gib_zurück kern_c_moo_func_call_8(t.funktionswert, laufzeit_listenwert(l, 0), laufzeit_listenwert(l, 1), laufzeit_listenwert(l, 2), laufzeit_listenwert(l, 3), laufzeit_listenwert(l, 4), laufzeit_listenwert(l, 5), laufzeit_listenwert(l, 6), laufzeit_listenwert(l, 7))

@nativ
funktion laufzeit_thread_arbeiter(daten: u64) -> void:
    unsicher:
        setze t: ptr[LaufzeitThread] auf zeiger(daten)
        wenn nicht laufzeit_kontext_starten(1):
            kern_c_moo_backend_anhalten()
        laufzeit_kontext().postfach = u64(t.postfach)
        setze ergebnis: LaufzeitWert auf laufzeit_thread_aufrufen(t)
        laufzeit_post_schliessen(t.postfach)
        laufzeit_post_freigeben(t.postfach)
        laufzeit_kontext().postfach = 0
        kern_c_moo_backend_mutex_nimm(zeiger(adresse_von(t.mutex)))
        t.ergebnis = ergebnis
        t.beendet = wahr
        kern_c_moo_backend_bedingung_wecken(zeiger(adresse_von(t.fertig)))
        kern_c_moo_backend_mutex_gib(zeiger(adresse_von(t.mutex)))
        kern_c_moo_backend_ende()

@nativ
funktion laufzeit_thread_starten(f: LaufzeitWert, arg: LaufzeitWert, anzahl: i32) -> LaufzeitWert:
    unsicher:
        wenn f.tag != 6 oder f.daten == 0:
            kern_c_moo_release(f)
            kern_c_moo_release(arg)
            laufzeit_werfen(zeiger(adresse_von(LWT_FUNC)))
            gib_zurück laufzeit_nichts()
        setze aritaet: i32 auf anzahl
        wenn aritaet < 0:
            setze aritaet auf 1
        wenn nicht kern_c_moo_func_aritaet_ok(zeiger(f.daten), aritaet):
            kern_c_moo_release(f)
            kern_c_moo_release(arg)
            gib_zurück laufzeit_nichts()
        kern_c_moo_mt_aktivieren()
        kern_c_moo_teilen(f)
        kern_c_moo_teilen(arg)
        setze t: ptr[LaufzeitThread] auf zeiger(laufzeit_nullspeicher(groesse_von(LaufzeitThread)))
        t.refcount = 1
        t.ergebnis = laufzeit_nichts()
        t.postfach = laufzeit_post_neu(2)
        t.funktionswert = f
        t.argument = arg
        t.anzahl = anzahl
        setze nummer: u64 auf kern_c_moo_backend_starten(adresse_von(laufzeit_thread_arbeiter), u64(t))
        t.griff = nummer
        wenn nummer == 0:
            laufzeit_post_freigeben(t.postfach)
            laufzeit_post_freigeben(t.postfach)
            kern_c_moo_release(f)
            kern_c_moo_release(arg)
            free(zeiger(u64(t)))
            laufzeit_werfen(zeiger(adresse_von(LWT_START)))
            gib_zurück laufzeit_nichts()
        gib_zurück LaufzeitWert(9, u64(t))

@nativ
funktion kern_rt_moo_thread_spawn(f: LaufzeitWert, arg: LaufzeitWert) -> LaufzeitWert:
    unsicher:
        gib_zurück laufzeit_thread_starten(f, arg, -1)

@nativ
funktion kern_rt_moo_thread_spawn_n(f: LaufzeitWert, liste: LaufzeitWert) -> LaufzeitWert:
    unsicher:
        wenn liste.tag != 4 oder liste.daten == 0:
            kern_c_moo_release(f)
            kern_c_moo_release(liste)
            laufzeit_werfen(zeiger(adresse_von(LWT_ARG)))
            gib_zurück laufzeit_nichts()
        setze p: ptr[LaufzeitListe] auf zeiger(liste.daten)
        wenn p.anzahl < 0 oder p.anzahl > 8:
            kern_c_moo_release(f)
            kern_c_moo_release(liste)
            laufzeit_werfen(zeiger(adresse_von(LWT_ARG)))
            gib_zurück laufzeit_nichts()
        gib_zurück laufzeit_thread_starten(f, liste, p.anzahl)

# Caller hält den Thread-Mutex. Genau der erste Join übernimmt die Worker-Werte.
@nativ
funktion laufzeit_thread_join(t: ptr[LaufzeitThread], ich: ptr[LaufzeitPostfach]) -> void:
    unsicher:
        solange nicht t.beendet:
            kern_c_moo_backend_bedingung_warten(zeiger(adresse_von(t.fertig)), zeiger(adresse_von(t.mutex)))
        wenn nicht t.gejoint:
            kern_c_moo_backend_warten(t.griff)
            laufzeit_post_uebernehmen(t.postfach, ich)
            kern_c_moo_release(t.funktionswert)
            kern_c_moo_release(t.argument)
            t.funktionswert = laufzeit_nichts()
            t.argument = laufzeit_nichts()
            t.gejoint = wahr

@nativ
funktion kern_rt_moo_thread_wait(thread: LaufzeitWert) -> LaufzeitWert:
    unsicher:
        wenn thread.tag != 9 oder thread.daten == 0:
            laufzeit_werfen(zeiger(adresse_von(LWT_KEIN_FADEN)))
            gib_zurück laufzeit_nichts()
        setze t: ptr[LaufzeitThread] auf zeiger(thread.daten)
        setze ich: ptr[LaufzeitPostfach] auf laufzeit_post_mein()
        laufzeit_post_leeren(ich)
        kern_c_moo_backend_mutex_nimm(zeiger(adresse_von(t.mutex)))
        wenn u64(t.wartender) == 0:
            laufzeit_post_halten(ich)
            t.wartender = ich
        sonst wenn u64(t.wartender) != u64(ich):
            kern_c_moo_backend_mutex_gib(zeiger(adresse_von(t.mutex)))
            laufzeit_werfen(zeiger(adresse_von(LWT_ANDERER)))
            gib_zurück laufzeit_nichts()
        laufzeit_thread_join(t, ich)
        setze r: LaufzeitWert auf t.ergebnis
        kern_c_moo_retain(r)
        kern_c_moo_backend_mutex_gib(zeiger(adresse_von(t.mutex)))
        gib_zurück r

@nativ
funktion kern_rt_moo_thread_done(thread: LaufzeitWert) -> LaufzeitWert:
    unsicher:
        wenn thread.tag != 9 oder thread.daten == 0:
            laufzeit_werfen(zeiger(adresse_von(LWT_FERTIG)))
            gib_zurück laufzeit_nichts()
        setze t: ptr[LaufzeitThread] auf zeiger(thread.daten)
        kern_c_moo_backend_mutex_nimm(zeiger(adresse_von(t.mutex)))
        setze fertig: bool auf t.gejoint
        kern_c_moo_backend_mutex_gib(zeiger(adresse_von(t.mutex)))
        gib_zurück laufzeit_bool(fertig)

@nativ
funktion kern_rt_moo_thread_free(p: ptr[u8]) -> void:
    unsicher:
        wenn u64(p) == 0:
            gib_zurück
        setze t: ptr[LaufzeitThread] auf zeiger(u64(p))
        setze ich: ptr[LaufzeitPostfach] auf laufzeit_post_mein()
        kern_c_moo_backend_mutex_nimm(zeiger(adresse_von(t.mutex)))
        laufzeit_thread_join(t, ich)
        kern_c_moo_backend_mutex_gib(zeiger(adresse_von(t.mutex)))
        laufzeit_post_leeren(ich)
        wenn u64(t.wartender) == 0 oder kern_c_moo_ist_geteilt(t.ergebnis):
            kern_c_moo_release(t.ergebnis)
        sonst:
            laufzeit_post_abgeben(t.wartender, ich, t.ergebnis)
        laufzeit_post_freigeben(t.wartender)
        laufzeit_post_freigeben(t.postfach)
        free(p)
