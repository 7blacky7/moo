aus "kern_laufzeit_plattform" importiere LaufzeitMutex, LaufzeitBedingung, kern_c_moo_backend_mutex_nimm, kern_c_moo_backend_mutex_gib, kern_c_moo_backend_bedingung_warten, kern_c_moo_backend_bedingung_wecken, kern_c_moo_backend_alle_wecken, kern_c_moo_backend_starten, kern_c_moo_backend_warten, kern_c_moo_backend_ende, kern_c_moo_backend_anhalten
# Gemeinsamer Thread-Träger; Kernel und Ring3 liefern den Plattformanschluss.
aus "kern_laufzeit_typen" importiere LaufzeitWert, LaufzeitFehler
aus "kern_laufzeit_faden" importiere laufzeit_kontext, laufzeit_kontext_starten
aus "kern_laufzeit_postfach" importiere LaufzeitPostfach, laufzeit_post_neu, laufzeit_post_halten, laufzeit_post_freigeben, laufzeit_post_leeren, laufzeit_post_abgeben, laufzeit_post_schliessen, laufzeit_post_uebernehmen
aus "kern_laufzeit_werte" importiere laufzeit_nichts, laufzeit_bool, laufzeit_nullspeicher, laufzeit_werfen, kern_c_moo_retain, kern_c_moo_release, kern_c_moo_teilen, free

