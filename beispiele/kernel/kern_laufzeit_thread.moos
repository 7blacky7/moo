@nativ
konstante LWT_KEIN_FADEN: [u8; 33] auf [119, 97, 114, 116, 101, 110, 58, 32, 100, 101, 114, 32, 87, 101, 114, 116, 32, 105, 115, 116, 32, 107, 101, 105, 110, 32, 84, 104, 114, 101, 97, 100, 0]

