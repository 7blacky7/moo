extern "C" funktion moo_bare_ssh_sicherheit_pruefen() -> u64
extern "C" funktion moo_bare_ssh_public() -> u64
extern "C" funktion moo_bare_ssh_random(ziel: u64, laenge: u64) -> u64
extern "C" funktion moo_bare_ssh_clear() -> void
