# ELF-Vertrag MOOSAU02 mit Hybrid-KEX. 0=Transport-Probe, 1=gesperrt, 2=aktiver Public Key.
@nativ
@sektion(".data.moo_ssh_auth")
statisch SSH_AUTH_PROFIL: [u64; 6] auf [0x32305541534F4F4D, 0, 0, 0, 0, 0]

struktur SshVerbindung:
    phase: u64
    eingang: u64
    ausgang: u64
    rx_seq: u64
    tx_seq: u64
    tx_verschluesselt: u64
    server_init: u64
    rx_verschluesselt: u64
    kanal_peer: u64
    kanal_fenster: u64
    kanal_max: u64
    info_pos: u64
    info_n: u64
    kex_verfahren: u64

@nativ
statisch SSH_VERBINDUNG: [u64; 14] auf 0
# Bootdaten: Logger, Bereit, PFA-Abfrage, erster TSC-Wert und Takte pro ms.
@nativ
statisch SSH_BOOT: [u64; 5] auf 0
@nativ
statisch SSH_INFO: [u8; 128] auf 0
@nativ
statisch SSH_EINGANG: [u8; 35000] auf 0
@nativ
statisch SSH_AUSGANG: [u8; 2048] auf 0
@nativ
statisch SSH_SERVER_INIT: [u8; 256] auf 0
@nativ
statisch SSH_NUTZ: [u8; 1536] auf 0
# RFC 8709: string(ssh-ed25519) + string(32 Byte Public Key).
@nativ
statisch SSH_HOST_BLOB: [u8; 51] auf 0
@nativ
statisch SSH_DH_ANTWORT: [u8; 1184] auf 0

@nativ
funktion ssh_wert(off: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(SSH_VERBINDUNG) + off, 8)

@nativ
funktion ssh_setze(off: u64, v: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(SSH_VERBINDUNG) + off, v, 8)

@nativ
funktion ssh_log(text: u64, wert: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(speicher_lesen(adresse_von(SSH_BOOT), 8))
        log(text, wert)

# Schreibt ein SSH-string-Feld und liefert die naechste Schreibadresse.
@nativ
funktion ssh_string_schreiben(ziel: u64, quelle: u64, n: u64) -> u64:
    unsicher:
        nt_b32(ziel, 0, n)
        nt_kopiere(ziel + 4, quelle, n)
        gib_zurück ziel + 4 + n

@nativ
funktion ssh_profil_zustand() -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(SSH_AUTH_PROFIL) + 8, 8)

@nativ
funktion ssh_profil_key() -> u64:
    unsicher:
        gib_zurück adresse_von(SSH_AUTH_PROFIL) + 16

@nativ
funktion ssh_profil_gueltig() -> bool:
    unsicher:
        setze zustand: u64 auf ssh_profil_zustand()
        setze key: u64 auf ssh_profil_key()
        setze leer: bool auf (speicher_lesen(key, 8) | speicher_lesen(key + 8, 8) | speicher_lesen(key + 16, 8) | speicher_lesen(key + 24, 8)) == 0
        gib_zurück ((zustand == 0 oder zustand == 1) und leer) oder (zustand == SSH_PROFIL_AKTIV und nicht leer)

@nativ
funktion ssh_booten(loggen: u64, pfa_frei: u64, start_takt: u64, takte_pro_us: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(SSH_BOOT), loggen, 8)
        speicher_schreiben(adresse_von(SSH_BOOT) + 16, pfa_frei, 8)
        speicher_schreiben(adresse_von(SSH_BOOT) + 24, start_takt, 8)
        speicher_schreiben(adresse_von(SSH_BOOT) + 32, takte_pro_us * 1000, 8)
        setze rolle: bool auf ssh_rolle_pruefen()
        setze methode: bool auf ssh_methode_pruefen()
        setze pruefungen: u64 auf moo_bare_ssh_sicherheit_pruefen()
        ssh_log(adresse_von(SSH_LOG_ROLLENTEST), u64(rolle))
        ssh_log(adresse_von(SSH_LOG_CREDTEST), pruefungen & 1)
        ssh_log(adresse_von(SSH_LOG_TAGTEST), (pruefungen >> 1) & 1)
        ssh_log(adresse_von(SSH_LOG_SIGNATURTEST), (pruefungen >> 2) & 1)
        ssh_log(adresse_von(SSH_LOG_METHODENTEST), u64(methode))
        ssh_log(adresse_von(SSH_LOG_MLKEMTEST), (pruefungen >> 3) & 1)
        setze ok: u64 auf 0
        wenn rolle und methode und pruefungen == 15 und ssh_profil_gueltig():
            setze ok auf moo_bare_ssh_boot()
        wenn ok == 1:
            setze pubkey: u64 auf moo_bare_ssh_public()
            setze blob: u64 auf ssh_string_schreiben(adresse_von(SSH_HOST_BLOB), adresse_von(SSH_ED), SSH_ED_N)
            ssh_string_schreiben(blob, pubkey, 32)
            # Ausschliesslich der oeffentliche Hostkey fuer die Linux-Pinprobe.
            ssh_log(adresse_von(SSH_LOG_EINS), (nt_r32(pubkey, 0) << 32) | nt_r32(pubkey, 4))
            ssh_log(adresse_von(SSH_LOG_ZWEI), (nt_r32(pubkey, 8) << 32) | nt_r32(pubkey, 12))
            ssh_log(adresse_von(SSH_LOG_DREI), (nt_r32(pubkey, 16) << 32) | nt_r32(pubkey, 20))
            ssh_log(adresse_von(SSH_LOG_VIER), (nt_r32(pubkey, 24) << 32) | nt_r32(pubkey, 28))
            speicher_schreiben(adresse_von(SSH_BOOT) + 8, 1, 8)
        ssh_log(adresse_von(SSH_LOG_BEREIT), ok)

@nativ
funktion ssh_bereit() -> bool:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(SSH_BOOT) + 8, 8) == 1

@nativ
funktion ssh_fertig() -> bool:
    unsicher:
        gib_zurück ssh_wert(versatz_von(SshVerbindung, phase)) == SSH_PHASE_FERTIG

@nativ
funktion ssh_schliessen() -> void:
    unsicher:
        moo_bare_ssh_clear()
        ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_FERTIG)
        ssh_setze(versatz_von(SshVerbindung, eingang), 0)

@nativ
funktion ssh_fehler() -> void:
    unsicher:
        ssh_log(adresse_von(SSH_LOG_FEHLER), ssh_wert(versatz_von(SshVerbindung, phase)))
        ssh_schliessen()

@nativ
funktion ssh_verbinden() -> void:
    unsicher:
        moo_bare_ssh_clear()
        nt_null(adresse_von(SSH_VERBINDUNG), groesse_von(SshVerbindung))
        ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_VERSION)
        nt_kopiere(adresse_von(SSH_AUSGANG), adresse_von(SSH_IDENT), SSH_IDENT_N)
        ssh_setze(versatz_von(SshVerbindung, ausgang), SSH_IDENT_N)

@nativ
funktion ssh_empfangsfrei() -> u64:
    unsicher:
        gib_zurück SSH_EINGANG_MAX - ssh_wert(versatz_von(SshVerbindung, eingang))

@nativ
funktion ssh_ausgabe_adresse() -> u64:
    unsicher:
        gib_zurück adresse_von(SSH_AUSGANG)

@nativ
funktion ssh_ausgabe_laenge() -> u64:
    unsicher:
        gib_zurück ssh_wert(versatz_von(SshVerbindung, ausgang))

@nativ
funktion ssh_ausgabe_quittieren() -> void:
    unsicher:
        ssh_setze(versatz_von(SshVerbindung, ausgang), 0)

# RFC 4253 6, OpenSSH packet.c:1199-1235. Bei ChaCha wird die
# verschluesselte Laenge getrennt behandelt, der Paketkoerper ist 8-Byte-rund.
@nativ
funktion ssh_paket_senden(nutz: u64, n: u64) -> bool:
    unsicher:
        setze enc: bool auf ssh_wert(versatz_von(SshVerbindung, tx_verschluesselt)) == 1
        setze auszurichten: u64 auf n + 1
        wenn nicht enc:
            setze auszurichten auf auszurichten + 4
        setze pad: u64 auf 8 - auszurichten % 8
        wenn pad < 4:
            setze pad auf pad + 8
        setze laenge: u64 auf 5 + n + pad
        setze draht: u64 auf laenge + u64(enc) * 16
        setze ausgang: u64 auf ssh_ausgabe_laenge()
        wenn draht > SSH_AUSGANG_MAX - ausgang:
            gib_zurück falsch
        setze paket: u64 auf adresse_von(SSH_AUSGANG) + ausgang
        nt_b32(paket, 0, laenge - 4)
        nt_b8(paket, 4, pad)
        nt_kopiere(paket + 5, nutz, n)
        wenn moo_bare_ssh_random(paket + 5 + n, pad) != 1:
            gib_zurück falsch
        setze seq: u64 auf ssh_wert(versatz_von(SshVerbindung, tx_seq))
        wenn enc und moo_bare_ssh_seal(paket, laenge, seq) != 1:
            gib_zurück falsch
        ssh_setze(versatz_von(SshVerbindung, tx_seq), seq + 1)
        ssh_setze(versatz_von(SshVerbindung, ausgang), ausgang + draht)
        gib_zurück wahr

@nativ
funktion ssh_server_init_senden() -> bool:
    unsicher:
        setze p: u64 auf adresse_von(SSH_SERVER_INIT)
        nt_b8(p, 0, SSH_MSG_KEXINIT)
        wenn moo_bare_ssh_random(p + 1, 16) != 1:
            gib_zurück falsch
        setze ziel: u64 auf ssh_string_schreiben(p + 17, adresse_von(SSH_KEX_ANGEBOT), SSH_KEX_ANGEBOT_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_ED), SSH_ED_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_CHACHA), SSH_CHACHA_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_CHACHA), SSH_CHACHA_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_MAC), SSH_MAC_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_MAC), SSH_MAC_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_KEINE_KOMPRESSION), SSH_KEINE_KOMPRESSION_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_KEINE_KOMPRESSION), SSH_KEINE_KOMPRESSION_N)
        nt_b32(ziel, 0, 0)
        nt_b32(ziel, 4, 0)
        nt_b8(ziel, 8, 0)
        nt_b32(ziel, 9, 0)
        setze n: u64 auf ziel + 13 - p
        ssh_setze(versatz_von(SshVerbindung, server_init), n)
        gib_zurück ssh_paket_senden(p, n)

@nativ
funktion ssh_gleiche_bytes(a: u64, b: u64, n: u64) -> bool:
    unsicher:
        setze i: u64 auf 0
        solange i < n:
            wenn speicher_lesen(a + i, 1) != speicher_lesen(b + i, 1):
                gib_zurück falsch
            setze i auf i + 1
        gib_zurück wahr

# RFC 4251 5. 0: ungueltig. 1: ohne Treffer. Sonst: Byteposition + 2.
@nativ
funktion ssh_namensliste(p: u64, n: u64, gesucht: u64, gesucht_n: u64) -> u64:
    unsicher:
        wenn n == 0:
            gib_zurück 1
        setze ergebnis: u64 auf 1
        setze anfang: u64 auf 0
        setze i: u64 auf 0
        solange i <= n:
            setze v: u64 auf 44
            wenn i < n:
                setze v auf u64(speicher_lesen(p + i, 1))
            wenn v == 44:
                wenn i == anfang:
                    gib_zurück 0
                wenn ergebnis == 1 und i - anfang == gesucht_n und ssh_gleiche_bytes(p + anfang, gesucht, gesucht_n):
                    setze ergebnis auf anfang + 2
                setze anfang auf i + 1
            sonst wenn v < 33 oder v > 126:
                gib_zurück 0
            setze i auf i + 1
        gib_zurück ergebnis

# RFC 4253 7.1. Der Client bestimmt die Reihenfolge der gemeinsamen Verfahren.
@nativ
funktion ssh_kex_wahl(p: u64, n: u64) -> u64:
    unsicher:
        setze klassisch: u64 auf ssh_namensliste(p, n, adresse_von(SSH_KEX_CORE), SSH_KEX_CORE_N)
        setze hybrid: u64 auf ssh_namensliste(p, n, adresse_von(SSH_KEX_HYBRID_NAME), SSH_KEX_HYBRID_NAME_N)
        wenn hybrid > 1 und (klassisch <= 1 oder hybrid < klassisch):
            gib_zurück SSH_KEX_HYBRID
        wenn klassisch > 1:
            gib_zurück SSH_KEX_X25519
        gib_zurück 0

@nativ
funktion ssh_client_init(p: u64, n: u64, seq: u64) -> bool:
    unsicher:
        wenn n < 22:
            gib_zurück falsch
        setze pos: u64 auf 17
        setze feld: u64 auf 0
        setze strikt: bool auf falsch
        setze verfahren: u64 auf 0
        solange feld < 10:
            wenn n - pos < 4:
                gib_zurück falsch
            setze l: u64 auf nt_r32(p, pos)
            setze pos auf pos + 4
            wenn l > n - pos:
                gib_zurück falsch
            setze gesucht: u64 auf 0
            setze gesucht_n: u64 auf 0
            wenn feld == 0:
                setze verfahren auf ssh_kex_wahl(p + pos, l)
                setze strikt auf ssh_namensliste(p + pos, l, adresse_von(SSH_STRIKT_CLIENT), SSH_STRIKT_CLIENT_N) > 1
            sonst wenn feld == 1:
                setze gesucht auf adresse_von(SSH_ED)
                setze gesucht_n auf SSH_ED_N
            sonst wenn feld == 2 oder feld == 3:
                setze gesucht auf adresse_von(SSH_CHACHA)
                setze gesucht_n auf SSH_CHACHA_N
            sonst wenn feld == 6 oder feld == 7:
                setze gesucht auf adresse_von(SSH_KEINE_KOMPRESSION)
                setze gesucht_n auf SSH_KEINE_KOMPRESSION_N
            wenn feld != 0:
                setze muster: u64 auf ssh_namensliste(p + pos, l, gesucht, gesucht_n)
                wenn muster == 0 oder (gesucht_n != 0 und muster == 1):
                    gib_zurück falsch
            setze pos auf pos + l
            setze feld auf feld + 1
        wenn n - pos != 5:
            gib_zurück falsch
        setze vermutet: u64 auf u64(speicher_lesen(p + pos, 1))
        # Strict KEX ist Pflicht. Die Probe nutzt die geordnete KEX-Folge
        # mit first_kex_packet_follows=0.
        wenn verfahren == 0 oder nicht strikt oder seq != 0 oder vermutet != 0 oder nt_r32(p, pos + 1) != 0:
            gib_zurück falsch
        moo_bare_ssh_inits(p, n, adresse_von(SSH_SERVER_INIT), ssh_wert(versatz_von(SshVerbindung, server_init)))
        ssh_setze(versatz_von(SshVerbindung, kex_verfahren), verfahren)
        ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_DH)
        ssh_log(adresse_von(SSH_LOG_INIT), 1)
        gib_zurück wahr

@nativ
funktion ssh_ecdh(p: u64, n: u64) -> bool:
    unsicher:
        setze verfahren: u64 auf ssh_wert(versatz_von(SshVerbindung, kex_verfahren))
        setze client_n: u64 auf 32
        setze server_n: u64 auf 32
        wenn verfahren == SSH_KEX_HYBRID:
            setze client_n auf SSH_HYBRID_CLIENT_BYTES
            setze server_n auf SSH_HYBRID_REPLY_BYTES
        wenn n != 5 + client_n:
            gib_zurück falsch
        wenn nt_r32(p, 1) != client_n:
            gib_zurück falsch
        setze antwort: u64 auf adresse_von(SSH_DH_ANTWORT)
        wenn moo_bare_ssh_exchange(p + 5, client_n, adresse_von(SSH_HOST_BLOB), 51, antwort) != 1:
            gib_zurück falsch
        setze nutz: u64 auf adresse_von(SSH_NUTZ)
        nt_b8(nutz, 0, SSH_MSG_ECDH_REPLY)
        setze ziel: u64 auf ssh_string_schreiben(nutz + 1, adresse_von(SSH_HOST_BLOB), 51)
        setze ziel auf ssh_string_schreiben(ziel, antwort, server_n)
        nt_b32(ziel, 0, 4 + SSH_ED_N + 4 + 64)
        setze ziel auf ssh_string_schreiben(ziel + 4, adresse_von(SSH_ED), SSH_ED_N)
        setze ziel auf ssh_string_schreiben(ziel, antwort + server_n, 64)
        wenn nicht ssh_paket_senden(nutz, ziel - nutz):
            gib_zurück falsch
        nt_b8(nutz, 0, SSH_MSG_NEWKEYS)
        wenn nicht ssh_paket_senden(nutz, 1):
            gib_zurück falsch
        ssh_setze(versatz_von(SshVerbindung, tx_verschluesselt), 1)
        ssh_setze(versatz_von(SshVerbindung, tx_seq), 0)
        ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_NEU)
        ssh_log(adresse_von(SSH_LOG_KEX_VERFAHREN), verfahren)
        gib_zurück wahr

# RFC 4252 4. Service-Runde und Einstieg in die konfigurierte Userauth.
@nativ
funktion ssh_dienst(p: u64, n: u64) -> bool:
    unsicher:
        wenn n != 5 + SSH_USERAUTH_N oder nt_r32(p, 1) != SSH_USERAUTH_N oder nicht ssh_gleiche_bytes(p + 5, adresse_von(SSH_USERAUTH), SSH_USERAUTH_N):
            gib_zurück falsch
        setze nutz: u64 auf adresse_von(SSH_NUTZ)
        nt_b8(nutz, 0, SSH_MSG_SERVICE_ACCEPT)
        setze ziel: u64 auf ssh_string_schreiben(nutz + 1, adresse_von(SSH_USERAUTH), SSH_USERAUTH_N)
        wenn nicht ssh_paket_senden(nutz, ziel - nutz):
            gib_zurück falsch
        ssh_log(adresse_von(SSH_LOG_DIENST), 1)
        wenn ssh_profil_zustand() != 0:
            ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_AUTH)
            gib_zurück wahr
        nt_b8(nutz, 0, SSH_MSG_DISCONNECT)
        nt_b32(nutz, 1, 11)
        setze ziel auf ssh_string_schreiben(nutz + 5, adresse_von(SSH_ABSCHLUSS), SSH_ABSCHLUSS_N)
        nt_b32(ziel, 0, 0)
        wenn nicht ssh_paket_senden(nutz, ziel + 4 - nutz):
            gib_zurück falsch
        ssh_schliessen()
        gib_zurück wahr

# SSH-Strings koennen leer sein. Null markiert eine unvollstaendige Laenge.
@nativ
funktion ssh_feld_ende(p: u64, n: u64, anfang: u64) -> u64:
    unsicher:
        wenn anfang == 0 oder anfang > n:
            gib_zurück 0
        wenn n - anfang < 4:
            gib_zurück 0
        setze l: u64 auf nt_r32(p, anfang)
        wenn l > n - anfang - 4:
            gib_zurück 0
        gib_zurück anfang + 4 + l

@nativ
funktion ssh_feld_gleich(p: u64, anfang: u64, ende: u64, gesucht: u64, gesucht_n: u64) -> bool:
    unsicher:
        wenn ende != anfang + 4 + gesucht_n:
            gib_zurück falsch
        gib_zurück ssh_gleiche_bytes(p + anfang + 4, gesucht, gesucht_n)

@nativ
funktion ssh_ed_blob(p: u64, n: u64, wert_n: u64) -> bool:
    unsicher:
        wenn n != 19 + wert_n:
            gib_zurück falsch
        gib_zurück nt_r32(p, 0) == SSH_ED_N und ssh_gleiche_bytes(p + 4, adresse_von(SSH_ED), SSH_ED_N) und nt_r32(p, 15) == wert_n

# RFC 4252 7 und RFC 8709 3–4. Der C-Pfad prueft den signierten
# Original-Praefix zusammen mit der Session-ID aus dem initialen KEX.
@nativ
funktion ssh_auth_pruefen(p: u64, n: u64) -> u64:
    unsicher:
        setze konto: u64 auf ssh_feld_ende(p, n, 1)
        setze dienst: u64 auf ssh_feld_ende(p, n, konto)
        setze methode: u64 auf ssh_feld_ende(p, n, dienst)
        wenn methode == 0:
            gib_zurück SSH_AUTH_UNGUELTIG
        wenn nicht ssh_feld_gleich(p, 1, konto, adresse_von(SSH_KONTO), SSH_KONTO_N) oder nicht ssh_feld_gleich(p, konto, dienst, adresse_von(SSH_CONNECTION), SSH_CONNECTION_N) oder nicht ssh_feld_gleich(p, dienst, methode, adresse_von(SSH_PUBLICKEY), SSH_PUBLICKEY_N):
            gib_zurück SSH_AUTH_METHODE
        wenn methode >= n:
            gib_zurück SSH_AUTH_UNGUELTIG
        setze signiert: u64 auf u64(speicher_lesen(p + methode, 1))
        setze alg: u64 auf ssh_feld_ende(p, n, methode + 1)
        setze blob: u64 auf ssh_feld_ende(p, n, alg)
        wenn signiert > 1 oder blob == 0:
            gib_zurück SSH_AUTH_UNGUELTIG
        wenn nicht ssh_feld_gleich(p, methode + 1, alg, adresse_von(SSH_ED), SSH_ED_N) oder nicht ssh_ed_blob(p + alg + 4, blob - alg - 4, 32):
            gib_zurück SSH_AUTH_KEY
        setze key: u64 auf p + alg + 4 + 19
        setze profil: u64 auf ssh_profil_zustand()
        setze erlaubt: u64 auf ssh_profil_key()
        wenn signiert == 0:
            wenn blob != n:
                gib_zurück SSH_AUTH_UNGUELTIG
            wenn moo_bare_ssh_key_erlaubt(profil, erlaubt, key) == 1:
                gib_zurück SSH_AUTH_PROBE
            gib_zurück SSH_AUTH_KEY
        setze signatur: u64 auf ssh_feld_ende(p, n, blob)
        wenn signatur != n oder signatur == 0:
            gib_zurück SSH_AUTH_UNGUELTIG
        wenn nicht ssh_ed_blob(p + blob + 4, signatur - blob - 4, 64):
            gib_zurück SSH_AUTH_SIGNATUR
        wenn moo_bare_ssh_userauth(profil, erlaubt, key, p, blob, p + blob + 4 + 19) == 1:
            gib_zurück SSH_AUTH_OK
        gib_zurück SSH_AUTH_SIGNATUR

@nativ
funktion ssh_methode_pruefen() -> bool:
    unsicher:
        setze p: u64 auf adresse_von(SSH_NUTZ)
        nt_b8(p, 0, SSH_MSG_USERAUTH_REQUEST)
        setze ziel: u64 auf ssh_string_schreiben(p + 1, adresse_von(SSH_KONTO), SSH_KONTO_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_CONNECTION), SSH_CONNECTION_N)
        setze ziel auf ssh_string_schreiben(ziel, adresse_von(SSH_PASSWORT), SSH_PASSWORT_N)
        nt_b8(ziel, 0, 0)
        nt_b32(ziel, 1, 0)
        gib_zurück ssh_auth_pruefen(p, ziel + 5 - p) == SSH_AUTH_METHODE

@nativ
funktion ssh_auth_antwort(p: u64, n: u64) -> bool:
    unsicher:
        setze ergebnis: u64 auf ssh_auth_pruefen(p, n)
        setze nutz: u64 auf adresse_von(SSH_NUTZ)
        wenn ergebnis == SSH_AUTH_UNGUELTIG:
            gib_zurück falsch
        wenn ergebnis == SSH_AUTH_OK:
            nt_b8(nutz, 0, SSH_MSG_USERAUTH_SUCCESS)
            wenn nicht ssh_paket_senden(nutz, 1):
                gib_zurück falsch
            ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_KANAL)
            ssh_log(adresse_von(SSH_LOG_AUTH), 1)
            gib_zurück wahr
        wenn ergebnis == SSH_AUTH_PROBE:
            # Kanonische Kette aus bereits geprueftem Algorithmus und Key.
            nt_b8(nutz, 0, SSH_MSG_USERAUTH_PK_OK)
            setze probe_ziel: u64 auf ssh_string_schreiben(nutz + 1, adresse_von(SSH_ED), SSH_ED_N)
            nt_b32(probe_ziel, 0, 51)
            setze probe_ziel auf ssh_string_schreiben(probe_ziel + 4, adresse_von(SSH_ED), SSH_ED_N)
            setze probe_ziel auf ssh_string_schreiben(probe_ziel, ssh_profil_key(), 32)
            gib_zurück ssh_paket_senden(nutz, probe_ziel - nutz)
        nt_b8(nutz, 0, SSH_MSG_USERAUTH_FAILURE)
        setze ziel: u64 auf ssh_string_schreiben(nutz + 1, adresse_von(SSH_PUBLICKEY), SSH_PUBLICKEY_N)
        nt_b8(ziel, 0, 0)
        ssh_log(adresse_von(SSH_LOG_AUTH_ABGELEHNT), ergebnis)
        gib_zurück ssh_paket_senden(nutz, ziel + 1 - nutz)

# RFC 4254 5.1 und 6.1. Ein Session-Kanal mit lokaler ID 0.
@nativ
funktion ssh_kanal_oeffnen(p: u64, n: u64) -> bool:
    unsicher:
        setze feld: u64 auf ssh_feld_ende(p, n, 1)
        wenn feld == 0 oder n - feld != 12:
            gib_zurück falsch
        setze peer: u64 auf nt_r32(p, feld)
        setze nutz: u64 auf adresse_von(SSH_NUTZ)
        wenn nicht ssh_feld_gleich(p, 1, feld, adresse_von(SSH_SESSION), SSH_SESSION_N) oder nt_r32(p, feld + 8) == 0:
            nt_b8(nutz, 0, SSH_MSG_CHANNEL_OPEN_FAILURE)
            nt_b32(nutz, 1, peer)
            nt_b32(nutz, 5, 3)
            nt_b32(nutz, 9, 0)
            nt_b32(nutz, 13, 0)
            gib_zurück ssh_paket_senden(nutz, 17)
        ssh_setze(versatz_von(SshVerbindung, kanal_peer), peer)
        ssh_setze(versatz_von(SshVerbindung, kanal_fenster), nt_r32(p, feld + 4))
        ssh_setze(versatz_von(SshVerbindung, kanal_max), nt_r32(p, feld + 8))
        nt_b8(nutz, 0, SSH_MSG_CHANNEL_OPEN_CONFIRMATION)
        nt_b32(nutz, 1, peer)
        nt_b32(nutz, 5, 0)
        nt_b32(nutz, 9, 0)
        nt_b32(nutz, 13, 4096)
        wenn nicht ssh_paket_senden(nutz, 17):
            gib_zurück falsch
        ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_SITZUNG)
        gib_zurück wahr

@nativ
funktion ssh_zahl_schreiben(ziel: u64, wert: u64) -> u64:
    unsicher:
        setze teiler: u64 auf 1
        solange wert / teiler >= 10:
            setze teiler auf teiler * 10
        solange teiler != 0:
            nt_b8(ziel, 0, 48 + (wert / teiler) % 10)
            setze ziel auf ziel + 1
            setze teiler auf teiler / 10
        gib_zurück ziel

@nativ
funktion ssh_info_starten() -> bool:
    unsicher:
        setze boot: u64 auf adresse_von(SSH_BOOT)
        setze takte: u64 auf speicher_lesen(boot + 32, 8)
        wenn takte == 0:
            gib_zurück falsch
        setze frei: ptr[fn[sysv64]() -> u64] auf zeiger(speicher_lesen(boot + 16, 8))
        setze p: u64 auf adresse_von(SSH_INFO)
        nt_kopiere(p, adresse_von(SSH_INFO_KOPF), SSH_INFO_KOPF_N)
        setze ziel: u64 auf ssh_zahl_schreiben(p + SSH_INFO_KOPF_N, (takt() - speicher_lesen(boot + 24, 8)) / takte)
        nt_kopiere(ziel, adresse_von(SSH_INFO_FREI), SSH_INFO_FREI_N)
        setze ziel auf ssh_zahl_schreiben(ziel + SSH_INFO_FREI_N, frei())
        nt_b8(ziel, 0, 10)
        ssh_setze(versatz_von(SshVerbindung, info_n), ziel + 1 - p)
        gib_zurück wahr

@nativ
funktion ssh_kanal_kopf(typ: u64) -> u64:
    unsicher:
        setze p: u64 auf adresse_von(SSH_NUTZ)
        nt_b8(p, 0, typ)
        nt_b32(p, 1, ssh_wert(versatz_von(SshVerbindung, kanal_peer)))
        gib_zurück p

@nativ
funktion ssh_kanal_marke(typ: u64) -> bool:
    unsicher:
        gib_zurück ssh_paket_senden(ssh_kanal_kopf(typ), 5)

@nativ
funktion ssh_kanal_auftrag(p: u64, n: u64) -> bool:
    unsicher:
        setze feld: u64 auf ssh_feld_ende(p, n, 5)
        wenn feld == 0 oder feld >= n:
            gib_zurück falsch
        setze antwort: u64 auf u64(speicher_lesen(p + feld, 1))
        wenn antwort > 1:
            gib_zurück falsch
        setze typ: u64 auf SSH_MSG_CHANNEL_FAILURE
        wenn ssh_wert(versatz_von(SshVerbindung, info_n)) == 0 und ssh_feld_gleich(p, 5, feld, adresse_von(SSH_EXEC), SSH_EXEC_N):
            setze befehl: u64 auf ssh_feld_ende(p, n, feld + 1)
            wenn befehl == n und ssh_feld_gleich(p, feld + 1, befehl, adresse_von(SSH_INFO_BEFEHL), SSH_INFO_BEFEHL_N) und ssh_info_starten():
                setze typ auf SSH_MSG_CHANNEL_SUCCESS
        gib_zurück antwort == 0 oder ssh_kanal_marke(typ)

# Die TCP-Wartung ruft dies auch ohne neue SSH-Nachrichten auf.
@nativ
funktion ssh_kanal_fortsetzen() -> void:
    unsicher:
        wenn ssh_wert(versatz_von(SshVerbindung, phase)) != SSH_PHASE_SITZUNG oder ssh_ausgabe_laenge() > SSH_AUSGANG_MAX - 384:
            gib_zurück
        setze pos: u64 auf ssh_wert(versatz_von(SshVerbindung, info_pos))
        setze ende: u64 auf ssh_wert(versatz_von(SshVerbindung, info_n))
        wenn ende == 0:
            gib_zurück
        setze fenster: u64 auf ssh_wert(versatz_von(SshVerbindung, kanal_fenster))
        setze maxpkt: u64 auf ssh_wert(versatz_von(SshVerbindung, kanal_max))
        setze n: u64 auf ende - pos
        wenn n > fenster:
            setze n auf fenster
        wenn n > maxpkt:
            setze n auf maxpkt
        wenn n != 0:
            setze datenpaket: u64 auf ssh_kanal_kopf(SSH_MSG_CHANNEL_DATA)
            ssh_string_schreiben(datenpaket + 5, adresse_von(SSH_INFO) + pos, n)
            wenn nicht ssh_paket_senden(datenpaket, 9 + n):
                ssh_fehler()
                gib_zurück
            setze pos auf pos + n
            ssh_setze(versatz_von(SshVerbindung, info_pos), pos)
            ssh_setze(versatz_von(SshVerbindung, kanal_fenster), fenster - n)
        wenn pos != ende:
            gib_zurück
        # RFC 4254 5.3 und 6.10. Exit-Status, EOF und CLOSE folgen den Daten.
        setze p: u64 auf ssh_kanal_kopf(SSH_MSG_CHANNEL_REQUEST)
        setze ziel: u64 auf ssh_string_schreiben(p + 5, adresse_von(SSH_EXIT_STATUS), SSH_EXIT_STATUS_N)
        nt_b8(ziel, 0, 0)
        nt_b32(ziel, 1, 0)
        wenn nicht ssh_paket_senden(p, ziel + 5 - p) oder nicht ssh_kanal_marke(SSH_MSG_CHANNEL_EOF) oder nicht ssh_kanal_marke(SSH_MSG_CHANNEL_CLOSE):
            ssh_fehler()
            gib_zurück
        ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_KANAL_ENDE)
        ssh_log(adresse_von(SSH_LOG_INFO), 1)

@nativ
funktion ssh_kanal_nachricht(p: u64, n: u64, typ: u64, phase: u64) -> bool:
    unsicher:
        wenn n < 5:
            gib_zurück falsch
        wenn nt_r32(p, 1) != 0:
            gib_zurück falsch
        wenn typ == SSH_MSG_CHANNEL_WINDOW_ADJUST:
            wenn n != 9:
                gib_zurück falsch
            setze fenster: u64 auf ssh_wert(versatz_von(SshVerbindung, kanal_fenster)) + nt_r32(p, 5)
            wenn fenster > 0xFFFFFFFF:
                gib_zurück falsch
            ssh_setze(versatz_von(SshVerbindung, kanal_fenster), fenster)
            gib_zurück wahr
        wenn typ == SSH_MSG_CHANNEL_REQUEST:
            gib_zurück ssh_kanal_auftrag(p, n)
        wenn n != 5:
            gib_zurück falsch
        wenn typ == SSH_MSG_CHANNEL_CLOSE:
            wenn phase != SSH_PHASE_KANAL_ENDE und nicht ssh_kanal_marke(SSH_MSG_CHANNEL_CLOSE):
                gib_zurück falsch
            ssh_schliessen()
        gib_zurück wahr

# Protokolltabelle fuer Nachrichten vom Client. Der Abschnitt nach
# NEWKEYS ist verschluesselt; ein Kanal ist erst nach der Signatur frei.
@nativ
funktion ssh_rolle_erlaubt(phase: u64, typ: u64) -> bool:
    wenn phase == SSH_PHASE_INIT:
        gib_zurück typ == SSH_MSG_KEXINIT
    wenn phase == SSH_PHASE_DH:
        gib_zurück typ == SSH_MSG_ECDH_INIT
    wenn phase == SSH_PHASE_NEU:
        gib_zurück typ == SSH_MSG_NEWKEYS
    wenn phase == SSH_PHASE_DIENST:
        gib_zurück typ == SSH_MSG_SERVICE_REQUEST
    wenn phase == SSH_PHASE_AUTH:
        gib_zurück typ == SSH_MSG_USERAUTH_REQUEST oder typ == SSH_MSG_DISCONNECT
    wenn phase == SSH_PHASE_KANAL:
        gib_zurück typ == SSH_MSG_CHANNEL_OPEN oder typ == SSH_MSG_DISCONNECT
    wenn phase == SSH_PHASE_SITZUNG oder phase == SSH_PHASE_KANAL_ENDE:
        gib_zurück typ == SSH_MSG_CHANNEL_WINDOW_ADJUST oder typ == SSH_MSG_CHANNEL_EOF oder typ == SSH_MSG_CHANNEL_CLOSE oder typ == SSH_MSG_DISCONNECT oder (phase == SSH_PHASE_SITZUNG und typ == SSH_MSG_CHANNEL_REQUEST)
    gib_zurück falsch

# Fuenf Draht-IDs je Phase. 52 kommt in keiner Rolle vor, 90 erst nach Auth.
@nativ
konstante SSH_ROLLEN_SOLL: [u8; 50] auf [0,0,0,0,0, 20,0,0,0,0, 30,0,0,0,0, 21,0,0,0,0, 5,0,0,0,0, 0,0,0,0,0, 50,1,0,0,0, 90,1,0,0,0, 93,96,97,1,98, 93,96,97,1,0]

@nativ
funktion ssh_rolle_pruefen() -> bool:
    unsicher:
        setze phase: u64 auf 1
        solange phase <= 10:
            setze r: u64 auf adresse_von(SSH_ROLLEN_SOLL) + (phase - 1) * 5
            setze typ: u64 auf 0
            solange typ <= 255:
                setze soll: bool auf falsch
                setze i: u64 auf 0
                solange typ != 0 und i < 5:
                    wenn u64(speicher_lesen(r + i, 1)) == typ:
                        setze soll auf wahr
                    setze i auf i + 1
                wenn ssh_rolle_erlaubt(phase, typ) != soll:
                    gib_zurück falsch
                setze typ auf typ + 1
            setze phase auf phase + 1
        gib_zurück wahr

@nativ
funktion ssh_paket_inhalt(p: u64, n: u64, seq: u64) -> bool:
    unsicher:
        setze typ: u64 auf u64(speicher_lesen(p, 1))
        setze phase: u64 auf ssh_wert(versatz_von(SshVerbindung, phase))
        wenn nicht ssh_rolle_erlaubt(phase, typ):
            gib_zurück falsch
        wenn phase == SSH_PHASE_INIT:
            gib_zurück ssh_client_init(p, n, seq)
        wenn phase == SSH_PHASE_DH:
            gib_zurück ssh_ecdh(p, n)
        wenn phase == SSH_PHASE_NEU:
            wenn n != 1:
                gib_zurück falsch
            ssh_setze(versatz_von(SshVerbindung, rx_seq), 0)
            ssh_setze(versatz_von(SshVerbindung, rx_verschluesselt), 1)
            ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_DIENST)
            ssh_log(adresse_von(SSH_LOG_NEU), 1)
            gib_zurück wahr
        wenn phase == SSH_PHASE_DIENST:
            gib_zurück ssh_dienst(p, n)
        wenn typ == SSH_MSG_DISCONNECT:
            ssh_schliessen()
            gib_zurück wahr
        wenn phase == SSH_PHASE_AUTH:
            gib_zurück ssh_auth_antwort(p, n)
        wenn phase == SSH_PHASE_KANAL:
            gib_zurück ssh_kanal_oeffnen(p, n)
        gib_zurück ssh_kanal_nachricht(p, n, typ, phase)

# Rueckgabe ist die verbrauchte Drahtlaenge. Null bedeutet, dass Bytes
# fehlen oder ssh_fehler die Verbindung bereits zum Abschluss markiert hat.
@nativ
funktion ssh_paket_lesen(p: u64, n: u64) -> u64:
    unsicher:
        wenn n < 4:
            gib_zurück 0
        setze enc: bool auf ssh_wert(versatz_von(SshVerbindung, rx_verschluesselt)) == 1
        setze seq: u64 auf ssh_wert(versatz_von(SshVerbindung, rx_seq))
        setze l: u64 auf nt_r32(p, 0)
        setze tag: u64 auf 0
        setze prefix: u64 auf 4
        wenn enc:
            setze l auf moo_bare_ssh_length(p, seq)
            setze tag auf 16
            setze prefix auf 0
        wenn l < 6 oder l > SSH_EINGANG_MAX - 4 - tag oder (l + prefix) % 8 != 0:
            ssh_fehler()
            gib_zurück 0
        setze draht: u64 auf 4 + l + tag
        wenn draht > n:
            gib_zurück 0
        wenn enc und moo_bare_ssh_open(p, 4 + l, seq) != 1:
            ssh_fehler()
            gib_zurück 0
        setze pad: u64 auf u64(speicher_lesen(p + 4, 1))
        wenn pad < 4 oder pad > l - 2:
            ssh_fehler()
            gib_zurück 0
        ssh_setze(versatz_von(SshVerbindung, rx_seq), seq + 1)
        wenn nicht ssh_paket_inhalt(p + 5, l - pad - 1, seq):
            ssh_fehler()
            gib_zurück 0
        gib_zurück draht

@nativ
funktion ssh_version_uebernehmen(p: u64, lf: u64) -> bool:
    unsicher:
        wenn lf < 10 oder speicher_lesen(p + lf - 1, 1) != 13 oder nt_r32(p, 0) != 0x5353482D oder nt_r32(p, 4) != 0x322E302D oder speicher_lesen(p + 8, 1) == 32:
            gib_zurück falsch
        setze version_n: u64 auf lf - 1
        setze i: u64 auf 8
        solange i < version_n:
            setze v: u64 auf u64(speicher_lesen(p + i, 1))
            wenn v < 32 oder v > 126:
                gib_zurück falsch
            setze i auf i + 1
        moo_bare_ssh_versions(p, version_n, adresse_von(SSH_IDENT), SSH_IDENT_N - 2)
        wenn nicht ssh_server_init_senden():
            gib_zurück falsch
        ssh_setze(versatz_von(SshVerbindung, phase), SSH_PHASE_INIT)
        gib_zurück wahr

@nativ
funktion ssh_version_lesen(p: u64, n: u64) -> u64:
    unsicher:
        setze i: u64 auf 0
        solange i < n und i < 255:
            wenn speicher_lesen(p + i, 1) == 10:
                wenn ssh_version_uebernehmen(p, i):
                    gib_zurück i + 1
                ssh_fehler()
                gib_zurück 0
            setze i auf i + 1
        wenn n >= 255:
            ssh_fehler()
        gib_zurück 0

@nativ
funktion ssh_empfangen(p: u64, n: u64) -> void:
    unsicher:
        setze belegt: u64 auf ssh_wert(versatz_von(SshVerbindung, eingang))
        setze buf: u64 auf adresse_von(SSH_EINGANG)
        wenn ssh_fertig():
            gib_zurück
        wenn n > SSH_EINGANG_MAX - belegt:
            ssh_fehler()
            gib_zurück
        nt_kopiere(buf + belegt, p, n)
        setze belegt auf belegt + n
        solange belegt != 0:
            setze verbraucht: u64 auf 0
            wenn ssh_wert(versatz_von(SshVerbindung, phase)) == SSH_PHASE_VERSION:
                setze verbraucht auf ssh_version_lesen(buf, belegt)
            sonst:
                setze verbraucht auf ssh_paket_lesen(buf, belegt)
            wenn ssh_fertig():
                gib_zurück
            wenn verbraucht == 0:
                stopp
            setze belegt auf belegt - verbraucht
            # Ziel liegt vor der Quelle, nt_kopiere laeuft vorwaerts.
            nt_kopiere(buf, buf + verbraucht, belegt)
        ssh_setze(versatz_von(SshVerbindung, eingang), belegt)
