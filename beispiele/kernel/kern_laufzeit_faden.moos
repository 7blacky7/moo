# Plattformbindung des gemeinsamen fadenlokalen Laufzeitzustands.
aus "kern_laufzeit_typen" importiere LaufzeitWert, LaufzeitFehler, laufzeit_kontext_starten_fuer
aus "kern_laufzeit_plattform" importiere kern_c_moo_backend_kontext, kern_c_moo_backend_abgeben

@nativ
funktion laufzeit_kontext() -> ptr[LaufzeitFehler]:
    unsicher:
        gib_zurück kern_c_moo_backend_kontext()

@nativ
funktion laufzeit_kontext_starten(worker: u8) -> bool:
    unsicher:
        gib_zurück laufzeit_kontext_starten_fuer(laufzeit_kontext(), worker)

@nativ
@einstieg
funktion moo_kern_error_flag() -> ptr[i32]:
    unsicher:
        gib_zurück zeiger(adresse_von(laufzeit_kontext().flag))

@nativ
@einstieg
funktion moo_kern_last_error() -> ptr[LaufzeitWert]:
    unsicher:
        gib_zurück zeiger(adresse_von(laufzeit_kontext().letzter))

@nativ
@einstieg
funktion moo_kern_try_depth() -> ptr[i32]:
    unsicher:
        gib_zurück zeiger(adresse_von(laufzeit_kontext().tiefe))

@nativ
@einstieg
funktion moo_kern_fehler_ort() -> ptr[u64]:
    unsicher:
        gib_zurück zeiger(adresse_von(laufzeit_kontext().wurfort))

@nativ
@einstieg
funktion moo_kern_fehler_gemeldet() -> ptr[i32]:
    unsicher:
        gib_zurück zeiger(adresse_von(laufzeit_kontext().gemeldet))

@nativ
@einstieg
funktion moo_kern_worker_flag() -> ptr[u8]:
    unsicher:
        gib_zurück zeiger(adresse_von(laufzeit_kontext().worker))

@nativ
@einstieg
funktion moo_kern_faden_abgeben() -> void:
    unsicher:
        kern_c_moo_backend_abgeben()
