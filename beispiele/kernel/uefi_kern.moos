# ============================================================
# uefi_kern.moos — P7-T5/T6: Moo-Kern hinter dem Moo-UEFI-Loader
# ============================================================
# Einsprung moo_kern_start (@nackt): cli, eigener Stack (KERN_STAPEL, in Moo),
# kern_haupt(boot_info). Der Loader (beispiele/uefi/moo_lader.moos) hat
# ExitBootServices schon gerufen; hier gibt es keine Firmwaredienste mehr.
# P7-T6: Kernlogik in Moo, Darstellung mit dem vorhandenen C-Surface-Kern:
#   - eigene GDT (64-Bit-Code/Daten), lgdt + Segmentneuladen
#   - eigene Seitentabellen: Identitaet 0..N GiB (2-MiB-Seiten), Framebuffer,
#     Kern in der oberen Haelfte (4-KiB-Seiten) -> CR3
#   - Zeichnen NUR in den Surface-Rueckpuffer (RGBA8888, moo_surface_core),
#     Present auf den GOP-Framebuffer mit Pixelformat-Umsetzung:
#     0 = RGBX, 1 = BGRX, 2 = Bitmaske (beliebige Masken), 3 = BltOnly -> nur COM1
#   - Textkonsole ueber Surface-Text (3x5-Schrift), Scrollen, Zeilen-Present
#   - COM1 (0x3F8) + debugcon (0xE9) als zweiter Kanal fuer jede Konsolenzeile
#   - Selbsttest der Formatumsetzung und Messung (TSC, ueber PIT kalibriert)
# Bau:  moo compile beispiele/kernel/uefi_kern.moos --no-stdlib --target x86_64-bare \
#           --kernel --linker-script beispiele/kernel/linker-uefi.ld -o kern.elf

# Vertrag Loader -> Kern: eine Quelle fuer beide Seiten.
aus "moo_bootvertrag" importiere MooBootInfo, BOOT_MAGIE
aus "usb_xhci" importiere usb_starten, usb_report_pruefen, usb_poll_berichte, xh, xh_neue_taste, xh_ascii, usb_inventar
aus "usb_speicher" importiere usb_speicher_pruefen
aus "nvme" importiere nvme_pruefen
aus "i226_diagnose" importiere i226_inventar
aus "netz_ipv4" importiere netz_ipv4_poll
aus "netz_tcp" importiere netz_tcp_wartung
aus "netz_ssh" importiere ssh_booten, ssh_bereit
aus "test_neustart" importiere testlauf_starten, testlauf_poll, testlauf_rueckfall, testlauf_konfig, testlauf_neustart
aus "../uefi/hardware_pci" importiere takt, nt_cfg_lese32
aus "../uefi/netz_geraet" importiere nt_finde, nt_bar, nt_oeffnen_in, nt_link, nt_senden, nt_udp_rahmen, nt_kopiere, pci_lese32, pci_schreibe32

# P7-T26: Explizit freigegebener Boot-Stick aus dem N100-Inventar.
# Diagnose beendet den MSC-Host vor dem vorhandenen HID-Start.
# Private Laufprofile binden hier den USB-iSerial aus dem Stringdeskriptor.
# Windows Get-Disk.SerialNumber ist der separate Runner-Vertrag.
@nativ
statisch USB_LESEN_ZIEL: [u64; 3] auf [0x44524253554F4F4D, 0x68, 0x1000090C]
@nativ
konstante USB_LESEN_SERIE: [u8; _] auf "AA00000000000489"
@nativ
funktion usb_leseziel(index: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(USB_LESEN_ZIEL) + index * 8, 8)

# P7-T27: interne SSD bleibt deaktiviert, bis BDF, NSID und exakte SN20
# vom Koordinator fuer einen lesenden Lauf freigegeben sind. 65536 ist KEINE BDF.
# Private QEMU-Kopie patcht diesen 64-Byte-Datenvertrag, nie Produkt-Testwerte.
@nativ
statisch NVME_LESEN_ZIEL: [u64; 8] auf [0x4E564D45524F3031, 65536, 1, 0, 0, 0, 0, 0]

# Sammler nur in einer privaten ELF-Kopie einschalten. Feld 2 ist die PCI-ID
# des expliziten NVMe-Inventarziels. Inventar startet keine I/O-Queue.
@nativ
statisch SAMMEL_ZIEL: [u64; 3] auf [0x4C4D4D41534F4F4D, 0, 0]
# MOOKRYP1: Bare-Link-Opt-in, Laufwert nur in der privaten ELF-Kopie setzen.
@nativ
@sektion(".data.moo_krypto")
statisch SAMMEL_KRYPTO: [u64; 2] auf [0x315059524B4F4F4D, 0]
# Dieselbe lesende Diagnose mit QEMU-igb nur in einer privaten ELF-Kopie.
@nativ
statisch SAMMEL_I226_ZIEL: [u64; 2] auf [0x4F52363232494F4D, 0x125C8086]
@nativ
statisch NVME_INVENTAR_ZIEL: [u64; 8] auf [0x4E564D45524F3031, 65536, 0, 0, 0, 0, 0, 0]

# UEFI-Speicherdeskriptor (Spec 2.10, 7.2 GetMemoryMap); Schrittweite aus der Boot-Info.
struktur EfiSpeicherDeskriptor:
    sd_typ: u32
    sd_physisch: u64
    sd_virtuell: u64
    sd_seiten: u64
    sd_attribute: u64

# Zustand der Textkonsole (liegt in KONSOLE, Zugriff ueber versatz_von).
struktur Konsole:
    k_x: u64
    k_y: u64
    k_links: u64
    k_oben: u64
    k_rechts: u64
    k_unten: u64
    k_skala: u64
    k_farbe: u64
    k_grund: u64
    k_aktiv: u64
    k_schmutz_oben: u64
    k_schmutz_unten: u64

# Present-Ziel (GOP) und Rueckpuffer.
struktur Schirm:
    s_fb: u64
    s_breite: u64
    s_hoehe: u64
    s_ziel_stride: u64
    s_format: u64
    s_mr: u64
    s_mg: u64
    s_mb: u64
    s_puffer: u64
    s_puffer_stride: u64
    s_kern: u64
    s_tsc_us: u64

# "RSD PTR " als u64 (little endian)
@nativ
konstante RSDP_SIGNATUR: u64 auf 0x2052545020445352

# ---------------- Statischer Speicher (P7-T6: @nativ statisch) ----------------
# Stack des Kerns (vorher im Linkerskript).
@nativ
@ausrichten(16)
statisch KERN_STAPEL: [u8; 65536] auf 0

# Rueckpuffer RGBA8888 bis 3840x2160 (bss, der Loader nullt ihn).
@nativ
@ausrichten(4096)
statisch BILD: [u8; 33177600] auf 0

# MooSurfaceCore (C-Struktur, < 1 KiB) und Kleinkram.
@nativ
@ausrichten(16)
statisch SURFACE_KERN: [u8; 1024] auf 0

@nativ
statisch ZEICHEN: [u8; 8] auf 0

@nativ
statisch KONSOLE: Konsole auf 0

@nativ
statisch SCHIRM: Schirm auf 0

# GDT: Null, 64-Bit-Code (0x08), Daten (0x10), TSS (0x18, zwei Slots).
@nativ
@ausrichten(16)
statisch GDT: [u64; 5] auf [0, 0x00AF9A000000FFFF, 0x00CF92000000FFFF, 0, 0]

@nativ
@ausrichten(16)
statisch GDT_ZEIGER: [u8; 16] auf 0

# 64-Bit-TSS mit IST1 fuer Double Fault sowie 256 IDT-Tore.
@nativ
@ausrichten(16)
statisch TSS: [u8; 104] auf 0

@nativ
@ausrichten(16)
statisch IST_DOPPELFEHLER: [u8; 16384] auf 0

@nativ
@ausrichten(16)
statisch IDT: [u64; 512] auf 0

@nativ
@ausrichten(16)
statisch IDT_ZEIGER: [u8; 16] auf 0

# [letzter Vektor, Fehlercode, RIP]
@nativ
statisch AUSNAHME_ZUSTAND: [u64; 3] auf [0, 0, 0]

# P7-T7 Hardwarezustand:
# 0 PM-Port, 1 PM-Maske, 2 MADT, 3 LAPIC-Basis, 4 x2APIC, 5 APIC-ID,
# 6 IOAPIC-Basis, 7 IOAPIC-GSI-Basis, 8 Tastatur-GSI, 9 ISO-Flags,
# 10 Timer-Ticks, 11 erster Make-Scancode, 15 Timerquelle (1 PM, 2 TSC).
@nativ
statisch HARDWARE_ZUSTAND: [u64; 16] auf 0

# Seitentabellen: Identitaet bis 64 GiB (2-MiB-Seiten), 2 GiB Framebuffer-Fenster
# fuer FB oberhalb davon, Kern bis 64 MiB (4-KiB-Seiten).
@nativ
@ausrichten(4096)
statisch PML4: [u64; 512] auf 0

@nativ
@ausrichten(4096)
statisch PDPT_IDENT: [u64; 512] auf 0

@nativ
@ausrichten(4096)
statisch PD_IDENT: [u64; 32768] auf 0

@nativ
@ausrichten(4096)
statisch PD_FB: [u64; 1024] auf 0

@nativ
@ausrichten(4096)
statisch PDPT_KERN: [u64; 512] auf 0

@nativ
@ausrichten(4096)
statisch PD_KERN: [u64; 512] auf 0

@nativ
@ausrichten(4096)
statisch PT_KERN: [u64; 16384] auf 0

# P7-T7: Bitmap fuer 64 GiB / 4 KiB = 16.777.216 Frames = 2 MiB.
# Ein gesetztes Bit bedeutet frei. Vor dem eigenen CR3 werden nur Typ-7-Seiten
# eingetragen; Loader-/BootServices-Speicher folgt explizit danach.
@nativ
@ausrichten(4096)
statisch PFA_BITS: [u8; 2097152] auf 0

# [maximale Frames, freie Frames, Suchcursor]
@nativ
statisch PFA_ZUSTAND: [u64; 3] auf [0, 0, 0]

# [Heap-Basis, Heap-Groesse]
@nativ
statisch HEAP_ZUSTAND: [u64; 2] auf [0, 0]

# Selbsttest der Formatumsetzung: 3 Pixel RGBA (r=12 g=34 b=56 a=FF).
@nativ
statisch TEST_QUELLE: [u32; 4] auf [0xFF563412, 0xFF563412, 0xFF563412, 0]

@nativ
statisch TEST_ZIEL: [u32; 4] auf [0, 0, 0, 0]

# Vorhandener Surface-Kern (compiler/runtime/moo_surface_core.c, RGBA8888,
# stride in Bytes). bool-Ergebnis als u8; MooSurfaceColor {r,g,b,a} wird als
# u32 = r | g<<8 | b<<16 | a<<24 uebergeben (SysV: beide INTEGER in einem Register).
extern "C" funktion moo_bare_krypto_selbsttest() -> u64
extern "C" funktion moo_bare_entropie_selbsttest() -> u64

extern "C" funktion moo_surface_core_init(kern: ptr[u8], pixel: ptr[u8], bytes: u64, breite: i32, hoehe: i32, stride: u64) -> u8
extern "C" funktion moo_surface_core_clear(kern: ptr[u8], farbe: u32) -> u8
extern "C" funktion moo_surface_core_rect(kern: ptr[u8], x: i32, y: i32, breite: i32, hoehe: i32, farbe: u32) -> u8
extern "C" funktion moo_surface_core_text_3x5(kern: ptr[u8], x: i32, y: i32, skala: i32, text: ptr[u8], laenge: u64, farbe: u32) -> u8

