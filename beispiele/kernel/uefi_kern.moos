# ---------------- Einsprung ----------------
# Vom Loader per call (SysV) mit rdi = Boot-Info erreicht. rdi bleibt
# unberuehrt und ist damit das erste Argument von kern_haupt.
@nativ
@nackt
@einstieg
funktion moo_kern_start() -> void:
    unsicher:
        assembler(ziel="x86_64", code="cli; leaq KERN_STAPEL+65536(%rip), %rsp; xorl %ebp, %ebp; call kern_haupt; 1: hlt; jmp 1b", clobber=[])

# ---------------- Ports, Takt ----------------
@nativ
funktion aus8(port: u16, wert: u8) -> void:
    unsicher:
        port_schreibe(port, wert)

@nativ
funktion ein8(port: u16) -> u8:
    unsicher:
        gib_zurück port_lese(port)


# TSC-Takte je Mikrosekunde ueber PIT-Kanal 2 (50 ms, Modus 0). 0 = unbekannt.
@nativ
funktion tsc_kalibrieren() -> u64:
    unsicher:
        setze v: u8 auf ein8(0x61) & 0xFC
        setze n: u64 auf 0
        setze t0: u64 auf 0
        aus8(0x61, v)
        aus8(0x43, 0xB0)
        aus8(0x42, 0x0B)
        aus8(0x42, 0xE9)
        setze t0 auf takt()
        aus8(0x61, v | 1)
        solange (ein8(0x61) & 0x20) == 0 und n < 100000000:
            setze n auf n + 1
        wenn n >= 100000000:
            gib_zurück 0
        gib_zurück (takt() - t0) / 50000

# ---------------- COM1 + debugcon ----------------
@nativ
funktion seriell_init() -> void:
    unsicher:
        port_schreibe(0x3F9, 0)
        port_schreibe(0x3FB, 0x80)
        port_schreibe(0x3F8, 1)
        port_schreibe(0x3F9, 0)
        port_schreibe(0x3FB, 3)
        port_schreibe(0x3FA, 0xC7)
        port_schreibe(0x3FC, 3)

@nativ
funktion seriell(z: u8) -> void:
    unsicher:
        setze n: u32 auf 0
        solange (port_lese(0x3FD) & 0x20) == 0 und n < 100000:
            setze n auf n + 1
        port_schreibe(0x3F8, z)
        port_schreibe(0xE9, z)

# ---------------- Present: Rueckpuffer -> GOP ----------------
# Lage des niedrigsten gesetzten Bits und Bitbreite einer Maske.
@nativ
funktion maske_lage(m: u64) -> u64:
    unsicher:
        setze i: u64 auf 0
        wenn m == 0:
            gib_zurück 0
        solange ((m >> i) & 1) == 0:
            setze i auf i + 1
        gib_zurück i

@nativ
funktion maske_breite(m: u64) -> u64:
    unsicher:
        setze i: u64 auf 0
        setze b: u64 auf 0
        solange i < 32:
            setze b auf b + ((m >> i) & 1)
            setze i auf i + 1
        gib_zurück b

# 8-Bit-Kanal auf Maskenbreite skalieren und an die Maskenlage schieben.
@nativ
funktion kanal(c: u64, lage: u64, breite: u64) -> u64:
    unsicher:
        wenn breite == 0:
            gib_zurück 0
        wenn breite >= 8:
            gib_zurück (c << (breite - 8)) << lage
        gib_zurück (c >> (8 - breite)) << lage

# Zeilen y0..y1 (halboffen) aus quelle (RGBA8888, Stride qs Bytes) nach ziel
# (32 Bit je Pixel, Stride zs Pixel) im GOP-Format umsetzen.
@nativ
funktion praesentieren(quelle: u64, qs: u64, ziel: u64, zs: u64, breite: u64, y0: u64, y1: u64, format: u64, mr: u64, mg: u64, mb: u64) -> void:
    unsicher:
        setze y: u64 auf y0
        setze x: u64 auf 0
        setze q: u64 auf 0
        setze z: u64 auf 0
        setze v: u64 auf 0
        setze paare: u64 auf breite / 2
        setze lr: u64 auf maske_lage(mr)
        setze lg: u64 auf maske_lage(mg)
        setze lb: u64 auf maske_lage(mb)
        setze br: u64 auf maske_breite(mr)
        setze bg: u64 auf maske_breite(mg)
        setze bb: u64 auf maske_breite(mb)
        solange y < y1:
            setze q auf quelle + y * qs
            setze z auf ziel + y * zs * 4
            setze x auf 0
            wenn format == 0:
                # RGBX = Bytefolge R,G,B,X: wie RGBA, zwei Pixel je 64-Bit-Zugriff.
                solange x < paare:
                    speicher_schreiben(z + x * 8, speicher_lesen(q + x * 8, 8), 8)
                    setze x auf x + 1
                wenn (breite & 1) != 0:
                    speicher_schreiben(z + (breite - 1) * 4, speicher_lesen(q + (breite - 1) * 4, 4), 4)
            sonst wenn format == 1:
                # BGRX: R und B tauschen, zwei Pixel je 64-Bit-Zugriff.
                solange x < paare:
                    setze v auf speicher_lesen(q + x * 8, 8)
                    speicher_schreiben(z + x * 8, ((v & 0x000000FF000000FF) << 16) | (v & 0x0000FF000000FF00) | ((v >> 16) & 0x000000FF000000FF), 8)
                    setze x auf x + 1
                wenn (breite & 1) != 0:
                    setze v auf u64(speicher_lesen(q + (breite - 1) * 4, 4))
                    speicher_schreiben(z + (breite - 1) * 4, u32(((v & 0xFF) << 16) | (v & 0xFF00) | ((v >> 16) & 0xFF)), 4)
            sonst:
                # Bitmaske: jeden Kanal auf Breite/Lage seiner Maske umsetzen.
                solange x < breite:
                    setze v auf u64(speicher_lesen(q + x * 4, 4))
                    speicher_schreiben(z + x * 4, u32(kanal(v & 0xFF, lr, br) | kanal((v >> 8) & 0xFF, lg, bg) | kanal((v >> 16) & 0xFF, lb, bb)), 4)
                    setze x auf x + 1
            setze y auf y + 1

# Zeilen y0..y1 des Rueckpuffers auf den Schirm bringen.
@nativ
funktion schirm_zeilen(y0: u64, y1: u64) -> void:
    unsicher:
        setze s: u64 auf adresse_von(SCHIRM)
        wenn speicher_lesen(s + versatz_von(Schirm, s_fb), 8) == 0:
            gib_zurück
        praesentieren(speicher_lesen(s + versatz_von(Schirm, s_puffer), 8), speicher_lesen(s + versatz_von(Schirm, s_puffer_stride), 8), speicher_lesen(s + versatz_von(Schirm, s_fb), 8), speicher_lesen(s + versatz_von(Schirm, s_ziel_stride), 8), speicher_lesen(s + versatz_von(Schirm, s_breite), 8), y0, y1, speicher_lesen(s + versatz_von(Schirm, s_format), 8), speicher_lesen(s + versatz_von(Schirm, s_mr), 8), speicher_lesen(s + versatz_von(Schirm, s_mg), 8), speicher_lesen(s + versatz_von(Schirm, s_mb), 8))

# Selbsttest: Formate 0, 1 und drei Bitmasken (8-8-8, 10-10-10, 5-6-5).
@nativ
funktion formate_pruefen() -> u64:
    unsicher:
        setze q: u64 auf adresse_von(TEST_QUELLE)
        setze z: u64 auf adresse_von(TEST_ZIEL)
        setze ok: u64 auf 0
        praesentieren(q, 16, z, 4, 3, 0, 1, 0, 0, 0, 0)
        wenn (speicher_lesen(z, 4) & 0x00FFFFFF) == 0x563412 und (speicher_lesen(z + 8, 4) & 0x00FFFFFF) == 0x563412:
            setze ok auf ok + 1
        praesentieren(q, 16, z, 4, 3, 0, 1, 1, 0, 0, 0)
        wenn (speicher_lesen(z, 4) & 0x00FFFFFF) == 0x123456 und (speicher_lesen(z + 8, 4) & 0x00FFFFFF) == 0x123456:
            setze ok auf ok + 1
        praesentieren(q, 16, z, 4, 3, 0, 1, 2, 0xFF0000, 0xFF00, 0xFF)
        wenn speicher_lesen(z, 4) == 0x123456 und speicher_lesen(z + 8, 4) == 0x123456:
            setze ok auf ok + 1
        praesentieren(q, 16, z, 4, 3, 0, 1, 2, 0x3FF00000, 0xFFC00, 0x3FF)
        wenn speicher_lesen(z, 4) == 0x04834158 und speicher_lesen(z + 8, 4) == 0x04834158:
            setze ok auf ok + 1
        praesentieren(q, 16, z, 4, 3, 0, 1, 2, 0xF800, 0x7E0, 0x1F)
        wenn speicher_lesen(z, 4) == 0x11AA und speicher_lesen(z + 8, 4) == 0x11AA:
            setze ok auf ok + 1
        gib_zurück ok

# ---------------- Textkonsole ueber Surface-Text ----------------
@nativ
funktion kon(feld: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(KONSOLE) + feld, 8)

@nativ
funktion kon_setze(feld: u64, wert: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(KONSOLE) + feld, wert, 8)

@nativ
funktion kon_schmutz(y0: u64, y1: u64) -> void:
    unsicher:
        wenn y0 < kon(versatz_von(Konsole, k_schmutz_oben)):
            kon_setze(versatz_von(Konsole, k_schmutz_oben), y0)
        wenn y1 > kon(versatz_von(Konsole, k_schmutz_unten)):
            kon_setze(versatz_von(Konsole, k_schmutz_unten), y1)

# Geaenderte Zeilen praesentieren.
@nativ
funktion kon_zeigen() -> void:
    unsicher:
        setze o: u64 auf kon(versatz_von(Konsole, k_schmutz_oben))
        setze u: u64 auf kon(versatz_von(Konsole, k_schmutz_unten))
        wenn u > o:
            schirm_zeilen(o, u)
        kon_setze(versatz_von(Konsole, k_schmutz_oben), 0xFFFFFFFF)
        kon_setze(versatz_von(Konsole, k_schmutz_unten), 0)

# Konsolenbereich um eine Textzeile nach oben schieben (im Rueckpuffer).
@nativ
funktion kon_rollen() -> void:
    unsicher:
        setze s: u64 auf adresse_von(SCHIRM)
        setze puffer: u64 auf speicher_lesen(s + versatz_von(Schirm, s_puffer), 8)
        setze ps: u64 auf speicher_lesen(s + versatz_von(Schirm, s_puffer_stride), 8)
        setze links: u64 auf kon(versatz_von(Konsole, k_links))
        setze rechts: u64 auf kon(versatz_von(Konsole, k_rechts))
        setze oben: u64 auf kon(versatz_von(Konsole, k_oben))
        setze unten: u64 auf kon(versatz_von(Konsole, k_unten))
        setze h: u64 auf 6 * kon(versatz_von(Konsole, k_skala))
        setze y: u64 auf oben
        setze x: u64 auf 0
        setze w: u64 auf (rechts - links) / 2
        solange y + h < unten:
            setze x auf 0
            solange x < w:
                speicher_schreiben(puffer + y * ps + links * 4 + x * 8, speicher_lesen(puffer + (y + h) * ps + links * 4 + x * 8, 8), 8)
                setze x auf x + 1
            setze y auf y + 1
        moo_surface_core_rect(zeiger(speicher_lesen(s + versatz_von(Schirm, s_kern), 8)), i32(links), i32(y), i32(rechts - links), i32(unten - y), u32(kon(versatz_von(Konsole, k_grund))))
        kon_schmutz(oben, unten)

@nativ
funktion kon_neue_zeile() -> void:
    unsicher:
        setze h: u64 auf 6 * kon(versatz_von(Konsole, k_skala))
        kon_setze(versatz_von(Konsole, k_x), kon(versatz_von(Konsole, k_links)))
        kon_setze(versatz_von(Konsole, k_y), kon(versatz_von(Konsole, k_y)) + h)
        wenn kon(versatz_von(Konsole, k_y)) + h > kon(versatz_von(Konsole, k_unten)):
            kon_rollen()
            kon_setze(versatz_von(Konsole, k_y), kon(versatz_von(Konsole, k_y)) - h)

# Ein Zeichen auf beide Kanaele: COM1/0xE9 immer, Schirm wenn aktiv.
@nativ
funktion zeichen(z: u8) -> void:
    unsicher:
        setze skala: u64 auf 0
        setze x: u64 auf 0
        setze y: u64 auf 0
        seriell(z)
        netz_zeichen(z)
        wenn kon(versatz_von(Konsole, k_aktiv)) == 0:
            gib_zurück
        setze skala auf kon(versatz_von(Konsole, k_skala))
        wenn z == 10:
            kon_neue_zeile()
            kon_zeigen()
            gib_zurück
        setze x auf kon(versatz_von(Konsole, k_x))
        setze y auf kon(versatz_von(Konsole, k_y))
        speicher_schreiben(adresse_von(ZEICHEN), z, 1)
        moo_surface_core_text_3x5(zeiger(speicher_lesen(adresse_von(SCHIRM) + versatz_von(Schirm, s_kern), 8)), i32(x), i32(y), i32(skala), zeiger(adresse_von(ZEICHEN)), 1, u32(kon(versatz_von(Konsole, k_farbe))))
        kon_schmutz(y, y + 5 * skala)
        kon_setze(versatz_von(Konsole, k_x), x + 4 * skala)
        wenn x + 7 * skala > kon(versatz_von(Konsole, k_rechts)):
            kon_neue_zeile()

@nativ
funktion konsole_starten(links: u64, oben: u64, rechts: u64, unten: u64, skala: u64, farbe: u64, grund: u64) -> void:
    unsicher:
        kon_setze(versatz_von(Konsole, k_links), links)
        kon_setze(versatz_von(Konsole, k_oben), oben)
        kon_setze(versatz_von(Konsole, k_rechts), rechts)
        kon_setze(versatz_von(Konsole, k_unten), unten)
        kon_setze(versatz_von(Konsole, k_skala), skala)
        kon_setze(versatz_von(Konsole, k_farbe), farbe)
        kon_setze(versatz_von(Konsole, k_grund), grund)
        kon_setze(versatz_von(Konsole, k_x), links)
        kon_setze(versatz_von(Konsole, k_y), oben)
        kon_setze(versatz_von(Konsole, k_schmutz_oben), 0xFFFFFFFF)
        kon_setze(versatz_von(Konsole, k_schmutz_unten), 0)
        kon_setze(versatz_von(Konsole, k_aktiv), 1)

@nativ
funktion text(adr: u64) -> void:
    unsicher:
        setze i: u64 auf 0
        solange speicher_lesen(adr + i, 1) != 0:
            zeichen(speicher_lesen(adr + i, 1))
            setze i auf i + 1

@nativ
funktion hex_ziffer(wert: u64, index: u64) -> u8:
    setze ziffer: u8 auf als(u8, (wert >> (60 - index * 4)) & 15)
    wenn ziffer < 10:
        gib_zurück ziffer + 48
    gib_zurück ziffer + 55

@nativ
funktion hex(wert: u64) -> void:
    unsicher:
        setze i: u64 auf 0
        solange i < 16:
            zeichen(hex_ziffer(wert, i))
            setze i auf i + 1

@nativ
funktion meldung(adr: u64, wert: u64) -> void:
    unsicher:
        text(adr)
        hex(wert)
        zeichen(10)

@nativ
funktion anhalten() -> void:
    unsicher:
        solange wahr:
            assembler(ziel="x86_64", code="cli; hlt", clobber=[])

# ---------------- GDT ----------------
@nativ
funktion gdt_laden(zeiger_adr: u64) -> void:
    unsicher:
        assembler(ziel="x86_64", code="lgdt ($0); pushq $$0x08; leaq 1f(%rip), %rax; pushq %rax; lretq; 1: movw $$0x10, %ax; movw %ax, %ds; movw %ax, %es; movw %ax, %ss; movw %ax, %fs; movw %ax, %gs", eingaenge={"r": zeiger_adr}, clobber=["rax", "memory"])

@nativ
funktion gdt_einrichten() -> u64:
    unsicher:
        setze z: u64 auf adresse_von(GDT_ZEIGER)
        setze basis: u64 auf adresse_von(TSS)
        setze niedrig: u64 auf 103 | ((basis & 0xFFFFFF) << 16) | (0x89 << 40) | (((basis >> 24) & 0xFF) << 56)
        # RSP0 und IST1; I/O-Bitmap beginnt hinter dem 104-Byte-TSS.
        speicher_schreiben(basis + 4, adresse_von(KERN_STAPEL) + 65536, 8)
        speicher_schreiben(basis + 36, adresse_von(IST_DOPPELFEHLER) + 16384, 8)
        speicher_schreiben(basis + 102, 104, 2)
        speicher_schreiben(adresse_von(GDT) + 24, niedrig, 8)
        speicher_schreiben(adresse_von(GDT) + 32, basis >> 32, 8)
        speicher_schreiben(z, u16(5 * 8 - 1), 2)
        speicher_schreiben(z + 2, adresse_von(GDT), 8)
        gdt_laden(z)
        tss_laden()
        gib_zurück assembler(ziel="x86_64", code="movq %cs, $0", ausgang="=r", clobber=[])

# ---------------- TSS, IDT und Ausnahmen ----------------
@nativ
funktion tss_laden() -> void:
    unsicher:
        assembler(ziel="x86_64", code="movw $$0x18, %ax; ltr %ax", clobber=["rax", "memory"])

@nativ
funktion idt_laden(zeiger_adr: u64) -> void:
    unsicher:
        assembler(ziel="x86_64", code="lidt ($0)", eingaenge={"r": zeiger_adr}, clobber=["memory"])

@nativ
funktion idt_tor(vektor: u64, ziel: u64, ist: u64) -> void:
    unsicher:
        setze tor: u64 auf adresse_von(IDT) + vektor * 16
        speicher_schreiben(tor, u16(ziel & 0xFFFF), 2)
        speicher_schreiben(tor + 2, u16(0x08), 2)
        speicher_schreiben(tor + 4, u8(ist & 7), 1)
        speicher_schreiben(tor + 5, u8(0x8E), 1)
        speicher_schreiben(tor + 6, u16((ziel >> 16) & 0xFFFF), 2)
        speicher_schreiben(tor + 8, u32((ziel >> 32) & 0xFFFFFFFF), 4)
        speicher_schreiben(tor + 12, 0, 4)

@nativ
funktion ausnahme_melden(vektor: u64, fehler: u64, rip: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(AUSNAHME_ZUSTAND), vektor, 8)
        speicher_schreiben(adresse_von(AUSNAHME_ZUSTAND) + 8, fehler, 8)
        speicher_schreiben(adresse_von(AUSNAHME_ZUSTAND) + 16, rip, 8)
        meldung(adresse_von(T_AUS_VEKTOR), vektor)
        meldung(adresse_von(T_AUS_FEHLER), fehler)
        meldung(adresse_von(T_AUS_RIP), rip)
        wenn vektor != 3:
            anhalten()

@nativ
@unterbrechung(0)
funktion ausnahme_0(rahmen: ptr[u64]) -> void:
    unsicher:
        ausnahme_melden(0, 0, volatile_lesen(rahmen, 0))

