@nativ
funktion idt_einrichten() -> bool:
    unsicher:
        setze z: u64 auf adresse_von(IDT_ZEIGER)
        idt_tor(0, adresse_von(ausnahme_0), 0)
        idt_tor(1, adresse_von(ausnahme_1), 0)
        idt_tor(2, adresse_von(ausnahme_2), 0)
        idt_tor(3, adresse_von(ausnahme_3), 0)
        idt_tor(4, adresse_von(ausnahme_4), 0)
        idt_tor(5, adresse_von(ausnahme_5), 0)
        idt_tor(6, adresse_von(ausnahme_6), 0)
        idt_tor(7, adresse_von(ausnahme_7), 0)
        idt_tor(8, adresse_von(ausnahme_8), 1)
        idt_tor(9, adresse_von(ausnahme_9), 0)
        idt_tor(10, adresse_von(ausnahme_10), 0)
        idt_tor(11, adresse_von(ausnahme_11), 0)
        idt_tor(12, adresse_von(ausnahme_12), 0)
        idt_tor(13, adresse_von(ausnahme_13), 0)
        idt_tor(14, adresse_von(ausnahme_14), 0)
        idt_tor(15, adresse_von(ausnahme_15), 0)
        idt_tor(16, adresse_von(ausnahme_16), 0)
        idt_tor(17, adresse_von(ausnahme_17), 0)
        idt_tor(18, adresse_von(ausnahme_18), 0)
        idt_tor(19, adresse_von(ausnahme_19), 0)
        idt_tor(20, adresse_von(ausnahme_20), 0)
        idt_tor(21, adresse_von(ausnahme_21), 0)
        idt_tor(22, adresse_von(ausnahme_22), 0)
        idt_tor(23, adresse_von(ausnahme_23), 0)
        idt_tor(24, adresse_von(ausnahme_24), 0)
        idt_tor(25, adresse_von(ausnahme_25), 0)
        idt_tor(26, adresse_von(ausnahme_26), 0)
        idt_tor(27, adresse_von(ausnahme_27), 0)
        idt_tor(28, adresse_von(ausnahme_28), 0)
        idt_tor(29, adresse_von(ausnahme_29), 0)
        idt_tor(30, adresse_von(ausnahme_30), 0)
        idt_tor(31, adresse_von(ausnahme_31), 0)
        speicher_schreiben(z, u16(256 * 16 - 1), 2)
        speicher_schreiben(z + 2, adresse_von(IDT), 8)
        idt_laden(z)
        gib_zurück wahr

@nativ
funktion ausnahme_pruefen() -> bool:
    unsicher:
        speicher_schreiben(adresse_von(AUSNAHME_ZUSTAND), 0xFFFFFFFFFFFFFFFF, 8)
        speicher_schreiben(adresse_von(AUSNAHME_ZUSTAND) + 8, 0, 8)
        speicher_schreiben(adresse_von(AUSNAHME_ZUSTAND) + 16, 0, 8)
        assembler(ziel="x86_64", code="int3", clobber=["memory"])
        gib_zurück speicher_lesen(adresse_von(AUSNAHME_ZUSTAND), 8) == 3 und speicher_lesen(adresse_von(AUSNAHME_ZUSTAND) + 16, 8) != 0

# ---------------- ACPI, LAPIC-Timer, IOAPIC und PS/2 ----------------
@nativ
funktion hw(index: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(HARDWARE_ZUSTAND) + index * 8, 8)

@nativ
funktion hw_setze(index: u64, wert: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(HARDWARE_ZUSTAND) + index * 8, wert, 8)

@nativ
funktion ein32(port: u16) -> u32:
    unsicher:
        gib_zurück port_in32(port)

@nativ
funktion msr_lesen(index: u32) -> u64:
    unsicher:
        gib_zurück assembler(ziel="x86_64", code="rdmsr; shlq $$32, %rdx; orq %rdx, %rax", ausgang="={rax}", eingaenge={"{ecx}": index}, clobber=["rdx"])

@nativ
funktion msr_schreiben_roh(index: u32, niedrig: u32, hoch: u32) -> void:
    unsicher:
        assembler(ziel="x86_64", code="wrmsr", eingaenge={"{ecx}": index, "{eax}": niedrig, "{edx}": hoch}, clobber=[])

@nativ
funktion msr_schreiben(index: u32, wert: u64) -> void:
    unsicher:
        msr_schreiben_roh(index, u32(wert & 0xFFFFFFFF), u32(wert >> 32))

@nativ
funktion acpi_pruefsumme(adr: u64, laenge: u64) -> bool:
    unsicher:
        setze i: u64 auf 0
        setze summe: u64 auf 0
        wenn adr == 0 oder laenge == 0 oder laenge > 0x100000:
            gib_zurück falsch
        solange i < laenge:
            setze summe auf (summe + u64(speicher_lesen(adr + i, 1))) & 0xFF
            setze i auf i + 1
        gib_zurück summe == 0

@nativ
funktion acpi_tabelle(rsdp: u64, signatur: u32) -> u64:
    unsicher:
        setze wurzel: u64 auf 0
        setze schritt: u64 auf 0
        setze laenge: u64 auf 0
        setze anzahl: u64 auf 0
        setze i: u64 auf 0
        setze tabelle: u64 auf 0
        wenn rsdp == 0 oder speicher_lesen(rsdp, 8) != RSDP_SIGNATUR oder nicht acpi_pruefsumme(rsdp, 20):
            gib_zurück 0
        wenn u64(speicher_lesen(rsdp + 15, 1)) >= 2 und u64(speicher_lesen(rsdp + 20, 4)) >= 36 und acpi_pruefsumme(rsdp, u64(speicher_lesen(rsdp + 20, 4))):
            setze wurzel auf speicher_lesen(rsdp + 24, 8)
            setze schritt auf 8
        sonst:
            setze wurzel auf u64(speicher_lesen(rsdp + 16, 4))
            setze schritt auf 4
        wenn wurzel == 0:
            gib_zurück 0
        setze laenge auf u64(speicher_lesen(wurzel + 4, 4))
        wenn laenge < 36 oder nicht acpi_pruefsumme(wurzel, laenge):
            gib_zurück 0
        setze anzahl auf (laenge - 36) / schritt
        solange i < anzahl:
            wenn schritt == 8:
                setze tabelle auf speicher_lesen(wurzel + 36 + i * 8, 8)
            sonst:
                setze tabelle auf u64(speicher_lesen(wurzel + 36 + i * 4, 4))
            wenn tabelle != 0 und speicher_lesen(tabelle, 4) == signatur:
                setze laenge auf u64(speicher_lesen(tabelle + 4, 4))
                wenn laenge >= 36 und acpi_pruefsumme(tabelle, laenge):
                    gib_zurück tabelle
            setze i auf i + 1
        gib_zurück 0

@nativ
funktion madt_auswerten(madt: u64) -> void:
    unsicher:
        setze laenge: u64 auf u64(speicher_lesen(madt + 4, 4))
        setze pos: u64 auf 44
        setze typ: u64 auf 0
        setze eintrag_laenge: u64 auf 0
        setze gsi: u64 auf 1
        setze flags: u64 auf 0
        hw_setze(3, u64(speicher_lesen(madt + 36, 4)))
        hw_setze(6, 0)
        hw_setze(7, 0)
        hw_setze(8, 1)
        hw_setze(9, 0)
        solange pos + 2 <= laenge:
            setze typ auf u64(speicher_lesen(madt + pos, 1))
            setze eintrag_laenge auf u64(speicher_lesen(madt + pos + 1, 1))
            wenn eintrag_laenge < 2 oder pos + eintrag_laenge > laenge:
                gib_zurück
            wenn typ == 1 und eintrag_laenge >= 12 und hw(6) == 0:
                hw_setze(6, u64(speicher_lesen(madt + pos + 4, 4)))
                hw_setze(7, u64(speicher_lesen(madt + pos + 8, 4)))
            sonst wenn typ == 2 und eintrag_laenge >= 10 und speicher_lesen(madt + pos + 3, 1) == 1:
                setze gsi auf u64(speicher_lesen(madt + pos + 4, 4))
                setze flags auf u64(speicher_lesen(madt + pos + 8, 2))
                hw_setze(8, gsi)
                hw_setze(9, flags)
            sonst wenn typ == 5 und eintrag_laenge >= 12:
                hw_setze(3, speicher_lesen(madt + pos + 4, 8))
            setze pos auf pos + eintrag_laenge

@nativ
funktion acpi_starten(rsdp: u64) -> u64:
    unsicher:
        setze fadt: u64 auf acpi_tabelle(rsdp, 0x50434146)
        setze madt: u64 auf acpi_tabelle(rsdp, 0x43495041)
        setze port: u64 auf 0
        setze gas: u64 auf 0
        setze laenge: u64 auf 0
        setze ergebnis: u64 auf 0
        wenn fadt != 0:
            setze laenge auf u64(speicher_lesen(fadt + 4, 4))
            wenn laenge >= 80:
                setze port auf u64(speicher_lesen(fadt + 76, 4))
            # ACPI 2+: X_PM_TMR_BLK ist ein GAS bei Offset 208. Nur System-I/O
            # ist hier zulaessig; Memory-GAS wird nicht als Port missdeutet.
            wenn laenge >= 220:
                setze gas auf fadt + 208
                wenn speicher_lesen(gas, 1) == 1 und speicher_lesen(gas + 2, 1) == 0 und speicher_lesen(gas + 4, 8) <= 0xFFFF und speicher_lesen(gas + 4, 8) != 0:
                    setze port auf speicher_lesen(gas + 4, 8)
            wenn port != 0 und port <= 0xFFFF:
                hw_setze(0, port)
                wenn laenge >= 116 und (u64(speicher_lesen(fadt + 112, 4)) & 0x100) != 0:
                    hw_setze(1, 0xFFFFFFFF)
                sonst:
                    hw_setze(1, 0xFFFFFF)
                setze ergebnis auf ergebnis | 1
        wenn madt != 0:
            hw_setze(2, madt)
            madt_auswerten(madt)
            setze ergebnis auf ergebnis | 2
        gib_zurück ergebnis

@nativ
funktion apic_lesen(register: u64) -> u64:
    unsicher:
        wenn hw(4) != 0:
            gib_zurück msr_lesen(u32(0x800 + register / 16))
        setze p: ptr[u32] auf zeiger(hw(3) + register)
        gib_zurück u64(volatile_lesen(p))

@nativ
funktion apic_schreiben(register: u64, wert: u64) -> void:
    unsicher:
        wenn hw(4) != 0:
            msr_schreiben(u32(0x800 + register / 16), wert)
            gib_zurück
        setze p: ptr[u32] auf zeiger(hw(3) + register)
        volatile_schreiben(p, u32(wert))

@nativ
funktion apic_starten() -> bool:
    unsicher:
        setze basis_msr: u64 auf 0
        setze svr: u64 auf 0
        wenn hw(2) == 0:
            gib_zurück falsch
        setze basis_msr auf msr_lesen(0x1B)
        wenn (basis_msr & 0x800) == 0:
            gib_zurück falsch
        hw_setze(4, u64((basis_msr & 0x400) != 0))
        wenn hw(3) == 0:
            hw_setze(3, basis_msr & 0x000FFFFFFFFFF000)
        wenn hw(4) != 0:
            hw_setze(5, apic_lesen(0x20) & 0xFFFFFFFF)
        sonst:
            hw_setze(5, (apic_lesen(0x20) >> 24) & 0xFF)
        setze svr auf apic_lesen(0xF0)
        apic_schreiben(0xF0, svr | 0x1FF)
        gib_zurück wahr

@nativ
funktion apic_eoi() -> void:
    unsicher:
        apic_schreiben(0xB0, 0)

@nativ
@unterbrechung(64)
funktion timer_irq(rahmen: ptr[u64]) -> void:
    unsicher:
        hw_setze(10, hw(10) + 1)
        apic_eoi()

@nativ
@unterbrechung(65)
funktion tastatur_irq(rahmen: ptr[u64]) -> void:
    unsicher:
        wenn (ein8(0x64) & 1) != 0:
            setze scan: u8 auf ein8(0x60)
            wenn (scan & 0x80) == 0 und hw(11) == 0:
                hw_setze(11, u64(scan))
        apic_eoi()

@nativ
funktion pm_vergangen(start: u64) -> u64:
    unsicher:
        gib_zurück (u64(ein32(u16(hw(0)))) - start) & hw(1)

@nativ
funktion timer_starten(tsc_pro_us: u64) -> u64:
    unsicher:
        setze start: u64 auf 0
        setze ziel: u64 auf 0
        setze schleifen: u64 auf 0
        setze aktuell: u64 auf 0
        setze takte: u64 auf 0
        wenn nicht apic_starten():
            gib_zurück 0
        idt_tor(64, adresse_von(timer_irq), 0)
        hw_setze(10, 0)
        apic_schreiben(0x3E0, 3)
        apic_schreiben(0x320, 0x10000 | 64)
        apic_schreiben(0x380, 0xFFFFFFFF)
        wenn hw(0) != 0:
            setze start auf u64(ein32(u16(hw(0))))
            solange pm_vergangen(start) < 35795 und schleifen < 100000000:
                setze schleifen auf schleifen + 1
            wenn schleifen >= 100000000:
                gib_zurück 0
            hw_setze(15, 1)
        sonst wenn tsc_pro_us != 0:
            setze start auf takt()
            setze ziel auf tsc_pro_us * 10000
            solange takt() - start < ziel und schleifen < 100000000:
                setze schleifen auf schleifen + 1
            wenn schleifen >= 100000000:
                gib_zurück 0
            # Auf dem N100 ist invariant TSC belegt; dieser Pfad nutzt nur die
            # zuvor per PIT gemessene TSC, wenn FADT keinen PM-Port liefert.
            hw_setze(15, 2)
        sonst:
            gib_zurück 0
        setze aktuell auf apic_lesen(0x390)
        setze takte auf 0xFFFFFFFF - aktuell
        wenn takte == 0:
            gib_zurück 0
        apic_schreiben(0x3E0, 3)
        apic_schreiben(0x320, 0x20000 | 64)
        apic_schreiben(0x380, takte)
        gib_zurück takte

@nativ
funktion ioapic_schreiben(register: u64, wert: u32) -> void:
    unsicher:
        setze auswahl: ptr[u32] auf zeiger(hw(6))
        setze daten: ptr[u32] auf zeiger(hw(6) + 0x10)
        volatile_schreiben(auswahl, u32(register))
        volatile_schreiben(daten, wert)

@nativ
funktion ioapic_lesen(register: u64) -> u32:
    unsicher:
        setze auswahl: ptr[u32] auf zeiger(hw(6))
        setze daten: ptr[u32] auf zeiger(hw(6) + 0x10)
        volatile_schreiben(auswahl, u32(register))
        gib_zurück volatile_lesen(daten)

@nativ
funktion ioapic_route(gsi: u64, vektor: u64, flags: u64) -> bool:
    unsicher:
        setze index: u64 auf 0
        setze maximal: u64 auf 0
        setze niedrig: u64 auf vektor
        wenn hw(6) == 0 oder gsi < hw(7) oder hw(5) > 255:
            gib_zurück falsch
        setze index auf gsi - hw(7)
        setze maximal auf (u64(ioapic_lesen(1)) >> 16) & 0xFF
        wenn index > maximal:
            gib_zurück falsch
        wenn (flags & 3) == 3:
            setze niedrig auf niedrig | 0x2000
        wenn ((flags >> 2) & 3) == 3:
            setze niedrig auf niedrig | 0x8000
        ioapic_schreiben(0x10 + index * 2 + 1, u32((hw(5) & 0xFF) << 24))
        ioapic_schreiben(0x10 + index * 2, u32(niedrig))
        gib_zurück wahr

@nativ
funktion i8042_eingang_frei() -> bool:
    unsicher:
        setze i: u64 auf 0
        solange i < 100000:
            wenn (ein8(0x64) & 2) == 0:
                gib_zurück wahr
            setze i auf i + 1
        gib_zurück falsch

@nativ
funktion i8042_ausgang_voll() -> bool:
    unsicher:
        setze i: u64 auf 0
        solange i < 100000:
            wenn (ein8(0x64) & 1) != 0:
                gib_zurück wahr
            setze i auf i + 1
        gib_zurück falsch

@nativ
funktion i8042_befehl(wert: u8) -> bool:
    unsicher:
        wenn nicht i8042_eingang_frei():
            gib_zurück falsch
        aus8(0x64, wert)
        gib_zurück wahr

@nativ
funktion i8042_daten(wert: u8) -> bool:
    unsicher:
        wenn nicht i8042_eingang_frei():
            gib_zurück falsch
        aus8(0x60, wert)
        gib_zurück wahr

@nativ
funktion ps2_starten() -> bool:
    unsicher:
        setze i: u64 auf 0
        setze konfiguration: u8 auf 0
        wenn hw(6) == 0:
            gib_zurück falsch
        wenn nicht i8042_befehl(0xAD) oder nicht i8042_befehl(0xA7):
            gib_zurück falsch
        solange (ein8(0x64) & 1) != 0 und i < 32:
            ein8(0x60)
            setze i auf i + 1
        wenn nicht i8042_befehl(0x20) oder nicht i8042_ausgang_voll():
            gib_zurück falsch
        setze konfiguration auf ein8(0x60)
        setze konfiguration auf (konfiguration | 1) & 0xEF
        wenn nicht i8042_befehl(0x60) oder not i8042_daten(konfiguration):
            gib_zurück falsch
        wenn nicht i8042_befehl(0xAE):
            gib_zurück falsch
        wenn nicht i8042_daten(0xF4) oder not i8042_ausgang_voll() oder ein8(0x60) != 0xFA:
            gib_zurück falsch
        idt_tor(65, adresse_von(tastatur_irq), 0)
        hw_setze(11, 0)
        gib_zurück ioapic_route(hw(8), 65, hw(9))

@nativ
funktion unterbrechungen_an() -> void:
    unsicher:
        assembler(ziel="x86_64", code="sti", clobber=["memory"])

@nativ
funktion unterbrechungen_aus() -> void:
    unsicher:
        assembler(ziel="x86_64", code="cli", clobber=["memory"])

@nativ
funktion bis_unterbrechung_warten() -> void:
    unsicher:
        assembler(ziel="x86_64", code="hlt", clobber=["memory"])

# ---------------- Paging ----------------
@nativ
funktion cr3_laden(wert: u64) -> void:
    unsicher:
        assembler(ziel="x86_64", code="movq $0, %cr3", eingaenge={"r": wert}, clobber=["memory"])

# Virtuelle Kernadresse -> physisch (der Kern liegt zusammenhaengend).
@nativ
funktion physisch(bi: u64, v: u64) -> u64:
    unsicher:
        gib_zurück v - speicher_lesen(bi + versatz_von(MooBootInfo, kern_virtuell), 8) + speicher_lesen(bi + versatz_von(MooBootInfo, kern_basis), 8)

# Eigene 4-Level-Tabellen: Identitaet 0..max (2 MiB), FB-Fenster, Kern oben.
# Ergebnis: neues CR3 oder 0 (dann bleiben die Tabellen des Loaders aktiv).
@nativ
funktion paging_einrichten(bi: u64, max_phys: u64, fb: u64, fb_groesse: u64) -> u64:
    unsicher:
        setze gib: u64 auf (max_phys + 0x3FFFFFFF) / 0x40000000
        setze kb: u64 auf speicher_lesen(bi + versatz_von(MooBootInfo, kern_basis), 8)
        setze seiten: u64 auf (speicher_lesen(bi + versatz_von(MooBootInfo, kern_ende), 8) - kb) / 4096
        setze pml4: u64 auf adresse_von(PML4)
        setze pdpt: u64 auf adresse_von(PDPT_IDENT)
        setze pd: u64 auf adresse_von(PD_IDENT)
        setze pdfb: u64 auf adresse_von(PD_FB)
        setze pdptk: u64 auf adresse_von(PDPT_KERN)
        setze pdk: u64 auf adresse_von(PD_KERN)
        setze ptk: u64 auf adresse_von(PT_KERN)
        setze i: u64 auf 0
        setze fbg: u64 auf fb / 0x40000000
        setze fbe: u64 auf (fb + fb_groesse + 0x3FFFFFFF) / 0x40000000
        wenn gib < 4:
            setze gib auf 4
        wenn gib > 64 oder seiten > 16384 oder seiten == 0:
            gib_zurück 0
        # Framebuffer oberhalb des Identitaetsbereichs: hoechstens 2 GiB-Fenster.
        wenn fb != 0 und fbe > gib und (fbe - fbg > 2 oder fbe > 512):
            gib_zurück 0
        solange i < gib * 512:
            speicher_schreiben(pd + i * 8, (i * 0x200000) | 0x83, 8)
            setze i auf i + 1
        setze i auf 0
        solange i < gib:
            speicher_schreiben(pdpt + i * 8, physisch(bi, pd + i * 4096) | 3, 8)
            setze i auf i + 1
        wenn fb != 0 und fbe > gib:
            setze i auf 0
            solange i < (fbe - fbg) * 512:
                speicher_schreiben(pdfb + i * 8, ((fbg * 0x40000000) + i * 0x200000) | 0x83, 8)
                setze i auf i + 1
            setze i auf 0
            solange i < fbe - fbg:
                speicher_schreiben(pdpt + (fbg + i) * 8, physisch(bi, pdfb + i * 4096) | 3, 8)
                setze i auf i + 1
        speicher_schreiben(pml4, physisch(bi, pdpt) | 3, 8)
        # Kern: PML4[511] -> PDPT[510] -> PD[k] -> PT_k (wie der Loader, aber eigene Tabellen).
        setze i auf 0
        solange i < seiten:
            speicher_schreiben(ptk + i * 8, (kb + i * 4096) | 3, 8)
            setze i auf i + 1
        setze i auf 0
        solange i < (seiten + 511) / 512:
            speicher_schreiben(pdk + i * 8, physisch(bi, ptk + i * 4096) | 3, 8)
            setze i auf i + 1
        speicher_schreiben(pdptk + 510 * 8, physisch(bi, pdk) | 3, 8)
        speicher_schreiben(pml4 + 511 * 8, physisch(bi, pdptk) | 3, 8)
        cr3_laden(physisch(bi, pml4))
        gib_zurück physisch(bi, pml4)

# Separates UC-MMIO-Fenster im vorhandenen oberen Kern-Adressraum.
# PDPT[509] liegt unterhalb des Kernfensters [510]; keine Identitaetsannahme
# fuer 64-Bit-PCI-BARs. Jeder Aufruf belegt neue Eintraege, laufende NIC/USB
# behalten ihre bisherigen Abbildungen.
@nativ
@ausrichten(4096)
statisch PD_MMIO: [u64; 512] auf 0
@nativ
statisch MMIO_NAECHSTE: [u64; 1] auf 0

@nativ
funktion kern_mmio_abbilden(bi: u64, basis: u64, bytes: u64) -> u64:
    unsicher:
        setze offset: u64 auf basis & 0x1FFFFF
        setze seiten: u64 auf (offset + bytes + 0x1FFFFF) / 0x200000
        setze pd: u64 auf adresse_von(PD_MMIO)
        setze i: u64 auf 0
        setze naechste: u64 auf speicher_lesen(adresse_von(MMIO_NAECHSTE), 8)
        wenn bytes == 0 oder bytes > 0x10000000 oder basis >= 0x1000000000000 oder naechste + seiten > 512:
            gib_zurück 0
        solange i < seiten:
            # Jede BAR behaelt ihr UC-Fenster; Netz und USB laufen gleichzeitig.
            speicher_schreiben(pd + (naechste + i) * 8, ((basis & 0xFFFFFFFFFFE00000) + i * 0x200000) | 0x9B, 8)
            setze i auf i + 1
        speicher_schreiben(adresse_von(MMIO_NAECHSTE), naechste + seiten, 8)
        speicher_schreiben(adresse_von(PDPT_KERN) + 509 * 8, physisch(bi, pd) | 3, 8)
        cr3_laden(physisch(bi, adresse_von(PML4)))
        gib_zurück 0xFFFFFFFF40000000 + naechste * 0x200000 + offset

# ---------------- Page-Frame-Allocator und Kernel-Heap ----------------
@nativ
funktion pfa_wert(index: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(PFA_ZUSTAND) + index * 8, 8)

@nativ
funktion pfa_setze(index: u64, wert: u64) -> void:
    unsicher:
        speicher_schreiben(adresse_von(PFA_ZUSTAND) + index * 8, wert, 8)

@nativ
funktion pfa_rahmen_frei(rahmen: u64) -> bool:
    unsicher:
        wenn rahmen >= pfa_wert(0):
            gib_zurück falsch
        setze byte: u8 auf speicher_lesen(adresse_von(PFA_BITS) + rahmen / 8, 1)
        gib_zurück (byte & u8(1 << (rahmen & 7))) != 0

@nativ
funktion pfa_markiere(rahmen: u64, frei_machen: bool) -> void:
    unsicher:
        wenn rahmen >= pfa_wert(0):
            gib_zurück
        setze adr: u64 auf adresse_von(PFA_BITS) + rahmen / 8
        setze maske: u8 auf u8(1 << (rahmen & 7))
        setze alt: u8 auf speicher_lesen(adr, 1)
        wenn frei_machen und (alt & maske) == 0:
            speicher_schreiben(adr, alt | maske, 1)
            pfa_setze(1, pfa_wert(1) + 1)
        sonst wenn nicht frei_machen und (alt & maske) != 0:
            speicher_schreiben(adr, alt & u8(255 - u64(maske)), 1)
            pfa_setze(1, pfa_wert(1) - 1)

@nativ
funktion pfa_bereich(basis: u64, seiten: u64, frei_machen: bool) -> void:
    unsicher:
        setze i: u64 auf 0
        setze rahmen: u64 auf basis / 4096
        solange i < seiten und rahmen + i < pfa_wert(0):
            pfa_markiere(rahmen + i, frei_machen)
            setze i auf i + 1

@nativ
funktion pfa_reserviere(basis: u64, bytes: u64) -> void:
    unsicher:
        wenn bytes == 0:
            gib_zurück
        setze erster: u64 auf basis / 4096
        setze ende: u64 auf (basis + bytes + 4095) / 4096
        wenn ende > erster:
            pfa_bereich(erster * 4096, ende - erster, falsch)

@nativ
funktion pfa_starten(bi: u64, max_phys: u64) -> u64:
    unsicher:
        setze max_rahmen: u64 auf (max_phys + 4095) / 4096
        setze karte: u64 auf speicher_lesen(bi + versatz_von(MooBootInfo, karte), 8)
        setze schritt: u64 auf speicher_lesen(bi + versatz_von(MooBootInfo, deskriptor_groesse), 8)
        setze anzahl: u64 auf 0
        setze i: u64 auf 0
        setze d: u64 auf 0
        wenn max_rahmen > 16777216:
            setze max_rahmen auf 16777216
        pfa_setze(0, max_rahmen)
        pfa_setze(1, 0)
        pfa_setze(2, 256)
        wenn schritt >= groesse_von(EfiSpeicherDeskriptor):
            setze anzahl auf speicher_lesen(bi + versatz_von(MooBootInfo, karte_groesse), 8) / schritt
        # Vor dem eigenen CR3 nur ConventionalMemory (Typ 7). Loader- und
        # BootServices-Seiten bleiben bis zum Paging-Wechsel unangetastet.
        solange i < anzahl:
            setze d auf karte + i * schritt
            wenn speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_typ), 4) == 7:
                pfa_bereich(speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_physisch), 8), speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_seiten), 8), wahr)
            setze i auf i + 1
        pfa_reserviere(0, 0x100000)
        pfa_reserviere(speicher_lesen(bi + versatz_von(MooBootInfo, kern_basis), 8), speicher_lesen(bi + versatz_von(MooBootInfo, kern_ende), 8) - speicher_lesen(bi + versatz_von(MooBootInfo, kern_basis), 8))
        gib_zurück pfa_wert(1)

@nativ
funktion pfa_nehme(anzahl: u64) -> u64:
    unsicher:
        setze i: u64 auf 256
        setze lauf: u64 auf 0
        setze anfang: u64 auf 0
        setze j: u64 auf 0
        wenn anzahl == 0:
            gib_zurück 0
        solange i < pfa_wert(0):
            wenn pfa_rahmen_frei(i):
                wenn lauf == 0:
                    setze anfang auf i
                setze lauf auf lauf + 1
                wenn lauf == anzahl:
                    setze j auf 0
                    solange j < anzahl:
                        pfa_markiere(anfang + j, falsch)
                        setze j auf j + 1
                    pfa_setze(2, anfang + anzahl)
                    gib_zurück anfang * 4096
            sonst:
                setze lauf auf 0
            setze i auf i + 1
        gib_zurück 0

@nativ
funktion pfa_bootspeicher_freigeben(bi: u64) -> u64:
    unsicher:
        setze karte: u64 auf speicher_lesen(bi + versatz_von(MooBootInfo, karte), 8)
        setze schritt: u64 auf speicher_lesen(bi + versatz_von(MooBootInfo, deskriptor_groesse), 8)
        setze anzahl: u64 auf 0
        setze i: u64 auf 0
        setze d: u64 auf 0
        setze typ: u64 auf 0
        setze tabellen: u64 auf speicher_lesen(bi + versatz_von(MooBootInfo, seitentabelle), 8)
        setze tabellen_seiten: u64 auf speicher_lesen(bi + versatz_von(MooBootInfo, seitentabelle_seiten), 8)
        setze firmware: u64 auf speicher_lesen(bi + versatz_von(MooBootInfo, firmware_seitentabelle), 8)
        setze bestaetigt: u64 auf 0
        wenn schritt >= groesse_von(EfiSpeicherDeskriptor):
            setze anzahl auf speicher_lesen(bi + versatz_von(MooBootInfo, karte_groesse), 8) / schritt
        # Nach dem eigenen CR3 sind LoaderCode/Data und BootServicesCode/Data frei.
        # Darin liegen sowohl der Loader-Tabellenblock als auch die Firmware-Tabellen.
        solange i < anzahl:
            setze d auf karte + i * schritt
            setze typ auf u64(speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_typ), 4))
            wenn typ >= 1 und typ <= 4:
                pfa_bereich(speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_physisch), 8), speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_seiten), 8), wahr)
            setze i auf i + 1
        # Noch lebende Loaderdaten und der Kern selbst bleiben reserviert.
        pfa_reserviere(0, 0x100000)
        pfa_reserviere(speicher_lesen(bi + versatz_von(MooBootInfo, kern_basis), 8), speicher_lesen(bi + versatz_von(MooBootInfo, kern_ende), 8) - speicher_lesen(bi + versatz_von(MooBootInfo, kern_basis), 8))
        pfa_reserviere(bi, groesse_von(MooBootInfo))
        pfa_reserviere(karte, speicher_lesen(bi + versatz_von(MooBootInfo, karte_groesse), 8))
        pfa_reserviere(speicher_lesen(bi + versatz_von(MooBootInfo, arbeit), 8), speicher_lesen(bi + versatz_von(MooBootInfo, arbeit_groesse), 8))
        pfa_reserviere(speicher_lesen(adresse_von(HEAP_ZUSTAND), 8), speicher_lesen(adresse_von(HEAP_ZUSTAND) + 8, 8))
        # Exakte Loader-Seiten plus Firmware-PML4 muessen nun im PFA frei sein.
        setze i auf 0
        solange i < tabellen_seiten:
            wenn pfa_rahmen_frei(tabellen / 4096 + i):
                setze bestaetigt auf bestaetigt + 1
            setze i auf i + 1
        wenn firmware != 0 und pfa_rahmen_frei(firmware / 4096):
            setze bestaetigt auf bestaetigt + 1
        gib_zurück bestaetigt

@nativ
funktion heap_starten() -> bool:
    unsicher:
        setze seiten: u64 auf 256
        setze basis: u64 auf pfa_nehme(seiten)
        wenn basis == 0:
            gib_zurück falsch
        speicher_schreiben(adresse_von(HEAP_ZUSTAND), basis, 8)
        speicher_schreiben(adresse_von(HEAP_ZUSTAND) + 8, seiten * 4096, 8)
        speicher_schreiben(basis, seiten * 4096 - 32, 8)
        speicher_schreiben(basis + 8, 0, 8)
        speicher_schreiben(basis + 16, 1, 8)
        speicher_schreiben(basis + 24, 0x4D4F4F4845415031, 8)
        gib_zurück wahr

@nativ
funktion heap_nimm(bytes: u64) -> u64:
    unsicher:
        setze benoetigt: u64 auf (bytes + 15) & 0xFFFFFFFFFFFFFFF0
        setze block: u64 auf speicher_lesen(adresse_von(HEAP_ZUSTAND), 8)
        setze neuer_block: u64 auf 0
        setze groesse: u64 auf 0
        wenn benoetigt == 0:
            setze benoetigt auf 16
        solange block != 0:
            setze groesse auf speicher_lesen(block, 8)
            wenn speicher_lesen(block + 24, 8) != 0x4D4F4F4845415031:
                gib_zurück 0
            wenn speicher_lesen(block + 16, 8) != 0 und groesse >= benoetigt:
                wenn groesse >= benoetigt + 48:
                    setze neuer_block auf block + 32 + benoetigt
                    speicher_schreiben(neuer_block, groesse - benoetigt - 32, 8)
                    speicher_schreiben(neuer_block + 8, speicher_lesen(block + 8, 8), 8)
                    speicher_schreiben(neuer_block + 16, 1, 8)
                    speicher_schreiben(neuer_block + 24, 0x4D4F4F4845415031, 8)
                    speicher_schreiben(block, benoetigt, 8)
                    speicher_schreiben(block + 8, neuer_block, 8)
                speicher_schreiben(block + 16, 0, 8)
                gib_zurück block + 32
            setze block auf speicher_lesen(block + 8, 8)
        gib_zurück 0

@nativ
funktion heap_gib(adr: u64) -> void:
    unsicher:
        wenn adr < 32:
            gib_zurück
        setze block: u64 auf adr - 32
        setze naechster: u64 auf speicher_lesen(block + 8, 8)
        wenn speicher_lesen(block + 24, 8) != 0x4D4F4F4845415031:
            gib_zurück
        speicher_schreiben(block + 16, 1, 8)
        wenn naechster != 0 und speicher_lesen(naechster + 16, 8) != 0 und speicher_lesen(naechster + 24, 8) == 0x4D4F4F4845415031:
            speicher_schreiben(block, speicher_lesen(block, 8) + 32 + speicher_lesen(naechster, 8), 8)
            speicher_schreiben(block + 8, speicher_lesen(naechster + 8, 8), 8)

@nativ
funktion heap_pruefen() -> bool:
    unsicher:
        setze a: u64 auf heap_nimm(64)
        setze b: u64 auf heap_nimm(128)
        wenn a == 0 oder b == 0:
            gib_zurück falsch
        speicher_schreiben(a, 0x1122334455667788, 8)
        speicher_schreiben(b, 0x8877665544332211, 8)
        wenn speicher_lesen(a, 8) != 0x1122334455667788 oder speicher_lesen(b, 8) != 0x8877665544332211:
            gib_zurück falsch
        heap_gib(b)
        heap_gib(a)
        gib_zurück wahr

# ---------------- Alter Weg (nur Messung): direkt in den Framebuffer ----------------
@nativ
funktion pixel(format: u64, r: u32, g: u32, b: u32) -> u32:
    unsicher:
        wenn format == 1:
            gib_zurück b | (g << 8) | (r << 16)
        gib_zurück r | (g << 8) | (b << 16)

@nativ
funktion fuellen(fb: u64, breite: u64, hoehe: u64, stride: u64, wert: u32) -> void:
    unsicher:
        setze y: u64 auf 0
        setze x: u64 auf 0
        setze zeile: u64 auf 0
        solange y < hoehe:
            setze zeile auf fb + y * stride * 4
            setze x auf 0
            solange x < breite:
                speicher_schreiben(zeile + x * 4, wert, 4)
                setze x auf x + 1
            setze y auf y + 1

# RGBA im Rueckpuffer.
@nativ
funktion rgba(r: u64, g: u64, b: u64) -> u32:
    unsicher:
        gib_zurück u32(r | (g << 8) | (b << 16) | 0xFF000000)

@nativ
konstante T_USB_TASTE: [u8; _] auf "MOO-KERNEL USB TASTE "
@nativ
konstante T_USB_HID: [u8; _] auf "MOO-KERNEL USB HID "
@nativ
konstante T_USB_TASTE_BDF: [u8; _] auf "MOO-KERNEL USB TASTE BDF "
@nativ
konstante T_USB_TASTE_PORT: [u8; _] auf "MOO-KERNEL USB TASTE PORT "
@nativ
konstante T_USB_TASTE_SLOT: [u8; _] auf "MOO-KERNEL USB TASTE SLOT "
@nativ
statisch USB_TASTEN: [u64; 1] auf 0
@nativ
statisch USB_CAPS: [u64; 1] auf 0

# Zustand gehaltener Tasten pro HID-Slot, CapsLock fuer die gemeinsame Konsole.
@nativ
@aufrufkonvention("sysv64")
funktion usb_report_verarbeiten(report: u64, zuletzt: u64, port: u64, slot: u64) -> void:
    unsicher:
        setze vorher: u64 auf speicher_lesen(zuletzt, 8)
        setze i: u64 auf 2
        setze gueltig: bool auf (report & 0xFF00) == 0
        solange i < 8:
            setze taste: u64 auf (report >> (i * 8)) & 255
            wenn taste >= 1 und taste <= 3:
                setze gueltig auf falsch
            setze i auf i + 1
        wenn nicht gueltig:
            gib_zurück
        setze i auf 2
        solange i < 8:
            setze usage: u64 auf xh_neue_taste(report, vorher, i)
            wenn usage != 0:
                meldung(adresse_von(T_USB_TASTE_BDF), xh(29))
                meldung(adresse_von(T_USB_TASTE_PORT), port)
                meldung(adresse_von(T_USB_TASTE_SLOT), slot)
                meldung(adresse_von(T_USB_HID), usage)
                speicher_schreiben(adresse_von(USB_TASTEN), speicher_lesen(adresse_von(USB_TASTEN), 8) + 1, 8)
                wenn usage == 57:
                    speicher_schreiben(adresse_von(USB_CAPS), speicher_lesen(adresse_von(USB_CAPS), 8) ^ 1, 8)
                setze c: u8 auf xh_ascii(usage, report & 255, speicher_lesen(adresse_von(USB_CAPS), 8) != 0)
                wenn c != 0:
                    meldung(adresse_von(T_USB_TASTE), u64(c))
                    zeichen(c)
                    zeichen(10)
                    eingabe_taste(c)
            setze i auf i + 1
        speicher_schreiben(zuletzt, report, 8)

# LAPIC-Ticks wecken den Polling-Loop. xHCI-Interrupts bleiben aus.
@nativ
funktion usb_poll() -> void:
    unsicher:
        usb_poll_berichte(adresse_von(usb_report_verarbeiten))

@nativ
@aufrufkonvention("sysv64")
funktion usb_dma_nehmen(seiten: u64) -> u64:
    unsicher:
        gib_zurück pfa_nehme(seiten)

# ---------------- Netz-Log nach ExitBootServices ----------------
# Fruehe Bootzeilen bleiben bis zur PFA/Paging/PCI-Initialisierung erhalten.
# Drahtformat: derselbe Ethernet/IPv4/UDP-Broadcast wie hallo_uefi (Port 7777).
@nativ
statisch NETZ_PORTS: [u64; 8] auf 0
@nativ
statisch NETZ_PCI: [u64; 4] auf 0
# Anzahl NICs, aktiv, FIFO-Kopf, Zeilenlaenge, FIFO-Verluste, Sende-Sperre,
# FIFO-Ende, belegte FIFO-Bytes, bereits belieferte Ports des aktuellen Rahmens.
@nativ
statisch NETZ: [u64; 9] auf 0
@nativ
statisch NETZ_FRUEH: [u8; 32768] auf 0
@nativ
statisch NETZ_ZEILE: [u8; 1472] auf 0
@nativ
statisch NETZ_PAKET: [u8; 1514] auf 0
@nativ
statisch NETZ_EMPFANG: [u8; 2048] auf 0
# IPv4 fuer private Laufprofile. Drittes Feld schaltet QEMU igb frei.
@nativ
statisch NETZ_IPV4_KONFIG: [u64; 3] auf [0x00345650494F4F4D, 0, 0]
# "MOOL4CFG" als eigener Vertrag. Alte IPv4-Profile bleiben verwendbar.
@nativ
statisch NETZ_TRANSPORT_KONFIG: [u64; 2] auf [0x474643344C4F4F4D, 0]
# "MOOECHO": kleiner TCP-Testdienst nur in ausdruecklichen Laufprofilen.
@nativ
statisch NETZ_ECHO_KONFIG: [u64; 2] auf [0x004F4843454F4F4D, 0]
# MOOSSH01 aktiviert ausschliesslich den initialen SSH-Transporttest.
@nativ
statisch NETZ_SSH_KONFIG: [u64; 2] auf [0x31304853534F4F4D, 0]
@nativ
konstante T_NETZ_ECHO: [u8; _] auf "MOO-KERNEL NETZ TCP ECHO BEREIT "
@nativ
konstante T_NETZ_TRANSPORT: [u8; _] auf "MOO-KERNEL NETZ UDP TCP BEREIT "
@nativ
konstante T_NETZ_IPV4: [u8; _] auf "MOO-KERNEL NETZ IPV4 BEREIT "
@nativ
konstante T_NETZ: [u8; _] auf "MOO-KERNEL NETZ PORTS "
@nativ
konstante T_NETZ_BDF: [u8; _] auf "MOO-KERNEL NETZ BDF "
@nativ
konstante T_NETZ_BAR: [u8; _] auf "MOO-KERNEL NETZ BAR "
@nativ
konstante T_NETZ_DMA: [u8; _] auf "MOO-KERNEL NETZ DMA "
@nativ
konstante T_NETZ_LINK: [u8; _] auf "MOO-KERNEL NETZ LINK "
@nativ
konstante T_NETZ_STOP_FEHLER: [u8; _] auf "MOO-KERNEL NETZ DMA-STOP FEHLER BDF "
@nativ
konstante T_NETZ_IGB: [u8; _] auf "MOO-KERNEL NETZ IGB INITIALISIERT "

# Der vorhandene Fruehpuffer ist eine Byte-FIFO aus [u16 Laenge, Nutzlast].
# Ring voll -> fuer spaeter behalten. Je Aufruf hoechstens16 Rahmen versuchen,
# kein Warten auf Hardware; ein Port darf andere Ports nicht doppelt beliefern.
@nativ
funktion netz_spuelen() -> void:
    unsicher:
        setze z: u64 auf adresse_von(NETZ)
        setze q: u64 auf adresse_von(NETZ_FRUEH)
        setze kopf: u64 auf speicher_lesen(z + 16, 8)
        setze benutzt: u64 auf speicher_lesen(z + 56, 8)
        setze ports: u64 auf speicher_lesen(z, 8)
        setze maske: u64 auf 0
        setze laenge: u64 auf 0
        setze nic: u64 auf 0
        setze i: u64 auf 0
        setze j: u64 auf 0
        setze runden: u64 auf 0
        wenn speicher_lesen(z + 8, 8) == 0 oder speicher_lesen(z + 40, 8) != 0:
            gib_zurück
        wenn ports == 0:
            speicher_schreiben(z + 16, speicher_lesen(z + 48, 8), 8)
            speicher_schreiben(z + 56, 0, 8)
            gib_zurück
        speicher_schreiben(z + 40, 1, 8)
        solange benutzt != 0 und runden < 16:
            setze laenge auf u64(speicher_lesen(q + kopf, 1)) | (u64(speicher_lesen(q + ((kopf + 1) & 32767), 1)) << 8)
            setze j auf 0
            solange j < laenge:
                speicher_schreiben(adresse_von(NETZ_PAKET) + 42 + j, speicher_lesen(q + ((kopf + 2 + j) & 32767), 1), 1)
                setze j auf j + 1
            setze maske auf speicher_lesen(z + 64, 8)
            setze i auf 0
            solange i < ports:
                wenn (maske & (u64(1) << i)) == 0:
                    setze nic auf speicher_lesen(adresse_von(NETZ_PORTS) + i * 8, 8)
                    wenn nicht nt_link(nic):
                        setze maske auf maske | (u64(1) << i)
                    sonst wenn nt_senden(nic, adresse_von(NETZ_PAKET), nt_udp_rahmen(adresse_von(NETZ_PAKET), nic, laenge)):
                        setze maske auf maske | (u64(1) << i)
                setze i auf i + 1
            speicher_schreiben(z + 64, maske, 8)
            wenn maske != (u64(1) << ports) - 1:
                stopp
            setze kopf auf (kopf + laenge + 2) & 32767
            setze benutzt auf benutzt - laenge - 2
            speicher_schreiben(z + 16, kopf, 8)
            speicher_schreiben(z + 56, benutzt, 8)
            speicher_schreiben(z + 64, 0, 8)
            setze runden auf runden + 1
        speicher_schreiben(z + 40, 0, 8)

@nativ
funktion netz_senden(laenge: u64) -> void:
    unsicher:
        setze z: u64 auf adresse_von(NETZ)
        setze q: u64 auf adresse_von(NETZ_FRUEH)
        setze ende: u64 auf speicher_lesen(z + 48, 8)
        setze j: u64 auf 0
        wenn speicher_lesen(z + 8, 8) != 0 und speicher_lesen(z, 8) == 0:
            gib_zurück
        netz_spuelen()
        wenn speicher_lesen(z + 56, 8) + laenge + 2 > 32768:
            speicher_schreiben(z + 32, speicher_lesen(z + 32, 8) + 1, 8)
            gib_zurück
        speicher_schreiben(q + ende, u8(laenge & 255), 1)
        speicher_schreiben(q + ((ende + 1) & 32767), u8(laenge >> 8), 1)
        solange j < laenge:
            speicher_schreiben(q + ((ende + 2 + j) & 32767), speicher_lesen(adresse_von(NETZ_ZEILE) + j, 1), 1)
            setze j auf j + 1
        speicher_schreiben(z + 48, (ende + laenge + 2) & 32767, 8)
        speicher_schreiben(z + 56, speicher_lesen(z + 56, 8) + laenge + 2, 8)
        netz_spuelen()

@nativ
funktion netz_zeichen(z: u8) -> void:
    unsicher:
        setze zustand: u64 auf adresse_von(NETZ)
        setze n: u64 auf speicher_lesen(zustand + 24, 8)
        wenn z == 10:
            netz_senden(n)
            speicher_schreiben(zustand + 24, 0, 8)
            gib_zurück
        wenn z == 13:
            gib_zurück
        speicher_schreiben(adresse_von(NETZ_ZEILE) + n, z, 1)
        setze n auf n + 1
        wenn n == 1472:
            netz_senden(n)
            setze n auf 0
        speicher_schreiben(zustand + 24, n, 8)

@nativ
funktion netz_ipv4_adresse() -> u64:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(NETZ_IPV4_KONFIG) + 8, 8)

@nativ
funktion netz_transport_aktiv() -> bool:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(NETZ_TRANSPORT_KONFIG) + 8, 8) == 1

@nativ
funktion netz_echo_aktiv() -> bool:
    unsicher:
        gib_zurück speicher_lesen(adresse_von(NETZ_ECHO_KONFIG) + 8, 8) == 1

@nativ
funktion netz_poll(tsc_us: u64) -> void:
    unsicher:
        setze ip: u64 auf netz_ipv4_adresse()
        wenn ip == 0:
            gib_zurück
        setze dienste: bool auf netz_transport_aktiv()
        setze echo_aktiv: bool auf dienste und netz_echo_aktiv()
        setze ssh_aktiv: bool auf dienste und ssh_bereit()
        wenn dienste:
            netz_tcp_wartung(tsc_us)
        setze ports: u64 auf speicher_lesen(adresse_von(NETZ), 8)
        setze i: u64 auf 0
        solange i < ports:
            setze nic: u64 auf speicher_lesen(adresse_von(NETZ_PORTS) + i * 8, 8)
            wenn nt_link(nic):
                netz_ipv4_poll(nic, adresse_von(NETZ_EMPFANG), ip, dienste, echo_aktiv, ssh_aktiv)
            setze i auf i + 1

@nativ
funktion netz_starten(bi: u64, tsc_us: u64) -> u64:
    unsicher:
        setze pci: u64 auf adresse_von(NETZ_PCI)
        setze zustand: u64 auf adresse_von(NETZ)
        setze typ: u64 auf 2
        setze nummer: u64 auf 0
        setze bdf: i64 auf -1
        setze bar: u64 auf 0
        setze mmio: u64 auf 0
        setze dma: u64 auf 0
        setze n: u64 auf 0
        setze i: u64 auf 0
        setze j: u64 auf 0
        setze link: u64 auf 0
        setze start: u64 auf 0
        wenn speicher_lesen(adresse_von(NETZ_IPV4_KONFIG) + 16, 8) == 1:
            setze typ auf 3
        # Konfigurationsmechanismus 1: kein Firmware-ECAM-Zeiger nach EBS.
        speicher_schreiben(pci + 16, 255, 8)
        solange typ > 0:
            setze nummer auf 0
            setze bdf auf nt_finde(pci, typ, nummer)
            solange bdf >= 0 und n < 8:
                # Auch ein Initfehler darf keinen alten UEFI-DMA-Ring weiterbetreiben.
                pci_schreibe32(pci, u64(bdf), 4, pci_lese32(pci, u64(bdf), 4) & 0xFFFB)
                wenn (pci_lese32(pci, u64(bdf), 4) & 4) != 0:
                    meldung(adresse_von(T_NETZ_STOP_FEHLER), u64(bdf))
                    anhalten()
                setze bar auf nt_bar(pci, u64(bdf))
                setze mmio auf 0
                setze dma auf 0
                wenn bar != 0 und tsc_us != 0:
                    setze mmio auf kern_mmio_abbilden(bi, bar, 0x20000)
                    setze dma auf pfa_nehme(20)
                meldung(adresse_von(T_NETZ_BDF), u64(bdf))
                meldung(adresse_von(T_NETZ_BAR), bar)
                meldung(adresse_von(T_NETZ_DMA), dma)
                wenn bar != 0 und mmio != 0 und dma != 0:
                    setze j auf 0
                    solange j < 20 * 4096:
                        speicher_schreiben(dma + j, 0, 8)
                        setze j auf j + 8
                    wenn nt_oeffnen_in(pci, u64(bdf), dma, mmio, tsc_us):
                        speicher_schreiben(adresse_von(NETZ_PORTS) + n * 8, dma, 8)
                        setze n auf n + 1
                setze nummer auf nummer + 1
                setze bdf auf nt_finde(pci, typ, nummer)
            setze typ auf typ - 1
        speicher_schreiben(zustand, n, 8)
        wenn speicher_lesen(adresse_von(NETZ_IPV4_KONFIG) + 16, 8) == 1:
            meldung(adresse_von(T_NETZ_IGB), n)
        setze start auf takt()
        solange n != 0 und link == 0 und takt() - start < tsc_us * 3000000:
            setze i auf 0
            solange i < n:
                wenn nt_link(speicher_lesen(adresse_von(NETZ_PORTS) + i * 8, 8)):
                    setze link auf link + 1
                setze i auf i + 1
            assembler(ziel="x86_64", code="pause", clobber=[])
        speicher_schreiben(zustand + 8, 1, 8)
        netz_spuelen()
        meldung(adresse_von(T_NETZ_LINK), link)
        gib_zurück n

# Diese Zeile liegt zwischen Diagnosekonsole und Eingabefeld.
@nativ
konstante T_KONSOLEN_STATUS: [u8; _] auf "PFA FREI 0000000000000000   TIMER TICKS 0000000000000000"
@nativ
statisch KONSOLEN_STATUS: [u8; 56] auf 0

@nativ
funktion konsolen_status(pfa_frei: u64, ticks: u64) -> void:
    unsicher:
        wenn kon(versatz_von(Konsole, k_aktiv)) == 0:
            gib_zurück
        setze s: u64 auf adresse_von(SCHIRM)
        setze breite: u64 auf speicher_lesen(s + versatz_von(Schirm, s_breite), 8)
        setze links: u64 auf 52
        setze laenge: u64 auf 56
        wenn breite < 2 * links + 4 * laenge:
            gib_zurück
        setze skala: i32 auf 2
        wenn breite < 2 * links + 8 * laenge:
            setze skala auf 1
        setze kern: u64 auf speicher_lesen(s + versatz_von(Schirm, s_kern), 8)
        setze unten: u64 auf kon(versatz_von(Konsole, k_unten))
        setze zeile: u64 auf adresse_von(KONSOLEN_STATUS)
        setze i: u64 auf 0
        solange i < laenge:
            speicher_schreiben(zeile + i, speicher_lesen(adresse_von(T_KONSOLEN_STATUS) + i, 1), 1)
            setze i auf i + 1
        # Die 16-stelligen Hexwerte beginnen in der Vorlage bei Byte 9 und 40.
        setze i auf 0
        solange i < 16:
            speicher_schreiben(zeile + 9 + i, hex_ziffer(pfa_frei, i), 1)
            speicher_schreiben(zeile + 40 + i, hex_ziffer(ticks, i), 1)
            setze i auf i + 1
        moo_surface_core_rect(zeiger(kern), 40, i32(unten), i32(breite) - 80, 20, rgba(20, 55, 75))
        moo_surface_core_text_3x5(zeiger(kern), i32(links), i32(unten + 5), skala, zeiger(zeile), laenge, rgba(200, 230, 255))
        schirm_zeilen(unten, unten + 20)

# Fester Eingabebereich unterhalb der rollenden Diagnosekonsole.
@nativ
statisch EINGABE: [u8; 256] auf 0
@nativ
statisch EINGABE_N: [u64; 1] auf 0
@nativ
konstante T_EINGABE: [u8; _] auf "EINGABE"

@nativ
funktion eingabe_zeigen() -> void:
    unsicher:
        setze s: u64 auf adresse_von(SCHIRM)
        setze breite: u64 auf speicher_lesen(s + versatz_von(Schirm, s_breite), 8)
        setze boden: u64 auf speicher_lesen(s + versatz_von(Schirm, s_hoehe), 8) - 80
        setze kern: u64 auf speicher_lesen(s + versatz_von(Schirm, s_kern), 8)
        setze n: u64 auf speicher_lesen(adresse_von(EINGABE_N), 8)
        wenn kon(versatz_von(Konsole, k_aktiv)) == 0:
            gib_zurück
        moo_surface_core_rect(zeiger(kern), 40, i32(boden), i32(breite) - 80, 60, rgba(20, 55, 75))
        moo_surface_core_text_3x5(zeiger(kern), 52, i32(boden + 6), 2, zeiger(adresse_von(T_EINGABE)), 7, rgba(200, 230, 255))
        moo_surface_core_text_3x5(zeiger(kern), 52, i32(boden + 28), 3, zeiger(adresse_von(EINGABE)), n, rgba(255, 230, 160))
        moo_surface_core_rect(zeiger(kern), i32(52 + n * 12), i32(boden + 45), 8, 2, rgba(255, 196, 64))
        schirm_zeilen(boden, boden + 60)

@nativ
funktion eingabe_taste(c: u8) -> void:
    unsicher:
        setze breite: u64 auf speicher_lesen(adresse_von(SCHIRM) + versatz_von(Schirm, s_breite), 8)
        setze n: u64 auf speicher_lesen(adresse_von(EINGABE_N), 8)
        setze max: u64 auf 0
        setze i: u64 auf 1
        wenn kon(versatz_von(Konsole, k_aktiv)) == 0 oder breite < 160:
            gib_zurück
        setze max auf (breite - 116) / 12
        wenn max > 255:
            setze max auf 255
        wenn c == 8:
            wenn n > 0:
                setze n auf n - 1
        sonst wenn c >= 32 und c <= 126:
            wenn n == max:
                solange i < n:
                    speicher_schreiben(adresse_von(EINGABE) + i - 1, speicher_lesen(adresse_von(EINGABE) + i, 1), 1)
                    setze i auf i + 1
                setze n auf n - 1
            speicher_schreiben(adresse_von(EINGABE) + n, c, 1)
            setze n auf n + 1
        sonst:
            # Noch keine Kommandoausfuehrung: Enter laesst den Text sichtbar.
            gib_zurück
        speicher_schreiben(adresse_von(EINGABE_N), n, 8)
        eingabe_zeigen()

@nativ
konstante SAM_T_START: [u8; _] auf "MOO-KERNEL SAMMEL START "
@nativ
konstante SAM_T_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL ENDE "
@nativ
konstante SAM_T_PCI_START: [u8; _] auf "MOO-KERNEL SAMMEL PCI START "
@nativ
konstante SAM_T_PCI_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL PCI ENDE "
@nativ
konstante SAM_T_BDF: [u8; _] auf "MOO-KERNEL SAMMEL PCI BDF "
@nativ
konstante SAM_T_ID: [u8; _] auf "MOO-KERNEL SAMMEL PCI ID "
@nativ
konstante SAM_T_KLASSE: [u8; _] auf "MOO-KERNEL SAMMEL PCI KLASSE REV "
@nativ
konstante SAM_T_BAR0: [u8; _] auf "MOO-KERNEL SAMMEL PCI BAR0 ROH "
@nativ
konstante SAM_T_PCI_ZIEL: [u8; _] auf "MOO-KERNEL SAMMEL PCI NVME-KANDIDATEN "
@nativ
konstante SAM_T_I226_START: [u8; _] auf "MOO-KERNEL SAMMEL I226 START "
@nativ
konstante SAM_T_I226_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL I226 ENDE "
@nativ
konstante SAM_T_I226_PHY_START: [u8; _] auf "MOO-KERNEL SAMMEL I226 PHY START "
@nativ
konstante SAM_T_I226_PHY_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL I226 PHY ENDE "
@nativ
konstante SAM_T_USB_START: [u8; _] auf "MOO-KERNEL SAMMEL USB START "
@nativ
konstante SAM_T_USB_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL USB ENDE "
@nativ
konstante SAM_T_MSC_START: [u8; _] auf "MOO-KERNEL SAMMEL USB-MSC START "
@nativ
konstante SAM_T_MSC_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL USB-MSC ENDE "
@nativ
konstante SAM_T_NVME_START: [u8; _] auf "MOO-KERNEL SAMMEL NVME START "
@nativ
konstante SAM_T_NVME_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL NVME ENDE "
@nativ
konstante SAM_T_NVME_ZIEL: [u8; _] auf "MOO-KERNEL SAMMEL NVME ZIEL BDF "
@nativ
konstante SAM_T_NVME_PROFIL: [u8; _] auf "MOO-KERNEL SAMMEL NVME GPT-PROFIL "
@nativ
konstante SAM_T_HID_START: [u8; _] auf "MOO-KERNEL SAMMEL HID START "
@nativ
konstante SAM_T_HID_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL HID ENDE "

@nativ
@aufrufkonvention("sysv64")
funktion sammel_wartung(log: u64) -> void:
    unsicher:
        netz_spuelen()
        testlauf_poll(log)

# Krypto-Selbsttest, nur Statuswerte. Die Entropieprobe erhaelt keinen Logger.
@nativ
konstante SAM_K_START: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO START "
@nativ
konstante SAM_K_SHA256: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO SHA256 "
@nativ
konstante SAM_K_SHA512: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO SHA512 "
@nativ
konstante SAM_K_HMAC_SHA256: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO HMAC-SHA256 "
@nativ
konstante SAM_K_HMAC_SHA512: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO HMAC-SHA512 "
@nativ
konstante SAM_K_X25519: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO X25519 "
@nativ
konstante SAM_K_ED25519: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO ED25519 "
@nativ
konstante SAM_K_CHACHA20_POLY1305: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO CHACHA20-POLY1305 "
@nativ
konstante SAM_K_HMAC_DRBG: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO HMAC-DRBG "
@nativ
konstante SAM_K_ENTROPIE_LOGIK: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO ENTROPIE-LOGIK "
@nativ
konstante SAM_K_RDSEED: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO RDSEED "
@nativ
konstante SAM_K_RDRAND: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO RDRAND "
@nativ
konstante SAM_K_QUELLE: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO QUELLE "
@nativ
konstante SAM_K_ENDE: [u8; _] auf "MOO-KERNEL SAMMEL KRYPTO ENDE "

@nativ
funktion sammel_krypto(log: u64) -> void:
    unsicher:
        meldung(adresse_von(SAM_K_START), 1)
        sammel_wartung(log)
        setze kat: u64 auf moo_bare_krypto_selbsttest()
        meldung(adresse_von(SAM_K_SHA256), (kat >> 0) & 1)
        meldung(adresse_von(SAM_K_SHA512), (kat >> 1) & 1)
        meldung(adresse_von(SAM_K_HMAC_SHA256), (kat >> 2) & 1)
        meldung(adresse_von(SAM_K_HMAC_SHA512), (kat >> 3) & 1)
        meldung(adresse_von(SAM_K_X25519), (kat >> 4) & 1)
        meldung(adresse_von(SAM_K_ED25519), (kat >> 5) & 1)
        meldung(adresse_von(SAM_K_CHACHA20_POLY1305), (kat >> 6) & 1)
        meldung(adresse_von(SAM_K_HMAC_DRBG), (kat >> 7) & 1)
        meldung(adresse_von(SAM_K_ENTROPIE_LOGIK), (kat >> 8) & 1)
        sammel_wartung(log)
        setze quellen: u64 auf moo_bare_entropie_selbsttest()
        meldung(adresse_von(SAM_K_RDSEED), quellen & 15)
        meldung(adresse_von(SAM_K_RDRAND), (quellen >> 4) & 15)
        setze quelle: u64 auf (quellen >> 8) & 15
        meldung(adresse_von(SAM_K_QUELLE), quelle)
        meldung(adresse_von(SAM_K_ENDE), u64(kat == 0x1FF und quelle != 0))
        sammel_wartung(log)

# PCI-Konfigurationsmechanismus 1 (Segment 0), nur lesen. Treffer brauchen
# NVMe-Klasse und die explizite Vendor-/Device-ID aus dem privaten Laufprofil.
@nativ
funktion sammel_pci(ziel_id: u64) -> u64:
    unsicher:
        setze bdf: u64 auf 0
        setze anzahl: u64 auf 0
        setze kandidaten: u64 auf 0
        setze ziel: u64 auf 65536
        solange bdf < 65536:
            setze addr: u32 auf u32(0x80000000 | (bdf << 8))
            setze id: u64 auf u64(nt_cfg_lese32(addr))
            wenn (id & 0xFFFF) == 0xFFFF:
                wenn (bdf & 7) == 0:
                    setze bdf auf bdf + 7
            sonst:
                setze klasse_wert: u64 auf u64(nt_cfg_lese32(addr | 8))
                meldung(adresse_von(SAM_T_BDF), bdf)
                meldung(adresse_von(SAM_T_ID), id)
                meldung(adresse_von(SAM_T_KLASSE), klasse_wert)
                meldung(adresse_von(SAM_T_BAR0), u64(nt_cfg_lese32(addr | 0x10)))
                setze anzahl auf anzahl + 1
                wenn id == ziel_id und (klasse_wert >> 8) == 0x010802:
                    setze ziel auf bdf
                    setze kandidaten auf kandidaten + 1
                sammel_wartung(adresse_von(meldung))
            setze bdf auf bdf + 1
        meldung(adresse_von(SAM_T_PCI_ZIEL), kandidaten)
        meldung(adresse_von(SAM_T_PCI_ENDE), anzahl)
        wenn kandidaten != 1:
            gib_zurück 65536
        gib_zurück ziel

@nativ
funktion sammel_lauf(tsc: u64, bi: u64) -> void:
    unsicher:
        setze log: u64 auf adresse_von(meldung)
        setze map: u64 auf adresse_von(kern_mmio_abbilden)
        meldung(adresse_von(SAM_T_START), 1)
        meldung(adresse_von(SAM_T_PCI_START), 1)
        setze bdf: u64 auf sammel_pci(speicher_lesen(adresse_von(SAMMEL_ZIEL) + 16, 8))
        sammel_wartung(log)

        meldung(adresse_von(SAM_T_I226_START), 1)
        setze netz_id: u64 auf speicher_lesen(adresse_von(SAMMEL_I226_ZIEL) + 8, 8)
        setze nic_bereit: u64 auf i226_inventar(adresse_von(NETZ_PCI), netz_id, bi, map, log, adresse_von(sammel_wartung), tsc, falsch)
        meldung(adresse_von(SAM_T_I226_ENDE), nic_bereit)
        sammel_wartung(log)

        meldung(adresse_von(SAM_T_USB_START), 1)
        setze usb_ok: bool auf usb_inventar(pfa_nehme(64), tsc, bi, map, log, adresse_von(sammel_wartung))
        meldung(adresse_von(SAM_T_USB_ENDE), u64(usb_ok))
        sammel_wartung(log)

        meldung(adresse_von(SAM_T_MSC_START), 1)
        setze msc_ok: bool auf usb_speicher_pruefen(pfa_nehme(99), tsc, bi, map, log, usb_leseziel(1), usb_leseziel(2), adresse_von(USB_LESEN_SERIE))
        meldung(adresse_von(SAM_T_MSC_ENDE), u64(msc_ok))
        sammel_wartung(log)

        meldung(adresse_von(SAM_T_NVME_START), 1)
        meldung(adresse_von(SAM_T_NVME_ZIEL), bdf)
        setze nv_ok: bool auf falsch
        setze lesen: u64 auf adresse_von(NVME_LESEN_ZIEL)
        setze lesen_bdf: u64 auf speicher_lesen(lesen + 8, 8)
        setze voll: bool auf bdf < 65536 und lesen_bdf == bdf
        meldung(adresse_von(SAM_T_NVME_PROFIL), u64(voll))
        wenn bdf < 65536:
            wenn voll:
                setze nv_ok auf nvme_pruefen(pfa_nehme(39), tsc, bi, map, log, lesen)
            sonst wenn lesen_bdf == 65536:
                setze inventar: u64 auf adresse_von(NVME_INVENTAR_ZIEL)
                speicher_schreiben(inventar + 8, bdf, 8)
                setze nv_ok auf nvme_pruefen(pfa_nehme(39), tsc, bi, map, log, inventar)
        meldung(adresse_von(SAM_T_NVME_ENDE), u64(nv_ok))
        sammel_wartung(log)

        meldung(adresse_von(SAM_T_I226_PHY_START), 1)
        setze phy_bereit: u64 auf i226_inventar(adresse_von(NETZ_PCI), netz_id, bi, map, log, adresse_von(sammel_wartung), tsc, wahr)
        meldung(adresse_von(SAM_T_I226_PHY_ENDE), phy_bereit)
        sammel_wartung(log)

# ---------------- Kern ----------------
@nativ
@einstieg
funktion kern_haupt(bi: u64) -> void:
    unsicher:
        setze fb: u64 auf 0
        setze breite: u64 auf 0
        setze hoehe: u64 auf 0
        setze stride: u64 auf 0
        setze format: u64 auf 0
        setze karte: u64 auf 0
        setze schritt: u64 auf 0
        setze anzahl: u64 auf 0
        setze frei: u64 auf 0
        setze maxphys: u64 auf 0
        setze typ: u64 auf 0
        setze i: u64 auf 0
        setze d: u64 auf 0
        setze rsdp: u64 auf 0
        setze kern: u64 auf 0
        setze s: u64 auf adresse_von(SCHIRM)
        setze ok: u8 auf 0
        setze rip: u64 auf 0
        setze cr3: u64 auf 0
        setze pfa_frei: u64 auf 0
        setze idt_ok: bool auf falsch
        setze usb_ok: bool auf falsch
        setze heap_ok: bool auf falsch
        setze tabellen_frei: u64 auf 0
        setze acpi_ok: u64 auf 0
        setze timer_start: u64 auf 0
        setze tastatur_ok: bool auf falsch
        setze warte: u64 auf 0
        setze tsc: u64 auf 0
        setze t0: u64 auf 0
        setze t_alt: u64 auf 0
        setze t_neu: u64 auf 0
        setze t_zeile: u64 auf 0
        setze schirm_ok: bool auf falsch
        setze sammeln: bool auf speicher_lesen(adresse_von(SAMMEL_ZIEL) + 8, 8) == 1
        seriell_init()
        text(adresse_von(T_START))
        # Laeuft der Kern wirklich in der oberen Haelfte? RIP und RSP direkt lesen.
        setze rip auf assembler(ziel="x86_64", code="leaq 0(%rip), $0", ausgang="=r", clobber=[])
        meldung(adresse_von(T_RIP), rip)
        meldung(adresse_von(T_RSP), assembler(ziel="x86_64", code="movq %rsp, $0", ausgang="=r", clobber=[]))
        wenn speicher_lesen(bi + versatz_von(MooBootInfo, magie), 8) != BOOT_MAGIE:
            meldung(adresse_von(T_MAGIE), speicher_lesen(bi, 8))
            anhalten()
        meldung(adresse_von(T_GDT), gdt_einrichten())
        setze fb auf speicher_lesen(bi + versatz_von(MooBootInfo, fb_basis), 8)
        setze breite auf u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_breite), 4))
        setze hoehe auf u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_hoehe), 4))
        setze stride auf u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_stride), 4))
        setze format auf u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_format), 4))
        meldung(adresse_von(T_FB), fb)
        meldung(adresse_von(T_BREITE), breite)
        meldung(adresse_von(T_HOEHE), hoehe)
        meldung(adresse_von(T_STRIDE), stride)
        meldung(adresse_von(T_FORMAT), format)
        wenn format == 2:
            meldung(adresse_von(T_MASKEN), (u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_maske_rot), 4)) << 32) | u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_maske_blau), 4)))
        # Speicherkarte: Deskriptoren zaehlen, EfiConventionalMemory (7) summieren, hoechste Adresse.
        setze karte auf speicher_lesen(bi + versatz_von(MooBootInfo, karte), 8)
        setze schritt auf speicher_lesen(bi + versatz_von(MooBootInfo, deskriptor_groesse), 8)
        wenn schritt >= groesse_von(EfiSpeicherDeskriptor):
            setze anzahl auf speicher_lesen(bi + versatz_von(MooBootInfo, karte_groesse), 8) / schritt
        solange i < anzahl:
            setze d auf karte + i * schritt
            wenn speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_typ), 4) == 7:
                setze frei auf frei + speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_seiten), 8)
            # Hoechste RAM-Adresse: Typen 1..10 (Loader/Boot/Runtime/frei/ACPI), ohne MMIO (11/12).
            setze typ auf u64(speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_typ), 4))
            wenn typ >= 1 und typ <= 10 und speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_physisch), 8) + speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_seiten), 8) * 4096 > maxphys:
                setze maxphys auf speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_physisch), 8) + speicher_lesen(d + versatz_von(EfiSpeicherDeskriptor, sd_seiten), 8) * 4096
            setze i auf i + 1
        meldung(adresse_von(T_KARTE), anzahl)
        meldung(adresse_von(T_FREI), frei / 256)
        meldung(adresse_von(T_MAXPHYS), maxphys)
        # PFA und Heap laufen vor dem Paging-Wechsel nur auf ConventionalMemory.
        setze pfa_frei auf pfa_starten(bi, maxphys)
        meldung(adresse_von(T_PFA), pfa_frei)
        setze heap_ok auf heap_starten()
        wenn heap_ok:
            setze heap_ok auf heap_pruefen()
        meldung(adresse_von(T_HEAP), u64(heap_ok))
        # Eigene Seitentabellen (Firmware-Tabellen werden danach nicht mehr benutzt).
        setze cr3 auf paging_einrichten(bi, maxphys, fb, speicher_lesen(bi + versatz_von(MooBootInfo, fb_groesse), 8))
        wenn cr3 != 0:
            meldung(adresse_von(T_PAGING), cr3)
        sonst:
            meldung(adresse_von(T_PAGING_NEIN), maxphys)
            anhalten()
        # Eigene NIC-DMA-Ringe muessen vor Freigabe ihrer alten UEFI-Arena stehen.
        setze idt_ok auf idt_einrichten()
        setze tsc auf tsc_kalibrieren()
        meldung(adresse_von(T_TSC), tsc)
        meldung(adresse_von(T_NETZ), netz_starten(bi, tsc))
        # Erst hinter dem eigenen CR3 werden Loader- und Firmware-Tabellen frei.
        setze tabellen_frei auf pfa_bootspeicher_freigeben(bi)
        meldung(adresse_von(T_TABELLEN), tabellen_frei)
        meldung(adresse_von(T_IDT), u64(idt_ok))
        setze rsdp auf speicher_lesen(bi + versatz_von(MooBootInfo, acpi_rsdp), 8)
        meldung(adresse_von(T_RSDP), rsdp)
        wenn rsdp != 0:
            meldung(adresse_von(T_RSDP_OK), u64(speicher_lesen(rsdp, 8) == RSDP_SIGNATUR))
            setze acpi_ok auf acpi_starten(rsdp)
        meldung(adresse_von(T_ACPI), acpi_ok)
        setze fadt_reset: u64 auf 0
        setze lpit: u64 auf 0
        wenn rsdp != 0:
            setze fadt_reset auf acpi_tabelle(rsdp, 0x50434146)
            setze lpit auf acpi_tabelle(rsdp, 0x5449504C)
        testlauf_starten(fadt_reset, lpit, bi, tsc, adresse_von(kern_mmio_abbilden), adresse_von(meldung))
        netz_spuelen()
        testlauf_poll(adresse_von(meldung))
        testlauf_rueckfall(adresse_von(meldung))
        # Ausschliesslich nach dem Rueckfall-Guard; DMA bleibt dauerhaft im PFA.
        wenn sammeln:
            setze modus: u64 auf testlauf_konfig(3)
            # ADL-N SMBus D31:F4 (Intel 759604, 15.1.17/18). Modus 1
            # hat den IT8613 gestartet, testlauf_poll faellt bei Fehler sofort zurueck.
            wenn modus != 1 und nt_cfg_lese32(0x8000FC00) == 0x54A38086:
                testlauf_neustart(adresse_von(meldung))
            sammel_lauf(tsc, bi)
        sonst:
            wenn speicher_lesen(adresse_von(NVME_LESEN_ZIEL) + 8, 8) < 65536:
                nvme_pruefen(pfa_nehme(39), tsc, bi, adresse_von(kern_mmio_abbilden), adresse_von(meldung), adresse_von(NVME_LESEN_ZIEL))
        meldung(adresse_von(T_FORMATE), formate_pruefen())
        # Bildschirm: alles ueber den Surface-Kern in den Rueckpuffer, dann Present.
        setze schirm_ok auf fb != 0 und breite >= 160 und hoehe >= 200 und breite <= 3840 und hoehe <= 2160 und format <= 2 und stride >= breite
        wenn nicht schirm_ok:
            meldung(adresse_von(T_KEIN_FB), format)
        wenn schirm_ok:
            # Messung "vorher": alter Weg (P7-T5) fuellte den FB direkt.
            wenn format <= 1:
                setze t0 auf takt()
                fuellen(fb, breite, hoehe, stride, pixel(format, 32, 96, 128))
                setze t_alt auf takt() - t0
            setze kern auf adresse_von(SURFACE_KERN)
            speicher_schreiben(s + versatz_von(Schirm, s_fb), fb, 8)
            speicher_schreiben(s + versatz_von(Schirm, s_breite), breite, 8)
            speicher_schreiben(s + versatz_von(Schirm, s_hoehe), hoehe, 8)
            speicher_schreiben(s + versatz_von(Schirm, s_ziel_stride), stride, 8)
            speicher_schreiben(s + versatz_von(Schirm, s_format), format, 8)
            speicher_schreiben(s + versatz_von(Schirm, s_mr), u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_maske_rot), 4)), 8)
            speicher_schreiben(s + versatz_von(Schirm, s_mg), u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_maske_gruen), 4)), 8)
            speicher_schreiben(s + versatz_von(Schirm, s_mb), u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_maske_blau), 4)), 8)
            speicher_schreiben(s + versatz_von(Schirm, s_puffer), adresse_von(BILD), 8)
            speicher_schreiben(s + versatz_von(Schirm, s_puffer_stride), breite * 4, 8)
            speicher_schreiben(s + versatz_von(Schirm, s_kern), kern, 8)
            setze ok auf moo_surface_core_init(zeiger(kern), zeiger(adresse_von(BILD)), breite * 4 * hoehe, i32(breite), i32(hoehe), breite * 4)
            meldung(adresse_von(T_SURFACE), u64(ok))
            wenn ok != 0:
                moo_surface_core_clear(zeiger(kern), rgba(32, 96, 128))
                moo_surface_core_rect(zeiger(kern), 40, 40, i32(breite) - 80, 140, rgba(255, 196, 64))
                moo_surface_core_text_3x5(zeiger(kern), 64, 60, 12, zeiger(adresse_von(T_SCHIRM)), 13, rgba(20, 20, 20))
                moo_surface_core_text_3x5(zeiger(kern), 64, 220, 6, zeiger(adresse_von(T_SCHIRM2)), 25, rgba(240, 240, 240))
                setze t0 auf takt()
                schirm_zeilen(0, hoehe)
                setze t_neu auf takt() - t0
                konsole_starten(40, 300, breite - 40, hoehe - 100, 2, u64(rgba(200, 230, 255)), u64(rgba(32, 96, 128)))
                eingabe_zeigen()
                setze t0 auf takt()
                text(adresse_von(T_KON1))
                setze t_zeile auf takt() - t0
                text(adresse_von(T_KON2))
                # Fruehe Resultate unveraendert auf dem jetzt aktiven Bildschirm spiegeln.
                # Die Werte sind die Boot-Snapshots, keine zweite Initialisierung.
                meldung(adresse_von(T_PFA), pfa_frei)
                meldung(adresse_von(T_HEAP), u64(heap_ok))
                meldung(adresse_von(T_TABELLEN), tabellen_frei)
                meldung(adresse_von(T_IDT), u64(idt_ok))
                meldung(adresse_von(T_ACPI), acpi_ok)
                text(adresse_von(T_SICHT))
                meldung(adresse_von(T_ALT), t_alt)
                meldung(adresse_von(T_NEU), t_neu)
                wenn tsc != 0:
                    meldung(adresse_von(T_ALT_US), t_alt / tsc)
                    meldung(adresse_von(T_NEU_US), t_neu / tsc)
                    meldung(adresse_von(T_ZEILE_US), t_zeile / tsc)
        meldung(adresse_von(T_AUS_TEST), u64(ausnahme_pruefen()))
        # Legacy-PIC bleibt vollstaendig maskiert; externe IRQs laufen ueber IOAPIC.
        aus8(0x21, 0xFF)
        aus8(0xA1, 0xFF)
        setze timer_start auf timer_starten(tsc)
        meldung(adresse_von(T_TIMER_QUELLE), hw(15))
        meldung(adresse_von(T_TIMER_INIT), timer_start)
        setze tastatur_ok auf ps2_starten()
        wenn tastatur_ok:
            meldung(adresse_von(T_TASTATUR_BEREIT), 1)
        sonst:
            meldung(adresse_von(T_TASTATUR_BEREIT), 0)
            text(adresse_von(T_TASTATUR_FEHLT))
        meldung(adresse_von(T_USB_TEST), u64(usb_report_pruefen()))
        # Erst die lesende Boot-Stick-Diagnose, dann den HID-Host neu initialisieren.
        # Der Rueckfallzweig weiter oben kehrt nicht hierher zurueck.
        wenn nicht sammeln:
            usb_speicher_pruefen(pfa_nehme(99), tsc, bi, adresse_von(kern_mmio_abbilden), adresse_von(meldung), usb_leseziel(1), usb_leseziel(2), adresse_von(USB_LESEN_SERIE))
        # PFA besitzt die DMA-Seiten dauerhaft. Kein Firmware-Speicher wird benutzt.
        wenn sammeln:
            meldung(adresse_von(SAM_T_HID_START), 1)
            sammel_wartung(adresse_von(meldung))
        setze usb_ok auf usb_starten(adresse_von(usb_dma_nehmen), tsc, bi, adresse_von(kern_mmio_abbilden), adresse_von(meldung), adresse_von(sammel_wartung), sammeln)
        meldung(adresse_von(T_USB_BAR), xh(23))
        meldung(adresse_von(T_USB_CAP), xh(0))
        meldung(adresse_von(T_USB_DMA), xh(4))
        meldung(adresse_von(T_USB_BEREIT), u64(usb_ok))
        wenn nicht usb_ok:
            meldung(adresse_von(T_USB_FEHLER), xh(19))
        wenn sammeln:
            meldung(adresse_von(SAM_T_HID_ENDE), u64(usb_ok))
            wenn speicher_lesen(adresse_von(SAMMEL_KRYPTO) + 8, 8) == 1:
                sammel_krypto(adresse_von(meldung))
            meldung(adresse_von(SAM_T_ENDE), 1)
            sammel_wartung(adresse_von(meldung))
        wenn timer_start != 0:
            unterbrechungen_an()
            solange (hw(10) < 3 oder (tastatur_ok und nicht usb_ok und hw(11) == 0) oder (usb_ok und speicher_lesen(adresse_von(USB_TASTEN), 8) == 0)) und warte < 1000:
                usb_poll()
                netz_spuelen()
                testlauf_poll(adresse_von(meldung))
                bis_unterbrechung_warten()
                setze warte auf warte + 1
            unterbrechungen_aus()
        setze ticks: u64 auf hw(10)
        meldung(adresse_von(T_TIMER_TICKS), ticks)
        konsolen_status(pfa_frei, ticks)
        wenn tastatur_ok:
            meldung(adresse_von(T_TASTATUR_SCAN), hw(11))
        wenn netz_ipv4_adresse() != 0 und speicher_lesen(adresse_von(NETZ), 8) != 0:
            wenn netz_transport_aktiv():
                meldung(adresse_von(T_NETZ_TRANSPORT), 1)
                wenn netz_echo_aktiv():
                    meldung(adresse_von(T_NETZ_ECHO), 1)
                wenn speicher_lesen(adresse_von(NETZ_SSH_KONFIG) + 8, 8) == 1:
                    ssh_booten(adresse_von(meldung))
            meldung(adresse_von(T_NETZ_IPV4), netz_ipv4_adresse())
        text(adresse_von(T_OK))
        # Eingabe, Netz-FIFO und Testreset bleiben auch bei fehlenden Geraeten aktiv.
        # Ohne Timer nicht hlt: der befristete Test muss weiter per TSC pollen.
        wenn timer_start != 0:
            unterbrechungen_an()
        solange wahr:
            usb_poll()
            netz_poll(tsc)
            netz_spuelen()
            testlauf_poll(adresse_von(meldung))
            wenn timer_start != 0:
                bis_unterbrechung_warten()
