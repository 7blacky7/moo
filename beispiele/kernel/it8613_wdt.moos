# IT8613E: Linux v6.12 drivers/watchdog/it87_wdt.c:39–87,115–155,159–212,283–304.
# Coreboot 694450ff2b7a util/superiotool/ite.c:379–406,1924–1929,1964–1967.
# Clock-Quelle in LDN 7, 71h[3] laut src/superio/ite/it8613e/it8613e.h:6–20.
aus "../uefi/hardware_pci" importiere takt, nt_cfg_lese32

@nativ
konstante IT8613_PORT: [u8; _] auf "MOO-KERNEL IT8613 PORT "
@nativ
konstante IT8613_ID: [u8; _] auf "MOO-KERNEL IT8613 CHIP ID "
@nativ
konstante IT8613_REV: [u8; _] auf "MOO-KERNEL IT8613 CHIP REV "
@nativ
konstante IT8613_CTRL: [u8; _] auf "MOO-KERNEL IT8613 WDT CTRL "
@nativ
konstante IT8613_CFG: [u8; _] auf "MOO-KERNEL IT8613 WDT CFG "
@nativ
konstante IT8613_LSB: [u8; _] auf "MOO-KERNEL IT8613 WDT TIMEOUT LSB "
@nativ
konstante IT8613_MSB: [u8; _] auf "MOO-KERNEL IT8613 WDT TIMEOUT MSB "
@nativ
konstante IT8613_REG23: [u8; _] auf "MOO-KERNEL IT8613 REG 23H "
@nativ
konstante IT8613_REG2D: [u8; _] auf "MOO-KERNEL IT8613 REG 2DH "
@nativ
konstante IT8613_SAFETY_CTRL_READBACK: [u8; _] auf "MOO-KERNEL IT8613 SAFETY CTRL QUITTIERUNG READBACK "
@nativ
konstante IT8613_SAFETY_MESSZEIT: [u8; _] auf "MOO-KERNEL IT8613 SAFETY MESSZEIT MS "
@nativ
konstante IT8613_FEHLT: [u8; _] auf "MOO-KERNEL IT8613 NICHT BELEGT "
@nativ
konstante IT8613_AN: [u8; _] auf "MOO-KERNEL IT8613 SCHARF SEKUNDEN "
@nativ
konstante IT8613_VOR_START_AUS: [u8; _] auf "MOO-KERNEL IT8613 VOR START AUS "
@nativ
konstante IT8613_SAFETY: [u8; _] auf "MOO-KERNEL IT8613 SAFETY OHNE BEDIENUNG "
@nativ
konstante IT8613_SAFETY_FRIST: [u8; _] auf "MOO-KERNEL IT8613 SAFETY SOFTWARE FRIST SEKUNDEN "
@nativ
konstante IT8613_NEIN: [u8; _] auf "MOO-KERNEL IT8613 SCHARFSCHALTUNG VERWEIGERT "
@nativ
konstante IT8613_PING: [u8; _] auf "MOO-KERNEL IT8613 BEDIENT "
@nativ
konstante IT8613_PING_FEHLER: [u8; _] auf "MOO-KERNEL IT8613 BEDIENUNG FEHLER "
@nativ
konstante IT8613_AUS: [u8; _] auf "MOO-KERNEL IT8613 AUS "
@nativ
konstante IT8613_AUS_FEHLER: [u8; _] auf "MOO-KERNEL IT8613 ABSCHALTEN FEHLER "

@nativ
funktion it8613_register_lesen(port: u16, index: u8) -> u8:
    unsicher:
        setze datenport: u16 auf port + 1
        port_schreibe(port, index)
        gib_zurück port_lese(datenport)

@nativ
funktion it8613_register_schreiben(port: u16, index: u8, wert: u8) -> void:
    unsicher:
        setze datenport: u16 auf port + 1
        port_schreibe(port, index)
        port_schreibe(datenport, wert)


@nativ
funktion it8613_register_schreiben_write0(port: u16, index: u8, vorher: u8, maske: u8) -> void:
    unsicher:
        setze datenport: u16 auf port + 1
        # Selektor und Snapshot bleiben explizit: kein zusaetzlicher Geraete-Read.
        port_schreibe(port, index)
        port_schreibe_write0(datenport, vorher, maske)

@nativ
funktion it8613_konfiguration_oeffnen(port: u16) -> u16:
    unsicher:
        port_schreibe(port, 0x87)
        port_schreibe(port, 0x01)
        port_schreibe(port, 0x55)
        wenn port == 0x2E:
            port_schreibe(port, 0x55)
        sonst:
            port_schreibe(port, 0xAA)
        setze hoch: u16 auf u16(it8613_register_lesen(port, 0x20))
        gib_zurück (hoch << 8) | u16(it8613_register_lesen(port, 0x21))

@nativ
funktion it8613_port_lesen(port: u16, loggen: u64, mit_takt: bool) -> bool:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze id: u16 auf 0
        setze gefunden: bool auf falsch
        setze rev: u8 auf 0
        setze ctrl: u8 auf 0
        setze cfg: u8 auf 0
        setze lsb: u8 auf 0
        setze msb: u8 auf 0
        setze reg23: u8 auf 0
        setze reg2d: u8 auf 0
        unsicher:
            aufräumen: it8613_register_schreiben(port, 0x02, 0x02)
            setze id auf it8613_konfiguration_oeffnen(port)
            wenn id == 0x8613:
                wenn mit_takt:
                    setze reg23 auf it8613_register_lesen(port, 0x23)
                setze vorher: u8 auf it8613_register_lesen(port, 0x07)
                aufräumen: it8613_register_schreiben(port, 0x07, vorher)
                it8613_register_schreiben(port, 0x07, 7)
                wenn it8613_register_lesen(port, 0x07) == 7:
                    setze rev auf it8613_register_lesen(port, 0x22) & 0x0F
                    setze ctrl auf it8613_register_lesen(port, 0x71)
                    setze cfg auf it8613_register_lesen(port, 0x72)
                    setze lsb auf it8613_register_lesen(port, 0x73)
                    setze msb auf it8613_register_lesen(port, 0x74)
                    wenn mit_takt:
                        # Coreboot it8613e.h:13–20 ordnet 2Dh[2:1] LDN 7 zu.
                        setze reg2d auf it8613_register_lesen(port, 0x2D)
                    setze gefunden auf wahr
        log(adresse_von(IT8613_PORT), u64(port))
        log(adresse_von(IT8613_ID), u64(id))
        wenn gefunden:
            log(adresse_von(IT8613_REV), u64(rev))
            log(adresse_von(IT8613_CTRL), u64(ctrl))
            log(adresse_von(IT8613_CFG), u64(cfg))
            log(adresse_von(IT8613_LSB), u64(lsb))
            log(adresse_von(IT8613_MSB), u64(msb))
            wenn mit_takt:
                log(adresse_von(IT8613_REG23), u64(reg23))
                log(adresse_von(IT8613_REG2D), u64(reg2d))
        gib_zurück gefunden

@nativ
funktion it8613_suchen(loggen: u64) -> u16:
    unsicher:
        wenn nt_cfg_lese32(0x8000FC00) == 0x54A38086:
            wenn it8613_port_lesen(0x2E, loggen, falsch):
                gib_zurück 0x2E
            wenn it8613_port_lesen(0x4E, loggen, falsch):
                gib_zurück 0x4E
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        log(adresse_von(IT8613_FEHLT), 1)
        gib_zurück 0

# Die IT8613E-Tabelle in Coreboot util/superiotool/ite.c:397–409
# nennt 20h/0038h als Vorgabewerte. Beide Resetfreigaben sind dabei aus.
@nativ
funktion it8613_ausgangszustand(port: u16) -> bool:
    unsicher:
        setze lsb: u8 auf it8613_register_lesen(port, 0x73)
        setze msb: u8 auf it8613_register_lesen(port, 0x74)
        gib_zurück msb == 0 und (lsb == 0 oder (lsb == 0x38 und it8613_register_lesen(port, 0x72) == 0x20))

# Rueckgabe 0: ohne Programmierung verweigert. 1: Readback passt.
# 2: Schreibversuch, Readback offen. Nach Scharfschaltversuch muss der Stopp belegt sein.
# Linux it87_wdt.c:159–177 startet/laedt mit TOV1|KRST|PWROK (0xD0).
# Coreboot src/superio/ite/common/early_serial.c:137–144 stoppt mit drei Nullbytes.
@nativ
funktion it8613_programmieren(port: u16, zeit: u8, vor_start: bool) -> u8:
    unsicher:
        setze ergebnis: u8 auf 0
        aufräumen: it8613_register_schreiben(port, 0x02, 0x02)
        wenn it8613_konfiguration_oeffnen(port) == 0x8613:
            setze vorher: u8 auf it8613_register_lesen(port, 0x07)
            aufräumen: it8613_register_schreiben(port, 0x07, vorher)
            it8613_register_schreiben(port, 0x07, 7)
            wenn it8613_register_lesen(port, 0x07) == 7 und (nicht vor_start oder (zeit == 0 und it8613_ausgangszustand(port))):
                setze cfg: u8 auf 0
                wenn zeit != 0:
                    setze cfg auf 0xD0
                it8613_register_schreiben(port, 0x72, cfg)
                setze ergebnis auf 2
                wenn zeit == 0 oder it8613_register_lesen(port, 0x72) == cfg:
                    it8613_register_schreiben(port, 0x73, zeit)
                    it8613_register_schreiben(port, 0x74, 0)
                    setze lsb: u8 auf it8613_register_lesen(port, 0x73)
                    setze msb: u8 auf it8613_register_lesen(port, 0x74)
                    wenn it8613_register_lesen(port, 0x72) == cfg und msb == 0 und lsb <= zeit und (zeit == 0 oder lsb != 0):
                        setze ergebnis auf 1
        gib_zurück ergebnis

# FreeBSD itwd.c:108–116 quittiert den Status mit 0 in 71h[0].
# Readback von Status und Taktbit prüft die Quittierung auf dem IT8613.
@nativ
funktion it8613_ctrl_quittieren(port: u16, loggen: u64) -> bool:
    unsicher:
        setze gelesen: bool auf falsch
        setze ctrl: u8 auf 0
        setze readback: u8 auf 0
        unsicher:
            aufräumen: it8613_register_schreiben(port, 0x02, 0x02)
            wenn it8613_konfiguration_oeffnen(port) == 0x8613:
                setze vorher: u8 auf it8613_register_lesen(port, 0x07)
                aufräumen: it8613_register_schreiben(port, 0x07, vorher)
                it8613_register_schreiben(port, 0x07, 7)
                wenn it8613_register_lesen(port, 0x07) == 7:
                    setze ctrl auf it8613_register_lesen(port, 0x71)
                    it8613_register_schreiben_write0(port, 0x71, ctrl, 1)
                    setze readback auf it8613_register_lesen(port, 0x71)
                    setze gelesen auf wahr
        wenn gelesen:
            setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
            log(adresse_von(IT8613_SAFETY_CTRL_READBACK), u64(readback))
        gib_zurück gelesen und (readback & 0x09) == (ctrl & 0x08)

@nativ
funktion it8613_abschalten(port: u16, software_rueckfall: bool, loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        wenn it8613_programmieren(port, 0, falsch) == 1:
            log(adresse_von(IT8613_AUS), 0)
            gib_zurück
        log(adresse_von(IT8613_AUS_FEHLER), 1)
        wenn software_rueckfall:
            gib_zurück
        assembler(ziel="x86_64", code="cli", clobber=[])
        solange wahr:
            assembler(ziel="x86_64", code="hlt", clobber=[])

# Gemeinsamer Kaltstart fuer Normal-, Rueckfall-, Bedien- und Safety-Lauf.
@nativ
funktion it8613_starten(watchdog: u64, software_rueckfall: bool, loggen: u64) -> u16:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        wenn watchdog < 6 oder watchdog > 30:
            log(adresse_von(IT8613_NEIN), 0)
            gib_zurück 0
        setze port: u16 auf it8613_suchen(loggen)
        wenn port == 0:
            log(adresse_von(IT8613_NEIN), 0)
            gib_zurück 0
        setze ergebnis: u8 auf it8613_programmieren(port, 0, wahr)
        wenn ergebnis != 1:
            log(adresse_von(IT8613_NEIN), u64(ergebnis))
            gib_zurück 0
        log(adresse_von(IT8613_VOR_START_AUS), 0)
        wenn nicht it8613_ctrl_quittieren(port, loggen):
            log(adresse_von(IT8613_NEIN), 3)
            gib_zurück 0
        setze ergebnis auf it8613_programmieren(port, u8(watchdog), falsch)
        wenn ergebnis != 1:
            log(adresse_von(IT8613_NEIN), u64(ergebnis))
            wenn ergebnis == 2:
                it8613_abschalten(port, software_rueckfall, loggen)
            gib_zurück 0
        log(adresse_von(IT8613_AN), watchdog)
        gib_zurück port

@nativ
funktion it8613_bedienen(port: u16, watchdog: u8, pings: u64, loggen: u64) -> bool:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze ergebnis: u8 auf it8613_programmieren(port, watchdog, falsch)
        wenn ergebnis != 1:
            log(adresse_von(IT8613_PING_FEHLER), u64(ergebnis))
            gib_zurück falsch
        log(adresse_von(IT8613_PING), pings)
        gib_zurück wahr

# Die Probe liest bis zur ursprünglichen Softwarefrist. Der Config-Mode
# ist zwischen zwei Proben geschlossen; in diesem Fenster gibt es keinen Reload.
@nativ
funktion it8613_safety_beobachten(port: u16, start: u64, hz: u64, sekunden: u64, loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        setze frist: u64 auf hz * sekunden
        setze faellig: u64 auf 0
        setze vergangen: u64 auf takt() - start
        solange vergangen < frist:
            wenn vergangen >= faellig:
                setze faellig auf vergangen + hz
                log(adresse_von(IT8613_SAFETY_MESSZEIT), vergangen * 1000 / hz)
                it8613_port_lesen(port, loggen, wahr)
            assembler(ziel="x86_64", code="pause", clobber=[])
            setze vergangen auf takt() - start

@nativ
funktion it8613_kurzlauf(sekunden: u64, watchdog: u64, hz: u64, safety: bool, loggen: u64) -> void:
    unsicher:
        setze log: ptr[fn[sysv64](u64, u64) -> void] auf zeiger(loggen)
        wenn hz == 0 oder sekunden <= watchdog oder sekunden > 60 oder (safety und sekunden < watchdog + 5):
            log(adresse_von(IT8613_NEIN), 0)
            gib_zurück
        setze port: u16 auf it8613_starten(watchdog, safety, loggen)
        wenn port == 0:
            gib_zurück
        setze start: u64 auf takt()
        wenn safety:
            log(adresse_von(IT8613_SAFETY), watchdog)
            it8613_safety_beobachten(port, start, hz, sekunden, loggen)
            log(adresse_von(IT8613_SAFETY_FRIST), sekunden)
        sonst:
            setze letzte_bedienung: u64 auf start
            setze pings: u64 auf 0
            solange takt() - start < hz * sekunden:
                setze jetzt: u64 auf takt()
                wenn jetzt - letzte_bedienung >= hz:
                    setze pings auf pings + 1
                    wenn nicht it8613_bedienen(port, u8(watchdog), pings, loggen):
                        it8613_abschalten(port, falsch, loggen)
                        gib_zurück
                    setze letzte_bedienung auf jetzt
                assembler(ziel="x86_64", code="pause", clobber=[])
        it8613_abschalten(port, safety, loggen)
