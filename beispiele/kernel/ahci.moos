# AHCI 1.3.1, Linux v6.12 drivers/ata/ahci.h und drivers/ata/libahci.c.
# Ein Befehl pro SATA-Port, eigene DMA-Seiten und IRQ-Status je Port.
aus "kern_block" importiere BlockGeraet, BlockGeometrie, BlockFehler, BlockAnfrage, BLOCK_OK, BLOCK_LESEN, BLOCK_SCHREIBEN, BLOCK_SCHREIBEN_FUA, BLOCK_FLUSH, BLOCK_VERWERFEN, BLOCK_UNBEKANNT, BLOCK_EA, BLOCK_ZEIT, BLOCK_NICHT_BEREIT, block_abschliessen, block_registrieren
aus "kern_irq" importiere kern_irq_msi, kern_irq_stoppen
aus "kern_mutex" importiere KernMutex, mutex_nimm, mutex_gib
aus "kern_smp" importiere smp_planer
aus "../uefi/hardware_pci" importiere takt, nt_null, nt_mmio_lese32, nt_mmio_schreibe32, nt_mmio_glocke32
aus "../uefi/netz_geraet" importiere nt_bar_slot, nt_kopiere, pci_lese32, pci_schreibe32
aus "speicher_gpt" importiere gp_log

@nativ
konstante AHCI_DMA_SEITEN: u64 auf 19
@nativ
konstante AHCI_BOUNCE_BYTES: u64 auf 65536
@nativ
konstante AHCI_PXIS_FEHLER: u32 auf 0x78000010
@nativ
konstante AHCI_PXIS_LINK: u32 auf 0x00400040
@nativ
konstante AHCI_PXIE_MASKE: u32 auf 0x7840005B

@nativ
statisch AHCI_PCI: [u64; 1] auf 0
@nativ
konstante AHCI_PRAEFIX: [u8; _] auf "MOO-KERNEL AHCI "
@nativ
konstante AHCI_LOG_RESET: [u8; _] auf "RESET "
@nativ
konstante AHCI_LOG_PI: [u8; _] auf "PI "
@nativ
konstante AHCI_LOG_MSI: [u8; _] auf "MSI "
@nativ
konstante AHCI_LOG_PORT: [u8; _] auf "PORT "
@nativ
konstante AHCI_LOG_NCQ: [u8; _] auf "NCQ "
@nativ
konstante AHCI_LOG_OPCODE: [u8; _] auf "OPCODE "
@nativ
konstante AHCI_LOG_PXIS: [u8; _] auf "PXIS "
@nativ
konstante AHCI_LOG_PXSERR: [u8; _] auf "PXSERR "

# abar_bytes ist der vom Aufrufer geprüfte BAR-Ressourcenumfang.
struktur AhciHbaZiel:
    bdf: u64
    pci_id: u64
    abar_bytes: u64
    apic_id: u64

struktur AhciPortZiel:
    nummer: u64
    dma: u64
    serie: u64
    schreibbar: bool
    ncq_erlaubt: bool

struktur AhciPort implementiert BlockGeraet:
    hba: ptr[AhciHba]
    registerbasis: u64
    dma: u64
    groesse: BlockGeometrie
    ncq: bool
    flush_ext: bool
    sperre: KernMutex
    pxis: atom[u32]
    pxserr: atom[u32]
    linkwechsel: atom[u32]
    irq_anzahl: atom[u64]
    bereit: bool

    funktion geometrie(selbst) -> BlockGeometrie:
        unsicher:
            gib_zurück selbst.groesse

    funktion block_starten(selbst, anfrage: ptr[BlockAnfrage]) -> ergebnis[void, BlockFehler]:
        unsicher:
            setze sperre: ptr[KernMutex] auf zeiger(adresse_von(selbst.sperre))
            mutex_nimm(smp_planer(), sperre)
            setze f: BlockFehler auf ahci_auftrag(selbst, anfrage)
            mutex_gib(smp_planer(), sperre)
            block_abschliessen(anfrage, f)
            gib_zurück erfolg()

struktur AhciHba:
    registerbasis: u64
    bdf: u64
    pci_id: u64
    pci_cmd: u64
    tsc: u64
    log: u64
    cap: u32
    pi: u32
    vektor: u64
    ports: [AhciPort; 32]

@nativ
funktion ahci_log(hba: ptr[AhciHba], text: u64, wert: u64) -> void:
    unsicher:
        wenn hba.log != 0:
            gp_log(hba.log, adresse_von(AHCI_PRAEFIX), text, wert)

@nativ
funktion ahci_port_ort(hba: ptr[AhciHba], nummer: u64) -> ptr[AhciPort]:
    unsicher:
        gib_zurück zeiger(adresse_von(hba.ports) + nummer * groesse_von(AhciPort))

@nativ
funktion ahci_pci_da(hba: ptr[AhciHba]) -> bool:
    unsicher:
        gib_zurück pci_lese32(adresse_von(AHCI_PCI), hba.bdf, 0) == hba.pci_id

@nativ
funktion ahci_px(port: ptr[AhciPort], offset: u64) -> u32:
    unsicher:
        gib_zurück nt_mmio_lese32(port.registerbasis + offset)

@nativ
funktion ahci_px_setzen(port: ptr[AhciPort], offset: u64, wert: u32) -> void:
    unsicher:
        nt_mmio_schreibe32(port.registerbasis + offset, wert)

@nativ
funktion ahci_warte_register(registerbasis: u64, maske: u32, soll: u32, frist: u64) -> bool:
    unsicher:
        setze start: u64 auf takt()
        solange takt() - start < frist:
            setze wert: u32 auf nt_mmio_lese32(registerbasis)
            wenn wert == 0xFFFFFFFF:
                gib_zurück falsch
            wenn (wert & maske) == soll:
                gib_zurück wahr
            kern_pause()
        gib_zurück falsch

# PxIS und PxSERR werden erst nach der Sicherung per W1C quittiert.
@nativ
funktion ahci_port_ereignis(port: ptr[AhciPort]) -> void:
    unsicher:
        setze pxis: u32 auf ahci_px(port, 0x10)
        setze serr: u32 auf ahci_px(port, 0x30)
        wenn pxis == 0xFFFFFFFF oder serr == 0xFFFFFFFF:
            atom_speichern(port.linkwechsel, 1, ordnung=freigeben)
            gib_zurück
        wenn (pxis & AHCI_PXIS_LINK) != 0 oder (serr & 0x00010000) != 0:
            atom_speichern(port.linkwechsel, 1, ordnung=freigeben)
        wenn serr != 0:
            atom_oder(port.pxserr, serr, ordnung=freigeben)
            ahci_px_setzen(port, 0x30, serr)
        wenn pxis != 0:
            atom_oder(port.pxis, pxis, ordnung=freigeben)
            ahci_px_setzen(port, 0x10, pxis)

@nativ
funktion ahci_irq(daten: u64) -> void:
    unsicher:
        setze hba: ptr[AhciHba] auf zeiger(daten)
        setze status: u32 auf nt_mmio_lese32(hba.registerbasis + 8)
        wenn status == 0xFFFFFFFF:
            gib_zurück
        setze nr: u64 auf 0
        solange nr < 32:
            wenn (status & (u32(1) << nr) & hba.pi) != 0:
                setze port: ptr[AhciPort] auf ahci_port_ort(hba, nr)
                ahci_port_ereignis(port)
                atom_addieren(port.irq_anzahl, 1, ordnung=freigeben)
            setze nr auf nr + 1
        wenn status != 0:
            nt_mmio_schreibe32(hba.registerbasis + 8, status)

# libahci.c ahci_stop_engine/ahci_stop_fis_rx: ST→CR=0, FRE→FR=0.
@nativ
funktion ahci_port_stoppen(port: ptr[AhciPort]) -> bool:
    unsicher:
        setze port.bereit auf falsch
        wenn port.registerbasis == 0 oder nicht ahci_pci_da(port.hba):
            gib_zurück falsch
        setze cmd: u32 auf ahci_px(port, 0x18)
        wenn cmd == 0xFFFFFFFF:
            gib_zurück falsch
        ahci_px_setzen(port, 0x14, 0)
        ahci_px_setzen(port, 0x18, cmd & 0xFFFFFFFE)
        wenn nicht ahci_warte_register(port.registerbasis + 0x18, 0x8000, 0, port.hba.tsc * 500000):
            gib_zurück falsch
        ahci_px_setzen(port, 0x18, ahci_px(port, 0x18) & 0xFFFFFFEF)
        gib_zurück ahci_warte_register(port.registerbasis + 0x18, 0x4000, 0, port.hba.tsc * 500000)

@nativ
funktion ahci_physisch_da(port: ptr[AhciPort]) -> bool:
    unsicher:
        gib_zurück (ahci_px(port, 0x28) & 15) == 3

@nativ
funktion ahci_port_verbunden(port: ptr[AhciPort]) -> bool:
    unsicher:
        gib_zurück ahci_pci_da(port.hba) und ahci_physisch_da(port) und atom_laden(port.linkwechsel, ordnung=erwerben) == 0

# Dword 0 des Headers enthält CFL, W und PRDTL. CFIS ist immer 20 Byte.
# ATA FPDMA zählt in Features, DMA EXT zählt in Sector Count.
@nativ
funktion ahci_bauen(port: ptr[AhciPort], opcode: u8, lba: u64, anzahl: u64, bytes: u64, ncq: bool, schreiben: bool) -> void:
    unsicher:
        setze clb: u64 auf port.dma
        setze tabelle: u64 auf clb + 2 * 4096
        nt_null(clb, 32)
        nt_null(tabelle, 144)
        setze flaggen: u32 auf 5
        wenn schreiben:
            setze flaggen auf flaggen | 0x40
        wenn bytes != 0:
            setze flaggen auf flaggen | 0x10000
            speicher_schreiben(tabelle + 128, clb + 3 * 4096, 8)
            speicher_schreiben(tabelle + 140, als(u32, bytes - 1), 4)
        speicher_schreiben(clb, flaggen, 4)
        speicher_schreiben(clb + 8, tabelle, 8)
        speicher_schreiben(tabelle, 0x8027, 2)
        speicher_schreiben(tabelle + 2, opcode, 1)
        wenn anzahl != 0:
            speicher_schreiben(tabelle + 4, als(u32, (lba & 0xFFFFFF) | 0x40000000), 4)
            speicher_schreiben(tabelle + 8, als(u32, lba >> 24), 4)
            wenn ncq:
                speicher_schreiben(tabelle + 3, als(u8, anzahl & 255), 1)
                speicher_schreiben(tabelle + 11, als(u8, (anzahl >> 8) & 255), 1)
            sonst:
                speicher_schreiben(tabelle + 12, als(u16, anzahl), 2)

@nativ
funktion ahci_fehler_protokoll(port: ptr[AhciPort]) -> void:
    unsicher:
        ahci_log(port.hba, adresse_von(AHCI_LOG_PXIS), u64(atom_laden(port.pxis, ordnung=erwerben)))
        ahci_log(port.hba, adresse_von(AHCI_LOG_PXSERR), u64(atom_laden(port.pxserr, ordnung=erwerben)))

@nativ
funktion ahci_abschalten_fehler(port: ptr[AhciPort], code: u32) -> BlockFehler:
    unsicher:
        wenn port.registerbasis != 0 und ahci_pci_da(port.hba):
            ahci_port_ereignis(port)
        ahci_fehler_protokoll(port)
        setze status: u32 auf atom_laden(port.pxis, ordnung=erwerben)
        ahci_port_stoppen(port)
        gib_zurück BlockFehler(code, status)

# Erst nach einer gültigen Completion wird die DMA-Arena erneut verwendet.
# Bei Fehler oder Linkwechsel bleibt sie reserviert und der Port offline.
@nativ
funktion ahci_senden(port: ptr[AhciPort], opcode: u8, lba: u64, anzahl: u64, bytes: u64, ncq: bool, schreiben: bool) -> BlockFehler:
    unsicher:
        wenn nicht ahci_port_verbunden(port):
            gib_zurück ahci_abschalten_fehler(port, BLOCK_NICHT_BEREIT)
        wenn nicht ahci_warte_register(port.registerbasis + 0x20, 0x88, 0, port.hba.tsc * 1000000):
            gib_zurück ahci_abschalten_fehler(port, BLOCK_ZEIT)
        wenn (ahci_px(port, 0x38) | ahci_px(port, 0x34)) != 0:
            gib_zurück ahci_abschalten_fehler(port, BLOCK_EA)
        atom_speichern(port.pxis, 0, ordnung=locker)
        atom_speichern(port.pxserr, 0, ordnung=locker)
        ahci_bauen(port, opcode, lba, anzahl, bytes, ncq, schreiben)
        ahci_log(port.hba, adresse_von(AHCI_LOG_OPCODE), u64(opcode))
        setze irq_vorher: u64 auf atom_laden(port.irq_anzahl, ordnung=erwerben)
        wenn ncq:
            ahci_px_setzen(port, 0x34, 1)
        nt_mmio_glocke32(port.registerbasis + 0x38, 1)
        setze start: u64 auf takt()
        solange takt() - start < port.hba.tsc * 2000000:
            wenn port.hba.vektor == 0:
                ahci_port_ereignis(port)
            wenn nicht ahci_physisch_da(port) oder atom_laden(port.linkwechsel, ordnung=erwerben) != 0:
                gib_zurück ahci_abschalten_fehler(port, BLOCK_NICHT_BEREIT)
            setze status: u32 auf atom_laden(port.pxis, ordnung=erwerben) | ahci_px(port, 0x10)
            wenn (status & AHCI_PXIS_FEHLER) != 0 oder (ahci_px(port, 0x20) & 1) != 0:
                gib_zurück ahci_abschalten_fehler(port, BLOCK_EA)
            setze aktiv: u32 auf ahci_px(port, 0x38) | ahci_px(port, 0x34)
            wenn (aktiv & 1) == 0 und (port.hba.vektor == 0 oder atom_laden(port.irq_anzahl, ordnung=erwerben) != irq_vorher):
                lesebarriere()
                gib_zurück BlockFehler(BLOCK_OK, 0)
            kern_pause()
        gib_zurück ahci_abschalten_fehler(port, BLOCK_ZEIT)

@nativ
funktion ahci_auftrag(port: ptr[AhciPort], anfrage: ptr[BlockAnfrage]) -> BlockFehler:
    unsicher:
        wenn nicht port.bereit:
            gib_zurück BlockFehler(BLOCK_NICHT_BEREIT, 0)
        wenn nicht ahci_port_verbunden(port):
            gib_zurück ahci_abschalten_fehler(port, BLOCK_NICHT_BEREIT)
        wenn anfrage.art == BLOCK_VERWERFEN:
            gib_zurück BlockFehler(BLOCK_UNBEKANNT, 0)
        wenn anfrage.art == BLOCK_FLUSH:
            wenn port.groesse.nur_lesend:
                gib_zurück BlockFehler(BLOCK_OK, 0)
            wenn nicht port.flush_ext:
                gib_zurück BlockFehler(BLOCK_UNBEKANNT, 0xEA)
            gib_zurück ahci_senden(port, 0xEA, 0, 0, 0, falsch, falsch)
        wenn anfrage.art == BLOCK_SCHREIBEN_FUA und nicht port.flush_ext:
            gib_zurück BlockFehler(BLOCK_UNBEKANNT, 0xEA)
        setze schreiben: bool auf anfrage.art == BLOCK_SCHREIBEN oder anfrage.art == BLOCK_SCHREIBEN_FUA
        setze opcode: u8 auf 0x25
        wenn port.ncq:
            setze opcode auf 0x60
        wenn schreiben:
            setze opcode auf 0x35
            wenn port.ncq:
                setze opcode auf 0x61
        setze limit: u64 auf AHCI_BOUNCE_BYTES / port.groesse.block_bytes
        setze erledigt: u64 auf 0
        setze bounce: u64 auf port.dma + 3 * 4096
        solange erledigt < anfrage.anzahl:
            setze anzahl: u64 auf anfrage.anzahl - erledigt
            wenn anzahl > limit:
                setze anzahl auf limit
            setze bytes: u64 auf anzahl * port.groesse.block_bytes
            setze puffer: u64 auf anfrage.puffer + erledigt * port.groesse.block_bytes
            wenn schreiben:
                nt_kopiere(bounce, puffer, bytes)
            setze f: BlockFehler auf ahci_senden(port, opcode, anfrage.lba + erledigt, anzahl, bytes, port.ncq, schreiben)
            wenn f.code != BLOCK_OK:
                gib_zurück f
            wenn nicht schreiben:
                nt_kopiere(puffer, bounce, bytes)
            setze erledigt auf erledigt + anzahl
        wenn anfrage.art == BLOCK_SCHREIBEN_FUA:
            gib_zurück ahci_senden(port, 0xEA, 0, 0, 0, falsch, falsch)
        gib_zurück BlockFehler(BLOCK_OK, 0)

# ATA Identify: Seriennummer Wort 10..19, ASCII-Bytes je Wort vertauscht.
# Linux v6.12 include/linux/ata.h ATA_ID_* und ata_id_logical_sector_size.
@nativ
funktion ahci_identitaet(port: ptr[AhciPort], ziel: ptr[AhciPortZiel]) -> bool:
    unsicher:
        setze daten: u64 auf port.dma + 3 * 4096
        setze f: BlockFehler auf ahci_senden(port, 0xEC, 0, 0, 512, falsch, falsch)
        wenn f.code != BLOCK_OK:
            gib_zurück falsch
        setze i: u64 auf 0
        solange i < 20:
            wenn speicher_lesen(daten + 20 + (i ^ 1), 1) != speicher_lesen(ziel.serie + i, 1):
                gib_zurück falsch
            setze i auf i + 1
        setze cs: u64 auf u64(speicher_lesen(daten + 166, 2))
        setze bloecke: u64 auf speicher_lesen(daten + 200, 8)
        wenn (cs & 0xC400) != 0x4400 oder bloecke == 0 oder bloecke > 0x1000000000000:
            gib_zurück falsch
        setze block_bytes: u64 auf 512
        wenn (u64(speicher_lesen(daten + 212, 2)) & 0xD000) == 0x5000:
            setze block_bytes auf u64(speicher_lesen(daten + 234, 4)) * 2
        wenn block_bytes < 512 oder block_bytes > 4096 oder (block_bytes & (block_bytes - 1)) != 0:
            gib_zurück falsch
        setze sata: u64 auf u64(speicher_lesen(daten + 152, 2))
        setze port.ncq auf ziel.ncq_erlaubt und (port.hba.cap & 0x40000000) != 0 und sata != 0xFFFF und (sata & 0x100) != 0
        setze port.flush_ext auf (cs & 0x2000) != 0
        setze port.groesse auf BlockGeometrie(bloecke, block_bytes, nicht ziel.schreibbar)
        gib_zurück wahr

# Nur SATA-Signatur 0x00000101. ATAPI/Port-Multiplikatoren separat behandeln.
@nativ
funktion ahci_port_einrichten(hba: ptr[AhciHba], ziel: ptr[AhciPortZiel]) -> ergebnis[u64, BlockFehler]:
    unsicher:
        wenn ziel.nummer >= 32 oder ziel.serie == 0 oder ziel.dma == 0 oder (ziel.dma & 4095) != 0 oder ziel.dma > 0xFFF00000:
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 1))
        wenn (hba.pi & (u32(1) << ziel.nummer)) == 0 oder nicht ahci_pci_da(hba):
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 2))
        setze port: ptr[AhciPort] auf ahci_port_ort(hba, ziel.nummer)
        wenn port.dma != 0 oder nicht ahci_port_stoppen(port):
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 3))
        setze cmd: u32 auf ahci_px(port, 0x18) & 0x0FFFFFFF
        wenn (hba.cap & 0x08000000) != 0:
            setze cmd auf cmd | 2
        ahci_px_setzen(port, 0x18, cmd | 0x10000000)
        wenn nicht ahci_warte_register(port.registerbasis + 0x28, 15, 3, hba.tsc * 1000000):
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 4))
        setze port.dma auf ziel.dma
        nt_null(port.dma, AHCI_DMA_SEITEN * 4096)
        ahci_px_setzen(port, 0, als(u32, port.dma))
        ahci_px_setzen(port, 4, 0)
        ahci_px_setzen(port, 8, als(u32, port.dma + 4096))
        ahci_px_setzen(port, 12, 0)
        ahci_px_setzen(port, 0x18, ahci_px(port, 0x18) | 0x10)
        ahci_px_setzen(port, 0x18, ahci_px(port, 0x18) | 1)
        # PxSIG kommt mit der initialen D2H Register-FIS.
        setze start: u64 auf takt()
        solange ahci_px(port, 0x24) == 0xFFFFFFFF und takt() - start < hba.tsc * 500000:
            kern_pause()
        wenn ahci_px(port, 0x24) != 0x00000101:
            ahci_port_stoppen(port)
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 6))
        ahci_px_setzen(port, 0x10, ahci_px(port, 0x10))
        ahci_px_setzen(port, 0x30, ahci_px(port, 0x30))
        nt_mmio_schreibe32(hba.registerbasis + 8, u32(1) << ziel.nummer)
        atom_speichern(port.linkwechsel, 0, ordnung=freigeben)
        wenn hba.vektor != 0:
            ahci_px_setzen(port, 0x14, AHCI_PXIE_MASKE)
        wenn nicht ahci_identitaet(port, ziel):
            ahci_port_stoppen(port)
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 5))
        ahci_log(hba, adresse_von(AHCI_LOG_PORT), ziel.nummer)
        ahci_log(hba, adresse_von(AHCI_LOG_NCQ), u64(port.ncq))
        setze port.bereit auf wahr
        setze registriert: ergebnis[u64, BlockFehler] auf block_registrieren(port)
        wenn nicht ist_erfolg(registriert):
            ahci_port_stoppen(port)
        gib_zurück registriert

# HBA-Reset nur für den ausdrücklich aufgebundenen Controller.
@nativ
funktion ahci_hba_einrichten(hba: ptr[AhciHba], ziel: ptr[AhciHbaZiel], tsc: u64, bi: u64, map: u64, log: u64) -> ergebnis[void, BlockFehler]:
    unsicher:
        setze pci: u64 auf adresse_von(AHCI_PCI)
        setze bdf: u64 auf ziel.bdf
        wenn tsc == 0 oder tsc > 1000000 oder ziel.pci_id == 0 oder (ziel.pci_id & 0xFFFF) == 0xFFFF oder bdf > 0xFFFF oder map == 0 oder ziel.abar_bytes < 0x180:
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 0x10))
        wenn pci_lese32(pci, bdf, 0) != ziel.pci_id oder (pci_lese32(pci, bdf, 8) >> 8) != 0x010601:
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 0x11))
        setze phys: u64 auf nt_bar_slot(pci, bdf, 5)
        wenn phys == 0:
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 0x12))
        setze map_fn: ptr[fn[sysv64](u64, u64, u64) -> u64] auf zeiger(map)
        setze mmio: u64 auf map_fn(bi, phys, ziel.abar_bytes)
        wenn mmio == 0:
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 0x13))
        setze hba.registerbasis auf mmio
        setze hba.tsc auf tsc
        setze hba.log auf log
        setze hba.bdf auf bdf
        setze hba.pci_id auf ziel.pci_id
        setze hba.pci_cmd auf pci_lese32(pci, bdf, 4) & 0xFFFF
        pci_schreibe32(pci, bdf, 4, (hba.pci_cmd | 0x402) & 0xFFFB)
        # AHCI 1.2+ CAP2.BOH: OS-owned setzen, BOS und BIOS-busy abwarten.
        wenn nt_mmio_lese32(mmio + 0x10) >= 0x00010200 und (nt_mmio_lese32(mmio + 0x24) & 1) != 0:
            nt_mmio_schreibe32(mmio + 0x28, nt_mmio_lese32(mmio + 0x28) | 2)
            wenn nicht ahci_warte_register(mmio + 0x28, 0x11, 0, tsc * 2000000):
                gib_zurück fehlschlag(BlockFehler(BLOCK_ZEIT, 0x14))
        nt_mmio_schreibe32(mmio + 4, 0x80000000)
        nt_mmio_glocke32(mmio + 4, 0x80000001)
        wenn nicht ahci_warte_register(mmio + 4, 1, 0, tsc * 1000000):
            gib_zurück fehlschlag(BlockFehler(BLOCK_ZEIT, 0x15))
        nt_mmio_schreibe32(mmio + 4, 0x80000000)
        setze hba.cap auf nt_mmio_lese32(mmio)
        setze hba.pi auf nt_mmio_lese32(mmio + 12)
        wenn hba.pi == 0 oder hba.pi == 0xFFFFFFFF oder (nt_mmio_lese32(mmio + 4) & 0x80000000) == 0:
            gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 0x16))
        setze nr: u64 auf 0
        solange nr < 32:
            wenn (hba.pi & (u32(1) << nr)) != 0:
                setze basis: u64 auf 0x100 + nr * 0x80
                wenn basis + 0x80 > ziel.abar_bytes:
                    gib_zurück fehlschlag(BlockFehler(BLOCK_NICHT_BEREIT, 0x17))
                setze port: ptr[AhciPort] auf ahci_port_ort(hba, nr)
                setze port.hba auf hba
                setze port.registerbasis auf mmio + basis
                ahci_px_setzen(port, 0x14, 0)
            setze nr auf nr + 1
        nt_mmio_schreibe32(mmio + 8, nt_mmio_lese32(mmio + 8))
        setze hba.vektor auf kern_irq_msi(pci, bdf, ziel.apic_id, adresse_von(ahci_irq), u64(hba))
        wenn hba.vektor != 0:
            nt_mmio_schreibe32(mmio + 4, 0x80000002)
        pci_schreibe32(pci, bdf, 4, hba.pci_cmd | 0x406)
        ahci_log(hba, adresse_von(AHCI_LOG_RESET), 1)
        ahci_log(hba, adresse_von(AHCI_LOG_PI), u64(hba.pi))
        ahci_log(hba, adresse_von(AHCI_LOG_MSI), hba.vektor)
        gib_zurück erfolg()

# Nach exklusivem Ablaufstopp, etwa vor PCIe-Slotentnahme.
@nativ
funktion ahci_hba_stoppen(hba: ptr[AhciHba]) -> bool:
    unsicher:
        wenn nicht ahci_pci_da(hba):
            gib_zurück falsch
        nt_mmio_schreibe32(hba.registerbasis + 4, 0x80000000)
        wenn hba.vektor != 0:
            kern_irq_stoppen(hba.vektor)
            setze hba.vektor auf 0
        setze ok: bool auf wahr
        setze nr: u64 auf 0
        solange nr < 32:
            wenn (hba.pi & (u32(1) << nr)) != 0:
                setze port: ptr[AhciPort] auf ahci_port_ort(hba, nr)
                wenn port.dma != 0 und nicht ahci_port_stoppen(port):
                    setze ok auf falsch
            setze nr auf nr + 1
        pci_schreibe32(adresse_von(AHCI_PCI), hba.bdf, 4, (hba.pci_cmd | 0x402) & 0xFFFB)
        gib_zurück ok und (pci_lese32(adresse_von(AHCI_PCI), hba.bdf, 4) & 4) == 0
