# ============================================================
# ki_multimodal_farbe.moos — KI-MULTI-V3 Farb-Level 2 (Design §5)
#
# Farbige Form -> RGBA-Frame -> Drei-Kopf-Encoder -> Projektion
# -> Praefix-Slot im Mini-LLM -> Caption "rotes quadrat unten rechts".
# Design: docs/kip/V3-multimodal-fusion.md (§4 Stufen, §5 Farb-Level).
# Muster: beispiele/ki_multimodal_audio.moos (V3b-Loesung uebernommen:
#   Drei-Kopf-Encoder + HARTE Subraum-Injektion via 0/1-matmul,
#   Anker-Regression Stufe A, Lehr-Slots in disjunkten Subraeumen).
#
# Faktoren (3): FARBE (rotes|gruenes|blaues|gelbes) x FORM
#   (kreis|quadrat|dreieck) x ORT (4 Quadranten) = 48 Klassen.
# Drei Encoder-Koepfe -> DISJUNKTE Subraeume (Kompositions-Fix):
#   FORM-Kopf  Conv-Stack + globales Max-Pool (translations-/farbinv.)  dims 0..11
#   ORT-Kopf   flacher Conv + grobes 4x4-Grid (Position)               dims 12..21
#   FARBE-Kopf globales Max je Kanal (orts-/form-/flaecheninvariant)    dims 22..31
# ABWEICHUNG vom Auftrag (dort "MITTEL-Pooling" angeregt): FARBE nutzt globales
#   MAX je Kanal (zwei Max-Pool-Stufen 8x8 dann 4x4). Grund: Max ist
#   flaecheninvariant -> robuste Anker-Regression trotz Groessen-Jitter
#   (Mittel skaliert mit der Form-Flaeche und bricht die Invarianz).
# Stufen: A  Encoder Anker-Regression (kompositionale Anker farbe+form+ort)
#         B0 Mini-LLM KONDITIONAL vortrainieren: Lehr-Slots in 3 disjunkten
#            Subraeumen + Rauschen (V3a/V3b-Learnings)
#         B  NUR die Projektion trainieren (CE + MSE-Anker, LR 0.02)
# Gates:  A   Retrieval accuracy@1 >= 0.95 (frische Jitter, 48-Wege)
#         1a  Caption-Accuracy >= 0.9 auf Jitter-Holdout (Greedy, exakt)
#         1b  Caption-Accuracy >= 0.9 auf Kombi-Holdout (16 Samples,
#             ungesehene Farbe-Form-Ort-Kombis — beweist Komposition)
#         2   FD-Gradcheck der Projektion (4 Koordinaten)
#         3   Checkpoint-Roundtrip: Save -> Load -> Loss bit-identisch
#
# Headless: xvfb-run -a stdbuf -o0 ./ki_multimodal_farbe
# Endet mit SELFTEST_RESULT: PASS/FAIL. Deterministisch (feste Seeds).
# ============================================================

konstante BILD auf 32
konstante DIM_ENC auf 32
konstante DIM auf 48
konstante KOEPFE auf 4
konstante T_TEXT auf 30
konstante JITTER_TRAIN auf 6
konstante JITTER_TEST auf 2
konstante JITTER_COMBO auf 4
konstante EPS_FD auf 0.02

setze FARBEN auf ["rotes", "gruenes", "blaues", "gelbes"]
setze FORMEN auf ["kreis", "quadrat", "dreieck"]
setze ORTE auf ["oben links", "oben rechts", "unten links", "unten rechts"]
setze FARB_HEX auf ["#FF4040", "#40C040", "#4060FF", "#FFD040"]

# Kombi-Holdout: diese 4 (farbe, form, ort)-Kombis kommen NIE ins Training.
# Jeder Einzelfaktor bleibt anderweitig im Training -> Komposition beweisbar.
# rotes+quadrat+unten rechts | gruenes+kreis+oben links |
# blaues+dreieck+oben rechts | gelbes+quadrat+unten links.
funktion ist_holdout(f, s, o):
    wenn f == 0 und s == 1 und o == 3:
        gib_zurück wahr
    wenn f == 1 und s == 0 und o == 0:
        gib_zurück wahr
    wenn f == 2 und s == 2 und o == 1:
        gib_zurück wahr
    wenn f == 3 und s == 1 und o == 2:
        gib_zurück wahr
    gib_zurück falsch

# ------------------------------------------------------------
# 0. Zustand: LCG + alle Schichten in einem Dict (M)
# ------------------------------------------------------------
setze G auf {}
G["rng"] = 7
funktion rng():
    G["rng"] = (G["rng"] * 75 + 74) % 65537
    gib_zurück G["rng"]

setze M auf {}

# ------------------------------------------------------------
# 1. Toy-Szenen rendern: farbige Form in Quadrant mit Jitter, 32x32 RGBA
# ------------------------------------------------------------
setze win auf fenster_erstelle("v3 farbe", BILD, BILD)

funktion zeichne_form(s, cx, cy, r, farbe):
    wenn s == 0:
        zeichne_kreis(win, cx, cy, r, farbe)
    sonst wenn s == 1:
        zeichne_rechteck(win, cx - r, cy - r, 2 * r, 2 * r, farbe)
    sonst:
        # Dreieck aus horizontalen Balken (kein Dreieck-Builtin noetig)
        setze zeile auf 0
        solange zeile < 2 * r:
            setze halb auf boden(zeile / 2)
            zeichne_rechteck(win, cx - halb, cy - r + zeile, 2 * halb + 1, 1, farbe)
            setze zeile auf zeile + 1

# Rendert ein Sample und liefert die flache RGBA-Pixelliste (32*32*4 = 4096).
# tensor_aus_frame(fr) OHNE Modus -> [32,32,4] (Modus "rgba" wuerde werfen;
# Runtime kennt nur "grau"/NONE, verifiziert in moo_frame_tensor.c).
funktion sample_pixel(f, s, o):
    setze qx auf 8
    wenn o == 1 oder o == 3:
        setze qx auf 24
    setze qy auf 8
    wenn o == 2 oder o == 3:
        setze qy auf 24
    setze jx auf rng() % 5 - 2
    setze jy auf rng() % 5 - 2
    setze r auf 6 + rng() % 3
    fenster_löschen(win, "#101018")
    zeichne_form(s, qx + jx, qy + jy, r, FARB_HEX[f])
    setze fr auf test_frame_grab(win)
    setze t auf tensor_aus_frame(fr)
    gib_zurück t.zu_liste()

# ------------------------------------------------------------
# 2. Captions + Zeichen-Vokabular
# ------------------------------------------------------------
# Genus einheitlich -es (Toy-Label, Konsistenz vor Grammatik).
funktion caption(f, s, o):
    setze c auf FARBEN[f] + " " + FORMEN[s] + " " + ORTE[o]
    solange länge(c) < T_TEXT:
        setze c auf c + "."
    gib_zurück c

setze korpus auf "."
setze f auf 0
solange f < 4:
    setze s auf 0
    solange s < 3:
        setze o auf 0
        solange o < 4:
            setze korpus auf korpus + caption(f, s, o)
            setze o auf o + 1
        setze s auf s + 1
    setze f auf f + 1
setze tok auf text_tokenizer(korpus)
setze vokab auf tok["vokab"]
setze id_zu_zeichen auf tok["id_zu_zeichen"]
setze z2i auf {}
setze k auf 0
solange k < vokab:
    z2i[id_zu_zeichen[k]] = k
    setze k auf k + 1

# knr = f*12 + s*4 + o; Rueckweg:
funktion knr_f(knr):
    gib_zurück boden(knr / 12)
funktion knr_s(knr):
    gib_zurück boden((knr % 12) / 4)
funktion knr_o(knr):
    gib_zurück knr % 4

funktion caption_ids(knr):
    setze c auf caption(knr_f(knr), knr_s(knr), knr_o(knr))
    setze ids auf []
    setze i auf 0
    solange i < T_TEXT:
        ids.hinzufügen(z2i[c[i]])
        setze i auf i + 1
    gib_zurück ids

funktion ids_gleich(a, bb):
    wenn länge(a) != länge(bb):
        gib_zurück falsch
    setze i auf 0
    solange i < länge(a):
        wenn a[i] != bb[i]:
            gib_zurück falsch
        setze i auf i + 1
    gib_zurück wahr

funktion ids_zu_text(ids):
    setze t auf ""
    setze i auf 0
    solange i < länge(ids):
        setze t auf t + id_zu_zeichen[ids[i]]
        setze i auf i + 1
    gib_zurück t

# ------------------------------------------------------------
# 3. Datensatz erzeugen (deterministisch) + Pruefwert-Log
# ------------------------------------------------------------
zeige "Erzeuge Farb-Toy-Datensatz ..."
setze train_px auf []
setze train_kl auf []
setze jit_px auf []
setze jit_kl auf []
setze combo_px auf []
setze combo_kl auf []
setze pruef auf 0
setze f auf 0
solange f < 4:
    setze s auf 0
    solange s < 3:
        setze o auf 0
        solange o < 4:
            setze knr auf f * 12 + s * 4 + o
            wenn ist_holdout(f, s, o):
                setze j auf 0
                solange j < JITTER_COMBO:
                    setze p auf sample_pixel(f, s, o)
                    combo_px.hinzufügen(p)
                    combo_kl.hinzufügen(knr)
                    setze pruef auf (pruef + p[rng() % 4096] * 1000 + knr) % 987654321
                    setze j auf j + 1
            sonst:
                setze j auf 0
                solange j < JITTER_TRAIN:
                    setze p auf sample_pixel(f, s, o)
                    train_px.hinzufügen(p)
                    train_kl.hinzufügen(knr)
                    setze pruef auf (pruef + p[rng() % 4096] * 1000 + knr) % 987654321
                    setze j auf j + 1
                setze j auf 0
                solange j < JITTER_TEST:
                    setze p auf sample_pixel(f, s, o)
                    jit_px.hinzufügen(p)
                    jit_kl.hinzufügen(knr)
                    setze pruef auf (pruef + p[rng() % 4096] * 1000 + knr) % 987654321
                    setze j auf j + 1
            setze o auf o + 1
        setze s auf s + 1
    setze f auf f + 1
zeige "V3-FARBE-DATEN train=" + text(länge(train_px)) + " jitter-holdout=" + text(länge(jit_px)) + " kombi-holdout=" + text(länge(combo_px)) + " pruefwert=" + text(pruef)

# ------------------------------------------------------------
# 4. Schichten (alle Seeds fest) — Drei-Kopf-Encoder
# ------------------------------------------------------------
# FORM-Kopf: Conv-Stack + globales Max-Pool (translations- und farbinvariant)
M["f1"] = schicht_faltung(4, 8, 3, 1, 1, "relu", 21)
M["p1"] = schicht_pooling("max", 2, 2)
M["f2"] = schicht_faltung(8, 16, 3, 1, 1, "relu", 22)
M["p2"] = schicht_pooling("max", 2, 2)
M["pg"] = schicht_pooling("max", 8, 8)
M["fl"] = schicht_flach()
M["ed"] = schicht_dicht(16, 12, "tanh", 23)
# ORT-Kopf: flacher Conv, frueh grob 4x4-gepoolt (Position, kaum Form/Farbe)
M["f1o"] = schicht_faltung(4, 4, 3, 1, 1, "relu", 26)
M["p1o"] = schicht_pooling("mittel", 2, 2)
M["po"] = schicht_pooling("mittel", 4, 4)
M["flo"] = schicht_flach()
M["edo"] = schicht_dicht(4 * 4 * 4, 10, "tanh", 27)
# FARBE-Kopf: globales Max je Kanal (8x8 dann 4x4) -> reine Kanal-Statistik
M["fc1"] = schicht_pooling("max", 8, 8)
M["fc2"] = schicht_pooling("max", 4, 4)
M["flc"] = schicht_flach()
M["edc"] = schicht_dicht(4, 10, "tanh", 28)
# Mini-LLM
M["emb"] = schicht_embedding(vokab, DIM, 31)
M["pos"] = schicht_position(1 + T_TEXT, DIM, "gelernt", 32)
M["ln1"] = schicht_layernorm(DIM)
M["att"] = schicht_attention(DIM, KOEPFE, 33)
M["ln2"] = schicht_layernorm(DIM)
M["ff1"] = schicht_dicht(DIM, 128, "gelu", 34)
M["ff2"] = schicht_dicht(128, DIM, "keine", 35)
M["lnf"] = schicht_layernorm(DIM)
M["kopf"] = schicht_dicht(DIM, vokab, "keine", 36)
M["proj"] = schicht_dicht(DIM_ENC, DIM, "keine", 41)

funktion enc_schichten():
    gib_zurück [M["f1"], M["p1"], M["f2"], M["p2"], M["pg"], M["fl"], M["ed"], M["f1o"], M["p1o"], M["po"], M["flo"], M["edo"], M["fc1"], M["fc2"], M["flc"], M["edc"]]
funktion form_schichten():
    gib_zurück [M["f1"], M["p1"], M["f2"], M["p2"], M["pg"], M["fl"], M["ed"]]
funktion ort_schichten():
    gib_zurück [M["f1o"], M["p1o"], M["po"], M["flo"], M["edo"]]
funktion farbe_schichten():
    gib_zurück [M["fc1"], M["fc2"], M["flc"], M["edc"]]
funktion llm_schichten():
    gib_zurück [M["emb"], M["pos"], M["ln1"], M["att"], M["ln2"], M["ff1"], M["ff2"], M["lnf"], M["kopf"]]

# Konstante 0/1-Subraum-Injektionen: form dims 0..11, ort 12..21, farbe 22..31
autograd_aus()
setze EF auf tensor_nullen([12, DIM_ENC])
setze i auf 0
solange i < 12:
    EF.wert_setzen([i, i], 1)
    setze i auf i + 1
setze EO auf tensor_nullen([10, DIM_ENC])
setze i auf 0
solange i < 10:
    EO.wert_setzen([i, 12 + i], 1)
    setze i auf i + 1
setze EC auf tensor_nullen([10, DIM_ENC])
setze i auf 0
solange i < 10:
    EC.wert_setzen([i, 22 + i], 1)
    setze i auf i + 1
autograd_an()

funktion encoder_batch(merkmal_listen):
    setze x auf tensor_aus_liste(merkmal_listen)
    setze x auf x.umformen([länge(merkmal_listen), BILD, BILD, 4])
    # Drei Koepfe schreiben via Injektions-matmul in DISJUNKTE Subraeume —
    # erzwingt getrennte Faktor-Repraesentation (Kompositions-Fix, V3b-Muster)
    gib_zurück vorwaerts(form_schichten(), x).matmul(EF) + vorwaerts(ort_schichten(), x).matmul(EO) + vorwaerts(farbe_schichten(), x).matmul(EC)

funktion llm_kern(x):
    setze x auf vorwaerts([M["pos"]], x)
    setze x auf x + vorwaerts([M["ln1"], M["att"]], x)
    setze x auf x + vorwaerts([M["ln2"], M["ff1"], M["ff2"]], x)
    gib_zurück vorwaerts([M["lnf"], M["kopf"]], x)

# Praefix-Injection (Design §3.3): x = verketten(e_inj, emb(text))
funktion mm_logits(e_inj, ids):
    setze x auf e_inj
    wenn länge(ids) > 0:
        setze e_txt auf vorwaerts([M["emb"]], tensor_aus_liste(ids))
        setze x auf e_inj.verketten(e_txt)
    gib_zurück llm_kern(x)

funktion seq_loss(e_inj, ids):
    setze logits auf mm_logits(e_inj, ids)
    setze ziele auf []
    setze maske auf []
    setze i auf 0
    solange i < länge(ids):
        ziele.hinzufügen(ids[i])
        maske.hinzufügen(1)
        setze i auf i + 1
    ziele.hinzufügen(0)
    maske.hinzufügen(0)
    gib_zurück kreuzentropie(logits, tensor_aus_liste(ziele), tensor_aus_liste(maske))

funktion argmax(liste):
    setze best auf 0
    setze i auf 1
    solange i < länge(liste):
        wenn liste[i] > liste[best]:
            setze best auf i
        setze i auf i + 1
    gib_zurück best

funktion grads_loeschen(params):
    für p in params:
        p.gradient_loeschen()

# ------------------------------------------------------------
# 5. STUFE A: Encoder Anker-Regression (kompositionale Anker, 3 Faktoren)
# ------------------------------------------------------------
zeige "Stufe A: Encoder Anker-Regression (600 Schritte) ..."
# Anker leben in DENSELBEN disjunkten Subraeumen wie die Encoder-Koepfe.
# Skala 0.7: sicher im tanh-Wertebereich (Stufe A = Anker-Regression).
autograd_aus()
setze form_proto auf tensor_nullen([3, DIM_ENC])
setze fpz auf tensor_zufall([3, DIM_ENC], 55)
setze i auf 0
solange i < 3:
    setze j auf 0
    solange j < 12:
        form_proto.wert_setzen([i, j], fpz.wert([i, j]) * 0.7)
        setze j auf j + 1
    setze i auf i + 1
setze ort_proto auf tensor_nullen([4, DIM_ENC])
setze opz auf tensor_zufall([4, DIM_ENC], 56)
setze i auf 0
solange i < 4:
    setze j auf 12
    solange j < 22:
        ort_proto.wert_setzen([i, j], opz.wert([i, j]) * 0.7)
        setze j auf j + 1
    setze i auf i + 1
setze farbe_proto auf tensor_nullen([4, DIM_ENC])
setze cpz auf tensor_zufall([4, DIM_ENC], 57)
setze i auf 0
solange i < 4:
    setze j auf 22
    solange j < 32:
        farbe_proto.wert_setzen([i, j], cpz.wert([i, j]) * 0.7)
        setze j auf j + 1
    setze i auf i + 1
autograd_an()

funktion proto_zeile(knr):
    gib_zurück form_proto.zeilen(knr_s(knr), knr_s(knr) + 1) + ort_proto.zeilen(knr_o(knr), knr_o(knr) + 1) + farbe_proto.zeilen(knr_f(knr), knr_f(knr) + 1)

funktion proto_stapel(klassen):
    setze p auf proto_zeile(klassen[0])
    setze i auf 1
    solange i < länge(klassen):
        setze p auf p.verketten(proto_zeile(klassen[i]))
        setze i auf i + 1
    gib_zurück p

setze params_enc auf parameter(enc_schichten())
setze opt_a auf optimierer_sgd(params_enc, 0.05, 0.9)
setze s auf 0
solange s < 600:
    setze bx auf []
    setze bk auf []
    setze i auf 0
    solange i < 44:
        setze idx auf i * JITTER_TRAIN + s % JITTER_TRAIN
        bx.hinzufügen(train_px[idx])
        bk.hinzufügen(train_kl[idx])
        setze i auf i + 1
    setze enc auf encoder_batch(bx)
    # Anker-Regression: Subraeume disjunkt -> EIN MSE ueber den vollen Vektor,
    # Normierung NUR ueber die Batchgroesse (V3b-Learning: /dim macht Grad ~32x zu klein)
    setze dva auf enc - proto_stapel(bk)
    setze v auf (dva * dva).summe() * (1.0 / 44)
    v.rueckwaerts()
    gradienten_kappen(params_enc, 1.0)
    opt_a.schritt()
    wenn s % 150 == 149:
        zeige "  A s=" + text(s) + " loss=" + text(v.zu_liste()[0])
    setze s auf s + 1

# GATE A: Retrieval accuracy@1 auf den Jitter-Holdout-Bildern (48-Wege)
autograd_aus()
setze enc_jit auf encoder_batch(jit_px)
setze treffer auf 0
setze i auf 0
solange i < länge(jit_px):
    setze zeile auf enc_jit.zeilen(i, i + 1)
    setze best auf 0 - 1
    setze best_w auf 0 - 1000000000
    setze kk auf 0
    solange kk < 48:
        setze w auf kosinus(zeile, proto_zeile(kk)).zu_liste()[0]
        wenn w > best_w:
            setze best_w auf w
            setze best auf kk
        setze kk auf kk + 1
    wenn best == jit_kl[i]:
        setze treffer auf treffer + 1
    sonst:
        zeige "  A-FEHLER i=" + text(i) + " soll=" + text(jit_kl[i]) + " ist=" + text(best) + " w=" + text(best_w)
    setze i auf i + 1
setze acc_a auf treffer / länge(jit_px)
autograd_an()
setze gate_a auf acc_a >= 0.95
zeige "V3-FARBE-GATE-A retrieval@1=" + text(acc_a) + " -> " + text(gate_a)

# DEBUG: Retrieval auf Kombi-Holdout — generalisiert der Encoder-Raum?
autograd_aus()
setze enc_c auf encoder_batch(combo_px)
setze ctreffer auf 0
setze i auf 0
solange i < länge(combo_px):
    setze zeile auf enc_c.zeilen(i, i + 1)
    setze best auf 0 - 1
    setze best_w auf 0 - 1000000000
    setze kk auf 0
    solange kk < 48:
        setze w auf kosinus(zeile, proto_zeile(kk)).zu_liste()[0]
        wenn w > best_w:
            setze best_w auf w
            setze best auf kk
        setze kk auf kk + 1
    wenn best == combo_kl[i]:
        setze ctreffer auf ctreffer + 1
    setze i auf i + 1
autograd_an()
zeige "  A-DEBUG combo-retrieval=" + text(ctreffer / länge(combo_px))

# Encoder ab jetzt FROZEN: Embeddings ohne Tape vorberechnen
autograd_aus()
setze e_train auf encoder_batch(train_px)
setze e_jit auf encoder_batch(jit_px)
setze e_combo auf encoder_batch(combo_px)
autograd_an()

# ------------------------------------------------------------
# 6. STUFE B0: Mini-LLM KONDITIONAL vortrainieren (Lehr-Slots,
#    3 disjunkte Subraeume + Rauschen — V3a/V3b-Learnings)
# ------------------------------------------------------------
zeige "Stufe B0: LLM-Vortraining mit Lehr-Slots (6000 Schritte) ..."
autograd_aus()
setze form_emb auf tensor_nullen([3, DIM])
setze bz auf tensor_zufall([3, DIM], 81)
setze i auf 0
solange i < 3:
    setze j auf 0
    solange j < 16:
        form_emb.wert_setzen([i, j], bz.wert([i, j]))
        setze j auf j + 1
    setze i auf i + 1
setze ort_emb auf tensor_nullen([4, DIM])
setze dz auf tensor_zufall([4, DIM], 82)
setze i auf 0
solange i < 4:
    setze j auf 16
    solange j < 32:
        ort_emb.wert_setzen([i, j], dz.wert([i, j]))
        setze j auf j + 1
    setze i auf i + 1
setze farbe_emb auf tensor_nullen([4, DIM])
setze mz auf tensor_zufall([4, DIM], 83)
setze i auf 0
solange i < 4:
    setze j auf 32
    solange j < 48:
        farbe_emb.wert_setzen([i, j], mz.wert([i, j]))
        setze j auf j + 1
    setze i auf i + 1
autograd_an()

funktion lehr_slot(knr):
    gib_zurück form_emb.zeilen(knr_s(knr), knr_s(knr) + 1) + ort_emb.zeilen(knr_o(knr), knr_o(knr) + 1) + farbe_emb.zeilen(knr_f(knr), knr_f(knr) + 1)

setze params_llm auf parameter(llm_schichten())
setze opt_b0 auf optimierer_sgd(params_llm, 0.05, 0.9)
setze s auf 0
solange s < 6000:
    wenn s == 2000:
        setze opt_b0 auf optimierer_sgd(params_llm, 0.015, 0.9)
    wenn s == 4000:
        setze opt_b0 auf optimierer_sgd(params_llm, 0.005, 0.9)
    setze idx auf s % länge(train_px)
    setze knr auf train_kl[idx]
    setze slot_j auf lehr_slot(knr) + tensor_zufall([1, DIM], 200 + s) * 0.03
    setze v auf seq_loss(slot_j, caption_ids(knr))
    v.rueckwaerts()
    gradienten_kappen(params_llm, 1.0)
    opt_b0.schritt()
    wenn s % 500 == 499:
        zeige "  B0 s=" + text(s) + " loss=" + text(v.zu_liste()[0])
    setze s auf s + 1
zeige "B0-Endverlust: " + text(seq_loss(lehr_slot(0), caption_ids(0)).zu_liste()[0])

# ------------------------------------------------------------
# 7. STUFE B: NUR die Projektion trainieren (CE + MSE-Anker)
# ------------------------------------------------------------
zeige "Stufe B: Projektion (6000 Schritte) ..."
setze params_proj auf parameter([M["proj"]])
setze opt_p auf optimierer_sgd(params_proj, 0.02, 0.9)
setze s auf 0
solange s < 6000:
    wenn s == 2000:
        setze opt_p auf optimierer_sgd(params_proj, 0.005, 0.9)
    wenn s == 4000:
        setze opt_p auf optimierer_sgd(params_proj, 0.002, 0.9)
    setze idx auf s % länge(train_px)
    setze knr auf train_kl[idx]
    setze e auf e_train.zeilen(idx, idx + 1)
    setze pe auf vorwaerts([M["proj"]], e)
    setze ce auf seq_loss(pe, caption_ids(knr))
    setze dv auf pe - lehr_slot(knr)
    setze v auf ce + (dv * dv).summe() * (1.0 / DIM)
    v.rueckwaerts()
    gradienten_kappen(params_proj, 1.0)
    opt_p.schritt()
    grads_loeschen(params_llm)
    wenn s % 600 == 599:
        zeige "  B s=" + text(s) + " loss=" + text(v.zu_liste()[0])
    setze s auf s + 1

# ------------------------------------------------------------
# 8. GATE 1: Greedy-Caption exakt (Jitter- und Kombi-Holdout)
# ------------------------------------------------------------
funktion greedy_slot(e_inj):
    setze ids auf []
    solange länge(ids) < T_TEXT:
        setze logits auf mm_logits(e_inj, ids)
        setze n auf länge(ids) + 1
        ids.hinzufügen(argmax(logits.zeilen(n - 1, n).zu_liste()))
    gib_zurück ids

funktion greedy_ids(e_konst):
    gib_zurück greedy_slot(vorwaerts([M["proj"]], e_konst))

funktion caption_acc(e_batch, klassen):
    setze ok auf 0
    setze i auf 0
    solange i < länge(klassen):
        setze knr auf klassen[i]
        setze soll auf caption_ids(knr)
        setze ist auf greedy_ids(e_batch.zeilen(i, i + 1))
        wenn ids_gleich(ist, soll):
            setze ok auf ok + 1
        sonst:
            zeige "  CAP-FEHLER ist='" + ids_zu_text(ist) + "' soll='" + ids_zu_text(soll) + "'"
        setze i auf i + 1
    gib_zurück ok / länge(klassen)

autograd_aus()
setze acc_jit auf caption_acc(e_jit, jit_kl)
setze acc_combo auf caption_acc(e_combo, combo_kl)
zeige "  B-DEBUG train0 ist='" + ids_zu_text(greedy_ids(e_train.zeilen(0, 1))) + "' soll='" + ids_zu_text(caption_ids(train_kl[0])) + "'"
zeige "  B-DEBUG combo0 ist='" + ids_zu_text(greedy_ids(e_combo.zeilen(0, 1))) + "' soll='" + ids_zu_text(caption_ids(combo_kl[0])) + "'"
zeige "  B-DEBUG lehrslot-combo ist='" + ids_zu_text(greedy_slot(lehr_slot(combo_kl[0]))) + "' (liest LLM ungesehene Slots?)"
autograd_an()
setze gate_1a auf acc_jit >= 0.9
setze gate_1b auf acc_combo >= 0.9
zeige "V3-FARBE-GATE-1A jitter-holdout-acc=" + text(acc_jit) + " -> " + text(gate_1a)
zeige "V3-FARBE-GATE-1B kombi-holdout-acc=" + text(acc_combo) + " -> " + text(gate_1b)

# ------------------------------------------------------------
# 9. GATE 2: FD-Gradcheck der Projektion (4 Koordinaten)
# ------------------------------------------------------------
setze e0 auf e_train.zeilen(0, 0 + 1)
setze ids0 auf caption_ids(train_kl[0])
grads_loeschen(params_proj)
grads_loeschen(params_llm)
setze v auf seq_loss(vorwaerts([M["proj"]], e0), ids0)
v.rueckwaerts()
setze pw auf params_proj[0]
setze g auf pw.gradient()
setze pform auf pw.form()
setze gate_2 auf wahr
autograd_aus()
setze t auf 0
solange t < 4:
    setze i auf rng() % pform[0]
    setze j auf rng() % pform[1]
    setze ana auf g.wert([i, j])
    setze w0 auf pw.wert([i, j])
    pw.wert_setzen([i, j], w0 + EPS_FD)
    setze lp auf seq_loss(vorwaerts([M["proj"]], e0), ids0).zu_liste()[0]
    pw.wert_setzen([i, j], w0 - EPS_FD)
    setze lm auf seq_loss(vorwaerts([M["proj"]], e0), ids0).zu_liste()[0]
    pw.wert_setzen([i, j], w0)
    setze fd auf (lp - lm) / (2 * EPS_FD)
    setze diff auf fd - ana
    wenn diff < 0:
        setze diff auf 0 - diff
    setze skala auf fd
    wenn skala < 0:
        setze skala auf 0 - skala
    setze askala auf ana
    wenn askala < 0:
        setze askala auf 0 - askala
    wenn diff > 0.05 * (skala + askala + 0.001):
        setze gate_2 auf falsch
        zeige "  FD-Abweichung [" + text(i) + "," + text(j) + "]: fd=" + text(fd) + " ana=" + text(ana)
    setze t auf t + 1
autograd_an()
grads_loeschen(params_proj)
grads_loeschen(params_llm)
zeige "V3-FARBE-GATE-2 fd-gradcheck -> " + text(gate_2)

# ------------------------------------------------------------
# 10. GATE 3: Checkpoint-Roundtrip bit-identisch
# ------------------------------------------------------------
setze cnetz auf ki_netz([M["f1"], M["p1"], M["f2"], M["p2"], M["pg"], M["fl"], M["ed"], M["f1o"], M["p1o"], M["po"], M["flo"], M["edo"], M["fc1"], M["fc2"], M["flc"], M["edc"], M["emb"], M["pos"], M["ln1"], M["att"], M["ln2"], M["ff1"], M["ff2"], M["lnf"], M["kopf"], M["proj"]])
autograd_aus()
# Batch-1-Forward wie nach dem Laden (Encoder-Forward ist batchgroessen-abhaengig)
setze e0_rt auf encoder_batch([train_px[0]])
setze loss_vor auf seq_loss(vorwaerts([M["proj"]], e0_rt), ids0).zu_liste()[0]
setze zustand auf {}
zustand["netz"] = cnetz
zustand["schritt"] = 1
checkpoint_speichern(zustand, "/tmp/v3farbe_ckpt.mook")
setze z2 auf checkpoint_laden("/tmp/v3farbe_ckpt.mook")
setze sch2 auf z2["netz"]["schichten"]
M["f1"] = sch2[0]
M["p1"] = sch2[1]
M["f2"] = sch2[2]
M["p2"] = sch2[3]
M["pg"] = sch2[4]
M["fl"] = sch2[5]
M["ed"] = sch2[6]
M["f1o"] = sch2[7]
M["p1o"] = sch2[8]
M["po"] = sch2[9]
M["flo"] = sch2[10]
M["edo"] = sch2[11]
M["fc1"] = sch2[12]
M["fc2"] = sch2[13]
M["flc"] = sch2[14]
M["edc"] = sch2[15]
M["emb"] = sch2[16]
M["pos"] = sch2[17]
M["ln1"] = sch2[18]
M["att"] = sch2[19]
M["ln2"] = sch2[20]
M["ff1"] = sch2[21]
M["ff2"] = sch2[22]
M["lnf"] = sch2[23]
M["kopf"] = sch2[24]
M["proj"] = sch2[25]
setze e0b auf encoder_batch([train_px[0]])
setze loss_nach auf seq_loss(vorwaerts([M["proj"]], e0b), ids0).zu_liste()[0]
autograd_an()
setze gate_3 auf loss_vor == loss_nach
zeige "V3-FARBE-GATE-3 roundtrip vor=" + text(loss_vor) + " nach=" + text(loss_nach) + " -> " + text(gate_3)

# ------------------------------------------------------------
# 11. SELFTEST
# ------------------------------------------------------------
wenn gate_a und gate_1a und gate_1b und gate_2 und gate_3:
    zeige "SELFTEST_RESULT: PASS ki_multimodal_farbe"
sonst:
    zeige "SELFTEST_RESULT: FAIL ki_multimodal_farbe"
