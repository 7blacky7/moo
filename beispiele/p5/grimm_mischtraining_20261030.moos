# P5: Echter SIL-14-Checkpoint; 2 kurze Korrekturschritte, separates Resume.
aus sft_adapter importiere korrektur_fenster_aufteilen
setze ausgabe auf umgebung("P5_TEST_DIR")
setze algo auf umgebung("P5_ALGO")
setze rate auf zahl(umgebung("P5_RATE"))
wenn ausgabe == nichts:
    wirf "P5_TEST_DIR fehlt"
setze tok auf silben_laden("beispiele/p4_silben/run_sil14_grimm36k/tokenizer.msf")
setze tokhash auf sha256(tok)
setze basis auf "beispiele/p4_silben/run_sil14_grimm36k/full.mook"
setze z auf nichts
versuche:
    setze z auf checkpoint_laden(basis, {"tokenizer_version": tokhash, "arch_version": "grimm-silben-250k-v1"})
fange lade_fehler:
    zeige "P5: checkpoint_laden fehlgeschlagen: " + lade_fehler
    beende(1)
setze schichten auf z["netz"]["schichten"]
setze limit auf schichten[1]["max"]
wenn länge(schichten) != 14 oder limit != 64:
    wirf "SIL-14 Architektur oder Positionslaenge ungueltig"
funktion encoder(textwert):
    gib_zurück silben_kodiere(tok, textwert)
funktion vorlauf(eingabe):
    setze x auf vorwaerts([schichten[0]], eingabe)
    setze x auf vorwaerts([schichten[1]], x)
    setze x auf x + vorwaerts([schichten[2], schichten[3]], x)
    setze x auf x + vorwaerts([schichten[4], schichten[5], schichten[6]], x)
    setze x auf x + vorwaerts([schichten[7], schichten[8]], x)
    setze x auf x + vorwaerts([schichten[9], schichten[10], schichten[11]], x)
    gib_zurück vorwaerts([schichten[12], schichten[13]], x)
setze pilot auf json_parse(datei_lesen("beispiele/p5/daten/pilot_lehrer_v2.json"))
# Diverse Korrekturen und Originaltext aus ausschliesslich dem Trainingssplit mischen.
setze normale_ids auf silben_kodiere(tok, datei_lesen("beispiele/p4_silben/run_sil14_grimm36k/train.txt")).zu_liste()
setze normale_position auf 100
setze teile auf []
setze genommen auf 0
für quelle in pilot["beispiele"]:
    wenn quelle["herkunft"]["tokenizer_id"] != tokhash:
        wirf "Tokenizer-Mismatch im Piloten"
    wenn quelle["akzeptiert"] == wahr und genommen < 24:
        setze fenster auf nichts
        versuche:
            setze fenster auf korrektur_fenster_aufteilen(quelle, encoder, limit, 0)
        fange lade_fehler:
            zeige "P5: korrektur_fenster_aufteilen fehlgeschlagen: " + lade_fehler
            beende(1)
        für item in fenster:
            teile.hinzufügen(item)
        # Alle zwei Korrekturbeispiele ein Fenster Originaltext.
        wenn genommen % 2 == 1:
            setze eingaben auf []
            setze ziele auf []
            setze maske auf []
            setze j auf 0
            solange j < limit:
                eingaben.hinzufügen(normale_ids[normale_position + j])
                ziele.hinzufügen(normale_ids[normale_position + j + 1])
                maske.hinzufügen(1)
                setze j auf j + 1
            teile.hinzufügen({"input_ids": eingaben, "target_ids": ziele, "loss_mask": maske, "nutzlaenge": limit, "ziel_start": 0})
            setze normale_position auf normale_position + 257
        setze genommen auf genommen + 1
wenn genommen < 24 oder länge(teile) < 20:
    wirf "Zu wenige unterschiedliche Korrekturen"
setze daten auf {"tokenizer_id": tokhash, "beispiele": teile}
setze params auf parameter(schichten)
setze vorher auf params[0].zu_liste()
setze konfig auf {"tokenizer_id": tokhash, "sequenzlaenge": limit, "vokab": silben_info(tok)["vokab"], "params": params, "optimierer": algo, "rate": rate, "encoder": encoder, "schritte": 48}
gpu_statistik_reset()
setze resultat auf trainiere_sft(vorlauf, daten, konfig)
setze nachher auf params[0].zu_liste()
setze i auf 0
setze geaendert auf falsch
solange i < länge(vorher):
    wenn vorher[i] != nachher[i]:
        setze geaendert auf wahr
    setze i auf i + 1
wenn nicht geaendert:
    wirf "SIL-14: Gewicht unveraendert"
setze ziel auf ausgabe + "/mix-" + algo + ".mook"
wenn datei_existiert(ziel):
    wirf "Ausgabecheckpoint existiert schon"
setze z["opt"] auf resultat["opt"]
setze z["schritt"] auf z["schritt"] + 48
setze z["global_schritt"] auf z["global_schritt"] + 48
checkpoint_speichern(z, ziel)
zeige "BEISPIELE " + text(länge(teile))
zeige "ERGEBNIS " + algo + " " + json_string(resultat["verluste"])
zeige "GPU " + json_string(gpu_statistik())
zeige "CHECKPOINT " + ziel
