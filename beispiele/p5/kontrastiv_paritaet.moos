# InfoNCE is a loss on paired representations, not an optimizer.
setze a auf tensor_aus_liste([[0.7, -0.2, 0.4], [-0.3, 0.8, 0.1], [0.2, 0.5, -0.6]]).mit_gradient()
setze b auf tensor_aus_liste([[0.6, -0.1, 0.3], [-0.2, 0.9, 0.2], [0.1, 0.4, -0.7]]).mit_gradient()
setze verlust auf kontrastiv(a, b, 0.7)
verlust.rueckwaerts()
zeige "P5 INFO " + json_string(a.gradient().zu_liste()) + " " + json_string(b.gradient().zu_liste())
