# Test-Client fuer Mini-Redis

# tcp_verbinde wirft bei Verbindungsfehler: Meldung und normales Ende.
setze client auf nichts
versuche:
    setze client auf tcp_verbinde("127.0.0.1", 6379)
fange fehler:
    zeige "Verbindung fehlgeschlagen: " + text(fehler)
wenn client == nichts:
    beende(0)
zeige "Verbunden mit Redis"

client.schreiben("PING\r\n")
setze antwort auf client.lesen(1024)
zeige "PING Antwort:"
zeige antwort

client.schliessen()
