# ============================================================
# beispiele/moo_widgets_host.moos — ALLE ui_moo-Widgets im
# nativen Aero-Glass-CSD-Fenster (NATIVE-UI-3b).
# Chrome + Widgets zeichnet moo selbst: KEIN Toolkit.
# Titelleiste (32px) + Buttons kommen vom CSD-Layer der Bruecke
# (uimh_fenster_csd), die Widgets nutzen das Glass-Theme.
# ============================================================

importiere ui_moo_hostfenster

setze k auf uimh_fenster_csd("MOO GLASS WIDGETS", 560, 540)
wenn k == nichts:
    wirf "Host-Fenster fehlgeschlagen (kein Backend / kein Display?)"

# Titelleiste (40px) + Menueleiste (26px) — Inhalt darunter.
setze OY auf 76

funktion on_knopf(w):
    zeige "KNOPF-KLICK"
    gib_zurück wahr

funktion on_schliessen(w):
    zeige "KNOPF-DEMO-KLICK (beendet NICHT)"
    gib_zurück wahr

funktion on_check(w, wert):
    zeige "CHECK " + text(wert)
    gib_zurück wahr

funktion on_slider(w, wert):
    gib_zurück wahr

funktion on_tf(w, txt):
    zeige "TF: " + txt
    gib_zurück wahr

funktion on_combo(w, idx):
    zeige "COMBO " + text(idx)
    gib_zurück wahr

funktion on_liste(w, idx):
    zeige "LISTE " + text(idx)
    gib_zurück wahr

funktion on_menue(p):
    zeige "MENUE: " + p["text"]
    gib_zurück wahr

funktion on_menue_beenden(p):
    zeige "MENUE: Beenden"
    host_beenden()
    gib_zurück wahr

# Menueleiste direkt unter der Titelleiste (NATIVE-UI-11)
setze m_datei auf uim_menue("Datei", [uim_menue_punkt("Neu", on_menue), uim_menue_punkt("Öffnen…", on_menue), uim_menue_punkt("Speichern", on_menue), uim_menue_trenner(), uim_menue_punkt("Beenden", on_menue_beenden)])
setze m_bearb auf uim_menue("Bearbeiten", [uim_menue_punkt("Rückgängig", on_menue), uim_menue_punkt("Wiederholen", on_menue), uim_menue_trenner(), uim_menue_punkt("Ausschneiden", on_menue), uim_menue_punkt("Kopieren", on_menue), uim_menue_punkt("Einfügen", on_menue)])
setze m_hilfe auf uim_menue("Hilfe", [uim_menue_punkt("Über moo…", on_menue)])
uim_hinzu(k, uim_menueleiste(0, 40, 560, 26, [m_datei, m_bearb, m_hilfe]))

uim_hinzu(k, uim_label("Aero Glass Widgets — Türöffner äöü ÄÖÜ ß nativ!", 24, OY, 480, 18))
uim_hinzu(k, uim_separator(24, OY + 22, 512))

uim_hinzu(k, uim_knopf("GLASS KNOPF", 24, OY + 38, 150, 30, on_knopf))
uim_hinzu(k, uim_knopf("NOCH EINER", 190, OY + 38, 150, 30, on_knopf))

uim_hinzu(k, uim_checkbox("GLAS-CHECKBOX", 24, OY + 84, 220, 22, wahr, on_check))
uim_hinzu(k, uim_checkbox("ZWEITE OPTION", 260, OY + 84, 220, 22, falsch, on_check))

uim_hinzu(k, uim_slider(24, OY + 120, 250, 24, 0, 100, 62, on_slider))
setze fp auf uim_fortschritt(300, OY + 124, 212, 16)
fp["wert"] = 0.62
uim_hinzu(k, fp)

uim_hinzu(k, uim_textfeld(24, OY + 158, 250, 26, "GLASS TEXT", on_tf))
uim_hinzu(k, uim_combobox(300, OY + 158, 160, 26, ["AERO", "GLASS", "MOO"], 0, on_combo))

setze panel auf uim_panel("PANEL", 24, OY + 200, 236, 150)
uim_hinzu(k, panel)
uim_hinzu(panel, uim_label("INHALT IM PANEL", 12, 26, 200, 18))
setze fp2 auf uim_fortschritt(12, 52, 200, 14)
fp2["wert"] = 0.35
uim_hinzu(panel, fp2)
uim_hinzu(panel, uim_knopf("IM PANEL", 12, 78, 130, 26, on_knopf))

uim_hinzu(k, uim_liste(276, OY + 200, 236, 150, ["ERSTE ZEILE", "ZWEITE ZEILE", "DRITTE ZEILE", "VIERTE ZEILE", "FUENFTE ZEILE", "SECHSTE ZEILE", "SIEBTE ZEILE", "ACHTE ZEILE"], on_liste))

uim_hinzu(k, uim_knopf("NUR EIN KNOPF", 24, OY + 366, 150, 30, on_schliessen))

zeige "GLASS-WIDGETS-START"
zeige "HOST-BACKEND " + ui_host_backend()
uimh_laufen(k)
zeige "GLASS-WIDGETS-ENDE"
