# Casts: als(T, x) ist geprüft; als_wrap und als_saettigend sind die
# ausdrücklich angeforderten Varianten für Überlauf und Sättigung.
# Erwartete Ausgabe: 200, -3, 16777216, 255, 127, -128, 3, 0, 42, 201
@nativ
funktion k_u8(a: i32) -> u8:
    gib_zurück als(u8, a)
@nativ
funktion k_i64(a: f64) -> i64:
    gib_zurück als(i64, a)
@nativ
funktion k_rund(a: i32) -> i64:
    gib_zurück als(i64, als(f32, a))
@nativ
funktion k_wrap(a: i32) -> u8:
    gib_zurück als_wrap(u8, a)
@nativ
funktion k_satt(a: i32) -> i8:
    gib_zurück als_saettigend(i8, a)
@nativ
funktion k_satt_f(a: f64) -> u8:
    gib_zurück als_saettigend(u8, a)
@nativ
funktion k_u64(a: i64) -> u64:
    gib_zurück als(u64, a)
@nativ
funktion k_literal(a: u8) -> u8:
    gib_zurück a + als(u8, 200)
zeige k_u8(200)
zeige k_i64(-3.0)
zeige k_rund(16777217)
zeige k_wrap(-1)
zeige k_satt(300)
zeige k_satt(-300)
zeige k_satt_f(3.7)
zeige k_satt_f(-5.0)
zeige k_u64(42)
zeige k_literal(1)
