# ---------------- Ausgabe: COM1 + debugcon 0xE9 ----------------
@nativ
funktion seriell_init() -> void:
    unsicher:
        port_schreibe(0x3F9, 0)
        port_schreibe(0x3FB, 0x80)
        port_schreibe(0x3F8, 1)
        port_schreibe(0x3F9, 0)
        port_schreibe(0x3FB, 3)
        port_schreibe(0x3FA, 0xC7)
        port_schreibe(0x3FC, 3)

@nativ
funktion zeichen(z: u8) -> void:
    unsicher:
        setze n: u32 auf 0
        solange (port_lese(0x3FD) & 0x20) == 0 und n < 100000:
            setze n auf n + 1
        port_schreibe(0x3F8, z)
        port_schreibe(0xE9, z)

# Nullterminierter Text ab adr.
@nativ
funktion text(adr: u64) -> void:
    unsicher:
        setze i: u64 auf 0
        solange speicher_lesen(adr + i, 1) != 0:
            zeichen(speicher_lesen(adr + i, 1))
            setze i auf i + 1

@nativ
funktion hex(wert: u64) -> void:
    unsicher:
        setze i: u64 auf 0
        solange i < 16:
            setze ziffer: u8 auf u8((wert >> (60 - i * 4)) & 15)
            wenn ziffer < 10:
                zeichen(ziffer + 48)
            sonst:
                zeichen(ziffer + 55)
            setze i auf i + 1

@nativ
funktion meldung(adr: u64, wert: u64) -> void:
    unsicher:
        text(adr)
        hex(wert)
        zeichen(10)

# ---------------- Firmwaredienste ----------------
@nativ
funktion dienst(tabelle: u64, versatz: u64) -> u64:
    unsicher:
        gib_zurück speicher_lesen(tabelle + versatz, 8)

@nativ
funktion ruf1(f: u64, a: u64) -> u64:
    unsicher:
        setze z: ptr[fn[uefi](u64) -> u64] auf zeiger(f)
        gib_zurück z(a)

@nativ
funktion ruf2(f: u64, a: u64, b: u64) -> u64:
    unsicher:
        setze z: ptr[fn[uefi](u64, u64) -> u64] auf zeiger(f)
        gib_zurück z(a, b)

@nativ
funktion ruf3(f: u64, a: u64, b: u64, c: u64) -> u64:
    unsicher:
        setze z: ptr[fn[uefi](u64, u64, u64) -> u64] auf zeiger(f)
        gib_zurück z(a, b, c)

@nativ
funktion ruf4(f: u64, a: u64, b: u64, c: u64, d: u64) -> u64:
    unsicher:
        setze z: ptr[fn[uefi](u64, u64, u64, u64) -> u64] auf zeiger(f)
        gib_zurück z(a, b, c, d)

@nativ
funktion ruf5(f: u64, a: u64, b: u64, c: u64, d: u64, e: u64) -> u64:
    unsicher:
        setze z: ptr[fn[uefi](u64, u64, u64, u64, u64) -> u64] auf zeiger(f)
        gib_zurück z(a, b, c, d, e)

# AllocatePages(AllocateAnyPages, EfiLoaderData, anzahl) und nullen; 0 = Fehler.
@nativ
funktion seiten(bs: u64, anzahl: u64) -> u64:
    unsicher:
        setze adr: u64 auf 0
        wenn ruf4(dienst(bs, versatz_von(EfiBootDienste, bs_allocate_pages)), 0, 2, anzahl, adresse_von(adr)) != 0:
            gib_zurück 0
        ruf3(dienst(bs, versatz_von(EfiBootDienste, bs_set_mem)), adr, anzahl * 4096, 0)
        gib_zurück adr

# Fehler zusaetzlich auf den Bildschirm (ConOut) und 10 s stehen lassen: der
# N100 hat keine sichtbare serielle Schnittstelle. Nur vor ExitBootServices.
@nativ
funktion schirm(st: u64, bs: u64, text_w: u64, warten: bool) -> void:
    unsicher:
        setze con: u64 auf dienst(st, versatz_von(EfiSystemTabelle, con_out))
        wenn con != 0:
            ruf2(dienst(con, versatz_von(EfiTextAusgabe, to_output_string)), con, text_w)
        wenn warten:
            ruf1(dienst(bs, versatz_von(EfiBootDienste, bs_stall)), 10000000)

@nativ
funktion guid_gleich(a: u64, b: u64) -> bool:
    unsicher:
        gib_zurück speicher_lesen(a, 8) == speicher_lesen(b, 8) und speicher_lesen(a + 8, 8) == speicher_lesen(b + 8, 8)

# P7-T25: opt-in fuer private Testloader, BootOrder bleibt unveraendert.
# UEFI2.10A 3.1.1/3.1.3 (BootNext, EFI_LOAD_OPTION), 8.2 (Variablen).
# https://uefi.org/specs/UEFI/2.10_A/03_Boot_Manager.html
# Layout: edk2 MdePkg/Include/Uefi/UefiSpec.h und Protocol/DevicePath.h.
@nativ
statisch RUECKKEHR_KONFIG: [u64; 2] auf [0x325654524F4F4D21, 0]
@nativ
konstante RF_GUID: [u64; 2] auf [0x11D293CA8BE4DF61, 0x8C2B0398E0000DAA]
@nativ
konstante RF_ORDER: [u16; _] auf "BootOrder"
@nativ
konstante RF_NEXT: [u16; _] auf "BootNext"
@nativ
konstante RF_BOOT: [u16; _] auf "Boot0000"
@nativ
konstante RF_WINDOWS: [u16; _] auf "\\efi\\microsoft\\boot\\bootmgfw.efi"
@nativ
konstante RF_OK: [u8; _] auf "MOO-LADER RUECKKEHR BOOTNEXT "
@nativ
konstante RF_FEHLER: [u8; _] auf "MOO-LADER RUECKKEHR FEHLER "
@nativ
konstante W_RF_FEHLER: [u16; _] auf "Moo-Lader: sichere Windows-Rueckkehr nicht belegt, kein Kernstart\r\n"

struktur EfiLaufzeitDienste:
    kopf_signatur: u64
    kopf_revision: u32
    kopf_groesse: u32
    kopf_crc: u32
    kopf_reserviert: u32
    rt_get_time: u64
    rt_set_time: u64
    rt_get_wakeup_time: u64
    rt_set_wakeup_time: u64
    rt_set_virtual_address_map: u64
    rt_convert_pointer: u64
    rt_get_variable: u64
    rt_get_next_variable_name: u64
    rt_set_variable: u64

@nativ
funktion rf_fehler(schritt: u64) -> bool:
    unsicher:
        meldung(adresse_von(RF_FEHLER), schritt)
        gib_zurück falsch

# Genau ein aktiver GPT-HD/FilePath/End-Pfad; Beschreibung wird nie benutzt.
@nativ
funktion rf_windows_option(p: u64, laenge: u64) -> bool:
    unsicher:
        wenn laenge < 8 oder laenge > 4096 oder (speicher_lesen(p, 4) & 1) == 0:
            gib_zurück falsch
        setze pfadlaenge: u64 auf u64(speicher_lesen(p + 4, 2))
        setze pos: u64 auf 6
        solange pos + 2 <= laenge und speicher_lesen(p + pos, 2) != 0:
            setze pos auf pos + 2
        wenn pos + 2 > laenge:
            gib_zurück falsch
        setze pos auf pos + 2
        wenn pfadlaenge < 4 oder pfadlaenge > laenge - pos:
            gib_zurück falsch
        setze ende: u64 auf pos + pfadlaenge
        setze hd: bool auf falsch
        setze datei: bool auf falsch
        setze typ: u64 auf 0
        setze untertyp: u64 auf 0
        setze n: u64 auf 0
        setze j: u64 auf 0
        setze erwartet: u64 auf 0
        setze zeichen: u64 auf 0
        solange pos + 4 <= ende:
            setze typ auf u64(speicher_lesen(p + pos, 1))
            setze untertyp auf u64(speicher_lesen(p + pos + 1, 1))
            setze n auf u64(speicher_lesen(p + pos + 2, 2))
            wenn n < 4 oder n > ende - pos:
                gib_zurück falsch
            wenn typ == 0x7F:
                gib_zurück untertyp == 0xFF und n == 4 und pos + n == ende und hd und datei
            wenn typ == 4 und untertyp == 1:
                wenn hd oder datei oder n != 42:
                    gib_zurück falsch
                wenn speicher_lesen(p + pos + 40, 1) != 2 oder speicher_lesen(p + pos + 41, 1) != 2:
                    gib_zurück falsch
                wenn speicher_lesen(p + pos + 4, 4) == 0 oder speicher_lesen(p + pos + 16, 8) == 0 oder (speicher_lesen(p + pos + 24, 8) == 0 und speicher_lesen(p + pos + 32, 8) == 0):
                    gib_zurück falsch
                setze hd auf wahr
            sonst wenn typ == 4 und untertyp == 4:
                wenn nicht hd oder datei oder n < 6 oder (n & 1) != 0:
                    gib_zurück falsch
                setze j auf 4
                solange j < n:
                    setze erwartet auf u64(speicher_lesen(adresse_von(RF_WINDOWS) + j - 4, 2))
                    setze zeichen auf u64(speicher_lesen(p + pos + j, 2))
                    wenn zeichen >= 65 und zeichen <= 90:
                        setze zeichen auf zeichen + 32
                    wenn zeichen != erwartet:
                        gib_zurück falsch
                    wenn erwartet == 0:
                        wenn j + 2 != n:
                            gib_zurück falsch
                        setze datei auf wahr
                        stopp
                    setze j auf j + 2
                wenn nicht datei:
                    gib_zurück falsch
            sonst wenn datei:
                gib_zurück falsch
            setze pos auf pos + n
        gib_zurück falsch

@nativ
funktion rf_bootname(ziel: u64, nummer: u64) -> void:
    unsicher:
        setze i: u64 auf 0
        setze ziffer: u64 auf 0
        solange i < 4:
            speicher_schreiben(ziel + i * 2, als(u16, speicher_lesen(adresse_von(RF_BOOT) + i * 2, 2)), 2)
            setze ziffer auf (nummer >> ((3 - i) * 4)) & 15
            wenn ziffer < 10:
                setze ziffer auf ziffer + 48
            sonst:
                setze ziffer auf ziffer + 55
            speicher_schreiben(ziel + 8 + i * 2, als(u16, ziffer), 2)
            setze i auf i + 1
        speicher_schreiben(ziel + 16, 0, 2)

# Arbeit: UINTN size@0, UINT32 attrs@8, Boot####@64, Order@256, Option@4096.
@nativ
funktion rf_lesen(rt: u64, name: u64, arbeit: u64, puffer: u64, max: u64) -> u64:
    unsicher:
        speicher_schreiben(arbeit, max, 8)
        speicher_schreiben(arbeit + 8, 0, 4)
        gib_zurück ruf5(dienst(rt, versatz_von(EfiLaufzeitDienste, rt_get_variable)), name, adresse_von(RF_GUID), arbeit + 8, arbeit, puffer)

@nativ
funktion rueckkehr_vorbereiten(st: u64, bs: u64) -> bool:
    unsicher:
        setze modus: u64 auf speicher_lesen(adresse_von(RUECKKEHR_KONFIG) + 8, 8)
        wenn modus > 3:
            gib_zurück rf_fehler(1)
        wenn (modus & 1) == 0:
            gib_zurück wahr
        setze rt: u64 auf dienst(st, versatz_von(EfiSystemTabelle, laufzeitdienste))
        wenn rt == 0 oder speicher_lesen(rt, 8) != 0x56524553544E5552 oder u64(speicher_lesen(rt + 12, 4)) < groesse_von(EfiLaufzeitDienste):
            gib_zurück rf_fehler(2)
        setze arbeit: u64 auf seiten(bs, 3)
        wenn arbeit == 0:
            gib_zurück rf_fehler(3)
        wenn rf_lesen(rt, adresse_von(RF_ORDER), arbeit, arbeit + 256, 256) != 0:
            gib_zurück rf_fehler(4)
        setze orderlaenge: u64 auf speicher_lesen(arbeit, 8)
        wenn orderlaenge == 0 oder orderlaenge > 256 oder (orderlaenge & 1) != 0 oder speicher_lesen(arbeit + 8, 4) != 7:
            gib_zurück rf_fehler(5)
        setze i: u64 auf 0
        setze kandidat: u64 auf 0x10000
        setze nummer: u64 auf 0
        setze status: u64 auf 0
        solange i < orderlaenge:
            setze nummer auf u64(speicher_lesen(arbeit + 256 + i, 2))
            rf_bootname(arbeit + 64, nummer)
            setze status auf rf_lesen(rt, arbeit + 64, arbeit, arbeit + 4096, 4096)
            wenn status != 0:
                gib_zurück rf_fehler(6)
            wenn rf_windows_option(arbeit + 4096, speicher_lesen(arbeit, 8)):
                wenn kandidat != 0x10000:
                    gib_zurück rf_fehler(7)
                setze kandidat auf nummer
            setze i auf i + 2
        wenn kandidat == 0x10000:
            gib_zurück rf_fehler(8)
        setze status auf rf_lesen(rt, adresse_von(RF_NEXT), arbeit, arbeit + 16, 2)
        wenn status == 0:
            # Nur eine bereits identische Rueckkehr akzeptieren; nie fremde Ziele loeschen.
            wenn speicher_lesen(arbeit, 8) != 2 oder speicher_lesen(arbeit + 8, 4) != 7 oder u64(speicher_lesen(arbeit + 16, 2)) != kandidat:
                gib_zurück rf_fehler(9)
        sonst:
            wenn status != 0x800000000000000E:
                gib_zurück rf_fehler(10)
            speicher_schreiben(arbeit + 16, als(u16, kandidat), 2)
            wenn ruf5(dienst(rt, versatz_von(EfiLaufzeitDienste, rt_set_variable)), adresse_von(RF_NEXT), adresse_von(RF_GUID), 7, 2, arbeit + 16) != 0:
                gib_zurück rf_fehler(11)
        wenn rf_lesen(rt, adresse_von(RF_NEXT), arbeit, arbeit + 16, 2) != 0 oder speicher_lesen(arbeit, 8) != 2 oder u64(speicher_lesen(arbeit + 16, 2)) != kandidat:
            gib_zurück rf_fehler(12)
        # Firmware-Nebenwirkung erkennen, keine dauerhafte Variable restaurieren/schreiben.
        wenn rf_lesen(rt, adresse_von(RF_ORDER), arbeit, arbeit + 4096, 256) != 0 oder speicher_lesen(arbeit, 8) != orderlaenge:
            gib_zurück rf_fehler(13)
        setze i auf 0
        solange i < orderlaenge:
            wenn speicher_lesen(arbeit + 256 + i, 1) != speicher_lesen(arbeit + 4096 + i, 1):
                gib_zurück rf_fehler(14)
            setze i auf i + 1
        meldung(adresse_von(RF_OK), kandidat)
        gib_zurück wahr

# ---------------- Kern-Datei ----------------
# \EFI\MOO\KERN.ELF vom Dateisystem auf geraet lesen. Ergebnis: Puffer (Pool)
# oder 0; die Laenge steht danach in *ausgabe.
@nativ
funktion datei_lesen(bs: u64, geraet: u64, ausgabe: u64) -> u64:
    unsicher:
        setze sfs: u64 auf 0
        setze wurzel: u64 auf 0
        setze datei: u64 auf 0
        setze groesse: u64 auf 0
        setze puffer: u64 auf 0
        setze gelesen: u64 auf 0
        setze status: u64 auf 0
        wenn ruf3(dienst(bs, versatz_von(EfiBootDienste, bs_handle_protocol)), geraet, adresse_von(DATEISYSTEM_GUID), adresse_von(sfs)) != 0 oder sfs == 0:
            gib_zurück 0
        wenn ruf2(dienst(sfs, versatz_von(EfiDateisystem, fs_open_volume)), sfs, adresse_von(wurzel)) != 0 oder wurzel == 0:
            gib_zurück 0
        wenn ruf5(dienst(wurzel, versatz_von(EfiDatei, fp_open)), wurzel, adresse_von(datei), adresse_von(KERN_PFAD), 1, 0) != 0 oder datei == 0:
            ruf1(dienst(wurzel, versatz_von(EfiDatei, fp_close)), wurzel)
            gib_zurück 0
        # Groesse: ans Ende setzen (0xFFFF...FFFF), Position lesen, zurueck auf 0.
        ruf2(dienst(datei, versatz_von(EfiDatei, fp_set_position)), datei, 0xFFFFFFFFFFFFFFFF)
        ruf2(dienst(datei, versatz_von(EfiDatei, fp_get_position)), datei, adresse_von(groesse))
        ruf2(dienst(datei, versatz_von(EfiDatei, fp_set_position)), datei, 0)
        wenn groesse >= 64 und groesse <= 0x4000000:
            wenn ruf3(dienst(bs, versatz_von(EfiBootDienste, bs_allocate_pool)), 2, groesse, adresse_von(puffer)) == 0:
                setze gelesen auf groesse
                setze status auf ruf3(dienst(datei, versatz_von(EfiDatei, fp_read)), datei, adresse_von(gelesen), puffer)
                wenn status != 0 oder gelesen != groesse:
                    setze puffer auf 0
        ruf1(dienst(datei, versatz_von(EfiDatei, fp_close)), datei)
        ruf1(dienst(wurzel, versatz_von(EfiDatei, fp_close)), wurzel)
        wenn puffer != 0:
            speicher_schreiben(ausgabe, groesse, 8)
        gib_zurück puffer

# Profilbit 1 bindet den Kern an das Geraet des gestarteten EFI-Images.
# Der Standardpfad kennt auch LoadOptions und weitere Dateisysteme.
@nativ
funktion kern_holen(bs: u64, bild: u64, ausgabe: u64) -> u64:
    unsicher:
        setze nur_esp: bool auf (speicher_lesen(adresse_von(RUECKKEHR_KONFIG) + 8, 8) & 2) != 0
        setze li: u64 auf 0
        setze geraet: u64 auf 0
        setze optionen: u64 auf 0
        setze puffer: u64 auf 0
        setze handles: u64 auf 0
        setze anzahl: u64 auf 0
        setze i: u64 auf 0
        wenn ruf3(dienst(bs, versatz_von(EfiBootDienste, bs_handle_protocol)), bild, adresse_von(BILD_GUID), adresse_von(li)) == 0 und li != 0:
            wenn nicht nur_esp:
                setze optionen auf speicher_lesen(li + versatz_von(EfiGeladenesBild, li_optionen), 8)
                wenn optionen != 0 und u64(speicher_lesen(li + versatz_von(EfiGeladenesBild, li_optionen_groesse), 4)) == groesse_von(MooKernUebergabe):
                    wenn speicher_lesen(optionen + versatz_von(MooKernUebergabe, ku_magie), 8) == KERN_UEBERGABE_MAGIE:
                        text(adresse_von(T_UEBERGABE))
                        speicher_schreiben(ausgabe, speicher_lesen(optionen + versatz_von(MooKernUebergabe, ku_laenge), 8), 8)
                        gib_zurück speicher_lesen(optionen + versatz_von(MooKernUebergabe, ku_adresse), 8)
            setze geraet auf speicher_lesen(li + versatz_von(EfiGeladenesBild, li_geraet), 8)
        wenn geraet != 0:
            setze puffer auf datei_lesen(bs, geraet, ausgabe)
            wenn puffer != 0:
                wenn nur_esp:
                    text(adresse_von(T_ESP_KERN))
                gib_zurück puffer
        wenn nur_esp:
            gib_zurück 0
        # LocateHandleBuffer(ByProtocol = 2, Dateisystem-GUID)
        wenn ruf5(dienst(bs, versatz_von(EfiBootDienste, bs_locate_handle_buffer)), 2, adresse_von(DATEISYSTEM_GUID), 0, adresse_von(anzahl), adresse_von(handles)) != 0:
            gib_zurück 0
        solange i < anzahl:
            setze puffer auf datei_lesen(bs, speicher_lesen(handles + i * 8, 8), ausgabe)
            wenn puffer != 0:
                gib_zurück puffer
            setze i auf i + 1
        gib_zurück 0

# ---------------- ELF64 laden (obere Adresshaelfte) ----------------
# Der Kern ist ab KERN_HOCH (0xFFFFFFFF80000000) gelinkt; das passt zu
# -mcmodel=kernel der C-Runtime. Alle PT_LOAD zusammen landen in EINEM Block
# freier physischer Seiten (AllocateAnyPages, Lage beliebig, also auch auf
# Rechnern mit belegtem Low-Memory); seitentabelle_bauen bildet KERN_HOCH..
# darauf ab. Ergebnis: Einstieg (virtuell) oder 0.
@nativ
funktion elf_laden(bs: u64, elf: u64, laenge: u64, bi: u64) -> u64:
    unsicher:
        setze bild: Elf64Bild auf Elf64Bild(0, 0, 0, 0, 0)
        setze segment: Elf64Segment auf Elf64Segment(0, 0, 0, 0, 0)
        setze eb: ptr[Elf64Bild] auf zeiger(adresse_von(bild))
        setze sg: ptr[Elf64Segment] auf zeiger(adresse_von(segment))
        wenn nicht elf64_oeffnen(elf, laenge, eb):
            meldung(adresse_von(T_F_ELF), laenge)
            gib_zurück 0
        setze i: u64 auf 0
        setze ph: u64 auf 0
        setze vunten: u64 auf 0xFFFFFFFFFFFFFFFF
        setze voben: u64 auf 0
        solange i < bild.eb_phanzahl:
            setze ph auf elf64_programmkopf(eb, i)
            wenn speicher_lesen(ph, 4) == ELF64_PT_LOAD:
                wenn nicht elf64_segment(eb, ph, sg) oder segment.es_virt < KERN_HOCH:
                    meldung(adresse_von(T_F_ELF), i)
                    gib_zurück 0
                setze seite: u64 auf segment.es_virt & 0xFFFFFFFFFFFFF000
                wenn seite < vunten:
                    setze vunten auf seite
                setze ende: u64 auf segment.es_virt + segment.es_speichergroesse
                wenn ende > voben:
                    setze voben auf ende
            setze i auf i + 1
        # Ein Seitenverzeichnis (1 GiB) ab genau KERN_HOCH.
        wenn vunten != KERN_HOCH oder voben <= vunten oder voben - vunten > 0x40000000:
            meldung(adresse_von(T_F_ELF), vunten)
            gib_zurück 0
        setze einstieg: u64 auf bild.eb_einstieg
        wenn einstieg < vunten oder einstieg >= voben:
            meldung(adresse_von(T_F_ELF), einstieg)
            gib_zurück 0
        setze seitenzahl: u64 auf (voben - vunten + 4095) / 4096
        setze physisch: u64 auf seiten(bs, seitenzahl)
        wenn physisch == 0:
            meldung(adresse_von(T_F_SPEICHER), seitenzahl)
            gib_zurück 0
        setze i auf 0
        solange i < bild.eb_phanzahl:
            setze ph auf elf64_programmkopf(eb, i)
            wenn speicher_lesen(ph, 4) == ELF64_PT_LOAD:
                elf64_segment(eb, ph, sg)
                elf64_kopieren(eb, sg, physisch + (segment.es_virt - vunten))
                meldung(adresse_von(T_SEGMENT), segment.es_virt)
            setze i auf i + 1
        speicher_schreiben(bi + versatz_von(MooBootInfo, kern_basis), physisch, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, kern_ende), physisch + seitenzahl * 4096, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, kern_virtuell), vunten, 8)
        meldung(adresse_von(T_PHYS), physisch)
        wenn nicht seitentabelle_bauen(bs, bi, physisch, seitenzahl):
            gib_zurück 0
        gib_zurück einstieg

# Neue PML4 = Kopie der Firmware-PML4 (deren Identitaetsabbildung bleibt fuer
# Loader, Boot-Info, Framebuffer und ACPI gueltig) plus PML4[511] -> PDPT,
# PDPT[510] -> PD, PD[j] -> PT_j, PT-Eintraege = physische 4-KiB-Seiten des
# Kerns (Present | RW). Nur 4-Level-Paging (CR4.LA57 = 0). Die Tabellen der
# Firmware liegen in EfiBootServicesData: der Kern darf diesen Speicher erst
# nach eigenem Paging (P7-T7) wiederverwenden.
@nativ
funktion seitentabelle_bauen(bs: u64, bi: u64, physisch: u64, seitenzahl: u64) -> bool:
    unsicher:
        setze cr3: u64 auf assembler(ziel="x86_64", code="movq %cr3, $0", ausgang="=r", clobber=[])
        setze cr4: u64 auf assembler(ziel="x86_64", code="movq %cr4, $0", ausgang="=r", clobber=[])
        setze alt: u64 auf cr3 & 0x000FFFFFFFFFF000
        speicher_schreiben(bi + versatz_von(MooBootInfo, firmware_seitentabelle), alt, 8)
        setze pt_anzahl: u64 auf (seitenzahl + 511) / 512
        setze tabellen: u64 auf 0
        setze k: u64 auf 0
        wenn (cr4 & 0x1000) != 0:
            meldung(adresse_von(T_F_PAGING), cr4)
            gib_zurück falsch
        wenn speicher_lesen(alt + 511 * 8, 8) != 0:
            meldung(adresse_von(T_F_PAGING), speicher_lesen(alt + 511 * 8, 8))
            gib_zurück falsch
        # Block: PML4, PDPT, PD, danach pt_anzahl PTs (alle genullt).
        setze tabellen auf seiten(bs, 3 + pt_anzahl)
        wenn tabellen == 0:
            meldung(adresse_von(T_F_SPEICHER), 3 + pt_anzahl)
            gib_zurück falsch
        ruf3(dienst(bs, versatz_von(EfiBootDienste, bs_copy_mem)), tabellen, alt, 4096)
        speicher_schreiben(tabellen + 511 * 8, (tabellen + 4096) | 3, 8)
        speicher_schreiben(tabellen + 4096 + 510 * 8, (tabellen + 8192) | 3, 8)
        solange k < pt_anzahl:
            speicher_schreiben(tabellen + 8192 + k * 8, (tabellen + 12288 + k * 4096) | 3, 8)
            setze k auf k + 1
        # Die PTs liegen hintereinander: Eintrag k von allen PTs steht bei 12288 + k * 8.
        setze k auf 0
        solange k < seitenzahl:
            speicher_schreiben(tabellen + 12288 + k * 8, (physisch + k * 4096) | 3, 8)
            setze k auf k + 1
        speicher_schreiben(bi + versatz_von(MooBootInfo, seitentabelle), tabellen, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, seitentabelle_seiten), 3 + pt_anzahl, 8)
        meldung(adresse_von(T_SEITEN), tabellen)
        gib_zurück wahr

# ---------------- Einstieg ----------------
@nativ
@einstieg
funktion efi_main(bild: u64, st: u64) -> u64:
    unsicher:
        setze bs: u64 auf 0
        setze con: u64 auf 0
        setze bi: u64 auf 0
        setze arbeit: u64 auf 0
        setze gop: u64 auf 0
        setze modus: u64 auf 0
        setze info: u64 auf 0
        setze anzahl: u64 auf 0
        setze tabelle: u64 auf 0
        setze eintrag: u64 auf 0
        setze rsdp: u64 auf 0
        setze i: u64 auf 0
        setze kern_laenge: u64 auf 0
        setze kern_puffer: u64 auf 0
        setze einstieg: u64 auf 0
        setze karte: u64 auf 0
        setze kapazitaet: u64 auf 0
        setze karte_groesse: u64 auf 0
        setze schluessel: u64 auf 0
        setze desk_groesse: u64 auf 0
        setze desk_version: u64 auf 0
        setze status: u64 auf 0
        setze versuch: u64 auf 0
        setze beendet: bool auf falsch
        setze pml4: u64 auf 0
        seriell_init()
        text(adresse_von(T_START))
        setze bs auf dienst(st, versatz_von(EfiSystemTabelle, bootdienste))
        # Watchdog aus: SetWatchdogTimer(0, 0, 0, NULL)
        ruf4(dienst(bs, versatz_von(EfiBootDienste, bs_set_watchdog_timer)), 0, 0, 0, 0)
        setze con auf dienst(st, versatz_von(EfiSystemTabelle, con_out))
        wenn con != 0:
            ruf2(dienst(con, versatz_von(EfiTextAusgabe, to_output_string)), con, adresse_von(W_START))
        wenn nicht rueckkehr_vorbereiten(st, bs):
            schirm(st, bs, adresse_von(W_RF_FEHLER), wahr)
            gib_zurück FEHLER_LADEN
        # Boot-Info (1 Seite) und Arbeitsspeicher fuer den Kern (16 Seiten)
        setze bi auf seiten(bs, 1)
        setze arbeit auf seiten(bs, 16)
        wenn bi == 0 oder arbeit == 0:
            meldung(adresse_von(T_F_SPEICHER), 0)
            schirm(st, bs, adresse_von(W_F_SPEICHER), wahr)
            gib_zurück FEHLER_LADEN
        speicher_schreiben(bi + versatz_von(MooBootInfo, magie), BOOT_MAGIE, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, version), 2, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, arbeit), arbeit, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, arbeit_groesse), 16 * 4096, 8)
        # GOP: LocateProtocol(&GOP_GUID, NULL, &gop)
        wenn ruf3(dienst(bs, versatz_von(EfiBootDienste, bs_locate_protocol)), adresse_von(GOP_GUID), 0, adresse_von(gop)) == 0 und gop != 0:
            setze modus auf speicher_lesen(gop + versatz_von(EfiGop, gop_modus), 8)
            setze info auf speicher_lesen(modus + versatz_von(EfiGopModus, gm_info), 8)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_basis), speicher_lesen(modus + versatz_von(EfiGopModus, gm_fb_basis), 8), 8)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_groesse), speicher_lesen(modus + versatz_von(EfiGopModus, gm_fb_groesse), 8), 8)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_breite), speicher_lesen(info + versatz_von(EfiGopInfo, gi_breite), 4), 4)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_hoehe), speicher_lesen(info + versatz_von(EfiGopInfo, gi_hoehe), 4), 4)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_stride), speicher_lesen(info + versatz_von(EfiGopInfo, gi_pixel_pro_zeile), 4), 4)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_format), speicher_lesen(info + versatz_von(EfiGopInfo, gi_format), 4), 4)
            # P7-T6: Bitmasken (nur bei Format 2 = PixelBitMask gueltig) an den Kern.
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_maske_rot), speicher_lesen(info + versatz_von(EfiGopInfo, gi_maske_rot), 4), 4)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_maske_gruen), speicher_lesen(info + versatz_von(EfiGopInfo, gi_maske_gruen), 4), 4)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_maske_blau), speicher_lesen(info + versatz_von(EfiGopInfo, gi_maske_blau), 4), 4)
            speicher_schreiben(bi + versatz_von(MooBootInfo, fb_maske_reserviert), speicher_lesen(info + versatz_von(EfiGopInfo, gi_maske_reserviert), 4), 4)
            meldung(adresse_von(T_GOP), speicher_lesen(bi + versatz_von(MooBootInfo, fb_basis), 8))
            meldung(adresse_von(T_BREITE), u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_breite), 4)))
            meldung(adresse_von(T_HOEHE), u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_hoehe), 4)))
            meldung(adresse_von(T_STRIDE), u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_stride), 4)))
            meldung(adresse_von(T_FORMAT), u64(speicher_lesen(bi + versatz_von(MooBootInfo, fb_format), 4)))
        sonst:
            meldung(adresse_von(T_KEIN_GOP), 0)
        # ACPI-RSDP aus der Konfigurationstabelle
        setze anzahl auf dienst(st, versatz_von(EfiSystemTabelle, tabellen_anzahl))
        setze tabelle auf dienst(st, versatz_von(EfiSystemTabelle, konfig_tabelle))
        solange i < anzahl:
            setze eintrag auf tabelle + i * groesse_von(EfiKonfigTabelle)
            wenn guid_gleich(eintrag, adresse_von(ACPI20_GUID)):
                setze rsdp auf speicher_lesen(eintrag + versatz_von(EfiKonfigTabelle, kt_tabelle), 8)
                stopp
            wenn rsdp == 0 und guid_gleich(eintrag, adresse_von(ACPI10_GUID)):
                setze rsdp auf speicher_lesen(eintrag + versatz_von(EfiKonfigTabelle, kt_tabelle), 8)
            setze i auf i + 1
        speicher_schreiben(bi + versatz_von(MooBootInfo, acpi_rsdp), rsdp, 8)
        meldung(adresse_von(T_RSDP), rsdp)
        # Kern holen und laden
        setze kern_puffer auf kern_holen(bs, bild, adresse_von(kern_laenge))
        wenn kern_puffer == 0:
            meldung(adresse_von(T_F_KERN), 0)
            schirm(st, bs, adresse_von(W_F_KERN), wahr)
            gib_zurück FEHLER_LADEN
        meldung(adresse_von(T_DATEI), kern_laenge)
        setze einstieg auf elf_laden(bs, kern_puffer, kern_laenge, bi)
        wenn einstieg == 0:
            schirm(st, bs, adresse_von(W_F_ELF), wahr)
            gib_zurück FEHLER_LADEN
        meldung(adresse_von(T_EINSTIEG), einstieg)
        schirm(st, bs, adresse_von(W_OK), falsch)
        # Speicherkarte: erst Groesse erfragen, Puffer mit Reserve anlegen
        # (AllocatePool selbst veraendert die Karte), dann Karte + ExitBootServices.
        ruf5(dienst(bs, versatz_von(EfiBootDienste, bs_get_memory_map)), adresse_von(karte_groesse), 0, adresse_von(schluessel), adresse_von(desk_groesse), adresse_von(desk_version))
        setze kapazitaet auf karte_groesse + 16 * desk_groesse + 4096
        wenn ruf3(dienst(bs, versatz_von(EfiBootDienste, bs_allocate_pool)), 2, kapazitaet, adresse_von(karte)) != 0:
            meldung(adresse_von(T_F_SPEICHER), kapazitaet)
            schirm(st, bs, adresse_von(W_F_SPEICHER), wahr)
            gib_zurück FEHLER_LADEN
        # Nach einem gescheiterten ExitBootServices sind nur GetMemoryMap und
        # ExitBootServices erlaubt; Ausgabe laeuft nur ueber Ports.
        solange versuch < 4 und nicht beendet:
            setze karte_groesse auf kapazitaet
            setze status auf ruf5(dienst(bs, versatz_von(EfiBootDienste, bs_get_memory_map)), adresse_von(karte_groesse), karte, adresse_von(schluessel), adresse_von(desk_groesse), adresse_von(desk_version))
            wenn status == 0:
                setze status auf ruf2(dienst(bs, versatz_von(EfiBootDienste, bs_exit_boot_services)), bild, schluessel)
                wenn status == 0:
                    setze beendet auf wahr
            setze versuch auf versuch + 1
        wenn nicht beendet:
            meldung(adresse_von(T_F_EBS), status)
            gib_zurück status
        # Ab hier: keine Firmwaredienste mehr.
        meldung(adresse_von(T_EBS), versuch)
        speicher_schreiben(bi + versatz_von(MooBootInfo, karte), karte, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, karte_groesse), karte_groesse, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, deskriptor_groesse), desk_groesse, 8)
        speicher_schreiben(bi + versatz_von(MooBootInfo, deskriptor_version), desk_version, 8)
        meldung(adresse_von(T_KARTE), karte_groesse / desk_groesse)
        meldung(adresse_von(T_SPRUNG), einstieg)
        # Eigene Seitentabelle aktivieren (untere Haelfte wie bisher, Kern oben).
        setze pml4 auf speicher_lesen(bi + versatz_von(MooBootInfo, seitentabelle), 8)
        assembler(ziel="x86_64", code="cli; movq $0, %cr3", eingaenge={"r": pml4}, clobber=["memory"])
        # Kern: SysV-ABI, erstes Argument (rdi) = Boot-Info; kehrt nicht zurueck.
        setze kern: ptr[fn[sysv64](u64) -> void] auf zeiger(einstieg)
        kern(bi)
        text(adresse_von(T_F_RUECKKEHR))
        solange wahr:
            assembler(ziel="x86_64", code="hlt", clobber=[])
        gib_zurück FEHLER_LADEN
