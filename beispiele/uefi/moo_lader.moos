# ============================================================
# moo_lader.moos — P7-T5: UEFI-Loader in Moo (ohne C)
# ============================================================
# Eine UEFI-App, deren gesamter Code aus diesem Moo-Quelltext stammt: kein
# uefi_entry.c, keine C-Runtime. efi_main ist eine @nativ-Funktion mit dem
# Zieldefault-ABI von x86_64-unknown-uefi (MS x64), alle Firmwaredienste
# werden ueber typisierte Funktionszeiger fn[uefi](...) gerufen.
#
# ABLAUF
#   1. COM1 einrichten, Watchdog aus (sonst Neustart nach 5 min, Befund P7-T2).
#   2. Boot-Info-Seite (MooBootInfo) und 64 KiB Arbeitsspeicher fuer den Kern.
#   3. GOP: Framebuffer, Breite, Hoehe, Stride (Pixel je Zeile), Format.
#   4. ACPI-RSDP aus der Konfigurationstabelle (ACPI 2.0, sonst 1.0).
#   5. Kern holen: (a) Uebergabe im LoadOptions-Block (MooKernUebergabe, z. B.
#      vom Netz-Lader), (b) \EFI\MOO\KERN.ELF auf dem Geraet des Laders,
#      (c) auf jedem Dateisystem.
#   6. ELF64 (EXEC, x86-64, gelinkt ab 0xFFFFFFFF80000000) laden: alle PT_LOAD
#      in einen Block freier physischer Seiten (Lage beliebig), Rest nullen;
#      eigene PML4 = Kopie der Firmware-PML4 + Abbildung der oberen Haelfte.
#   7. Speicherkarte holen, ExitBootServices (bis 4 Versuche), Karte in die
#      Boot-Info, cli, CR3 = eigene PML4, Sprung in den Kern: kern(boot_info)
#      mit SysV-ABI.
# Jede Stufe meldet "MOO-LADER ..." auf COM1 und dem QEMU-debugcon (0xE9).
#
# BAU (scripts/uefi-smoke.sh, MOO_UEFI_PRUEFUNG=kern):
#   moo-compiler compile beispiele/uefi/moo_lader.moos --no-stdlib --target x86_64-unknown-uefi -o lader.obj
#   lld-link /subsystem:efi_application /entry:efi_main /nodefaultlib /opt:ref /out:BOOTX64.EFI lader.obj
#
# QUELLEN: UEFI Spec 2.10, Kap. 4.3 (EFI_SYSTEM_TABLE), 4.4 (EFI_BOOT_SERVICES,
# Reihenfolge der Dienste), 7.2 (GetMemoryMap/ExitBootServices), 9.1
# (EFI_LOADED_IMAGE_PROTOCOL), 12.9 (GOP), 13.4/13.5 (Dateisystem/Datei),
# 4.6 (Konfigurationstabelle, ACPI-GUIDs); ELF-64 Object File Format 1.5.

# ---------------- UEFI-Tabellen (Layout aus Ziel-TargetData) ----------------
struktur EfiSystemTabelle:
    kopf_signatur: u64
    kopf_revision: u32
    kopf_groesse: u32
    kopf_crc: u32
    kopf_reserviert: u32
    hersteller: u64
    hersteller_revision: u32
    con_in_handle: u64
    con_in: u64
    con_out_handle: u64
    con_out: u64
    std_err_handle: u64
    std_err: u64
    laufzeitdienste: u64
    bootdienste: u64
    tabellen_anzahl: u64
    konfig_tabelle: u64

struktur EfiBootDienste:
    kopf_signatur: u64
    kopf_revision: u32
    kopf_groesse: u32
    kopf_crc: u32
    kopf_reserviert: u32
    bs_raise_tpl: u64
    bs_restore_tpl: u64
    bs_allocate_pages: u64
    bs_free_pages: u64
    bs_get_memory_map: u64
    bs_allocate_pool: u64
    bs_free_pool: u64
    bs_create_event: u64
    bs_set_timer: u64
    bs_wait_for_event: u64
    bs_signal_event: u64
    bs_close_event: u64
    bs_check_event: u64
    bs_install_protocol_interface: u64
    bs_reinstall_protocol_interface: u64
    bs_uninstall_protocol_interface: u64
    bs_handle_protocol: u64
    bs_reserviert: u64
    bs_register_protocol_notify: u64
    bs_locate_handle: u64
    bs_locate_device_path: u64
    bs_install_configuration_table: u64
    bs_load_image: u64
    bs_start_image: u64
    bs_exit: u64
    bs_unload_image: u64
    bs_exit_boot_services: u64
    bs_get_next_monotonic_count: u64
    bs_stall: u64
    bs_set_watchdog_timer: u64
    bs_connect_controller: u64
    bs_disconnect_controller: u64
    bs_open_protocol: u64
    bs_close_protocol: u64
    bs_open_protocol_information: u64
    bs_protocols_per_handle: u64
    bs_locate_handle_buffer: u64
    bs_locate_protocol: u64
    bs_install_multiple_protocol_interfaces: u64
    bs_uninstall_multiple_protocol_interfaces: u64
    bs_calculate_crc32: u64
    bs_copy_mem: u64
    bs_set_mem: u64
    bs_create_event_ex: u64

struktur EfiTextAusgabe:
    to_reset: u64
    to_output_string: u64

struktur EfiGop:
    gop_query_mode: u64
    gop_set_mode: u64
    gop_blt: u64
    gop_modus: u64

struktur EfiGopModus:
    gm_max_modus: u32
    gm_modus: u32
    gm_info: u64
    gm_info_groesse: u64
    gm_fb_basis: u64
    gm_fb_groesse: u64

struktur EfiGopInfo:
    gi_version: u32
    gi_breite: u32
    gi_hoehe: u32
    gi_format: u32
    gi_maske_rot: u32
    gi_maske_gruen: u32
    gi_maske_blau: u32
    gi_maske_reserviert: u32
    gi_pixel_pro_zeile: u32

struktur EfiGeladenesBild:
    li_revision: u32
    li_eltern: u64
    li_system_tabelle: u64
    li_geraet: u64
    li_datei_pfad: u64
    li_reserviert: u64
    li_optionen_groesse: u32
    li_optionen: u64
    li_bild_basis: u64
    li_bild_groesse: u64
    li_code_typ: u32
    li_daten_typ: u32
    li_entladen: u64

struktur EfiDateisystem:
    fs_revision: u64
    fs_open_volume: u64

struktur EfiDatei:
    fp_revision: u64
    fp_open: u64
    fp_close: u64
    fp_delete: u64
    fp_read: u64
    fp_write: u64
    fp_get_position: u64
    fp_set_position: u64
    fp_get_info: u64
    fp_set_info: u64
    fp_flush: u64

struktur EfiKonfigTabelle:
    kt_guid_a: u64
    kt_guid_b: u64
    kt_tabelle: u64

struktur EfiGuid:
    d1: u32
    d2: u16
    d3: u16
    d4: [u8; 8]

# ---------------- ELF64 ----------------
struktur Elf64Kopf:
    e_ident_a: u64
    e_ident_b: u64
    e_typ: u16
    e_maschine: u16
    e_version: u32
    e_einstieg: u64
    e_phoff: u64
    e_shoff: u64
    e_flags: u32
    e_ehgroesse: u16
    e_phgroesse: u16
    e_phanzahl: u16
    e_shgroesse: u16
    e_shanzahl: u16
    e_shnamen: u16

struktur Elf64Programmkopf:
    ph_typ: u32
    ph_flags: u32
    ph_versatz: u64
    ph_vadr: u64
    ph_padr: u64
    ph_dateigroesse: u64
    ph_speichergroesse: u64
    ph_ausrichtung: u64

# ---------------- Vertrag Loader -> Kern ----------------
# Gleiches Layout in beispiele/kernel/uefi_kern.moos. Alle Adressen physisch
# (UEFI bildet identisch ab; die Seitentabellen der Firmware bleiben aktiv).
struktur MooBootInfo:
    magie: u64
    version: u64
    fb_basis: u64
    fb_groesse: u64
    fb_breite: u32
    fb_hoehe: u32
    fb_stride: u32
    fb_format: u32
    karte: u64
    karte_groesse: u64
    deskriptor_groesse: u64
    deskriptor_version: u64
    acpi_rsdp: u64
    kern_basis: u64
    kern_ende: u64
    arbeit: u64
    arbeit_groesse: u64
    kern_virtuell: u64
    seitentabelle: u64

# Optionaler LoadOptions-Block eines startenden Images (z. B. Netz-Lader):
# Kern liegt bereits im Speicher.
struktur MooKernUebergabe:
    ku_magie: u64
    ku_adresse: u64
    ku_laenge: u64

@nativ
konstante BOOT_MAGIE: u64 auf 0x31544F4F424F4F4D

@nativ
konstante KERN_UEBERGABE_MAGIE: u64 auf 0x314E52454B4F4F4D

@nativ
konstante FEHLER_LADEN: u64 auf 0x8000000000000001

# Virtuelle Basis des Kerns (PML4 511, PDPT 510), siehe beispiele/kernel/linker-uefi.ld.
@nativ
konstante KERN_HOCH: u64 auf 0xFFFFFFFF80000000

# ---------------- GUIDs ----------------
@nativ
konstante GOP_GUID: EfiGuid auf EfiGuid(0x9042a9de, 0x23dc, 0x4a38, [0x96, 0xfb, 0x7a, 0xde, 0xd0, 0x80, 0x51, 0x6a])

@nativ
konstante BILD_GUID: EfiGuid auf EfiGuid(0x5b1b31a1, 0x9562, 0x11d2, [0x8e, 0x3f, 0x00, 0xa0, 0xc9, 0x69, 0x72, 0x3b])

@nativ
konstante DATEISYSTEM_GUID: EfiGuid auf EfiGuid(0x964e5b22, 0x6459, 0x11d2, [0x8e, 0x39, 0x00, 0xa0, 0xc9, 0x69, 0x72, 0x3b])

@nativ
konstante ACPI20_GUID: EfiGuid auf EfiGuid(0x8868e871, 0xe4f1, 0x11d3, [0xbc, 0x22, 0x00, 0x80, 0xc7, 0x3c, 0x88, 0x81])

@nativ
konstante ACPI10_GUID: EfiGuid auf EfiGuid(0xeb9d2d30, 0x2d88, 0x11d3, [0x9a, 0x16, 0x00, 0x90, 0x27, 0x3f, 0xc1, 0x4d])

# ---------------- Texte ----------------
