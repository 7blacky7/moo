@nativ
konstante W_START: [u16; _] auf "Moo-Lader: lade \\EFI\\MOO\\KERN.ELF\r\n"

@nativ
konstante W_OK: [u16; _] auf "Moo-Lader: Kern geladen, ExitBootServices und Sprung in den Kern ...\r\n"

@nativ
konstante W_F_SPEICHER: [u16; _] auf "Moo-Lader FEHLER: kein Speicher (Details auf COM1)\r\n"

@nativ
konstante W_F_KERN: [u16; _] auf "Moo-Lader FEHLER: Kern nicht gefunden (\\EFI\\MOO\\KERN.ELF oder moo.kern per Netz-Lader)\r\n"

@nativ
konstante W_F_ELF: [u16; _] auf "Moo-Lader FEHLER: Kern-ELF oder Seitentabelle (Details auf COM1)\r\n"

@nativ
konstante T_START: [u8; _] auf "MOO-LADER START (MOO, OHNE C)\n"

@nativ
konstante T_GOP: [u8; _] auf "MOO-LADER GOP "

@nativ
konstante T_BREITE: [u8; _] auf "MOO-LADER FB-BREITE "

@nativ
