@nativ
konstante T_STRIDE: [u8; _] auf "MOO-LADER FB-STRIDE "

@nativ
konstante T_FORMAT: [u8; _] auf "MOO-LADER FB-FORMAT "

@nativ
konstante T_KEIN_GOP: [u8; _] auf "MOO-LADER GOP FEHLT 0 "

@nativ
konstante T_RSDP: [u8; _] auf "MOO-LADER RSDP "

@nativ
konstante T_UEBERGABE: [u8; _] auf "MOO-LADER KERN AUS UEBERGABE \n"

@nativ
konstante T_DATEI: [u8; _] auf "MOO-LADER KERN-DATEI "

@nativ
konstante T_SEGMENT: [u8; _] auf "MOO-LADER SEGMENT "

@nativ
konstante T_EINSTIEG: [u8; _] auf "MOO-LADER KERN-EINSTIEG "

@nativ
konstante T_KARTE: [u8; _] auf "MOO-LADER KARTE "

@nativ
konstante T_PHYS: [u8; _] auf "MOO-LADER KERN-PHYSISCH "

@nativ
konstante T_SEITEN: [u8; _] auf "MOO-LADER SEITENTABELLE "

@nativ
