# Gemeinsamer Hardwarezugriff fuer PCI-Treiber (ADR P7-T3, Variante A).
# Aus netz_treiber.moos uebernommen; dieselben Helfer fuer Netz und USB.

# Gemeinsamer RAM-Helfer: bisheriger xHCI-Koerper, auch fuer NVMe-Queues.
# Aufrufer geben auf 8 Byte gerundete, eigene DMA-/Statusbereiche an.
@nativ
funktion nt_null(p: u64, n: u64) -> void:
    unsicher:
        setze i: u64 auf 0
        solange i < n:
            speicher_schreiben(p + i, 0, 8)
            setze i auf i + 8


@nativ
funktion nt_mmio_lese32(adresse: u64) -> u32:
    unsicher:
        setze p: ptr[u32] auf zeiger(adresse)
        gib_zurück volatile_lesen(p)

@nativ
funktion nt_mmio_schreibe32(adresse: u64, wert: u32) -> void:
    unsicher:
        setze p: ptr[u32] auf zeiger(adresse)
        volatile_schreiben(p, wert)

# Tuerklingel (Ende-Register einer Queue): erst muessen Deskriptor- und
# Pufferstores im RAM sichtbar sein, dann darf das Geraet sie lesen.
@nativ
funktion nt_mmio_glocke32(adresse: u64, wert: u32) -> void:
    unsicher:
        schreibbarriere()
        setze p: ptr[u32] auf zeiger(adresse)
        volatile_schreiben(p, wert)

aus "../kernel/kern_sperre" importiere KernSperre, spin_nimm, spin_gib

# PCI-Konfigurationsmechanismus 1. CF8 ist die gemeinsame Adressauswahl
# für CFC, daher immer beide Portzugriffe unter derselben Sperre ausführen.
@nativ
statisch NT_PCI_CFG_SPERRE: KernSperre auf 0

@nativ
funktion nt_cfg_lese32(adresse: u32) -> u32:
    unsicher:
        setze sperre: ptr[KernSperre] auf zeiger(adresse_von(NT_PCI_CFG_SPERRE))
        setze irq: u64 auf spin_nimm(sperre)
        port_schreibe32(u16(0xCF8), adresse)
        setze wert: u32 auf port_lese32(u16(0xCFC))
        spin_gib(sperre, irq)
        gib_zurück wert

@nativ
funktion nt_cfg_schreibe32(adresse: u32, wert: u32) -> void:
    unsicher:
        setze sperre: ptr[KernSperre] auf zeiger(adresse_von(NT_PCI_CFG_SPERRE))
        setze irq: u64 auf spin_nimm(sperre)
        port_schreibe32(u16(0xCF8), adresse)
        port_schreibe32(u16(0xCFC), wert)
        spin_gib(sperre, irq)

# Gemeinsame CPU-Zeitbasis fuer den Kern und seine PCI-Treiber.
@nativ
funktion takt() -> u64:
    unsicher:
        gib_zurück assembler(ziel="x86_64", code="rdtsc; shlq $$32, %rdx; orq %rdx, %rax", ausgang="={rax}", clobber=["rdx"])

