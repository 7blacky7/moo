# ============================================================
# netz_treiber.moos — P7-T14/T15: Netzwerk-Treiberrahmen in Moo
#                     mit Treibern fuer Intel e1000 und Intel I226
# ============================================================
# Laeuft im UEFI-/Bare-Profil (--no-stdlib, x86_64). Kein fremder Treibercode.
#
# EINHEITLICHE SCHNITTSTELLE (fuer den spaeteren Netzwerkstack, P1-T380):
#   nt_pci_init()                    -> pci   (ECAM aus ACPI-MCFG, sonst Port CF8/CFC)
#   nt_finde(pci, typ, k)            -> bdf des k-ten Geraets vom Typ (1 e1000, 2 I226) oder -1
#   nt_oeffnen(pci, bdf)             -> nic   (Treiber nach Typ waehlen + initialisieren), 0 = Fehler
#   nt_ports_oeffnen(pci, typ)       -> ports (Block: Anzahl @0, nic[i] @8+8i, max. 8)
#   nt_senden(nic, quelle, laenge)   -> wahr/falsch (Ethernet-Rahmen ohne FCS)
#   nt_empfangen(nic, ziel)          -> Laenge des empfangenen Rahmens oder 0
#   nt_mac(nic, i), nt_link(nic), nt_tempo(nic) (Mbit/s, 0 = kein Link)
#   nt_udp_log(nic, puffer, text)    -> UDP-Broadcast 0.0.0.0 -> 255.255.255.255:7777
#   nt_status_text(ports, puffer)    -> "I226 FEHLT" | "I226 0:- 1:2500 ..."
# Hilfen: nt_dma, nt_kopiere, pci_lese32/pci_schreibe32, nt_typ.
#
# QUELLEN
# - PCI Local Bus Spec 3.0 (Konfigurationsraum, Command-Register, BARs, Header-Typ),
#   PCI Firmware Spec 3.x + ACPI 6.x (RSDP/XSDT/MCFG).
# - e1000: Intel 8254x Family of Gigabit Ethernet Controllers Software
#   Developer's Manual (Register, Legacy-Deskriptoren).
# - I226: oeffentliches Datenblatt Intel Ethernet Controller I210, Order No.
#   333016-011 Rev. 3.7 (Jan. 2021, cdrdv2-public.intel.com/333016), da das
#   I225/I226-Datenblatt 596659 nur unter CNDA erhaeltlich ist (Entscheid
#   Koordinator/User 01.11.2026). Zeilenangaben "DS:<n>" = pdftotext -layout
#   (build/p7-t15/doku/i210.txt, sha256 PDF be7edd5e...1f18).
#   * Registertabelle DS:22633 CTRL 0x0000, DS:22634 STATUS 0x0008, DS:22742ff
#     RDBAL0 0xC000 / RDBAH0 0xC004 / RDLEN0 0xC008 / RDH0 0xC010 / RDT0 0xC018,
#     RXDCTL0 0xC028; DS:22851ff TDBAL0 0xE000 ... TXDCTL0 0xE028; IMC 0x150C,
#     ICR 0x1500; RCTL 0x0100; TCTL 0x0400; RXPBSIZE 0x2404; TXPBSIZE 0x3404;
#     DS:22819 RAL0 0x5400, RAH0 0x5404.
#   * Bits: DS:23474 CTRL.RST 26, DS:23372 CTRL.SLU 6, DS:23522 CTRL.PHY_RST 31,
#     DS:23550 STATUS.LU 1; DS:27409 RXDCTL.ENABLE 25 ("Setting this bit
#     initializes the Head and Tail registers"), DS:28767 TXDCTL.ENABLE 25;
#     DS:27153 SRRCTL.DESCTYPE 000b = Legacy (Standard); DS:16259 Legacy-RX-,
#     DS:17716 Legacy-TX-Deskriptor; DS:24073/24092 RXPBSIZE-/TXPBSIZE-Standard
#     0x22 + BMC2OS 2 bzw. TXPB0 0x14 + OS2BMC 4.
#   Abweichungen I226 gegenueber I210 (nur gelesen, nicht uebernommen):
#   * Geraete-IDs: Linux drivers/net/ethernet/intel/igc/igc_hw.h:29-33
#     (I226-LM 0x125B, -V 0x125C, -IT 0x125D, Blank-NVM 0x125F), Stand Commit
#     acb138b8235c; K 0x3102 und LMVP 0x5503 hier bewusst ausgelassen.
#   * Gleiche Registeradressen wie oben: igc_regs.h:8-9, 20-21, 51, 54, 98-126
#     (Commit f05ce73cc3b2).
#   * STATUS-Bit 22 = 2,5 Gbit/s: igc_defines.h:233 (Commit acb138b8235c).
#   * Paketpuffer-Standardwerte I225/I226 gleich I210 (0xA2 / 0x04000014):
#     igc_defines.h:426-427 und 446-448.
#   * Ablauf (Puffergroessen vor dem Reset setzen, CTRL.RST, 20 ms, SLU|ASDE,
#     ohne Link zusaetzlich PHY-Reset; Legacy-Deskriptoren; Queue-Enable):
#     iPXE src/drivers/net/intel.c:267-350, 396-440, 540-550 (Tag v2.0.0,
#     Commit 12798ec29a); auf dem N100 mit iPXE belegt (Thought 9ad7cd7a).
#
# SPEICHERMODELL: Dieser UEFI-Adapter liefert kern_alloc-RAM (identisch/DMA).
# Der gemeinsame native Treiber steht in netz_geraet.moos: 20 zusammenhaengende
# Seiten je NIC, getrennte physische DMA- und virtuelle MMIO-Adressen.
# Der Moo-Kern stellt PFA-Seiten und sein eigenes UC-Paging bereit.
# Geraeteregister und PCI-Konfiguration laufen seit P7-T18 ueber die @nativ-
# Zugriffsschicht unten (ADR P7-T3 Variante A): volatile 32-Bit-Zugriffe mit
# exakter Breite, registerfeld_lesen fuer STATUS, port_*32 fuer CF8/CFC und echte
# Barrieren (schreibbarriere vor jeder Tuerklingel, lesebarriere nach RX-DD).
# speicher_lesen/-schreiben bleibt nur fuer gewoehnlichen RAM (Zustandsblock,
# Deskriptoren, Puffer) - das ist der Uebergangsweg, kein Registerzugriff mehr.
# Nur Polling, keine Interrupts. UEFI nutzt ECAM oder CF8/CFC; der Kern nutzt
# CF8/CFC (auch im Kern-UDP-Gate mit e1000 ausgefuehrt).

# ---------------- Hardwarezugriff (@nativ, Variante A) ----------------
# Kopf des Registerblocks (8254x SDM / I210 DS:22633-22634).
aus "netz_geraet" importiere nt_status_lesen, nt_desk_fertig, nt_kopiere, nt_b8, nt_b16, pci_lese32, pci_schreibe32, nt_typ, nt_finde, nt_bar, nt_oeffnen_in, nt_warte_us, nt_port, nt_anzahl, nt_senden, nt_empfangen, nt_mac, nt_reg, nt_reg_setze, nt_reg_glocke, nt_status, nt_link, nt_tempo, nt_ringe_init, nt_tx_aufraeumen, nt_tx_gesendet, nt_tx_verworfen, nt_ring_senden, nt_ring_empfangen, e1000_eeprom, e1000_init, i226_init, nt_udp_rahmen
aus "hardware_pci" importiere takt

# DD-Bit (Bit 0) im Statusbyte eines Deskriptors (DMA-RAM, vom Geraet
# geschrieben). Ist es gesetzt, trennt die Lesebarriere es von den folgenden
# Lesezugriffen auf Laenge und Puffer.
#
# ZUSTAND je nic (192 Byte): 0 Typ, 8 MMIO, 16 bdf, 24 MAC 0-3, 32 MAC 4-5,
#   40 TX-Ring, 48 TX-Puffer, 56 TX-Ende, 64 RX-Ring, 72 RX-Puffer, 80 RX-naechster,
#   88 RX-Registerbasis, 96 TX-Registerbasis, 104 MAC gueltig (1/0),
#   112 aeltester offener TX-Deskriptor, 120 TX gesendet, 128 TX verworfen.
# Ringe: je 16 Legacy-Deskriptoren zu 16 Byte (wie iPXE), Puffer je 2048 Byte.
# TX blockiert nie: Rueckgewinnung ueber STA.DD oder TDH, bei vollem Ring
# hoechstens 2 ms warten, dann verwerfen und zaehlen (P7-T10, Befund N100 run4).

# ---------------- Speicher ----------------
funktion nt_dma(groesse):
    unsicher:
        setze roh auf kern_alloc(groesse + 128)
        wenn roh == 0:
            gib_zurück 0
        setze a auf (roh + 127) & (0 - 128)
        setze i auf 0
        solange i < groesse:
            speicher_schreiben(a + i, 0, 8)
            setze i auf i + 8
        gib_zurück a

# ---------------- PCI ----------------
# bdf = Bus << 8 | Geraet << 3 | Funktion.
# ACPI: RSDP -> XSDT (oder RSDT) -> Tabelle mit Signatur "MCFG". 0 = keine.
funktion nt_acpi_mcfg():
    unsicher:
        setze rsdp auf kern_acpi_rsdp()
        wenn rsdp == 0:
            gib_zurück 0
        setze breite auf 4
        setze sdt auf speicher_lesen(rsdp + 16, 4)
        wenn speicher_lesen(rsdp + 15, 1) >= 2 und speicher_lesen(rsdp + 24, 8) != 0:
            setze breite auf 8
            setze sdt auf speicher_lesen(rsdp + 24, 8)
        wenn sdt == 0:
            gib_zurück 0
        setze grenze auf sdt + speicher_lesen(sdt + 4, 4)
        setze p auf sdt + 36
        solange p + breite <= grenze:
            setze t auf speicher_lesen(p, breite)
            wenn t != 0 und speicher_lesen(t, 4) == 0x4746434D:
                gib_zurück t
            setze p auf p + breite
        gib_zurück 0

funktion nt_pci_init():
    unsicher:
        setze pci auf kern_alloc(32)
        speicher_schreiben(pci, 0, 8)
        speicher_schreiben(pci + 8, 0, 8)
        speicher_schreiben(pci + 16, 255, 8)
        setze mcfg auf nt_acpi_mcfg()
        # Erster Eintrag (Segment 0): Basis @44, erster Bus @54, letzter Bus @55.
        wenn mcfg != 0 und speicher_lesen(mcfg + 4, 4) >= 60:
            speicher_schreiben(pci, speicher_lesen(mcfg + 44, 8), 8)
            speicher_schreiben(pci + 8, speicher_lesen(mcfg + 54, 1), 8)
            speicher_schreiben(pci + 16, speicher_lesen(mcfg + 55, 1), 8)
        gib_zurück pci

# Treibertyp aus Vendor/Device-ID (id = Device << 16 | Vendor): 1 e1000, 2 I226, 0 unbekannt.
# k-tes Geraet (ab 0) vom Typ typ; -1 = keins.
# Kompatibel zu P7-T14: Suche nach exakter Vendor/Device-ID.
funktion nt_suche(pci, vendor, device, nummer):
    unsicher:
        setze typ auf nt_typ((device << 16) | vendor)
        wenn typ == 0:
            gib_zurück -1
        setze k auf 0
        setze bdf auf nt_finde(pci, typ, 0)
        solange bdf >= 0:
            wenn (pci_lese32(pci, bdf, 0) >> 16) == device:
                wenn k == nummer:
                    gib_zurück bdf
                setze k auf k + 1
            setze bdf auf nt_finde_nach(pci, typ, bdf)
        gib_zurück -1
# Naechstes Geraet vom Typ nach bdf (fuer nt_suche).
funktion nt_finde_nach(pci, typ, bdf):
    unsicher:
        setze i auf 0
        setze b auf nt_finde(pci, typ, 0)
        solange b >= 0 und b != bdf:
            setze i auf i + 1
            setze b auf nt_finde(pci, typ, i)
        wenn b < 0:
            gib_zurück -1
        gib_zurück nt_finde(pci, typ, i + 1)
# ---------------- Rahmen: Oeffnen, Dispatch ----------------
# UEFI-Adapter: ein zusammenhaengender Block; der Kern gibt eigene PFA-Seiten.
funktion nt_oeffnen(pci, bdf):
    unsicher:
        wenn bdf < 0:
            gib_zurück 0
        setze mmio auf nt_bar(pci, bdf)
        wenn mmio == 0:
            gib_zurück 0
        setze nic auf nt_dma(20 * 4096)
        wenn nic == 0:
            gib_zurück 0
        setze anfang auf takt()
        kern_warte_us(1000)
        setze tsc_us auf (takt() - anfang) / 1000
        wenn nicht nt_oeffnen_in(pci, bdf, nic, mmio, tsc_us):
            gib_zurück 0
        gib_zurück nic

# Gemeinsame physische BAR-Ermittlung, noch ohne Registerzugriff.
# nic: 20 genullte zusammenhaengende DMA-Seiten (identisch abgebildetes RAM).
# mmio darf eine getrennte virtuelle UC-Abbildung der physischen BAR sein.
# Kein Firmwareaufruf: Zeitbasis ist der vom Aufrufer kalibrierte TSC.
# Alle Geraete eines Typs oeffnen (max. 8). Auch Ports, deren Init scheitert,
# zaehlen nicht; @0 Anzahl offener Ports, @8+8i nic.
funktion nt_ports_oeffnen(pci, typ):
    unsicher:
        setze ports auf nt_dma(80)
        setze n auf 0
        setze k auf 0
        setze bdf auf nt_finde(pci, typ, 0)
        solange bdf >= 0 und n < 8:
            setze nic auf nt_oeffnen(pci, bdf)
            wenn nic != 0:
                speicher_schreiben(ports + 8 + n * 8, nic, 8)
                setze n auf n + 1
            setze k auf k + 1
            setze bdf auf nt_finde(pci, typ, k)
        speicher_schreiben(ports, n, 8)
        gib_zurück ports

# Registerzugriff ueber die @nativ-Schicht; nic + 8 ist RAM (Zustandsblock).
# Ende-Register (Tuerklingel) mit Schreibbarriere davor.
# STATUS (0x0008) Bit 1 = LU, bei e1000 (8254x SDM) und I210/I226 (DS:23550) gleich.
# Geschwindigkeit in Mbit/s, 0 = kein Link. STATUS Bits 7:6: 00 10, 01 100,
# 1x 1000; beim I226 zusaetzlich Bit 22 = 2500 (igc_defines.h:233).
# ---------------- Gemeinsame Ringlogik (Legacy-Deskriptoren) ----------------
# Registerblock je Queue ab basis: +0 BAL, +4 BAH, +8 LEN, +0x10 Kopf, +0x18 Ende,
# +0x28 Queue-Steuerung (nur I226: ENABLE Bit 25, setzt Kopf/Ende zurueck).
# TX-Rueckgewinnung: Deskriptoren ab dem aeltesten offenen (nic+112) gelten als
# erledigt, wenn die Hardware STA.DD gesetzt hat ODER das Kopfregister TDH schon
# dahinter steht (alles vor dem Kopf ist verarbeitet). Beides, weil sich das
# Zurueckschreiben von DD je nach Schwellwerten verzoegern kann.
# ---------------- e1000 (Intel 8254x) ----------------
# EEPROM-Wort ueber EERD (0x0014): Start Bit 0, Adresse Bits 15:8, Fertig Bit 4, Daten 31:16.
# ---------------- I226 (Grundlage I210-DS 333016, Quellen siehe Kopf) ----------------
# Logzeile als UDP-Broadcast nur auf Ports mit Link senden; Ports ohne Link
# werden nicht befuellt. Rueckgabe: Anzahl Ports, auf denen gesendet wurde.
funktion nt_log(ports, puffer, text):
    unsicher:
        setze n auf 0
        setze i auf 0
        solange i < nt_anzahl(ports):
            setze nic auf nt_port(ports, i)
            wenn nt_link(nic):
                wenn nt_udp_log(nic, puffer, text):
                    setze n auf n + 1
            setze i auf i + 1
        gib_zurück n
# Multicast-Rahmen annehmen (RCTL.MPE, Bit 4; 8254x SDM und I210-DS gleich),
# z. B. fuer den Empfangstest mit "ping -6 ff02::1" vom Linux-PC (P7-T10).
funktion nt_multicast_an(nic):
    unsicher:
        wenn nic != 0:
            nt_reg_setze(nic, 0x0100, nt_reg(nic, 0x0100) | 0x10)
# ---------------- Rahmenbau: UDP-Log und Statustext ----------------
# Ethernet-Broadcast + IPv4 0.0.0.0 -> 255.255.255.255 + UDP 7777 -> 7777.
# Nutzlast liegt bereits bei puffer + 42 (laenge Byte). Rueckgabe: Rahmenlaenge.
funktion nt_udp_log(nic, puffer, text):
    unsicher:
        setze laenge auf kern_text_in_puffer(text, puffer + 42, 1472)
        wenn laenge <= 0:
            gib_zurück falsch
        gib_zurück nt_senden(nic, puffer, nt_udp_rahmen(puffer, nic, laenge))
# Dezimalzahl ab off schreiben, neue Position zurueck.
funktion nt_dez(p, off, wert):
    unsicher:
        setze stellen auf 1
        setze t auf 10
        solange wert >= t:
            setze stellen auf stellen + 1
            setze t auf t * 10
        setze i auf stellen - 1
        setze rest auf wert
        solange i >= 0:
            nt_b8(p, off + i, 48 + (rest % 10))
            setze rest auf (rest - (rest % 10)) / 10
            setze i auf i - 1
        gib_zurück off + stellen
# "I226 FEHLT" ohne Ports, sonst "I226 0:- 1:2500 2:-" (Port:Tempo bzw. - ohne Link).
funktion nt_status_text(ports, puffer):
    unsicher:
        nt_b8(puffer, 0, 73)
        nt_b8(puffer, 1, 50)
        nt_b8(puffer, 2, 50)
        nt_b8(puffer, 3, 54)
        setze o auf 4
        setze n auf nt_anzahl(ports)
        wenn n == 0:
            # " FEHLT"
            nt_b8(puffer, 4, 32)
            nt_b8(puffer, 5, 70)
            nt_b8(puffer, 6, 69)
            nt_b8(puffer, 7, 72)
            nt_b8(puffer, 8, 76)
            nt_b8(puffer, 9, 84)
            gib_zurück kern_text_aus_puffer(puffer, 10)
        setze i auf 0
        solange i < n:
            nt_b8(puffer, o, 32)
            setze o auf nt_dez(puffer, o + 1, i)
            nt_b8(puffer, o, 58)
            setze tempo auf nt_tempo(nt_port(ports, i))
            wenn tempo == 0:
                nt_b8(puffer, o + 1, 45)
                setze o auf o + 2
            sonst:
                setze o auf nt_dez(puffer, o + 1, tempo)
            setze i auf i + 1
        # Summe gesendet/verworfen ueber alle Ports (Diagnose).
        setze tx auf 0
        setze verw auf 0
        setze i auf 0
        solange i < n:
            setze tx auf tx + nt_tx_gesendet(nt_port(ports, i))
            setze verw auf verw + nt_tx_verworfen(nt_port(ports, i))
            setze i auf i + 1
        nt_b8(puffer, o, 32)
        nt_b8(puffer, o + 1, 84)
        nt_b8(puffer, o + 2, 88)
        nt_b8(puffer, o + 3, 32)
        setze o auf nt_dez(puffer, o + 4, tx)
        nt_b8(puffer, o, 47)
        setze o auf nt_dez(puffer, o + 1, verw)
        gib_zurück kern_text_aus_puffer(puffer, o)