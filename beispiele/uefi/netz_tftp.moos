# ============================================================
# netz_tftp.moos — P7-T10: ARP/IPv4/UDP-Minimum und TFTP-Client in Moo
# ============================================================
# Fuer den Netz-Lader (netz_lader.moos). Baut auf netz_treiber.moos auf
# (nt_senden/nt_empfangen/nt_mac). Bewusst nur das Noetigste; der vollstaendige
# Stack ist P1-T380.
#
# Grundlagen: RFC 826 (ARP), RFC 791 (IPv4, Kopfpruefsumme), RFC 768 (UDP,
# Pruefsumme 0 = keine), RFC 1350 (TFTP: RRQ/DATA/ACK/ERROR, octet),
# RFC 2347/2348/2349 (OACK, blksize, tsize). CRC32 (IEEE 802.3, Polynom
# 0xEDB88320 reflektiert) wie im gzip-Trailer (RFC 1952), damit der Host den
# Wert ohne Zusatzpakete erzeugen kann.
#
# KONTEXT ctx (256 Byte, Felder als u64):
#   0 nic, 8 eigene IP, 16 Server-IP, 24 Server-MAC 0-3, 32 Server-MAC 4-5,
#   40 Server-MAC bekannt, 48 Sendepuffer, 56 Empfangspuffer, 64 Rahmen empfangen,
#   72 eigener UDP-Port, 80 Server-TID (Port), 88 ARP-Antworten gesendet,
#   96 Nutzlast-Offset, 104 Nutzlast-Quellport,
#   112 erwarteter Block, 120 Bytes empfangen, 128 blksize, 136 tsize,
#   144 Leerlauf-Zaehler, 152 Wiederholungen, 160 Status, 168 Fehlercode,
#   176 letzte Sendung (1 RRQ, 4 ACK), 184 letzter ACK-Block,
#   192 RRQ-Puffer, 200 RRQ-Laenge, 208 Ziel, 216 Ziel-Maximum.
# IP-Adressen als Zahl a<<24|b<<16|c<<8|d.

# Nutzt aus netz_treiber.moos: nt_senden, nt_empfangen, nt_mac, nt_dma, nt_b8,
# nt_b16, nt_kopiere. Der Aufrufer importiert beide Module (Module werden
# inline eingefuegt; doppelter Import wuerde Funktionen doppelt definieren).

funktion nn_ip(a, b, c, d):
    gib_zurück (a << 24) | (b << 16) | (c << 8) | d

funktion nn_r8(p, o):
    unsicher:
        gib_zurück speicher_lesen(p + o, 1)

funktion nn_r16(p, o):
    gib_zurück (nn_r8(p, o) << 8) | nn_r8(p, o + 1)

funktion nn_r32(p, o):
    gib_zurück (nn_r16(p, o) << 16) | nn_r16(p, o + 2)

funktion nn_b32(p, o, wert):
    nt_b16(p, o, (wert >> 16) & 0xFFFF)
    nt_b16(p, o + 2, wert & 0xFFFF)

funktion nn_feld(ctx, o):
    unsicher:
        gib_zurück speicher_lesen(ctx + o, 8)

funktion nn_setze(ctx, o, wert):
    unsicher:
        speicher_schreiben(ctx + o, wert, 8)

funktion nn_kontext(nic, eigene_ip, server_ip):
    setze ctx auf nt_dma(256)
    nn_setze(ctx, 0, nic)
    nn_setze(ctx, 8, eigene_ip)
    nn_setze(ctx, 16, server_ip)
    nn_setze(ctx, 48, nt_dma(2048))
    nn_setze(ctx, 56, nt_dma(2048))
    nn_setze(ctx, 192, nt_dma(512))
    nn_setze(ctx, 72, 49152)
    gib_zurück ctx

# Ethernet-Kopf: Ziel-MAC (lo = Byte 0-3, hi = Byte 4-5, wie im nic-Block), eigene MAC, Typ.
funktion nn_eth(ctx, p, lo, hi, typ):
    setze nic auf nn_feld(ctx, 0)
    setze i auf 0
    solange i < 6:
        wenn i < 4:
            nt_b8(p, i, (lo >> (i * 8)) & 255)
        sonst:
            nt_b8(p, i, (hi >> ((i - 4) * 8)) & 255)
        nt_b8(p, 6 + i, nt_mac(nic, i))
        setze i auf i + 1
    nt_b16(p, 12, typ)

# MAC aus 6 Bytes ab p+o als (lo, hi) in ctx-Felder schreiben.
funktion nn_mac_merken(ctx, p, o, feld):
    setze lo auf nn_r8(p, o) | (nn_r8(p, o + 1) << 8) | (nn_r8(p, o + 2) << 16) | (nn_r8(p, o + 3) << 24)
    setze hi auf nn_r8(p, o + 4) | (nn_r8(p, o + 5) << 8)
    nn_setze(ctx, feld, lo)
    nn_setze(ctx, feld + 8, hi)

# ARP: op 1 Anfrage (an Broadcast), op 2 Antwort (an Anfrager).
funktion nn_arp(ctx, op, ziel_lo, ziel_hi, ziel_ip):
    setze p auf nn_feld(ctx, 48)
    setze nic auf nn_feld(ctx, 0)
    nn_eth(ctx, p, ziel_lo, ziel_hi, 0x0806)
    nt_b16(p, 14, 1)
    nt_b16(p, 16, 0x0800)
    nt_b8(p, 18, 6)
    nt_b8(p, 19, 4)
    nt_b16(p, 20, op)
    setze i auf 0
    solange i < 6:
        nt_b8(p, 22 + i, nt_mac(nic, i))
        wenn op == 1:
            nt_b8(p, 32 + i, 0)
        sonst:
            wenn i < 4:
                nt_b8(p, 32 + i, (ziel_lo >> (i * 8)) & 255)
            sonst:
                nt_b8(p, 32 + i, (ziel_hi >> ((i - 4) * 8)) & 255)
        setze i auf i + 1
    nn_b32(p, 28, nn_feld(ctx, 8))
    nn_b32(p, 38, ziel_ip)
    gib_zurück nt_senden(nic, p, 42)

funktion nn_arp_anfrage(ctx):
    gib_zurück nn_arp(ctx, 1, 0xFFFFFFFF, 0xFFFF, nn_feld(ctx, 16))

# IPv4-Kopfpruefsumme (Einerkomplement der 16-Bit-Summe ueber 20 Byte ab p+o).
funktion nn_ip_pruefsumme(p, o):
    setze summe auf 0
    setze i auf 0
    solange i < 20:
        setze summe auf summe + nn_r16(p, o + i)
        setze i auf i + 2
    solange summe > 0xFFFF:
        setze summe auf (summe & 0xFFFF) + (summe >> 16)
    gib_zurück 0xFFFF - summe

# Unicast-UDP an den Server; Nutzlast liegt schon ab Sendepuffer + 42.
funktion nn_udp_senden(ctx, sport, dport, laenge):
    setze p auf nn_feld(ctx, 48)
    nn_eth(ctx, p, nn_feld(ctx, 24), nn_feld(ctx, 32), 0x0800)
    nt_b8(p, 14, 0x45)
    nt_b8(p, 15, 0)
    nt_b16(p, 16, 20 + 8 + laenge)
    nt_b16(p, 18, 0)
    nt_b16(p, 20, 0x4000)
    nt_b8(p, 22, 64)
    nt_b8(p, 23, 17)
    nt_b16(p, 24, 0)
    nn_b32(p, 26, nn_feld(ctx, 8))
    nn_b32(p, 30, nn_feld(ctx, 16))
    nt_b16(p, 24, nn_ip_pruefsumme(p, 14))
    nt_b16(p, 34, sport)
    nt_b16(p, 36, dport)
    nt_b16(p, 38, 8 + laenge)
    nt_b16(p, 40, 0)
    gib_zurück nt_senden(nn_feld(ctx, 0), p, 42 + laenge)

# Einen Rahmen abholen und auswerten. Rueckgabe: Laenge der UDP-Nutzlast fuer
# unseren Port vom Server (Offset/Quellport in ctx 96/104), sonst 0.
funktion nn_poll(ctx):
    setze r auf nn_feld(ctx, 56)
    setze n auf nt_empfangen(nn_feld(ctx, 0), r)
    wenn n <= 0:
        gib_zurück 0
    nn_setze(ctx, 64, nn_feld(ctx, 64) + 1)
    setze typ auf nn_r16(r, 12)
    wenn typ == 0x0806 und n >= 42:
        setze op auf nn_r16(r, 20)
        # Anfrage nach unserer IP beantworten (sonst erreicht uns der Server nicht).
        wenn op == 1 und nn_r32(r, 38) == nn_feld(ctx, 8):
            setze lo auf nn_r8(r, 22) | (nn_r8(r, 23) << 8) | (nn_r8(r, 24) << 16) | (nn_r8(r, 25) << 24)
            setze hi auf nn_r8(r, 26) | (nn_r8(r, 27) << 8)
            nn_arp(ctx, 2, lo, hi, nn_r32(r, 28))
            nn_setze(ctx, 88, nn_feld(ctx, 88) + 1)
        wenn op == 2 und nn_r32(r, 28) == nn_feld(ctx, 16):
            nn_mac_merken(ctx, r, 22, 24)
            nn_setze(ctx, 40, 1)
        gib_zurück 0
    wenn typ != 0x0800 oder n < 42:
        gib_zurück 0
    setze ihl auf (nn_r8(r, 14) & 15) * 4
    wenn nn_r8(r, 23) != 17 oder nn_r32(r, 30) != nn_feld(ctx, 8) oder nn_r32(r, 26) != nn_feld(ctx, 16):
        gib_zurück 0
    # Fragmente (MF oder Offset) werden nicht unterstuetzt.
    wenn (nn_r16(r, 20) & 0x3FFF) != 0:
        gib_zurück 0
    setze u auf 14 + ihl
    wenn nn_r16(r, u + 2) != nn_feld(ctx, 72):
        gib_zurück 0
    setze laenge auf nn_r16(r, u + 4) - 8
    wenn laenge < 0 oder u + 8 + laenge > n:
        gib_zurück 0
    nn_setze(ctx, 96, u + 8)
    nn_setze(ctx, 104, nn_r16(r, u))
    gib_zurück laenge

# ARP-Aufloesung der Server-MAC: Anfrage, dann bis zu ms Millisekunden lauschen.
funktion nn_arp_aufloesen(ctx, ms):
    nn_setze(ctx, 40, 0)
    nn_arp_anfrage(ctx)
    setze t auf 0
    solange t < ms * 5:
        nn_poll(ctx)
        wenn nn_feld(ctx, 40) == 1:
            gib_zurück wahr
        kern_warte_us(200)
        setze t auf t + 1
    gib_zurück falsch

# ---------------- TFTP (RFC 1350, Optionen RFC 2347-2349) ----------------
# Text an Position o in p schreiben (mit 0-Byte), neue Position zurueck.
funktion nn_tz(p, o, text):
    setze n auf kern_text_in_puffer(text, p + o, 256)
    nt_b8(p, o + n, 0)
    gib_zurück o + n + 1

# Anfrage vorbereiten und senden. ziel/max: Zielpuffer fuer die Datei.
funktion nn_tftp_start(ctx, name, ziel, max):
    setze q auf nn_feld(ctx, 192)
    nt_b16(q, 0, 1)
    setze o auf nn_tz(q, 2, name)
    setze o auf nn_tz(q, o, "octet")
    setze o auf nn_tz(q, o, "blksize")
    setze o auf nn_tz(q, o, "1428")
    setze o auf nn_tz(q, o, "tsize")
    setze o auf nn_tz(q, o, "0")
    nn_setze(ctx, 200, o)
    # Neuer Quellport je Uebertragung (TID).
    nn_setze(ctx, 72, 49152 + ((nn_feld(ctx, 72) - 49152 + 1) % 8000))
    nn_setze(ctx, 80, 0)
    nn_setze(ctx, 112, 1)
    nn_setze(ctx, 120, 0)
    nn_setze(ctx, 128, 512)
    nn_setze(ctx, 136, 0)
    nn_setze(ctx, 144, 0)
    nn_setze(ctx, 152, 0)
    nn_setze(ctx, 160, 0)
    nn_setze(ctx, 168, 0)
    nn_setze(ctx, 208, ziel)
    nn_setze(ctx, 216, max)
    nn_tftp_rrq(ctx)

funktion nn_tftp_rrq(ctx):
    setze p auf nn_feld(ctx, 48)
    nt_kopiere(p + 42, nn_feld(ctx, 192), nn_feld(ctx, 200))
    nn_setze(ctx, 176, 1)
    nn_udp_senden(ctx, nn_feld(ctx, 72), 69, nn_feld(ctx, 200))

funktion nn_tftp_ack(ctx, block):
    setze p auf nn_feld(ctx, 48)
    nt_b16(p, 42, 4)
    nt_b16(p, 44, block)
    nn_setze(ctx, 176, 4)
    nn_setze(ctx, 184, block)
    nn_udp_senden(ctx, nn_feld(ctx, 72), nn_feld(ctx, 80), 4)

# Dezimalzahl aus Bytes ab p+o (bis 0-Byte oder Ende e).
funktion nn_dez_lesen(p, o, e):
    setze wert auf 0
    solange o < e und nn_r8(p, o) >= 48 und nn_r8(p, o) <= 57:
        setze wert auf wert * 10 + (nn_r8(p, o) - 48)
        setze o auf o + 1
    gib_zurück wert

# OACK auswerten: Paare "name\0wert\0"; blksize/tsize an Anfangsbuchstabe erkannt.
funktion nn_oack(ctx, p, o, e):
    solange o < e:
        setze k auf nn_r8(p, o)
        setze start auf o
        solange o < e und nn_r8(p, o) != 0:
            setze o auf o + 1
        setze o auf o + 1
        setze wert auf nn_dez_lesen(p, o, e)
        solange o < e und nn_r8(p, o) != 0:
            setze o auf o + 1
        setze o auf o + 1
        wenn k == 98 oder k == 66:
            nn_setze(ctx, 128, wert)
        wenn k == 116 oder k == 84:
            nn_setze(ctx, 136, wert)

# Einen Schritt der Uebertragung. Rueckgabe: 0 laeuft, 1 fertig, <0 Fehler
# (-1 Ziel zu klein, -2 Zeitueberschreitung, -5 TFTP-ERROR, Code in ctx 168).
funktion nn_tftp_schritt(ctx):
    setze n auf nn_poll(ctx)
    wenn n < 4:
        # Leerlauf: nach ~0,5 s letzte Sendung wiederholen, nach 12 Versuchen aufgeben.
        kern_warte_us(100)
        nn_setze(ctx, 144, nn_feld(ctx, 144) + 1)
        wenn nn_feld(ctx, 144) >= 5000:
            nn_setze(ctx, 144, 0)
            nn_setze(ctx, 152, nn_feld(ctx, 152) + 1)
            wenn nn_feld(ctx, 152) > 12:
                gib_zurück -2
            wenn nn_feld(ctx, 176) == 1:
                nn_tftp_rrq(ctx)
            sonst:
                nn_tftp_ack(ctx, nn_feld(ctx, 184))
        gib_zurück 0
    setze r auf nn_feld(ctx, 56)
    setze o auf nn_feld(ctx, 96)
    setze quelle auf nn_feld(ctx, 104)
    # Erste Antwort legt den Server-TID fest; fremde TIDs ignorieren.
    wenn nn_feld(ctx, 80) == 0:
        nn_setze(ctx, 80, quelle)
    wenn quelle != nn_feld(ctx, 80):
        gib_zurück 0
    nn_setze(ctx, 144, 0)
    nn_setze(ctx, 152, 0)
    setze op auf nn_r16(r, o)
    wenn op == 5:
        nn_setze(ctx, 168, nn_r16(r, o + 2))
        gib_zurück -5
    wenn op == 6:
        nn_oack(ctx, r, o + 2, o + n)
        nn_tftp_ack(ctx, 0)
        gib_zurück 0
    wenn op != 3:
        gib_zurück 0
    setze block auf nn_r16(r, o + 2)
    setze daten auf n - 4
    wenn block == nn_feld(ctx, 112):
        setze bisher auf nn_feld(ctx, 120)
        wenn bisher + daten > nn_feld(ctx, 216):
            gib_zurück -1
        nt_kopiere(nn_feld(ctx, 208) + bisher, r + o + 4, daten)
        nn_setze(ctx, 120, bisher + daten)
        nn_tftp_ack(ctx, block)
        nn_setze(ctx, 112, (block + 1) % 65536)
        wenn daten < nn_feld(ctx, 128):
            gib_zurück 1
        gib_zurück 0
    # Doppelter Block (unser ACK ging verloren): ACK wiederholen.
    nn_tftp_ack(ctx, block)
    gib_zurück 0

# ---------------- CRC32 (wie gzip) ----------------
funktion nn_crc_tabelle():
    unsicher:
        setze tab auf nt_dma(1024)
        setze n auf 0
        solange n < 256:
            setze c auf n
            setze k auf 0
            solange k < 8:
                wenn (c & 1) != 0:
                    setze c auf 0xEDB88320 ^ (c >> 1)
                sonst:
                    setze c auf c >> 1
                setze k auf k + 1
            speicher_schreiben(tab + n * 4, c, 4)
            setze n auf n + 1
        gib_zurück tab

funktion nn_crc32(tab, adresse, laenge):
    unsicher:
        setze c auf 0xFFFFFFFF
        setze i auf 0
        solange i < laenge:
            setze c auf speicher_lesen(tab + ((c ^ speicher_lesen(adresse + i, 1)) & 255) * 4, 4) ^ (c >> 8)
            setze i auf i + 1
        gib_zurück c ^ 0xFFFFFFFF
