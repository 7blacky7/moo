zeige "Starte..."
setze server auf nichts
versuche:
    setze server auf web_server(8080)
fange fehler:
    zeige "Server konnte nicht gestartet werden (Port 8080): " + text(fehler)
wenn server == nichts:
    beende(0)
zeige "Server laeuft auf 8080"
solange wahr:
    setze req auf server.web_annehmen()
    zeige "Request!"
    server.antworten(req, "Hallo von moo!")
