# Linux-Werkzeug für neue reguläre Bilddateien; vorhandene Ziele bleiben erhalten.
# Aufruf über skripte/p11/moofs/mkfs.sh. Format-/Baumlogik liegt in der stdlib.
aus ds_moofs_format importiere MooFsQuelle, MooFsFormatSpeicher, moofs_formatieren
aus ds_moofs importiere MooFsFehler, MOOFS_ARGUMENT, MOOFS_EA
aus ds_fat_posix importiere FatPosix, fat_posix_einrichten, lseek
aus ds_fat_transport importiere FatTransport
extern "C" funktion getenv(name: ptr[u8]) -> ptr[u8]
extern "C" funktion open(name: ptr[u8], flags: i32, modus: u32) -> i32
extern "C" funktion close(fd: i32) -> i32
extern "C" funktion ftruncate(fd: i32, bytes: i64) -> i32
extern "C" funktion mmap(hinweis: ptr[u8], bytes: u64, schutz: i32, flags: i32, fd: i32, offset: i64) -> ptr[u8]
extern "C" funktion munmap(basis: ptr[u8], bytes: u64) -> i32
extern "C" funktion getrandom(basis: ptr[u8], bytes: u64, flags: u32) -> i64
@nativ
statisch MOOFS_MKFS_ARBEIT: MooFsFormatSpeicher auf 0
@nativ
konstante MOOFS_ENV_BILD: [u8; _] auf "MOO_MOOFS_BILD"
@nativ
konstante MOOFS_ENV_BYTES: [u8; _] auf "MOO_MOOFS_BYTES"
@nativ
konstante MOOFS_ENV_QUELLE: [u8; _] auf "MOO_MOOFS_QUELLE"
@nativ
konstante MOOFS_ENV_NAME: [u8; _] auf "MOO_MOOFS_NAME"
@nativ
funktion moofs_mkfs_close(fd: i32) -> void:
    unsicher:
        setze status: i32 auf close(fd)
@nativ
funktion moofs_mkfs_unmap(basis: ptr[u8], bytes: u64) -> void:
    unsicher:
        wenn bytes != 0:
            setze status: i32 auf munmap(basis, bytes)
@nativ
funktion moofs_mkfs_ablauf() -> ergebnis[void, MooFsFehler]:
    unsicher:
        setze bild: ptr[u8] auf getenv(zeiger(adresse_von(MOOFS_ENV_BILD)))
        setze zahl: ptr[u8] auf getenv(zeiger(adresse_von(MOOFS_ENV_BYTES)))
        wenn u64(bild) == 0 oder u64(zahl) == 0:
            gib_zurück fehlschlag(MooFsFehler(MOOFS_ARGUMENT, 200, 0))
        setze bytes: u64 auf 0
        setze i: u64 auf 0
        solange i < 20 und zahl[i] != 0:
            wenn zahl[i] < 48 oder zahl[i] > 57:
                gib_zurück fehlschlag(MooFsFehler(MOOFS_ARGUMENT, 201, 0))
            setze ziffer: u64 auf u64(zahl[i] - 48)
            wenn bytes > (0x7FFFFFFFFFFFFFFF - ziffer) / 10:
                gib_zurück fehlschlag(MooFsFehler(MOOFS_ARGUMENT, 202, 0))
            setze bytes auf bytes * 10 + ziffer
            setze i auf i + 1
        wenn i == 0 oder i == 20 oder bytes < 16384 oder bytes % 4096 != 0:
            gib_zurück fehlschlag(MooFsFehler(MOOFS_ARGUMENT, 203, 0))
        setze quelle: ptr[u8] auf getenv(zeiger(adresse_von(MOOFS_ENV_QUELLE)))
        setze name: ptr[u8] auf getenv(zeiger(adresse_von(MOOFS_ENV_NAME)))
        setze q: MooFsQuelle auf 0
        setze qp: ptr[MooFsQuelle] auf zeiger(adresse_von(q))
        setze anzahl: u64 auf 0
        setze mapping: ptr[u8] auf nichts
        wenn u64(quelle) != 0 und quelle[0] != 0:
            wenn u64(name) == 0:
                gib_zurück fehlschlag(MooFsFehler(MOOFS_ARGUMENT, 204, 0))
            setze i auf 0
            solange i < 256 und name[i] != 0:
                setze q.name[i] auf name[i]
                setze i auf i + 1
            wenn i == 256:
                gib_zurück fehlschlag(MooFsFehler(MOOFS_ARGUMENT, 205, 0))
            setze q.nummer auf 2
            setze q.eltern auf 1
            setze q.art auf 1
            setze q.name_bytes auf i
            setze input: i32 auf open(quelle, 0, 0)
            wenn input < 0:
                gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, 206, 0))
            aufräumen: moofs_mkfs_close(input)
            setze laenge: i64 auf lseek(input, 0, 2)
            wenn laenge < 0:
                gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, 207, 0))
            setze q.bytes auf u64(laenge)
            wenn laenge > 0:
                setze mapping auf mmap(nichts, q.bytes, 1, 2, input, 0)
                wenn u64(mapping) == 0xFFFFFFFFFFFFFFFF:
                    gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, 208, 0))
                setze q.daten auf u64(mapping)
            aufräumen: moofs_mkfs_unmap(mapping, q.bytes)
            setze anzahl auf 1
            # Formatierung muss innerhalb der geliehenen Mapping-Lebensdauer liegen.
            gib_zurück moofs_mkfs_schreiben(bild, bytes, qp, anzahl)
        gib_zurück moofs_mkfs_schreiben(bild, bytes, qp, anzahl)

@nativ
funktion moofs_mkfs_schreiben(bild: ptr[u8], bytes: u64, quelle: ptr[MooFsQuelle], anzahl: u64) -> ergebnis[void, MooFsFehler]:
    unsicher:
        # O_EXCL schützt vorhandene Dateien und Geräte vor Überschreiben.
        setze fd: i32 auf open(bild, 194, 384)
        wenn fd < 0:
            gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, 209, 0))
        aufräumen: moofs_mkfs_close(fd)
        wenn ftruncate(fd, i64(bytes)) != 0:
            gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, 210, 0))
        setze adapter: FatPosix auf 0
        setze a: ptr[FatPosix] auf zeiger(adresse_von(adapter))
        setze ok: bool auf ist_erfolg(fat_posix_einrichten(a, fd, 512, falsch))
        wenn nicht ok:
            gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, 211, 0))
        setze uuid: [u64; 2] auf [0, 0]
        setze p: ptr[u8] auf zeiger(adresse_von(uuid))
        setze fertig: u64 auf 0
        solange fertig < 16:
            setze n: i64 auf getrandom(zeiger(u64(p) + fertig), 16 - fertig, 0)
            wenn n <= 0 oder u64(n) > 16 - fertig:
                gib_zurück fehlschlag(MooFsFehler(MOOFS_EA, 212, 0))
            setze fertig auf fertig + u64(n)
        setze transport: ptr[dyn FatTransport] auf a
        gib_zurück moofs_formatieren(transport, quelle, anzahl, uuid[0], uuid[1], zeiger(adresse_von(MOOFS_MKFS_ARBEIT)))

@nativ
funktion moofs_mkfs() -> u64:
    unsicher:
        setze r: ergebnis[void, MooFsFehler] auf moofs_mkfs_ablauf()
        wenn nicht ist_erfolg(r):
            setze f: MooFsFehler auf ergebnis_fehler(r)
            gib_zurück u64(f.code) * 1000 + u64(f.grund)
        gib_zurück 0

# FEHLERPFAD(M-F001): Werkzeug beendet sich bei unerwarteten Sprachfehlern.
unsicher:
    setze status auf moofs_mkfs()
    wenn status != 0:
        zeige "mkfs MooFS Fehler: " + text(status)
        beende(1)
    zeige "MooFS formatiert"
