setze a auf []
setze b auf []
setze c auf []
setze i auf 0
solange i < 10000000:
    a.hinzufügen(i % 100)
    b.hinzufügen(i % 100)
    setze i auf i + 1
setze i auf 0
solange i < 10000000:
    c.hinzufügen(a[i] + b[i])
    setze i auf i + 1
setze i auf 0
setze s auf 0
solange i < 10000000:
    setze s auf s + c[i]
    setze i auf i + 1
zeige s
