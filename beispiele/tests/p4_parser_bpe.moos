# Parser-BPE: deterministisches Artefakt und bytegenauer Roundtrip.
setze text auf "Äpfel und Birnen. Äpfel und Birnen.\n```moo\n  setze x auf 42\n```\n"
setze a auf tokenizer_trainiere_parser(text, 300)
setze b auf tokenizer_trainiere_parser(text, 300)
wenn tokenizer_hash(a) != tokenizer_hash(b):
    wirf "Parser-Tokenizer nicht deterministisch"
setze ids auf tokenizer_kodiere(a, text)
wenn tokenizer_dekodiere(a, ids) != text:
    wirf "Parser-Roundtrip"
setze pfad auf umgebung("P4_PARSER_TOKENIZER_PFAD")
tokenizer_speichern(a, pfad)
setze geladen auf tokenizer_laden(pfad)
wenn tokenizer_hash(a) != tokenizer_hash(geladen):
    wirf "Parser-Speichern/Laden"
wenn tokenizer_dekodiere(geladen, tokenizer_kodiere(geladen, text)) != text:
    wirf "Parser-Roundtrip nach Laden"
zeige "PARSER BPE OK"
