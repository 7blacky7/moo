funktion generiere(schichten, anfragen):
    setze ergebnisse auf []
    für ursprung in anfragen["prompts"]:
        setze prefix auf []
        für id in ursprung:
            prefix.hinzufügen(id)
        setze erzeugt auf []
        setze schritt auf 0
        solange schritt < 12:
            setze kontext auf []
            wenn länge(prefix) < 64:
                kontext.hinzufügen(0)
                für id in prefix:
                    kontext.hinzufügen(id)
            sonst:
                setze i auf länge(prefix) - 63
                solange i < länge(prefix):
                    kontext.hinzufügen(prefix[i])
                    setze i auf i + 1
            setze x auf vorwaerts([schichten[0]], tensor_aus_liste(kontext))
            setze x auf vorwaerts([schichten[1]], x)
            setze x auf x + vorwaerts([schichten[2], schichten[3]], x)
            setze x auf x + vorwaerts([schichten[4], schichten[5], schichten[6]], x)
            setze x auf x + vorwaerts([schichten[7], schichten[8]], x)
            setze x auf x + vorwaerts([schichten[9], schichten[10], schichten[11]], x)
            setze logits auf vorwaerts([schichten[12], schichten[13]], x)
            setze zeile auf logits.zeilen(länge(kontext) - 1, länge(kontext)).zu_liste()
            setze erlaubt auf anfragen["allowed"]
            setze best auf erlaubt[0]
            für id in erlaubt:
                wenn zeile[id] > zeile[best]:
                    setze best auf id
            prefix.hinzufügen(best)
            erzeugt.hinzufügen(best)
            setze schritt auf schritt + 1
        ergebnisse.hinzufügen(erzeugt)
    gib_zurück ergebnisse

funktion parameter_beleg(schichten):
    setze liste auf parameter(schichten)
    setze resultate auf []
    für p in liste:
        setze werte auf json_string(p.zu_liste())
        resultate.hinzufügen({"form": p.form(), "sha256_json": sha256(werte)})
    gib_zurück resultate

# Initialisiert ausschließlich einen untrainierten p4-gpt2-v1-Checkpoint.
# Führt keinen Optimiererschritt und kein Tokenizertraining aus.
setze art auf umgebung("P4_TOKENIZER_KIND")
setze tokpfad auf umgebung("P4_TOKENIZER_PATH")
setze ziel auf umgebung("P4_CHECKPOINT_OUT")
setze seed auf zahl(umgebung("P4_SEED"))
setze dim auf zahl(umgebung("P4_DIM"))
setze heads auf zahl(umgebung("P4_HEADS"))
setze block auf zahl(umgebung("P4_CONTEXT"))
setze versteckt auf zahl(umgebung("P4_HIDDEN"))
wenn art == nichts oder tokpfad == nichts oder ziel == nichts oder seed == nichts oder dim == nichts oder heads == nichts oder block == nichts oder versteckt == nichts:
    wirf "P4-Init: Umgebungsvariablen fehlen"
wenn datei_existiert(ziel):
    wirf "P4-Init: Checkpoint existiert bereits"
wenn seed < 0 oder seed > 1000000000 oder seed != boden(seed):
    wirf "P4-Init: Seed ungültig"
wenn dim < 1 oder dim > 512 oder dim != boden(dim) oder heads < 1 oder heads > 16 oder heads != boden(heads) oder dim - boden(dim / heads) * heads != 0:
    wirf "P4-Init: Dimension/Köpfe ungültig"
wenn block < 2 oder block > 4096 oder block != boden(block) oder versteckt < 1 oder versteckt > 4096 oder versteckt != boden(versteckt):
    wirf "P4-Init: Kontext/FF-Dimension ungültig"
setze tok auf nichts
setze info auf nichts
wenn art == "char":
    setze tok auf zeichen_fixed_laden(tokpfad)
    setze info auf zeichen_fixed_info(tok)
sonst wenn art == "bpe":
    setze tok auf tokenizer_laden(tokpfad)
    setze info auf tokenizer_info(tok)
sonst wenn art == "syllable":
    setze tok auf silben_laden(tokpfad)
    setze info auf silben_info(tok)
sonst:
    wirf "P4-Init: unbekannter Tokenizer"
setze vokab auf info["vokab"]
wenn 2 * vokab * dim + 4 * dim * versteckt > 8000000:
    wirf "P4-Init: Modellgröße über dem Ressourcenlimit"
setze emb auf schicht_embedding(vokab, dim, seed + 1)
setze pos auf schicht_position(block, dim, "gelernt", seed + 2)
setze ln1a auf schicht_layernorm(dim)
setze att1 auf schicht_attention(dim, heads, seed + 3)
setze ln1b auf schicht_layernorm(dim)
setze ff1a auf schicht_dicht(dim, versteckt, "gelu", seed + 4)
setze ff1b auf schicht_dicht(versteckt, dim, "keine", seed + 5)
setze ln2a auf schicht_layernorm(dim)
setze att2 auf schicht_attention(dim, heads, seed + 6)
setze ln2b auf schicht_layernorm(dim)
setze ff2a auf schicht_dicht(dim, versteckt, "gelu", seed + 7)
setze ff2b auf schicht_dicht(versteckt, dim, "keine", seed + 8)
setze lnf auf schicht_layernorm(dim)
setze kopf auf schicht_dicht(dim, vokab, "keine", seed + 9)
setze alle auf [emb, pos, ln1a, att1, ln1b, ff1a, ff1b, ln2a, att2, ln2b, ff2a, ff2b, lnf, kopf]
setze netz auf ki_netz(alle)
setze opt auf optimierer_sgd(parameter(alle), 0.01, 0.9)


setze anfragen auf json_parse(datei_lesen(umgebung("P4_GENERATION_PATH")))
setze eingaben auf []
setze ziele auf []
setze maske auf []
setze original auf anfragen["prompts"][0]
setze i auf 0
solange i < 64:
    eingaben.hinzufügen(original[i % länge(original)])
    ziele.hinzufügen(original[(i + 1) % länge(original)])
    maske.hinzufügen(1)
    setze i auf i + 1
gpu_statistik_reset()
autograd_an()
setze schritt auf 0
solange schritt < 3:
    setze x auf vorwaerts([alle[0]], tensor_aus_liste(eingaben))
    setze x auf vorwaerts([alle[1]], x)
    setze x auf x + vorwaerts([alle[2], alle[3]], x)
    setze x auf x + vorwaerts([alle[4], alle[5], alle[6]], x)
    setze x auf x + vorwaerts([alle[7], alle[8]], x)
    setze x auf x + vorwaerts([alle[9], alle[10], alle[11]], x)
    setze logits auf vorwaerts([alle[12], alle[13]], x)
    setze verlust auf kreuzentropie(logits, tensor_aus_liste(ziele), tensor_aus_liste(maske))
    verlust.rueckwaerts()
    gradienten_kappen(parameter(alle), 1.0)
    opt.schritt()
    setze schritt auf schritt + 1
setze train_gpu auf gpu_statistik()
autograd_aus()
setze vor auf generiere(alle, anfragen)
# netz.speichern zuerst: checkpoint_speichern materialisiert die Hostdaten.
netz.speichern(ziel + ".netz")
checkpoint_speichern({"netz": netz, "opt": opt, "schritt": 3, "global_schritt": 3, "tokenizer_version": sha256(tok), "arch_version": "p4-gpt2-v1"}, ziel)
# Host-Materialisierung erst NACH dem Speichern, damit sie den Bug nicht verdeckt.
setze parameter_vor auf parameter_beleg(alle)
setze geladen auf checkpoint_laden(ziel, {"tokenizer_version": sha256(tok), "arch_version": "p4-gpt2-v1"})
setze neu_schichten auf geladen["netz"]["schichten"]
setze parameter_nach auf parameter_beleg(neu_schichten)
setze nach auf generiere(neu_schichten, anfragen)
setze netz_schichten auf ki_laden(ziel + ".netz")["schichten"]
setze parameter_netz auf parameter_beleg(netz_schichten)
setze nach_netz auf generiere(netz_schichten, anfragen)
datei_schreiben(umgebung("P4_DIAG_RESULT"), json_string({"before": vor, "after": nach, "after_netz": nach_netz, "params_before": parameter_vor, "params_after": parameter_nach, "params_netz": parameter_netz, "gpu": train_gpu}))
