# Öffentliche P4-Sprachschnittstelle mit künstlichen Byte-Fallback-Artefakten.
# Der Task erzeugt beide Artefakte anhand ihres Formats; kein Training.
setze dir auf umgebung("P4_MOOS_FIXTURES")
setze c auf zeichen_fixed_laden(dir + "/char.mcf")
setze s auf silben_laden(dir + "/silben.msf")
setze w auf silben_laden(dir + "/words.msf")
# Amtliches Regelwerk §88: https://grammis.ids-mannheim.de/rechtschreibung/6216
setze zu auf silben_grenzen(w, "Zucker")
wenn länge(zu) != 2 oder zu[0][0] != 0 oder zu[0][1] != 2 oder zu[1][0] != 2 oder zu[1][1] != 6:
    zeige "Zu|cker Mustergrenze"
    beende(1)
setze bag auf silben_grenzen(w, "Bagger")
wenn länge(bag) != 2 oder bag[0][1] != 3 oder bag[1][0] != 3 oder bag[1][1] != 6:
    zeige "Bag|ger Mustergrenze"
    beende(1)
wenn länge(silben_kodiere(w, "Zucker").zu_liste()) != 2:
    zeige "Mustersegmente nicht im Vokabular"
    beende(1)
setze kaputt auf falsch
versuche:
    silben_laden(dir + "/bad-silben.msf")
fange fehler:
    setze kaputt auf wahr
wenn nicht kaputt:
    zeige "Beschädigtes Silbenartefakt akzeptiert"
    beende(1)
setze kaputt auf falsch
versuche:
    zeichen_fixed_laden(dir + "/bad-char.mcf")
fange fehler:
    setze kaputt auf wahr
wenn nicht kaputt:
    zeige "Beschädigtes Zeichenartefakt akzeptiert"
    beende(1)
setze probe auf "Straße Ä 🌱\n"
wenn zeichen_fixed_dekodiere(c, zeichen_fixed_kodiere(c, probe)) != probe:
    zeige "Zeichen-Roundtrip"
    beende(1)
wenn silben_dekodiere(s, silben_kodiere(s, probe)) != probe:
    zeige "Silben-Roundtrip"
    beende(1)
wenn syllable_decode(s, syllable_encode(s, probe)) != probe:
    zeige "Englischer Alias"
    beende(1)
wenn zeichen_fixed_info(c)["vokab"] != 256 oder silben_info(s)["vokab"] != 256:
    zeige "Fallback-Vokabular"
    beende(1)
wenn silben_info(s)["hash"] != silben_hash(s):
    zeige "Silben-Info-Hash"
    beende(1)
setze grenzen auf silben_grenzen(s, "Wald")
wenn länge(grenzen) == 0 oder grenzen[0][0] != 0:
    zeige "Silbengrenzen"
    beende(1)
setze unicode_grenzen auf silben_grenzen(s, "Ä")
setze cursor auf 0
setze i auf 0
solange i < länge(unicode_grenzen):
    setze teil auf unicode_grenzen[i]
    wenn teil[0] != cursor oder teil[1] <= teil[0] oder teil[2] < 0 oder teil[2] > 2:
        zeige "UTF-8-Bytegrenzen inkonsistent"
        beende(1)
    setze cursor auf teil[1]
    setze i auf i + 1
wenn cursor != 2:
    zeige "UTF-8-Bytegrenzen unvollständig"
    beende(1)
setze fehl auf falsch
versuche:
    silben_dekodiere(s, [256])
fange fehler:
    setze fehl auf wahr
wenn nicht fehl:
    zeige "Ungültige Silben-ID akzeptiert"
    beende(1)
setze fehl auf falsch
versuche:
    zeichen_fixed_dekodiere(c, [-1])
fange fehler:
    setze fehl auf wahr
wenn nicht fehl:
    zeige "Ungültige Zeichen-ID akzeptiert"
    beende(1)
setze char_speicher auf dir + "/speicher.mcf"
zeichen_fixed_speichern(c, char_speicher)
wenn zeichen_fixed_hash(zeichen_fixed_laden(char_speicher)) != zeichen_fixed_hash(c):
    zeige "Zeichen-Speichern/Laden"
    beende(1)
setze speicher auf dir + "/speicher.msf"
silben_speichern(s, speicher)
wenn silben_hash(silben_laden(speicher)) != silben_hash(s):
    zeige "Silben-Speichern/Laden"
    beende(1)
setze netz auf ki_netz([schicht_embedding(256, 8, 1), schicht_dicht(8, 256, "keine", 2)])
setze pfad auf dir + "/checkpoint.mook"
checkpoint_speichern({"netz": netz, "schritt": 0, "tokenizer_version": silben_hash(s),
                     "arch_version": "p4-moo-test"}, pfad)
# Selftest: Ein nicht ladbarer Checkpoint meldet FAIL und beendet mit RC 1 (ein unbehandeltes wirf
# bricht den Lauf nicht ab).
setze geladen auf nichts
versuche:
    setze geladen auf checkpoint_laden(pfad, {"tokenizer_version": silben_hash(s), "arch_version": "p4-moo-test"})
fange lade_fehler:
    zeige "P4 TOKENIZER-API FAIL: checkpoint_laden: " + lade_fehler
    beende(1)
wenn geladen["tokenizer_version"] != silben_hash(s):
    zeige "Checkpoint-Identität"
    beende(1)
setze fehl auf falsch
versuche:
    checkpoint_laden(pfad, {"tokenizer_version": zeichen_fixed_hash(c), "arch_version": "p4-moo-test"})
fange fehler:
    setze fehl auf wahr
wenn nicht fehl:
    zeige "Falscher Tokenizer-Hash akzeptiert"
    beende(1)
setze fehl auf falsch
versuche:
    checkpoint_laden(pfad, {"tokenizer_version": silben_hash(s), "arch_version": "falsch"})
fange fehler:
    setze fehl auf wahr
wenn nicht fehl:
    zeige "Falsche Architektur akzeptiert"
    beende(1)
zeige "P4 MOOS API OK"
