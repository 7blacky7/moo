# Kausale Präfixe gruppiert auswerten, Modell und Tokenizer einmal laden.
setze art auf umgebung("P4_TOKENIZER_KIND")
setze tokpfad auf umgebung("P4_TOKENIZER_PATH")
setze ckpfad auf umgebung("P4_CHECKPOINT")
setze anfragenpfad auf umgebung("P4_REQUESTS_PATH")
wenn art == nichts oder tokpfad == nichts oder ckpfad == nichts oder anfragenpfad == nichts:
    zeige "P4-Batch: Umgebungsvariablen fehlen"
    beende(1)
setze tok auf nichts
wenn art == "char":
    setze tok auf zeichen_fixed_laden(tokpfad)
sonst wenn art == "bpe":
    versuche:
        setze tok auf tokenizer_laden(tokpfad)
    fange lade_fehler:
        zeige "P4: tokenizer_laden fehlgeschlagen: " + lade_fehler
        beende(1)
sonst wenn art == "syllable":
    setze tok auf silben_laden(tokpfad)
sonst:
    zeige "P4-Batch: unbekannter Tokenizer"
    beende(1)
setze h auf sha256(tok)
setze geladen auf nichts
versuche:
    setze geladen auf checkpoint_laden(ckpfad, {"tokenizer_version": h, "arch_version": "p4-gpt2-v1"})
fange lade_fehler:
    zeige "P4: checkpoint_laden fehlgeschlagen: " + lade_fehler
    beende(1)
setze schichten auf geladen["netz"]["schichten"]
wenn länge(schichten) != 14:
    zeige "P4-Batch: unerwartete Architektur"
    beende(1)
setze anfragen auf json_parse(datei_lesen(anfragenpfad))
wenn länge(anfragen) < 1 oder länge(anfragen) > 32:
    zeige "P4-Batch: ungültige Anfragezahl"
    beende(1)
setze ergebnisse auf []
autograd_aus()
für anfrage in anfragen:
    setze prefix auf anfrage["prefix"]
    setze pos auf anfrage["position"]
    setze kontext auf []
    wenn pos == länge(prefix):
        kontext.hinzufügen(0)
    für id in prefix:
        kontext.hinzufügen(id)
    wenn länge(kontext) == 0:
        zeige "P4-Batch: abgeschnittenes Fenster ohne Kontext"
        beende(1)
    setze x auf vorwaerts([schichten[0]], tensor_aus_liste(kontext))
    setze x auf vorwaerts([schichten[1]], x)
    setze x auf x + vorwaerts([schichten[2], schichten[3]], x)
    setze x auf x + vorwaerts([schichten[4], schichten[5], schichten[6]], x)
    setze x auf x + vorwaerts([schichten[7], schichten[8]], x)
    setze x auf x + vorwaerts([schichten[9], schichten[10], schichten[11]], x)
    setze logits auf vorwaerts([schichten[12], schichten[13]], x)
    ergebnisse.hinzufügen(logits.zeilen(länge(kontext) - 1, länge(kontext)).zu_liste())
zeige json_string(ergebnisse)
