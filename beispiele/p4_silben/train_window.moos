# P4 Multi-Window-Trainingsadapter. Nur über den zertifizierten Orchestrator.
# Manifest-, Dokument-, Tokenizer-, Checkpoint- und Budgetbelege sowie der
# GPU-Slot werden vor dem Aufruf im Gate und Runner geprüft.
setze art auf umgebung("P4_TOKENIZER_KIND")
setze tokpfad auf umgebung("P4_TOKENIZER_PATH")
setze ckpfad auf umgebung("P4_CHECKPOINT")
setze ziel auf umgebung("P4_CHECKPOINT_OUT")
setze fensterpfad auf umgebung("P4_WINDOWS_PATH")
setze erwarteter_hash auf umgebung("P4_WINDOWS_SHA256")
setze manifesthash auf umgebung("P4_MANIFEST_SHA256")
wenn art == nichts oder tokpfad == nichts oder ckpfad == nichts oder ziel == nichts oder fensterpfad == nichts oder erwarteter_hash == nichts oder manifesthash == nichts:
    zeige "P4-Train: Umgebungsvariablen fehlen"
    beende(1)
wenn datei_existiert(ziel):
    zeige "P4-Train: Ausgabe-Checkpoint existiert bereits"
    beende(1)
setze tok auf nichts
setze info auf nichts
wenn art == "char":
    setze tok auf zeichen_fixed_laden(tokpfad)
    setze info auf zeichen_fixed_info(tok)
sonst wenn art == "bpe":
    versuche:
        setze tok auf tokenizer_laden(tokpfad)
    fange lade_fehler:
        zeige "P4: tokenizer_laden fehlgeschlagen: " + lade_fehler
        beende(1)
    setze info auf tokenizer_info(tok)
sonst wenn art == "syllable":
    setze tok auf silben_laden(tokpfad)
    setze info auf silben_info(tok)
sonst:
    zeige "P4-Train: unbekannter Tokenizer"
    beende(1)
setze tokenhash auf sha256(tok)
setze zustand auf nichts
versuche:
    setze zustand auf checkpoint_laden(ckpfad, {"tokenizer_version": tokenhash, "arch_version": "p4-gpt2-v1"})
fange lade_fehler:
    zeige "P4: checkpoint_laden fehlgeschlagen: " + lade_fehler
    beende(1)
setze schichten auf zustand["netz"]["schichten"]
setze opt auf zustand["opt"]
wenn opt == nichts oder länge(schichten) != 14:
    zeige "P4-Train: Checkpoint braucht Optimizer und 14 Schichten"
    beende(1)
setze kontextlimit auf schichten[1]["max"]
wenn kontextlimit == nichts oder kontextlimit < 2 oder kontextlimit > 4096 oder kontextlimit != boden(kontextlimit):
    zeige "P4-Train: ungueltiges Positionslimit"
    beende(1)
setze roh auf datei_lesen(fensterpfad)
wenn sha256(roh) != erwarteter_hash:
    zeige "P4-Train: Fensterdatei verändert"
    beende(1)
setze paket auf json_parse(roh)
wenn paket["manifest_sha256"] != manifesthash oder paket["tokenizer_sha256"] != tokenhash:
    zeige "P4-Train: Manifest oder Tokenizer passt nicht"
    beende(1)
setze fenster auf paket["windows"]
wenn länge(fenster) < 1 oder länge(fenster) > 100000:
    zeige "P4-Train: ungültige Fensterzahl"
    beende(1)
setze vokab auf info["vokab"]
# Sämtliche Form- und Maskenfehler werden vor dem ersten Optimiererschritt
# erkannt. Train-only-Zuordnung und Bytebezug prüft zusätzlich der Runner.
für f in fenster:
    setze eingaben auf f["input_ids"]
    setze ziele auf f["target_ids"]
    setze maske auf f["loss_mask"]
    setze n auf länge(eingaben)
    wenn n < 1 oder n > kontextlimit oder länge(ziele) != n oder länge(maske) != n:
        zeige "P4-Train: Eingabe- und Zielform ungültig"
        beende(1)
    setze i auf 0
    setze aktive auf 0
    solange i < n:
        wenn maske[i] != 0 und maske[i] != 1:
            zeige "P4-Train: Verlustmaske muss binär sein"
            beende(1)
        setze aktive auf aktive + maske[i]
        setze a auf eingaben[i]
        setze b auf ziele[i]
        wenn a < 0 oder a >= vokab oder a != boden(a) oder b < 0 oder b >= vokab oder b != boden(b):
            zeige "P4-Train: ungültige Token-ID"
            beende(1)
        wenn i + 1 < n und eingaben[i + 1] != b:
            zeige "P4-Train: Next-Token-Verschiebung inkonsistent"
            beende(1)
        setze i auf i + 1
    wenn aktive == 0:
        zeige "P4-Train: Verlustmaske ist leer"
        beende(1)

autograd_an()
für f in fenster:
    setze eingaben auf f["input_ids"]
    setze ziele auf f["target_ids"]
    setze maske auf f["loss_mask"]
    # Pads folgen nur auf echte Eingaben; kausale Attention und Nullmaske
    # verhindern Einfluss auf fruehere Positionen und auf den Verlust.
    solange länge(eingaben) < kontextlimit:
        eingaben.hinzufügen(0)
        ziele.hinzufügen(0)
        maske.hinzufügen(0)
    setze x auf vorwaerts([schichten[0]], tensor_aus_liste(eingaben))
    setze x auf vorwaerts([schichten[1]], x)
    setze x auf x + vorwaerts([schichten[2], schichten[3]], x)
    setze x auf x + vorwaerts([schichten[4], schichten[5], schichten[6]], x)
    setze x auf x + vorwaerts([schichten[7], schichten[8]], x)
    setze x auf x + vorwaerts([schichten[9], schichten[10], schichten[11]], x)
    setze logits auf vorwaerts([schichten[12], schichten[13]], x)
    setze verlust auf kreuzentropie(logits, tensor_aus_liste(ziele), tensor_aus_liste(maske))
    verlust.rueckwaerts()
    gradienten_kappen(parameter(schichten), 1.0)
    opt.schritt()
    setze zustand["schritt"] auf zustand["schritt"] + 1
    setze zustand["global_schritt"] auf zustand["global_schritt"] + 1
# Nur in privatem Staging schreiben; der Runner muss das Ergebnis prüfen und
# anschließend exklusiv atomar veröffentlichen.
checkpoint_speichern(zustand, ziel)
zeige "P4 TRAIN RUN OK"
