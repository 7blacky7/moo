# P4 Tokenizer-Encoder: kein Training, nur ein vorab ausgewähltes Dokument.
# Der Runner übergibt ausschließlich validierte Train-Dokumente.
setze art auf umgebung("P4_TOKENIZER_KIND")
setze tokpfad auf umgebung("P4_TOKENIZER_PATH")
setze textpfad auf umgebung("P4_TEXT_PATH")
wenn art == nichts oder tokpfad == nichts oder textpfad == nichts:
    zeige "P4-Encoder: Umgebungsvariablen fehlen"
    beende(1)
setze text auf datei_lesen(textpfad)
setze ids auf nichts
wenn art == "char":
    setze ids auf zeichen_fixed_kodiere(zeichen_fixed_laden(tokpfad), text)
sonst wenn art == "bpe":
    setze bpe_tok auf nichts
    versuche:
        setze bpe_tok auf tokenizer_laden(tokpfad)
    fange lade_fehler:
        zeige "P4: tokenizer_laden fehlgeschlagen: " + lade_fehler
        beende(1)
    setze ids auf tokenizer_kodiere(bpe_tok, text)
sonst wenn art == "syllable":
    setze ids auf silben_kodiere(silben_laden(tokpfad), text)
sonst:
    zeige "P4-Encoder: unbekannter Tokenizer"
    beende(1)
zeige json_string(ids.zu_liste())
